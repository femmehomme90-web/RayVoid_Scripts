    end

    local function binPrompt(k)
        local trash = k:FindFirstChild("Trash")
        if not trash then return nil end
        local can = trash:FindFirstChild("TrashCan")
        local throw = can and can:FindFirstChild("PromptPart") and can.PromptPart:FindFirstChild("Throw")
        if throw and throw.Enabled then return throw end
        return trash:FindFirstChild("TrashPrompt")
    end

    local function invalidateTrashWorker()
        trashWorkerToken = trashWorkerToken + 1
    end

    local function startTrashWorker()
        invalidateTrashWorker()
        local token = trashWorkerToken
        if not trashEnabled then return end

        task.spawn(function()
            while trashEnabled and token == trashWorkerToken and scriptAlive() do
                local k = myRestaurant()
                local targets = cleanUpPrompts()
                if k and #targets > 0 then
                    withCharacter(function()
                        for i = 1, math.min(perTrip, #targets) do
                            if firePrompt(targets[i]) then task.wait(0.4) end
                        end
                        local bin = binPrompt(k)
                        if bin and firePrompt(bin) then
                            Live.trash = Live.trash + 1
                            task.wait(0.4)
                        end
                    end)
                end
                task.wait(3)
            end
        end)
