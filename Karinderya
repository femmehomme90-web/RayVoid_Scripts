-- WEBHOOK
-- The URL only ever leaves the machine towards Discord itself: it is typed here, saved in the local
-- config file and posted straight to discord.com. Nothing is sent anywhere else.

local Webhook = (function()
    local HttpService = game:GetService("HttpService")
    local httpRequest = http_request or request
        or (syn and syn.request) or (fluxus and fluxus.request) or (http and http.request)

    local url, enabled, pingId = "", false, ""
    local reportOn, reportMinutes = false, 60
    local groceryOn, shopOn, merchantOn, upgradesOn = false, false, false, false
    local digestMinutes = 5

    local queue, buckets = {}, {}
    local urlInput, pingInput
    local lastResult = "nothing sent yet"
    local lastReportCash, lastReportAt = nil, os.clock()
    local lastDigestAt = os.clock()

    local function cash()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        local v = ls and ls:FindFirstChild("Cash")
        return v and tonumber(v.Value) or 0
    end

    local function money(n)
        n = math.floor(tonumber(n) or 0)
        local sign = n < 0 and "-" or ""
        local digits = tostring(math.abs(n))
        local grouped = digits:reverse():gsub("(%d%d%d)", "%1 "):reverse():gsub("^%s+", "")
        return sign .. grouped
    end

    local function configured()
        return type(url) == "string" and url:sub(1, 8) == "https://"
            and url:find("/api/webhooks/", 1, true) ~= nil
    end

    local function ready()
        return enabled and configured() and httpRequest ~= nil
    end

    local function enqueue(embed)
        if not ready() then return end
        if #queue >= 20 then table.remove(queue, 1) end
        queue[#queue + 1] = embed
    end

    local function embed(title, description, color, fields)
        return {
            title = title,
            description = description,
            color = color or 3447003,
            fields = fields,
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            footer = { text = "Karinderya · AKkiwi HUB · " .. LocalPlayer.Name },
        }
    end

    -- Discord takes up to 10 embeds per message; one message every 2s stays well inside its limits.
    local function flushQueue()
        if #queue == 0 or not ready() then return end
        local batch = {}
        while #queue > 0 and #batch < 10 do
            batch[#batch + 1] = table.remove(queue, 1)
        end
        -- The Roblox account name rides on the message itself, so a channel fed by several
        -- accounts stays readable without opening an embed.
        local payload = { username = "Karinderya · " .. LocalPlayer.Name, embeds = batch }
        if pingId ~= "" then payload.content = "<@" .. pingId .. ">" end
        local okBody, body = pcall(HttpService.JSONEncode, HttpService, payload)
        if not okBody then lastResult = "encode failed" return end
        local ok, res = pcall(httpRequest, {
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
        if not ok then
            lastResult = "request error: " .. tostring(res)
        elseif type(res) == "string" then
            lastResult = "failed: " .. res
        else
            local code = tonumber(res.StatusCode) or 0
            if code >= 200 and code < 300 then
                lastResult = string.format("sent %d embed(s) at %s", #batch, os.date("%H:%M:%S"))
            else
                lastResult = "HTTP " .. tostring(code) .. " — check the URL"
            end
        end
    end

    -- Purchases are batched: an auto-buy pass can fire dozens of them, and one Discord message per
    -- ingredient would be both unreadable and rate limited.
    local function record(category, name, price)
        buckets[category] = buckets[category] or {}
        local line = buckets[category][name] or { count = 0, total = 0 }
        line.count = line.count + 1
        line.total = line.total + (tonumber(price) or 0)
        buckets[category][name] = line
    end

    local function flushDigest()
        for category, items in pairs(buckets) do
            local lines, total, kinds = {}, 0, 0
            for name, line in pairs(items) do
                lines[#lines + 1] = string.format("• %s ×%d — ₱%s", name, line.count, money(line.total))
                total = total + line.total
                kinds = kinds + 1
            end
            if kinds > 0 then
                table.sort(lines)
                enqueue(embed(category .. " purchases", table.concat(lines, "\n"), 5763719, {
                    { name = "Total spent", value = "₱" .. money(total), inline = true },
                    { name = "Cash now", value = "₱" .. money(cash()), inline = true },
                }))
            end
        end
        buckets = {}
        lastDigestAt = os.clock()
    end

    local function sendReport()
        local now = cash()
        local fields = {
            { name = "Cash", value = "₱" .. money(now), inline = true },
        }
        if lastReportCash then
            local delta = now - lastReportCash
            local minutes = math.max(1, math.floor((os.clock() - lastReportAt) / 60))
            fields[#fields + 1] = { name = "Since last report", value = (delta >= 0 and "+" or "") .. "₱" .. money(delta), inline = true }
            fields[#fields + 1] = { name = "Per hour", value = "₱" .. money(delta / minutes * 60), inline = true }
        end
        fields[#fields + 1] = { name = "Served", value = tostring(Live.served), inline = true }
        fields[#fields + 1] = { name = "Assigned", value = tostring(Live.assigned), inline = true }
        fields[#fields + 1] = { name = "Washed", value = tostring(Live.washed), inline = true }
        enqueue(embed("Hourly report", nil, 3066993, fields))
        lastReportCash, lastReportAt = now, os.clock()
    end

    -- A loaded config fills the text boxes, but Airflow's Input:Set only fired its Callback from
    -- 2026-09-16 on — so read the boxes themselves every tick. That also covers switching config
    -- profiles at runtime, which never fires a Callback either.
    local function syncFromBoxes()
        if urlInput then
            local boxed = urlInput:Get()
            if type(boxed) == "string" and boxed ~= url then url = boxed end
        end
        if pingInput then
            local boxed = pingInput:Get()
            if type(boxed) == "string" then
                local digits = boxed:gsub("%D", "")
                if digits ~= pingId then pingId = digits end
            end
        end
    end

    task.spawn(function()
        while scriptAlive() do
            syncFromBoxes()
            if ready() then
                if reportOn and os.clock() - lastReportAt >= reportMinutes * 60 then sendReport() end
                if os.clock() - lastDigestAt >= digestMinutes * 60 then flushDigest() end
                flushQueue()
            end
            task.wait(2)
        end
    end)

    WebhookTab:CreateSection("Discord webhook")

    WebhookTab:CreateParagraph({
        Title = "How this works",
        Content = "Paste a Discord webhook URL and the script posts to it directly. The URL is saved only in your local config file (AKkiwiHub/Karinderya.json) and is never sent anywhere except discord.com. Anyone holding that URL can post in that channel, so keep it to yourself.",
    })

    urlInput = WebhookTab:CreateInput({
        Name = "Webhook URL",
        Desc = "Discord channel → Edit → Integrations → Webhooks → Copy URL",
        Placeholder = "https://discord.com/api/webhooks/...",
        Default = "",
        Flag = "KarinderyaWebhookUrl",
        Callback = function(text)
            url = tostring(text or "")
            notify("Webhook", configured() and "URL looks valid" or "That is not a Discord webhook URL", configured() and "Success" or "Warning")
        end,
    })

    pingInput = WebhookTab:CreateInput({
        Name = "Discord user ID to ping",
        Desc = "Optional. Your numeric Discord ID, so every message mentions you",
        Placeholder = "123456789012345678",
        Default = "",
        Flag = "KarinderyaWebhookPing",
        Callback = function(text) pingId = tostring(text or ""):gsub("%D", "") end,
    })

    WebhookTab:CreateToggle({
        Name = "Enable webhook",
        Desc = "Nothing is sent while this is off",
        Default = false,
        Flag = "KarinderyaWebhookEnabled",
        Callback = function(v) enabled = v end,
    })

    WebhookTab:CreateButton({
        Name = "Send a test message",
        Desc = "Posts one message right now so you can check the URL",
        Callback = function()
            task.spawn(function()
                syncFromBoxes()
                if not configured() then
                    notify("Webhook", "Set a valid webhook URL first", "Warning")
                    return
                end
                if not httpRequest then
                    notify("Webhook", "This executor has no HTTP request function", "Error")
                    return
                end
                local wasEnabled = enabled
                enabled = true
                enqueue(embed("Test message", "Karinderya is connected to this channel.", 3447003, {
                    { name = "Cash", value = "₱" .. money(cash()), inline = true },
                }))
                flushQueue()
                enabled = wasEnabled
                notify("Webhook", lastResult, "Success")
            end)
        end,
    })

    WebhookTab:CreateLabel({
        Text = "Status: —",
        UpdateRate = 2,
        Update = function()
            if not httpRequest then return "Status: this executor has no HTTP request function" end
            if not configured() then return "Status: no webhook URL set" end
            if not enabled then return "Status: configured but disabled" end
            return "Status: " .. lastResult .. " · " .. #queue .. " queued"
        end,
    })

    WebhookTab:CreateSection("What to send")

    WebhookTab:CreateToggle({
        Name = "Periodic cash report",
        Desc = "Current cash, what changed since the last report, and the session counters",
        Default = false,
        Flag = "KarinderyaWebhookReport",
        Callback = function(v)
            reportOn = v
            if v then lastReportCash, lastReportAt = cash(), os.clock() end
        end,
    })

    WebhookTab:CreateSlider({
        Name = "Report every",
        Desc = "Minutes between cash reports",
        Min = 5, Max = 240, Step = 5, Default = reportMinutes, Suffix = " min",
        Flag = "KarinderyaWebhookInterval",
        Callback = function(v) reportMinutes = tonumber(v) or reportMinutes end,
    })

    WebhookTab:CreateToggle({
        Name = "Ingredient purchases",
        Desc = "What the grocery auto-buy bought, with quantities and prices",
        Default = false,
        Flag = "KarinderyaWebhookGrocery",
        Callback = function(v) groceryOn = v end,
    })

    WebhookTab:CreateToggle({
        Name = "Shop purchases",
        Desc = "Furniture, paints, materials and tiles bought from the shop",
        Default = false,
        Flag = "KarinderyaWebhookShop",
        Callback = function(v) shopOn = v end,
    })

    WebhookTab:CreateToggle({
        Name = "Merchant",
        Desc = "A message the moment a travelling merchant (furniture cart or Halaman) arrives, and what was bought from it",
        Default = false,
        Flag = "KarinderyaWebhookMerchant",
        Callback = function(v) merchantOn = v end,
    })

    WebhookTab:CreateToggle({
        Name = "Upgrades",
        Desc = "Menus unlocked, counter upgrades and tables bought",
        Default = false,
        Flag = "KarinderyaWebhookUpgrades",
        Callback = function(v) upgradesOn = v end,
    })

    WebhookTab:CreateSlider({
        Name = "Group purchases over",
        Desc = "Purchases are collected and sent as one digest this often",
        Min = 1, Max = 30, Step = 1, Default = digestMinutes, Suffix = " min",
        Flag = "KarinderyaWebhookDigest",
        Callback = function(v) digestMinutes = tonumber(v) or digestMinutes end,
    })

    local switches = { Grocery = function() return groceryOn end, Shop = function() return shopOn end,
        Merchant = function() return merchantOn end, Upgrade = function() return upgradesOn end }

    return {
        -- Purchase(category, itemName, price) — batched into the next digest.
        Purchase = function(category, name, price)
            local on = switches[category]
            if ready() and on and on() then record(category, tostring(name), price) end
        end,
        -- Event(category, title, description) — sent on the next queue flush, within ~2s.
        Event = function(category, title, description, color)
            local on = switches[category]
            if ready() and on and on() then enqueue(embed(title, description, color)) end
        end,
    }
end)()

