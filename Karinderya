CleanTab:CreateSection("Dishes")

local AutoWashController = (function()
    local washEnabled = false
    local washWorkerToken = 0

    local function invalidateWashWorker()
        washWorkerToken = washWorkerToken + 1
    end

    -- Verified live: with the sponge equipped the server sinks a dish every ~0.3s from the moment
    -- the hold BEGINS; the 30s HoldDuration never matters. A hold-0 fireproximityprompt washes nothing.
    local DirtyDishSunk = Remotes.BussingRemotes.DirtyDishSunk
    local PropEquipEvent = Remotes.PropEquipEvent

    -- Stand exactly where the Dishwasher worker stands (washing from 10 studs did not work):
    -- WorkerConfig.Roles.Dishwasher.StationPath = {"Sink", "WashNPC", "CounterNPC"}.
    local function washSpot(k, wash)
        local sink = k:FindFirstChild("Sink")
        local station = sink and sink:FindFirstChild("WashNPC")
        station = station and station:FindFirstChild("CounterNPC")
        if station and station:IsA("BasePart") then return station.Position end
        return wash.Parent.Position
    end

    -- Teleport to the station instead of walking to it (Zachary, 2026-09-19). The nudge right after
    -- is not optional: the client only re-checks prompt range once the character has really moved, so
    -- without it InputHoldBegin would start a hold the prompt never accepts.
    -- Land, turn to face the sink, and nudge LAST: every CFrame write counts as a teleport to the
    -- client, so the little step has to be the final thing that touches the character or the prompt
    -- is still considered out of range when InputHoldBegin runs.
    local function goToStation(pos, facePos)
        local root = rootPart()
        if not root then return false end
        root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
        task.wait(0.15)
        root = rootPart()
        if not root then return false end
        root.CFrame = CFrame.lookAt(root.Position, Vector3.new(facePos.X, root.Position.Y, facePos.Z))
        task.wait(0.05)
        nudge()
        return rootPart() ~= nil
    end

    local function washAll(k, wash)
        local sinkPos = wash.Parent.Position
        if not goToStation(washSpot(k, wash), sinkPos) then return end
        local conn = DirtyDishSunk.OnClientEvent:Connect(function() Live.washed = Live.washed + 1 end)
        pcall(function() PropEquipEvent:FireServer("Sponge", true) end)
        pcall(function() wash:InputHoldBegin() end)
        local started = os.clock()
        while wash:GetAttribute("HasDishes") == true and os.clock() - started < 35 and washEnabled and scriptAlive() do
            task.wait(0.2)
        end
        pcall(function() wash:InputHoldEnd() end)
        pcall(function() PropEquipEvent:FireServer("Sponge", false) end)
        task.wait(0.3)
        conn:Disconnect()
    end

    local function startWashWorker()
        invalidateWashWorker()
        local token = washWorkerToken
        if not washEnabled then return end

        task.spawn(function()
            while washEnabled and token == washWorkerToken and scriptAlive() do
                local k = myRestaurant()
                local sink = k and k:FindFirstChild("Sink")
                local wash = sink and sink:FindFirstChild("Sink") and sink.Sink:FindFirstChild("PromptPart")
                wash = wash and wash:FindFirstChild("Wash")
                if wash and wash.Enabled and wash:GetAttribute("HasDishes") then
                    withCharacter(function() washAll(k, wash) end)
                end
                task.wait(2)
            end
        end)
    end

    CleanTab:CreateToggle({
        Name = "Auto wash dishes",
        Desc = "Washes at your sink whenever it has dirty dishes",
        Default = false,
        Flag = "KarinderyaAutoWash",
        Callback = function(enabled)
            washEnabled = enabled
            if enabled then startWashWorker() else invalidateWashWorker() end
        end,
    })

    return {}
end)()

