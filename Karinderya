                return
            end
            if queued then return end
            local queue = queueFunction()
            if not queue then
                notify("Auto reload", "Your executor has no queue_on_teleport", "Warning")
                return
            end
            local ok, err = pcall(queue, LOADER)
            queued = ok
            if not ok then notify("Auto reload", tostring(err), "Warning") end
        end,
    })

    return {}
end)()

SettingsTab:CreateSection("Reach")

local LongReachController = (function()
    local reachEnabled = false
    local originals = setmetatable({}, { __mode = "k" })
    local addedConnection

    local function extend(prompt)
        if not prompt:IsA("ProximityPrompt") then return end
        if originals[prompt] == nil then originals[prompt] = prompt.MaxActivationDistance end
        prompt.MaxActivationDistance = PROMPT_REACH
    end

    local function restore()
        for prompt, reach in pairs(originals) do
            if prompt.Parent then prompt.MaxActivationDistance = reach end
        end
        table.clear(originals)
    end

    SettingsTab:CreateToggle({
        Name = "Long-range prompts",
        Desc = "Every prompt in the game can be used from any distance, manual play included",
        Default = false,
        Flag = "KarinderyaLongReach",
        Callback = function(enabled)
            reachEnabled = enabled
            if addedConnection then addedConnection:Disconnect() addedConnection = nil end
            if enabled then
                for _, d in ipairs(workspace:GetDescendants()) do extend(d) end
                addedConnection = workspace.DescendantAdded:Connect(function(d)
                    if reachEnabled and scriptAlive() then extend(d) end
                end)
            else
                restore()
            end
        end,
    })

    return {}
end)()

SettingsTab:CreateSection("Anti-AFK")

local AntiAfkController = (function()
    local afkEnabled = false
    local afkWorkerToken = 0

    local function invalidateAfkWorker()
        afkWorkerToken = afkWorkerToken + 1
    end

    local function startAfkWorker()
        invalidateAfkWorker()
        local token = afkWorkerToken
        if not afkEnabled then return end

        task.spawn(function()
            while afkEnabled and token == afkWorkerToken and scriptAlive() do
                -- Wait first: an immediate click lands on the toggle and turns it back off.
                task.wait(60)
                if not (afkEnabled and token == afkWorkerToken and scriptAlive()) then break end
                local ok, err = pcall(function() mouse1click() end)
                if not ok then
                    warn("[AntiAFK] mouse1click failed: " .. tostring(err))
                end
            end
        end)
    end

    SettingsTab:CreateToggle({
        Name = "Anti-AFK",
        Desc = "Simulates a left click every 60s to prevent the AFK kick",
        Default = false,
        Flag = "KarinderyaAntiAfk",
        Callback = function(enabled)
            afkEnabled = enabled
            if enabled then startAfkWorker() else invalidateAfkWorker() end
        end,
    })

    return {}
end)()

