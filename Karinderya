local AutoDrinksController = (function()
    local GiveSoftdrink = Remotes.ShopRemotes.GiveSoftdrink
    local NPCRemotes = Remotes.NPCRemotes
    local drinksEnabled = false
    local drinksWorkerToken = 0
    local pending = {}
    local cooldown = {}

    -- Order flavours come as names ("Kola", "Cola", "Surprise"…); stock keys are Kola / Loyal / Suprise.
    local function flavorKey(raw)
        local s = tostring(raw or ""):lower():gsub("%s+", "")
        if s == "cola" or s == "kola" then return "Kola" end
        if s == "surprise" or s == "suprise" then return "Suprise" end
        if s == "loyal" then return "Loyal" end
        return tostring(raw)
    end

    -- SoftdrinkOrdersUpdated(orders) replaces the list, AdditionalOrder(npc, flavour) adds one: same events
    -- the community Orion script listens to. Not verified live.
    pcall(function()
        NPCRemotes.SoftdrinkOrdersUpdated.OnClientEvent:Connect(function(orders)
            if type(orders) ~= "table" then return end
            pending = {}
            for _, v in pairs(orders) do pending[#pending + 1] = flavorKey(v) end
        end)
        NPCRemotes.AdditionalOrder.OnClientEvent:Connect(function(_, flavor)
            if flavor ~= nil then pending[#pending + 1] = flavorKey(flavor) end
        end)
    end)

    local function chillerReady()
        local k = myRestaurant()
        local drinks = k and k:FindFirstChild("Softdrinks")
        local chiller = drinks and drinks:FindFirstChild("Chiller")
        return chiller ~= nil and chiller:GetAttribute("IsRepaired") == true
    end

    local function invalidateDrinksWorker()
        drinksWorkerToken = drinksWorkerToken + 1
    end

    -- GiveSoftdrink:InvokeServer(key) → (ok, message); "Nobody…"/"…ordered" means that order is gone.
    local function startDrinksWorker()
        invalidateDrinksWorker()
        local token = drinksWorkerToken
        if not drinksEnabled then return end

        task.spawn(function()
            local warned = false
            while drinksEnabled and token == drinksWorkerToken and scriptAlive() do
                if not chillerReady() then
                    if not warned then
                        notify("Drinks", "Repair the softdrink chiller first", "Warning")
                        warned = true
                    end
                elseif pending[1] then
                    local key = pending[1]
                    if os.clock() >= (cooldown[key] or 0) then
                        cooldown[key] = os.clock() + 1.5
                        if IngredientsController.Stock(key) <= 0 then
                            IngredientsController.Buy(key)
                            task.wait(0.3)
                        end
                        local served = false
                        if IngredientsController.Stock(key) > 0 then
                            local ok, res, msg = pcall(GiveSoftdrink.InvokeServer, GiveSoftdrink, key)
                            if ok and res then
                                served = true
                                table.remove(pending, 1)
                                Live.drinks = Live.drinks + 1
                            elseif tostring(msg):match("Nobody") or tostring(msg):match("ordered") then
                                table.remove(pending, 1)
                                served = true
                            end
                        else
                            cooldown[key] = os.clock() + 5
                        end
                        -- Don't let one stuck order block the others.
                        if not served and pending[1] == key then
                            table.insert(pending, table.remove(pending, 1))
                        end
                    end
                end
                task.wait(0.3)
            end
        end)
    end

    KitchenTab:CreateToggle({
        Name = "Auto serve drinks",
        Desc = "Gives customers the softdrinks they order, buying a pack when out (needs the repaired chiller)",
        Default = false,
        Flag = "KarinderyaAutoDrinks",
        Callback = function(enabled)
            drinksEnabled = enabled
            if enabled then startDrinksWorker() else invalidateDrinksWorker() end
        end,
    })

    return {}
end)()

