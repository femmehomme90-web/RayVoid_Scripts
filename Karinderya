local function rootPart()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function promptPart(prompt)
    local parent = prompt.Parent
    if parent and parent:IsA("Attachment") then parent = parent.Parent end
    if parent and parent:IsA("BasePart") then return parent end
    return parent and parent:FindFirstChildWhichIsA("BasePart", true)
end

-- Stairs catch the character on a step edge and MoveTo just keeps pushing into it: a jump clears
-- most of them, and from the second try a sidestep gets around the rest.
local function unstickStep(humanoid, root, goal, attempt)
    humanoid.Jump = true
    if attempt >= 2 then
        local dir = Vector3.new(goal.X - root.Position.X, 0, goal.Z - root.Position.Z)
        dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(1, 0, 0)
        local side = Vector3.new(-dir.Z, 0, dir.X) * (attempt % 2 == 0 and 4 or -4)
        humanoid:MoveTo(root.Position + side + dir * 2)
        task.wait(0.4)
        humanoid.Jump = true
    end
    task.wait(0.3)
end

-- Teleporting next to a prompt makes the pickup fail silently; walking works (verified live).
local function walkTo(position, range, timeout)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = rootPart()
    if not (humanoid and root) then return false end
    local deadline = os.clock() + (timeout or 15)
    local best, lastProgress, attempt = math.huge, os.clock(), 0
    while (root.Position - position).Magnitude > range and os.clock() < deadline and scriptAlive() do
        local d = (root.Position - position).Magnitude
        if d < best - 0.3 then
            best, lastProgress, attempt = d, os.clock(), 0
        elseif os.clock() - lastProgress > 1.2 then
            attempt = attempt + 1
            unstickStep(humanoid, root, position, attempt)
            lastProgress = os.clock()
        end
        humanoid:MoveTo(position)
        task.wait(0.2)
    end
    return (root.Position - position).Magnitude <= range
end

-- The client only re-checks prompt range after a real move: a tiny out-and-back step is enough.
local function nudge()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = rootPart()
    if not (humanoid and root) then return end
    local here = root.Position
    local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    look = look.Magnitude > 0.1 and look.Unit or Vector3.new(1, 0, 0)
    for _, goal in ipairs({ here + look * 1.5, here }) do
        local started = os.clock()
        while os.clock() - started < 0.35 and Vector3.new(root.Position.X - goal.X, 0, root.Position.Z - goal.Z).Magnitude > 0.4 do
            humanoid:MoveTo(goal)
            task.wait()
        end
    end
    humanoid:MoveTo(root.Position)
end

local PROMPT_REACH = 1000

local function triggered(prompt)
    local hold = prompt.HoldDuration
    prompt.HoldDuration = 0
    pcall(fireproximityprompt, prompt)
    prompt.HoldDuration = hold
    task.wait(0.5)
    return prompt.Parent == nil or not prompt.Enabled
end

-- AlwaysShow + reach + one small step fires from where we stand if the server range allows it;
-- otherwise walk up to it. Never teleport: prompts keep failing right after one (verified live).
local function firePrompt(prompt)
    local part = promptPart(prompt)
    if not (part and prompt.Enabled) then return false end
    prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
    prompt.MaxActivationDistance = PROMPT_REACH
    nudge()
    if triggered(prompt) then return true end
    if not walkTo(part.Position, 4) then return false end
    task.wait(0.2)
    if not (prompt.Parent and prompt.Enabled) then return false end
    return triggered(prompt)
end

-- Serve, wash and trash all move the character: one at a time.
local characterBusy = false
local function withCharacter(fn)
    if characterBusy or not rootPart() then return false end
    characterBusy = true
    local ok, err = pcall(fn)
    characterBusy = false
    if not ok then warn("[Karinderya] " .. tostring(err)) end
    return ok
end

-- Hitting a runaway and waking a worker both go through the pan, and both only count while a Tool with
-- the attribute Category = "Weapon" is actually in hand (Zachary, 2026-09-19). What is held sits under
-- workspace.<PlayerName> - either one Tool, or nothing at all - and the rest waits in the Backpack.
local function heldTool()
    local character = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
    return character and character:FindFirstChildOfClass("Tool") or nil
end

local function isWeapon(tool)
    return tool ~= nil and tool:GetAttribute("Category") == "Weapon"
end

local function backpackWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return nil end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and isWeapon(tool) then return tool end
    end
    return nil
end

-- Draws the weapon and leaves it out: sheathing it between hits was the earlier version, Zachary asked
-- to keep it simple. Nothing minds - prompts are gated on HandState accessories, not on Tools - and the
-- pan even carries a faster equippedWalkSpeed (18) than walking empty-handed.
local function ensureWeapon()
    if isWeapon(heldTool()) then return true end
    local weapon = backpackWeapon()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not (weapon and humanoid) then return false end
    pcall(function() humanoid:EquipTool(weapon) end)
    task.wait(0.15)
    return isWeapon(heldTool())
end

-- Can the character walk straight at that spot, or is there a wall in between? Horizontal ray at
-- torso height, so a waypoint sitting a few studs below the floor is not mistaken for an obstacle.
local sightParams = RaycastParams.new()
sightParams.FilterType = Enum.RaycastFilterType.Exclude
pcall(function() sightParams.RespectCanCollide = true end)

local function canSee(from, to)
    sightParams.FilterDescendantsInstances = {
        LocalPlayer.Character,
        workspace:FindFirstChild("ClientNPCs"),
    }
    local level = Vector3.new(to.X, from.Y, to.Z)
    return workspace:Raycast(from, level - from, sightParams) == nil
end

-- Let the game land the blow instead of calling the remote ourselves: Tool:Activate() runs the pan's
-- own ClientPanHandler, which plays the swing, waits for its animation marker, does the box test and
-- fires the remote itself. Firing the remote by hand was unreliable; swinging is what works
-- (Zachary, 2026-09-19).
local function swingWeapon()
    local tool = heldTool()
    if not isWeapon(tool) then return false end
    pcall(function() tool:Activate() end)
    return true
end

-- Drop an NPC in front of the character and keep it there. Re-asserted constantly, because
-- NPCClientController never stops steering these models from the server's waypoints.
local function pinInFront(npc, distance)
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    local me = rootPart()
    if not (hrp and me) then return false end
    local humanoid = npc:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.WalkSpeed = 0 end
    hrp.Anchored = true
    local look = Vector3.new(me.CFrame.LookVector.X, 0, me.CFrame.LookVector.Z)
    look = look.Magnitude > 0.1 and look.Unit or Vector3.new(1, 0, 0)
    pcall(function() npc:PivotTo(CFrame.new(me.Position + look * distance, me.Position)) end)
    return true
end

local function unpin(npc, home)
    if not home then return end
    if home.putBack and npc.Parent then pcall(function() npc:PivotTo(home.pivot) end) end
    if home.hrp.Parent then home.hrp.Anchored = home.anchored end
    if home.humanoid and home.humanoid.Parent and home.speed then
        home.humanoid.WalkSpeed = home.speed
    end
end

local function markHome(npc)
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local humanoid = npc:FindFirstChildOfClass("Humanoid")
    return {
        pivot = npc:GetPivot(),
        anchored = hrp.Anchored,
        hrp = hrp,
        humanoid = humanoid,
        speed = humanoid and humanoid.WalkSpeed or nil,
        putBack = true,
    }
end

