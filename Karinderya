        local cfg = foodCache and foodCache[order]
        if type(cfg) ~= "table" then return {} end
        local missing = {}
        for _, name in ipairs(cfg.RequiredIngredients or {}) do
            if IngredientsController.Stock(name) <= 0 then missing[#missing + 1] = name end
        end
        return missing
    end

    -- placeVersion 409: payload table + RequestId as a 2nd arg; the server answers on
    -- CounterActionResult {RequestId, NpcId, Success, Message?, RetryAfter} (verified live 2026-09-21).
    local HttpService = game:GetService("HttpService")
    local ActionResultRemote = Remotes.CounterRemotes.CounterActionResult
    local replies = {}
    ActionResultRemote.OnClientEvent:Connect(function(result)
        if type(result) == "table" and result.RequestId then replies[result.RequestId] = result end
    end)

    local function counterAction(remote, payload)
        local rid = HttpService:GenerateGUID(false)
        remote:FireServer(payload, rid)
        local deadline = os.clock() + 3
        while not replies[rid] and os.clock() < deadline do task.wait(0.05) end
        local result = replies[rid]
        replies[rid] = nil
        return result
    end

    local function afterReply(result)
        local wait = result and tonumber(result.RetryAfter) or 1
        task.wait(math.clamp(wait, 0.3, 5))
    end

    -- The game's own counter re-reads GetCounterInfo on these two events; do the same instead of
    -- waiting out a poll.
    local woken = false
    Remotes.NPCRemotes.NPCArrivedAtSpot1.OnClientEvent:Connect(function() woken = true end)
    Remotes.NPCRemotes.NPCSeated.OnClientEvent:Connect(function() woken = true end)

    local function idle(seconds)
        local deadline = os.clock() + seconds
        while not woken and os.clock() < deadline do task.wait(0.05) end
    end

    local function invalidateAssignWorker()
        assignWorkerToken = assignWorkerToken + 1
    end

    local function startAssignWorker()
        invalidateAssignWorker()
        local token = assignWorkerToken
        if not assignEnabled then return end

        task.spawn(function()
            while assignEnabled and token == assignWorkerToken and scriptAlive() do
                woken = false
                local ok, npc, tables = pcall(GetCounterInfoRemote.InvokeServer, GetCounterInfoRemote)
                if ok and type(npc) == "table" and type(tables) == "table" and tables[1] then
                    local missing = missingFor(npc.Order)
                    if #missing > 0 and IngredientsController.IsBuying() then
                        for _, name in ipairs(missing) do IngredientsController.Buy(name) end
                        missing = missingFor(npc.Order)
                    end
                    if #missing == 0 then
                        -- Firing right as the customer arrives bugs out (Zachary, 2026-09-21).
                        task.wait(0.2)
                        local result = counterAction(AssignNPCRemote, { Seat = tables[1].Seat, NpcId = npc.NpcId, Slot = tables[1].Slot })
                        if result and result.Success then Live.assigned = Live.assigned + 1 end
                        afterReply(result)
                    elseif rejectMissing then
                        afterReply(counterAction(RejectNPCRemote, npc.NpcId))
                    else
                        idle(1)
                    end
                else
                    idle(2)
                end
            end
        end)
    end

    KitchenTab:CreateToggle({
        Name = "Auto assign customers",
        Desc = "Seats the customer at the counter on the first free table (the stove then cooks by itself)",
        Default = false,
        Flag = "KarinderyaAutoAssign",
        Callback = function(enabled)
            assignEnabled = enabled
            if enabled then startAssignWorker() else invalidateAssignWorker() end
        end,
    })

    KitchenTab:CreateToggle({
        Name = "Reject if ingredients missing",
        Desc = "Otherwise the customer waits until the ingredients are restocked",
        Default = false,
        Flag = "KarinderyaRejectMissing",
        Callback = function(enabled) rejectMissing = enabled end,
    })

    return {}
end)()

KitchenTab:CreateSection("Serving")

local AutoServeController = (function()
    local serveEnabled = false
    local serveWorkerToken = 0

    local function enabledPrompts(folders, filter)
        local list = {}
        for _, folder in ipairs(folders) do
            for _, d in ipairs(folder:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled and filter(d) then list[#list + 1] = d end
            end
        end
        return list
    end

    local function diningPlots(k)
        local list = {}
        for _, c in ipairs(k:GetChildren()) do
            if c.Name:match("^DiningPlot") then list[#list + 1] = c end
        end
        return list
    end

    -- Cooked plate: Serve.<n>.Cooked_<Food>.<Plate|Tray>.ProximityPrompt → food accessory.
    -- Delivery: DiningPlot.<Table>.CurrentTable.WoodPlank.Serve<seat>.ProximityPrompt "Serve <Food>".
    -- TableActionPromptController enables these from HandState: GetFood (plates), Serve (seats).
    local function isCooked(p)
        if p:GetAttribute("TableAction") == "GetFood" then return true end
        local model = p.Parent and p.Parent.Parent
        return model ~= nil and model.Name:match("^Cooked_") ~= nil
    end

    local function isSeat(p)
        return p:GetAttribute("TableAction") == "Serve" or p.ActionText:match("^Serve") ~= nil
    end

    -- The server keeps the prompt's own range + ~8 studs (plate 10: ok 18 / refused 20.7; seat 5: ok 8.9 /
    -- refused 10.6), whatever the client sets. Walk, never teleport: after a teleport seats failed even
    -- with a 1s wait (0/4), walking table to table delivered every time (6/6, ~0.9s per table).
    local function standNear(list, reach)
        local root = rootPart()
        if not root then return false end
        local center, far = Vector3.zero, 0
        for _, p in ipairs(list) do
            local pos = promptPart(p).Position
            center = center + pos
            far = math.max(far, (root.Position - pos).Magnitude)
        end
        center = center / #list
        if far <= reach then return false end
        walkTo(center, math.max(reach - 3, 3), 8)
        return true
    end

    local function burst(list, reach)
        local live = {}
        for _, p in ipairs(list) do
            if p.Parent and p.Enabled and promptPart(p) then live[#live + 1] = p end
        end
        if #live == 0 then return 0 end
        local walked = standNear(live, reach)
        -- OnePerButton makes the client keep a single prompt active per key (verified: 0/12 plates
        -- picked with it, 11/11 with AlwaysShow).
        for _, p in ipairs(live) do
            p.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
            p.MaxActivationDistance = PROMPT_REACH
            p.HoldDuration = 0
        end
        if not walked then nudge() end
        for _, p in ipairs(live) do
            if p.Parent and p.Enabled then pcall(fireproximityprompt, p) end
        end
        task.wait(0.35)
        local done = 0
        for _, p in ipairs(live) do
            if not (p.Parent and p.Enabled) then done = done + 1 end
        end
        return done
    end

    local function tableOf(p)
        local node = p
        while node.Parent and not node.Parent.Name:match("^DiningPlot") do node = node.Parent end
        return node
    end

    -- The upgraded counter blocks the walk to the plates (found by Zachary). CanCollide is only changed on
    -- our client, which simulates our own character, and put back when Auto serve is turned off.
    local counterCollide = {}
    local function passThroughCounter(k, enabled)
        if not enabled then
            for part in pairs(counterCollide) do
                if part.Parent then part.CanCollide = true end
            end
            table.clear(counterCollide)
            return
        end
        -- Every counter model differs (Counter1 folder on Default/RedWood/Standard, only Model/Model/BasePart on
        -- ElegantWood/Parsons/SlatBack/Royal, a Folder on ObbyBaloyet/Futitoo), so take every part of UpgradeCounter.
        local counter = k:FindFirstChild("Counter")
        local upgrade = counter and counter:FindFirstChild("UpgradeCounter")
        if not upgrade then return end
        for _, part in ipairs(upgrade:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                counterCollide[part] = true
                part.CanCollide = false
            end
        end
    end

    -- Upstairs = table number >= 7, same rule as the game's getUpstairsRoute.
    local function isUpstairs(tbl)
        return (tonumber(tbl.Name:match("%d+")) or 0) >= 7
    end

    local function routePointsNamed(k, folderName)
        local folder = k:FindFirstChild(folderName)
        local points = {}
        if folder then
            for _, p in ipairs(folder:GetChildren()) do
                if p:IsA("BasePart") then points[#points + 1] = p end
            end
            table.sort(points, function(a, b) return (tonumber(a.Name) or 999) < (tonumber(b.Name) or 999) end)
        end
        return points
    end

    -- Route the game's NPCs take: ExpansionConfig.CustomerRouteFolder (To2ndDeck for Table13-15), else To2nd.
    local expansionCache
    local function routeFor(k, tbl)
        if not expansionCache then
            local ok, mod = pcall(require, Modules.ExpansionConfig)
            expansionCache = ok and type(mod) == "table" and mod or {}
        end
        local folderName = "To2nd"
        for _, entry in pairs(expansionCache) do
            if type(entry) == "table" and entry.CustomerRouteFolder and type(entry.Tables) == "table"
                and table.find(entry.Tables, tbl.Name) then
                folderName = entry.CustomerRouteFolder
            end
        end
        local points = routePointsNamed(k, folderName)
        if #points == 0 then points = routePointsNamed(k, "To2nd") end
        return folderName, points
    end

    -- The routes CUSTOMERS walk: To2nd plus whatever CustomerRouteFolder the expansions declare.
    -- To2ndServer is deliberately left out - it is the worker route and it ends inside the kitchen.
    local function customerRoutes(k)
        local names, seen = { "To2nd" }, { To2nd = true }
        routeFor(k, { Name = "" })
        for _, entry in pairs(expansionCache or {}) do
            local folderName = type(entry) == "table" and entry.CustomerRouteFolder
            if folderName and not seen[folderName] and k:FindFirstChild(folderName) then
                seen[folderName] = true
                names[#names + 1] = folderName
            end
        end
        return names
    end

    -- Flat-distance step (waypoints sit on the floor, ~3 studs under the root). A stall on the
    -- stairs is jumped/sidestepped out of (unstickStep) before giving up.
    local function stepTo(pos)
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = rootPart()
        if not (humanoid and root) then return false end
        local started, lastProgress, best, attempt = os.clock(), os.clock(), math.huge, 0
        while scriptAlive() do
            local d = Vector3.new(root.Position.X - pos.X, 0, root.Position.Z - pos.Z).Magnitude
            if d <= 1.5 then return true end
            if d < best - 0.3 then
                best, lastProgress, attempt = d, os.clock(), 0
            elseif os.clock() - lastProgress > 1.2 then
                attempt = attempt + 1
                if attempt > 4 or os.clock() - started > 14 then
                    humanoid:MoveTo(root.Position)
                    return false
                end
                unstickStep(humanoid, root, pos, attempt)
                lastProgress = os.clock()
            end
            humanoid:MoveTo(pos)
            task.wait(0.1)
        end
        return false
    end

    -- Walk the stairs, never teleport up them. A teleport leaves every prompt on the upper floor dead:
    -- the client only re-checks their range after a real move, and the short walk from the landing
    -- point to a table was not enough to wake them (Zachary, 2026-09-19).
    -- Two things make the walk reliable instead.
    -- 1. The game's waypoints are far apart - 15 studs across the stair run - and MoveTo just leans
    --    into a step edge over that distance. So the route is re-sampled into short hops. stepTo
    --    compares flat distance only, so an interpolated point hanging above or below the real steps
    --    is harmless: the character walks its X/Z and the staircase carries it up.
    -- 2. The start used to be the nearest waypoint in 3D, which from some spots picked a point one
    --    storey up and walked the character into a wall. Now it is the nearest one on OUR floor.
    local STEP_SPACING = 6
    local SAME_FLOOR = 6

    local function densify(points)
        local dense = {}
        for i, part in ipairs(points) do
            if i > 1 then
                local from, to = points[i - 1].Position, part.Position
                local span = Vector3.new(to.X - from.X, 0, to.Z - from.Z).Magnitude
                local cuts = math.floor(span / STEP_SPACING)
                for c = 1, cuts do
                    dense[#dense + 1] = from:Lerp(to, c / (cuts + 1))
                end
            end
            dense[#dense + 1] = part.Position
        end
        return dense
    end

    -- Nearest point on our floor THAT WE CAN SEE. The sight test is what stops the character joining
    -- the route in the middle: from the Extension deck the stairwell points are only a few studs away
    -- in plan view but on the far side of a wall, and picking one skipped the deck access - the only
    -- way off the deck - so the walk went straight into that wall (Zachary, 2026-09-20).
    local function startIndexFor(order)
        local root = rootPart()
        if not root then return 1 end
        local eye = root.Position
        local best, bestDist
        local blind, blindDist
        for i, pos in ipairs(order) do
            if math.abs(pos.Y - eye.Y) <= SAME_FLOOR then
                local d = Vector3.new(eye.X - pos.X, 0, eye.Z - pos.Z).Magnitude
                if not blindDist or d < blindDist then blind, blindDist = i, d end
                if (not bestDist or d < bestDist) and canSee(eye, pos) then
                    best, bestDist = i, d
                end
            end
        end
        if best then return best end
        if blind then return blind end
        -- Nothing at our height at all: stuck halfway up, or on a floor the route does not describe.
        local far, farDist
        for i, pos in ipairs(order) do
            local d = (eye - pos).Magnitude
            if not farDist or d < farDist then far, farDist = i, d end
        end
        return far or 1
    end

    local function followRoute(points, up)
        local root = rootPart()
        if not root or #points == 0 then return false end
        local dense = densify(points)
        local order = {}
        for i = 1, #dense do order[i] = up and dense[i] or dense[#dense + 1 - i] end
        local startIndex = startIndexFor(order)
        for i = startIndex, #order do
            if not stepTo(order[i]) then
                -- One blocked waypoint is not the whole route: aim at the next one before giving up.
                if i >= #order or not stepTo(order[i + 1]) then return false end
            end
        end
        return true
    end

    local function flatDist(a, b)
        return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
    end

    -- Way out of the counter: the gap by the register. Walking straight from the plate hatch to a table
    -- or to the stairs cuts through the kitchen wall and the character gets stuck in it. Line.<n> is the
    -- queue the game's own customers walk, so its first spot is always reachable and sits at the register.
    local function registerSpot(k)
        local line = k:FindFirstChild("Line")
        local best, bestNumber
        if line then
            for _, part in ipairs(line:GetChildren()) do
                local n = tonumber(part.Name)
                if part:IsA("BasePart") and n and (not bestNumber or n < bestNumber) then
                    best, bestNumber = part, n
                end
            end
        end
        if best then return best.Position end
        local counter = k:FindFirstChild("Counter")
        local npc = counter and counter:FindFirstChild("CounterNPC")
        local part = npc and npc:FindFirstChildWhichIsA("BasePart", true)
        return part and part.Position
    end

    -- No-op once we are out in the dining room, where the register would only be a detour.
    local function leaveCounter(k)
        local spot = registerSpot(k)
        local root = rootPart()
        local hatch = k.Serve:FindFirstChildWhichIsA("BasePart")
        if not (spot and root and hatch) then return end
        if flatDist(root.Position, hatch.Position) < flatDist(spot, hatch.Position) then
            stepTo(spot)
        end
    end

    -- Getting out of the BACK of the room is the other half of the problem (Zachary, 2026-09-20): from
    -- the far tables - 16/17, 5/6 - a straight line to the stairs goes through a wall. Their way out is
    -- via the nearer tables, then the counter, then the stairs. So the approach hops from table to
    -- table, always picking one closer to the register than where we stand, until the register is in
    -- reach. Tables make good stepping stones because serveNearestFirst already walks between them all
    -- day; nothing here is hardcoded to a table number, so it survives a new extension.
    local APPROACH_HOP = 14
    local APPROACH_MAX_HOPS = 8

    -- Every table of the restaurant, extensions included, not just DiningPlot1.
    local function groundTableSpots(k, groundY)
        local spots = {}
        for _, node in ipairs(k:GetDescendants()) do
            if node:IsA("Model") and node.Name:match("^Table%d+$") then
                local current = node:FindFirstChild("CurrentTable")
                local part = current and current:FindFirstChildWhichIsA("BasePart", true)
                if part and (not groundY or math.abs(part.Position.Y - groundY) <= 8) then
                    spots[#spots + 1] = part.Position
                end
            end
        end
        return spots
    end

    -- Cross the room by hopping between tables rather than in a straight line. Used both ways now:
    -- towards the register before a climb, and towards a far table after coming down - "arrivé en bas
    -- des escaliers il faudrait ajouter un point plus vers le milieu de la map, par exemple table 4,
    -- avant d'aller a table 17/16" (Zachary, 2026-09-20). A no-op when the goal is already close, so
    -- the usual short walk between neighbouring tables is untouched.
    local function hopTowards(k, goal, groundY, stopShort)
        local root = rootPart()
        if not (root and goal) then return end
        if flatDist(root.Position, goal) <= APPROACH_HOP then return end

        -- Without a floor height every table would qualify, upstairs ones included; our own is the
        -- safe fallback, since this only ever runs while we are on foot at our own level.
        local spots = groundTableSpots(k, groundY or root.Position.Y)
        local used = {}
        for _ = 1, APPROACH_MAX_HOPS do
            root = rootPart()
            if not root then return end
            local here = flatDist(root.Position, goal)
            if here <= APPROACH_HOP then break end
            local best, bestScore
            for i, pos in ipairs(spots) do
                if not used[i] and flatDist(root.Position, pos) <= APPROACH_HOP then
                    local score = flatDist(pos, goal)
                    -- Must actually make progress, or we bounce between two neighbours forever.
                    if score < here and (not bestScore or score < bestScore) then
                        best, bestScore = i, score
                    end
                end
            end
            if not best then break end
            used[best] = true
            if not stepTo(spots[best]) then break end
        end
        if not stopShort then stepTo(goal) end
    end

    -- Only worth it from the back of the room: near the foot of the stairs the register is a detour.
    local function approachStairs(k, points, groundY)
        local root = rootPart()
        if not (root and points[1]) then return end
        if flatDist(root.Position, points[1].Position) <= APPROACH_HOP then return end
        hopTowards(k, registerSpot(k), groundY)
    end

    -- Which upstairs route are we actually standing on? Coming down the wrong one walks straight into a
    -- wall: the deck tables of an Extension have to leave by To2ndDeck 7 -> 6 -> ..., and point 7 is the
    -- only way off the deck - To2nd does not have it (Zachary, 2026-09-20). This used to be hardcoded to
    -- "the route of Table7", i.e. always To2nd, which is exactly the bug.
    -- Picked on the route holding the point nearest to us on our own floor; ties go to the longer route,
    -- which is the more specific one (To2ndDeck is To2nd plus the deck access).
    local function routeHome(k)
        local root = rootPart()
        if not root then return nil end
        local best, bestDist, bestCount
        for _, folderName in ipairs(customerRoutes(k)) do
            local points = routePointsNamed(k, folderName)
            local nearest
            for _, part in ipairs(points) do
                if math.abs(part.Position.Y - root.Position.Y) <= SAME_FLOOR then
                    local d = flatDist(root.Position, part.Position)
                    if not nearest or d < nearest then nearest = d end
                end
            end
            if nearest and (not bestDist or nearest < bestDist - 0.5
                or (math.abs(nearest - bestDist) <= 0.5 and #points > (bestCount or 0))) then
                best, bestDist, bestCount = points, nearest, #points
            end
        end
        return best or routePointsNamed(k, "To2nd")
    end

    -- Nearest table first, so the walk between tables stays short. Tables on another floor (> 8 studs
    -- up or down) are dropped: walking straight at them parks the character under an upstairs table.
    local function serveNearestFirst(groups, k, groundY)
        while next(groups) and scriptAlive() do
            local root = rootPart()
            if not root then break end
            local best, bestDist, bestPart
            for t, list in pairs(groups) do
                local part = promptPart(list[1])
                if not part or math.abs(part.Position.Y - root.Position.Y) > 8 then
                    groups[t] = nil
                else
                    local d = (root.Position - part.Position).Magnitude
                    if not best or d < bestDist then best, bestDist, bestPart = t, d, part end
                end
            end
            if not best then break end
            -- A table right across the room does not get walked at in a straight line any more.
            if k and bestPart and bestDist > APPROACH_HOP then
                hopTowards(k, bestPart.Position, groundY, true)
            end
            Live.served = Live.served + burst(groups[best], 5)
            groups[best] = nil
        end
    end

    local function serveOnce(k)
        passThroughCounter(k, true)
        if #enabledPrompts({ k.Serve }, isCooked) == 0 and #enabledPrompts(diningPlots(k), isSeat) == 0 then return end

        withCharacter(function()
            -- Never walk straight through the floor: come down first if a previous run left us upstairs.
            local root = rootPart()
            local counterPart = k.Serve:FindFirstChildWhichIsA("BasePart")
            -- +6, not +8: on the ground the root sits ~3 studs above the counter part, so this still
            -- catches a run that stalled low in the stairs.
            if root and counterPart and root.Position.Y > counterPart.Position.Y + 6 then
                followRoute(routeHome(k), false)
            end

            burst(enabledPrompts({ k.Serve }, isCooked), 12)
            task.wait(0.15)
            leaveCounter(k)

            -- Upstairs by real height (> 8 studs above the plate counter); the table number is only a fallback.
            local groundY = counterPart and counterPart.Position.Y
            local ground, upstairs = {}, {}
            for _, p in ipairs(enabledPrompts(diningPlots(k), isSeat)) do
                local t = tableOf(p)
                local part = promptPart(p)
                local up
                if groundY and part then
                    up = part.Position.Y > groundY + 8
                else
                    up = isUpstairs(t)
                end
                local bucket = up and upstairs or ground
                bucket[t] = bucket[t] or {}
                table.insert(bucket[t], p)
            end
            serveNearestFirst(ground, k, groundY)

            -- One trip per route: up, serve every upstairs table on it, back down.
            local byRoute = {}
            for t, list in pairs(upstairs) do
                local name, points = routeFor(k, t)
                byRoute[name] = byRoute[name] or { points = points, groups = {} }
                byRoute[name].groups[t] = list
            end
            -- Walk the route back down even when the climb failed: otherwise a stall halfway up
            -- leaves the character parked in the stairs until the next run.
            for _, route in pairs(byRoute) do
                approachStairs(k, route.points, groundY)
                if followRoute(route.points, true) then
                    serveNearestFirst(route.groups)   -- upstairs: no table hopping, the floor is open
                end
                followRoute(route.points, false)
            end
        end)
    end

    local function invalidateServeWorker()
        serveWorkerToken = serveWorkerToken + 1
    end

    local function startServeWorker()
        invalidateServeWorker()
        local token = serveWorkerToken
        if not serveEnabled then return end

        task.spawn(function()
            while serveEnabled and token == serveWorkerToken and scriptAlive() do
                local k = myRestaurant()
                if k then serveOnce(k) end
                task.wait(0.5)
            end
        end)
    end

    KitchenTab:CreateToggle({
        Name = "Auto serve food",
        Desc = "Walks to every cooked plate, picks it up and delivers it to its table",
        Default = false,
        Flag = "KarinderyaAutoServe",
        Callback = function(enabled)
            serveEnabled = enabled
            if enabled then
                startServeWorker()
            else
                invalidateServeWorker()
                passThroughCounter(nil, false)
            end
        end,
    })

    return {}
end)()

