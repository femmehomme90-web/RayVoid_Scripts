            if list then
                table.sort(list, function(a, b) return a.order < b.order end)
                out[#out + 1] = { Label = label, Items = list }
            end
        end
        return out
    end

    for _, attribute in ipairs({ "GlobalMerchantEvent", "GlobalMerchant2Event" }) do
        pcall(function()
            workspace:GetAttributeChangedSignal(attribute):Connect(function() pending = true end)
        end)
    end

    -- Data thread: server calls and grid SetGroups only (the grid redraws on its own loop).
    task.spawn(function()
        local lastRefresh = 0
        while scriptAlive() do
            local here = present()
            if pending or (here and os.clock() - lastRefresh > 5) or os.clock() - lastRefresh > 60 then
                pending = false
                lastRefresh = os.clock()
                refresh()
                if grid then pcall(function() grid:SetGroups(groups()) end) end
            end
            if here then
                if lastSeen ~= true then
                    lastSeen = true
                    notify("Merchant", "The merchant is here", "Success")
                    local lines = {}
                    for key, entry in pairs(live) do
                        if entry.Stock > 0 then
                            lines[#lines + 1] = "• " .. key .. " — ₱" .. tostring(entry.Price)
                        end
                    end
                    if bread.Stock > 0 then
                        lines[#lines + 1] = "• Bread ×" .. bread.Stock .. " — ₱" .. tostring(bread.Price)
                    end
                    table.sort(lines)
                    Webhook.Event("Merchant", "The travelling merchant is here",
                        #lines > 0 and table.concat(lines, "\n") or "No stock left.", 15844367)
                end
                if autoBuy then buySelected(true) end
            else
                lastSeen = false
            end
            task.wait(2)
        end
    end)

