local StaffController = (function()
    local WorkerRemotes = Remotes.WorkerRemotes
    local StaffRemotes = Remotes.StaffRemotes
    local ROLES = { "Assigner", "Dishwasher", "Server" }

    local candidates, hiredRoles, staffInfo = {}, {}, nil
    local rolesToFill = { Dishwasher = true }
    local autoHire, maxWage = false, 4000
    local autoRoll, maxRollCost, lastRoll = false, 1000, 0

    -- The role is picked at hire time, so rarity is the only thing that matters (Zachary).
    local RARITIES = { "Common", "Rare", "Epic", "Steamer", "Legendary", "Mythical", "Secret", "Limited" }
    local okConfig, workerConfig = pcall(require, Modules.WorkerConfig)
    if okConfig and type(workerConfig) == "table" and type(workerConfig.Workers) == "table" then
        local known = toSet(RARITIES)
        for _, w in pairs(workerConfig.Workers) do
            if type(w) == "table" and w.Rarity and not known[w.Rarity] then
                known[w.Rarity] = true
                RARITIES[#RARITIES + 1] = w.Rarity
            end
        end
    end
    local rarityRank = {}
    for i, r in ipairs(RARITIES) do rarityRank[r] = i end
    local wantedRarities = toSet(RARITIES)
    local autoWake, autoAccept = false, false
    local pickedApplicants, pickedStaff = {}, {}
    local applicantGrid, staffGrid

    -- GetWaitingWorkers → (restaurant, candidates, hiredRoles as {[role] = true}).
    local function refreshData()
        local ok, _, list, roles = pcall(WorkerRemotes.GetWaitingWorkers.InvokeServer, WorkerRemotes.GetWaitingWorkers)
        if ok then
            candidates = type(list) == "table" and list or {}
            hiredRoles = type(roles) == "table" and roles or {}
        end
        local ok2, info = pcall(StaffRemotes.GetStaffInfo.InvokeServer, StaffRemotes.GetStaffInfo)
        if ok2 and type(info) == "table" then staffInfo = info end
    end

    local function hire(worker, role)
        if not worker then return false, "No candidate selected" end
        if hiredRoles[role] then return false, role .. " is already taken" end
        local ok, res, msg = pcall(WorkerRemotes.HireWorker.InvokeServer, WorkerRemotes.HireWorker, worker.Name, role)
        if ok and res then hiredRoles[role] = true end
        return ok and res, tostring(msg or (ok and "" or res))
    end

    -- Rarest wanted candidate first, then least sleepy, then fastest.
    local function bestCandidate()
        local best, bestRank, bestSleep, bestSpeed
        for _, w in ipairs(candidates) do
            local rarity = tostring(w.Rarity)
            if wantedRarities[rarity] and (tonumber(w.Wage) or math.huge) <= maxWage then
                local rank = rarityRank[rarity] or 0
                local sleep = tonumber(w.SleepChance) or 100
                local speed = tonumber(w.Speed) or 0
                if not best or rank > bestRank
                    or (rank == bestRank and (sleep < bestSleep or (sleep == bestSleep and speed > bestSpeed))) then
                    best, bestRank, bestSleep, bestSpeed = w, rank, sleep, speed
                end
            end
        end
        return best
    end

    local function applications()
        return staffInfo and type(staffInfo.Applications) == "table" and staffInfo.Applications or {}
    end

    local function staffList()
        return staffInfo and type(staffInfo.Staff) == "table" and staffInfo.Staff or {}
    end

    local function respond(userId, accept)
        local ok, res, msg = pcall(StaffRemotes.RespondApplication.InvokeServer, StaffRemotes.RespondApplication, userId, accept)
        return ok and res, tostring(msg or "")
    end

    local function shortName(modelName)
        return tostring(modelName):match("^([^_]+)") or tostring(modelName)
    end

    local function userItems(list)
        local items = {}
        for _, entry in ipairs(list) do items[#items + 1] = { Name = tostring(entry.UserId), Icon = "user" } end
        return items
    end

    -- Data thread: server calls and grid SetItems only (grids redraw on their own loop).
    task.spawn(function()
        while scriptAlive() do
            refreshData()
            if applicantGrid then pcall(function() applicantGrid:SetItems(userItems(applications())) end) end
            if staffGrid then pcall(function() staffGrid:SetItems(userItems(staffList())) end) end

            if autoHire then
                for _, role in ipairs(ROLES) do
                    if rolesToFill[role] and not hiredRoles[role] then
                        local pick = bestCandidate()
                        if pick then
                            local ok, msg = hire(pick, role)
                            if ok then
                                for i, w in ipairs(candidates) do
                                    if w == pick then table.remove(candidates, i) break end
                                end
                            end
                            notify("Staff", (ok and "Hired " or "Hire failed: ") .. shortName(pick.Name) .. " (" .. role .. ") " .. msg, ok and "Success" or "Warning")
                        end
                    end
                end

                -- RollWorker("GetCost") → (ok, _, cost); RollWorker("Roll") spawns a new set of candidates.
                local roleFree = false
                for _, role in ipairs(ROLES) do
                    if rolesToFill[role] and not hiredRoles[role] then roleFree = true end
                end
                if roleFree and autoRoll and not bestCandidate() and os.clock() - lastRoll > 15 then
                    lastRoll = os.clock()
                    local pOk, ok, _, cost = pcall(WorkerRemotes.RollWorker.InvokeServer, WorkerRemotes.RollWorker, "GetCost")
                    cost = tonumber(cost)
                    if pOk and ok and cost and cost <= maxRollCost then
                        local rOk, res, msg = pcall(WorkerRemotes.RollWorker.InvokeServer, WorkerRemotes.RollWorker, "Roll")
                        notify("Staff", "Roll ₱" .. cost .. ": " .. tostring(msg or (rOk and "done" or res)), (rOk and res) and "Success" or "Warning")
                    end
                end
            end

            if autoAccept and staffInfo then
                local room = (tonumber(staffInfo.MaxStaff) or 3) - #staffList()
                for _, app in ipairs(applications()) do
                    if room <= 0 then break end
                    if respond(app.UserId, true) then room = room - 1 end
                end
            end

            task.wait(5)
        end
    end)

    -- Hired workers live at the workspace root (verified live), tagged WorkerPlot = our restaurant.
    local function sleepingWorkers()
        local list = {}
        local k = myRestaurant()
        for _, m in ipairs(workspace:GetChildren()) do
            if m:IsA("Model") and m:GetAttribute("IsWorker") == true and m:GetAttribute("IsSleeping") == true
                and (not k or m:GetAttribute("WorkerPlot") == k.Name) then
                list[#list + 1] = m
            end
        end
        return list
    end

    -- The remote used to be enough on its own, from anywhere (Zachary, 2026-09-12). The server now checks
    -- the distance between the player and the worker: measured live 2026-09-18, four fires at 22.6 studs
    -- were ignored, the same four at 20.0 woke it on the spot.
    -- Two ways to close that gap, tried in that order:
    --   1. bring the worker over, like the runaways - the character never moves, so nothing else is
    --      disturbed. Their HumanoidRootPart is already Anchored by the game and a client-side PivotTo
    --      sticks (checked live: 0 studs of slide back after 2s).
    --   2. if that did not take, hop the character next to them and back. This is the one that was
    --      actually measured, so it stays as the fallback.
    local WAKE_RANGE = 12
    local WAKE_SHOTS = 4
    -- Same lesson as the runaways: let the server take the moved position before firing.
    local PIN_SETTLE = 0.1

    local function fireWake(worker)
        pcall(function() WorkerRemotes.WakeWorkerEvent:FireServer(worker.Name) end)
    end

    local function stillAsleep(worker)
        return worker.Parent ~= nil and worker:GetAttribute("IsSleeping") == true
    end

    -- Land between us and the worker rather than on a fixed side, which would sometimes be inside a wall.
    local function hopPlayerBeside(target)
        local root = rootPart()
        if not root then return end
        local away = Vector3.new(root.Position.X - target.X, 0, root.Position.Z - target.Z)
        away = away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)
        root.CFrame = CFrame.new(target + away * 3 + Vector3.new(0, root.Position.Y - target.Y, 0))
    end

    local function wake(worker)
        local ok, err = pcall(function()
            if not ensureWeapon() then return end
            local at = worker:FindFirstChild("HumanoidRootPart")
            local me = rootPart()
            if not (at and me) then return end

            if (me.Position - at.Position).Magnitude <= WAKE_RANGE then
                for _ = 1, WAKE_SHOTS do
                    if not stillAsleep(worker) then return end
                    fireWake(worker)
                    task.wait(0.3)
                end
                return
            end

            -- Same trick as the runaways, and the pan wakes workers too (MeleeWeapon.canWakeWorkers):
            -- swing at the pinned worker, and fire the remote as well since that one was measured to
            -- work at this range.
            local home = markHome(worker)
            for _ = 1, WAKE_SHOTS do
                if not stillAsleep(worker) then break end
                if not pinInFront(worker, 4) then break end
                task.wait(PIN_SETTLE)
                if not stillAsleep(worker) then break end
                fireWake(worker)
                swingWeapon()
                local until_ = os.clock() + 0.8
                while os.clock() < until_ and stillAsleep(worker) and scriptAlive() do
                    pinInFront(worker, 4)
                    task.wait(0.1)
                end
            end
            unpin(worker, home)

            -- Fallback: the measured one. Four fires at 22.6 studs were ignored, the same at 20.0 woke it.
            if stillAsleep(worker) then
                withCharacter(function()
                    local root = rootPart()
                    if not root then return end
                    local back = root.CFrame
                    hopPlayerBeside(at.Position)
                    task.wait(0.3)
                    for _ = 1, WAKE_SHOTS do
                        if not stillAsleep(worker) then break end
                        fireWake(worker)
                        task.wait(0.3)
                    end
                    local root2 = rootPart()
                    if root2 then root2.CFrame = back end
                end)
            end
        end)
        if not ok then warn("[Karinderya] " .. tostring(err)) end
    end

    task.spawn(function()
        while scriptAlive() do
            if autoWake then
                for _, worker in ipairs(sleepingWorkers()) do
                    wake(worker)
                end
            end
            task.wait(3)
        end
    end)

