local IngredientsController = (function()
    local buyEnabled = false
    local buyWorkerToken = 0
    local restockBelow = 10
    local keepCash = 1000
    local wanted = {}
    local ingredientsCache

    local function safeRequire(moduleScript)
        local ok, mod = pcall(require, moduleScript)
        return ok and mod or nil
    end

    local function config()
        ingredientsCache = ingredientsCache or safeRequire(Modules.IngredientsConfig)
        return ingredientsCache or {}
    end

    local function stock(name)
        local folder = LocalPlayer:FindFirstChild("Ingredients")
        local v = folder and folder:FindFirstChild(name)
        return v and v.Value or 0
    end

    local function cash()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        local v = ls and ls:FindFirstChild("Cash")
        return v and tonumber(v.Value) or 0
    end

    local function affordable(name)
        local cfg = config()[name]
        return cfg ~= nil and cash() - (tonumber(cfg.Cost) or 0) >= keepCash
    end

    -- Same rule as the game's GroceryController: refused only once stock has reached MaxStock.
    -- (Rice yields 100 per pack with a max of 100, so "stock + yield <= max" never bought it.)
    local function canHold(name)
        local cfg = config()[name]
        if not cfg then return false end
        return stock(name) < (cfg.MaxStock or 100)
    end

    -- Remote shape from GroceryController: (name, packs, "Cash") -> ok, message.
    local function buy(name)
        if not canHold(name) then return false end
        local ok, bought, message = pcall(BuyIngredientRemote.InvokeServer, BuyIngredientRemote, name, 1, "Cash")
        if ok and bought then
            Live.bought = Live.bought + 1
            local cfg = config()[name]
            Webhook.Purchase("Grocery", name, cfg and cfg.Cost or 0)
            return true
        end
        if ok and message then warn("[Karinderya] buy " .. name .. ": " .. tostring(message)) end
        return false
    end

    local function invalidateBuyWorker()
        buyWorkerToken = buyWorkerToken + 1
    end

    local function startBuyWorker()
        invalidateBuyWorker()
        local token = buyWorkerToken
        if not buyEnabled then return end

        task.spawn(function()
            while buyEnabled and token == buyWorkerToken and scriptAlive() do
                -- Lowest stock (relative to its max) first, so cash goes where it is needed most.
                local order = {}
                for name in pairs(wanted) do
                    if config()[name] and stock(name) < restockBelow then order[#order + 1] = name end
                end
                table.sort(order, function(a, b)
                    return stock(a) / (config()[a].MaxStock or 100) < stock(b) / (config()[b].MaxStock or 100)
                end)
                for _, name in ipairs(order) do
                    if not (buyEnabled and token == buyWorkerToken) then break end
                    if affordable(name) and buy(name) then task.wait(0.4) end
                end
                task.wait(3)
            end
        end)
    end

    local names, defaults = {}, {}
    for name, cfg in pairs(config()) do
        if type(cfg) == "table" then
            names[#names + 1] = name
            if cfg.Category ~= "Softdrinks" then defaults[#defaults + 1] = name end
        end
    end
    local function byLayout(a, b)
        return (config()[a].LayoutOrder or 99) < (config()[b].LayoutOrder or 99)
    end
    table.sort(names, byLayout)
    wanted = toSet(defaults)

    local all, byCategory, categories = {}, {}, {}
    for _, name in ipairs(names) do
        local item = { Name = name, Icon = config()[name].Image }
        all[#all + 1] = item
        local category = config()[name].GroceryCategory or "Others"
        if not byCategory[category] then
            byCategory[category] = {}
            categories[#categories + 1] = category
        end
        table.insert(byCategory[category], item)
    end
    table.sort(categories)
    local groups = { { Label = "All", Items = all } }
    for _, category in ipairs(categories) do
        groups[#groups + 1] = { Label = category, Items = byCategory[category] }
    end

    GroceryTab:CreateSection("Auto restock")

    GroceryTab:CreateToggle({
        Name = "Auto buy ingredients",
        Desc = "Buys one pack of each selected ingredient when its stock drops below the threshold",
        Default = false,
        Flag = "KarinderyaAutoBuy",
        Callback = function(enabled)
            buyEnabled = enabled
            if enabled then startBuyWorker() else invalidateBuyWorker() end
        end,
    })

    GroceryTab:CreateSlider({
        Name = "Restock below",
        Desc = "Stock level that triggers a purchase",
        Min = 1, Max = 90, Step = 1, Default = restockBelow,
        Flag = "KarinderyaRestockBelow",
        Callback = function(v) restockBelow = tonumber(v) or restockBelow end,
    })

    GroceryTab:CreateSlider({
        Name = "Keep cash",
        Desc = "Never buy if it would drop your cash below this",
        Min = 0, Max = 50000, Step = 500, Default = keepCash, Suffix = " ₱",
        Flag = "KarinderyaKeepCash",
        Callback = function(v) keepCash = tonumber(v) or keepCash end,
    })

    GroceryTab:CreateButton({
        Name = "Restock everything now",
        Desc = "One pass over the selected ingredients, ignoring the threshold",
        Callback = function()
            task.spawn(function()
                local n = 0
                for name in pairs(wanted) do
                    while canHold(name) and affordable(name) and buy(name) do
                        n = n + 1
                        task.wait(0.4)
                    end
                end
                notify("Grocery", n .. " pack(s) bought", "Success")
            end)
        end,
    })

    GroceryTab:CreateSection("Ingredients to keep stocked")

    local grid = GroceryTab:CreateFilteredCardGrid({
        Name = "Ingredients",
        Desc = "Selected cards are restocked. Softdrinks need the repaired chiller.",
        Groups = groups,
        FilterName = "Aisle",
        Columns = 4,
        CardHeight = 110,
        Flag = "KarinderyaBuyCards",
        Callback = function(selectedSet) wanted = selectedSet end,
        OnCardCreated = function(name, label)
            local title = config()[name] and config()[name].Name or name
            while label.Parent and scriptAlive() do
                label.Text = title .. " (" .. stock(name) .. ")"
                task.wait(1)
            end
        end,
    })
    pcall(function() grid:Set(defaults, true) end)

    return {
        IsBuying = function() return buyEnabled end,
        Buy = buy,
        Stock = stock,
    }
end)()

-- SHOP

local ShopController = (function()
    local ShopRemotes = Remotes.ShopRemotes
    local CATEGORIES = { "Tables", "Chairs", "Stoves", "Materials", "Paints", "Tiles" }
    local CONFIG_MODULES = {
        Tables = "TableConfig", Chairs = "ChairConfig", Stoves = "StoveConfig",
        Materials = "MaterialConfig", Paints = "PaintConfig", Tiles = "TileConfig",
    }

    local autoBuy, keepCash = false, 5000
    local wanted = {}
    local items = {}
    local restockAt, restockPending = nil, true
    local configCache = {}
    local grid

    local function safeRequire(moduleScript)
        local ok, mod = pcall(require, moduleScript)
        return ok and mod or nil
    end

    local function itemConfig(category, key)
        if configCache[category] == nil then
            local mod = Modules:FindFirstChild(CONFIG_MODULES[category] or "")
            configCache[category] = mod and safeRequire(mod) or false
        end
        local cfg = configCache[category]
        return cfg and cfg[key] or nil
    end

    -- Tables/Chairs/Stoves configs carry Price, Paints/Materials/Tiles carry Cost (the game's own
    -- ShopController remaps Cost into Price before sending). Tiles drop to ₱1 during a Piso sale,
    -- Removers excepted. Verified live 2026-09-16 — a wrong price is refused.
    local function priceOf(item)
        local cfg = itemConfig(item.Category, item.Key)
        if not cfg then return 0 end
        if item.Category == "Tiles" and workspace:GetAttribute("PisoSaleTiles") == true and not cfg.Remover then
            return 1
        end
        return tonumber(cfg.Price or cfg.Cost) or 0
    end

    local function cash()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        local v = ls and ls:FindFirstChild("Cash")
        return v and tonumber(v.Value) or 0
    end

    local function short(n)
        n = tonumber(n) or 0
        if n >= 1e6 then return string.format("%.1fM", n / 1e6) end
        if n >= 1e3 then return string.format("%.1fk", n / 1e3) end
        return tostring(math.floor(n))
    end

    -- GetShopInfo → ({[Category] = {{Key, Stock, SystemType, Category}}}, secondsUntilRestock).
    local function refresh()
        local ok, data, seconds = pcall(ShopRemotes.GetShopInfo.InvokeServer, ShopRemotes.GetShopInfo)
        if not (ok and type(data) == "table") then return false end
        local fresh, changed = {}, false
        for _, category in ipairs(CATEGORIES) do
            for _, entry in ipairs(type(data[category]) == "table" and data[category] or {}) do
                if type(entry) == "table" and entry.Key ~= nil then
                    local id = category .. ":" .. tostring(entry.Key)
                    fresh[id] = { Key = tostring(entry.Key), Category = category, SystemType = entry.SystemType, Stock = tonumber(entry.Stock) or 0 }
                    if not items[id] then changed = true end
                end
            end
        end
        items = fresh
        if tonumber(seconds) then restockAt = os.clock() + tonumber(seconds) end
        return changed
    end

    local function groups()
        local out = {}
        for _, category in ipairs(CATEGORIES) do
            local list = {}
            for id, item in pairs(items) do
                if item.Category == category then
                    local cfg = itemConfig(category, item.Key)
                    list[#list + 1] = { Name = id, Icon = cfg and (cfg.Icon or cfg.Image) or "package", order = cfg and cfg.LayoutOrder or 99 }
                end
            end
            table.sort(list, function(a, b) return a.order < b.order end)
            if #list > 0 then out[#out + 1] = { Label = category, Items = list } end
        end
        return out
    end

    -- Same call as the game's ShopController: (SystemType, Category, Key, priceOf(item)) → ok, message.
    -- "The price changed" means our price is stale (a Piso sale started or ended): re-read and retry once.
    local function buy(item)
        local lastMsg = "refused"
        for _ = 1, 2 do
            local ok, res, msg = pcall(ShopRemotes.BuyFurniture.InvokeServer, ShopRemotes.BuyFurniture,
                item.SystemType, item.Category, item.Key, priceOf(item))
            if ok and res then
                item.Stock = math.max(0, item.Stock - 1)
                local named = itemConfig(item.Category, item.Key)
                Webhook.Purchase("Shop", named and named.Name or item.Key, priceOf(item))
                return true, ""
            end
            lastMsg = tostring(ok and (msg or "refused") or res)
            if not string.find(string.lower(lastMsg), "price") then break end
            task.wait(0.3)
        end
        item.Stock = 0
        return false, lastMsg
    end

    local function displayName(item)
        local cfg = itemConfig(item.Category, item.Key)
        return cfg and cfg.Name or item.Key
    end

    local function buySelected(respectReserve)
        local bought = 0
        for id in pairs(wanted) do
            local item = items[id]
            if item and item.Stock > 0 and (not respectReserve or cash() - priceOf(item) >= keepCash) then
                local ok, msg = buy(item)
                if ok then bought = bought + 1 end
                notify("Shop", (ok and "Bought " or "Failed: ") .. displayName(item) .. (ok and "" or (" — " .. msg)), ok and "Success" or "Warning")
                task.wait(0.5)
            end
        end
        return bought
    end

    pcall(function()
        ShopRemotes.ShopRestocked.OnClientEvent:Connect(function() restockPending = true end)
    end)

    -- Data thread: server calls and grid SetGroups only (the grid redraws on its own loop).
    task.spawn(function()
        local lastRefresh = 0
        while scriptAlive() do
            if restockPending or os.clock() - lastRefresh > 15 then
                restockPending = false
                lastRefresh = os.clock()
                if refresh() and grid then pcall(function() grid:SetGroups(groups()) end) end
            end
            if autoBuy then buySelected(true) end
            task.wait(2)
        end
    end)

    ShopTab:CreateSection("Auto buy")

    ShopTab:CreateToggle({
        Name = "Auto buy selected items",
        Desc = "Buys every selected item as soon as it is in stock (spends cash)",
        Default = false,
        Flag = "KarinderyaAutoShop",
        Callback = function(enabled) autoBuy = enabled end,
    })

    ShopTab:CreateSlider({
        Name = "Keep cash",
        Desc = "Never buy if it would drop your cash below this",
        Min = 0, Max = 1000000, Step = 5000, Default = keepCash, Suffix = " ₱",
        Flag = "KarinderyaShopKeepCash",
        Callback = function(v) keepCash = tonumber(v) or keepCash end,
    })

    ShopTab:CreateLabel({
        Text = "Restock: —",
        UpdateRate = 1,
        Update = function()
            if not restockAt then return "Restock: —" end
            local s = math.max(0, math.floor(restockAt - os.clock()))
            return string.format("Next restock in %02d:%02d", math.floor(s / 60), s % 60)
        end,
    })

    ShopTab:CreateSection("Items")

    grid = ShopTab:CreateFilteredCardGrid({
        Name = "Shop items",
        Desc = "Select what Auto buy grabs. Name, price and stock left. Bought furniture goes to your inventory.",
        Groups = {},
        FilterName = "Category",
        Columns = 4,
        CardHeight = 110,
        EmptyText = "Loading the shop…",
        Flag = "KarinderyaShopItems",
        Callback = function(set) wanted = set end,
        OnCardCreated = function(id, label)
            while label.Parent and scriptAlive() do
                local item = items[id]
                if item then
                    label.Text = string.format("%s ₱%s (%d)", displayName(item), short(priceOf(item)), item.Stock)
                end
                task.wait(1)
            end
        end,
    })

    ShopTab:CreateButton({
        Name = "Buy selected now",
        Desc = "Buys every selected item in stock, ignoring Keep cash",
        Callback = function()
            task.spawn(function()
                notify("Shop", buySelected(false) .. " item(s) bought", "Success")
            end)
        end,
    })

    return {
        Items = function() return items end,
        Buy = buy,
        CanAfford = function(item) return cash() - priceOf(item) >= keepCash end,
        DisplayName = displayName,
    }
end)()

-- AUTO PLACE

local AutoPlaceController = (function()
    local PlaceFurnitureEvent = Remotes.PlaceFurnitureEvent
    local SPECS = {
        { Category = "Tables", System = "Dining", Module = "TableConfig" },
        { Category = "Chairs", System = "Dining", Module = "ChairConfig" },
        { Category = "Stoves", System = "Kitchen", Module = "StoveConfig" },
    }
    local placeEnabled = false
    local placeWorkerToken = 0
    local configCache = {}
    local strikes = {}
    local status = {}

    local function safeRequire(moduleScript)
        local ok, mod = pcall(require, moduleScript)
        return ok and mod or nil
    end

    local function config(spec)
        if configCache[spec.Module] == nil then
            local mod = Modules:FindFirstChild(spec.Module)
            configCache[spec.Module] = mod and safeRequire(mod) or false
        end
        return configCache[spec.Module] or nil
    end

    -- Best = most stars, then highest price (the bonuses grow with both). Empty slot = -1, unknown item = 0.
    local function score(spec, key)
        if not key then return -1 end
        local cfg = config(spec)
        local item = cfg and cfg[key]
        if type(item) ~= "table" then return 0 end
        return (tonumber(item.Stars) or 0) * 1e7 + (tonumber(item.Price) or 0)
    end

    -- Same rule as the game's Customize UIs: a model in ReplicatedStorage.Models.<System>.<Category>
    -- and a FurnitureInventory.<Category>_<Key> count above 0.
    local function owned(spec)
        local list = {}
        local models = ReplicatedStorage:FindFirstChild("Models")
        local folder = models and models:FindFirstChild(spec.System)
        folder = folder and folder:FindFirstChild(spec.Category)
        local inventory = LocalPlayer:FindFirstChild("FurnitureInventory")
        if not (folder and inventory) then return list end
        for _, model in ipairs(folder:GetChildren()) do
            local id = spec.Category .. "_" .. model.Name
            local count = inventory:FindFirstChild(id)
            if count and count.Value > 0 and (strikes[id] or 0) < 3 then
                list[#list + 1] = { Key = model.Name, Score = score(spec, model.Name) }
            end
        end
        table.sort(list, function(a, b) return a.Score > b.Score end)
        return list
    end

    local function currentKey(slot, spec)
        local holder
        if spec.Category == "Tables" then
            holder = slot:FindFirstChild("CurrentTable")
        elseif spec.Category == "Chairs" then
            holder = slot:FindFirstChild("CurrentChair")
        else
            holder = slot:FindFirstChild("CurrentBuilding")
        end
        local item = holder and holder:GetChildren()[1]
        return item and (item:GetAttribute("OriginalItemName") or item.Name) or nil
    end

    local function slots(k, spec)
        local prefix = spec.System == "Dining" and "^DiningPlot" or "^KitchenPlot"
        local list = {}
        for _, plot in ipairs(k:GetChildren()) do
            if plot.Name:match(prefix) then
                for _, slot in ipairs(plot:GetChildren()) do
                    local promptPartOf = slot:FindFirstChild("PromptPart")
                    local prompt = promptPartOf and promptPartOf:FindFirstChildOfClass("ProximityPrompt")
                    -- Locked tables show "Buy - ₱…" instead of "Customize".
                    if slot:IsA("Model") and prompt and prompt.ActionText == "Customize" then
                        list[#list + 1] = slot
                    end
                end
            end
        end
        return list
    end

    -- The server swaps the model in ~0.3s (measured live), but poll instead of a fixed wait so a
    -- laggy pass is not mistaken for a refusal. A key is only dropped after 3 real failures.
    local function confirm(slot, spec, key)
        local deadline = os.clock() + 3
        while os.clock() < deadline do
            if currentKey(slot, spec) == key then return true end
            task.wait(0.2)
        end
        return false
    end

    local function placeBest(k)
        local placed = 0
        for _, spec in ipairs(SPECS) do
            local stock = owned(spec)
            local targets = slots(k, spec)
            local stopped
            if #stock == 0 then
                status[spec.Category] = "nothing in inventory"
            elseif #targets == 0 then
                status[spec.Category] = "no unlocked slot"
            else
                table.sort(targets, function(a, b)
                    return score(spec, currentKey(a, spec)) < score(spec, currentKey(b, spec))
                end)
                for _, slot in ipairs(targets) do
                    local best = stock[1]
                    if not best or best.Score <= score(spec, currentKey(slot, spec)) then
                        stopped = string.format("best owned %s does not beat %s", best and best.Key or "-",
                            tostring(currentKey(slot, spec)))
                        break
                    end
                    -- Same call as CustomizeDining/KitchenController: (slot, category, key, system).
                    PlaceFurnitureEvent:FireServer(slot, spec.Category, best.Key, spec.System)
                    if confirm(slot, spec, best.Key) then
                        placed = placed + 1
                        strikes[spec.Category .. "_" .. best.Key] = nil
                        notify("Auto place", best.Key .. " → " .. slot.Name, "Success")
                    else
                        local id = spec.Category .. "_" .. best.Key
                        strikes[id] = (strikes[id] or 0) + 1
                        stopped = best.Key .. " refused (" .. strikes[id] .. "/3)"
                    end
                    stock = owned(spec)
                end
                status[spec.Category] = stopped or "every slot has the best owned"
            end
        end
        return placed
    end

    local function invalidatePlaceWorker()
        placeWorkerToken = placeWorkerToken + 1
    end

    local function startPlaceWorker()
        invalidatePlaceWorker()
        local token = placeWorkerToken
        if not placeEnabled then return end

        task.spawn(function()
            while placeEnabled and token == placeWorkerToken and scriptAlive() do
                local k = myRestaurant()
                if k then pcall(placeBest, k) end
                task.wait(10)
            end
        end)
    end

    ShopTab:CreateSection("Auto place")

    ShopTab:CreateToggle({
        Name = "Auto place best furniture",
        Desc = "Puts your best tables, chairs and stoves (most stars, then price) wherever they beat what is placed",
        Default = false,
        Flag = "KarinderyaAutoPlace",
        Callback = function(enabled)
            placeEnabled = enabled
            if enabled then startPlaceWorker() else invalidatePlaceWorker() end
        end,
    })

    ShopTab:CreateButton({
        Name = "Place best now",
        Desc = "One pass right now; also retries items that were refused before",
        Callback = function()
            task.spawn(function()
                table.clear(strikes)
                local k = myRestaurant()
                local ok, n = pcall(placeBest, k)
                notify("Auto place", (ok and n or 0) .. " item(s) placed", "Success")
            end)
        end,
    })

    -- Placing quietly does nothing most of the time (the inventory is usually worse than what is
    -- already down), so say so per category instead of looking broken.
    ShopTab:CreateLabel({
        Text = "Idle",
        UpdateRate = 2,
        Update = function()
            local parts = {}
            for _, spec in ipairs(SPECS) do
                parts[#parts + 1] = spec.Category .. ": " .. (status[spec.Category] or "not checked yet")
            end
            return table.concat(parts, " · ")
        end,
    })

    -- Auto upgrade (Zachary): take the weakest placed item of each category, buy the next shop tier above
    -- it until every slot can have it, place, repeat. Tiers are ranked like placeBest (stars, then price).
    local upgradeEnabled = false
    local upgradeWorkerToken = 0

    local function ownedCount(spec, key)
        local inventory = LocalPlayer:FindFirstChild("FurnitureInventory")
        local v = inventory and inventory:FindFirstChild(spec.Category .. "_" .. key)
        return v and v.Value or 0
    end

    local function upgradePass(k)
        placeBest(k)
        for _, spec in ipairs(SPECS) do
            local targets = slots(k, spec)
            if #targets > 0 then
                local worst = math.huge
                for _, slot in ipairs(targets) do
                    worst = math.min(worst, score(spec, currentKey(slot, spec)))
                end
                local ladder = {}
                for _, item in pairs(ShopController.Items()) do
                    if item.Category == spec.Category then
                        ladder[#ladder + 1] = { item = item, score = score(spec, item.Key) }
                    end
                end
                table.sort(ladder, function(a, b) return a.score < b.score end)
                -- Cheapest tier above the worst slot that is actually in stock: stopping on a
                -- sold-out tier used to stall the whole upgrade until the next restock.
                local nextTier
                for _, entry in ipairs(ladder) do
                    if entry.score > worst and entry.item.Stock > 0 then nextTier = entry break end
                end
                if nextTier then
                    local need = 0
                    for _, slot in ipairs(targets) do
                        if score(spec, currentKey(slot, spec)) < nextTier.score then need = need + 1 end
                    end
                    local item = nextTier.item
                    while upgradeEnabled and ownedCount(spec, item.Key) < need and item.Stock > 0 and ShopController.CanAfford(item) do
                        if not ShopController.Buy(item) then break end
                        notify("Upgrade", "Bought " .. ShopController.DisplayName(item) .. " (next " .. spec.Category .. " tier)", "Success")
                        task.wait(0.5)
                    end
                end
            end
        end
        placeBest(k)
    end

    local function invalidateUpgradeWorker()
        upgradeWorkerToken = upgradeWorkerToken + 1
    end

    local function startUpgradeWorker()
        invalidateUpgradeWorker()
        local token = upgradeWorkerToken
        if not upgradeEnabled then return end

        task.spawn(function()
            while upgradeEnabled and token == upgradeWorkerToken and scriptAlive() do
                local k = myRestaurant()
                if k then pcall(upgradePass, k) end
                task.wait(10)
            end
        end)
    end

    ShopTab:CreateSection("Auto upgrade furniture")

    ShopTab:CreateToggle({
        Name = "Auto upgrade furniture",
        Desc = "Buys the next tier of tables, chairs and stoves until every slot has it, places it, then the next tier (spends cash, respects Keep cash)",
        Default = false,
        Flag = "KarinderyaAutoUpgradeFurniture",
        Callback = function(enabled)
            upgradeEnabled = enabled
            if enabled then startUpgradeWorker() else invalidateUpgradeWorker() end
        end,
    })

    return {}
end)()

-- MERCHANT

-- Two travelling merchants, each announced by a workspace attribute: GlobalMerchantEvent (Rolando's
-- furniture cart: 5 of 13 items get 1 stock each) and GlobalMerchant2Event (the bread cart).
-- BuyMerchantItem:InvokeServer(key) and BuyMerchant2Item:InvokeServer() both return (ok, message).
local MerchantController = (function()
    local MerchantRemotes = Remotes.MerchantRemotes
    local Merchant2Remotes = Remotes.Merchant2Remotes
    local BREAD = "Bread"

    local autoBuy, keepCash = false, 5000
    local wanted = {}
    local live = {}
    local bread = { Stock = 0, Price = 0 }
    local grid, pending, lastSeen = nil, true, nil
    local configCache = {}

    local function safeRequire(moduleScript)
        local ok, mod = pcall(require, moduleScript)
        return ok and mod or nil
    end

    local function merchantConfig()
        if configCache.Merchant == nil then
            local mod = Modules:FindFirstChild("MerchantConfig")
            configCache.Merchant = mod and safeRequire(mod) or false
        end
        return configCache.Merchant or nil
    end

    local function furnitureItem(category, key)
        if configCache.Furniture == nil then
            local mod = Modules:FindFirstChild("FurnitureConfig")
            configCache.Furniture = mod and safeRequire(mod) or false
        end
        local fc = configCache.Furniture
        if not (fc and fc.GetItemConfig) then return nil end
        local ok, item = pcall(fc.GetItemConfig, "Dining", category, key)
        return ok and type(item) == "table" and item or nil
    end

    -- Static catalogue so the cards exist while the merchant is away: MerchantConfig.Order is its own
    -- display order, Items[key].Category is Tables / Chairs / Weapons. Weapons carry their own price
    -- and icon; furniture takes both from FurnitureConfig.
    local function catalogue()
        local cfg = merchantConfig()
        local list = {}
        if cfg and type(cfg.Order) == "table" and type(cfg.Items) == "table" then
            for i, key in ipairs(cfg.Order) do
                local entry = cfg.Items[key]
                if type(entry) == "table" then
                    local category = entry.Category or "Others"
                    local item = category ~= "Weapons" and furnitureItem(category, key) or nil
                    list[#list + 1] = {
                        Key = key,
                        Category = category,
                        Name = entry.Name or (item and item.Name) or key,
                        Icon = entry.Icon or (item and item.Icon) or "package",
                        Price = tonumber(entry.Price) or (item and tonumber(item.Price)) or 0,
                        Order = i,
                    }
                end
            end
        end
        list[#list + 1] = { Key = BREAD, Category = BREAD, Name = "Bread", Icon = "croissant", Price = bread.Price, Order = 99 }
        return list
    end

    local function cash()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        local v = ls and ls:FindFirstChild("Cash")
        return v and tonumber(v.Value) or 0
    end

    local function present()
        return workspace:GetAttribute("GlobalMerchantEvent") == true
            or workspace:GetAttribute("GlobalMerchant2Event") == true
    end

    local function refresh()
        local ok, data = pcall(MerchantRemotes.GetMerchantStock.InvokeServer, MerchantRemotes.GetMerchantStock)
        local fresh = {}
        if ok and type(data) == "table" then
            for _, e in ipairs(data) do
                if type(e) == "table" and e.Key ~= nil then
                    fresh[tostring(e.Key)] = {
                        Stock = tonumber(e.Stock) or 0,
                        Price = tonumber(e.Price) or 0,
                        Owned = e.Owned == true,
                    }
                end
            end
        end
        live = fresh
        local ok2, d2 = pcall(Merchant2Remotes.GetMerchant2Stock.InvokeServer, Merchant2Remotes.GetMerchant2Stock)
        if ok2 and type(d2) == "table" then
            bread = { Stock = tonumber(d2.Stock) or 0, Price = tonumber(d2.Price) or 0 }
        end
    end

    local function priceOf(id)
        if id == BREAD then return bread.Price end
        local entry = live[id]
        if entry and entry.Price > 0 then return entry.Price end
        for _, item in ipairs(catalogue()) do
            if item.Key == id then return item.Price end
        end
        return 0
    end

    local function stockOf(id)
        if id == BREAD then return bread.Stock end
        local entry = live[id]
        return entry and entry.Stock or 0
    end

    local function buyOne(id)
        if id == BREAD then
            return pcall(Merchant2Remotes.BuyMerchant2Item.InvokeServer, Merchant2Remotes.BuyMerchant2Item)
        end
        return pcall(MerchantRemotes.BuyMerchantItem.InvokeServer, MerchantRemotes.BuyMerchantItem, id)
    end

    -- Weapons are one-time purchases (Owned), furniture is 1 stock per visit, bread can be stacked.
    local function buySelected(respectReserve)
        local bought = 0
        for id in pairs(wanted) do
            local entry = live[id]
            local guard = 0
            while stockOf(id) > 0 and not (entry and entry.Owned) and guard < 20
                and (not respectReserve or cash() - priceOf(id) >= keepCash) do
                guard = guard + 1
                local ok, res, msg = buyOne(id)
                local name = id
                if ok and res then
                    bought = bought + 1
                    Webhook.Purchase("Merchant", name, priceOf(id))
                    notify("Merchant", "Bought " .. name, "Success")
                else
                    notify("Merchant", "Failed: " .. name .. " — " .. tostring(ok and msg or res), "Warning")
                end
                task.wait(0.5)
                refresh()
                entry = live[id]
                if not (ok and res) then break end
            end
        end
        return bought
    end

    local function groups()
        local buckets, order = {}, { "Tables", "Chairs", "Weapons", BREAD }
        for _, item in ipairs(catalogue()) do
            local label = item.Category
            buckets[label] = buckets[label] or {}
            table.insert(buckets[label], { Name = item.Key, Icon = item.Icon, order = item.Order })
        end
        local out = {}
        for _, label in ipairs(order) do
