-- UPGRADES

local UpgradesController = (function()
    local MenuRemotes = Remotes.MenuRemotes
    local CounterRemotes = Remotes.CounterRemotes

    local autoMenus, keepEnabled, autoCounter, autoTables = false, false, false, false
    local tableInfo
    local keepCash = 10000
    local data
    local menuCache, counterCache

    local function safeRequire(moduleScript)
        local ok, mod = pcall(require, moduleScript)
        return ok and mod or nil
    end

    local function menus()
        menuCache = menuCache or safeRequire(Modules.MenuConfig)
        return menuCache and menuCache.List or {}
    end

    local function counters()
        counterCache = counterCache or safeRequire(Modules.CounterConfig)
        return counterCache or {}
    end

    -- Follows the Requirement links: Default → RedWood → ElegantWood → …
    local function counterChain()
        local chain, current = {}, "Default"
        for _ = 1, 30 do
            local nextKey
            for key, entry in pairs(counters()) do
                if type(entry) == "table" and entry.Requirement == current then nextKey = key break end
            end
            if not nextKey then break end
            chain[#chain + 1] = nextKey
            current = nextKey
        end
        return chain
    end

    local function served()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        local v = ls and ls:FindFirstChild("TotalServed")
        return v and tonumber(v.Value) or (data and tonumber(data.TotalServed)) or 0
    end

    local function cash()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        local v = ls and ls:FindFirstChild("Cash")
        return v and tonumber(v.Value) or 0
    end

    local function upgradeState(key)
        local all = data and data.CounterUpgrades
        return type(all) == "table" and all[key] or nil
    end

    local function isUnlocked(key)
        if key == "Default" then return true end
        local s = upgradeState(key)
        return s ~= nil and s.Unlocked == true
    end

    local function invoke(remote, ...)
        local ok, res, msg = pcall(remote.InvokeServer, remote, ...)
        return ok and res, tostring(msg or (ok and "" or res))
    end

    -- GetMenuData → {TotalServed, UnlockedMenus, EnabledMenus, CounterLevel, CounterUpgrades = {key = {Unlocked, IsUpgrading, EndTime}}}.
    local function refresh()
        local ok, result = pcall(MenuRemotes.GetMenuData.InvokeServer, MenuRemotes.GetMenuData)
        if ok and type(result) == "table" then data = result end
        return data ~= nil
    end

    local function menuPass()
        for _, menu in ipairs(menus()) do
            local unlocked = menu.Required <= 0 or (data.UnlockedMenus and data.UnlockedMenus[menu.Key] == true)
            if autoMenus and not unlocked and served() >= menu.Required then
                local ok, msg = invoke(MenuRemotes.UnlockMenu, menu.Key)
                notify("Menus", ok and (menu.DisplayName .. " unlocked!") or msg, ok and "Success" or "Warning")
                if ok then Webhook.Event("Upgrade", "Menu unlocked", menu.DisplayName, 10181046) end
                if ok then
                    data.UnlockedMenus = data.UnlockedMenus or {}
                    data.UnlockedMenus[menu.Key] = true
                    data.EnabledMenus = data.EnabledMenus or {}
                    data.EnabledMenus[menu.Key] = true
                end
            elseif keepEnabled and unlocked and not (data.EnabledMenus and data.EnabledMenus[menu.Key] == true) then
                if invoke(MenuRemotes.ToggleMenu, menu.Key, true) then
                    data.EnabledMenus = data.EnabledMenus or {}
                    data.EnabledMenus[menu.Key] = true
                end
            end
        end
    end

    local function counterPass()
        local chain = counterChain()
        -- Equip the best finished counter.
        local best = "Default"
        for _, key in ipairs(chain) do
            if isUnlocked(key) then best = key end
        end
        if best ~= "Default" and data.CounterLevel ~= best then
            local ok, msg = invoke(CounterRemotes.EquipCounterUpgrade, best)
            notify("Counter", ok and ("Equipped " .. best) or msg, ok and "Success" or "Warning")
            if ok then data.CounterLevel = best end
        end
        -- One upgrade at a time.
        for _, key in ipairs(chain) do
            local s = upgradeState(key)
            if s and s.IsUpgrading then return end
        end
        for _, key in ipairs(chain) do
            if not isUnlocked(key) then
                local entry = counters()[key]
                if entry and isUnlocked(entry.Requirement or "Default") and cash() - (tonumber(entry.Cost) or 0) >= keepCash then
                    local ok, msg = invoke(CounterRemotes.BuyCounterUpgrade, key)
                    notify("Counter", ok and ("Upgrading to " .. key) or msg, ok and "Success" or "Warning")
                    if ok then
                        Webhook.Event("Upgrade", "Counter upgrade started",
                            key .. " — ₱" .. tostring(entry.Cost), 10181046)
                    end
                end
                return
            end
        end
    end

    -- CustomizeDiningController: BuyTableEvent:InvokeServer("TableN") → (ok, msg), tables 7-12 in any order;
    -- price = (unlocked 7-12 count + 1) * 20000. GetUnlockedTables() → {Table7 = bool, …, Table12 = bool}.
    local function tablePass()
        local ok, unlocked = pcall(Remotes.GetUnlockedTables.InvokeServer, Remotes.GetUnlockedTables)
        if not (ok and type(unlocked) == "table") then return end
        local count, nextName = 0, nil
        for i = 7, 12 do
            local name = "Table" .. i
            if unlocked[name] == true then
                count = count + 1
            elseif not nextName then
                nextName = name
            end
        end
        local price = (count + 1) * 20000
        tableInfo = { count = count, nextName = nextName, price = price }
        if autoTables and nextName and cash() - price >= keepCash then
            local bought, msg = invoke(Remotes.BuyTableEvent, nextName)
            notify("Tables", bought and ("Unlocked " .. nextName .. "!") or msg, bought and "Success" or "Warning")
            if bought then
                Webhook.Event("Upgrade", "Table unlocked", nextName .. " — ₱" .. tostring(price), 10181046)
            end
        end
    end

    -- Data thread: all server calls here; the status label only reads `data`.
    task.spawn(function()
        while scriptAlive() do
            if (autoMenus or keepEnabled or autoCounter) and refresh() then
                pcall(menuPass)
                if autoCounter then pcall(counterPass) end
            elseif not data then
                refresh()
            end
            pcall(tablePass)
            task.wait(5)
        end
    end)

    UpgradesTab:CreateSection("Status")

    UpgradesTab:CreateLabel({
        Text = "Menus: —",
        UpdateRate = 1,
        Update = function()
            local nextMenu
            for _, menu in ipairs(menus()) do
                local unlocked = menu.Required <= 0 or (data and data.UnlockedMenus and data.UnlockedMenus[menu.Key] == true)
                if not unlocked then nextMenu = menu break end
            end
            if not nextMenu then return string.format("Served %d · every menu unlocked", served()) end
            return string.format("Served %d · next menu %s at %d", served(), nextMenu.DisplayName, nextMenu.Required)
        end,
    })

    UpgradesTab:CreateLabel({
        Text = "Counter: —",
        UpdateRate = 1,
        Update = function()
            if not data then return "Counter: —" end
            for _, key in ipairs(counterChain()) do
                local s = upgradeState(key)
                if s and s.IsUpgrading then
                    local left = math.max(0, math.floor((tonumber(s.EndTime) or 0) - os.time()))
                    return string.format("Counter %s · upgrading to %s (%02d:%02d)", tostring(data.CounterLevel), key, math.floor(left / 60), left % 60)
                end
                if not isUnlocked(key) then
                    local entry = counters()[key]
                    return string.format("Counter %s · next %s for ₱%s", tostring(data.CounterLevel), key, tostring(entry and entry.Cost))
                end
            end
            return "Counter " .. tostring(data.CounterLevel) .. " · max level"
        end,
    })

    UpgradesTab:CreateSection("Menus")

    UpgradesTab:CreateToggle({
        Name = "Auto unlock menus",
        Desc = "Unlocks each menu as soon as you have served enough customers (free)",
        Default = false,
        Flag = "KarinderyaAutoMenus",
        Callback = function(enabled) autoMenus = enabled end,
    })

    UpgradesTab:CreateToggle({
        Name = "Keep all menus enabled",
        Desc = "Turns back on any unlocked menu that is disabled",
        Default = false,
        Flag = "KarinderyaKeepMenusEnabled",
        Callback = function(enabled) keepEnabled = enabled end,
    })

    UpgradesTab:CreateSection("Counter")

    UpgradesTab:CreateToggle({
        Name = "Auto upgrade counter",
        Desc = "Buys the next counter upgrade when none is running, then equips the best finished one (spends cash)",
        Default = false,
        Flag = "KarinderyaAutoCounter",
        Callback = function(enabled) autoCounter = enabled end,
    })

    UpgradesTab:CreateSlider({
        Name = "Keep cash",
        Desc = "Never buy a counter upgrade or a table if it would drop your cash below this",
        Min = 0, Max = 2000000, Step = 10000, Default = keepCash, Suffix = " ₱",
        Flag = "KarinderyaUpgradeKeepCash",
        Callback = function(v) keepCash = tonumber(v) or keepCash end,
    })

    UpgradesTab:CreateSection("Tables")

    UpgradesTab:CreateLabel({
        Text = "Tables: —",
        UpdateRate = 1,
        Update = function()
            if not tableInfo then return "Tables: —" end
            if not tableInfo.nextName then return "Upstairs tables: all 6 unlocked" end
            return string.format("Upstairs tables: %d/6 unlocked · next %s for ₱%d", tableInfo.count, tableInfo.nextName, tableInfo.price)
        end,
    })

    UpgradesTab:CreateToggle({
        Name = "Auto buy tables",
        Desc = "Unlocks the next locked table (7-12) on your plot as soon as you can afford it above Keep cash",
        Default = false,
        Flag = "KarinderyaAutoBuyTables",
        Callback = function(enabled) autoTables = enabled end,
    })

    return {}
end)()

