-- ANTI-AFK (drop-in, PC + mobile, works with Roblox in background)
pcall(function()
	local env = (getgenv and getgenv()) or _G
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local VirtualInputManager = game:GetService("VirtualInputManager")
	local LocalPlayer = Players.LocalPlayer

	-- one instance per session even if several scripts paste this
	if env.__AKkiwiAntiAfk == LocalPlayer then return end
	env.__AKkiwiAntiAfk = LocalPlayer

	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

	local function nudge()
		local v = workspace.CurrentCamera.ViewportSize
		local x, y = v.X / 2, v.Y / 2

		-- F13: exists in Roblox, on no normal keyboard, bound by no game
		pcall(function()
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F13, false, game)
			task.wait(0.05)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F13, false, game)
		end)

		if touchOnly then
			-- 2px drag, not a tap: states 0 Begin / 1 Change / 2 End
			pcall(function()
				VirtualInputManager:SendTouchEvent(8, 0, x, y)
				task.wait(0.05)
				VirtualInputManager:SendTouchEvent(8, 1, x + 2, y)
				task.wait(0.05)
				VirtualInputManager:SendTouchEvent(8, 2, x + 2, y)
			end)
		else
			pcall(function()
				VirtualInputManager:SendMouseMoveEvent(x + 2, y, game)
				task.wait(0.05)
				VirtualInputManager:SendMouseMoveEvent(x, y, game)
			end)
		end
	end

	local idledConn = LocalPlayer.Idled:Connect(nudge)
	task.spawn(function()
		while LocalPlayer.Parent ~= nil do
			nudge()
			task.wait(60)
		end
		idledConn:Disconnect()
		if env.__AKkiwiAntiAfk == LocalPlayer then env.__AKkiwiAntiAfk = nil end
	end)
end)
