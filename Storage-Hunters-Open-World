-- =========================================================
-- PRIVATE SERVER WATCH -- are we still in the private server we were in?
--
-- Auto Reconnect has exactly one call available to it,
-- TeleportService:Teleport(placeId, player), and that call names no server:
-- it means "put me in this place" and ROBLOX picks which one. It normally
-- puts a private-server player back in their private server, but that is
-- Roblox's decision, not something we ask for. If the private server was
-- torn down while we were disconnected, the rejoin lands in a PUBLIC server
-- and nothing in the game says so -- RayVoid then restores the Auto Farm
-- toggle and the farm quietly runs in a stranger's server.
--
-- This must NOT depend on our own reconnect having driven the rejoin. Most
-- people execute the script by hand once they are already in a server, and
-- the routes back that we never see are the common ones: Roblox's own
-- Reconnect button, the game page, Auto Reconnect switched off, the executor
-- closed along with the game. A note dropped at teleport time only covers
-- rejoins we drove ourselves, which is the minority.
--
-- So: a rolling record instead. While the script runs in a private server it
-- rewrites SESSION.privateFile every minute. Any later execution -- ours on
-- arrival, or the user's own Execute click -- reads it and asks one question:
-- was I in a private server a moment ago, and am I in a public one now?
--
-- It lives HERE, at the top, because SESSION.landedPublic has to exist before
-- the Auto Farm toggle is built and before RayVoid restores its saved value.
-- =========================================================
SESSION.landedPublic = false
SESSION.privateFile = "SH-last-private.txt"
SESSION.privateId = (game.PrivateServerId or "")

function SESSION.WritePrivateRecord()
	if type(writefile) ~= "function" then
		return false
	end
	local ok, err = pcall(function()
		writefile(SESSION.privateFile, tostring(os.time()) .. " " .. SESSION.privateId)
	end)
	if not ok then
		warn("[Server] could not write " .. SESSION.privateFile .. ": " .. tostring(err))
	end
	return ok
end

function SESSION.ForgetPrivateRecord()
	pcall(function()
		if type(delfile) == "function" then
			delfile(SESSION.privateFile)
		elseif type(writefile) == "function" then
			writefile(SESSION.privateFile, "")
		end
	end)
end

do
	-- How long a private session stays "a moment ago". Long enough to cover a
	-- disconnect, the rejoin and a manual Execute afterwards; short enough that
	-- a deliberate public session later in the day is not second-guessed.
	local MEMORY = 1800

	if SESSION.privateId ~= "" then
		-- In a private server. Keep the record fresh for as long as we run, so a
		-- disconnect at hour three is covered as well as one at minute one. This
		-- also keeps it fresh right through our own retry loop, which can run for
		-- many minutes before Roblox takes the teleport.
		if not SESSION.WritePrivateRecord() then
			warn("[Server] this executor has no writefile -- if a rejoin drops you in a public server you will not be told")
		end
		task.spawn(function()
			while SESSION.alive do
				task.wait(60)
				if SESSION.alive then
					SESSION.WritePrivateRecord()
				end
			end
		end)
	elseif type(isfile) == "function" and type(readfile) == "function" then
		-- In a public server. If we were in a private one minutes ago, this is not
		-- where the user meant to end up.
		local ok, data = pcall(function()
			if isfile(SESSION.privateFile) then
				return readfile(SESSION.privateFile)
			end
			return nil
		end)
		if not ok then
			warn("[Server] could not read " .. SESSION.privateFile .. ": " .. tostring(data))
			data = nil
		end
		local wroteAt = tonumber(tostring(data):match("^(%d+)"))
		if wroteAt and (os.time() - wroteAt) < MEMORY then
			SESSION.landedPublic = true
			warn("[Server] THIS IS A PUBLIC SERVER. You were in a private server minutes ago, so the rejoin did "
				.. "not put you back -- the private server was most likely shut down while you were out.")
			warn("[Server] Auto Farm is blocked. Rejoin your private server yourself, or switch Auto Farm "
				.. "on a second time if you really want to farm in this server.")
		end
		-- The record is deliberately NOT consumed: a second Execute in the same
		-- public server has to warn again. It ages out on its own.
	end
end

-- Protected require(): returns the module or nil (+ warn) instead of
-- erroring. Replaces the "local ok, X = pcall(...)" pattern, which costs
-- 2 root-level locals per call site; Lua 5.1 caps root-level locals at
-- 200 and this file is close to the limit. Do not reintroduce that pattern.
local function SafeRequire(path, label)
	local ok, result = pcall(function()
		return require(path)
	end)
	if ok then
		return result
	end
	warn("[SafeRequire] " .. tostring(label) .. " unavailable: " .. tostring(result))
	return nil
end

-- Reads an item's mutation names by trying BOTH possible attribute
-- names ("Mutator" singular and "Mutators" plural). The game seems to
-- use one or the other depending on context/number of mutations, never
-- confirmed with certainty despite several contradictory in-game tests
-- -- so we read both and merge rather than guessing which one applies
-- where. Used by isItemBroken (carryables) AND FORCEBID.Check
-- (garage.Floorspace).
local function ReadMutatorNames(item)
	local names = {}
	for _, attrName in ipairs({ "Mutator", "Mutators" }) do
		local raw = item:GetAttribute(attrName)
		if type(raw) == "string" and raw ~= "" and raw ~= "[]" then
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
			if ok and type(decoded) == "table" then
				for _, mutation in ipairs(decoded) do
					if type(mutation) == "table" and type(mutation.name) == "string" then
						table.insert(names, mutation.name)
					end
				end
			end
		end
	end
	return names
end

-- Moved early in the file (used to be lower) so it can be used by
-- GetCarryablePrompts/CountOwnedCarryablePrompts as well as CollectItem.
local function isItemBroken(itemModel)
	if not itemModel then return false end
	for _, name in ipairs(ReadMutatorNames(itemModel)) do
		if name == "Broken" then
			return true
		end
	end
	return false
end

