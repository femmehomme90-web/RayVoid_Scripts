		RULES.ED.Button(effectsBox, (on and "[x] " or "[  ] ") .. effect, UDim2.fromOffset(178, 24), nil, {
			bg = on and RULES.ED.GOOD or RULES.ED.CARD,
			align = Enum.TextXAlignment.Left,
			padLeft = 8,
			order = effectIndex,
			textSize = 12,
			onClick = function()
				if rule.effects[effect] then
					rule.effects[effect] = nil
				else
					rule.effects[effect] = true
				end
				RULES.Save(RULES.ED.current)
				RULES.ED.Render()
			end,
		})
	end
end

function RULES.ED.RenderLeft()
	local pane = RULES.ED.left
	for _, child in ipairs(pane:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end

	-- Two things live in this window: the rules, and the per-lane lists that
	-- used to be scattered over five tabs. The switch comes first because it
	-- decides what the rest of the window is showing.
	local modeRow = RULES.ED.Row(pane, 28, 0)
	RULES.ED.Button(modeRow, "Rules", UDim2.fromOffset(102, 24), UDim2.fromOffset(0, 2), {
		bg = (RULES.ED.mode ~= "filters") and RULES.ED.ACCENT or RULES.ED.CARD,
		bold = true, textSize = 12,
		onClick = function()
			RULES.ED.mode = "rules"
			RULES.ED.Render()
		end,
	})
	RULES.ED.Button(modeRow, "Lists", UDim2.fromOffset(102, 24), UDim2.fromOffset(106, 2), {
		bg = (RULES.ED.mode == "filters") and RULES.ED.ACCENT or RULES.ED.CARD,
		bold = true, textSize = 12,
		onClick = function()
			RULES.ED.mode = "filters"
			RULES.ED.Render()
		end,
	})

	if RULES.ED.mode == "filters" then
		RULES.ED.Label(pane, "LISTS  (per lane)", UDim2.new(1, 0, 0, 20), nil,
			{ bold = true, color = RULES.ED.ACCENT, order = 1 })
		for laneIndex, lane in ipairs(FILTERS.ORDER) do
			local count = 0
			for _, entry in ipairs(FILTERS.ForLane(lane)) do
				local current = FILTERS.Current(entry)
				if entry.kind == "bool" then
					if current then
						count = count + 1
					end
				else
					count = count + #current
				end
			end
			local row = RULES.ED.Row(pane, 26, laneIndex + 1)
			RULES.ED.Button(row, FILTERS.SHORT[lane] .. "  (" .. count .. ")",
				UDim2.new(1, 0, 0, 24), UDim2.fromOffset(0, 1), {
					bg = (RULES.ED.lane == lane) and RULES.ED.ACCENT or RULES.ED.CARD,
					align = Enum.TextXAlignment.Left,
					padLeft = 8,
					textSize = 12,
					onClick = function()
						RULES.ED.lane = lane
						RULES.ED.Render()
					end,
				})
		end
		RULES.ED.Label(pane, "The number is how many things that lane filters on.",
			UDim2.new(1, 0, 0, 30), nil, { color = RULES.ED.DIM, textSize = 11, wrapped = true, order = 90 })
		return
	end

	RULES.ED.Label(pane, "RULES  (first match wins)", UDim2.new(1, 0, 0, 20), nil,
		{ bold = true, color = RULES.ED.ACCENT, order = 1 })

	for i = 1, RULES.COUNT do
		local rule = RULES.rules[i]
		local armed = RULES.RuleIsArmed(rule)
		local touched = RULES.AnySet(rule.effects) or RULES.RuleHasCriteria(rule)
		local caption = i .. ".  "
		if rule.label ~= "" then
			caption = caption .. rule.label
		elseif touched then
			caption = caption .. "(unnamed)"
		else
			caption = caption .. "empty"
		end
		if touched and not armed then
			caption = caption .. "  !"
		end
