-- Forward declaration: the sequence is defined further down (FSM
-- section, it needs AUCTION.garage) but the REMOTES.UpdateBidEvent handler
-- just below calls it. Without this, task.spawn receives nil.
-- The "local" was removed from its definition; do NOT put it back.
local RunAutoWinSequence


-- Declared here because the REMOTES.UpdateBidEvent handler needs it as an upvalue.

SESSION.Track(REMOTES.UpdateBidEvent.OnClientEvent:Connect(function(currentBid, currentHolderName, holderChar, nextRequiredBid, garageObject)
	local ok, err = pcall(function()
		-- FARM.Moved is only assigned ~2,200 lines below, so a bid arriving
		-- during a hot reload taken mid-auction used to call a nil and throw
		-- the whole handler away ("attempt to call a nil value"). The pcall
		-- caught it and the next bid was fine, but one bid per reload was
		-- dropped -- including, potentially, the Min Bid check.
		if FARM.Moved then
			FARM.Moved()
		end
		-- Formerly gated on FARM.active: Min Bid now also works when the
		-- player enters an auction manually, without Auto Farm active.
		-- FARM.cooldownUntil = 0 below stays a harmless no-op if Auto Farm
		-- is off (nothing reads it).
		if AUCTION.minBid and not AUCTION.checkedMinBid and type(currentBid) == "number" then
			AUCTION.checkedMinBid = true
			if currentBid < AUCTION.minBid then
				-- Veto on the veto: a targeted mutation in the garage
				-- overrides Min Bid. We read the garage's Floorspace, which
				-- is already populated at this stage of the auction.
				local forced, mutationName = FORCEBID.Check(garageObject)
				local reason = nil

				if forced then
					reason = "mutation '" .. tostring(mutationName) .. "'"
				else
					-- Same veto-on-veto, on the item itself rather than its
					-- mutations. Only reached when no mutation matched, so a
					-- garage full of nothing interesting costs one extra pass
					-- over 6 models -- no model loading, see IGNOREBID.
					local itemForced, itemName = IGNOREBID.Check(garageObject)
					if itemForced then
						forced = true
						reason = "item '" .. tostring(itemName) .. "'"
					end
				end

				if not forced then
					-- Item Rules last of the three, so the two existing
					-- overrides keep the wording they always had in the log.
					local ruleForcedBid, ruleReason = RULES.CheckGarage(garageObject)
					if ruleForcedBid then
						forced = true
						reason = ruleReason
					end
				end

				if forced then
					-- Always printed, not DebugPrint: this is the one line
					-- that explains why a garage under Min Bid was entered
					-- anyway, and it is worthless if it only shows in debug
					-- mode -- the override looks broken without it.
					print(string.format(
						"[AutoBid] Bid too low (%d < %d) BUT %s found -> Min Bid ignored",
						currentBid, AUCTION.minBid, tostring(reason)))
				else
					DebugPrint(string.format("[AutoBid] Bid too low (%d < %d), leaving the auction", currentBid, AUCTION.minBid))
					-- Deliberate exit: the UI close that follows is not an
					-- auction ending, no need to wait to learn whether we won.
					-- We can go back to searching right away.
					AUCTION.deliberateLeave = true
					-- The 15s cooldown set by TryEnterNextAuction is designed
					-- for a REAL garage visit (full collection). A Min Bid
					-- skip leaves in 1-2s -- without this reset, the Master
					-- would still wait out the rest of the 15s before looking
					-- for the next garage, for nothing.
					FARM.cooldownUntil = 0
					-- Nothing to wait for: tick fast until the next garage is taken.
					FARM.Hurry()
					local leaveOk, leaveErr = pcall(function()
						return REMOTES.LeaveAuctionRemote:InvokeServer()
					end)
					if not leaveOk then
						warn("[AutoBid] LeaveAuction:InvokeServer failed: " .. tostring(leaveErr))
					end
					return
				end
			end
		end

		if not AUCTION.bidActive then return end

		-- An NPC rebid while we are in the Auto-Win hold (outside the
		-- zone, auction paused): a normal bid will not go through from
		-- here. We cut the hold short rather than waiting the timer out.
		if AUCTION.winRunning and currentHolderName ~= LocalPlayer.Name then
			AUCTION.abort = true
			AUCTION.abortNextRequiredBid = nextRequiredBid
			DebugPrint("[AutoWin] Outbid mid-hold, aborting to return and rebid")
			return
		end

		-- We have just taken the lead: time to freeze and leave.
		if AUCTION.winActive and currentHolderName == LocalPlayer.Name
			and not AUCTION.wonThisAuction and not AUCTION.winRunning then
			task.spawn(RunAutoWinSequence)
			return
		end

		if currentHolderName ~= LocalPlayer.Name then
			if type(nextRequiredBid) == "number" and (not AUCTION.maxBid or nextRequiredBid <= AUCTION.maxBid) then
				local fireOk, fireErr = pcall(function()
					REMOTES.BidRemote:FireServer()
				end)
				if not fireOk then
					warn("BidRemote:FireServer failed: " .. tostring(fireErr))
				end
			end
		end
	end)
	if not ok then
		warn("[AutoBid] UpdateCurrentWinningBid handler failed: " .. tostring(err))
	end
end))

