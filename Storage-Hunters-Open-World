function RULES.ED.Corner(instance, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 6)
	corner.Parent = instance
	return instance
end

function RULES.ED.Label(parent, text, size, position, opts)
	opts = opts or {}
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position or UDim2.fromOffset(0, 0)
	label.Font = opts.bold and Enum.Font.GothamBold or Enum.Font.Gotham
	label.TextSize = opts.textSize or 13
	label.TextColor3 = opts.color or RULES.ED.TEXT
	label.TextXAlignment = opts.align or Enum.TextXAlignment.Left
	label.TextWrapped = opts.wrapped or false
	label.Text = text
	label.LayoutOrder = opts.order or 0
	label.Parent = parent
	return label
end

function RULES.ED.Button(parent, text, size, position, opts)
	opts = opts or {}
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position or UDim2.fromOffset(0, 0)
	button.BackgroundColor3 = opts.bg or RULES.ED.CARD2
	button.BorderSizePixel = 0
	button.AutoButtonColor = true
	button.Font = opts.bold and Enum.Font.GothamBold or Enum.Font.Gotham
	button.TextSize = opts.textSize or 13
	button.TextColor3 = opts.color or RULES.ED.TEXT
	button.TextXAlignment = opts.align or Enum.TextXAlignment.Center
	button.TextTruncate = Enum.TextTruncate.AtEnd
	button.Text = text
	button.LayoutOrder = opts.order or 0
	button.Parent = parent
	RULES.ED.Corner(button, opts.radius or 6)
	if opts.padLeft then
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, opts.padLeft)
		padding.PaddingRight = UDim.new(0, 6)
		padding.Parent = button
	end
	if opts.onClick then
		button.MouseButton1Click:Connect(opts.onClick)
	end
	return button
end

-- A number box that commits on focus lost. Blank means "no limit", which is
-- why it commits nil rather than 0 -- 0 is a real threshold and must not be
-- what an empty box means.
function RULES.ED.NumberBox(parent, value, size, position, placeholder, onCommit)
	local box = Instance.new("TextBox")
	box.Size = size
	box.Position = position or UDim2.fromOffset(0, 0)
	box.BackgroundColor3 = RULES.ED.BAR
	box.BorderSizePixel = 0
	box.Font = Enum.Font.Gotham
	box.TextSize = 13
	box.TextColor3 = RULES.ED.TEXT
	box.PlaceholderText = placeholder or ""
	box.PlaceholderColor3 = RULES.ED.DIM
	box.ClearTextOnFocus = false
	box.Text = value ~= nil and tostring(value) or ""
	box.Parent = parent
	RULES.ED.Corner(box, 5)
	box.FocusLost:Connect(function()
		local text = box.Text
		if text == nil or text:gsub("%s", "") == "" then
			onCommit(nil)
			box.Text = ""
			return
		end
		local parsed = ParseValueInput(text)
		if parsed == nil then
			warn("[Rules] \"" .. tostring(text) .. "\" is not a number, so that box has been cleared.")
			onCommit(nil)
			box.Text = ""
			return
		end
		onCommit(parsed)
		box.Text = tostring(parsed)
	end)
	return box
end

-- ---------------------------------------------------------
-- The picker overlay: one list, a search box, ticks. Used for item names
-- (hundreds of them), categories, rarities, traits, effects and the mutation
-- on a requirement line.
-- ---------------------------------------------------------
function RULES.ED.OpenPicker(title, options, isTicked, onToggle, singleChoice)
	if RULES.ED.picker then
		RULES.ED.picker:Destroy()
		RULES.ED.picker = nil
	end
	local shade = Instance.new("TextButton")
	shade.Size = UDim2.fromScale(1, 1)
	shade.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	shade.BackgroundTransparency = 0.45
	shade.BorderSizePixel = 0
	shade.Text = ""
	shade.AutoButtonColor = false
	shade.ZIndex = 10
	shade.Parent = RULES.ED.main
	RULES.ED.picker = shade

	local panel = Instance.new("Frame")
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(340, 400)
	panel.BackgroundColor3 = RULES.ED.BG
	panel.BorderSizePixel = 0
	panel.ZIndex = 11
	panel.Parent = shade
	RULES.ED.Corner(panel, 8)

	RULES.ED.Label(panel, title, UDim2.new(1, -60, 0, 32), UDim2.fromOffset(12, 4), { bold = true }).ZIndex = 12
	local close = RULES.ED.Button(panel, "Done", UDim2.fromOffset(52, 24), UDim2.new(1, -60, 0, 8), {
		bg = RULES.ED.ACCENT,
		onClick = function()
			shade:Destroy()
			RULES.ED.picker = nil
			RULES.ED.Render()
		end,
	})
	close.ZIndex = 12

	local search = Instance.new("TextBox")
	search.Size = UDim2.new(1, -24, 0, 28)
	search.Position = UDim2.fromOffset(12, 38)
	search.BackgroundColor3 = RULES.ED.BAR
	search.BorderSizePixel = 0
	search.Font = Enum.Font.Gotham
	search.TextSize = 13
	search.TextColor3 = RULES.ED.TEXT
	search.PlaceholderText = "search..."
	search.PlaceholderColor3 = RULES.ED.DIM
	search.ClearTextOnFocus = false
	search.Text = ""
	search.ZIndex = 12
	search.Parent = panel
	RULES.ED.Corner(search, 5)

	local list = Instance.new("ScrollingFrame")
	list.Position = UDim2.fromOffset(12, 74)
	list.Size = UDim2.new(1, -24, 1, -86)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 5
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ZIndex = 12
	list.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	local function paint()
		-- Every child, not just the buttons: this function also creates
		-- TextLabels ("...and 889 more", "Nothing matches ..."), and clearing
		-- only the buttons left those stacking up one per keystroke.
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local needle = string.lower(search.Text or "")
		local shown = 0
		for _, option in ipairs(options) do
			if needle == "" or string.find(string.lower(option), needle, 1, true) then
				shown = shown + 1
				-- Capped so a search that matches everything does not build
				-- eight hundred buttons and freeze the client.
				if shown <= 150 then
					local ticked = isTicked(option)
					local row = RULES.ED.Button(list, (ticked and "[x]  " or "[  ]  ") .. option,
						UDim2.new(1, -6, 0, 26), nil, {
							bg = ticked and RULES.ED.GOOD or RULES.ED.CARD,
							align = Enum.TextXAlignment.Left,
							padLeft = 8,
							order = shown,
						})
					row.ZIndex = 12
					row.MouseButton1Click:Connect(function()
						onToggle(option)
						if singleChoice then
							shade:Destroy()
							RULES.ED.picker = nil
							RULES.ED.Render()
						else
							paint()
						end
					end)
				end
			end
		end
		if shown > 150 then
			RULES.ED.Label(list, "...and " .. (shown - 150) .. " more. Type to narrow it down.",
				UDim2.new(1, -6, 0, 24), nil, { color = RULES.ED.DIM, order = 9999 }).ZIndex = 12
		end
		if shown == 0 then
			RULES.ED.Label(list, "Nothing matches \"" .. search.Text .. "\".",
				UDim2.new(1, -6, 0, 24), nil, { color = RULES.ED.DIM }).ZIndex = 12
		end
	end

	search:GetPropertyChangedSignal("Text"):Connect(paint)
	paint()
end

-- ---------------------------------------------------------
-- Building the right-hand pane. Rebuilt wholesale on every change: a settings
-- panel is small, and a full redraw cannot leave a stale row behind claiming
-- something the rule no longer says.
-- ---------------------------------------------------------
function RULES.ED.Row(parent, height, order)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, height)
	row.BackgroundTransparency = 1
	row.LayoutOrder = order
	row.Parent = parent
	return row
end

function RULES.ED.PickerRow(parent, order, caption, set, options)
	local row = RULES.ED.Row(parent, 28, order)
	RULES.ED.Label(row, caption, UDim2.fromOffset(96, 28), UDim2.fromOffset(0, 0), { color = RULES.ED.DIM })
	local chosen = RULES.AnySet(set) and RULES.NamesOf(set, 4) or "anything"
	RULES.ED.Button(row, chosen, UDim2.new(1, -170, 0, 24), UDim2.fromOffset(100, 2), {
		align = Enum.TextXAlignment.Left,
		padLeft = 8,
		color = RULES.AnySet(set) and RULES.ED.TEXT or RULES.ED.DIM,
		onClick = function()
			RULES.ED.OpenPicker(caption, options,
				function(option) return set[option] == true end,
				function(option)
					if set[option] then
						set[option] = nil
					else
						set[option] = true
					end
					RULES.Save(RULES.ED.current)
				end)
		end,
	})
	RULES.ED.Button(row, "clear", UDim2.fromOffset(56, 24), UDim2.new(1, -62, 0, 2), {
		bg = RULES.ED.CARD,
		color = RULES.ED.DIM,
		onClick = function()
			table.clear(set)
			RULES.Save(RULES.ED.current)
			RULES.ED.Render()
		end,
	})
	return row
end

function RULES.ED.BuildAltRow(parent, setup, line, altIndex, order)
	local alt = line.alts[altIndex]
	local row = RULES.ED.Row(parent, 26, order)
	if altIndex > 1 then
		RULES.ED.Label(row, "or", UDim2.fromOffset(24, 26), UDim2.fromOffset(4, 0), { color = RULES.ED.DIM })
	end
	RULES.ED.Button(row, alt.mutation or "(pick a mutation)", UDim2.fromOffset(170, 22), UDim2.fromOffset(30, 2), {
		color = alt.mutation and RULES.ED.TEXT or RULES.ED.DIM,
		align = Enum.TextXAlignment.Left,
		padLeft = 8,
		onClick = function()
			RULES.ED.OpenPicker("Which mutation?", RULES.LINE_OPTIONS,
				function(option)
					return (alt.mutation or RULES.ANY_MUTATION) == option
				end,
				function(option)
					alt.mutation = option
					RULES.Save(RULES.ED.current)
				end, true)
		end,
	})
	RULES.ED.Label(row, "at least", UDim2.fromOffset(50, 26), UDim2.fromOffset(206, 0), { color = RULES.ED.DIM })
	RULES.ED.NumberBox(row, alt.minPercent, UDim2.fromOffset(52, 22), UDim2.fromOffset(258, 2), "any",
		function(value)
			alt.minPercent = value
			RULES.Save(RULES.ED.current)
			RULES.ED.Render()
		end)
	RULES.ED.Label(row, "%", UDim2.fromOffset(16, 26), UDim2.fromOffset(314, 0), { color = RULES.ED.DIM })
	RULES.ED.Button(row, "x", UDim2.fromOffset(22, 22), UDim2.fromOffset(336, 2), {
		bg = RULES.ED.BAD,
		onClick = function()
			table.remove(line.alts, altIndex)
			RULES.Save(RULES.ED.current)
			RULES.ED.Render()
		end,
	})
	return row
end

function RULES.ED.BuildLine(parent, setup, lineIndex, order)
	local line = setup.lines[lineIndex]
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, -8, 0, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = RULES.ED.CARD2
	card.BorderSizePixel = 0
	card.LayoutOrder = order
	card.Parent = parent
	RULES.ED.Corner(card, 6)

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 2)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = card
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingBottom = UDim.new(0, 4)
	padding.PaddingLeft = UDim.new(0, 6)
	padding.Parent = card

	local head = RULES.ED.Row(card, 20, 1)
	RULES.ED.Label(head, (lineIndex == 1 and "needs a buff that is:" or "AND a DIFFERENT buff that is:"),
		UDim2.new(1, -70, 0, 20), UDim2.fromOffset(0, 0), { color = RULES.ED.DIM, bold = true })
	RULES.ED.Button(head, "remove", UDim2.fromOffset(58, 18), UDim2.new(1, -66, 0, 1), {
		bg = RULES.ED.BAD, textSize = 11,
		onClick = function()
			table.remove(setup.lines, lineIndex)
			RULES.Save(RULES.ED.current)
			RULES.ED.Render()
		end,
	})

	for altIndex = 1, #line.alts do
		RULES.ED.BuildAltRow(card, setup, line, altIndex, altIndex + 1)
	end

	if #line.alts < RULES.MAX_ALTS then
		local addRow = RULES.ED.Row(card, 24, 100)
		RULES.ED.Button(addRow, "+ or ...", UDim2.fromOffset(80, 20), UDim2.fromOffset(30, 2), {
			bg = RULES.ED.CARD, textSize = 12,
			onClick = function()
				table.insert(line.alts, { mutation = nil, minPercent = nil })
				RULES.Save(RULES.ED.current)
				RULES.ED.Render()
			end,
		})
	end
	return card
end

