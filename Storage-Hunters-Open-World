-- =========================================================
-- LOST ITEMS COLLECTION (set 1: 29 items around the map; set 2: 23 items,
-- unlocked with Lucky Beach). Measured: each uncollected one is
-- workspace._LostItems.<ItemName> with Base.PickupPrompt ("Add to Vehicle"),
-- so it goes into the TRUCK, which has to be nearby. The map streams, so a
-- far item is not in workspace: the sweep visits every area's GPS point,
-- lets it stream in, and grabs whatever appears -- no hand-written
-- coordinates, so set 2 (whose spots nobody has listed) is covered too.
-- Remotes UI.GetLostItems / ClaimLostItem / LostItemsStatus exist; their
-- shapes were not measured, so their first answers are printed once.
-- Never runs while Auto Farm is on (the farm owns your character).
-- =========================================================
local LOSTITEMS = {
	active = false,
	busy = false,
	collected = 0,
	seen = {},      -- name -> true: found at least once this session
	failed = {},    -- name -> os.clock() until which we do not retry
	logged = {},
	status = "Idle",
	deepScan = false,  -- also grid-search the whole map + any "Add to Vehicle" prompt
	GRID_STEP = 350,   -- studs between grid stops
}

function LOSTITEMS.Folder()
	return workspace:FindFirstChild("_LostItems")
end

-- Set 1, from the community guide (29). Only used to say what is missing;
-- set 2's names come from the game (GetLostItems) when it lists them.
LOSTITEMS.GUIDE = {
	"Needle", "Branding Iron", "Horseshoe", "Painting", "Cow Milker", "Saddle", "Key", "Scythe",
	"Bluetooth Speaker", "Backpack", "Camera", "Suitcase", "LED Flashlight", "Watering Can",
	"Professional Camera", "Digital Alarm Clock", "Book", "Bonsai Plant", "Circular Saw",
	"Acoustic Guitar", "Classic Telephone", "Jade Bracelet", "Marble Vase", "Lava Lamp",
	"Typewriter", "Cowbell", "Butter Churn", "Flip Cell Phone", "Beehive",
}
LOSTITEMS.known = {}     -- name -> last position seen (survives streaming out)
LOSTITEMS.taken = {}     -- name -> true: taken this session

-- { model, prompt, pos, locked } for every lost item currently loaded.
-- Two sources: workspace._LostItems (measured) and, in case set 2 lives
-- somewhere else, any "Add to Vehicle" prompt outside the farm's own folders.
function LOSTITEMS.Loaded()
	local out, seenModels = {}, {}
	local function consider(model, prompt)
		if seenModels[model] or LOSTITEMS.taken[model.Name] then
			return
		end
		seenModels[model] = true
		local pos = TPCACHE.AnyToPosition(prompt.Parent) or TPCACHE.AnyToPosition(model)
		if pos then
			LOSTITEMS.seen[model.Name] = true
			LOSTITEMS.known[model.Name] = pos
			table.insert(out, { model = model, prompt = prompt, pos = pos, locked = not prompt.Enabled })
		end
	end
	local folder = LOSTITEMS.Folder()
	if folder then
		for _, model in ipairs(folder:GetChildren()) do
			local prompt = model:FindFirstChild("PickupPrompt", true)
			if prompt and prompt:IsA("ProximityPrompt") then
				consider(model, prompt)
			end
		end
	end
	if LOSTITEMS.deepScan then
		-- The prompts the sweep has watched stream in (see Sweep), not a
		-- whole-map GetDescendants at every one of hundreds of grid stops --
		-- that was a fresh table of every object in the world, every 1.5s,
		-- for ten minutes, every half hour of an all-night run.
		local source = {}
		if LOSTITEMS.prompts then
			for d in pairs(LOSTITEMS.prompts) do
				if d.Parent then
					table.insert(source, d)
				end
			end
		else
			source = workspace:GetDescendants()
		end
		for _, d in ipairs(source) do
			if d:IsA("ProximityPrompt") and d.ActionText == "Add to Vehicle" then
				local model = d:FindFirstAncestorWhichIsA("Model")
				local inFarm = d:FindFirstAncestor("_Carryables") or d:FindFirstAncestor("_NPCShoppers")
				if model and not inFarm and not (folder and d:IsDescendantOf(folder)) then
					consider(model, d)
				end
			end
		end
	end
	return out
end

-- A locked one (the Scythe sits in the back-alley warehouse that the Key
-- opens): fire any unlock / open prompt close to it, then look again.
-- The Key has to be IN HAND for the garage to open (guides: "equip the Key
-- to open the Lost Item Garage"). Unload the truck first so a Key picked up
-- this pass is in the inventory, then equip it.
function LOSTITEMS.EquipKey()
	pcall(UnloadCargo)
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not ok or type(inventory) ~= "table" then
		return false
	end
	for guid, entry in pairs(inventory) do
		local def = Items[tostring(entry.ItemId)]
		if type(def) == "table" and def.Name == "Key" then
			pcall(function()
				REMOTES.EquipItem:FireServer(guid)
			end)
			task.wait(1)
			print("[LostItems] Holding the Key to open the locked garage")
			return true
		end
	end
	warn("[LostItems] No Key in your inventory -- it opens the Scythe's garage. It will be picked up "
		.. "on the next sweep (it respawns ~12h after being sold) and is now never sold or shelved.")
	return false
end

function LOSTITEMS.TryUnlock(item)
	local hasKey = LOSTITEMS.EquipKey()
	local fired = 0
	local WORDS = { "unlock", "door", "key", "open", "lost" }
	for _, d in ipairs(workspace:GetDescendants()) do
		-- Disabled ones too: some only switch on once the Key is in hand.
		if d:IsA("ProximityPrompt") and d ~= item.prompt then
			local text = string.lower(tostring(d.ActionText) .. " " .. tostring(d.ObjectText) .. " " .. d.Name)
			local hit = false
			for _, w in ipairs(WORDS) do
				if string.find(text, w, 1, true) then
					hit = true
					break
				end
			end
			-- Never an auction / bid / shop prompt.
			if hit and (string.find(text, "bid", 1, true) or string.find(text, "auction", 1, true)
				or string.find(text, "buy", 1, true)) then
				hit = false
			end
			local p = hit and TPCACHE.AnyToPosition(d.Parent)
			if p and (p - item.pos).Magnitude < 90 then
				SafeSetHRPCFrame(CFrame.new(p + Vector3.new(0, 3, 0)))
				task.wait(0.6)
				pcall(function()
					d.RequiresLineOfSight = false
				end)
				pcall(fireproximityprompt, d)
				fired = fired + 1
				task.wait(1.2)
			end
		end
	end
	print("[LostItems] " .. item.model.Name .. " is locked: " .. (hasKey and "holding the Key, " or "no Key, ")
		.. "tried " .. fired .. " unlock/open prompt(s) near it")
	return fired > 0
end

function LOSTITEMS.Remote(name, ...)
	local ui = Events:FindFirstChild("UI")
	local remote = ui and ui:FindFirstChild(name)
	if not remote then
		return false, "no remote"
	end
	local args = table.pack(...)
	local ok, res = pcall(function()
		if remote:IsA("RemoteFunction") then
			return remote:InvokeServer(table.unpack(args, 1, args.n))
		end
		remote:FireServer(table.unpack(args, 1, args.n))
		return true
	end)
	if not LOSTITEMS.logged[name] then
		LOSTITEMS.logged[name] = true
		print("[LostItems] " .. name .. " -> " .. TRAINQUEST.Short(ok and res or ("error " .. tostring(res))))
	end
	return ok, res
end

function LOSTITEMS.Gone(item)
	return not item.model.Parent or not item.prompt.Parent
		or (not item.locked and not item.prompt.Enabled)
end

-- Fire the prompt a few times from right next to it.
function LOSTITEMS.FireAt(item, tries)
	for _ = 1, tries do
		if LOSTITEMS.Gone(item) then
			return true
		end
		pcall(function()
			item.prompt.RequiresLineOfSight = false -- roof / wall / water spots
		end)
		SafeSetHRPCFrame(CFrame.new(item.pos + Vector3.new(0, 3, 0)))
		task.wait(0.25)
		pcall(fireproximityprompt, item.prompt)
		task.wait(1)
	end
	return LOSTITEMS.Gone(item)
end

-- Plan B for spots the truck cannot be summoned to (the Painting is IN the
-- pond): drive -- i.e. teleport while seated -- the truck right up to it,
-- then hop out next to it and take it.
function LOSTITEMS.BringTruck(item)
	local truck = GetPlayerTruck()
	if not truck then
		return false
	end
	if GetSeatedVehicle() ~= truck then
		SitInTruck(truck)
		local deadline = os.clock() + 2
		while os.clock() < deadline and GetSeatedVehicle() ~= truck do
			task.wait(0.1)
		end
	end
	if GetSeatedVehicle() == truck then
		TeleportPlayerAndTruck(item.pos + Vector3.new(8, 2, 0))
		task.wait(0.8)
		pcall(fireproximityprompt, item.prompt) -- some work from the seat
		task.wait(0.8)
		if LOSTITEMS.Gone(item) then
			return true
		end
		local hum = MOVE.Humanoid()
		if hum then
			hum.Sit = false
		end
		task.wait(0.5)
	end
	return LOSTITEMS.FireAt(item, 3)
end

function LOSTITEMS.Grab(item)
	local name = item.model.Name
	if LOSTITEMS.failed[name] and LOSTITEMS.failed[name] > os.clock() then
		return false
	end
	LOSTITEMS.status = "Taking " .. name
	if item.locked then
		LOSTITEMS.TryUnlock(item)
		task.wait(0.5)
		item.locked = not item.prompt.Enabled
	end
	-- Plan A: stand next to it, summon the truck nearby, fire.
	SafeSetHRPCFrame(CFrame.new(item.pos + Vector3.new(0, 3, 0)))
	task.wait(0.4)
	pcall(CatchUpVehicle, item.pos)
	task.wait(0.6)
	local ok = LOSTITEMS.FireAt(item, 3)
	-- Plan B: bring the truck itself right up to it.
	if not ok then
		ok = LOSTITEMS.BringTruck(item)
	end
	-- Plan C: it looked open but would not come (behind a locked door, like
	-- the Scythe): Key in hand, open what is near it, try again.
	if not ok and not item.locked then
		LOSTITEMS.TryUnlock(item)
		ok = LOSTITEMS.FireAt(item, 3)
	end
	if not ok then
		LOSTITEMS.failed[name] = os.clock() + 120
		warn("[LostItems] Could not take " .. name .. (item.locked and " (still locked)" or " (truck full?)")
			.. " at " .. tostring(item.pos) .. " -- retry in 2 min")
		return false
	end
	LOSTITEMS.taken[name] = true
	LOSTITEMS.collected = LOSTITEMS.collected + 1
	print("[LostItems] Got " .. name .. " (" .. LOSTITEMS.collected .. " this session)")
	return true
end

function LOSTITEMS.GrabAllLoaded()
	local got = 0
	for _, item in ipairs(LOSTITEMS.Loaded()) do
		if not LOSTITEMS.active or FARM.active then
			break
		end
		if LOSTITEMS.Grab(item) then
			got = got + 1
		end
	end
	return got
end

-- One full sweep of every area. Returns how many items were taken.
function LOSTITEMS.Sweep()
	if LOSTITEMS.busy then
		return 0
	end
	-- Someone else is moving you (a quest trip, train job): next time.
	if not SESSION.Claim("lostItems") then
		LOSTITEMS.status = "Waiting: " .. tostring(SESSION.mover) .. " is moving you right now"
		return 0
	end
	LOSTITEMS.busy = true
	local hrp = GetFreshHRP()
	local home = hrp and hrp.CFrame
	local got = 0
	-- Deep pass: one look at what is loaded now, then just watch prompts
	-- arrive as each stop streams in (weak keys: streamed-out ones drop out).
	local watch
	if LOSTITEMS.deepScan then
		LOSTITEMS.prompts = setmetatable({}, { __mode = "k" })
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				LOSTITEMS.prompts[d] = true
			end
		end
		watch = SESSION.Track(workspace.DescendantAdded:Connect(function(d)
			if d:IsA("ProximityPrompt") and LOSTITEMS.prompts then
				LOSTITEMS.prompts[d] = true
			end
		end))
	end
	local ok, err = pcall(function()
		LOSTITEMS.Remote("GetLostItems")
		got = got + LOSTITEMS.GrabAllLoaded()

		-- Stops: EVERY GPS point (areas, shops, landmarks -- not just the 20
		-- area centres, which is how 3 items were missed: the crane top, the
		-- ship, the pond were too far from any area centre to stream in), plus
		-- every spot an item was ever seen at.
		local stops = {}
		AREAPOS.LoadPOIs()
		TPCACHE.LoadAllPOIs()
		for name, pos in pairs(AREAPOS.poiCache or {}) do
			table.insert(stops, { name, pos })
		end
		for name, pos in pairs(TPCACHE.allPois or {}) do
			table.insert(stops, { name, pos })
		end
		for name, pos in pairs(LOSTITEMS.known) do
			if not LOSTITEMS.taken[name] then
				table.insert(stops, 1, { name .. " (seen before)", pos })
			end
		end

		-- Deep mode (a pass found nothing, or the button): add a grid over the
		-- whole map so nothing is out of streaming range of some stop.
		if LOSTITEMS.deepScan and #stops > 0 then
			local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
			for _, s in ipairs(stops) do
				minX, maxX = math.min(minX, s[2].X), math.max(maxX, s[2].X)
				minZ, maxZ = math.min(minZ, s[2].Z), math.max(maxZ, s[2].Z)
			end
			local step = LOSTITEMS.GRID_STEP
			for x = minX - step, maxX + step, step do
				for z = minZ - step, maxZ + step, step do
					table.insert(stops, { string.format("grid %d,%d", x, z), Vector3.new(x, 60, z) })
				end
			end
		end

		for i, s in ipairs(stops) do
			if not LOSTITEMS.active or FARM.active or AUTOFISH.active then
				break
			end
			SESSION.Claim("lostItems") -- still ours: refresh the hold
			LOSTITEMS.status = string.format("Searching %s (%d/%d) -- %d taken", s[1], i, #stops, got)
			SafeSetHRPCFrame(CFrame.new(s[2] + Vector3.new(0, 5, 0)))
			pcall(function()
				LocalPlayer:RequestStreamAroundAsync(s[2], 3)
			end)
			task.wait(LOSTITEMS.deepScan and 1.5 or 2)
			got = got + LOSTITEMS.GrabAllLoaded()
		end
		if got > 0 then
			-- Out of the truck into the inventory, then let the collection
			-- book register them (shape unknown: logged once).
			pcall(UnloadCargo)
			LOSTITEMS.Remote("ClaimLostItem")
			LOSTITEMS.Remote("LostItemsStatus")
		end
	end)
	if not ok then
		warn("[LostItems] Sweep failed: " .. tostring(err))
	end
	if watch then
		pcall(function()
			watch:Disconnect()
		end)
	end
	LOSTITEMS.prompts = nil
	if home and not FARM.active then
		SafeSetHRPCFrame(home)
	end
	local names = {}
	for name in pairs(LOSTITEMS.seen) do
		table.insert(names, name)
	end
	table.sort(names)
	LOSTITEMS.status = string.format("Last sweep: %d taken, %d total this session.\nSeen: %s",
		got, LOSTITEMS.collected, #names > 0 and table.concat(names, ", ") or "none loaded (all collected already?)")
	LOSTITEMS.busy = false
	SESSION.Release("lostItems")
	return got
end

function LOSTITEMS.StartLoop()
	if LOOPGUARDS.lostItems then
		return
	end
	LOOPGUARDS.lostItems = true
	task.spawn(function()
		while LOSTITEMS.active and LOOPGUARDS.lostItems and SESSION.alive do
			if FARM.active or AUTOFISH.active then
				LOSTITEMS.status = "Paused: " .. (FARM.active and "Auto Farm" or "Auto Fish") .. " is on (it owns your character)"
				task.wait(10)
			elseif SESSION.mover and SESSION.mover ~= "lostItems" then
				LOSTITEMS.status = "Waiting: " .. tostring(SESSION.mover) .. " is moving you right now"
				task.wait(5)
			else
				local got = LOSTITEMS.Sweep()
				-- Nothing found on a normal pass: the next pass is a deep one
				-- (whole-map grid). Nothing found by a deep one either: slow
				-- re-check (new set, respawns).
				-- Two deep passes in a row that find nothing = nothing is left
				-- to find: no more whole-map grids this session (they streamed
				-- the entire map in, every half hour, all night), just a
				-- normal look once an hour.
				if got > 0 then
					LOSTITEMS.deepScan = false
					LOSTITEMS.emptyDeep = 0
					task.wait(20)
				elseif not LOSTITEMS.deepScan and (LOSTITEMS.emptyDeep or 0) < 2 then
					LOSTITEMS.deepScan = true
					task.wait(5)
				else
					-- Nothing left that we can see: say exactly what is still
					-- missing (console + the status box), no button needed.
					-- Then rest: an all-night run must not keep flinging you
					-- round the map for items that are not there.
					if LOSTITEMS.deepScan then
						LOSTITEMS.emptyDeep = (LOSTITEMS.emptyDeep or 0) + 1
						pcall(LOSTITEMS.Report)
					end
					LOSTITEMS.deepScan = false
					task.wait((LOSTITEMS.emptyDeep or 0) >= 2 and 3600 or 1800)
				end
			end
		end
		LOOPGUARDS.lostItems = false
	end)
end

