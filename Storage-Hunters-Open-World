-- AUTO UNFAVOURITE URANIUM ORE (Processing tab) -- passive, never touches
-- the HRP. The game favourites Uranium Ore on its own for a reason nobody
-- has found yet (docs/game-reference.md, open question); Favorited is
-- otherwise the user's hardest signal, so Wash, Grade, AutoSell and Place
-- all skip a Favorited item outright -- an auto-favourited Uranium Ore just
-- sits stuck until someone opens it and clicks Favorite by hand. This
-- undoes the game's own favouriting, one item at a time, so the rest of the
-- pipeline can see it again. Off by default: only the user gets to decide
-- whether Uranium Ore should ever be sold or placed away.
-- Everything grouped in ONE table = a single root-level local for the
-- whole feature (Lua 5.1 caps root-level locals at 200, cf. CLAUDE.md).
-- Cleaning Sprays too (2026-10-13, user request): same problem, same fix, own
-- toggle. `active` = Uranium Ore, `spray` = Cleaning Sprays (any item whose
-- name has both "clean" and "spray", so every spray tier is covered).
local URANIUM = { active = false, spray = false, sprayNames = {} }

function URANIUM.Wanted(def)
	if type(def) ~= "table" or type(def.Name) ~= "string" then
		return false
	end
	if URANIUM.active and def.Name == "Uranium Ore" then
		return true
	end
	if URANIUM.spray then
		local n = string.lower(def.Name)
		if string.find(n, "spray", 1, true) and string.find(n, "clean", 1, true) then
			if not URANIUM.sprayNames[def.Name] then
				URANIUM.sprayNames[def.Name] = true
				print("[Unfavourite] Treating \"" .. def.Name .. "\" as a cleaning spray")
			end
			return true
		end
	end
	return false
end

function URANIUM.RunPass()
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not ok or type(inventory) ~= "table" then
		return
	end
	for guid, entry in pairs(inventory) do
		if entry.Favorited == true then
			local def = Items[tostring(entry.ItemId)]
			if URANIUM.Wanted(def) then
				local invokeOk, newState = pcall(function()
					return REMOTES.ToggleFavoriteItem:InvokeServer(guid)
				end)
				-- One at a time, never a burst of remote calls.
				task.wait(0.3)
				if invokeOk and newState == false then
					print("[Unfavourite] Auto-unfavourited a " .. def.Name)
				elseif invokeOk and newState == true then
					-- The remote TOGGLES; something re-favourited it in the
					-- same window and this flipped it the wrong way. Left
					-- alone -- the next pass tries again.
					DebugPrint("[Uranium] Toggle came back still favourited, will retry")
				else
					DebugPrint("[Uranium] Toggle call failed, will retry: " .. tostring(newState))
				end
			end
		end
	end
end

function URANIUM.StartLoop()
	if LOOPGUARDS.uranium then
		return
	end
	LOOPGUARDS.uranium = true
	task.spawn(function()
		while (URANIUM.active or URANIUM.spray) and LOOPGUARDS.uranium and SESSION.alive do
			local passOk, passErr = pcall(URANIUM.RunPass)
			if not passOk then
				warn("[Uranium] Pass failed, continuing: " .. tostring(passErr))
			end
			-- 10s, not 5: each pass reads your whole inventory from the server.
			task.wait(10)
		end
		LOOPGUARDS.uranium = false
	end)
end

