	Name = "Garage Types",
	Options = FARM_GARAGE_TYPE_OPTIONS,
	CurrentOption = {},
	MultipleOptions = true,
	Flag = "AutoFarmGarageTypesDropdown",
	Callback = function(selected)
		-- A saved config can carry types the game has since removed (the
		-- Alien Garages, seen 2026-09-08). RayVoid draws no row for those,
		-- so they could never be unticked and sat in the "Checked:" line
		-- for good. Keep only what the game still has, and push the clean
		-- list back into the dropdown so the next slot save drops them.
		local kept, stale = {}, {}
		table.clear(FARM.selectedTypes)
		for _, garageName in ipairs(selected) do
			if FARM.knownTypes[garageName] then
				FARM.selectedTypes[garageName] = true
				table.insert(kept, garageName)
			else
				table.insert(stale, garageName)
			end
		end
		-- The priority dropdowns below only offer what is checked here.
		GARAGEPRIORITY.RefreshOptions()
		FARM.RefreshTypesSummary()
		if #stale > 0 then
			warn("[AutoFarm] Garage Types: " .. table.concat(stale, ", ") ..
				" no longer exist in the game -- dropped from the selection")
			FARM.PushCleanTypes(kept)
		end
	end,
})

