function RULES.ED.RenderLeft()
	local pane = RULES.ED.left
	for _, child in ipairs(pane:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end

	-- Two things live in this window: the rules, and the per-lane lists that
	-- used to be scattered over five tabs. The switch comes first because it
	-- decides what the rest of the window is showing.
	local modeRow = RULES.ED.Row(pane, 28, 0)
	RULES.ED.Button(modeRow, "Rules", UDim2.fromOffset(102, 24), UDim2.fromOffset(0, 2), {
		bg = (RULES.ED.mode ~= "filters") and RULES.ED.ACCENT or RULES.ED.CARD,
		bold = true, textSize = 12,
		onClick = function()
			RULES.ED.mode = "rules"
			RULES.ED.Render()
		end,
	})
	RULES.ED.Button(modeRow, "Lists", UDim2.fromOffset(102, 24), UDim2.fromOffset(106, 2), {
		bg = (RULES.ED.mode == "filters") and RULES.ED.ACCENT or RULES.ED.CARD,
		bold = true, textSize = 12,
		onClick = function()
			RULES.ED.mode = "filters"
			RULES.ED.Render()
		end,
	})

	-- The master switch only governs the Rules half -- the per-lane Lists
	-- (Filters) below do not go through RULES.enabled at all, so it has no
	-- effect there and is hidden rather than shown as a dead control. Flips
	-- the hidden RayVoid toggle (RULES.enabledToggle) rather than
	-- RULES.enabled directly, so the change still travels with the config
	-- slot.
	if RULES.ED.mode ~= "filters" then
		local switchRow = RULES.ED.Row(pane, 26, 1)
		RULES.ED.Label(switchRow, "Rules engine:", UDim2.fromOffset(100, 24), UDim2.fromOffset(0, 3),
			{ color = RULES.ED.DIM, textSize = 12 })
		RULES.ED.Button(switchRow, RULES.enabled and "ON" or "OFF", UDim2.fromOffset(60, 24), UDim2.fromOffset(104, 1), {
			bg = RULES.enabled and RULES.ED.GOOD or RULES.ED.BAD,
			bold = true, textSize = 12,
			onClick = function()
				local target = not RULES.enabled
				local didSet = RULES.enabledToggle and RULES.enabledToggle.Set and pcall(function()
					RULES.enabledToggle:Set(target)
				end)
				-- :Set() re-enters this same toggle's Callback, which already
				-- flips RULES.enabled and re-renders -- only fall back to doing
				-- it here if the control itself could not be reached.
				if not didSet then
					RULES.enabled = target
					RULES.RefreshSummary()
					RULES.ED.Render()
				end
			end,
		})
	end

	if RULES.ED.mode == "filters" then
		RULES.ED.Label(pane, "LISTS  (per lane)", UDim2.new(1, 0, 0, 20), nil,
			{ bold = true, color = RULES.ED.ACCENT, order = 2 })
		for laneIndex, lane in ipairs(FILTERS.ORDER) do
			local count = 0
			for _, entry in ipairs(FILTERS.ForLane(lane)) do
				local current = FILTERS.Current(entry)
				if entry.kind == "bool" then
					if current then
						count = count + 1
					end
				else
					count = count + #current
				end
			end
			local row = RULES.ED.Row(pane, 26, laneIndex + 2)
			RULES.ED.Button(row, FILTERS.SHORT[lane] .. "  (" .. count .. ")",
				UDim2.new(1, 0, 0, 24), UDim2.fromOffset(0, 1), {
					bg = (RULES.ED.lane == lane) and RULES.ED.ACCENT or RULES.ED.CARD,
					align = Enum.TextXAlignment.Left,
					padLeft = 8,
					textSize = 12,
					onClick = function()
						RULES.ED.lane = lane
						RULES.ED.Render()
					end,
				})
		end
		RULES.ED.Label(pane, "The number is how many things that lane filters on.",
			UDim2.new(1, 0, 0, 30), nil, { color = RULES.ED.DIM, textSize = 11, wrapped = true, order = 90 })
		return
	end

	RULES.ED.Label(pane, "RULES  (first match wins)", UDim2.new(1, 0, 0, 20), nil,
		{ bold = true, color = RULES.ED.ACCENT, order = 2 })

	for i = 1, RULES.COUNT do
		local rule = RULES.rules[i]
		local armed = RULES.RuleIsArmed(rule)
		local touched = RULES.AnySet(rule.effects) or RULES.RuleHasCriteria(rule)
		local enabled = rule.enabled ~= false
		-- A disabled rule reads as inactive even if it is fully armed --
		-- "touched" alone would still show it in the live CARD colour, which
		-- is exactly the false impression a switched-off rule must not give.
		local looksActive = touched and enabled
		local caption = i .. ".  "
		if rule.label ~= "" then
			caption = caption .. rule.label
		elseif touched then
			caption = caption .. "(unnamed)"
		else
			caption = caption .. "empty"
		end
		if touched and not armed then
			caption = caption .. "  !"
		end
		if not enabled then
			caption = caption .. "  (off)"
		end
		local row = RULES.ED.Row(pane, 26, i + 2)
		-- Per-rule on/off, independent of the "x"/"^"/"v" row actions and of
		-- the master switch above: pauses just this rule without deleting or
		-- unarming it, same trick as the master switch minus the RayVoid
		-- Flag -- this one already travels inside the rule's own JSON blob.
		RULES.ED.Button(row, enabled and "On" or "Off", UDim2.fromOffset(34, 24), UDim2.fromOffset(0, 1), {
			bg = enabled and RULES.ED.GOOD or RULES.ED.BAD,
			textSize = 11,
			onClick = function()
				rule.enabled = not enabled
				RULES.Save(i)
				RULES.ED.Render()
			end,
		})
		RULES.ED.Button(row, caption, UDim2.new(1, -114, 0, 24), UDim2.fromOffset(38, 1), {
			bg = (i == RULES.ED.current) and RULES.ED.ACCENT or (looksActive and RULES.ED.CARD or RULES.ED.BAR),
			color = looksActive and RULES.ED.TEXT or RULES.ED.DIM,
			align = Enum.TextXAlignment.Left,
			padLeft = 8,
			textSize = 12,
			onClick = function()
				RULES.ED.current = i
				RULES.ED.Render()
			end,
		})
		-- One click, no select-first: deletes THIS row directly, wherever the
		-- mouse already is. The "Clear" button below is the separate action
		-- that empties the CURRENT rule without removing its slot.
		RULES.ED.Button(row, "x", UDim2.fromOffset(22, 24), UDim2.new(1, -72, 0, 1), {
			bg = RULES.ED.BAD, textSize = 12,
			onClick = function()
				RULES.RemoveRuleAt(i)
				RULES.ED.current = math.min(RULES.ED.current, RULES.COUNT)
				RULES.ED.Render()
			end,
		})
		RULES.ED.Button(row, "^", UDim2.fromOffset(22, 24), UDim2.new(1, -48, 0, 1), {
			bg = RULES.ED.CARD2, textSize = 12,
			onClick = function()
				RULES.ED.Swap(i, i - 1)
			end,
		})
		RULES.ED.Button(row, "v", UDim2.fromOffset(22, 24), UDim2.new(1, -24, 0, 1), {
			bg = RULES.ED.CARD2, textSize = 12,
			onClick = function()
				RULES.ED.Swap(i, i + 1)
			end,
		})
	end

	local addRow = RULES.ED.Row(pane, 30, 99)
	RULES.ED.Button(addRow, "+ Add rule", UDim2.new(1, 0, 0, 24), UDim2.fromOffset(0, 3), {
		bg = RULES.ED.GOOD, textSize = 12,
		onClick = function()
			RULES.ED.current = RULES.AddRule()
			RULES.ED.Render()
		end,
	})

	local clearRow = RULES.ED.Row(pane, 30, 100)
	RULES.ED.Button(clearRow, "Clear rule " .. RULES.ED.current, UDim2.new(1, 0, 0, 24), UDim2.fromOffset(0, 3), {
		bg = RULES.ED.BAD, textSize = 12,
		onClick = function()
			RULES.rules[RULES.ED.current] = RULES.NewRule()
			RULES.Save(RULES.ED.current)
			RULES.ED.Render()
		end,
	})

	RULES.ED.Label(pane, "! = set up but not active yet", UDim2.new(1, 0, 0, 18), nil,
		{ color = RULES.ED.DIM, textSize = 11, order = 101 })
	RULES.ED.Label(pane, "(it needs both something to match and an effect)",
		UDim2.new(1, 0, 0, 30), nil, { color = RULES.ED.DIM, textSize = 11, wrapped = true, order = 102 })
	RULES.ED.Label(pane, "On/Off (left of each rule) pauses just that rule. The switch up top pauses all of them.",
		UDim2.new(1, 0, 0, 30), nil, { color = RULES.ED.DIM, textSize = 11, wrapped = true, order = 103 })
end

-- Order is the whole semantics of this tab -- first match wins -- so moving a
-- rule has to move its SAVED text too, not just the live table.
function RULES.ED.Swap(a, b)
	if b < 1 or b > RULES.COUNT then
		return
	end
	RULES.rules[a], RULES.rules[b] = RULES.rules[b], RULES.rules[a]
	RULES.SaveAll()
	if RULES.ED.current == a then
		RULES.ED.current = b
	elseif RULES.ED.current == b then
		RULES.ED.current = a
	end
	RULES.ED.Render()
end

function RULES.ED.RenderFooter()
	if not RULES.ED.footer then
		return
	end
	if RULES.ED.mode == "filters" then
		RULES.ED.footer.Text = "Lists decide which items a lane touches. A rule beats a list for the items it names."
		return
	end
	RULES.ED.footer.Text = RULES.Describe(RULES.ED.current)
end

function RULES.ED.Render()
	if not RULES.ED.gui then
		return
	end
	RULES.ED.RenderLeft()
	RULES.ED.RenderRight()
	RULES.ED.RenderFooter()
end

function RULES.ED.Close()
	if RULES.ED.gui then
		RULES.ED.gui:Destroy()
		RULES.ED.gui = nil
	end
	RULES.ED.picker = nil
	-- Also sweep by name: a run that died without unloading leaves its window
	-- in PlayerGui, and RayVoid's own DestroyAll never reaches it.
	pcall(function()
		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
		if playerGui then
			for _, child in ipairs(playerGui:GetChildren()) do
				if child.Name == "ItemRulesEditor" then
					child:Destroy()
				end
			end
		end
	end)
end

