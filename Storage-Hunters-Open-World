-- =========================================================
-- TOWN DEFENSE (Wild West event) -- fights bandit waves at the Sheriff.
-- Dying is a hard failure (per the user) and costs
-- TownDefenseConfig.PlayerCooldownSeconds (30 min) regardless of outcome,
-- so this backs off and retreats to heal rather than trading hits down
-- to zero.
--
-- The whole session state is broadcast as ATTRIBUTES ON THE REMOTES
-- FOLDER, ReplicatedStorage.Events.TownDefense -- measured live
-- 2026-09-15 off the game's own TownDefenseClient render(): Phase,
-- EventId, Wave, WaveTotal, Remaining, Alive, Players, EndsAt, Message.
-- The game's own "am I in this session" test is
-- LocalPlayer:GetAttribute("TownDefenseId") == EventId, and Phase cycles
-- Idle -> Preparing -> Wave <-> Intermission -> Victory / Cancelled /
-- (defeat). Every one of those replaces a guess this feature used to
-- make, and each guess was one of the user's symptoms (
-- "defend never joins or never ends"):
--   * It never checked whether a defense was open at all -- it just fired
--     Join at the Sheriff every 15s, teleporting the player there each
--     time, and read the refusal. Now it only goes when Phase says there
--     is something to join and the cooldown attribute says we are
--     eligible.
--   * It ended the fight on "no TownDefenseEnemy-tagged model for 30
--     seconds", which is neither the start (Preparing is 20s of no
--     enemies) nor the end (Intermission is 10s of no enemies) of
--     anything -- so it would drop out between waves, or stand at the
--     Sheriff forever if any tagged model lingered. Now it ends on Phase.
--   * The retreat-to-heal (below) aimed at the Sheriff, then the Saloon,
--     then under the town floor, then street-level cover -- the user saw
-- the first two get the player killed, and the other
--     two ended defenses with "The bandits couldn't reach town". It heals
--     on a ROOF and nowhere else now; see Retreat() for why.
-- =========================================================
GOLDPAN.WW.TownDefense = {
	active = false,
	Config = SafeRequire(ReplicatedStorage.Modules.TownDefenseConfig, "TownDefenseConfig"),
	-- The user's original number was 15%, not 35% -- but at 15% (15 HP) the
	-- player was killed in wave 5: "Backing out of the fight to
	-- heal" printed, meaning Retreat() DID fire, and the player was
	-- eliminated anyway. Wave 5 hits for 9 damage on a 1.4s interval PER
	-- bandit, several of which can be engaged at once -- 15 HP of margin is
	-- less than three hits, easily lost to damage already "in flight" the
	-- instant the threshold is crossed, before the teleport can take effect.
	-- Raised to 30% (30 HP) for a bigger cushion against that same race
	-- rather than just hoping the Engage() fix above (which was ALSO part
	-- of this bug -- see its comment) closes the gap by itself. Only heal
	-- to 50% before rejoining -- no need to sit at full before going back
	-- in.
	-- Raised from 0.30 to 0.50, and heal to 0.95 rather than 0.5, measured
	-- Wave 5 deals ~143 damage in one wave, so 30% (30 HP) is
	-- already inside one bad exchange of death -- the run that reached wave
	-- 5 retreated exactly once, at 24 HP, and died. Healing is nearly free
	-- now that it happens on a roof nothing can walk to, so it pays to leave
	-- early and come back full rather than trade at low health.
	fleeHealthFraction = 0.50,
	-- 0.85, not 0.95: each retreat then lasts ~35s from the 50% flee point
	-- rather than ~45s, because time spent where bandits cannot reach us is
	-- exactly what cancelled a defense once ("The bandits couldn't reach
	-- town"), and two long retreats in one wave would exceed the ~84s that
	-- did it. Unmeasured whether a roof counts the same way as under the
	-- map -- this defense is the test.
	healToFraction = 0.85,
	-- Regen measured at 1 HP/s (3 s samples on a roof), so from
	-- 5 HP to a 70% heal target takes ~65 s. Only a backstop for a heal that
	-- never gets there; health or a bandit's line of sight ends it first.
	healMaxSeconds = 90,
	-- Roof time is rationed because the game DOES end a defense when the player
	-- is out of reach too long: "The bandits couldn't reach town." Measured
	-- With no cap at all, standing on real roofs: wave 4 spent
	-- 55 s up there without a cancel, then wave 5 was cancelled 39 s in. So it
	-- is not a per-wave clock -- the three earlier cancels came at ~84 s and
	-- ~94 s of hiding across a defense, which fits a running total (inferred;
	-- TownDefenseConfig has MaxReplacements 8, and an extra 390 boss spawned
	-- while the player was on a roof at 15:48). Waves 1-4 keep the 25 s / 15 s
	-- per wave / stint that never cancelled; the LAST wave, the only one that
	-- has killed the player, gets unreachableLastWaveSeconds with no stint cap,
	-- so a heal there runs to the Heal-To %. Worst realistic total: 25 in wave
	-- 4 plus 40 in wave 5, well under the smallest cancel on record.
	unreachableBudgetSeconds = 25,
	unreachableStintSeconds = 15,
	unreachableLastWaveSeconds = 40,
	unreachableWave = nil,
	unreachableUsed = 0,
	-- os.clock() before which no retreat is tried (see CanRetreat). Set by
	-- Retreat() itself: retreatNoRoofPause after a sweep found no roof, so a
	-- low-health fight is not cut every frame for another full sweep, and
	-- retreatAfterStintPause after a stint on a roof, so the bandits really get
	-- a reachable target before the next one. Nothing else clears it; left
	-- alone it simply expires.
	retreatPausedUntil = 0,
	retreatNoRoofPause = 3,
	retreatAfterStintPause = 5,
	-- How far the nearest bandit must be for a roof to be worth healing on.
	-- Beyond this, more distance only drags the wave further out of town --
	-- and "The bandits couldn't reach town" is how three defenses ended.
	healSpotMinGap = 35,
	-- How high above the street a surface has to be to count as a roof a
	-- bandit cannot walk onto, and how high is still plausibly a building
	-- rather than the cliffs around the arena. Measured: the
	-- town's flat roofs sit 27-33 studs above Rally.
	roofMinHeight = 12,
	roofMaxHeight = 55,
	-- Roofs that failed to hold the player, keyed by a 4-stud grid cell, so a
	-- bad one is never offered twice. Cleared on reload only; the arena does
	-- not change shape mid-session.
	badRoofs = {},
	-- Falls off one roof before it is written off. One can be a bump; three
	-- means there is no floor there.
	roofMaxFalls = 2,
	-- The Heartbeat connection pinning the player under the floor while
	-- hidden. Cleared by Retreat() on every exit path and by
	-- SESSION.Unload (it is tracked); if neither ran the player would be
	-- held under the town for good, which is why Retreat() pcalls its wait.
	hideHold = nil,
	-- Cap on the post-defense body pickup (see RunDefense). The Outlaw
	-- sweep's own cap, and far under the bodies' 600s lifetime.
	collectMaxSeconds = 180,
	-- 5 waves x WaveTimeoutSeconds 240 + prep + intermissions is ~21 min
	-- worst case; this is the backstop that stops a session whose Phase
	-- attribute somehow never resolves from owning the floor forever.
	maxSessionSeconds = 1500,
	-- Phases in which the player is committed to a running defense.
	livePhases = { Preparing = true, Wave = true, Intermission = true },
	-- Phases worth walking up to the Sheriff for. Idle means nobody has
	-- started one (joining starts it); Preparing is the 20s window the
	-- game's own HUD advertises as "Friends can join at the sheriff".
	joinablePhases = { Idle = true, Preparing = true },
	-- Only after a refusal the eligibility attribute did not predict --
	-- the normal 30-min wait is read straight off the player now, not
	-- parsed out of the Sheriff's chat line.
	retryAfter = 0,
	warnedNoGun = false,
	warnedRaceSoon = false,
	-- Don't start a defense with less than this until the next horse race
	-- (when Auto Horse Race is on). Race takes the floor 75 s before its start
	-- (handoffLeadSeconds) and a defense it cuts short is forfeited outright.
	-- Measured wins: 150-218 s from Preparing to Victory. 360 s
	-- (the user's call 2026-09-18, was 300) leaves the fight ~285 s: at 300 the
	-- 12:40 defense took 218 of its ~225 s and Race asked for the floor 13 s
	-- before its Victory. It was 660, sized for the ~8-min runs of older
	-- builds. Races come every 900 s, so this leaves a 9-min window per cycle.
	raceClearanceSeconds = 360,
	-- The wave the "under a minute left to clear" warning last fired for, so
	-- it fires once per wave (see RunDefense). Reset at the start of each run.
	clockWarnedWave = nil,
	-- Bandits with no firing line from any peek spot, set aside until the
	-- os.clock() stored here so FindEnemy picks one we CAN hit (see
	-- RunDefense). Weak keys: a dead bandit's model drops out on its own.
	noLineUntil = setmetatable({}, { __mode = "k" }),
	noLineSkipSeconds = 6,
	-- At or under this, with no roof heal available, peeks only go up where
	-- no other bandit can see (EngageFromCover's critical hold). The boss hits
	-- for about 20 (measured 2026-09-18), so 25 HP is one boss hit from dead.
	criticalHealthFraction = 0.25,
}

-- The remotes folder doubles as the session's state board (see the section
-- header). FindFirstChild, never WaitForChild: this is a Wild-West-only
-- folder and a hard wait here would hang the whole script load when the
-- event is not running.
function GOLDPAN.WW.TownDefense.Board()
	local events = ReplicatedStorage:FindFirstChild("Events")
	local folder = events and events:FindFirstChild("TownDefense")
	return folder
end

function GOLDPAN.WW.TownDefense.Phase()
	local board = GOLDPAN.WW.TownDefense.Board()
	if not board then
		return nil
	end
	return board:GetAttribute("Phase")
end

-- The game's own in-session test, copied from TownDefenseClient render().
function GOLDPAN.WW.TownDefense.InSession()
	local board = GOLDPAN.WW.TownDefense.Board()
	if not board then
		return false
	end
	local mine = LocalPlayer:GetAttribute("TownDefenseId")
	if mine == nil then
		return false
	end
	return mine == board:GetAttribute("EventId")
end

-- TownDefenseNextEligibleAt is an os.time() unix stamp on the player,
-- written by the server -- measured live 2026-09-15 against os.time().
-- Reading it is what makes the join attempt rare instead of constant:
-- the old code learned the same 30-minute number by teleporting to the
-- Sheriff, firing the remote and parsing "16 min 26 sec" out of the
-- refusal, every 15 seconds, for half an hour.
function GOLDPAN.WW.TownDefense.SecondsUntilEligible()
	local nextAt = LocalPlayer:GetAttribute("TownDefenseNextEligibleAt")
	if type(nextAt) ~= "number" then
		return 0
	end
	return nextAt - os.time()
end

function GOLDPAN.WW.TownDefense.Join()
	local sheriff = game:GetService("CollectionService"):GetTagged("BountyHunterNPC")[1]
	if not sheriff then
		return false
	end

	-- "Come closer to sign up" is the server judging the player's distance from
	-- where IT last saw them, and the teleport made a moment ago (from a
	-- garage thousands of studs away, usually) has not always reached it: 25 of
	-- them in one 6-hour console, each costing a minute's back-off, the floor
	-- handed to Auto Farm and taken back, and a defense that started minutes
	-- late. So after a teleport wait for the gameplay pause to clear and give
	-- the server a moment, and answer that particular refusal with a short
	-- retry instead of the minute.
	local ok, result, line
	for attempt = 1, 3 do
		local hrp = GetFreshHRP()
		local posOk, sheriffPosition = pcall(function() return sheriff:GetPivot().Position end)
		if hrp and posOk then
			local offset = sheriffPosition - hrp.Position
			if offset.Magnitude > 9 then
				TeleportPlayerOnly(sheriffPosition - offset.Unit * 8)
				local waited = 0
				while LocalPlayer.GameplayPaused and waited < 2 do
					task.wait(0.1)
					waited = waited + 0.1
				end
				task.wait(0.5)
			end
		end

		ok, result = pcall(function()
			return ReplicatedStorage.Events.TownDefense.Join:InvokeServer(sheriff)
		end)
		if ok and type(result) == "table" and result.success then
			DebugPrint("[AutoTownDefense] Join accepted on attempt " .. attempt)
			return true
		end
		line = ok and type(result) == "table" and result.line
		if type(line) == "string" and string.find(line, "Come closer", 1, true) and attempt < 3 then
			DebugPrint("[AutoTownDefense] Join refused (" .. line .. ") on attempt " .. attempt .. ", trying again")
			task.wait(1)
		else
			break
		end
	end

	-- The eligibility attribute already covers the ordinary 30-minute wait,
	-- so anything that reaches here is a refusal it did not predict (a full
	-- lobby, a defense that closed between the phase read and the call).
	-- Say it, back off a minute, and let the next phase read decide.
	GOLDPAN.WW.TownDefense.retryAfter = os.clock() + 60
	if type(line) == "string" then
		warn("[AutoTownDefense] Join refused: " .. line)
	elseif not ok then
		warn("[AutoTownDefense] Join failed: " .. tostring(result))
	else
		warn("[AutoTownDefense] Join refused with no reason given")
	end
	return false
end

-- Bandits carry the session's EventId in their own TownDefenseId attribute
-- (measured off TownDefenseClient) -- matching on it means a
-- leftover or someone else's tagged model can never be mistaken for an
-- enemy of ours, which is what a bare tag scan would do.
-- The second value is true when every live bandit is set aside (see
-- noLineUntil), i.e. the one returned is the least bad of the unhittable.
function GOLDPAN.WW.TownDefense.FindEnemy()
	local cfg = GOLDPAN.WW.TownDefense.Config
	local setAside = GOLDPAN.WW.TownDefense.noLineUntil
	local hrp = GetFreshHRP()
	if not cfg or not hrp then
		return nil
	end
	local board = GOLDPAN.WW.TownDefense.Board()
	local eventId = board and board:GetAttribute("EventId")
	local best, bestDistance
	local fallback, fallbackScore
	for _, model in ipairs(game:GetService("CollectionService"):GetTagged(cfg.EnemyTag)) do
		local mine = true
		if eventId ~= nil and model:GetAttribute("TownDefenseId") ~= nil then
			mine = model:GetAttribute("TownDefenseId") == eventId
		end
		if model.Parent and mine then
			local rootPart = model:FindFirstChild("HumanoidRootPart")
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if rootPart and humanoid and humanoid.Health > 0 then
				-- WEAKEST first, not nearest. Measured: wave 5
				-- fields 4x130 + a 208 + a 390 = 1118 HP, and every one of
				-- them shoots the whole time it is alive. Nearest-first can
				-- spend the wave chewing the 390 boss while five others fire;
				-- killing the cheapest target removes a shooter every ~3s and
				-- cuts the incoming rate fastest. Distance is only a
				-- tiebreak, so a far weak target still beats a near tough one.
				local distance = (rootPart.Position - hrp.Position).Magnitude
				local score = humanoid.Health + distance * 0.3
				if (setAside[model] or 0) > os.clock() then
					if not fallbackScore or score < fallbackScore then
						fallback, fallbackScore = model, score
					end
				elseif not bestDistance or score < bestDistance then
					best, bestDistance = model, score
				end
			end
		end
	end
	if best then
		return best, false
	end
	return fallback, fallback ~= nil
end

function GOLDPAN.WW.TownDefense.HealthOk()
	local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.MaxHealth <= 0 then
		return true
	end
	return (humanoid.Health / humanoid.MaxHealth) > GOLDPAN.WW.TownDefense.fleeHealthFraction
end

-- Where to hide: under the town floor, straight below the Rally point.
-- Both spots tried before got the player killed. The Saloon's wall stands
-- ~6 studs from the bandit spawn "05_SaloonSide" (measured); that bandits
-- then walk in or shoot through is inferred, not watched. Anywhere a
-- bandit can walk to is out. Measured: the
-- whole town stands on ONE part ("BBOW Builder Assets"...grassbase),
-- 15 studs thick (y 1704.8 to 1719.8), with nothing below it, while
-- workspace.TownDefense.Bounds reaches down to y 1690. Halfway between
-- the two (y ~1697) is still inside the defense box but under 15 studs
-- of solid ground: no bandit can walk there, and a shot from above has
-- to go through the slab. A 4s hold there kept the player in place with
-- no damage and no reset. STILL UNPROVEN in a live wave: that the server
-- stops a bandit's shot at the slab (their config has spread and "wide
-- shot" misses, which suggests real ray shots -- inferred, not measured)
-- and that the server's Bounds check is a full 3D box (Retreat() watches
-- TownDefenseAwaySeconds to catch it if not).
-- Measured each time rather than stored, so a moved or rebuilt town
-- shows up as a warning instead of a teleport into open air.
function GOLDPAN.WW.TownDefense.HideSpot()
	local cfg = GOLDPAN.WW.TownDefense.Config
	local arena = workspace:FindFirstChild(cfg and cfg.ArenaFolder or "TownDefense")
	local rally = arena and arena:FindFirstChild("Rally")
	local bounds = arena and arena:FindFirstChild("Bounds")
	if not rally or not bounds then
		return nil, "no TownDefense Rally/Bounds in workspace"
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LocalPlayer.Character }
	params.RespectCanCollide = true
	local bottom = bounds.Position.Y - bounds.Size.Y / 2
	local base = Vector3.new(rally.Position.X, bottom + 1, rally.Position.Z)
	local cover = workspace:Raycast(base, Vector3.new(0, 60, 0), params)
	if not cover then
		return nil, "nothing solid above the spot under the Rally point"
	end
	-- A character needs ~6 studs of height; less room than 10 means the
	-- floor has moved down into the box and the math above no longer holds.
	if cover.Position.Y - bottom < 10 then
		return nil, string.format("only %.1f studs between the defense box floor and the ground", cover.Position.Y - bottom)
	end
	return Vector3.new(base.X, (bottom + cover.Position.Y) / 2, base.Z)
end

function GOLDPAN.WW.TownDefense.StopHide()
	local me = GOLDPAN.WW.TownDefense
	if me.hideHold then
		pcall(function() me.hideHold:Disconnect() end)
		me.hideHold = nil
	end
end

-- Ends a hide and puts the player back where they hid from. Also called by
-- SESSION.Unload: a reload mid-hide would otherwise drop the character out
-- from under the town. A plain CFrame write, no waits, so Unload can call it.
function GOLDPAN.WW.TownDefense.Surface()
	local me = GOLDPAN.WW.TownDefense
	local wasHidden = me.hideHold ~= nil
	me.StopHide()
	local back = me.hideReturn
	me.hideReturn = nil
	local hrp = GetFreshHRP()
	if wasHidden and back and hrp then
		pcall(function() hrp.CFrame = CFrame.new(back) end)
		ZeroVelocity(hrp)
	end
end

-- Hides under the town and waits for health to climb back to
-- healToFraction before returning to the fight -- the user's own
-- suggestion ("tp away to heal"), used here because death is the one
-- unrecoverable outcome. `maxSeconds` is short when we are retreating to
-- hand the floor over (Race is waiting on us and its lead window is
-- finite) and long when we are retreating to heal and intend to come
-- back. Nothing holds a character under a floor, so a Heartbeat pins it
-- there each frame, and the player is always put back up where they
-- came from afterwards: released down there, they would fall forever.
-- A flat rooftop inside the arena to heal on. The user's call,
-- after watching the street-level spot fail exactly as designed: it was
-- chosen BECAUSE bandits could walk to it, and they walked to it and killed
-- the player at 24 HP. A roof cannot be walked to, and it is real cover --
-- the building's own edge hides anyone standing on it from a bandit nearby,
-- which is the opposite of hovering in mid-air (measured: 12 of 12 hits at
-- 100 studs up in open air, because nothing is in the way there).
--
-- Two things measured while building this, both load-bearing:
--   * There are 8 invisible `AreaBoundary` parts 99 studs above the town.
--     A downward ray from higher than that hits them every time and finds no
--     roof at all, which is what made the first search come back empty.
--   * Roofs must be checked for FLATNESS. A pitched roof reads as ground at
--     the ray point and slides the player straight off.
-- `minGap` overrides healSpotMinGap, so a caller with nothing else left can
-- ask for any out-of-sight roof rather than none at all.
function GOLDPAN.WW.TownDefense.RoofSpot(minGap)
	local me = GOLDPAN.WW.TownDefense
	local cfg = me.Config
	local arena = workspace:FindFirstChild(cfg and cfg.ArenaFolder or "TownDefense")
	local rally = arena and arena:FindFirstChild("Rally")
	local bounds = arena and arena:FindFirstChild("Bounds")
	if not rally or not bounds then
		return nil
	end
	local half = bounds.Size / 2
	-- The AreaBoundary parts never move, so the list is built once. It used to
	-- be rebuilt from workspace:GetDescendants() on EVERY call -- tens of
	-- thousands of instances -- and this function is called several times a
	-- second during a heal. Roblox killed the client for "hanging past
	-- timeout" in wave 5 (13:07 local) with that version live.
	if not me.boundaryIgnore then
		me.boundaryIgnore = {}
		for _, part in ipairs(workspace:GetDescendants()) do
			if part:IsA("BasePart") and part.Name == "AreaBoundary" then
				table.insert(me.boundaryIgnore, part)
			end
		end
	end
	local ignore = { LocalPlayer.Character }
	for _, part in ipairs(me.boundaryIgnore) do
		table.insert(ignore, part)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	-- Rays pass THROUGH non-solid parts. Measured: the town has an
	-- invisible, non-collidable 41x49 sheet 34 studs up (Wild West Event.Part,
	-- Transparency 1, CanCollide false). Without this it read as a flat roof,
	-- the player was put on it, fell through, got caught and put back, over and
	-- over in mid-air -- and four defenses were lost to it.
	params.RespectCanCollide = true
	local streetY = rally.Position.Y
	local best, bestGap = nil, -1
	-- Also the best roof ignoring the gap rule, so a caller that finds nothing
	-- far enough does not pay for a second full sweep (see the `minGap`
	-- fallback this replaces).
	local anyBest, anyGap = nil, -1
	local checked = 0
	for _, radius in ipairs({ 40, 60, 80, 25, 100 }) do
		for angle = 0, 350, 20 do
			-- Spread the sweep over frames: up to 90 candidates, each firing
			-- five rays plus one per live enemy, is far too much for a single
			-- frame with eight bandits on the field.
			checked = checked + 1
			if checked % 12 == 0 then
				task.wait()
			end
			local radians = math.rad(angle)
			local at = rally.Position + Vector3.new(math.cos(radians) * radius, 0, math.sin(radians) * radius)
			local inBox = bounds.CFrame:PointToObjectSpace(at)
			if math.abs(inBox.X) < half.X - 8 and math.abs(inBox.Z) < half.Z - 8 then
				-- From below the AreaBoundary ceiling, never above it.
				local hit = workspace:Raycast(at + Vector3.new(0, 60, 0), Vector3.new(0, -160, 0), params)
				-- Solid AND visible. RespectCanCollide already drops non-solid
				-- parts; a see-through solid one is still not a building.
				local key = hit and (math.floor(hit.Position.X / 4) .. "," .. math.floor(hit.Position.Z / 4))
				if hit and hit.Instance.Transparency < 0.95 and not me.badRoofs[key] then
					local up = hit.Position.Y - streetY
					if up > me.roofMinHeight and up < me.roofMaxHeight then
						local flat = true
						for _, off in ipairs({ Vector3.new(5, 0, 0), Vector3.new(-5, 0, 0), Vector3.new(0, 0, 5), Vector3.new(0, 0, -5) }) do
							local probe = workspace:Raycast(at + off + Vector3.new(0, 60, 0), Vector3.new(0, -160, 0), params)
							if not probe or math.abs(probe.Position.Y - hit.Position.Y) > 1.5 then
								flat = false
								break
							end
						end
						if flat then
							local spot = hit.Position + Vector3.new(0, 3.5, 0)
							-- Out of sight beats merely high: a bandit far enough
							-- back still gets an angle over the edge. Bandits
							-- only -- see EnemiesSeeing's onlyTag comment.
							if GOLDPAN.WW.Combat.EnemiesSeeing(spot, nil, cfg and cfg.EnemyTag or "TownDefenseEnemy") == 0 then
								local gap = me.NearestEnemyDistance(spot)
								-- The closest safe roof to TOWN, not the farthest
								-- from the bandits: healing at the arena edge walks
								-- the whole wave out there after us, and the board's
								-- reason for all three cancels was that the bandits
								-- could not reach town.
								local toTown = (spot - rally.Position).Magnitude
								if gap >= (minGap or me.healSpotMinGap) and (not best or toTown < bestGap) then
									best, bestGap = spot, toTown
								end
								if not anyBest or toTown < anyGap then
									anyBest, anyGap = spot, toTown
								end
							end
						end
					end
				end
			end
		end
	end
	if not best then
		-- Nothing with the gap to spare; hand back the nearest safe roof so the
		-- caller can decide, instead of sweeping the whole arena again.
		if anyBest then
			return nil, nil, anyBest
		end
		return nil
	end
	return best, bestGap, anyBest
end

-- Seconds of time-off-the-map left in the current wave (see
-- unreachableBudgetSeconds). Rolls the budget over when the wave changes.
function GOLDPAN.WW.TownDefense.UnreachableLeft()
	local me = GOLDPAN.WW.TownDefense
	local board = me.Board()
	local wave = board and board:GetAttribute("Wave")
	if wave ~= me.unreachableWave then
		me.unreachableWave = wave
		me.unreachableUsed = 0
		-- New wave, new budget -- worth warning about again if it runs out a
		-- second time (see Retreat()'s two latched warns below).
		me.warnedRoofBudgetGone = false
		me.warnedNoRoofFree = false
	end
	local budget = me.unreachableBudgetSeconds
	if me.OnLastWave() then
		budget = me.unreachableLastWaveSeconds
	end
	return budget - me.unreachableUsed
end

-- The wave that ends the defense (board WaveCount, 5 when unreadable).
function GOLDPAN.WW.TownDefense.OnLastWave()
	local board = GOLDPAN.WW.TownDefense.Board()
	local wave = board and board:GetAttribute("Wave")
	local count = board and board:GetAttribute("WaveCount")
	if type(count) ~= "number" then
		count = 5
	end
	return type(wave) == "number" and wave >= count
end

-- Whether a retreat is worth trying right now, answered cheaply (no roof
-- sweep): the wave still has roof time, and Retreat() has not just paused
-- itself. The fight loop's abort asks this AND low health, never low health
-- alone -- measured: with the budget spent, "abort when
-- health is low" was true before the first shot, so every engage returned at
-- once and the player stood in the open until eliminated.
function GOLDPAN.WW.TownDefense.Critical()
	local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.MaxHealth <= 0 then
		return false
	end
	return (humanoid.Health / humanoid.MaxHealth) <= GOLDPAN.WW.TownDefense.criticalHealthFraction
end

function GOLDPAN.WW.TownDefense.CanRetreat()
	local me = GOLDPAN.WW.TownDefense
	return os.clock() >= me.retreatPausedUntil and me.UnreachableLeft() >= 5
end

-- Distance from `position` to the closest live bandit, or math.huge when the
-- field is empty. Used to prefer the quietest corner of the arena.
function GOLDPAN.WW.TownDefense.NearestEnemyDistance(position)
	local cfg = GOLDPAN.WW.TownDefense.Config
	local tag = cfg and cfg.EnemyTag or "TownDefenseEnemy"
	local closest = math.huge
	for _, model in ipairs(game:GetService("CollectionService"):GetTagged(tag)) do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local rootPart = model:FindFirstChild("HumanoidRootPart")
		if humanoid and rootPart and humanoid.Health > 0 then
			closest = math.min(closest, (rootPart.Position - position).Magnitude)
		end
	end
	return closest
end

-- Heals on a ROOF, and nowhere else (the user's call 2026-09-17, second
-- instruction: another player told them roofs work fine). Everything that
-- used to be a fallback is gone:
--   * Under the map. Perfect cover, zero hits taken down there -- and three
--     defenses ended `Cancelled`, "The bandits couldn't reach town", every
--     one of them in a run with long hides below the world.
--   * Street-level cover. Chosen precisely because bandits could walk to it,
--     and they walked round the corner and killed the player at 24 HP.
-- If no roof is free, the retreat does not happen at all and the fight goes
-- on: a roof is the only place this is allowed to heal.
--
-- The player STANDS on the roof -- no per-frame pin. Being frozen in place is
-- what the user did not want, and a character held in the air is also the one
-- thing a bandit cannot walk to. The hold below only catches a fall off the
-- edge, and a roof that will not hold the player is written off (badRoofs).
-- Returns true when the player went up on a roof, false when there was none
-- to go to. Either way it leaves retreatPausedUntil set, so the caller's
-- next stretch of fighting is not cut short by another attempt at once.
function GOLDPAN.WW.TownDefense.Retreat(maxSeconds)
	local me = GOLDPAN.WW.TownDefense
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = GetFreshHRP()
	if not humanoid or not hrp or humanoid.MaxHealth <= 0 then
		warn("[AutoTownDefense] No character to move -- cannot back out of the fight")
		me.retreatPausedUntil = os.clock() + me.retreatNoRoofPause
		return false
	end
	-- A roof is somewhere the bandits cannot walk to, so it is still rationed
	-- per wave: see unreachableBudgetSeconds.
	if me.UnreachableLeft() < 5 then
		-- Latched: unlatched, this once spun 5000 prints in 2s and froze the
		-- client. The caller no longer comes here with the budget spent
		-- (CanRetreat), so this is only reached by a direct call; the one-frame
		-- yield stays so even that cannot spin.
		GOLDPAN.WW.ReportBlocked(me, "warnedRoofBudgetGone",
			"[AutoTownDefense] This wave's time up on a roof is used up -- fighting on so the bandits can reach town")
		task.wait()
		return false
	end
	local roof, _, anyRoof = me.RoofSpot()
	if not roof and anyRoof then
		-- Nothing with healSpotMinGap to spare. Any out-of-sight roof still
		-- beats trading shots at half health, and the sweep already found the
		-- best one, so take it rather than not retreating at all.
		roof = anyRoof
	end
	if not roof then
		-- The sweep is the expensive part, so the fight gets retreatNoRoofPause
		-- seconds before the next one rather than being cut every frame.
		me.retreatPausedUntil = os.clock() + me.retreatNoRoofPause
		GOLDPAN.WW.ReportBlocked(me, "warnedNoRoofFree",
			"[AutoTownDefense] No roof is out of sight right now -- fighting on rather than healing somewhere they can walk to")
		task.wait()
		return false
	end
	GOLDPAN.WW.ClearBlocked(me, "warnedRoofBudgetGone", "[AutoTownDefense] Roof budget renewed for the new wave")
	GOLDPAN.WW.ClearBlocked(me, "warnedNoRoofFree", "[AutoTownDefense] A roof opened up")

	local startHealth = humanoid.Health
	-- Measured here, not RoofSpot's second value: that one is the roof's
	-- distance to TOWN, and this line printed it as the bandit gap until
	-- 2026-09-17.
	warn(string.format("[AutoTownDefense] Backing out of the fight to heal (%d HP), onto a roof %d studs from the nearest bandit",
		math.floor(startHealth), math.floor(math.min(me.NearestEnemyDistance(roof), 9999))))
	-- The peek hold and this one would fight over the character.
	GOLDPAN.WW.Combat.Unpin()
	me.StopHide()
	me.hideReturn = hrp.Position

	local standOn = roof
	local roofFalls = 0
	-- The roof the player was last put on. Starts empty so the first frame
	-- places them exactly: TeleportPlayerOnly aims 5 studs high, which on a
	-- roof would drop them back down through the edge.
	local placedOn = nil
	TeleportPlayerOnly(standOn - Vector3.new(0, 5, 0))
	me.hideHold = SESSION.Track(game:GetService("RunService").Heartbeat:Connect(function()
		-- A respawned character must never be dragged back up.
		if LocalPlayer.Character ~= character then
			me.StopHide()
			return
		end
		local root = GetFreshHRP()
		if not root then
			return
		end
		if standOn ~= placedOn then
			-- A new roof was picked. With no pin nothing else moves the player
			-- there, so place them once and let them stand.
			placedOn = standOn
			pcall(function() root.CFrame = CFrame.new(standOn) end)
			ZeroVelocity(root)
		elseif root.Position.Y < standOn.Y - 6 then
			-- Fell off; put it back and let go again. Counted, because a roof
			-- that keeps dropping the player has no floor to stand on.
			roofFalls = roofFalls + 1
			pcall(function() root.CFrame = CFrame.new(standOn) end)
			ZeroVelocity(root)
		end
	end))

	local lowest = startHealth
	local warnedHit, warnedAway, warnedFloating = false, false, false
	local ok, err = pcall(function()
		local waited = 0
		-- Unbroken seconds on a roof; see unreachableStintSeconds.
		local stint = 0
		local floating = 0
		local lastPick = os.clock()
		while waited < (maxSeconds or me.healMaxSeconds) and SESSION.alive do
			if LocalPlayer.Character ~= character or humanoid.Health <= 0 then
				break
			end
			if (humanoid.Health / humanoid.MaxHealth) >= me.healToFraction then
				break
			end
			-- Nothing left to hide from; the pickup is waiting.
			if not me.livePhases[tostring(me.Phase())] then
				break
			end

			me.unreachableUsed = me.unreachableUsed + 0.5
			stint = stint + 0.5
			-- No stint cap on the last wave: the heal there runs to the target
			-- or to the end of the wave's roof time (see unreachableLastWaveSeconds).
			local stintCap = me.unreachableStintSeconds
			if me.OnLastWave() then
				stintCap = math.huge
			end
			if me.UnreachableLeft() <= 0 or stint >= stintCap then
				warn(string.format("[AutoTownDefense] %ds on the roof is enough -- back to the fight so the bandits can reach town (%d HP)",
					math.floor(stint), math.floor(humanoid.Health)))
				break
			end

			-- Re-picking a roof sweeps the whole arena, so it happens at most
			-- once every couple of seconds however often a bandit glances up
			-- here or the player slips off an edge.
			local canRepick = (os.clock() - lastPick) > 2

			-- Really standing on it, not hovering over it or stuck inside it:
			-- a character the hold is catching in mid-air is exactly as
			-- unreachable as being under the map, and it heals just as slowly.
			local state = humanoid:GetState()
			if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Flying then
				floating = floating + 0.5
			else
				floating = 0
			end
			if canRepick and (floating >= 2 or roofFalls > me.roofMaxFalls) then
				lastPick = os.clock()
				me.badRoofs[math.floor(standOn.X / 4) .. "," .. math.floor(standOn.Z / 4)] = true
				if not warnedFloating then
					warnedFloating = true
					warn(string.format("[AutoTownDefense] The roof at %d, %d, %d will not hold the player (%d falls, %.0fs in the air) -- never using it again",
						math.floor(standOn.X), math.floor(standOn.Y), math.floor(standOn.Z), roofFalls, floating))
				end
				roofFalls, floating = 0, 0
				local instead, _, insteadAny = me.RoofSpot()
				instead = instead or insteadAny
				if not instead then
					warn("[AutoTownDefense] No other roof is free -- back to the fight")
					break
				end
				standOn = instead
			end

			-- A bandit that can see the roof ends the cover, and so does a hit
			-- landing: measured, warning and staying put got the
			-- player killed up there. Move to another roof or go back down.
			local seen = false
			if canRepick then
				seen = GOLDPAN.WW.Combat.EnemiesSeeing(standOn, nil, me.Config and me.Config.EnemyTag or "TownDefenseEnemy") > 0
			end
			if humanoid.Health < lowest - 0.5 and not warnedHit then
				warnedHit = true
				warn(string.format("[AutoTownDefense] Took a hit while healing (%d -> %d HP) -- that roof is not cover, moving",
					math.floor(lowest), math.floor(humanoid.Health)))
			end
			if canRepick and (seen or humanoid.Health < lowest - 0.5) then
				lastPick = os.clock()
				local elsewhere, _, elsewhereAny = me.RoofSpot()
				elsewhere = elsewhere or elsewhereAny
				if not elsewhere then
					warn("[AutoTownDefense] Nowhere out of sight up there any more -- back to the fight")
					break
				end
				standOn = elsewhere
			end
			lowest = math.min(lowest, humanoid.Health)

			local away = LocalPlayer:GetAttribute("TownDefenseAwaySeconds")
			if type(away) == "number" and away > 0 and not warnedAway then
				warnedAway = true
				warn("[AutoTownDefense] The game counts this roof as OUTSIDE town (leave countdown " ..
					tostring(away) .. "s) -- you may drop out of this defense, tell Claude")
			end
			task.wait(0.5)
			waited = waited + 0.5
		end
	end)
	if not ok then
		warn("[AutoTownDefense] Healing on the roof errored: " .. tostring(err))
	end

	if LocalPlayer.Character ~= character or humanoid.Health <= 0 then
		me.StopHide()
		me.hideReturn = nil
	else
		me.Surface()
		print(string.format("[AutoTownDefense] Back from the roof at %d HP (%s)", math.floor(humanoid.Health),
			warnedHit and "took hits up there" or "no hits taken"))
	end
	-- A stint that ended below the flee line would otherwise go straight back
	-- up, and the stint cap exists precisely to give the bandits a reachable
	-- target in between.
	me.retreatPausedUntil = os.clock() + me.retreatAfterStintPause
	return true
end

-- One defense, start to finish: takes the floor, joins, fights until the
-- Phase attribute says it is over, collects and turns in, and gives the
-- floor and the Auto Farm hold back on every exit path.
function GOLDPAN.WW.TownDefense.RunDefense()
	local me = GOLDPAN.WW.TownDefense
	-- The floor comes FIRST, because Join() itself teleports the player to
	-- the Sheriff. The old code teleported there on every 15s poll without
	-- holding anything, which is a second thing yanking the character while
	-- the Master Cycle or a pan session thought it owned it.
	-- 40s for the same reason as the outlaw sweep: long enough to outlast a
	-- 30s Gold Pan cycle or an outlaw mid-engage, so the handoff completes
	-- instead of timing out and dropping the request.
	if not GOLDPAN.WW.Acquire(GOLDPAN.WW.PRIORITY.TownDefense, "TownDefense", me.maxSessionSeconds, 40) then
		return
	end
	-- 90 s of patience for an auction: joining costs nothing to delay (the
	-- defense only starts when we join), and a lot bid on after the join
	-- pulls the player out of town (see PauseFarm).
	if not GOLDPAN.WW.PauseFarm("TownDefense", 90, GOLDPAN.WW.PRIORITY.TownDefense) then
		GOLDPAN.WW.Release("TownDefense")
		return
	end

	-- Already in one (joined by hand, or still in it across a reload) means
	-- there is nothing to join -- firing Join again would just spend a round
	-- trip to be told so.
	if not me.InSession() and not me.Join() then
		GOLDPAN.WW.ResumeFarm("TownDefense")
		GOLDPAN.WW.Release("TownDefense")
		return
	end

	print("[AutoTownDefense] In the defense, fighting waves")
	local tool = GOLDPAN.WW.Combat.EnsureWeaponEquipped()
	local deadline = os.clock() + me.maxSessionSeconds
	local yielded = false
	-- Open question (docs/wild-west-event.md): does a bandit turn-in add
	-- nuggets on top of the flat 200 Victory reward, or is TownDefenseReward
	-- the whole story? GoldNuggets is the player's live running total, and
	-- everything else that earns nuggets is locked out by the floor while
	-- TownDefense holds it, so the delta across one defense is a clean
	-- answer -- read here, before anything is turned in.
	local nuggetsBefore = LocalPlayer:GetAttribute("GoldNuggets")

	-- The result phase (Victory, Cancelled, the defeat one) lasts only
	-- ResultSeconds (8s) before Idle, and the loop below can be inside a 40s
	-- hide or a 10s engage when it passes -- printed "Defense over
	-- (Idle)", so nobody could tell how the defense ended. Caught as it
	-- happens instead.
	local resultPhase = nil
	me.clockWarnedWave = nil
	local board = me.Board()
	local resultWatch = board and SESSION.Track(board:GetAttributeChangedSignal("Phase"):Connect(function()
		local now = board:GetAttribute("Phase")
		if now ~= nil and now ~= "Idle" and not me.livePhases[tostring(now)] then
			resultPhase = now
		end
	end))

	-- Same containment as the outlaw sweep: an error in here must not take
	-- the floor and the Auto Farm hold down with the coroutine. A dead Town
	-- Defense thread is the worst of the four to lose, because its hold
	-- deadline is the longest.
	local fightOk, fightErr = pcall(function()
	while me.active and LOOPGUARDS.autoTownDefense and SESSION.alive do
		local phase = me.Phase()
		if not me.livePhases[tostring(phase)] then
			print(string.format("[AutoTownDefense] Rockets fired this defense: %d (launcher picked up empty: %d)",
				GOLDPAN.WW.Combat.rocketsFired or 0, GOLDPAN.WW.Combat.rocketsEmpty or 0))
			GOLDPAN.WW.Combat.rocketsFired = 0
			GOLDPAN.WW.Combat.rocketsEmpty = 0
			print("[AutoTownDefense] Defense over (" .. tostring(resultPhase or phase) .. ")")
			-- "Defeat" alone covers a death and a wave that ran out its clear
			-- timer alike; the board's Message is the only place the game says
			-- which (it survives into Idle). Three defeats went
			-- unexplained for want of this line.
			if tostring(resultPhase or phase) ~= "Victory" and board then
				warn(string.format("[AutoTownDefense] Lost in wave %s -- the game says: \"%s\"",
					tostring(board:GetAttribute("Wave")), tostring(board:GetAttribute("Message"))))
			end
			break
		end
		if not me.InSession() then
			print("[AutoTownDefense] No longer in the session, standing down")
			break
		end
		if LocalPlayer:GetAttribute("TownDefenseEliminated") then
			warn(string.format("[AutoTownDefense] Eliminated in wave %s -- leaving the rest of the waves to the others",
				tostring(board and board:GetAttribute("Wave"))))
			break
		end
		if os.clock() > deadline then
			warn("[AutoTownDefense] Defense ran past " .. me.maxSessionSeconds .. "s, standing down")
			break
		end
		-- A wave not cleared inside WaveTimeoutSeconds (240) is lost outright,
		-- "TOWN OVERRUN" on the HUD, with the player still standing. Said once
		-- per wave with a minute to go, so a stalled wave shows in the console
		-- while it is happening, along with what is still alive and where.
		if phase == "Wave" and board then
			local endsAt = board:GetAttribute("EndsAt")
			local wave = board:GetAttribute("Wave")
			if type(endsAt) == "number" and endsAt - workspace:GetServerTimeNow() < 60 and me.clockWarnedWave ~= wave then
				me.clockWarnedWave = wave
				local standing = {}
				for _, model in ipairs(game:GetService("CollectionService"):GetTagged(me.Config and me.Config.EnemyTag or "TownDefenseEnemy")) do
					local humanoid = model:FindFirstChildOfClass("Humanoid")
					local rootPart = model:FindFirstChild("HumanoidRootPart")
					if humanoid and rootPart and humanoid.Health > 0 then
						table.insert(standing, string.format("%d HP at %d, %d, %d", math.floor(humanoid.Health),
							math.floor(rootPart.Position.X), math.floor(rootPart.Position.Y), math.floor(rootPart.Position.Z)))
					end
				end
				warn(string.format("[AutoTownDefense] Wave %s has under a minute left to clear, %d bandits standing: %s",
					tostring(wave), #standing, table.concat(standing, "; ")))
			end
		end

		-- Only Race outranks this, and only when it is actually queued.
		-- Walking out costs the 30-minute cooldown either way, so this is
		-- the user's own ordering being paid for, not an accident.
		if GOLDPAN.WW.ShouldYield(GOLDPAN.WW.PRIORITY.TownDefense) then
			warn("[AutoTownDefense] A race needs the floor -- leaving the defense")
			-- Straight out of town, NOT a hide: this path used to hide for 6s
			-- and then put the player back exactly where they had been
			-- fighting. On that surfaced them at 27 HP in the
			-- middle of wave 5 and they were eliminated ~2s later, before the
			-- race had moved them anywhere. Leaving the defense is already the
			-- decision here, so leave the danger too.
			GOLDPAN.WW.Combat.Unpin()
			local away
			local raceCfg = GOLDPAN.WW.Race and GOLDPAN.WW.Race.Config
			local lobby = raceCfg and raceCfg.LobbyModelName and workspace:FindFirstChild(raceCfg.LobbyModelName)
			local center = lobby and lobby:FindFirstChild("Center")
			if center then
				away = center.Position
			else
				local arena = workspace:FindFirstChild(me.Config and me.Config.ArenaFolder or "TownDefense")
				local bounds = arena and arena:FindFirstChild("Bounds")
				if bounds then
					away = bounds.Position + Vector3.new(0, 0, bounds.Size.Z)
				end
			end
			if away then
				TeleportPlayerOnly(away)
			else
				warn("[AutoTownDefense] Nowhere known to leave to -- standing down where we are")
			end
			yielded = true
			break
		end

		-- 120s for the same reason as the outlaw sweep: this watchdog is for
		-- a dead thread, not a slow one, and it has to outlast the longest
		-- blocking call below it. `deadline` is what actually caps the
		-- session, and it is checked right above.
		GOLDPAN.WW.Renew("TownDefense", 120)
		-- CanRetreat as well: with no roof time left (or none free), low
		-- health has to mean "keep fighting", and the abort below has to agree.
		if not me.HealthOk() and me.CanRetreat() then
			me.Retreat()
		end

		local enemy = me.FindEnemy()
		if enemy then
			-- `not tool.Parent` too: a rocket opener swaps weapons, which
			-- destroys the Tool this loop was holding on to. A launcher staged in
			-- hand stays there for the next peek's opener.
			local inHand = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
			if GOLDPAN.WW.Combat.IsLauncher(inHand) then
				tool = inHand
			elseif not tool or not tool.Parent then
				tool = GOLDPAN.WW.Combat.EnsureWeaponEquipped()
			end
			if tool then
				-- Stop to heal only when a heal can actually happen. Low health
				-- alone was true before the first shot whenever the roof time
				-- was spent, so every engage returned at once and the player
				-- stood still until eliminated (wave 5).
				local abort = function()
					return not me.HealthOk() and me.CanRetreat()
				end
				-- Peek cycles (see PEEK FIRING): up for less than a bandit's
				-- reaction, down under the town between bursts. Standing and
				-- trading is what wave 5 killed the player through, every
				-- single time. nil means no clear line from anywhere -- a
				-- bandit indoors or under a roof -- and only then is closing
				-- in worth the damage it costs.
				local bounds = workspace:FindFirstChild(me.Config and me.Config.ArenaFolder or "TownDefense")
				bounds = bounds and bounds:FindFirstChild("Bounds")
				-- The defense's own hiding spot is measured to stay inside
				-- the arena box; ground found near a bandit might not be.
				local cover = me.HideSpot()
				-- No heal to be had and below the flee line: only peek where
				-- at most one other bandit can see, and at the critical line
				-- only where none can (EngageFromCover's critical hold). The
				-- 15:1x loss on 2026-09-18 went 58 -> 23 HP in seconds right
				-- after a roof stint, with the roof on its 5 s pause and every
				-- spot allowed.
				local exposureLimit = function()
					if me.CanRetreat() then
						return nil
					end
					if me.Critical() then
						return 0
					end
					if not me.HealthOk() then
						return 1
					end
					return nil
				end
				local done = GOLDPAN.WW.Combat.EngageFromCover(tool, enemy, 20, abort, bounds, cover, exposureLimit)
				-- No line from any peek spot. Measured, wave 5:
				-- the weakest-first pick had no clear shot from 44 of 48 spots,
				-- twice; closing in fired 20 point-blank shots for no damage
				-- while the other five shot the player from 100 to 42 HP, and
				-- the defense was lost. A bandit nothing can hit is set aside
				-- for noLineSkipSeconds and the fight goes to one that can be;
				-- closing in is only for when every bandit left is like that.
				local closeIn = false
				if done == nil then
					me.noLineUntil[enemy] = os.clock() + me.noLineSkipSeconds
					local other, otherBlocked = me.FindEnemy()
					if other and other ~= enemy and not otherBlocked then
						DebugPrint("[AutoTownDefense] No clear line on " .. enemy.Name .. " from anywhere -- fighting another bandit first")
					else
						closeIn = true
					end
				end
				if closeIn then
					local rootPart = enemy:FindFirstChild("HumanoidRootPart")
					local hrp = GetFreshHRP()
					if rootPart and hrp and (rootPart.Position - hrp.Position).Magnitude > 25 then
						local direction = (rootPart.Position - hrp.Position).Unit
						TeleportPlayerOnly(rootPart.Position - direction * 4)
						task.wait(0.2)
					end
					DebugPrint("[AutoTownDefense] No clear line on " .. enemy.Name .. ", closing in")
					if GOLDPAN.WW.Combat.IsLauncher(tool) or not tool.Parent then
						tool = GOLDPAN.WW.Combat.GunBack()
					end
					if tool then
						GOLDPAN.WW.Combat.Engage(tool, enemy, 10, abort)
					end
				end
			end
		else
			-- Preparing (20s) and Intermission (10s) are both legitimately
			-- enemy-free. Waiting them out is correct; it is only "over"
			-- when Phase says so, which is checked at the top. A launcher
			-- fired on the wave's last bandit never got its hide, so its
			-- reload is started here.
			if next(GOLDPAN.WW.Combat.needsReload) ~= nil then
				GOLDPAN.WW.Combat.ReloadLaunchers(false)
			end
			task.wait(1)
		end
	end
	end)
	if not fightOk then
		warn("[AutoTownDefense] Defense errored: " .. tostring(fightErr))
	end
	if resultWatch then
		resultWatch:Disconnect()
	end

	-- Skipped on the yield path: the corpse sweep teleports repeatedly and
	-- can recall the truck, which is precisely what we just retreated to
	-- avoid doing while a race is waiting for the character. The bodies keep
	-- for TownDefenseConfig.BanditLootLifetimeSeconds (600s), so the outlaw
	-- sweep picks them up afterwards.
	if not yielded then
		print("[AutoTownDefense] Collecting and turning in")
		local combat = GOLDPAN.WW.Combat
		combat.ReloadLaunchers(false)
		local pickupStartedAt = os.clock()
		local carMovesBefore = combat.carMoves
		-- The car first, once, to the middle of the bodies (the user's call
		-- 2026-09-17): they lie within one car's reach of each other, so
		-- there is no reason to call it per body the way a map-wide outlaw
		-- sweep must. A body it still cannot reach gets its own recall inside
		-- CollectCorpses, and so does one refused twice with the car beside it.
		local callOk, callErr = pcall(combat.CallCarToCorpses, "[AutoTownDefense]")
		if not callOk then
			warn("[AutoTownDefense] Calling the car errored: " .. tostring(callErr))
		end
		-- One CollectCorpses call is ONE pass, and a pass skips every body the
		-- car cannot reach while the recall is cooling down (6s). A single
		-- pass after a solo defense loaded 6 of 15 bodies; Auto
		-- Hunt Outlaws picked up the other 9 later, and with it off they would
		-- have despawned. So pass again until none is waiting.
		local loaded = 0
		local collectDeadline = os.clock() + me.collectMaxSeconds
		while SESSION.alive and me.active and os.clock() < collectDeadline do
			-- Renewed every pass: this runs OUTSIDE the fight loop that was
			-- renewing, and one pass can spend ~25s in a truck recall.
			GOLDPAN.WW.Renew("TownDefense", 120)
			if GOLDPAN.WW.ShouldYield(GOLDPAN.WW.PRIORITY.TownDefense) then
				print("[AutoTownDefense] A race needs the floor -- leaving the rest of the bodies to Auto Hunt Outlaws")
				break
			end
			local passOk, passLoaded = pcall(GOLDPAN.WW.Combat.CollectCorpses)
			if not passOk then
				warn("[AutoTownDefense] Body pickup errored: " .. tostring(passLoaded))
				break
			end
			loaded = loaded + (passLoaded or 0)
			if not GOLDPAN.WW.Combat.AnyCorpseWaiting() then
				break
			end
			-- Short: the car is already in town, so the next pass has nothing to
			-- wait for but a body's retry pause or the recall cooldown.
			task.wait(0.2)
		end
		-- Counted directly, not with AnyCorpseWaiting: that one skips bodies
		-- given up on, and those are exactly the ones worth reporting.
		local left = 0
		local carryables = workspace:FindFirstChild("_Carryables")
		if carryables then
			for _, item in ipairs(carryables:GetChildren()) do
				if item:GetAttribute("OutlawCorpse") then
					left = left + 1
				end
			end
		end
		print(string.format("[AutoTownDefense] Picked up %d bodies in %.0f s, car called %d times, %d left on the ground",
			loaded, os.clock() - pickupStartedAt, combat.carMoves - carMovesBefore, left))
		if left > 0 then
			warn("[AutoTownDefense] " .. left .. " bodies still on the ground after the pickup -- they despawn in 10 min unless Auto Hunt Outlaws gets them")
		end
		pcall(GOLDPAN.WW.Combat.TurnInToSheriff)

		local nuggetsAfter = LocalPlayer:GetAttribute("GoldNuggets")
		if type(nuggetsBefore) == "number" and type(nuggetsAfter) == "number" then
			print("[AutoTownDefense] Nuggets: " .. nuggetsBefore .. " -> " .. nuggetsAfter ..
				" (+" .. (nuggetsAfter - nuggetsBefore) .. ") from " .. loaded .. " bodies, victory reward attribute was " ..
				tostring(LocalPlayer:GetAttribute("TownDefenseReward")))
		end
	end
	GOLDPAN.WW.ResumeFarm("TownDefense")
	GOLDPAN.WW.Release("TownDefense")
end

function GOLDPAN.WW.TownDefense.Start()
	if LOOPGUARDS.autoTownDefense then
		return
	end
	LOOPGUARDS.autoTownDefense = true
	task.spawn(function()
		while GOLDPAN.WW.TownDefense.active and LOOPGUARDS.autoTownDefense and SESSION.alive do
			local me = GOLDPAN.WW.TownDefense
			local phase = me.Phase()
			local eligibleIn = me.SecondsUntilEligible()

			if phase == nil then
				-- No Events.TownDefense folder: the Wild West event is not
				-- running at all. Nothing to poll for.
				task.wait(30)
			elseif me.InSession() and me.livePhases[tostring(phase)] then
				-- Already in one (joined by hand, or rejoined after a
				-- reload) -- pick it up rather than sitting idle next to it.
				-- livePhases is checked here too, not just InSession() alone:
				-- confirmed that LocalPlayer's TownDefenseId can
				-- still equal the board's EventId for a moment after Phase has
				-- already left Wave/Intermission (server hasn't cleared the
				-- attribute yet) -- without this, RunDefense() returning from a
				-- real Defeat immediately re-entered a SECOND time, re-claimed
				-- the floor from whatever queued behind it (Gold Pan, that
				-- time), printed "fighting waves" again, and ended instantly
				-- with 0 nuggets -- pure dead time before the floor could
				-- actually go back to whoever needed it.
				me.RunDefense()
			elseif eligibleIn > 0 then
				DebugPrint("[AutoTownDefense] On cooldown for another " .. math.floor(eligibleIn) .. "s")
				task.wait(math.min(60, eligibleIn))
			elseif os.clock() < me.retryAfter then
				task.wait(math.min(15, me.retryAfter - os.clock()))
			elseif not me.joinablePhases[tostring(phase)] then
				DebugPrint("[AutoTownDefense] Nothing to join right now (" .. tostring(phase) .. ")")
				task.wait(10)
			elseif not GOLDPAN.WW.Combat.FindWeaponGuid() then
				-- Ownership only, no equip: taking the tool slot on the way
				-- to a join that may be refused is how this used to pull the
				-- pan out of the player's hands every 15 seconds.
				GOLDPAN.WW.ReportBlocked(me, "warnedNoGun",
					"[AutoTownDefense] Auto Defend Town is ON but you own no gun -- it cannot do anything until you have one (Handgun, Revolver, Uzi, SMG, P90, Sniper Rifle, Shotgun or Antique Pistol)")
				task.wait(20)
			elseif GOLDPAN.WW.ShouldYield(GOLDPAN.WW.PRIORITY.TownDefense) then
				GOLDPAN.WW.Announce(GOLDPAN.WW.PRIORITY.TownDefense, "TownDefense", 6)
				task.wait(2)
			elseif GOLDPAN.WW.Race.active and (GOLDPAN.WW.Race.SecondsUntilRaceOrGuess() or math.huge) < me.raceClearanceSeconds then
				-- Race outranks Defend (the user's ordering), and a defense
				-- that yields mid-run is FORFEITED: measured, one
				-- joined at 06:13, "A race needs the floor -- leaving the
				-- defense" 90 s later, and ended "The defenders have left
				-- town." So a run that cannot finish before the race's lead
				-- window never starts; it waits for the race instead. The
				-- 30-min cooldown makes a few minutes' wait cheap.
				GOLDPAN.WW.ReportBlocked(me, "warnedRaceSoon", string.format(
					"[AutoTownDefense] Horse race in %d s -- waiting for it before starting a defense it would cut short",
					math.floor(GOLDPAN.WW.Race.SecondsUntilRaceOrGuess() or 0)))
				task.wait(10)
			else
				GOLDPAN.WW.ClearBlocked(me, "warnedRaceSoon", "[AutoTownDefense] Race window clear, starting the defense")
				GOLDPAN.WW.ClearBlocked(me, "warnedNoGun", "[AutoTownDefense] Gun found, Auto Defend Town is live again")
				me.RunDefense()
			end
			task.wait(1)
		end
		GOLDPAN.WW.ResumeFarm("TownDefense")
		GOLDPAN.WW.Release("TownDefense")
		LOOPGUARDS.autoTownDefense = false
	end)
end

-- THE GAME'S OWN IDLE REJOIN. Measured from Roblox's client log:
-- "[IdleRejoin] Requesting reload after 903 idle seconds" / "Server accepted
-- idle reload request", then a teleport to a different server -- every
-- 15 min 9 s, like clockwork, all night. It is a game LocalScript
-- (PlayerScripts.IdleRejoin) that resets its clock only on real
-- UserInputService.InputEnded and after ~900 s fires
-- Events.Misc.IdleTeleport:FireServer("requestReload"). Everything this
-- script does is scripted, so to it the player is always idle: it moved a
-- live defense to a new server in wave 4 and lost it. VirtualUser clicks do
-- NOT reset it (measured: nudged every 50 s, hopped on schedule anyway).
--
-- The fix is to switch that LocalScript off while something needs the player
-- to stay put, and back on when nothing does. Refcounted by holder name so
-- Anti-AFK and Auto Defend can each hold it without undoing the other.
SESSION.idleRejoinHolds = {}
function SESSION.HoldIdleRejoin(holder, hold)
	if hold then
		SESSION.idleRejoinHolds[holder] = true
	else
		SESSION.idleRejoinHolds[holder] = nil
	end
	local wantEnabled = next(SESSION.idleRejoinHolds) == nil
	SESSION.ApplyIdleRejoin(wantEnabled, holder)
	-- Held: keep holding. Measured after a network rejoin: this
	-- script autoloads BEFORE the game puts IdleRejoin into PlayerScripts, so
	-- the one-shot switch-off above found nothing, the game's script started
	-- normally, and the new server would have hopped us 15 min later. A slow
	-- loop re-asserts it until nothing holds it any more.
	if not wantEnabled and not LOOPGUARDS.idleRejoinHold then
		LOOPGUARDS.idleRejoinHold = true
		task.spawn(function()
			while SESSION.alive and LOOPGUARDS.idleRejoinHold and next(SESSION.idleRejoinHolds) ~= nil do
				SESSION.ApplyIdleRejoin(false, "keep-off")
				task.wait(3)
			end
			LOOPGUARDS.idleRejoinHold = false
		end)
	end
end

-- Sets the game's IdleRejoin LocalScript on or off, printing only on an
-- actual change. Quiet when the script is not there yet -- the hold loop
-- above comes back for it.
function SESSION.ApplyIdleRejoin(enabled, holder)
	local scripts = LocalPlayer:FindFirstChild("PlayerScripts")
	local idle = scripts and scripts:FindFirstChild("IdleRejoin")
	if not idle or not idle:IsA("LocalScript") then
		return
	end
	if idle.Enabled ~= enabled then
		idle.Enabled = enabled
		if enabled then
			print("[AntiIdle] The game's idle rejoin is back on")
		else
			print("[AntiIdle] Paused the game's idle rejoin, so it cannot move you to another server (held by " .. tostring(holder) .. ")")
		end
	end
end

