-- =========================================================
-- HORSE RACING (Wild West event) -- the race is server-authoritative by
-- POSITION: confirmed that HorseRaceTrack's client script
-- only ever fires CancelRace, never HurdleImpact or Update (both are
-- server -> client only), so there is no per-hurdle remote to call --
-- reaching each checkpoint in order is what counts. Checkpoints are read
-- straight from the game's own HorseRaceConfig rather than hardcoded, so
-- a course change can't silently desync this from the real layout.
-- Joining is automatic: per the user, being on your own horse inside the
-- entry circle when the timer hits 0 enters you -- no NPC prompt needed.
-- Movement is teleport-paced off the game's own horse curve, sped up by
-- a user-set percentage (Race Speed Boost %, see RunSession, RideCourse)
-- checked against the game's own SpeedAllowance tolerance, and starts only
-- when the game says GO (see WaitForGo).
-- =========================================================
GOLDPAN.WW.Race = {
	active = false,
	Config = SafeRequire(ReplicatedStorage.Modules.HorseRaceConfig, "HorseRaceConfig"),
	HorseConfig = SafeRequire(ReplicatedStorage.Modules.HorseConfig, "HorseConfig"),
	-- Every owned horse rolls its own "Top Speed" (the AccessoryAttributes
	-- "HorseSpeed" stat, shown in the inventory/shop card) on top of
	-- HorseConfig.RideSpeed's flat 48 -- measured, the
	-- user's own horse showed "71 Top Speed" and HorseConfig has no
	-- per-horse field at all. Pacing the race off the flat 48 leaves real
	-- speed on the table (and NPCs roll 50-80, per HorseRaceConfig), so
	-- ComputeTopSpeed below reads the mounted horse's actual rolled value.
	AccessoryAttributes = SafeRequire(ReplicatedStorage.Modules.AccessoryAttributes, "AccessoryAttributes"),
	mountedTopSpeed = nil,
	horseNames = { ["Horse"] = true, ["Chestnut Horse"] = true, ["White Horse"] = true },
	-- User-configurable, set by the "Race Speed Boost %" input below (Flag
	-- RaceSpeedBoostInput). 35 matches the game's own SpeedAllowance (1.35,
	-- see RunSession) and is the only value confirmed live not
	-- to cancel a race -- this default holds even if the input's own
	-- Callback never fires at build time.
	speedBoostPercent = 35,
	-- Races are every 15 min (RaceInterval); mounting and heading to the
	-- lobby only makes sense for the last stretch before one starts, not
	-- for the whole gap in between -- staying mounted (and Auto Farm
	-- paused) for a full 15-minute cycle just to catch one race was the
	-- bug the user caught.
	mountLeadSeconds = 20,
	-- Asking for the floor is a separate, EARLIER step than mounting. A
	-- town defense mid-wave needs to finish its enemy and retreat before it
	-- can let go, and the old code did its whole handoff inside the 20s
	-- mount window with a fixed 2s guess -- which is how Race ended up
	-- mounting while Town Defense was still shooting, two coroutines on one
	-- character. 75s out costs nothing -- Auto Farm keeps running right up
	-- until the mount, because holding the floor and pausing the farm are
	-- separate steps now -- and it leaves room for a 50s handoff to finish
	-- before the mount window even opens. 50s because the handoff is
	-- cooperative: the wait has to outlast the longest gap between two yield
	-- checks in whatever is below, which is an outlaw sweep's engage plus
	-- pickup run, not the 30s Gold Pan cycle alone.
	handoffLeadSeconds = 75,
	-- MaxRaceSeconds is 300 (measured off HorseRaceConfig); this
	-- covers the lobby wait plus the course and is renewed while a session
	-- runs, so it only ever bites on a hold nobody is driving.
	holdSeconds = 330,
	hasHorse = false,
	lastHorseCheckAt = 0,
	warnedMount = false,
	warnedNoHorse = false,
	-- Last state the game pushed over HorseRace.Update (listener below):
	-- `phase` goes Loading -> Countdown -> Racing, `id` is the session.
	-- Measured: the old code moved as soon as the session
	-- attribute appeared, i.e. during Loading/Countdown, and the race ended
	-- 0.18s after GO with "your horse moved outside the race limits".
	phase = nil,
	phaseSession = nil,
	nextIndex = nil,
	-- The HUD hint that came with it ("Race starts in 3", "Race ended: ...").
	phaseLine = nil,
	-- Height the horse crosses a hurdle at. The game's own jump is 7.2
	-- studs (Humanoid.JumpHeight while mounted, measured); 9 clears the 4.5
	-- bar with room and stays under MaxJumpHeight (12). A ridden 9-stud hop
	-- counted and knocked nothing.
	hopHeight = 9,
	-- Where a gate crossing starts (in front) and lands (behind), along the
	-- gate's own direction. 25 in front leaves room for the hop's run-up at
	-- Top Speed; landing clear of the gate matters because the line from
	-- hurdle 5 to 6 runs almost along gate 5 (measured dot 0.07).
	leadIn = 25,
	gateOvershoot = 6,
	-- How long to stand and wait for a gate to count (measured ~0.5s after
	-- the crossing) before riding back for it.
	confirmSeconds = 1.5,
	-- Session id already ridden, so the 2s poll does not remount for it.
	doneSession = nil,
	-- Remembered the first time the lobby streams in, so the "lobby first"
	-- teleport below still has somewhere to send the player when the model
	-- is not currently loaded (same idea as lastNextRaceAt, applied to
	-- position instead of time).
	lastLobbyCenter = nil,
}

-- Reads the lobby sign's own countdown (same attribute HorseRaceLobby
-- itself displays) rather than guessing a schedule -- nil if the lobby
-- model isn't loaded/streamed in from here, which the caller treats as
-- "unknown, don't assume a race is due".
function GOLDPAN.WW.Race.SecondsUntilRace()
	local cfg = GOLDPAN.WW.Race.Config
	local lobby = cfg and workspace:FindFirstChild(cfg.LobbyModelName)
	-- Cached here, not only inside Start()'s own handoff-window teleport
	-- step: measured, the lobby streamed in early in the 900s
	-- cycle (far outside the 75s handoff window) while the player wandered
	-- past on an unrelated errand, then streamed back out before the
	-- window opened -- the teleport step had nothing to fall back to, the
	-- player mounted wherever Auto Farm had left them, and the race never
	-- granted a session (no ActiveSessionAttribute the whole dueSoon
	-- window). Caching on every sighting, all cycle long, gives the
	-- teleport a real position to use even when this exact call returns
	-- nil below.
	local center = lobby and lobby:FindFirstChild("Center")
	if center and center:IsA("BasePart") then
		GOLDPAN.WW.Race.lastLobbyCenter = center.Position
	end
	local nextAt = lobby and lobby:GetAttribute("NextRaceAt")
	if typeof(nextAt) ~= "number" then
		return nil
	end
	GOLDPAN.WW.Race.lastNextRaceAt = nextAt
	-- Also kept in getgenv(), which outlives a script reload (a fresh load
	-- starts with the player wherever the farm left them, the lobby streamed
	-- out and no countdown known -- and Town Defense then starts a defense a
	-- race is about to cut short: seen, one started 6 minutes
	-- before a race straight after a reload).
	getgenv().SHRaceNextAt = nextAt
	return nextAt - workspace:GetServerTimeNow()
end

-- The same, but never "unknown" once a countdown has been seen: races run on
-- a fixed RaceInterval (900 s, read off HorseRaceConfig), so a remembered
-- NextRaceAt can be rolled forward when the lobby is not streamed in. Used to
-- keep Town Defense from starting a run that a race would cut short.
function GOLDPAN.WW.Race.SecondsUntilRaceOrGuess()
	local live = GOLDPAN.WW.Race.SecondsUntilRace()
	if live then
		return live
	end
	local last = GOLDPAN.WW.Race.lastNextRaceAt or getgenv().SHRaceNextAt
	local cfg = GOLDPAN.WW.Race.Config
	local interval = cfg and tonumber(cfg.RaceInterval) or 900
	if not last or interval <= 0 then
		return nil
	end
	local now = workspace:GetServerTimeNow()
	while last < now do
		last = last + interval
	end
	return last - now
end

-- Returns guid, entry so callers that need the roll (ComputeTopSpeed)
-- don't have to invoke the inventory a second time. Always the FASTEST horse
-- owned: pairs() order is arbitrary, and the first hit used to be whatever
-- came up -- measured the inventory held horses at 65, 68, 72 and
-- 110 Top Speed, and the console showed races ridden at 65, 110 and 72.
-- Ties go to the lower guid so the pick does not flip between calls.
function GOLDPAN.WW.Race.FindHorseGuid()
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not ok or type(inventory) ~= "table" then
		warn("[AutoRace] GetPlayerInventory failed: " .. tostring(inventory))
		return nil
	end
	local bestGuid, bestEntry, bestSpeed
	for guid, entry in pairs(inventory) do
		local def = Items[tostring(entry.ItemId)]
		if def and GOLDPAN.WW.Race.horseNames[def.Name] then
			local speed = GOLDPAN.WW.Race.ComputeTopSpeed(entry)
			if not bestGuid or speed > bestSpeed or (speed == bestSpeed and tostring(guid) < tostring(bestGuid)) then
				bestGuid, bestEntry, bestSpeed = guid, entry, speed
			end
		end
	end
	return bestGuid, bestEntry
end

-- Runs the exact same formula the game's own item cards use
-- (AccessoryAttributes:EffectiveMagnitude, confirmed to
-- reproduce the UI's displayed "71 Top Speed" from this horse's rolled
-- Magnitude=61 HorseSpeed buff) rather than guessing at the grade-scale
-- math by hand. Falls back to the flat HorseConfig.RideSpeed for a horse
-- with no HorseSpeed buff rolled at all.
function GOLDPAN.WW.Race.ComputeTopSpeed(entry)
	local fallback = (GOLDPAN.WW.Race.HorseConfig and GOLDPAN.WW.Race.HorseConfig.RideSpeed) or 48
	local accessoryAttrs = GOLDPAN.WW.Race.AccessoryAttributes
	local buffs = entry and entry.RolledAttributes and entry.RolledAttributes.Buffs
	if not accessoryAttrs or type(buffs) ~= "table" then
		return fallback
	end
	for _, buff in ipairs(buffs) do
		if buff.AttrId == "HorseSpeed" then
			local ok, value = pcall(function()
				return accessoryAttrs:EffectiveMagnitude("HorseSpeed", buff.Magnitude, true, entry.Grade, entry.GradeV)
			end)
			if ok and type(value) == "number" then
				return value
			end
		end
	end
	return fallback
end

-- HorseConfig.RidingAttribute ("HorseRiding") is set on the player by the
-- server once mounted. Confirmed (user tested manually):
-- equipping the Horse item only holds it in hand -- an ordinary
-- left-click (the Tool's Activated event) is the actual mount trigger,
-- and the in-game DISMOUNT button only ever appears once already
-- riding. Tool:Activate() fires that event with no OS input, measured
-- 2026-09-17 to mount. The old mouse1click() is real OS input and needs the
-- Roblox window focused (docs/game-reference.md), which an unattended farm
-- does not have -- the likely reason the mount kept failing at the lobby.
function GOLDPAN.WW.Race.EnsureMounted()
	local ridingAttribute = GOLDPAN.WW.Race.HorseConfig and GOLDPAN.WW.Race.HorseConfig.RidingAttribute or "HorseRiding"
	local character = LocalPlayer.Character
	if not character then
		return false
	end
	-- Measured via script-grep across the game's own scripts
	-- (HorseRaceTrack, HorseRiderBob, HorseSounds): all of them read this
	-- attribute off the CHARACTER, never the Player. Checking LocalPlayer
	-- here was always nil, so EnsureMounted reported failure even after a
	-- successful mount -- the bug behind "it mounts, console says it can't".
	if character:GetAttribute(ridingAttribute) then
		return true
	end

	-- Resolved every attempt (not only when we still need to equip) so
	-- mountedTopSpeed reflects THIS horse even if it was already in hand
	-- when Auto Horse Race turned on.
	local guid, entry = GOLDPAN.WW.Race.FindHorseGuid()
	if guid then
		GOLDPAN.WW.Race.mountedTopSpeed = GOLDPAN.WW.Race.ComputeTopSpeed(entry)
	end

	-- A horse already in hand only counts if it IS the fastest one: a held
	-- tool carries the inventory guid as its "EquippedGuid" attribute
	-- (measured on a held P90). Any other horse, or a tool whose
	-- guid cannot be read, is swapped for the fastest.
	local tool = character:FindFirstChildOfClass("Tool")
	local holdingFastest = tool and GOLDPAN.WW.Race.horseNames[tool.Name] and tool:GetAttribute("EquippedGuid") == guid
	if not holdingFastest then
		if not guid then
			return false
		else
			local equipOk, equipErr = pcall(function()
				REMOTES.EquipItem:FireServer(guid)
			end)
			if not equipOk then
				warn("[AutoRace] EquipItem failed: " .. tostring(equipErr))
				return false
			end
			task.wait(0.7)
			tool = character:FindFirstChildOfClass("Tool")
			if not (tool and GOLDPAN.WW.Race.horseNames[tool.Name]) then
				warn("[AutoRace] Equipped the horse, but it is not in hand (holding " .. tostring(tool and tool.Name) .. ")")
				return false
			end
			local heldGuid = tool:GetAttribute("EquippedGuid")
			if typeof(heldGuid) == "string" and heldGuid ~= guid then
				warn("[AutoRace] Asked for the fastest horse (" .. tostring(GOLDPAN.WW.Race.mountedTopSpeed) .. " Top Speed) but a different one is in hand -- not riding it, its speed is unknown")
				return false
			end
		end
	end

	local activateOk, activateErr = pcall(function() tool:Activate() end)
	if not activateOk then
		warn("[AutoRace] Activating the horse failed: " .. tostring(activateErr))
		return false
	end
	task.wait(1.2)
	return character:GetAttribute(ridingAttribute) == true
end

-- Gets off through the game's own DISMOUNT button handler
-- (PlayerGui.HorseControls, one Activated connection), measured.
-- Unequipping the horse does NOT dismount: the player stayed riding with
-- nothing in hand. During a race the same button reads "Leave race", so
-- only call this once the race is over.
function GOLDPAN.WW.Race.Dismount()
	local me = GOLDPAN.WW.Race
	local ridingAttribute = (me.HorseConfig and me.HorseConfig.RidingAttribute) or "HorseRiding"
	local character = LocalPlayer.Character
	if not (character and character:GetAttribute(ridingAttribute)) then
		return true
	end
	local gui = LocalPlayer.PlayerGui:FindFirstChild("HorseControls")
	local button = gui and gui:FindFirstChild("Dismount", true)
	if not (button and type(getconnections) == "function") then
		warn("[AutoRace] Cannot find the game's DISMOUNT button -- still on the horse")
		return false
	end
	pcall(function()
		for _, connection in ipairs(getconnections(button.Activated)) do
			if connection.Function then
				connection.Function()
			end
		end
	end)
	local waited = 0
	while character:GetAttribute(ridingAttribute) and waited < 2 do
		task.wait(0.1)
		waited = waited + 0.1
	end
	if character:GetAttribute(ridingAttribute) then
		warn("[AutoRace] Pressed DISMOUNT, still on the horse")
		return false
	end
	return true
end

-- The game's own state for the race we are in. Update carries one table
-- (phase, id, countdownEndsAt, startAt, nextIndex, knocked, ...), measured
-- 2026-09-17; HurdleImpact carries (sessionId, hurdleIndex, number) and
-- came through the moment a hurdle was knocked down.
do
	local cfg = GOLDPAN.WW.Race.Config
	local folder = cfg and Events:FindFirstChild(cfg.RemotesFolder)
	local update = folder and folder:FindFirstChild(cfg.UpdateRemote)
	local impact = folder and folder:FindFirstChild(cfg.ImpactRemote)
	if update and update:IsA("RemoteEvent") then
		SESSION.Track(update.OnClientEvent:Connect(function(state)
			if type(state) == "table" and state.phase ~= nil then
				GOLDPAN.WW.Race.phase = state.phase
				GOLDPAN.WW.Race.phaseSession = state.id
				GOLDPAN.WW.Race.nextIndex = state.nextIndex
				GOLDPAN.WW.Race.phaseLine = state.line
			end
		end))
	else
		warn("[AutoRace] HorseRace.Update not found -- Auto Horse Race cannot tell when a race starts")
	end
	if impact and impact:IsA("RemoteEvent") then
		SESSION.Track(impact.OnClientEvent:Connect(function(sessionId, hurdleIndex, value)
			if sessionId ~= LocalPlayer:GetAttribute(cfg.ActiveSessionAttribute) then
				return
			end
			print("[AutoRace] Knocked hurdle " .. tostring(hurdleIndex) .. " (game says " .. tostring(value) .. ")")
		end))
	end
end

-- One frame of the ride: position, facing and velocity together. The
-- velocity is written (not zeroed as SafeSetHRPCFrame does) so the replicated
-- motion and the game's own hurdle check see a moving horse, not one that
-- blinks from spot to spot.
function GOLDPAN.WW.Race.Place(position, direction, velocity)
	local hrp = GetFreshHRP()
	if not hrp then
		return false
	end
	local ok = pcall(function()
		hrp.CFrame = CFrame.lookAt(position, position + direction)
		hrp.AssemblyLinearVelocity = velocity
	end)
	return ok
end

function GOLDPAN.WW.Race.StillRacing()
	local me = GOLDPAN.WW.Race
	return me.active and SESSION.alive and LocalPlayer:GetAttribute(me.Config.ActiveSessionAttribute) ~= nil
end

-- True once the game has counted gate `index`: its `nextIndex` moved past
-- it (measured, nextIndex steps up ~0.5s after each gate), or
-- the race is no longer running (the finish closes it).
function GOLDPAN.WW.Race.WaitCounted(index, seconds)
	local me = GOLDPAN.WW.Race
	local deadline = os.clock() + seconds
	repeat
		if not me.StillRacing() then
			return true
		end
		if type(me.nextIndex) == "number" and me.nextIndex > index then
			return true
		end
		if me.phase ~= nil and me.phase ~= "Racing" then
			return true
		end
		if os.clock() >= deadline then
			return false
		end
		task.wait(0.05)
	until false
end

-- Moves the horse toward `goal` in one small teleport per frame, sized to
-- the game's own horse: measured, it starts at HorseConfig
-- StartSpeed (8), gains Acceleration (20) studs/s every second up to
-- `ride.topSpeed` (the horse's own Top Speed, or that times SpeedAllowance --
-- see RunSession) and does not speed up in the air. Big teleports do not survive:
-- the same day, one 63-stud teleport right after GO ended the race 0.23s
-- later with "your horse moved outside the race limits". Hops over the bar
-- when `hopAt` is given, timed so the peak is over it. `ride` carries
-- position, speed and hop across calls.
function GOLDPAN.WW.Race.RideTo(ride, goal, hopAt)
	local me = GOLDPAN.WW.Race
	while me.StillRacing() do
		local now = os.clock()
		local dt = math.min(now - ride.lastClock, 0.1)
		ride.lastClock = now
		if ride.hopStartedAt and (now - ride.hopStartedAt) >= ride.airTime then
			ride.hopStartedAt = nil
		end
		if not ride.hopStartedAt then
			ride.speed = math.min(ride.topSpeed, ride.speed + ride.accel * dt)
		end

		local toGoal = goal - ride.pos
		local remaining = toGoal.Magnitude
		if remaining > 0.01 then
			ride.direction = toGoal / remaining
		end
		if hopAt and not ride.hopStartedAt and (hopAt - ride.pos):Dot(ride.direction) <= ride.speed * ride.airTime / 2 then
			ride.hopStartedAt = now
		end

		local arrived = ride.speed * dt >= remaining
		if arrived then
			ride.pos = goal
		else
			ride.pos = ride.pos + ride.direction * (ride.speed * dt)
		end
		local lift, climb = 0, 0
		if ride.hopStartedAt then
			local t = now - ride.hopStartedAt
			lift = ride.hopUp * t - 0.5 * ride.gravity * t * t
			climb = ride.hopUp - ride.gravity * t
		end
		me.Place(ride.pos + Vector3.new(0, lift, 0), ride.direction, ride.direction * ride.speed + Vector3.new(0, climb, 0))
		if arrived then
			return true
		end
		task.wait()
	end
	return false
end

-- Keeps riding in the current direction, without steering toward a new
-- goal, until any hop already started is actually done (grounded). Added
-- RideCourse used to turn toward the next gate's lead-in the
-- instant it reached the landing point, which is only `gateOvershoot` (6
-- studs) past the gate -- well inside the hop's own air time (~0.6s for
-- hopHeight 9), so the turn started mid-air. Harmless when the next gate
-- is roughly ahead, but hurdle 5's own comment already notes the 5->6
-- line runs nearly square to hurdle 5's crossing direction (dot 0.07) --
-- turning that sharply before landing was missing hurdle 5 consistently
-- (the user). A no-op when there is no hop in progress.
function GOLDPAN.WW.Race.SettleHop(ride)
	local me = GOLDPAN.WW.Race
	while me.StillRacing() and ride.hopStartedAt do
		local now = os.clock()
		local dt = math.min(now - ride.lastClock, 0.1)
		ride.lastClock = now
		if (now - ride.hopStartedAt) >= ride.airTime then
			ride.hopStartedAt = nil
			break
		end
		ride.pos = ride.pos + ride.direction * (ride.speed * dt)
		local t = now - ride.hopStartedAt
		local lift = ride.hopUp * t - 0.5 * ride.gravity * t * t
		local climb = ride.hopUp - ride.gravity * t
		me.Place(ride.pos + Vector3.new(0, lift, 0), ride.direction, ride.direction * ride.speed + Vector3.new(0, climb, 0))
		task.wait()
	end
	return me.StillRacing()
end

-- Straight lines between gates (per the user), but each gate is crossed
-- square-on from `leadIn` studs in front: measured, riding the
-- straight line into hurdle 2 (~70 degrees off square) gave "Jump it from
-- the arrow side." and "MISSED HURDLE 2", and the same hurdle taken
-- square-on counted.
function GOLDPAN.WW.Race.GatePoints(ride, checkpoint)
	local me = GOLDPAN.WW.Race
	local centre = Vector3.new(checkpoint.Position.X, ride.baseY, checkpoint.Position.Z)
	return centre - checkpoint.Direction * me.leadIn, centre, centre + checkpoint.Direction * me.gateOvershoot
end

function GOLDPAN.WW.Race.RideCourse(topSpeed)
	local me = GOLDPAN.WW.Race
	local hc = me.HorseConfig
	local hrp = GetFreshHRP()
	if not hrp then
		warn("[AutoRace] No character at the start line")
		return false
	end
	local gravity = workspace.Gravity
	local hopUp = math.sqrt(2 * gravity * me.hopHeight)
	local startSpeed = (hc and hc.StartSpeed) or 8
	local ride = {
		-- Every Route point sits at the same height (measured), so the
		-- resting ride height at the start slot holds for the whole lap.
		baseY = hrp.Position.Y,
		pos = hrp.Position,
		direction = hrp.CFrame.LookVector,
		speed = startSpeed,
		topSpeed = topSpeed,
		accel = (hc and hc.Acceleration) or 20,
		gravity = gravity,
		hopUp = hopUp,
		airTime = 2 * hopUp / gravity,
		hopStartedAt = nil,
		lastClock = os.clock(),
	}

	local gates = me.Config.Checkpoints
	local index, misses = 1, 0
	while index <= #gates do
		local gate = gates[index]
		local leadIn, centre, landing = me.GatePoints(ride, gate)
		if not me.RideTo(ride, leadIn, nil)
			or not me.RideTo(ride, centre, gate.Kind == "Hurdle" and centre or nil)
			or not me.RideTo(ride, landing, nil)
			or not me.SettleHop(ride) then
			return false
		end

		-- The game counts a gate ~0.5s after it is crossed, so keep riding
		-- to the next gate's lead-in and check there; only stand and wait
		-- when it still has not counted.
		local nextGate = gates[index + 1]
		if nextGate and not me.WaitCounted(index, 0) then
			local nextLeadIn = me.GatePoints(ride, nextGate)
			if not me.RideTo(ride, nextLeadIn, nil) then
				return false
			end
		end
		local waitStarted = os.clock()
		local counted = me.WaitCounted(index, me.confirmSeconds)
		if os.clock() - waitStarted > 0.1 then
			-- Stood still: start again from a standstill, as the horse would.
			ride.speed = startSpeed
		end
		ride.lastClock = os.clock()

		if counted then
			index = index + 1
			misses = 0
		else
			misses = misses + 1
			if misses >= 3 then
				warn("[AutoRace] Gate " .. index .. " (" .. tostring(gate.Label) .. ") never counted after 3 tries -- stopping this race")
				return false
			end
			print("[AutoRace] Gate " .. index .. " did not count, riding back for it (try " .. (misses + 1) .. ")")
		end
	end
	return true
end

-- Waits for the game to say GO. The countdown is 3s after Loading, and a
-- horse that moves before GO gets the race cancelled (measured). Returns
-- false, loudly, rather than guessing a start time.
function GOLDPAN.WW.Race.WaitForGo()
	local me = GOLDPAN.WW.Race
	local cfg = me.Config
	local deadline = os.clock() + (cfg.LoadingTimeout or 12) + (cfg.CountdownSeconds or 3) + 10
	while me.StillRacing() and os.clock() < deadline do
		local session = LocalPlayer:GetAttribute(cfg.ActiveSessionAttribute)
		if me.phase == "Racing" and me.phaseSession == session then
			return true
		end
		task.wait()
	end
	if me.StillRacing() then
		warn("[AutoRace] In a race, but the game never said GO (last phase: " .. tostring(me.phase) .. ") -- not moving")
	elseif me.active and SESSION.alive then
		-- The session closed on its own before GO. The game says why on its
		-- HUD; for "The start area didn't load in time" that is its own
		-- streaming request going unanswered (see TPCACHE.StreamAround), which
		-- no script can cure -- only a rejoin does.
		local line = tostring(me.phaseLine)
		local hint = ""
		if string.find(line, "start area", 1, true) then
			hint = ". The game's own streaming request went unanswered, so every race is cancelled like this until you rejoin"
		end
		warn("[AutoRace] The game ended the race before GO (last phase: " .. tostring(me.phase) .. ", it said: \"" .. line .. "\")" .. hint)
	end
	return false
end

function GOLDPAN.WW.Race.RunSession()
	local me = GOLDPAN.WW.Race
	local cfg = me.Config
	if not cfg or not cfg.Checkpoints then
		warn("[AutoRace] HorseRaceConfig.Checkpoints missing, cannot run the course")
		return
	end

	local topSpeed = me.mountedTopSpeed
	if not topSpeed then
		local _, entry = me.FindHorseGuid()
		topSpeed = me.ComputeTopSpeed(entry)
		me.mountedTopSpeed = topSpeed
	end

	-- Boost is user-set (Race Speed Boost % on the Wild West tab, Flag
	-- RaceSpeedBoostInput, default 35). HorseRaceConfig.SpeedAllowance (read
	-- live, not hardcoded) is the game's OWN anti-exploit tolerance for how
	-- far a sample can outrun the expected pace -- 35% is the only value
	-- confirmed live (full lap, no cancel) not to break it.
	-- Going higher is the user's own call, warned about once per race
	-- rather than clamped, since we have no live data past 35% either way.
	local percent = me.speedBoostPercent or 35
	local capPercent = cfg.SpeedAllowance and (cfg.SpeedAllowance - 1) * 100
	if capPercent and percent > capPercent + 0.01 then
		warn(string.format("[AutoRace] Race Speed Boost is %.0f%%, above the game's own measured %.0f%% tolerance -- untested past there, risks the race getting cancelled", percent, capPercent))
	end
	local allowance = 1 + percent / 100
	local ridePace = topSpeed * allowance
	print("[AutoRace] Race session detected, waiting for GO (" .. cfg.CourseName .. ", top speed " .. tostring(topSpeed) .. ", riding at " .. string.format("%.1f", ridePace) .. " = +" .. tostring(percent) .. "%)")
	if not me.WaitForGo() then
		return
	end

	print("[AutoRace] GO -- riding the course")
	local startedAt = os.clock()
	local rode = me.RideCourse(ridePace)
	-- The game closes the session as the horse crosses the line, and a fast
	-- horse can still be inside RideCourse's last leg when it does, so
	-- "returned false" is not the same as "did not finish": the game's own
	-- phase says which (measured, "You finished 1st!" with nothing
	-- printed). A race that ended any other way says why, in the game's words.
	if not rode and me.phase ~= "Finished" then
		warn("[AutoRace] The race ended before the finish line (last phase: " .. tostring(me.phase) .. ", the game said: \"" .. tostring(me.phaseLine) .. "\")")
		return
	end
	print(string.format("[AutoRace] Crossed the finish line in %.1fs%s", os.clock() - startedAt, type(me.phaseLine) == "string" and (" -- " .. me.phaseLine) or ""))

	-- The DISMOUNT button leaves the race while it is running, so wait for
	-- the game to close the session first.
	local waited = 0
	while LocalPlayer:GetAttribute(cfg.ActiveSessionAttribute) and waited < 15 and me.active and SESSION.alive do
		task.wait(0.5)
		waited = waited + 0.5
	end
	if not LocalPlayer:GetAttribute(cfg.ActiveSessionAttribute) then
		me.Dismount()
	end
end

function GOLDPAN.WW.Race.Start()
	if LOOPGUARDS.autoRace then
		return
	end
	LOOPGUARDS.autoRace = true
	task.spawn(function()
		while GOLDPAN.WW.Race.active and LOOPGUARDS.autoRace and SESSION.alive do
			local me = GOLDPAN.WW.Race
			local cfg = me.Config
			local inSession = cfg and LocalPlayer:GetAttribute(cfg.ActiveSessionAttribute)
			-- OrGuess, not the plain live read: the lobby model streaming out
			-- (player far from it, e.g. mid-Town-Defense on the far side of
			-- the map) used to make this whole loop go blind and silently
			-- skip the race -- 75+ minutes with zero [AutoRace] console
			-- output, toggle on the whole time. Once a countdown has been
			-- seen live, the remembered NextRaceAt plus the fixed interval
			-- keeps working even while unseen; genuinely never having seen
			-- one yet still reads as "not due", same as before.
			local secondsUntil = me.SecondsUntilRaceOrGuess()
			local dueSoon = inSession or (secondsUntil ~= nil and secondsUntil <= me.mountLeadSeconds)
			local handoffSoon = inSession or (secondsUntil ~= nil and secondsUntil <= me.handoffLeadSeconds)

			-- Whether we own a horse is checked BEFORE taking the floor, and
			-- cached so the 2s poll does not spend an inventory round trip
			-- every tick. A race we cannot enter is not worth interrupting
			-- anything for: the old code claimed first and then, on the
			-- no-horse path, resumed Auto Farm while STILL holding the lock
			-- -- starving outlaw sweeps and panning for the whole lead window
			-- of every 15-minute cycle in exchange for nothing at all.
			if handoffSoon and not inSession and (os.clock() - me.lastHorseCheckAt) > 15 then
				me.lastHorseCheckAt = os.clock()
				me.hasHorse = me.FindHorseGuid() ~= nil
				if me.hasHorse then
					GOLDPAN.WW.ClearBlocked(me, "warnedNoHorse", "[AutoRace] Horse found, Auto Horse Race is live again")
				else
					GOLDPAN.WW.ReportBlocked(me, "warnedNoHorse",
						"[AutoRace] Auto Horse Race is ON but you own no horse -- it cannot enter a race until you have one (Horse, Chestnut Horse or White Horse, all Livestock garage drops)")
				end
			end

			local canRace = cfg ~= nil and handoffSoon and (inSession or me.hasHorse)
			if canRace then
				FARM.noNewAuctionUntil = os.clock() + 5
			end
			if not canRace then
				if GOLDPAN.WW.Hold.owners.Race and not inSession then
					me.Dismount()
				end
				GOLDPAN.WW.ResumeFarm("Race")
				GOLDPAN.WW.Release("Race")
				me.warnedMount = false
			elseif not GOLDPAN.WW.Acquire(GOLDPAN.WW.PRIORITY.Race, "Race", me.holdSeconds, 50) then
				-- Nothing outranks Race, so this only happens if the previous
				-- holder never stood down -- worth saying out loud rather
				-- than silently racing it for the character.
				warn("[AutoRace] Could not get the floor in time, skipping this race")
			elseif dueSoon then
				GOLDPAN.WW.Renew("Race", me.holdSeconds)
				-- Auto Farm goes down BEFORE the horse goes up. Mounting while
				-- the Master Cycle still owns the HRP means the farm teleports
				-- the player out from under the mount -- the Master Cycle is
				-- the sole owner of the HRP while FARM.active (CLAUDE.md), and
				-- holding the Wild West floor says nothing to it. 10s of
				-- auction budget, not the usual 60: the mount window is only
				-- 20s wide and a missed race costs 15 minutes.
				local session = LocalPlayer:GetAttribute(cfg.ActiveSessionAttribute)
				if session ~= nil and session == me.doneSession then
					-- Already ridden (or given up on); the game is still
					-- closing it. Mounting again here would put the horse
					-- back in hand after the finish.
				elseif not GOLDPAN.WW.PauseFarm("Race", 10, GOLDPAN.WW.PRIORITY.Race) then
					DebugPrint("[AutoRace] Mid-auction, cannot take the player for the race yet")
				else
					-- Lobby first, THEN mount: measured, mounting
					-- where the farm left the player (beside the truck) was
					-- refused with "Move into open space to mount your
					-- horse." Never once the session exists: the game has
					-- already put the player on the start line by then.
					if session == nil then
						-- lastLobbyCenter is kept fresh by SecondsUntilRace()
						-- on every sighting, all cycle long -- not only here.
						-- Falls back to that remembered spot when the lobby
						-- is not currently streamed in -- otherwise this
						-- whole step silently no-ops from across the map and
						-- EnsureMounted is tried wherever the farm happened
						-- to leave the player, which is the exact "not open
						-- space" refusal above.
						local targetPos = me.lastLobbyCenter
						if targetPos then
							local hrp = GetFreshHRP()
							if hrp and (hrp.Position - targetPos).Magnitude > (cfg.LobbyRadius or 14) then
								TeleportPlayerOnly(targetPos)
								task.wait(0.5)
							end
						end
					end

					if me.EnsureMounted() then
						session = LocalPlayer:GetAttribute(cfg.ActiveSessionAttribute)
						if session ~= nil then
							me.doneSession = session
							-- Contained for the same reason as the sweep and the
							-- defense: the release and resume at the bottom of
							-- this loop must run even if the course throws.
							local raceOk, raceErr = pcall(GOLDPAN.WW.Race.RunSession)
							if not raceOk then
								warn("[AutoRace] Race errored: " .. tostring(raceErr))
							end
						end
					elseif not me.warnedMount then
						-- Once per race window, not once per 2s poll. Auto
						-- Farm stays paused until the window closes (the
						-- not-canRace branch above resumes it): resuming here
						-- restarted the Master Cycle every poll, dragging the
						-- player away from the lobby each time (measured: the
						-- farm flapped on and off through the whole window).
						me.warnedMount = true
						warn("[AutoRace] Could not mount for the race")
					end
				end
			end

			-- Idle checks (race not due yet) can be infrequent, but the lead
			-- window eats into the poll gap directly -- 8s keeps worst-case
			-- notice comfortably inside the 75s handoff window, and 2s once
			-- inside it. The 2s wait ends early when a race session appears:
			-- the countdown to GO is only 3s.
			if handoffSoon then
				local hadSession = LocalPlayer:GetAttribute(cfg.ActiveSessionAttribute) ~= nil
				local waitUntil = os.clock() + 2
				while os.clock() < waitUntil and GOLDPAN.WW.Race.active and SESSION.alive do
					if not hadSession and LocalPlayer:GetAttribute(cfg.ActiveSessionAttribute) ~= nil then
						break
					end
					task.wait(0.1)
				end
			else
				task.wait(8)
			end
		end
		GOLDPAN.WW.ResumeFarm("Race")
		GOLDPAN.WW.Release("Race")
		LOOPGUARDS.autoRace = false
	end)
end

