	CurrentOption = {},
	MultipleOptions = true,
	Flag = "AutoFarmGarageTypesDropdown",
	Callback = function(selected)
		-- A saved config can carry types the game has since removed (the
		-- Alien Garages, seen 2026-09-08). RayVoid draws no row for those,
		-- so they could never be unticked and sat in the "Checked:" line
		-- for good. Keep only what the game still has, and push the clean
		-- list back into the dropdown so the next slot save drops them.
		local kept, stale = {}, {}
		table.clear(FARM.selectedTypes)
		for _, garageName in ipairs(selected) do
