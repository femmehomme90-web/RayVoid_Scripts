-- =========================================================
-- MOVEMENT (Misc tab): Fly, Speed, Noclip, Super Jump.
-- All client-side on your own character, all OFF by default, and each one
-- puts back exactly what it changed when switched off. They stand aside
-- while you are seated (the truck drives itself) so they cannot fight the
-- farm's vehicle handling. The game DOES ship a Misc.HeartbeatAudit remote,
-- which looks like a server-side movement check -- these are your call.
-- One table = one root-level local (Lua 5.1 cap of 200).
local MOVE = {
	fly = false, flySpeed = 60,
	speed = false, walkSpeed = 32,
	noclip = false,
	jump = false, jumpPower = 100,
	-- What we overwrote, so switching off restores the game's own values
	-- rather than guessing defaults.
	savedWalk = nil, savedJump = nil, savedUseJumpPower = nil,
	noclipSaved = {}, -- part -> original CanCollide
	bv = nil, bg = nil,
	-- Superman flight: eased velocity, eased body angle, eased pose (0..1).
	vel = Vector3.zero, gyroCF = nil, pose = 0, lastTrackStop = 0,
	poseSaved = {}, -- Motor6D -> original C0, restored when flight ends
}

-- The flying pose (R15), keyed by the LIMB the joint moves: offset at full
-- pose (p = 1). +X swings a limb forward. Right arm straight out past the
-- head, left arm back along the body, left knee bent, legs together.
-- Keyed by limb rather than joint name because the game's R15 rig may use
-- the new AnimationConstraint joints instead of Motor6Ds -- that is why the
-- first version (Motor6D names only) left a still, unposed character.
-- Four poses, blended by weight each frame (degrees: x = swing forward,
-- z = out to the side; right arm out = +z, left arm out = -z):
--   super  flying forward: right fist out past the head, left arm back
--   hover  still / strafing / going down: arms loose and a bit out, legs dangling
--   back   flying backwards: arms forward, legs forward, leaning back
--   rise   going straight up: both arms up
MOVE.POSES = {
	super = {
		RightUpperArm = { 170, 0, -8 }, LeftUpperArm = { -20, 0, -10 }, RightLowerArm = { -5, 0, 0 },
		LeftUpperLeg = { 10, 0, 0 }, LeftLowerLeg = { -50, 0, 0 }, RightUpperLeg = { -6, 0, 0 },
		["Right Arm"] = { 0, 0, 170 }, ["Left Arm"] = { 0, 0, 20 }, ["Left Leg"] = { 0, 0, -25 },
	},
	hover = {
		RightUpperArm = { 10, 0, 22 }, LeftUpperArm = { 10, 0, -22 },
		RightLowerArm = { 25, 0, 0 }, LeftLowerArm = { 25, 0, 0 },
		RightUpperLeg = { 10, 0, 0 }, LeftUpperLeg = { -5, 0, 0 },
		RightLowerLeg = { -30, 0, 0 }, LeftLowerLeg = { -15, 0, 0 },
	},
	back = {
		RightUpperArm = { 50, 0, 30 }, LeftUpperArm = { 50, 0, -30 },
		RightLowerArm = { 30, 0, 0 }, LeftLowerArm = { 30, 0, 0 },
		RightUpperLeg = { 35, 0, 0 }, LeftUpperLeg = { 20, 0, 0 },
		RightLowerLeg = { -40, 0, 0 }, LeftLowerLeg = { -25, 0, 0 },
	},
	rise = {
		RightUpperArm = { 175, 0, 5 }, LeftUpperArm = { 175, 0, -5 },
		RightLowerLeg = { -10, 0, 0 }, LeftLowerLeg = { -25, 0, 0 },
		["Right Arm"] = { 0, 0, 170 }, ["Left Arm"] = { 0, 0, -170 },
	},
}
MOVE.weights = { super = 0, hover = 0, back = 0, rise = 0 }

-- Every limb any pose moves (PoseJoints looks for these).
MOVE.POSE = {}
for _, pose in pairs(MOVE.POSES) do
	for limb in pairs(pose) do
		MOVE.POSE[limb] = true
	end
end

-- Blended offset for one limb, plus a slow idle sway on arms and legs.
function MOVE.LimbOffset(limb)
	local x, y, z = 0, 0, 0
	for name, w in pairs(MOVE.weights) do
		local a = w > 0.001 and MOVE.POSES[name][limb]
		if a then
			x, y, z = x + a[1] * w, y + a[2] * w, z + a[3] * w
		end
	end
	local t = os.clock()
	local idle = MOVE.weights.hover + MOVE.weights.back * 0.5
	if limb == "RightUpperLeg" then
		x = x + math.sin(t * 2.2) * 8 * idle
	elseif limb == "LeftUpperLeg" then
		x = x - math.sin(t * 2.2) * 8 * idle
	elseif limb == "RightUpperArm" or limb == "LeftUpperArm" then
		x = x + math.sin(t * 1.6 + 1) * 5 * idle
	end
	return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z))
end

-- Every joint that moves a posed limb: { joint, kind, limbName }.
-- Motor6D -> C0; AnimationConstraint -> its Attachment0's CFrame (the same
-- spot on the parent side, so the result is identical).
function MOVE.PoseJoints(char)
	local out = {}
	for _, j in ipairs(char:GetDescendants()) do
		if j:IsA("Motor6D") and j.Part1 and MOVE.POSE[j.Part1.Name] then
			table.insert(out, { j, "motor", j.Part1.Name })
		elseif j:IsA("AnimationConstraint") and j.Attachment0 and j.Attachment1
			and j.Attachment1.Parent and MOVE.POSE[j.Attachment1.Parent.Name] then
			table.insert(out, { j.Attachment0, "attach", j.Attachment1.Parent.Name })
		end
	end
	return out
end

function MOVE.ApplyPose(char)
	if not MOVE.poseJoints or MOVE.poseChar ~= char then
		MOVE.RestorePose()
		MOVE.poseJoints, MOVE.poseChar = MOVE.PoseJoints(char), char
	end
	for _, rec in ipairs(MOVE.poseJoints) do
		local obj, kind, limb = rec[1], rec[2], rec[3]
		if obj.Parent then
			local prop = kind == "motor" and "C0" or "CFrame"
			if MOVE.poseSaved[obj] == nil then
				MOVE.poseSaved[obj] = { prop, obj[prop] }
			end
			obj[prop] = MOVE.poseSaved[obj][2] * MOVE.LimbOffset(limb)
		end
	end
end

function MOVE.RestorePose()
	for obj, saved in pairs(MOVE.poseSaved) do
		if obj.Parent then
			pcall(function()
				obj[saved[1]] = saved[2]
			end)
		end
	end
	table.clear(MOVE.poseSaved)
	MOVE.poseJoints, MOVE.poseChar = nil, nil
	MOVE.pose = 0
	for k in pairs(MOVE.weights) do
		MOVE.weights[k] = 0
	end
end

function MOVE.Humanoid()
	local char = LocalPlayer.Character
	return char and char:FindFirstChildOfClass("Humanoid"), char
end

function MOVE.StopFly()
	if MOVE.bv then MOVE.bv:Destroy() MOVE.bv = nil end
	if MOVE.bg then MOVE.bg:Destroy() MOVE.bg = nil end
	MOVE.vel, MOVE.gyroCF = Vector3.zero, nil
	pcall(MOVE.RestorePose)
	local hum, char = MOVE.Humanoid()
	if hum then
		hum.PlatformStand = false
		hum.AutoRotate = true
		-- Land upright, not lying on your face.
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			local look = root.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude < 0.1 then
				flat = Vector3.new(0, 0, -1)
			end
			root.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
		end
	end
end

function MOVE.RestoreSpeed()
	local hum = MOVE.Humanoid()
	if hum and MOVE.savedWalk then
		hum.WalkSpeed = MOVE.savedWalk
	end
	MOVE.savedWalk = nil
end

function MOVE.RestoreJump()
	local hum = MOVE.Humanoid()
	if hum and MOVE.savedJump then
		hum.UseJumpPower = MOVE.savedUseJumpPower
		hum.JumpPower = MOVE.savedJump
	end
	MOVE.savedJump = nil
end

function MOVE.RestoreNoclip()
	for part, was in pairs(MOVE.noclipSaved) do
		if part.Parent then
			part.CanCollide = was
		end
	end
	table.clear(MOVE.noclipSaved)
end

function MOVE.StopAll()
	MOVE.fly, MOVE.speed, MOVE.noclip, MOVE.jump = false, false, false, false
	pcall(MOVE.StopFly)
	pcall(MOVE.RestoreSpeed)
	pcall(MOVE.RestoreJump)
	pcall(MOVE.RestoreNoclip)
	pcall(MOVE.Wire)
end

-- The three per-frame listeners exist ONLY while fly, speed, jump or noclip
-- is on (2026-10-13, phones). They used to stay connected from load to
-- unload, three calls a frame all night with everything switched off.
MOVE.conns = {}
function MOVE.Wire()
	local want = MOVE.fly or MOVE.speed or MOVE.noclip or MOVE.jump
	if not want then
		for _, conn in ipairs(MOVE.conns) do
			pcall(function()
				conn:Disconnect()
			end)
		end
		MOVE.conns = {}
		return
	end
	if #MOVE.conns > 0 then
		return
	end
	local RunService = game:GetService("RunService")
	local UIS = game:GetService("UserInputService")

	-- Noclip must run on Stepped (before physics) or collisions win the frame.
	table.insert(MOVE.conns, SESSION.Track(RunService.Stepped:Connect(function()
		if not MOVE.noclip then
			return
		end
		local hum, char = MOVE.Humanoid()
		if not char or (hum and hum.SeatPart) then
			return
		end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				if MOVE.noclipSaved[part] == nil then
					MOVE.noclipSaved[part] = true
				end
				part.CanCollide = false
			end
		end
	end)))

	table.insert(MOVE.conns, SESSION.Track(RunService.Heartbeat:Connect(function()
		if not (MOVE.speed or MOVE.jump) then
			return
		end
		local hum = MOVE.Humanoid()
		if not hum then
			return
		end
		-- Re-applied every frame: the game (and a respawn) resets these.
		if MOVE.speed then
			if MOVE.savedWalk == nil then
				MOVE.savedWalk = hum.WalkSpeed
			end
			if hum.WalkSpeed ~= MOVE.walkSpeed then
				hum.WalkSpeed = MOVE.walkSpeed
			end
		end
		if MOVE.jump then
			if MOVE.savedJump == nil then
				MOVE.savedJump = hum.JumpPower
				MOVE.savedUseJumpPower = hum.UseJumpPower
			end
			hum.UseJumpPower = true
			if hum.JumpPower ~= MOVE.jumpPower then
				hum.JumpPower = MOVE.jumpPower
			end
		end
	end)))

	-- Fly: WASD along the camera, Space up, Left Ctrl down. Mobile falls back
	-- to the thumbstick (Humanoid.MoveDirection).
	table.insert(MOVE.conns, SESSION.Track(RunService.RenderStepped:Connect(function(dt)
		if not MOVE.fly then
			return
		end
		local hum, char = MOVE.Humanoid()
		local root = char and char:FindFirstChild("HumanoidRootPart")
		-- Paused while an automation moves you (farm, fishing, quest / train /
		-- lost-item trips): flight would hold you in place against their
		-- teleports. It comes back by itself when they are done.
		if not (hum and root) or hum.SeatPart or FARM.active or AUTOFISH.active or SESSION.mover then
			if MOVE.bv then
				MOVE.StopFly()
			end
			return
		end
		if not (MOVE.bv and MOVE.bv.Parent == root) then
			MOVE.StopFly()
			MOVE.bv = Instance.new("BodyVelocity")
			MOVE.bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
			MOVE.bv.P = 2e4
			MOVE.bv.Velocity = Vector3.zero
			MOVE.bv.Parent = root
		end
		hum.PlatformStand = true
		hum.AutoRotate = false
		local cam = workspace.CurrentCamera
		local dir = Vector3.zero
		if UIS:GetFocusedTextBox() == nil then
			if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
		end
		if dir.Magnitude < 0.01 and hum.MoveDirection.Magnitude > 0 then
			dir = hum.MoveDirection
		end
		-- Eased speed: ~0.3s to full, glides to a stop instead of snapping.
		local moving = dir.Magnitude > 0.01
		local target = moving and (dir.Unit * MOVE.flySpeed) or Vector3.zero
		MOVE.vel = MOVE.vel:Lerp(target, 1 - math.exp(-dt * 5))
		local speedFrac = math.clamp(MOVE.vel.Magnitude / math.max(MOVE.flySpeed, 1), 0, 1)
		-- Hovering: a slow bob so you do not freeze in mid-air like a statue.
		local bob = Vector3.new(0, math.sin(os.clock() * 2) * 1.2 * (1 - speedFrac), 0)
		MOVE.bv.Velocity = MOVE.vel + bob

		-- Body angle. Flying: head along the flight path, chest to the ground,
		-- banking into turns. Hovering: upright, facing where the camera looks.
		local pos = root.Position
		local look = cam.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.01 then
			flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		end
		flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
		-- Which way are we going, seen from the camera?
		--   forward -> superman: body along the flight path, banking into turns
		--   backward -> keep facing the camera's way, lean back, fly backwards
		--   sideways / down / still -> face the camera's way, roll into strafes
		--   straight up -> upright, both arms up
		local rightFlat = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
		rightFlat = rightFlat.Magnitude > 0.01 and rightFlat.Unit or Vector3.new(1, 0, 0)
		local goal
		local mode = "hover"
		local v = MOVE.vel.Magnitude > 1 and MOVE.vel.Unit or nil
		local fwd, side = 0, 0
		if v then
			fwd, side = v:Dot(flat), v:Dot(rightFlat)
			if fwd > 0.35 then
				mode = "super"
			elseif v.Y > 0.8 then
				mode = "rise"
			elseif fwd < -0.35 then
				mode = "back"
			end
		end
		if mode == "super" then
			local bank = -math.rad(30) * side * speedFrac
			goal = CFrame.lookAt(pos, pos + v) * CFrame.Angles(-math.rad(90) * speedFrac, bank, 0)
		elseif mode == "back" then
			goal = CFrame.lookAt(pos, pos + flat)
				* CFrame.Angles(math.rad(28) * speedFrac, 0, -math.rad(18) * side * speedFrac)
		else
			goal = CFrame.lookAt(pos, pos + flat)
				* CFrame.Angles(-math.rad(6) * speedFrac, 0, -math.rad(28) * side * speedFrac)
		end
		-- Turn the body ourselves, every frame: a BodyGyro was not strong
		-- enough to win against the R15 humanoid here (the "still guy").
		-- Only the rotation is eased; the position is wherever physics put us.
		local rotGoal = goal - goal.Position
		MOVE.gyroCF = MOVE.gyroCF and MOVE.gyroCF:Lerp(rotGoal, 1 - math.exp(-dt * 6)) or rotGoal
		root.CFrame = CFrame.new(pos) * MOVE.gyroCF
		root.AssemblyAngularVelocity = Vector3.zero

		-- Pose: blend toward the one that matches the motion (~0.25s).
		local poseMode = (mode ~= "hover" and speedFrac > 0.25) and mode or "hover"
		local k = 1 - math.exp(-dt * 6)
		for name, w in pairs(MOVE.weights) do
			MOVE.weights[name] = w + ((name == poseMode and 1 or 0) - w) * k
		end
		pcall(MOVE.ApplyPose, char)
		-- The walk / idle animations fight the pose; hush them while flying.
		if os.clock() - MOVE.lastTrackStop > 0.3 then
			MOVE.lastTrackStop = os.clock()
			local animator = hum:FindFirstChildOfClass("Animator")
			if animator then
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
					track:Stop(0.3)
				end
			end
		end
	end)))
end

-- Text box -> number in [lo, hi], or nil.
function MOVE.Parse(text, lo, hi)
	local n = tonumber((string.gsub(tostring(text), "%s", "")))
	if n and n >= lo and n <= hi then
		return n
	end
	return nil
end

