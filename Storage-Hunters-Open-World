-- ---------------------------------------------------------
-- The eight save slots. Hidden, because they hold machine-written JSON and
-- there is nothing useful a person can do by typing into them -- but they are
-- real RayVoid Inputs with real Flags, which is the whole point.
-- ---------------------------------------------------------
RULES.dataInputs = {}
RULES.hiddenInstances = {}

-- RULES.page was resolved above, before the exclusion lists were collapsed.
function RULES.PageChildSet()
	local set = {}
	if RULES.page then
		for _, child in ipairs(RULES.page:GetChildren()) do
			set[child] = true
		end
	end
	return set
end

for ruleIndex = 1, RULES.COUNT do
	local beforeBuild = RULES.PageChildSet()
	RULES.dataInputs[ruleIndex] = ItemRulesTab:CreateInput({
		Name = "Rule " .. ruleIndex .. " (saved data)",
		CurrentValue = "",
		PlaceholderText = "managed by the rule editor",
		Flag = "Rule" .. ruleIndex .. "Data",
		RemoveTextAfterFocusLost = false,
		Callback = function(Text)
			if RULES.saving then
				-- Our own write, echoing back. The live rule is already right.
				return
			end
			RULES.Deserialize(ruleIndex, Text)
			RULES.RefreshSummary()
			-- A config slot load arrives through here, so the window redraws
			-- if it happens to be open.
			if RULES.ED and RULES.ED.gui then
				RULES.ED.Render()
			end
		end,
	})
	if RULES.page then
		for _, child in ipairs(RULES.page:GetChildren()) do
			if not beforeBuild[child] then
				table.insert(RULES.hiddenInstances, child)
			end
		end
	end
end

for _, instance in ipairs(RULES.hiddenInstances) do
	pcall(function()
		instance.Visible = false
	end)
end

-- Writing a rule back so the config slot picks it up. The flag entry IS the
-- settings table RayVoid snapshots (verified against the library source
-- 2026-09-12: RayfieldLibrary.Flags[InputSettings.Flag] = InputSettings), so
-- setting CurrentValue there is what makes a rule survive a slot save. The
-- control's own :Set is tried first where it exists, and neither path is
-- allowed to throw.
function RULES.Save(i)
	local text = RULES.Serialize(i)
	local control = RULES.dataInputs[i]
	-- Writing the box fires its own Callback, which calls Deserialize and
	-- REPLACES the live rule with a fresh one built from the text. That is
	-- right when the text came from a config slot and catastrophic when it
	-- came from us: an edit still in progress would be thrown away between
	-- keystrokes. The callback is only allowed to rebuild when the change
	-- came from outside.
	RULES.saving = true
	if control and control.Set then
		pcall(function()
			control:Set(text)
		end)
	end
	pcall(function()
		local flag = Ui.Flags and Ui.Flags["Rule" .. i .. "Data"]
		if flag then
			flag.CurrentValue = text
		end
	end)
	RULES.saving = false
	RULES.RefreshSummary()
end

