-- A number box that commits on focus lost. Blank means "no limit", which is
-- why it commits nil rather than 0 -- 0 is a real threshold and must not be
-- what an empty box means.
function RULES.ED.NumberBox(parent, value, size, position, placeholder, onCommit)
	local box = Instance.new("TextBox")
	box.Size = size
	box.Position = position or UDim2.fromOffset(0, 0)
	box.BackgroundColor3 = RULES.ED.BAR
	box.BorderSizePixel = 0
	box.Font = Enum.Font.Gotham
	box.TextSize = 13
	box.TextColor3 = RULES.ED.TEXT
	box.PlaceholderText = placeholder or ""
	box.PlaceholderColor3 = RULES.ED.DIM
	box.ClearTextOnFocus = false
	box.Text = value ~= nil and tostring(value) or ""
	box.Parent = parent
	RULES.ED.Corner(box, 5)
	box.FocusLost:Connect(function()
		local text = box.Text
		if text == nil or text:gsub("%s", "") == "" then
			onCommit(nil)
			box.Text = ""
			return
		end
		local parsed = ParseValueInput(text)
		if parsed == nil then
			warn("[Rules] \"" .. tostring(text) .. "\" is not a number, so that box has been cleared.")
			onCommit(nil)
			box.Text = ""
			return
		end
		onCommit(parsed)
		box.Text = tostring(parsed)
	end)
	return box
end

