-- Writing the whole list back so the config slot picks it up. The flag
-- entry IS the settings table RayVoid snapshots (verified against the
-- library source: RayfieldLibrary.Flags[InputSettings.Flag] =
-- InputSettings), so setting CurrentValue there is what makes the list
-- survive a slot save. The control's own :Set is tried first where it
-- exists, and neither path is allowed to throw.
function RULES.SaveAll()
	-- A rule's names/categories/rarities/traits may have just changed, so
	-- the bid fingerprint map is stale -- mark it and kick the pass now
	-- rather than waiting on the next live CheckGarage.
	RULES.bidFp.dirty = true
	RULES.MaybeRebuildBidFp()

	local text = RULES.SerializeAll()
	local control = RULES.allDataInput
	-- Writing the box fires its own Callback, which calls DeserializeAll and
	-- REPLACES the live list with one built from the text. That is right
	-- when the text came from a config slot and catastrophic when it came
	-- from us: an edit still in progress would be thrown away between
	-- keystrokes. The callback is only allowed to rebuild when the change
	-- came from outside.
	RULES.saving = true
	if control and control.Set then
		pcall(function()
			control:Set(text)
		end)
	end
	pcall(function()
		local flag = Ui.Flags and Ui.Flags["ItemRulesData"]
		if flag then
			flag.CurrentValue = text
		end
	end)
	RULES.saving = false
	RULES.RefreshSummary()
end

-- Every per-field edit in the editor window (label, effects, names,
-- setups...) calls RULES.Save(RULES.ED.current) after changing that one
-- rule. The whole list is one blob now, so saving any single rule means
-- re-serializing all of them -- kept under the old name so none of those
-- (many) call sites needed to change.
function RULES.Save(i)
	RULES.SaveAll()
end

-- Add / remove a rule slot. The editor window calls these directly; nothing
-- else needs to touch RULES.rules' length.
function RULES.AddRule()
	table.insert(RULES.rules, RULES.NewRule())
	RULES.COUNT = #RULES.rules
	RULES.SaveAll()
	return RULES.COUNT
end

function RULES.RemoveRuleAt(i)
	if i < 1 or i > #RULES.rules then
		return
	end
	table.remove(RULES.rules, i)
	RULES.EnsureAtLeastOneRule()
	RULES.SaveAll()
end

-- =========================================================
-- THE RULE EDITOR WINDOW (NOT RayVoid): Instance.new by hand, same pattern
-- as the event predictor above. RayVoid gives one control per setting, and a
-- rule is a variable-length list of setups -- there is no number of controls
-- that shape fits into.
-- =========================================================
RULES.ED = {
	gui = nil,
	current = 1,
	-- "rules" or "filters": which half of the window is showing.
	mode = "rules",
	lane = "sell",
	BG = Color3.fromRGB(28, 28, 34),
	BAR = Color3.fromRGB(20, 20, 25),
	CARD = Color3.fromRGB(38, 38, 46),
	CARD2 = Color3.fromRGB(46, 46, 56),
	ACCENT = Color3.fromRGB(70, 120, 200),
	GOOD = Color3.fromRGB(60, 130, 80),
	BAD = Color3.fromRGB(90, 40, 40),
	TEXT = Color3.fromRGB(235, 235, 235),
	DIM = Color3.fromRGB(170, 170, 180),
	WARN = Color3.fromRGB(240, 190, 90),
}

function RULES.ED.Corner(instance, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 6)
	corner.Parent = instance
	return instance
end

function RULES.ED.Label(parent, text, size, position, opts)
	opts = opts or {}
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position or UDim2.fromOffset(0, 0)
	label.Font = opts.bold and Enum.Font.GothamBold or Enum.Font.Gotham
	label.TextSize = opts.textSize or 13
	label.TextColor3 = opts.color or RULES.ED.TEXT
	label.TextXAlignment = opts.align or Enum.TextXAlignment.Left
	label.TextWrapped = opts.wrapped or false
	label.Text = text
	label.LayoutOrder = opts.order or 0
	label.Parent = parent
	return label
end

function RULES.ED.Button(parent, text, size, position, opts)
	opts = opts or {}
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position or UDim2.fromOffset(0, 0)
	button.BackgroundColor3 = opts.bg or RULES.ED.CARD2
	button.BorderSizePixel = 0
	button.AutoButtonColor = true
	button.Font = opts.bold and Enum.Font.GothamBold or Enum.Font.Gotham
	button.TextSize = opts.textSize or 13
	button.TextColor3 = opts.color or RULES.ED.TEXT
	button.TextXAlignment = opts.align or Enum.TextXAlignment.Center
	button.TextTruncate = Enum.TextTruncate.AtEnd
	button.Text = text
	button.LayoutOrder = opts.order or 0
	button.Parent = parent
	RULES.ED.Corner(button, opts.radius or 6)
	if opts.padLeft then
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, opts.padLeft)
		padding.PaddingRight = UDim.new(0, 6)
		padding.Parent = button
	end
	if opts.onClick then
		button.MouseButton1Click:Connect(opts.onClick)
	end
	return button
end

-- A number box that commits on focus lost. Blank means "no limit", which is
-- why it commits nil rather than 0 -- 0 is a real threshold and must not be
-- what an empty box means.
function RULES.ED.NumberBox(parent, value, size, position, placeholder, onCommit)
	local box = Instance.new("TextBox")
	box.Size = size
	box.Position = position or UDim2.fromOffset(0, 0)
	box.BackgroundColor3 = RULES.ED.BAR
	box.BorderSizePixel = 0
	box.Font = Enum.Font.Gotham
	box.TextSize = 13
	box.TextColor3 = RULES.ED.TEXT
	box.PlaceholderText = placeholder or ""
	box.PlaceholderColor3 = RULES.ED.DIM
	box.ClearTextOnFocus = false
	box.Text = value ~= nil and tostring(value) or ""
	box.Parent = parent
	RULES.ED.Corner(box, 5)
	box.FocusLost:Connect(function()
		local text = box.Text
		if text == nil or text:gsub("%s", "") == "" then
			onCommit(nil)
			box.Text = ""
			return
		end
		local parsed = ParseValueInput(text)
		if parsed == nil then
			warn("[Rules] \"" .. tostring(text) .. "\" is not a number, so that box has been cleared.")
			onCommit(nil)
			box.Text = ""
			return
		end
		onCommit(parsed)
		box.Text = tostring(parsed)
	end)
	return box
end

-- ---------------------------------------------------------
-- The picker overlay: one list, a search box, ticks. Used for item names
-- (hundreds of them), categories, rarities, traits, effects and the mutation
-- on a requirement line.
-- ---------------------------------------------------------
function RULES.ED.OpenPicker(title, options, isTicked, onToggle, singleChoice)
	if RULES.ED.picker then
		RULES.ED.picker:Destroy()
		RULES.ED.picker = nil
	end
	local shade = Instance.new("TextButton")
	shade.Size = UDim2.fromScale(1, 1)
	shade.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	shade.BackgroundTransparency = 0.45
	shade.BorderSizePixel = 0
	shade.Text = ""
	shade.AutoButtonColor = false
	shade.ZIndex = 10
	shade.Parent = RULES.ED.main
	RULES.ED.picker = shade

	local panel = Instance.new("Frame")
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(340, 400)
	panel.BackgroundColor3 = RULES.ED.BG
	panel.BorderSizePixel = 0
	panel.ZIndex = 11
	panel.Parent = shade
	RULES.ED.Corner(panel, 8)

	RULES.ED.Label(panel, title, UDim2.new(1, -60, 0, 32), UDim2.fromOffset(12, 4), { bold = true }).ZIndex = 12
	local close = RULES.ED.Button(panel, "Done", UDim2.fromOffset(52, 24), UDim2.new(1, -60, 0, 8), {
		bg = RULES.ED.ACCENT,
		onClick = function()
			shade:Destroy()
			RULES.ED.picker = nil
			RULES.ED.Render()
		end,
	})
	close.ZIndex = 12

	local search = Instance.new("TextBox")
	search.Size = UDim2.new(1, -24, 0, 28)
	search.Position = UDim2.fromOffset(12, 38)
	search.BackgroundColor3 = RULES.ED.BAR
	search.BorderSizePixel = 0
	search.Font = Enum.Font.Gotham
	search.TextSize = 13
	search.TextColor3 = RULES.ED.TEXT
	search.PlaceholderText = "search..."
	search.PlaceholderColor3 = RULES.ED.DIM
	search.ClearTextOnFocus = false
	search.Text = ""
	search.ZIndex = 12
	search.Parent = panel
	RULES.ED.Corner(search, 5)

	local list = Instance.new("ScrollingFrame")
	list.Position = UDim2.fromOffset(12, 74)
	list.Size = UDim2.new(1, -24, 1, -86)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 5
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ZIndex = 12
	list.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	local function paint()
		-- Every child, not just the buttons: this function also creates
		-- TextLabels ("...and 889 more", "Nothing matches ..."), and clearing
		-- only the buttons left those stacking up one per keystroke.
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local needle = string.lower(search.Text or "")
		local shown = 0
		for _, option in ipairs(options) do
			if needle == "" or string.find(string.lower(option), needle, 1, true) then
				shown = shown + 1
				-- Capped so a search that matches everything does not build
				-- eight hundred buttons and freeze the client.
				if shown <= 150 then
					local ticked = isTicked(option)
					local row = RULES.ED.Button(list, (ticked and "[x]  " or "[  ]  ") .. option,
						UDim2.new(1, -6, 0, 26), nil, {
							bg = ticked and RULES.ED.GOOD or RULES.ED.CARD,
							align = Enum.TextXAlignment.Left,
							padLeft = 8,
							order = shown,
						})
					row.ZIndex = 12
					row.MouseButton1Click:Connect(function()
						onToggle(option)
						if singleChoice then
							shade:Destroy()
							RULES.ED.picker = nil
							RULES.ED.Render()
						else
							paint()
						end
					end)
				end
			end
		end
		if shown > 150 then
			RULES.ED.Label(list, "...and " .. (shown - 150) .. " more. Type to narrow it down.",
				UDim2.new(1, -6, 0, 24), nil, { color = RULES.ED.DIM, order = 9999 }).ZIndex = 12
		end
		if shown == 0 then
			RULES.ED.Label(list, "Nothing matches \"" .. search.Text .. "\".",
				UDim2.new(1, -6, 0, 24), nil, { color = RULES.ED.DIM }).ZIndex = 12
		end
	end

	search:GetPropertyChangedSignal("Text"):Connect(paint)
	paint()
end

-- ---------------------------------------------------------
-- Building the right-hand pane. Rebuilt wholesale on every change: a settings
-- panel is small, and a full redraw cannot leave a stale row behind claiming
-- something the rule no longer says.
-- ---------------------------------------------------------
function RULES.ED.Row(parent, height, order)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, height)
	row.BackgroundTransparency = 1
	row.LayoutOrder = order
	row.Parent = parent
	return row
end

function RULES.ED.PickerRow(parent, order, caption, set, options)
	local row = RULES.ED.Row(parent, 28, order)
	RULES.ED.Label(row, caption, UDim2.fromOffset(96, 28), UDim2.fromOffset(0, 0), { color = RULES.ED.DIM })
	local chosen = RULES.AnySet(set) and RULES.NamesOf(set, 4) or "anything"
	RULES.ED.Button(row, chosen, UDim2.new(1, -170, 0, 24), UDim2.fromOffset(100, 2), {
		align = Enum.TextXAlignment.Left,
		padLeft = 8,
		color = RULES.AnySet(set) and RULES.ED.TEXT or RULES.ED.DIM,
		onClick = function()
			RULES.ED.OpenPicker(caption, options,
				function(option) return set[option] == true end,
				function(option)
					if set[option] then
						set[option] = nil
					else
						set[option] = true
					end
					RULES.Save(RULES.ED.current)
				end)
		end,
	})
	RULES.ED.Button(row, "clear", UDim2.fromOffset(56, 24), UDim2.new(1, -62, 0, 2), {
		bg = RULES.ED.CARD,
		color = RULES.ED.DIM,
		onClick = function()
			table.clear(set)
			RULES.Save(RULES.ED.current)
			RULES.ED.Render()
		end,
	})
	return row
end

-- The full list of what a row has ticked. The row's button shows a few names
-- before collapsing to "5 selected" (and truncates long ones before that), so
-- there was nowhere at all to see WHICH items a rule is about -- the user's
-- complaint,. Same look as the Lists view.
function RULES.ED.TickedList(parent, order, set)
	local list = RULES.SetToList(set)
	if #list == 0 or (#list == 1 and #list[1] <= 30) then
		return nil
	end
	local label = RULES.ED.Label(parent, table.concat(list, ", "), UDim2.new(1, -12, 0, 0), nil,
		{ color = RULES.ED.DIM, textSize = 11, wrapped = true, order = order })
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextYAlignment = Enum.TextYAlignment.Top
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 100)
	pad.Parent = label
	return label
end

-- name -> { { def = , id = }, ... } over Modules.Items, built on first use.
-- A list because one name can have more than one definition.
function RULES.ED.ItemDefs(name)
	if not RULES.ED.defsByName then
		local map = {}
		for id, def in pairs(Items) do
			if type(def) == "table" and type(def.Name) == "string" then
				map[def.Name] = map[def.Name] or {}
				table.insert(map[def.Name], { def = def, id = id })
			end
		end
		RULES.ED.defsByName = map
	end
	return RULES.ED.defsByName[name]
end

