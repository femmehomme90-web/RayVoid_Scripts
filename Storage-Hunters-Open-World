-- =========================================================
-- AUTO MUSEUM (Misc tab) -- automatic reward collection
-- Originates from reading the real game via the `real` MCP
-- (2026-08-26): Players.<x>.PlayerScripts.ServiceNPCCompletionHighlight
-- (same "service ready" detection mechanic as Wash/Grade/Locksmith, just
-- a different FolderName) + ReplicatedStorage.Modules.Screens.Museum for
-- the claim remote.
--
-- ONLY collects ready rewards -- does NOT automatically donate new
-- items to the museum (Zachary only asked for collection; donating an
-- item costs money and removes it from the inventory, a decision this
-- controller does not make on behalf of the
-- player).
--
-- Confirmed in game:
--   Events.Museum.GetSlotState:InvokeServer() -> {slots = {[i] = {...}}}
--   A slot is ready when slot.ItemGUID ~= nil AND slot.Pending ~= nil
--   (same predicate as ServiceNPCCompletionHighlight.IsFinished for
--   Museum). Events.Museum.Collect:InvokeServer(slotIndex) claims the
--   reward -- PASSIVE, never moves the player (same category of remote
--   as Wash/Grade/Locksmith).
-- The real game script handles a "Too fast" return on Collect
-- (server-side rate limit) -- we treat it as a benign failure, retried
-- on the next pass rather than insisting immediately.
-- Everything grouped in ONE table = a single root-level local for the
-- whole feature (Lua 5.1 caps root-level locals at 200, cf. CLAUDE.md).
local AUTOMUSEUM = {
	active = false,
	GetSlotState = nil,
	Collect = nil,
	-- Per-slot back-off after a collect the server refused, keyed by the
	-- slot key as it comes back from GetSlotState.
	backoffUntil = {},
	limitWarned = {},
}

-- The game exposes NO remaining count and NO next-collect time: probe L6
-- read the whole GetSlotState payload and it is not in there, so the 6-per-24h
-- limit cannot be asked for. What it does expose is RewardsCollected, a
-- lifetime per-slot counter -- so a refused collect is detected by that
-- counter NOT moving, which is a real measurement and survives a rejoin the
-- way a local tally does not.
--
-- 30 minutes: long enough that a run of refusals costs two calls an hour
-- instead of 240, short enough to pick the hourly reward back up soon after
-- the limit clears. The daily reset time is unknown and does not need to be.
AUTOMUSEUM.BACKOFF = 1800

do
	local ok, getSlotState, collect = pcall(function()
		local MuseumEvents = Events:WaitForChild("Museum", 10)
		return MuseumEvents:WaitForChild("GetSlotState", 10), MuseumEvents:WaitForChild("Collect", 10)
	end)
	if ok then
		AUTOMUSEUM.GetSlotState, AUTOMUSEUM.Collect = getSlotState, collect
	else
		warn("[AutoMuseum] Events.Museum not found -- Auto Museum disabled")
	end
end

-- The raw slots table, or nil. The refusal check needs more than a list of
-- ready indexes: it compares RewardsCollected before and after a collect.
function AUTOMUSEUM.ReadSlots()
	if not AUTOMUSEUM.GetSlotState then
		return nil
	end
	local ok, state = pcall(function()
		return AUTOMUSEUM.GetSlotState:InvokeServer()
	end)
	if not ok or type(state) ~= "table" or type(state.slots) ~= "table" then
		return nil
	end
	return state.slots
end

function AUTOMUSEUM.RewardsCollected(slots, indexKey)
	local slot = slots and slots[indexKey]
	if type(slot) ~= "table" then
		return nil
	end
	return tonumber(slot.RewardsCollected)
end

function AUTOMUSEUM.RunPass()
	if not AUTOMUSEUM.Collect then
		return
	end

	local slots = AUTOMUSEUM.ReadSlots()
	if not slots then
		return
	end

	for indexKey, slot in pairs(slots) do
		-- Pending absent means there is no reward waiting at all, so the
		-- remote is not called. Same convention as the other slot machines
		-- in this file (Wash/Grade/Vault): the keys are STRINGS ("1", "2")
		-- but the remotes want the index as a NUMBER.
		if type(slot) == "table" and slot.ItemGUID ~= nil and slot.Pending ~= nil then
			local slotIndex = tonumber(indexKey) or indexKey

			if os.clock() < (AUTOMUSEUM.backoffUntil[indexKey] or 0) then
				DebugPrint(string.format("[AutoMuseum] Slot %s backing off, %.0fs left",
					tostring(slotIndex), AUTOMUSEUM.backoffUntil[indexKey] - os.clock()))
			else
				local before = AUTOMUSEUM.RewardsCollected(slots, indexKey)

				local ok, err = pcall(function()
					return AUTOMUSEUM.Collect:InvokeServer(slotIndex)
				end)

				if not ok then
					warn("[AutoMuseum] Collect failed for slot " .. tostring(slotIndex) .. ": " .. tostring(err))
				else
					-- The return value is not trustworthy on its own: it was
					-- already coming back falsy on a refusal AND on some
					-- successes. The counter is the measurement.
					task.wait(1)
					local after = AUTOMUSEUM.RewardsCollected(AUTOMUSEUM.ReadSlots(), indexKey)

					if before == nil or after == nil then
						DebugPrint("[AutoMuseum] Slot " .. tostring(slotIndex) ..
							": no RewardsCollected to compare, cannot tell whether it landed")
					elseif after > before then
						AUTOMUSEUM.limitWarned[indexKey] = nil
						DebugPrint("[AutoMuseum] Collected slot " .. tostring(slotIndex) ..
							" (" .. before .. " -> " .. after .. ")")
					else
						AUTOMUSEUM.backoffUntil[indexKey] = os.clock() + AUTOMUSEUM.BACKOFF
						-- Latched: this is a real stop, and the loop comes
						-- back every 15s. One line per limit, not per pass.
						if not AUTOMUSEUM.limitWarned[indexKey] then
							AUTOMUSEUM.limitWarned[indexKey] = true
							warn(string.format(
								"[AutoMuseum] Slot %s refused the collect (RewardsCollected stayed at %d), " ..
								"so the daily limit looks reached. Waiting %d minutes before trying again.",
								tostring(slotIndex), before, AUTOMUSEUM.BACKOFF / 60))
						end
					end
				end

				task.wait(1)
			end
		end
	end
end

function AUTOMUSEUM.StartLoop()
	if LOOPGUARDS.autoMuseum then
		return
	end
	LOOPGUARDS.autoMuseum = true
	task.spawn(function()
		while AUTOMUSEUM.active and LOOPGUARDS.autoMuseum do
			local passOk, passErr = pcall(AUTOMUSEUM.RunPass)
			if not passOk then
				warn("[AutoMuseum] Pass failed, continuing: " .. tostring(passErr))
			end
			task.wait(15)
		end
		LOOPGUARDS.autoMuseum = false
	end)
end

