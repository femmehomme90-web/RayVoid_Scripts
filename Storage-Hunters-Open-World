-- VEHICLE SPAWN
-- Official remote (the truck's VehicleGUID): server-handled, so no more
-- manual SetPrimaryPartCFrame + ZeroVelocity, which caused physics
-- discontinuities. Applies ONLY if the player is not seated in it.
-- No confirmation event -> we poll the seated state.
local VEHICLESPAWN = {
	Remote = REMOTES.VehiclesEvents:WaitForChild("RequestSpawn"),
	Result = REMOTES.VehiclesEvents:WaitForChild("SpawnResult"),
	Timeout = 5,
	-- The server's own spawn cooldown, and it belongs HERE, next to the
	-- remote, rather than in one caller. Measured: a request 4.5s
	-- after the last one is refused ("Please wait before spawning again."),
	-- 5.0s is accepted, and a refused try does not restart the server's clock.
	-- Only the Wild West corpse code knew about it, so Auto Farm's own truck
	-- catch-up fired straight into it: measured, an outlaw sweep
	-- recalled the car, the farm asked for a catch-up in the same second, all
	-- three attempts were refused inside the cooldown and it gave up -- which
	-- left the truck 184 studs behind with a won lot on the ground.
	cooldownSeconds = 6,
	cooldownUntil = 0,
}

-- REAL confirmation of the spawn request, found by reading the real
-- game script (ReplicatedStorage.Modules.Screens.VehicleGarage, via the
-- `real` MCP, 2026-08-25): the server replies on Vehicles.SpawnResult
-- with a success boolean. We did not listen to it at all before -- we
-- just guessed by waiting for the player to be seated, up to Timeout
-- seconds, never knowing whether the server had even accepted the
-- request. Probable cause of the "vehicle TP slightly buggy" bug: if
-- the 1st request takes more than Timeout seconds to seat the player
-- but was accepted anyway, the old code already considered it failed
-- and sent a 2nd -- two overlapping spawns, hence the glitch.
-- pendingSpawnResult: nil = awaiting a reply, true/false = last known
-- result. Only one request at a time on our side (RequestAndWait is
-- sequential), so no need to correlate by id as for placement.
local pendingSpawnResult = nil

SESSION.Track(VEHICLESPAWN.Result.OnClientEvent:Connect(function(success)
	pendingSpawnResult = (success == true)
end))

-- Waits for the server's explicit reply to the LAST request sent.
-- Returns true (accepted), false (explicitly refused) or nil (no reply
-- received within the delay -- suspicious, treated as a failure by the
-- caller).
function VEHICLESPAWN.WaitForSpawnConfirmation(timeout)
	local deadline = os.clock() + (timeout or 5)
	while pendingSpawnResult == nil and os.clock() < deadline do
		task.wait(0.1)
	end
	return pendingSpawnResult
end

function VEHICLESPAWN.Request()
	local truck = GetPlayerTruck()
	if not truck then
		warn("[VehicleSpawn] Player truck not found, cannot request spawn")
		return false
	end

	local guid = truck:GetAttribute("VehicleGUID")
	if not guid then
		warn("[VehicleSpawn] Truck has no VehicleGUID attribute")
		return false
	end

	local ok, err = pcall(function()
		VEHICLESPAWN.Remote:FireServer(guid)
	end)
	if not ok then
		warn("[VehicleSpawn] RequestSpawn failed: " .. tostring(err))
		return false
	end

	DebugPrint("[VehicleSpawn] RequestSpawn fired for GUID " .. tostring(guid))
	return true
end

-- The game automatically seats the player in the vehicle once it
-- arrives: a far more reliable signal than distance (no false positive
-- if another vehicle happens to be nearby). So we poll the "seated"
-- state, and as soon as it is detected we get out immediately (same
-- wait logic as UnloadCargo/TeleportPlayerOnly to confirm the exit).
function VEHICLESPAWN.WaitAndExit(timeout)
	local deadline = os.clock() + (timeout or VEHICLESPAWN.Timeout)

	while os.clock() < deadline do
		local character = LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if humanoid and humanoid.SeatPart then
			DebugPrint("[VehicleSpawn] Player seated, exiting")
			humanoid.Sit = false

			local waited = 0
			while (humanoid.SeatPart ~= nil or humanoid:GetState() == Enum.HumanoidStateType.Seated) and waited < 2 do
				task.wait(0.1)
				waited = waited + 0.1
			end

			return true
		end

		task.wait(0.1)
	end

	warn("[VehicleSpawn] Timeout waiting for the player to be seated")
	return false
end

-- Request() + WaitAndExit() in a single attempt has no safety net: if
-- the server drops the request (lag, vehicle already in transit
-- elsewhere...) or if the truck takes more than Timeout seconds to
-- arrive, WaitAndExit gives up and nothing retries -- the truck stays
-- far away and the player cannot sit in it. We retry several times,
-- with a slightly longer timeout on each attempt.
function VEHICLESPAWN.RequestAndWait(maxAttempts)
	maxAttempts = maxAttempts or 3
	for attempt = 1, maxAttempts do
		pendingSpawnResult = nil

		-- Wait the cooldown out instead of spending an attempt inside it.
		-- Capped at cooldownSeconds so a clock armed far into the future (a
		-- future caller, a clock jump) cannot park this call indefinitely.
		local waitFor = math.min(VEHICLESPAWN.cooldownUntil - os.clock(), VEHICLESPAWN.cooldownSeconds)
		if waitFor > 0 then
			DebugPrint(string.format("[VehicleSpawn] Attempt %d/%d waiting %.1fs for the server's spawn cooldown",
				attempt, maxAttempts, waitFor))
			local coolDeadline = os.clock() + waitFor
			while os.clock() < coolDeadline and SESSION.alive do
				task.wait(0.2)
			end
		end

		if VEHICLESPAWN.Request() then
			-- Armed on the request itself, accepted or not: the server starts
			-- its clock when it hears us. A refused try does not restart that
			-- clock, so arming here can over-wait by a few seconds at worst --
			-- and never under-waits, which is the failure that cost the lot.
			VEHICLESPAWN.cooldownUntil = os.clock() + VEHICLESPAWN.cooldownSeconds

			-- Step 1: did the server even ACCEPT the request?
			-- Before, we jumped straight to WaitAndExit (seat polling) without
			-- knowing -- an explicitly refused request still made us wait the
			-- whole Timeout for nothing, AND an ACCEPTED request that was slow
			-- to seat the player could be judged "failed" too early, leading to
			-- a 2nd request overlapping the 1st (visual glitch).
			local confirmed = VEHICLESPAWN.WaitForSpawnConfirmation(5)

			if confirmed == false then
				DebugPrint("[VehicleSpawn] Attempt " .. attempt .. "/" .. maxAttempts .. " explicitly rejected by server, retrying")
			elseif confirmed == nil then
				DebugPrint("[VehicleSpawn] Attempt " .. attempt .. "/" .. maxAttempts .. " no SpawnResult confirmation received, retrying")
			else
				-- Accepted: what follows (seating the player) is still outside
				-- our direct control (the game does it automatically once the
				-- vehicle arrives), so we still poll the seated state here --
				-- but at least we KNOW the request was taken into account.
				local timeout = VEHICLESPAWN.Timeout + (attempt - 1) * 3
				if VEHICLESPAWN.WaitAndExit(timeout) then
					return true
				end
				DebugPrint("[VehicleSpawn] Attempt " .. attempt .. "/" .. maxAttempts .. " accepted but never got seated, retrying")
			end
		else
			DebugPrint("[VehicleSpawn] Attempt " .. attempt .. "/" .. maxAttempts .. " request failed, retrying")
		end
		if attempt < maxAttempts then
			task.wait(1)
		end
	end
	warn("[VehicleSpawn] Gave up after " .. maxAttempts .. " attempt(s), truck may be left behind")
	return false
end

-- Manual button, a safety net for when the automatic catch-up (in
-- CatchUpVehicle, only during Auto Farm) was not enough or the player
-- is not farming. Disabled for the duration of the call to avoid a
-- double-click spamming RequestSpawn.
-- AUTO RESPAWN VEHICLE (failsafe, not a routine).
-- A truck that ends up under the map or too far to reach stalls the whole
-- farm forever, and nothing else recovers from it -- so this recalls it on a
-- timer whether or not anything looks wrong. Rare enough that the interval is
-- measured in minutes.
--
-- Recalling seats the player in the truck, so it MOVES them. Two consequences:
--   * never during an auction -- bidding, collecting our lot, or the settle
--     window right after a win where the loot is still spawning. Being yanked
--     into the truck there loses the lot.
--   * while Auto Farm runs, the Master Cycle is the sole owner of the HRP, so
--     the recall happens on ITS thread (it calls RunAutoIfDue while SEARCHING)
--     and this loop only keeps time. Off-farm the loop does it itself.
VEHICLESPAWN.autoEnabled = false
VEHICLESPAWN.autoInterval = 300
VEHICLESPAWN.lastAutoAt = 0

-- One automatic recall, if one is due AND it is safe right now. A blocked
-- attempt does NOT consume the timer: it retries on the next tick, so the
-- recall simply happens as soon as the auction is over.
function VEHICLESPAWN.RunAutoIfDue()
	if not VEHICLESPAWN.autoEnabled or VEHICLESPAWN.autoInterval <= 0 then
		return false
	end
	if (os.clock() - VEHICLESPAWN.lastAutoAt) < VEHICLESPAWN.autoInterval then
		return false
	end

	local blocked = AUCTION.BusyReason()
	if blocked then
		DebugPrint("[VehicleSpawn] Auto respawn due but waiting: " .. blocked)
		return false
	end
	-- Recalling seats the player in the truck wherever it lands, which
	-- yanks them off GOLDPAN.SPOT mid-session -- the user found this is
	-- exactly what breaks Gold Panning ("moves at all after first tp").
	-- SESSION.goldPanning (not GOLDPAN.WW.Hold directly: GOLDPAN is a
	-- local declared much later in the file, out of lexical scope for a
	-- function defined up here -- referencing it would resolve to a
	-- nonexistent global and error) mirrors it, true for the whole time
	-- ANY Wild West feature owns the player's position -- panning,
	-- hunting, racing or defending.
	if SESSION.goldPanning then
		DebugPrint("[VehicleSpawn] Auto respawn due but waiting: Gold Panning is active")
		return false
	end

	VEHICLESPAWN.lastAutoAt = os.clock()
	DebugPrint("[VehicleSpawn] Auto respawn: " .. VEHICLESPAWN.autoInterval .. "s elapsed, recalling the truck")
	if not VEHICLESPAWN.RequestAndWait(2) then
		-- The failsafe itself failing is a real failure: the truck may be the
		-- thing that is already stuck, and staying quiet about it is how the
		-- farm ends up parked with no explanation.
		warn("[VehicleSpawn] Auto respawn failed, truck not recalled -- retrying in " ..
			VEHICLESPAWN.autoInterval .. "s")
		return false
	end
	return true
end

function VEHICLESPAWN.StartAutoLoop()
	if LOOPGUARDS.vehicleRespawn then
		return
	end
	LOOPGUARDS.vehicleRespawn = true
	task.spawn(function()
		while VEHICLESPAWN.autoEnabled and LOOPGUARDS.vehicleRespawn and SESSION.alive do
			-- FARM.active: the Master Cycle owns the HRP and calls
			-- RunAutoIfDue itself. This tick only keeps the clock running.
			if not FARM.active then
				VEHICLESPAWN.RunAutoIfDue()
			end
			task.wait(1)
		end
		LOOPGUARDS.vehicleRespawn = false
	end)
end

