		-- Same per-item accounting the Auction tab's Learned Items panel
		-- gives the legacy list, but scoped to just this rule's own picks --
		-- a name that can never be matched must be the loudest thing here,
		-- same reasoning as IGNOREBID.Rebuild.
		if RULES.bidFp.preparing then
			RULES.ED.Label(pane, "  Learning this rule's item meshes now -- check back in a moment.",
