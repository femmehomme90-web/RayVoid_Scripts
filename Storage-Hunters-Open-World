-- Order is the whole semantics of this tab -- first match wins -- so moving a
-- rule has to move its SAVED text too, not just the live table.
function RULES.ED.Swap(a, b)
	if b < 1 or b > RULES.COUNT then
		return
	end
	RULES.rules[a], RULES.rules[b] = RULES.rules[b], RULES.rules[a]
	RULES.SaveAll()
	if RULES.ED.current == a then
		RULES.ED.current = b
	elseif RULES.ED.current == b then
		RULES.ED.current = a
	end
	RULES.ED.Render()
end

function RULES.ED.RenderFooter()
	if not RULES.ED.footer then
