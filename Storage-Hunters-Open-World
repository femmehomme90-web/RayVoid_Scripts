-- =========================================================
-- EVENT/WEATHER PREDICTION (Misc tab)
-- Predicts the next occurrence of each event/weather by calling
-- DIRECTLY the public functions already exposed by
-- ReplicatedStorage.Modules.SpecialEventManager -- no home-made
-- reimplementation of the game's seeded RNG. The decompile of its
-- internal scheduling logic (intervalOccurrenceStart/isEventDay) contains
-- a variable read before being reassigned right after its creation -- a
-- sign of decompiler information loss -- so reimplementing that logic by
-- hand could have given a confident but wrong prediction. Instead, we
-- use what the game already exposes publicly (confirmed in game via the
-- `real` MCP, 2026-08-26):
--   SpecialEventManager:GetNextConcurrentStart(name) -- any Concurrent
--     event (Rain/Sandstorm/Cargo Ship/Alien Invasion/Fishing Season),
--     handles the 3 scheduling families internally (Interval/
--     DaySchedule/DayCycle). Returns nil for Acid Rain (Scheduled=false
--     in its config -- no deterministic scheduling, special/admin
--     only).
--   SpecialEventManager:GetNextEventStart("Moonlit") -- the only "night"
--     event (different scheduling, isEventNight).
-- IMPORTANT: both functions accept a 3rd "hypothetical time" argument,
-- but we NEVER pass it -- the Interval branch caches its progression
-- state at module level (shared with the rest of the client, including
-- the game's own UI), so probing it with a fake future would
-- desynchronize the real countdown the game displays for the rest of
-- the session. We only call with real time.
-- =========================================================

function EVENTPREDICT.FormatDuration(seconds)
	if type(seconds) ~= "number" then
		return "?"
	end
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm %02ds", h, m, s)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

-- Returns a sorted list (active now first, then soonest first) of
-- {name, nextStart, scheduled, activeNow, activeEndsAt}.
function EVENTPREDICT.GetPredictions()
	local predictions = {}
	local SpecialEventManager = EVENTPREDICT.SpecialEventManager
	local SpecialEventConfig = EVENTPREDICT.SpecialEventConfig

	if not SpecialEventManager or not SpecialEventConfig or type(SpecialEventConfig.Events) ~= "table" then
		return predictions
	end

	for _, eventDef in ipairs(SpecialEventConfig.Events) do
		local ok, nextStart

		if eventDef.Name == "Moonlit" then
			ok, nextStart = pcall(function()
				return SpecialEventManager:GetNextEventStart("Moonlit")
			end)
		elseif eventDef.Concurrent then
			ok, nextStart = pcall(function()
				return SpecialEventManager:GetNextConcurrentStart(eventDef.Name)
			end)
		else
			ok, nextStart = true, nil
		end

		local activeNow = false
		local activeEndsAt = nil
		if eventDef.Concurrent then
			local activeOk, isActive = pcall(function()
				return SpecialEventManager:IsConcurrentEventActive(eventDef.Name)
			end)
			if activeOk and isActive then
				activeNow = true
				local remOk, remaining = pcall(function()
					return SpecialEventManager:GetEventTimeRemaining(eventDef.Name)
				end)
				if remOk and type(remaining) == "number" then
					activeEndsAt = os.time() + remaining
				end
			end
		end

		table.insert(predictions, {
			name = eventDef.Name,
			nextStart = (ok and type(nextStart) == "number") and nextStart or nil,
			scheduled = eventDef.Scheduled ~= false,
			activeNow = activeNow,
			activeEndsAt = activeEndsAt,
		})
	end

	table.sort(predictions, function(a, b)
		if a.activeNow ~= b.activeNow then
			return a.activeNow
		end
		if a.nextStart and b.nextStart then
			return a.nextStart < b.nextStart
		end
		return a.nextStart ~= nil
	end)

	return predictions
end

