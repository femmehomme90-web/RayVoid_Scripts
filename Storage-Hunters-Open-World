-- All auction state grouped here (same pattern as AUTOSELL,
-- ENERGYDRINK, etc.) rather than scattered root-level locals.
--   state / garage      : FSM (SEARCHING / BIDDING / COLLECTING)
--   abort               : an NPC retook the lead DURING the Auto-Win hold,
--                         we cut short, come back, then rebid
--   resolved            : set to true by REMOTES.AuctionPickupStart, server
--                         confirmation that the lot has been won
local AUCTION = {
	maxBid = nil,
	minBid = nil,
	checkedMinBid = false,
	bidActive = false,
	winActive = false,
	winRunning = false,
	wonThisAuction = false,
	abort = false,
	abortNextRequiredBid = nil,
	resolved = false,
	-- Fast Win: when true, the Auto-Win sequence STOPS the out-of-zone
	-- hold the moment the server confirms the win
	-- (REMOTES.AuctionPickupStart -> AUCTION.resolved), without waiting for the
	-- AUTOWIN.WAIT floor. That is "skip the countdown" on the auto-farm
	-- side: without the option, even on an already-won lot, we idle up to
	-- 15s outside the zone for nothing. The MAX_WAIT ceiling and the SETTLE
	-- window stay in place, and we ALWAYS wait for the server confirmation
	-- -- we only cut the dead time AFTER it. Default off (historical).
	fastWin = false,
	state = "SEARCHING",
	garage = nil,
	-- Set to true just before a deliberate LeaveAuction (Min Bid skip):
	-- the UI close that follows is not an auction ending, so we can go
	-- back to searching immediately.
	deliberateLeave = false,
	-- Settle window after a NON-deliberate auction ending.
	-- The "Sold to <you>" and the carryable spawn arrive AFTER the bid
	-- UI closes: without this delay, the master moves on to another
	-- garage during that gap and abandons the lot we just won
	-- (collection cut off midway).
	settleUntil = 0,
	-- True once "Sold to <someone else>" has been heard for our garage:
	-- the auction is resolved and we lost, so there is nothing left for
	-- the settle window to wait for. Cleared on entering BIDDING.
	outcomeKnown = false,
	-- Set the instant the entry fee is paid, cleared the instant the state
	-- moves off SEARCHING. Confirmed that fee-paid and
	-- AUCTION.state actually flipping to BIDDING are two separate server
	-- messages ~6.5s apart (the game's own bidding countdown) -- during that
	-- gap BusyReason() said "not busy" even though we had just paid to stand
	-- inside a live garage, so a Wild West feature's own poll loop (Gold Pan's,
	-- in this case) could claim the floor and pause Auto Farm right as
	-- bidding opened, and Auto-Win then fought it for the HRP.
	feePaidAt = nil,
}

-- "Are we in the middle of an auction?", in one place, because several
-- features need the same answer and each one guessing at it separately is how
-- they drift apart. Returns nil when the coast is clear, otherwise the reason
-- in words so the caller can print it. SEARCHING plus a spent settle window is
-- the only moment nothing is riding on the player's position.
function AUCTION.BusyReason()
	if AUCTION.winRunning then
		return "the auto-win sequence is holding position"
	end
	if AUCTION.state ~= "SEARCHING" then
		return "in an auction (" .. tostring(AUCTION.state) .. ")"
	end
	-- 10s ceiling, not indefinite: bidding reliably follows a paid fee within
	-- ~6.5s, but nothing should be able to claim the floor forever off a flag
	-- that, for whatever reason, never gets cleared.
	if AUCTION.feePaidAt and (os.clock() - AUCTION.feePaidAt) < 10 then
		return "just paid entry fee, waiting for bidding to open"
	end
	if os.clock() < (AUCTION.settleUntil or 0) then
		return "an auction has just ended and the loot is still landing"
	end
	return nil
end

