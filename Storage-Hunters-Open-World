				RULES.Save(RULES.ED.current)
				RULES.ED.Render()
			end,
		})
	end

	local totals = RULES.ED.Row(card, 26, 60)
	RULES.ED.Label(totals, "or all its buffs together add up to at least",
		UDim2.fromOffset(236, 26), UDim2.fromOffset(0, 0), { color = RULES.ED.DIM })
	RULES.ED.NumberBox(totals, setup.sumMin, UDim2.fromOffset(56, 22), UDim2.fromOffset(238, 2), "any",
		function(value)
			setup.sumMin = value
			RULES.Save(RULES.ED.current)
			RULES.ED.Render()
		end)
	RULES.ED.Label(totals, "%", UDim2.fromOffset(14, 26), UDim2.fromOffset(298, 0), { color = RULES.ED.DIM })
	return card
end

-- One lane's lists. Every row drives the REAL RayVoid control through its own
-- :Set(), so the lane's state table, its hooks (IGNOREBID.Rebuild and friends)
-- and the config flag all update exactly as if the dropdown had been clicked
-- by hand. Nothing here re-implements a filter.
function RULES.ED.RenderFilters()
	local pane = RULES.ED.right
	local lane = RULES.ED.lane or FILTERS.ORDER[1]
	local order = 0
	local function nextOrder()
		order = order + 1
		return order
	end

	RULES.ED.Label(pane, FILTERS.TITLE[lane] or lane,
		UDim2.new(1, 0, 0, 22), nil, { bold = true, color = RULES.ED.ACCENT, order = nextOrder() })
	RULES.ED.Label(pane, FILTERS.NOTE[lane] or "", UDim2.new(1, 0, 0, 18), nil,
		{ color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
	local cannot = FILTERS.CANNOT[lane]
	if type(cannot) == "string" then
		cannot = { cannot }
	end
	for _, line in ipairs(cannot or {}) do
		RULES.ED.Label(pane, line, UDim2.new(1, 0, 0, 18), nil,
			{ color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
	end

	local entries = FILTERS.ForLane(lane)
	if #entries == 0 then
		RULES.ED.Label(pane, "This lane has no item lists.", UDim2.new(1, 0, 0, 20), nil,
			{ color = RULES.ED.DIM, order = nextOrder() })
		return
	end

	for _, entry in ipairs(entries) do
		if entry.kind == "bool" then
			local on = FILTERS.Current(entry) == true
			local row = RULES.ED.Row(pane, 26, nextOrder())
			RULES.ED.Button(row, (on and "[x]  " or "[  ]  ") .. entry.label,
				UDim2.new(1, -4, 0, 24), UDim2.fromOffset(0, 1), {
					bg = on and RULES.ED.GOOD or RULES.ED.CARD,
					align = Enum.TextXAlignment.Left,
					padLeft = 8,
					onClick = function()
						FILTERS.Set(entry, not on)
						RULES.ED.Render()
					end,
				})
			if entry.note then
				RULES.ED.Label(pane, "        " .. entry.note, UDim2.new(1, 0, 0, 16), nil,
					{ color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
			end
		else
			local current = FILTERS.Current(entry)
			local picked = {}
			for _, value in ipairs(current) do
				picked[value] = true
			end
			local shown = (#current == 0) and "nothing" or table.concat(current, ", ")
			local row = RULES.ED.Row(pane, 28, nextOrder())
			RULES.ED.Label(row, entry.label, UDim2.fromOffset(108, 28), UDim2.fromOffset(0, 0),
				{ color = RULES.ED.DIM })
			RULES.ED.Button(row, "(" .. #current .. ")  " .. shown,
				UDim2.new(1, -178, 0, 24), UDim2.fromOffset(110, 2), {
					align = Enum.TextXAlignment.Left,
					padLeft = 8,
					color = (#current > 0) and RULES.ED.TEXT or RULES.ED.DIM,
					onClick = function()
						local options = entry.options
						if type(options) == "function" then
							options = options()
						end
						RULES.ED.OpenPicker(entry.label, options or {},
							function(option)
								return picked[option] == true
							end,
							function(option)
								if picked[option] then
									picked[option] = nil
								else
									picked[option] = true
								end
								local list = {}
								for value in pairs(picked) do
									table.insert(list, value)
								end
								table.sort(list)
								FILTERS.Set(entry, list)
							end)
					end,
				})
			RULES.ED.Button(row, "clear", UDim2.fromOffset(58, 24), UDim2.new(1, -62, 0, 2), {
				bg = RULES.ED.CARD,
				color = RULES.ED.DIM,
				onClick = function()
					FILTERS.Set(entry, {})
					RULES.ED.Render()
				end,
			})

			-- The row's button is one line wide and truncates, so the full
			-- selection is spelled out underneath. RayVoid's own control
			-- collapses to "Various" and this window replaced the paragraph
			-- that used to expand it -- without this, a 43-name list has no
			-- place on screen where you can actually read it.
			if #current > 0 then
				local full = table.concat(current, ", ")
				local label = RULES.ED.Label(pane, full, UDim2.new(1, -12, 0, 0), nil,
					{ color = RULES.ED.DIM, textSize = 11, wrapped = true, order = nextOrder() })
				label.AutomaticSize = Enum.AutomaticSize.Y
				label.TextYAlignment = Enum.TextYAlignment.Top
				local pad = Instance.new("UIPadding")
				pad.PaddingLeft = UDim.new(0, 112)
				pad.PaddingBottom = UDim.new(0, 4)
				pad.Parent = label
			end
		end
	end

	-- The bid lane has feedback nothing else has: which of the chosen items are
	-- actually learned, and which can never be learned at all. That paragraph
	-- stayed on the Auction tab when the lists moved in here, which left the
	-- control and the only thing that explains it on different screens.
	if lane == "bid" then
		local status = IGNOREBID.statusText
		if type(status) == "string" and status ~= "" then
			RULES.ED.Label(pane, "WHAT IS ACTUALLY WATCHED", UDim2.new(1, 0, 0, 20), nil,
				{ bold = true, color = RULES.ED.ACCENT, order = nextOrder() })
			local label = RULES.ED.Label(pane, status, UDim2.new(1, -12, 0, 0), nil,
				{ color = RULES.ED.DIM, textSize = 11, wrapped = true, order = nextOrder() })
			label.AutomaticSize = Enum.AutomaticSize.Y
			label.TextYAlignment = Enum.TextYAlignment.Top
		end
		RULES.ED.Label(pane, "Mutations always work. Items and rarities must be learned first",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "with \"Learn ALL Items\" on the Auction tab. Boxed items never match.",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
	end

	-- Where a rule and a list disagree about the same item the RULE wins, so
	-- the list is left showing something that is no longer true. Saying so is
	-- the point: a control that lies quietly is the failure this whole tab
	-- exists to avoid.
	local clashes = RULES.Contradictions(lane)
	if #clashes > 0 then
		RULES.ED.Label(pane, "! A RULE OVERRIDES THIS LIST FOR:", UDim2.new(1, 0, 0, 20), nil,
			{ bold = true, color = RULES.ED.WARN, order = nextOrder() })
		for _, line in ipairs(clashes) do
			RULES.ED.Label(pane, "   " .. line, UDim2.new(1, 0, 0, 18), nil,
				{ color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
		end
	end
end

function RULES.ED.RenderRight()
