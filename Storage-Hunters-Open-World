-- Storage Hunters Open World - AKkiwi
--
-- FILE LAYOUT
--   1. Services + base helpers (DebugPrint, SafeRequire, ReadMutatorNames)
--   2. State tables, one per feature. ALL mutable state lives in them:
--        LOOPGUARDS   loop locks (one field per loop)
--        REMOTES      every remote handle (assigned where it used to be declared)
--        SESSION      dev reload: alive flag + tracked listeners (see end of file)
--        COLLECT      auto-collect + auto-repair
--        FARM         auto-farm (garages, cooldown, placement counters)
--        OFFERS       auto-accept of NPC offers
--        WASHGRADE    auto-wash + auto-grade
--        PLACE        shelf placement filters
--        AUCTION      auction FSM + auto-bid + auto-win
--        AUTOWIN      timing constants for the auto-win sequence
--        FORCEBID     mutations that override Min Bid
--        VEHICLESPAWN truck recall via the official remote
--        GARAGEPRIORITY garage type priority order
--        ENERGYDRINK  auto-buy + auto-use of drinks
--        AUTOSELL     auto-resell at the Pawn Shop
--        RECONNECT    auto-rejoin after a disconnect (+ private server link)
--   3. World helpers (plot, teleport, truck, shelf slots)
--   4. Per-feature logic, then its UI right after
--   5. Master Cycle: sole owner of the HRP while FARM.active
--
-- Rule: a new feature = a new state table, not scattered root-level
-- locals. Lua 5.1 caps a chunk at 200 root-level locals and Prometheus
-- obfuscation breaks past that.

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- DEV RELOAD: if a previous run of this file is still alive (re-executed
-- from the executor workspace without rejoining), shut it down first. The
-- handle is registered at the very END of the file, once everything it
-- must clean up exists. See the SESSION block further down.
if type(getgenv) == "function" and type(getgenv().StorageHunters) == "table" then
	local previous = getgenv().StorageHunters
	if type(previous.Unload) == "function" then
		local unloadOk, unloadErr = pcall(previous.Unload)
		if not unloadOk then
			warn("[Reload] previous instance unload failed: " .. tostring(unloadErr))
		end
	end
end

-- Every run stamps a fresh token here. The AutoLoad block below loops in the
-- background long before the SESSION table exists, so Unload cannot reach it;
-- it compares against this token instead and stops as soon as a newer run has
-- taken over. Without it, a hot reload during a claim retry leaves two claim
-- loops running and every message prints twice.
if type(getgenv) == "function" then
	getgenv().StorageHuntersRun = {}
end

-- DEBUG MODE
-- All informational prints go through DebugPrint, off by default.
-- warn() calls stay always visible (those are real errors/failures).
-- Moved early (before AUTOLOAD just below): the AutoLoad block needs
-- it, and AutoLoad itself must run BEFORE any reference to
-- LocalPlayer.Character (see the AUTOLOAD comment).
--
-- Turned on ONLY by the SH-debug-toggle script (tools/deploy.py writes it),
-- which flips getgenv().StorageHuntersDebug. Deliberately not a UI toggle:
-- the build the hub serves is loadstring'd with no loader in front of it, so
-- that global is never set, end users cannot reach debug mode, and nothing on
-- screen hints it exists.
--
-- Read on EVERY call, not captured once, so the toggle works on a run that is
-- already going -- no reload, no lost state. The env table itself is grabbed
-- once: it never changes, and getgenv() per chatter line would be silly.
local ENV = (type(getgenv) == "function") and getgenv() or nil

local function DebugPrint(...)
	if ENV and ENV.StorageHuntersDebug then
		print(...)
	end
end

-- BUILD STAMP. Always printed, never debug-only: "is the new build actually
-- running?" cost a whole round trip, and one line at load
-- settles it forever. tools/deploy.py rewrites the line below (matched on the
-- BUILD-STAMP marker) with the deploy time on its way to the executor, so the
-- repo copy and the hub build both just say "dev".
print("[SH] Storage Hunter build: dev") -- BUILD-STAMP

-- AUTOLOAD: skip splash screen + automatic plot claim.
--
-- The same complete file is reloaded by loadstring on every arrival
-- on a new server (first join AND reconnects/teleports) --
-- nothing distinguishes the two cases script-side, so this block runs
-- on EVERY execution, with no toggle. Each step has its own timeout
-- (WaitForChild(..., N)): if the matching screen never appears
-- (character already loaded, plot already owned), the step yields on
-- its own without blocking the rest of the script.
--
-- MUST run before any reference to LocalPlayer.Character: on the
-- splash screen the character does not exist yet, and
-- LocalPlayer.CharacterAdded:Wait() would stay blocked until the click
-- on PlayButton -- exactly what this block is meant to do first.
-- Runs in task.spawn (see below): the RayVoid UI (CreateWindow etc.)
-- starts immediately without waiting on this block -- otherwise a
-- player already in game (no SplashScreen) needlessly waits the full
-- 15s timeout before seeing the UI appear. Character/HRP, by contrast,
-- stay assigned only AFTER this block (see below): the character may
-- not exist before the click on PlayButton.
local Character, HRP

task.spawn(function()
	-- MouseButton1Click is a real RBXScriptSignal (not a
	-- BindableEvent), so :Fire() does not exist on it, even with an
	-- executor -- blocked by the Roblox API itself. We try several
	-- methods in order, the first that works wins. Shared
	-- between PlayButton and ClaimButton.
	-- `verify` is polled for 3s after each method and decides whether the
	-- click really did anything. It matters: firesignal not throwing used to
	-- count as success, so on an executor where it fires the signal without
	-- the game reacting, we reported a clicked button, never fell through to
	-- the virtual mouse, and the only trace was a debug-only line. A method
	-- that changes nothing is now a failed method, not a successful one.
	local function ClickButton(button, verify)
		local function worked()
			if not verify then
				return true
			end
			local waited = 0
			while waited < 3 do
				if verify() then
					return true
				end
				task.wait(0.2)
				waited = waited + 0.2
			end
			return false
		end

		-- 1. getconnections: call the game's own handler directly. No signal
		-- is fired and no OS input is sent, which makes this **the only
		-- method that works while the Roblox window is not focused** -- and
		-- that is exactly the case that matters, because an unattended
		-- reconnect lands on the splash screen with the window behind
		-- whatever the user was actually doing.
		--
		-- Added after a VPN reconnect stranded the player on the
		-- splash screen with "clicking PlayButton had no effect": on Real,
		-- firesignal is a no-op in the executor core and the virtual mouse
		-- needs focus, so BOTH existing methods were dead. Real returns
		-- connections carrying a callable .Function plus :Fire(), measured.
		if type(getconnections) == "function" then
			local ok, err = pcall(function()
				for _, connection in ipairs(getconnections(button.MouseButton1Click)) do
					if type(connection.Function) == "function" then
						connection.Function()
					elseif type(connection.Fire) == "function" then
						connection:Fire()
					end
				end
			end)
			if ok and worked() then
				DebugPrint("[AutoLoad]   clicked via getconnections")
				return true
			elseif ok then
				DebugPrint("[AutoLoad]   getconnections ran the handler but nothing changed, trying firesignal")
			else
				warn("[AutoLoad]   getconnections failed: " .. tostring(err))
			end
		end

		-- 2. firesignal (available on some executors, fires a real
		-- RBXScriptSignal directly, without having to click physically).
		if type(firesignal) == "function" then
			local ok, err = pcall(function()
				firesignal(button.MouseButton1Click)
			end)
			if ok and worked() then
				DebugPrint("[AutoLoad]   clicked via firesignal")
				return true
			elseif ok then
				DebugPrint("[AutoLoad]   firesignal fired but nothing changed, trying the mouse")
			else
				warn("[AutoLoad]   firesignal failed: " .. tostring(err))
			end
		end

		-- 3. Virtual click positioned on the button's real on-screen center.
		-- Only meaningful on a VISIBLE button: on a hidden one it clicks
		-- whatever happens to be underneath, so callers gate on Visible.
		if type(mousemoveabs) == "function" and type(mouse1click) == "function" then
			local ok, err = pcall(function()
				local pos = button.AbsolutePosition
				local size = button.AbsoluteSize
				mousemoveabs(pos.X + size.X / 2, pos.Y + size.Y / 2)
				task.wait(0.05)
				mouse1click()
			end)
			if ok and worked() then
				DebugPrint("[AutoLoad]   clicked via virtual mouse (mousemoveabs + mouse1click)")
				return true
			elseif ok then
				DebugPrint("[AutoLoad]   virtual mouse click changed nothing")
			else
				warn("[AutoLoad]   virtual mouse click failed: " .. tostring(err))
			end
		end

		if verify then
			warn("[AutoLoad]   clicking " .. button.Name .. " had no effect")
		else
			warn("[AutoLoad]   no working click method found (firesignal/mousemoveabs unavailable)")
		end
		return false
	end

	-- Skips the launch screen by simulating the real PlayButton click,
	-- once DataLoaded is confirmed (otherwise the game script ignores the
	-- click). We fire no AZLive* remote ourselves -- those are side
	-- effects, not triggers.
	local function bypassSplashScreen()
		local playerGui = LocalPlayer:WaitForChild("PlayerGui")
		local splash = playerGui:WaitForChild("SplashScreen", 15)
		if not splash then
			warn("[AutoLoad] SplashScreen never appeared, skipping")
			return false
		end

		DebugPrint("[AutoLoad] Waiting for DataLoaded...")
		if LocalPlayer:GetAttribute("DataLoaded") ~= true then
			LocalPlayer:GetAttributeChangedSignal("DataLoaded"):Wait()
		end
		DebugPrint("[AutoLoad] DataLoaded confirmed")

		local overlay = splash:FindFirstChild("Overlay")
		local playButton = overlay and overlay:FindFirstChild("PlayButton")
		if not playButton then
			warn("[AutoLoad] SplashScreen.Overlay.PlayButton not found")
			return false
		end

		-- The button shows "Loading..." until showPlayButton() runs
		-- (right after DataLoaded) and switches the text to "PLAY". We
		-- wait for that change to be sure the click will actually be
		-- taken into account.
		local waited = 0
		while playButton.Text ~= "PLAY" and waited < 10 do
			task.wait(0.2)
			waited = waited + 0.2
		end
		DebugPrint("[AutoLoad] PlayButton text: " .. playButton.Text)

		DebugPrint("[AutoLoad] Clicking PlayButton")
		local clicked = ClickButton(playButton, function()
			-- The game tears the splash down once play really starts. If none
			-- of that happened, the click did not land.
			return splash.Parent == nil
				or (splash:IsA("ScreenGui") and splash.Enabled == false)
				or (overlay:IsA("GuiObject") and overlay.Visible == false)
		end)
		if not clicked then
			warn("[AutoLoad] PLAY BUTTON NOT CLICKED -- still on the splash screen. Click PLAY yourself; until then nothing that needs your character (including claiming a plot) can work.")
		end
		return clicked
	end

	local function ownsPlot()
		local plotsFolder = workspace:FindFirstChild("_Plots")
		if not plotsFolder then
			return false
		end
		for _, plot in ipairs(plotsFolder:GetChildren()) do
			if plot:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
				return true
			end
		end
		return false
	end

	-- A hot reload starts a new AutoLoad thread; this one must not keep
	-- clicking alongside it. See the token stamped at the top of the file.
	local myRun = (type(getgenv) == "function") and getgenv().StorageHuntersRun or nil
	local function stillCurrentRun()
		return myRun == nil or getgenv().StorageHuntersRun == myRun
	end

	-- How many times the claim is attempted before giving up. One click used
	-- to be the whole story: click, wait a second, and if the plot was still
	-- not owned, print a warning and carry on plotless -- which silently
	-- breaks everything that needs a plot (placing, washing, grading,
	-- vaulting). Ownership is now re-verified between attempts.
	local PLOT_CLAIM_ATTEMPTS = 8

	-- Polls ownsPlot() for up to `seconds` so a slow server reply is not
	-- mistaken for a failed claim.
	local function waitForPlot(seconds)
		local waited = 0
		while waited < seconds do
			if ownsPlot() then
				return true
			end
			task.wait(0.25)
			waited = waited + 0.25
		end
		return ownsPlot()
	end

	-- The claim screen is built up front but stays hidden until the game
	-- actually reaches plot selection (after PLAY, and only when you have no
	-- plot). Clicking it while hidden achieves nothing, and with the virtual
	-- mouse it clicks whatever is underneath -- which is what 8 wasted
	-- attempts looked like. So: wait for it to be on screen.
	local function waitForClaimScreen(frame, seconds)
		local waited = 0
		while waited < seconds do
			if ownsPlot() or not stillCurrentRun() then
				return false
			end
			local button = frame:FindFirstChild("ClaimButton")
			if frame.Visible and button and button.Visible then
				return true
			end
			task.wait(0.5)
			waited = waited + 0.5
		end
		return false
	end

	-- Printed only when every attempt failed. Says WHY rather than just
	-- "it did not work": whether any plot is free at all, and what the claim
	-- screen actually contains (i.e. whether a plot has to be picked on the
	-- map before the button does anything).
	local function describeClaimScreen(frame)
		local plotsFolder = workspace:FindFirstChild("_Plots")
		local total, free = 0, 0
		if plotsFolder then
			for _, plot in ipairs(plotsFolder:GetChildren()) do
				total = total + 1
				local owner = plot:GetAttribute("OwnerUserId")
				if owner == nil or owner == 0 then
					free = free + 1
				end
			end
		end
		warn("[AutoLoad]   plots: " .. total .. " total, " .. free .. " look unowned")
		if not frame then
			return
		end
		if frame:IsA("GuiObject") then
			warn("[AutoLoad]   PlotSelectionFrame.Visible = " .. tostring(frame.Visible))
		end
		for _, child in ipairs(frame:GetChildren()) do
			local line = "[AutoLoad]   - " .. child.Name .. " (" .. child.ClassName .. ")"
			if child:IsA("GuiObject") then
				line = line .. " Visible=" .. tostring(child.Visible)
			end
			if child:IsA("TextButton") or child:IsA("TextLabel") then
				line = line .. " Text=" .. tostring(child.Text)
			end
			warn(line)
		end
	end

	-- Path confirmed in game: PlayerGui.UIControllerGui.PlotSelectionFrame.ClaimButton
	local function claimPlotViaButton()
		if ownsPlot() then
			DebugPrint("[AutoLoad] Already own a plot, nothing to claim")
			return true
		end

		local playerGui = LocalPlayer:WaitForChild("PlayerGui")
		local controllerGui = playerGui:WaitForChild("UIControllerGui", 15)
		if not controllerGui then
			warn("[AutoLoad] UIControllerGui never appeared -- NO PLOT CLAIMED")
			return false
		end

		local plotSelectionFrame = controllerGui:WaitForChild("PlotSelectionFrame", 15)
		if not plotSelectionFrame then
			-- No claim screen at all. Harmless if the plot arrived some other
			-- way (already owned from a previous session, claimed by the game
			-- itself); a real failure otherwise.
			if waitForPlot(2) then
				DebugPrint("[AutoLoad] No claim screen, but a plot is already owned")
				return true
			end
			warn("[AutoLoad] PlotSelectionFrame never appeared and NO PLOT IS OWNED")
			describeClaimScreen(nil)
			return false
		end

		-- Screen layout confirmed: LeftArrow / ClaimButton /
		-- RightArrow / NoPlots. Claim takes the plot currently on screen, the
		-- arrows page through the others, and NoPlots shows when the server has
		-- none free.
		if not waitForClaimScreen(plotSelectionFrame, 60) then
			if ownsPlot() then
				DebugPrint("[AutoLoad] Plot owned while waiting for the claim screen")
				return true
			end
			if not stillCurrentRun() then
				return false
			end
			warn("[AutoLoad] The claim screen never came up and NO PLOT IS OWNED.")
			warn("[AutoLoad]   Most likely the splash screen was never dismissed, so the game never reached plot selection -- look for the PLAY BUTTON warning above.")
			describeClaimScreen(plotSelectionFrame)
			return false
		end

		for attempt = 1, PLOT_CLAIM_ATTEMPTS do
			if not stillCurrentRun() then
				return false
			end
			if ownsPlot() then
				DebugPrint("[AutoLoad] Plot owned, stopping claim attempts")
				return true
			end

			local noPlots = plotSelectionFrame:FindFirstChild("NoPlots")
			if noPlots and noPlots.Visible then
				warn("[AutoLoad] NO PLOT CLAIMED: this server has no free plot left (the game says TRY ANOTHER SERVER). Rejoin a different server.")
				return false
			end

			-- Re-resolved every attempt: the screen is rebuilt whenever a plot
			-- is taken by someone else while it is open, and a button
			-- reference from before that would click a destroyed object.
			local claimButton = plotSelectionFrame:FindFirstChild("ClaimButton")

			if claimButton and claimButton.Visible then
				DebugPrint("[AutoLoad] Claim attempt " .. attempt .. "/" .. PLOT_CLAIM_ATTEMPTS)
				-- Success is ownership, not a click that returned true.
				if ClickButton(claimButton, ownsPlot) then
					if attempt > 1 then
						print("[AutoLoad] Plot claimed on attempt " .. attempt)
					else
						DebugPrint("[AutoLoad] Plot successfully claimed")
					end
					return true
				end
			else
				DebugPrint("[AutoLoad] Claim attempt " .. attempt .. "/" .. PLOT_CLAIM_ATTEMPTS
					.. ": Claim button not on screen right now")
			end

			-- Claim takes the plot being shown, so if that one would not go
			-- through, someone else holds it: page to the next one first.
			local rightArrow = plotSelectionFrame:FindFirstChild("RightArrow")
			if rightArrow and rightArrow.Visible then
				DebugPrint("[AutoLoad]   showing the next plot")
				ClickButton(rightArrow)
			end

			task.wait(1)
		end

		warn("[AutoLoad] PLOT NOT CLAIMED after " .. PLOT_CLAIM_ATTEMPTS
			.. " attempts -- placing, washing, grading and vaulting will not work. Details:")
		describeClaimScreen(plotSelectionFrame)
		return false
	end

	bypassSplashScreen()

	-- Claiming can now wait up to a minute for the screen and then retry, so
	-- it runs in its own thread: queueonteleport and the Character/HRP
	-- assignment below must not sit behind it.
	task.spawn(function()
		task.wait(1)
		claimPlotViaButton()
	end)

	-- Arms the automatic reload on the NEXT server:
	-- queueonteleport registers a piece of source code (a string, not a
	-- closure) that the executor runs on its own, very early, as soon as
	-- it arrives on the new server following a real teleport
	-- (TeleportService). That is what closes the loop with the AUTOLOAD
	-- block above: the new server re-runs this same file via loadstring,
	-- which skips the screens up front then re-arms queueonteleport for
	-- the next time.
	-- Stays sequential HERE (after claimPlotViaButton, not in parallel):
	-- no need to be earlier, it blocks nothing else.
	-- Must stay a literal string (no closure/upvalues): the code runs in
	-- a completely fresh context on the other server, and none of this
	-- execution's locals exist there any more.
	-- Real names it queue_on_teleport, most other executors queueonteleport.
	-- A dev run (SH-dev.lua sets StorageHuntersDev before loading) re-arms
	-- the workspace file rather than the production URL, so a teleport does
	-- not silently swap the version under test.
	local queueOnTeleport = queue_on_teleport or queueonteleport
	local reloadSource = [[loadstring(game:HttpGet("https://akkiwi.com/h"))()]]
	if type(getgenv) == "function" and getgenv().StorageHuntersDev then
		reloadSource = [[getgenv().StorageHuntersDev = true; loadfile("Storage-Hunter.lua")()]]
	end
	if type(queueOnTeleport) == "function" then
		local queuedOk, queuedErr = pcall(function()
			-- The queue APPENDS and is never emptied on its own. Every arrival
			-- armed one more entry, so the next teleport started two copies of
			-- this file, then three -- three UIs, three auction FSMs fighting
			-- over the same auction ("you're already in an auction"), three
			-- reconnect loops. Clear it before arming so exactly one copy is
			-- ever queued.
			if type(clear_teleport_queue) == "function" then
				clear_teleport_queue()
			end
			queueOnTeleport(reloadSource)
		end)
		if queuedOk then
			DebugPrint("[AutoLoad] queueonteleport armed")
		else
			warn("[AutoLoad] queueonteleport failed: " .. tostring(queuedErr))
		end
	else
		warn("[AutoLoad] queueonteleport not available on this executor, script won't auto-reload across a real teleport")
	end

	-- Character/HRP assigned only now: the character may not exist
	-- before the click on PlayButton (bypassSplashScreen above). Any
	-- function further down the file that captures these locals by
	-- upvalue (GetFarmReferencePosition, etc.) only READS them from a
	-- user toggle, so well after this task.spawn has finished --
	-- assigning late here is risk-free.
	Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	HRP = Character:WaitForChild("HumanoidRootPart")
end)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Events = ReplicatedStorage:WaitForChild("Events")

-- Remote handles: ONE table instead of ~30 root-level locals (200-local
-- limit). Each handle is still assigned at the same place in the file as
-- before, so WaitForChild order and timing are unchanged; only the name
-- moved. New remotes go in here too: REMOTES.Foo = folder:WaitForChild("Foo").
local REMOTES = {}

-- DEV RELOAD / UNLOAD
-- Re-executing this file while a previous run is still alive (hot reload
-- from the executor workspace, no rejoin) would double every window,
-- listener and loop. So each run registers an Unload() handle in getgenv()
-- (see the very END of the file) and the next run calls it first (see the
-- top). Everything that must die on unload goes through this table:
--   SESSION.alive         checked by the two loops that have no feature flag
--   SESSION.Track(conn)   wraps every root-level :Connect() so Unload can
--                         disconnect it
-- Feature loops stop through their own flags; Unload sets them all false.
-- ONE root-level local for all of it (200-local limit).
local SESSION = {
	alive = true,
	connections = {},
	-- This run's copy of the token stamped at the top of the file. The
	-- handshake up there cannot catch copies that start in the same instant
	-- (the Unload handle is only registered at the END of the file, seconds
	-- later, so all of them see "no previous run" and all of them survive).
	-- The end of the file compares this against the global one: whoever no
	-- longer owns it tears itself down instead of registering.
	token = (type(getgenv) == "function") and getgenv().StorageHuntersRun or nil,
	-- Mirrors GOLDPAN.WW.Hold (Wild West event, declared much later in the
	-- file): true whenever ANY Wild West feature owns the player's position
	-- -- panning, hunting, racing or defending. Put here instead so
	-- VEHICLESPAWN.RunAutoIfDue -- defined earlier than GOLDPAN, so it
	-- cannot see that local at all -- can still tell and skip the
	-- auto-recall, which would otherwise seat the player in the truck
	-- wherever it lands, mid-session. The name predates the other three
	-- features; it is kept because renaming it buys nothing.
	goldPanning = false,
}

function SESSION.Track(conn)
	table.insert(SESSION.connections, conn)
	return conn
end

-- Guard booleans for the double-guard pattern (feature bool + loop-active
-- bool), one field per loop. Grouped into ONE table rather than 6 separate
-- root-level locals: Lua 5.1 caps root-level locals at 200 and this file
-- is close to the limit. Do not split them back into individual locals.
local LOOPGUARDS = {
	inventoryProcessing = false,
	washClaim = false,
	gradeClaim = false,
	collect = false,
	masterCycle = false,
	antiAfk = false,
	autoSell = false,
	energyDrink = false,
	autoFish = false,
	autoVault = false,
	autoMuseum = false,
	reconnect = false,
	collectorKeep = false,
	vehicleRespawn = false,
	-- Wild West event loops. Declared here rather than created on first
	-- Start() so SESSION.Unload's `for key in pairs(LOOPGUARDS)` sweep
	-- clears them even on a reload that happened before they ever ran.
	goldPan = false,
	goldPanSellBroken = false,
	autoOutlaw = false,
	autoRace = false,
	autoTownDefense = false,
	-- Gives Auto Farm back when a Wild West feature dies holding it.
	wwWatchdog = false,
	-- Keeps the game's IdleRejoin switched off while something holds it.
	idleRejoinHold = false,
}

-- =========================================================
-- PRIVATE SERVER WATCH -- are we still in the private server we were in?
--
-- Auto Reconnect has exactly one call available to it,
-- TeleportService:Teleport(placeId, player), and that call names no server:
-- it means "put me in this place" and ROBLOX picks which one. It normally
-- puts a private-server player back in their private server, but that is
-- Roblox's decision, not something we ask for. If the private server was
-- torn down while we were disconnected, the rejoin lands in a PUBLIC server
-- and nothing in the game says so -- RayVoid then restores the Auto Farm
-- toggle and the farm quietly runs in a stranger's server.
--
-- This must NOT depend on our own reconnect having driven the rejoin. Most
-- people execute the script by hand once they are already in a server, and
-- the routes back that we never see are the common ones: Roblox's own
-- Reconnect button, the game page, Auto Reconnect switched off, the executor
-- closed along with the game. A note dropped at teleport time only covers
-- rejoins we drove ourselves, which is the minority.
--
-- So: a rolling record instead. While the script runs in a private server it
-- rewrites SESSION.privateFile every minute. Any later execution -- ours on
-- arrival, or the user's own Execute click -- reads it and asks one question:
-- was I in a private server a moment ago, and am I in a public one now?
--
-- It lives HERE, at the top, because SESSION.landedPublic has to exist before
-- the Auto Farm toggle is built and before RayVoid restores its saved value.
-- =========================================================
SESSION.landedPublic = false
-- When this run started, so a toggle can tell the saved-config restore at
-- load (which lands in the first moment) from a person flipping it later.
SESSION.loadedAt = os.clock()
SESSION.privateFile = "SH-last-private.txt"
SESSION.privateId = (game.PrivateServerId or "")

function SESSION.WritePrivateRecord()
	if type(writefile) ~= "function" then
		return false
	end
	local ok, err = pcall(function()
		writefile(SESSION.privateFile, tostring(os.time()) .. " " .. SESSION.privateId)
	end)
	if not ok then
		warn("[Server] could not write " .. SESSION.privateFile .. ": " .. tostring(err))
	end
	return ok
end

function SESSION.ForgetPrivateRecord()
	pcall(function()
		if type(delfile) == "function" then
			delfile(SESSION.privateFile)
		elseif type(writefile) == "function" then
			writefile(SESSION.privateFile, "")
		end
	end)
end

do
	-- How long a private session stays "a moment ago". Long enough to cover a
	-- disconnect, the rejoin and a manual Execute afterwards; short enough that
	-- a deliberate public session later in the day is not second-guessed.
	local MEMORY = 1800

	if SESSION.privateId ~= "" then
		-- In a private server. Keep the record fresh for as long as we run, so a
		-- disconnect at hour three is covered as well as one at minute one. This
		-- also keeps it fresh right through our own retry loop, which can run for
		-- many minutes before Roblox takes the teleport.
		if not SESSION.WritePrivateRecord() then
			warn("[Server] this executor has no writefile -- if a rejoin drops you in a public server you will not be told")
		end
		task.spawn(function()
			while SESSION.alive do
				task.wait(60)
				if SESSION.alive then
					SESSION.WritePrivateRecord()
				end
			end
		end)
	elseif type(isfile) == "function" and type(readfile) == "function" then
		-- In a public server. If we were in a private one minutes ago, this is not
		-- where the user meant to end up.
		local ok, data = pcall(function()
			if isfile(SESSION.privateFile) then
				return readfile(SESSION.privateFile)
			end
			return nil
		end)
		if not ok then
			warn("[Server] could not read " .. SESSION.privateFile .. ": " .. tostring(data))
			data = nil
		end
		local wroteAt = tonumber(tostring(data):match("^(%d+)"))
		if wroteAt and (os.time() - wroteAt) < MEMORY then
			SESSION.landedPublic = true
			warn("[Server] THIS IS A PUBLIC SERVER. You were in a private server minutes ago, so the rejoin did "
				.. "not put you back -- the private server was most likely shut down while you were out.")
			warn("[Server] Auto Farm is blocked. Rejoin your private server yourself, or switch Auto Farm "
				.. "on a second time if you really want to farm in this server.")
		end
		-- The record is deliberately NOT consumed: a second Execute in the same
		-- public server has to warn again. It ages out on its own.
	end
end

-- The same refusal for every OTHER feature that moves the player. Measured
-- A network drop reconnected into a public server, the guard
-- above blocked Auto Farm -- and Auto Defend, Auto Hunt Outlaws and Auto
-- Horse Race came straight back on from the saved config and ran a whole
-- Town Defense in front of five strangers. Only the unattended restore at
-- load is refused (the first few seconds); a person switching one on later
-- is taken as meaning it. Returns true when it refused, and puts the switch
-- back off out of line (:Set() re-enters the callback).
function SESSION.RefuseInLandedPublic(name, getToggle)
	if not SESSION.landedPublic or (os.clock() - SESSION.loadedAt) > 5 then
		return false
	end
	warn("[Server] " .. name .. " refused: you were in a private server minutes ago and this one is public. "
		.. "Rejoin your private server, or switch it on again to run it here anyway.")
	task.spawn(function()
		task.wait(0.2)
		local toggle = getToggle()
		if toggle and toggle.Set then
			pcall(function() toggle:Set(false) end)
		end
	end)
	return true
end

-- Protected require(): returns the module or nil (+ warn) instead of
-- erroring. Replaces the "local ok, X = pcall(...)" pattern, which costs
-- 2 root-level locals per call site; Lua 5.1 caps root-level locals at
-- 200 and this file is close to the limit. Do not reintroduce that pattern.
local function SafeRequire(path, label)
	local ok, result = pcall(function()
		return require(path)
	end)
	if ok then
		return result
	end
	warn("[SafeRequire] " .. tostring(label) .. " unavailable: " .. tostring(result))
	return nil
end

-- Reads an item's mutation names by trying BOTH possible attribute
-- names ("Mutator" singular and "Mutators" plural). The game seems to
-- use one or the other depending on context/number of mutations, never
-- confirmed with certainty despite several contradictory in-game tests
-- -- so we read both and merge rather than guessing which one applies
-- where. Used by isItemBroken (carryables) AND FORCEBID.Check
-- (garage.Floorspace).
local function ReadMutatorNames(item)
	local names = {}
	for _, attrName in ipairs({ "Mutator", "Mutators" }) do
		local raw = item:GetAttribute(attrName)
		if type(raw) == "string" and raw ~= "" and raw ~= "[]" then
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
			if ok and type(decoded) == "table" then
				for _, mutation in ipairs(decoded) do
					if type(mutation) == "table" and type(mutation.name) == "string" then
						table.insert(names, mutation.name)
					end
				end
			end
		end
	end
	return names
end

-- Moved early in the file (used to be lower) so it can be used by
-- GetCarryablePrompts/CountOwnedCarryablePrompts as well as CollectItem.
local function isItemBroken(itemModel)
	if not itemModel then return false end
	for _, name in ipairs(ReadMutatorNames(itemModel)) do
		if name == "Broken" then
			return true
		end
	end
	return false
end

