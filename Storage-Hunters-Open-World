	RULES.ED.Label(valueRow, "from", UDim2.fromOffset(34, 28), UDim2.fromOffset(100, 0), { color = RULES.ED.DIM })
	RULES.ED.NumberBox(valueRow, rule.minValue, UDim2.fromOffset(88, 24), UDim2.fromOffset(134, 2), "anything",
		function(value)
			rule.minValue = value
			RULES.Save(RULES.ED.current)
			RULES.ED.RenderFooter()
		end)
	RULES.ED.Label(valueRow, "to", UDim2.fromOffset(20, 28), UDim2.fromOffset(228, 0), { color = RULES.ED.DIM })
	RULES.ED.NumberBox(valueRow, rule.maxValue, UDim2.fromOffset(88, 24), UDim2.fromOffset(250, 2), "anything",
		function(value)
			rule.maxValue = value
			RULES.Save(RULES.ED.current)
			RULES.ED.RenderFooter()
		end)

	local weightRow = RULES.ED.Row(pane, 28, nextOrder())
	RULES.ED.Label(weightRow, "Weighs", UDim2.fromOffset(96, 28), UDim2.fromOffset(0, 0), { color = RULES.ED.DIM })
	RULES.ED.Label(weightRow, "from", UDim2.fromOffset(34, 28), UDim2.fromOffset(100, 0), { color = RULES.ED.DIM })
	RULES.ED.NumberBox(weightRow, rule.weightMin, UDim2.fromOffset(88, 24), UDim2.fromOffset(134, 2), "any KG",
		function(value)
			rule.weightMin = value
			RULES.Save(RULES.ED.current)
			RULES.ED.RenderFooter()
		end)
	RULES.ED.Label(weightRow, "to", UDim2.fromOffset(20, 28), UDim2.fromOffset(228, 0), { color = RULES.ED.DIM })
	RULES.ED.NumberBox(weightRow, rule.weightMax, UDim2.fromOffset(88, 24), UDim2.fromOffset(250, 2), "any KG",
		function(value)
			rule.weightMax = value
			RULES.Save(RULES.ED.current)
			RULES.ED.RenderFooter()
		end)
	RULES.ED.Label(weightRow, "KG", UDim2.fromOffset(30, 28), UDim2.fromOffset(344, 0), { color = RULES.ED.DIM })

	RULES.ED.Label(pane, "Every item has a weight. Uranium Ore, Hay, the crops and the eggs roll their own.",
		UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
	RULES.ED.Label(pane, "! KG only works on items ALREADY IN YOUR INVENTORY (sell / place / grade).",
		UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
	RULES.ED.Label(pane, "  The game does not reveal a weight while the lot is still up for auction.",
		UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })

	RULES.ED.Label(pane, "MUTATIONS  --  for gavels and anything else that rolls buffs",
		UDim2.new(1, 0, 0, 22), nil, { bold = true, color = RULES.ED.ACCENT, order = nextOrder() })
	RULES.ED.Label(pane, "Leave this empty unless you care about buffs. Items with none still match everything above.",
		UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
	RULES.ED.Label(pane, "! Buff % only works on items ALREADY IN YOUR INVENTORY (sell / place / grade).",
		UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
