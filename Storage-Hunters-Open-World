-- CARGO WEIGHT MANAGEMENT
local CARGO_MARGIN_PERCENT = 0.10

local function GetTruckWeightInfo(truck)
	local weight = truck:GetAttribute("CargoWeight")
	local limit = truck:GetAttribute("CargoWeightLimit")
	if type(weight) ~= "number" or type(limit) ~= "number" or limit <= 0 then
		return nil
	end
	return weight, limit
end

local function HasCargoRoom(truck)
	local weight, limit = GetTruckWeightInfo(truck)
	if not weight then
		return true
	end
	local remaining = limit - weight
	return remaining >= (limit * CARGO_MARGIN_PERCENT)
end

local function SitInTruck(truck)
	local seat = truck:FindFirstChild("DriveSeat")
	if not seat or not seat:IsA("VehicleSeat") then
		warn("[CargoManager] DriveSeat not found in the truck")
		return false
	end
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		warn("[CargoManager] Humanoid not found")
		return false
	end
	seat:Sit(humanoid)
	return true
end

local function UnloadCargo()
	local truck = GetPlayerTruck()
	if not truck then
		warn("[CargoManager] Truck not found for unloading")
		return false
	end

	local wasAlreadySeated = GetSeatedVehicle() == truck
	DebugPrint("[CargoManager] wasAlreadySeated=" .. tostring(wasAlreadySeated))

	if not wasAlreadySeated then
		if not SitInTruck(truck) then
			return false
		end

		-- Was a flat task.wait(2) below, paid on every unload whether or not
		-- we had just sat down. The transfer only needs the seat to have
		-- actually taken hold, and the Humanoid reports exactly that, so wait
		-- for the real thing and skip it entirely when already seated. This
		-- runs after every won auction, so it is seconds off every container.
		local waited = 0
		while waited < 2 do
			local character = LocalPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.SeatPart then
				break
			end
			task.wait(0.1)
			waited = waited + 0.1
		end
		DebugPrint("[CargoManager] Seated in the truck after " .. string.format("%.1f", waited) .. "s")
	end

	local weightBefore = GetTruckWeightInfo(truck)
	local sentCount = TransferTruckCargo()

	-- Was a flat task.wait(1.5) here regardless of whether anything had been
	-- sent. The truck's CargoWeight attribute is the server telling us the
	-- transfer landed, so watch that instead of guessing, and do not wait at
	-- all when the truck was empty.
	if sentCount and sentCount > 0 then
		if weightBefore == nil then
			-- No readable weight means no confirmation is possible, so the old
			-- flat wait stands. Said out loud rather than silently racing on.
			DebugPrint("[CargoManager] Truck cargo weight is not readable, falling back to a flat 1.5s wait")
			task.wait(1.5)
		else
			local deadline = os.clock() + 1.5
			local moved = false
			while os.clock() < deadline do
				task.wait(0.1)
				local weightNow = GetTruckWeightInfo(truck)
				if weightNow == nil or weightNow < weightBefore then
					moved = true
					break
				end
			end
			if not moved then
				-- The truck is still carrying what it was carrying, so the items
				-- are not in the inventory and the next garage will fill up early.
				warn("[CargoManager] " .. sentCount ..
					" item(s) sent to the inventory but the truck's cargo weight has not moved -- the inventory is probably full")
			end
		end
	end

	if not wasAlreadySeated then
		local character = LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Sit = false
			DebugPrint("[CargoManager] Sit=false sent, waiting to leave the seat...")

			local waited = 0
			while (humanoid.SeatPart ~= nil or humanoid:GetState() == Enum.HumanoidStateType.Seated) and waited < 2 do
				task.wait(0.1)
				waited = waited + 0.1
			end
			DebugPrint("[CargoManager] Seat exit confirmed after " .. waited .. "s (state: " .. tostring(humanoid:GetState().Name) .. ")")

			-- The loop above already confirmed the seat is released, so this is
			-- only physics settling before whoever called us moves the player.
			-- 0.15s instead of 0.5s; it runs after every won auction.
			task.wait(0.15)
		else
		end
	end

	return true
end

-- FORCE BID ON MUTATION
-- A targeted mutation in the garage overrides Min Bid (veto on veto).
-- Source: garage.Floorspace > <Model> > "Mutators" attribute (JSON).
-- Same attribute name on post-win carryables (isItemBroken) -- the old
-- note here wrongly claimed a different singular "Mutator", corrected
-- after testing in game.
-- The Floorspace is populated from the start of the auction.

-- List of selectable mutations, built once at load time from
-- MutatorModule's 8 tables (color, flag, tag, clean, event, time,
-- perfect, size). Wrapped in an immediate function so it consumes
-- ONLY ONE root-level local (Lua 5.1 limit of 200).
local FORCEBID = {}

FORCEBID.options = (function()
	local GROUP_KEYS = {
		"Mutations",
		"FlagMutations",
		-- "TagMutations" deliberately absent: Exclusive/Limited/Fish/
		-- Quest/Mint/Showcased/Artifact have no Roll* function in
		-- MutatorModule (unlike Mutations/EventMutations/FlagMutations,
		-- which are properly rolled via RollMutationsForItem /
		-- RollEventMutators / RollConditionAndFlags). They are static
		-- item definition fields (Items[id].EventExclusive), not
		-- mutations that ever land in the Mutators attribute. Offering
		-- them in this dropdown could never match.
		"CleanMutations",
		"EventMutations",
		"TimeMutations",
		"PerfectMutations",
		"SizeMutations",
	}

	local seen = {}
	local names = {}

	for _, key in ipairs(GROUP_KEYS) do
		local group = MutatorModule[key]
		if type(group) == "table" then
			for _, def in ipairs(group) do
				if type(def) == "table" and type(def.Name) == "string" and def.Name ~= "" then
					if not seen[def.Name] then
						seen[def.Name] = true
						table.insert(names, def.Name)
					end
				end
			end
		end
	end

	table.sort(names)

	-- "Mint" is added by hand because it is not a mutation the game rolls --
	-- it is derived from Condition (see IsMintCondition). Users think of it
	-- as one and asked for it in these lists, so it is offered here and
	-- special-cased in all three matchers. Kept first so it is visible
	-- without scrolling or searching.
	table.insert(names, 1, "Mint")

	return names
end)()

FORCEBID.selected = {}

-- Resolves the garage whose auction zone contains the player, when the
-- caller does not already have a usable reference.
local function ResolveNearbyGarage(garage)
	if garage and garage.Parent and garage:FindFirstChild("Floorspace") then
		return garage
	end

	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local debris = workspace:FindFirstChild("_Debris")
	local garagesFolder = debris and debris:FindFirstChild("Garages")

	if not (hrp and garagesFolder) then
		return nil
	end

	local best = nil
	local bestDist = math.huge
	for _, candidate in ipairs(garagesFolder:GetChildren()) do
		local zone = candidate:FindFirstChild("AuctionZone")
		if zone and zone:IsA("BasePart") and candidate:FindFirstChild("Floorspace") then
			local rel = zone.CFrame:PointToObjectSpace(hrp.Position)
			local half = zone.Size / 2
			if math.abs(rel.X) <= half.X
				and math.abs(rel.Z) <= half.Z
				and math.abs(rel.Y) <= 25 then
				local dist = (zone.Position - hrp.Position).Magnitude
				if dist < bestDist then
					best = candidate
					bestDist = dist
				end
			end
		end
	end

	return best
end

-- Returns (true, mutationName) if the garage contains at least one item
-- carrying one of the selected mutations. false otherwise.
function FORCEBID.Check(garage)
	if next(FORCEBID.selected) == nil then
		return false, nil
	end

	garage = ResolveNearbyGarage(garage)
	if not garage then
		warn("[ForceBid] Garage not resolved, Min Bid applies normally")
		return false, nil
	end

	local floorspace = garage:FindFirstChild("Floorspace")
	if not floorspace then
		warn("[ForceBid] Floorspace not found in " .. tostring(garage.Name))
		return false, nil
	end

	local wantMint = FORCEBID.selected["Mint"]

	for _, item in ipairs(floorspace:GetChildren()) do
		-- Mint before the mutation names: it is a Condition test, not a
		-- Mutators lookup. Condition is one of the two things that leak
		-- through a concealment box, so this works pre-win like the
		-- mutation match does.
		if wantMint and IsMintCondition(item:GetAttribute("Condition")) then
			return true, "Mint"
		end
		for _, name in ipairs(ReadMutatorNames(item)) do
			if FORCEBID.selected[name] then
				return true, name
			end
		end
	end

	return false, nil
end

-- RULES.CheckGarage (the Item Rules version of the same veto-on-veto) lives
-- below IGNOREBID now, in the AUTO BID section -- it resolves a Floorspace
-- model's name through IGNOREBID.Fingerprint, and IGNOREBID is declared as a
-- `local` just below this comment, so anything calling into it has to be
-- defined after that declaration or it would silently see a nil global.

-- IGNORE MIN BID ON ITEM / RARITY
-- The sibling of FORCEBID, for specific items and rarities instead of
-- mutations. Same veto-on-veto: a targeted item in the garage overrides
-- Min Bid.
--
-- Why this needs machinery at all, while FORCEBID does not: the game
-- STRIPS the item name from a Floorspace model during the auction (they
-- are all called "Model", and are renamed to the real item only once the
-- auction resolves). Mutations leak through, the name does not. What is
-- not hidden is the geometry: the model is still built from the item's
-- own meshes. So we identify an item by its set of mesh ids, matched
-- against the canonical model ItemLoader:GetItem(name) returns.
-- Verified: Cheese Slice and Water Hand Pump were both
-- identified mid-auction, and the names the game filled in after the win
-- confirmed both. Full write-up in docs/game-reference.md.
--
-- Cost discipline: loading a model costs ~68ms, and there are 1039 items,
-- so the full sweep takes ~70s and must NEVER happen at runtime. We only
-- ever fingerprint the items the USER selected, once, at selection time,
-- and cache the result to disk. Checking a garage then loads nothing at
-- all -- it reads 6 models' mesh ids and compares, as instant as the
-- mutation check.
local IGNOREBID = {
	-- What the user picked.
	selectedItems = {},        -- item name -> true
	selectedRarities = {},     -- rarity name -> true

	-- fingerprint string -> item name, rebuilt from the selection. This is
	-- the only thing Check() touches.
	targets = {},

	-- item name -> fingerprint string, or false for "has no meshes, can
	-- never be identified". Persisted, so a name is loaded at most once ever.
	cache = {},
	cacheLoaded = false,
	cacheDirty = false,

	-- Prepare state. `ready` is false while models are still loading;
	-- Check() refuses to answer rather than answering wrongly.
	ready = true,
	preparing = false,
	generation = 0,
	statusLabel = nil,

	-- Learning every item in the game in one pass (the "Learn ALL" button).
	-- Kept apart from `preparing`, which is only ever about the user's own
	-- selection: the two must not run at the same time.
	learning = false,
	learnLabel = nil,

	-- Set once the game's ItemPreviewCache is used up and GetItem has
	-- stopped returning anything. Only a rejoin clears it, so it stays true
	-- for the rest of the session and Learn ALL refuses instead of grinding
	-- through a thousand five-second timeouts.
	exhausted = false,

	CACHE_FILE = "SH-meshfingerprints.json",

	-- Items that are built from exactly the same meshes as another item and
	-- therefore cannot be told apart. From the full 1039-item audit
	-- (snippets/mesh-index-audit.lua). Selecting one of these
	-- is allowed, but the user is told it can also fire on its twin --
	-- silently matching the wrong item is exactly what we will not do.
	AMBIGUOUS = {
		["Luck Drink 1"] = "Luck Drink 2 / Luck Drink 3",
		["Luck Drink 2"] = "Luck Drink 1 / Luck Drink 3",
		["Luck Drink 3"] = "Luck Drink 1 / Luck Drink 2",
		["Apple Seeds"] = "Corn / Orange / Sunflower / Tomato Seeds",
		["Corn Seeds"] = "Apple / Orange / Sunflower / Tomato Seeds",
		["Orange Seeds"] = "Apple / Corn / Sunflower / Tomato Seeds",
		["Sunflower Seeds"] = "Apple / Corn / Orange / Tomato Seeds",
		["Tomato Seeds"] = "Apple / Corn / Orange / Sunflower Seeds",
		["Alien Storage Box"] = "Steel Storage Box",
		["Steel Storage Box"] = "Alien Storage Box",
		["Tractor Tire"] = "Tractor Wheel Stack",
		["Tractor Wheel Stack"] = "Tractor Tire",
		["Large Cash"] = "Medium Cash",
		["Medium Cash"] = "Large Cash",
		["Flash Grenade"] = "Smoke Grenade",
		["Smoke Grenade"] = "Flash Grenade",
		["Green Radiant Bench"] = "Green Radiant Chair",
		["Green Radiant Chair"] = "Green Radiant Bench",
		["Reactor Control Panel"] = "Small Control Panel",
		["Small Control Panel"] = "Reactor Control Panel",
		["Wooden Cart"] = "Wooden Cart Wheel",
		["Wooden Cart Wheel"] = "Wooden Cart",
		["Nuclear Monitoring Screen"] = "Radiation Monitoring Screen",
		["Radiation Monitoring Screen"] = "Nuclear Monitoring Screen",
	},
}

-- Sorted mesh ids of a model, joined. Same routine for a garage model and
-- for a canonical item model, which is what makes the two comparable.
function IGNOREBID.Fingerprint(model)
	local ids = {}
	local seen = {}
	for _, d in ipairs(model:GetDescendants()) do
		local id = nil
		if d:IsA("MeshPart") then
			id = d.MeshId
		elseif d:IsA("SpecialMesh") then
			id = d.MeshId
		end
		if type(id) == "string" and id ~= "" and not seen[id] then
			seen[id] = true
			table.insert(ids, id)
		end
	end
	table.sort(ids)
	return table.concat(ids, "|")
end

function IGNOREBID.LoadCache()
	if IGNOREBID.cacheLoaded then
		return
	end
	IGNOREBID.cacheLoaded = true

	if type(readfile) ~= "function" or type(isfile) ~= "function" then
		DebugPrint("[IgnoreBid] No file API, fingerprints will be re-learned every session")
		return
	end

	local ok, raw = pcall(function()
		if isfile(IGNOREBID.CACHE_FILE) then
			return readfile(IGNOREBID.CACHE_FILE)
		end
		return nil
	end)
	if not ok or type(raw) ~= "string" or raw == "" then
		return
	end

	local okDecode, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if okDecode and type(decoded) == "table" then
		IGNOREBID.cache = decoded
		local n = 0
		for _ in pairs(decoded) do
			n = n + 1
		end
		DebugPrint("[IgnoreBid] Loaded " .. tostring(n) .. " cached fingerprints")
	else
		warn("[IgnoreBid] Fingerprint cache is corrupt, starting fresh")
	end
end

function IGNOREBID.SaveCache()
	if not IGNOREBID.cacheDirty then
		return
	end
	if type(writefile) ~= "function" then
		return
	end

	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(IGNOREBID.cache)
	end)
	if not ok then
		warn("[IgnoreBid] Could not encode fingerprint cache: " .. tostring(encoded))
		return
	end

	local okWrite, err = pcall(function()
		writefile(IGNOREBID.CACHE_FILE, encoded)
	end)
	if okWrite then
		IGNOREBID.cacheDirty = false
	else
		warn("[IgnoreBid] Could not write fingerprint cache: " .. tostring(err))
	end
end

-- Fingerprint one item by name, using the cache. Returns the fingerprint
-- string, or false when the item has no meshes and can never be matched.
function IGNOREBID.FingerprintItem(itemName)
	local cached = IGNOREBID.cache[itemName]
	if cached ~= nil then
		return cached
	end

	if not ItemLoader then
		return nil
	end

	-- GetItem comes back empty when the asset is not loaded yet, which
	-- happens in bursts: nine Mythicals "failed" during one bulk pass and
	-- every one of them loaded on the very next try. So a miss is retried
	-- rather than believed. Marking an item undetectable when it is merely
	-- slow is worse than waiting a moment for it.
	local model = nil
	for attempt = 1, 2 do
		local ok, result = pcall(function()
			return ItemLoader:GetItem(itemName)
		end)
		if ok and typeof(result) == "Instance" then
			model = result
			break
		end
		if attempt < 2 then
			task.wait(0.1)
		end
	end

	-- nil, not false: "could not load" is a different failure from "loaded
	-- fine but has no meshes", and Rebuild reports the two separately. Not
	-- cached either, so a later attempt can still succeed.
	if not model then
		return nil
	end

	-- Read first, release second: the mesh ids have to come off the model
	-- while it still exists.
	local fp = IGNOREBID.Fingerprint(model)

	-- MUST be destroyed, and unconditionally. GetItem parents what it builds
	-- into PlayerGui.ItemPreviewCache, and that cache has a ceiling: once it
	-- was sitting at 141 models, GetItem stopped producing anything -- it
	-- blocked for 5s and returned nil, every time, for every remaining item.
	-- Measured, and it is self-inflicted: preparing a rarity fills
	-- the cache and then every later item in the same run "fails to load".
	-- Releasing our own entry as soon as its meshes are read keeps the cache
	-- from filling. It is a cache, so the game refills it on demand.
	pcall(function()
		model:Destroy()
	end)

	if fp == "" then
		IGNOREBID.cache[itemName] = false
		IGNOREBID.cacheDirty = true
		return false
	end

	IGNOREBID.cache[itemName] = fp
	IGNOREBID.cacheDirty = true
	return fp
end

-- Every item name covered by the current selection: the explicitly chosen
-- items, plus every item of a chosen rarity.
function IGNOREBID.CollectTargetNames()
	local names = {}
	local seen = {}

	for itemName in pairs(IGNOREBID.selectedItems) do
		if not seen[itemName] then
			seen[itemName] = true
			table.insert(names, itemName)
		end
	end

	if next(IGNOREBID.selectedRarities) ~= nil then
		for _, def in pairs(Items) do
			if type(def) == "table" and type(def.Name) == "string" then
				local rarity = def.Rarity or "Uncommon"
				if IGNOREBID.selectedRarities[rarity] and not seen[def.Name] then
					seen[def.Name] = true
					table.insert(names, def.Name)
				end
			end
		end
	end

	return names
end

-- The status paragraphs are the only place the user can see that a rarity
-- is still loading, that a pick can never be detected, or how a learning
-- pass went. A CreateParagraph is used rather than a CreateLabel because
-- :Set is only proven to work on paragraphs (cf. policeRaidParagraph). If
-- an update ever fails we say so in the console rather than leaving a
-- stale panel standing.
-- The text is kept as well as drawn: the rule editor window shows the same
-- status beside the bid lists, which live there now.
function IGNOREBID.SetPanel(panel, title, text)
	if title == "Item / Rarity Override" then
		IGNOREBID.statusText = text
	end
	if not panel then
		return
	end
	local ok = pcall(function()
		panel:Set({ Title = title, Content = text })
	end)
	if not ok then
		warn("[IgnoreBid] Could not update the '" .. title .. "' panel. It said: " .. tostring(text))
	end
end

-- What the current selection is doing.
function IGNOREBID.SetStatus(text)
	IGNOREBID.SetPanel(IGNOREBID.statusLabel, "Item / Rarity Override", text)
end

-- What the last Learn ALL / Delete pass did.
function IGNOREBID.SetLearnStatus(text)
	IGNOREBID.SetPanel(IGNOREBID.learnLabel, "Learned Items", text)
end

-- "Hay, Pearl and 3 more" -- a readable list for the status panel. A raw
-- count ("1 can never be found") does not tell the user WHICH pick is dead,
-- and the one thing they need in order to act on it is the name.
function IGNOREBID.NameList(names, limit)
	table.sort(names)
	local shown = {}
	for i = 1, math.min(#names, limit) do
		table.insert(shown, names[i])
	end
	local text = table.concat(shown, ", ")
	if #names > limit then
		text = text .. " and " .. tostring(#names - limit) .. " more"
	end
	return text
end

-- Fingerprints a list of item names and sorts the outcome into three:
-- fingerprint -> name for the ones that worked, plus the names that have no
-- meshes to match on and the names whose model would not load. Both failures
-- have to reach the UI and not just the console -- either way the user's
-- pick will never fire, and they must be able to see that without reading
-- logs. Blocks until the pass is done, so call it from a spawned thread.
--
-- Loading is dominated by WAITING on assets (measured: 240ms per item cold,
-- 71ms once warm, with no real computation in between), so the work is done
-- by a pool of workers pulling from a shared cursor rather than one at a
-- time. Lua here is cooperative, not truly parallel, so no locking is
-- needed: only one worker runs between yields, and the shared tables are
-- only touched in those gaps.
--
-- `shouldAbort()` is polled between items so a superseded pass can throw its
-- work away; `onProgress(done, total)` drives the status panel.
function IGNOREBID.FingerprintMany(names, shouldAbort, onProgress)
	local targets = {}
	local blind = {}
	local unloadable = {}

	local cursor = 1
	local done = 0
	local liveWorkers = 0
	local WORKER_COUNT = 8

	-- Consecutive load failures across all workers; any success resets it.
	local sinceLoad = 0
	local GIVE_UP_AFTER = 12

	for _ = 1, WORKER_COUNT do
		liveWorkers = liveWorkers + 1
		task.spawn(function()
			while true do
				if not SESSION.alive or shouldAbort() then
					break
				end

				local index = cursor
				cursor = cursor + 1
				if index > #names then
					break
				end

				local itemName = names[index]

				-- Once the game's cache is spent, an uncached name cannot
				-- load and trying costs ~10s of blocking -- so skip straight
				-- to the failure. An already-learned name is unaffected: it
				-- comes from our own cache and never touches GetItem, so a
				-- selection of learned items still prepares normally.
				local fp
				if IGNOREBID.exhausted and IGNOREBID.cache[itemName] == nil then
					fp = nil
				else
					fp = IGNOREBID.FingerprintItem(itemName)
				end

				if fp == false then
					table.insert(blind, itemName)
					sinceLoad = 0
				elseif type(fp) == "string" then
					targets[fp] = itemName
					sinceLoad = 0
				else
					table.insert(unloadable, itemName)

					-- A long unbroken run of load failures is not bad luck,
					-- it is the ItemPreviewCache being full: GetItem then
					-- blocks ~5s and returns nothing for every remaining
					-- item, so a full pass would sit there for twenty
					-- minutes looking frozen. Only a rejoin frees it, so
					-- stop now and say so rather than grinding.
					sinceLoad = sinceLoad + 1
					if sinceLoad >= GIVE_UP_AFTER and not IGNOREBID.exhausted then
						IGNOREBID.exhausted = true
						warn("[IgnoreBid] " .. tostring(GIVE_UP_AFTER)
							.. " items in a row would not load -- the game's item cache is used up. Rejoin to learn any more.")
					end
				end

				done = done + 1
				if done % 25 == 0 then
					onProgress(done, #names)
				end
			end
			liveWorkers = liveWorkers - 1
		end)
	end

	while liveWorkers > 0 do
		task.wait(0.05)
	end

	return targets, blind, unloadable
end

-- Is there anything for the override to watch for at all?
-- `ready` is only ever allowed to be false while this is true: a false
-- `ready` makes Check refuse loudly, and refusing loudly on every auction
-- when the user has selected nothing would be noise, not safety.
function IGNOREBID.HasSelection()
	return next(IGNOREBID.selectedItems) ~= nil or next(IGNOREBID.selectedRarities) ~= nil
end

-- Rebuilds the fingerprint targets after any selection change. Runs in its
-- own thread because a rarity can cover 300 items (~20s of loading); the
-- UI must not freeze. `generation` makes a newer call win: if the user
-- changes the selection mid-prepare, the older pass throws its work away.
--
-- Every call clears `preparing` up front, before anything can return early.
-- That flag guards the buttons, and a pass that is superseded returns
-- without reaching its own cleanup -- so if the flag were only cleared on
-- the way out, one superseded pass would leave it stuck true and the
-- buttons dead for the rest of the session. Clearing on entry means the
-- flag is owned by the newest call and cannot be stranded by an older one.
function IGNOREBID.Rebuild()
	IGNOREBID.generation = IGNOREBID.generation + 1
	local myGeneration = IGNOREBID.generation
	IGNOREBID.preparing = false

	local names = IGNOREBID.CollectTargetNames()

	if #names == 0 then
		IGNOREBID.targets = {}
		IGNOREBID.ready = true
		IGNOREBID.SetStatus("No item or rarity selected -- Min Bid applies normally.")
		return
	end

	IGNOREBID.ready = false

	-- A Learn ALL pass is already walking the whole game, so a second pool
	-- on the same asset pipeline would gain nothing. Stand down; LearnAll
	-- calls back the moment it finishes.
	if IGNOREBID.learning then
		IGNOREBID.SetStatus("Learning every item first -- your picks are prepared right after.")
		return
	end

	IGNOREBID.preparing = true
	IGNOREBID.SetStatus("Preparing " .. tostring(#names) .. " items...")

	task.spawn(function()
		IGNOREBID.LoadCache()

		local targets, blind, unloadable = IGNOREBID.FingerprintMany(
			names,
			function()
				return IGNOREBID.generation ~= myGeneration
			end,
			function(done, total)
				IGNOREBID.SetStatus("Preparing " .. tostring(done) .. "/" .. tostring(total) .. "...")
			end
		)

		-- Superseded: a newer call owns `preparing` now, so do not touch it.
		if not SESSION.alive or IGNOREBID.generation ~= myGeneration then
			return
		end

		IGNOREBID.targets = targets
		IGNOREBID.ready = true
		IGNOREBID.preparing = false
		IGNOREBID.SaveCache()

		local missed = #blind + #unloadable

		-- The failures come FIRST, and they name names. When they were
		-- appended after the count the line read "Watching 10 items." and
		-- that is where the eye stopped -- so Hay, which has no 3D model and
		-- can never be matched, sat in that ten looking armed. A pick that
		-- will never fire has to be the loudest thing in the panel.
		local status = ""
		if #blind > 0 then
			status = "CAN NEVER BE FOUND (no 3D model): "
				.. IGNOREBID.NameList(blind, 4) .. ". "
		end
		if #unloadable > 0 then
			if IGNOREBID.exhausted then
				status = status .. "NOT LEARNED YET: " .. IGNOREBID.NameList(unloadable, 4)
					.. " -- rejoin, then press Learn ALL Items. "
			else
				status = status .. "NO USABLE MODEL: "
					.. IGNOREBID.NameList(unloadable, 4) .. ". "
			end
		end
		status = status .. "Watching " .. tostring(#names - missed)
			.. " of " .. tostring(#names) .. " items."
		if #blind > 0 then
			warn("[IgnoreBid] No 3D model, will never be detected: " .. table.concat(blind, ", "))
		end
		if #unloadable > 0 then
			warn("[IgnoreBid] No usable model in the game, cannot be detected: " .. table.concat(unloadable, ", "))
		end

		IGNOREBID.SetStatus(status)
		DebugPrint("[IgnoreBid] Ready: " .. tostring(#names - missed) .. " watched, " .. tostring(missed) .. " undetectable")
	end)
end

-- Learn every item in the game in one deliberate pass.
--
-- Why this button exists. Learning an item means asking ItemLoader for its
-- model, and every such call pushes an entry into
-- PlayerGui.ItemPreviewCache -- the very cache the inventory draws its item
-- icons from. That cache is capped (~141 entries observed), so filling it
-- evicts the game's own models and the inventory icons go blank until the
-- player rejoins. Destroying only our own entries was tried and did not
-- help, so the damage is the insertion itself and no cleanup can undo it.
-- What we CAN do is stop paying it over and over: a learned item is written
-- to disk and never learned again, so learning all of them at once costs one
-- rejoin, where drip-feeding a few per new pick costs a rejoin every time.
--
-- Already-learned items are skipped, so a second press only picks up
-- whatever failed the first time and is nearly free.
--
-- A prepare in flight is superseded rather than refused. Refusing meant the
-- button did nothing visible for however long the prepare ran, which reads
-- as broken and gets clicked five more times. Pressing it always starts a
-- pass; the selection is prepared again at the end anyway.
function IGNOREBID.LearnAll()
	if IGNOREBID.learning then
		IGNOREBID.SetLearnStatus("Already learning -- one press is enough. Progress is shown here.")
		return
	end

	-- Every item left to learn is one that is not cached, and once the
	-- game's cache is spent none of them can load. Say so instantly instead
	-- of spending 20 minutes proving it again.
	if IGNOREBID.exhausted then
		IGNOREBID.SetLearnStatus("Rejoin first -- the game's item cache is used up, so nothing more can be learned this session.")
		return
	end

	IGNOREBID.learning = true
	IGNOREBID.generation = IGNOREBID.generation + 1
	IGNOREBID.preparing = false
	if IGNOREBID.HasSelection() then
		IGNOREBID.ready = false
	end
	IGNOREBID.SetLearnStatus("Starting...")

	task.spawn(function()
		IGNOREBID.LoadCache()

		local names = {}
		for _, itemName in ipairs(ALL_ITEM_NAMES) do
			if IGNOREBID.cache[itemName] == nil then
				table.insert(names, itemName)
			end
		end

		if #names == 0 then
			IGNOREBID.learning = false
			IGNOREBID.SetLearnStatus("All " .. tostring(#ALL_ITEM_NAMES)
				.. " items already learned. Nothing to do.")
			IGNOREBID.Rebuild()
			return
		end

		IGNOREBID.SetLearnStatus("Learning 0/" .. tostring(#names)
			.. ". Icons go blank -- rejoin afterwards.")

		local startedAt = os.clock()
		local _, blind, unloadable = IGNOREBID.FingerprintMany(
			names,
			function()
				return false
			end,
			function(done, total)
				IGNOREBID.SetLearnStatus("Learning " .. tostring(done) .. "/" .. tostring(total) .. "...")
			end
		)

		IGNOREBID.learning = false
		IGNOREBID.SaveCache()

		if not SESSION.alive then
			return
		end

		local elapsed = string.format("%.0f", os.clock() - startedAt)
		local status = "Learned " .. tostring(#names - #unloadable) .. "/" .. tostring(#names)
			.. " in " .. elapsed .. "s."
		if #blind > 0 then
			status = status .. " " .. tostring(#blind) .. " have no 3D model."
		end
		if IGNOREBID.exhausted then
			-- Stopped short, not finished. Saying "press again to retry"
			-- here would be a lie: nothing more can load until a rejoin.
			status = status .. " Stopped early: the game's item cache is used up."
		elseif #unloadable > 0 then
			status = status .. " " .. tostring(#unloadable) .. " failed -- press again to retry."
			warn("[IgnoreBid] Would not load, still unlearned: " .. table.concat(unloadable, ", "))
		end
		status = status .. " Rejoin, then press Learn ALL again."

		IGNOREBID.SetLearnStatus(status)
		DebugPrint("[IgnoreBid] Learn ALL finished in " .. elapsed .. "s")

		-- Everything the selection needs is cached now, so this is instant.
		IGNOREBID.Rebuild()
	end)
end

-- Throw away everything learned, so it can be learned again from scratch.
-- Both halves have to go: the copy in memory and the file on disk. If the
-- file survives we say so loudly rather than reporting success -- it would
-- quietly come back on the next session and undo this.
--
-- Deliberately does NOT rebuild afterwards. Rebuilding would immediately
-- re-learn whatever is selected, which is the drip-fed icon damage the
-- Learn ALL button exists to avoid -- and doing it one second after the
-- user asked to delete everything is the last thing they meant. Instead the
-- selection is left unprepared with `ready` false, so the override refuses
-- out loud until Learn ALL is pressed.
function IGNOREBID.ForgetAll()
	if IGNOREBID.learning then
		IGNOREBID.SetLearnStatus("Learning right now. Let it finish, then delete.")
		return
	end

	-- Kill any prepare in flight: its results are about to be meaningless.
	IGNOREBID.generation = IGNOREBID.generation + 1
	IGNOREBID.preparing = false

	IGNOREBID.cache = {}
	IGNOREBID.cacheDirty = false
	IGNOREBID.cacheLoaded = true
	IGNOREBID.targets = {}

	local cleared = false
	local why = ""

	if type(delfile) == "function" and type(isfile) == "function" then
		local ok, err = pcall(function()
			if isfile(IGNOREBID.CACHE_FILE) then
				delfile(IGNOREBID.CACHE_FILE)
			end
		end)
		cleared = ok
		why = tostring(err)
	elseif type(writefile) == "function" then
		-- No delete in this executor. Emptying the file reaches the same end
		-- state, and it is written down here rather than passed off as a
		-- deletion.
		local ok, err = pcall(function()
			writefile(IGNOREBID.CACHE_FILE, "{}")
		end)
		cleared = ok
		why = tostring(err)
	else
		why = "this executor has no file API"
	end

	local status
	if cleared then
		status = "Deleted. Nothing is learned any more."
		DebugPrint("[IgnoreBid] Fingerprint cache cleared")
	else
		warn("[IgnoreBid] Could not delete " .. IGNOREBID.CACHE_FILE .. ": " .. why)
		status = "Cleared for now, but the file would NOT delete (" .. why .. "). See console."
	end

	if IGNOREBID.HasSelection() then
		IGNOREBID.ready = false
		IGNOREBID.SetStatus("Nothing is learned -- press Learn ALL Items.")
		status = status .. " Your picks are unarmed until you press Learn ALL."
	else
		IGNOREBID.ready = true
	end

	-- Learning already ran this session, so the game's item cache is spent
	-- and a fresh pass cannot load anything. Better said here than
	-- discovered as a frozen-looking progress bar.
	if IGNOREBID.exhausted then
		status = status .. " Rejoin before learning again."
	end

	IGNOREBID.SetLearnStatus(status)
end


-- Returns (true, itemName) if the garage visibly contains a targeted item.
-- Boxed items are invisible to this by design: a box is one of the 6 items
-- wearing a disguise, and its identity is not on the client before the win.
function IGNOREBID.Check(garage)
	-- Readiness is checked BEFORE the empty-target shortcut on purpose: a
	-- selection that is still being prepared has no targets yet, and falling
	-- through the shortcut would make that look like "nothing selected" and
	-- pass in silence.
	if not IGNOREBID.ready then
		warn("[IgnoreBid] Still preparing item fingerprints -- NOT applying the override for this auction")
		return false, nil
	end

	if next(IGNOREBID.targets) == nil then
		return false, nil
	end

	garage = ResolveNearbyGarage(garage)
	if not garage then
		warn("[IgnoreBid] Garage not resolved, Min Bid applies normally")
		return false, nil
	end

	local floorspace = garage:FindFirstChild("Floorspace")
	if not floorspace then
		warn("[IgnoreBid] Floorspace not found in " .. tostring(garage.Name))
		return false, nil
	end

	for _, model in ipairs(floorspace:GetChildren()) do
		local fp = IGNOREBID.Fingerprint(model)
		if fp ~= "" then
			local hit = IGNOREBID.targets[fp]
			if hit then
				return true, hit
			end
		end
	end

	return false, nil
end

-- Item def by name, for resolving a fingerprinted bid item into the same
-- shape sell/place/grade already get from GetCarryableItemDef. Reuses the
-- ItemsByName index GetCarryableItemDef lazily builds -- one catalog lookup
-- table, not two copies that could drift apart.
function RULES.ItemDefByName(name)
	if not ItemsByName then
		ItemsByName = {}
		for _, def in pairs(Items) do
			if type(def) == "table" and type(def.Name) == "string" then
				ItemsByName[def.Name] = def
			end
		end
	end
	return ItemsByName[name]
end

-- Every item name ONE rule's identity criteria could mean: names picked
-- directly, plus every item in a picked category, rarity or Is-box trait.
-- Same cost the legacy Ignore Min Bid list already pays for a rarity pick
-- (IGNOREBID.CollectTargetNames) -- one pass over the Items catalog, only
-- when the rule actually asks for one of those rows. Shared by
-- RULES.CollectBidIdentityNames (unions this across every armed bid rule)
-- and RULES.BidUnmatched (checks one rule's own picks against what mesh
-- matching actually resolved).
function RULES.NamesForRule(rule)
	local names, seen = {}, {}
	local function add(name)
		if not seen[name] then
			seen[name] = true
			table.insert(names, name)
		end
	end

	for name in pairs(rule.names) do
		add(name)
	end

	local anyCategory = RULES.AnySet(rule.categories)
	local anyRarity = RULES.AnySet(rule.rarities)
	local anyTrait = RULES.AnySet(rule.traits)
	if anyCategory or anyRarity or anyTrait then
		for _, def in pairs(Items) do
			if type(def) == "table" and type(def.Name) == "string" then
				local hit = anyCategory and def.Category ~= nil and rule.categories[def.Category]
				if not hit and anyRarity then
					hit = rule.rarities[def.Rarity or "Uncommon"]
				end
				if not hit and anyTrait then
					local traits = RULES.TraitsFor(def, nil)
					for trait in pairs(rule.traits) do
						if traits[trait] then
							hit = true
							break
						end
					end
				end
				if hit then
					add(def.Name)
				end
			end
		end
	end

	return names
end

-- Every item name a currently armed "Ignore Min Bid" rule could need
-- identified, unioned across every such rule.
function RULES.CollectBidIdentityNames()
	local names, seen = {}, {}
	for i = 1, RULES.COUNT do
		local rule = RULES.rules[i]
		if rule.effects["Ignore Min Bid"] and RULES.RuleIsArmed(rule) then
			for _, name in ipairs(RULES.NamesForRule(rule)) do
				if not seen[name] then
					seen[name] = true
					table.insert(names, name)
				end
			end
		end
	end
	return names
end

-- Of THIS rule's own name/category/rarity/trait picks, which ones the last
-- mesh-fingerprint pass could not resolve -- split the same way the Auction
-- tab's Learned Items panel splits them: no 3D model at all (never fixable)
-- vs. not learned yet (the game's item cache ran dry mid-pass; a rejoin and
-- a re-save fix it). Empty while a pass is still running -- callers should
-- check RULES.bidFp.preparing first, or this can under-report mid-pass.
function RULES.BidUnmatched(i)
	local rule = RULES.rules[i]
	local blind, unloadable = {}, {}
	if not rule.effects["Ignore Min Bid"] then
		return blind, unloadable
	end
	for _, name in ipairs(RULES.NamesForRule(rule)) do
		if RULES.bidFp.blind[name] then
			table.insert(blind, name)
		elseif RULES.bidFp.unloadable[name] then
			table.insert(unloadable, name)
		end
	end
	return blind, unloadable
end

-- Rebuilds the bid lane's fingerprint -> name lookup after a rule change.
-- Reuses IGNOREBID.FingerprintMany, so a name already learned for the
-- legacy Ignore Min Bid list costs nothing here, and learning it here feeds
-- that list too -- one on-disk cache, two consumers. Runs in its own
-- thread; `generation` lets a newer edit cancel a stale pass, same pattern
-- as IGNOREBID.Rebuild. `RULES.bidFp.fpToName` is only ever overwritten by
-- the winning generation's final assignment, so a rule check running mid
-- rebuild just keeps reading the last complete map -- never a torn one.
function RULES.RebuildBidFp()
	RULES.bidFp.generation = RULES.bidFp.generation + 1
	local myGeneration = RULES.bidFp.generation
	RULES.bidFp.dirty = false

	local names = RULES.CollectBidIdentityNames()
	if #names == 0 then
		RULES.bidFp.fpToName = {}
		RULES.bidFp.blind = {}
		RULES.bidFp.unloadable = {}
		RULES.bidFp.preparing = false
		return
	end

	RULES.bidFp.preparing = true
	-- Reflect the new preparing=true state immediately if the editor is open,
	-- instead of leaving whatever it last showed (nothing, or a stale result)
	-- on screen while this pass runs.
	if RULES.ED and RULES.ED.gui then
		RULES.ED.Render()
	end
	task.spawn(function()
		IGNOREBID.LoadCache()
		local targets, blind, unloadable = IGNOREBID.FingerprintMany(names, function()
			return RULES.bidFp.generation ~= myGeneration
		end, function() end)

		if RULES.bidFp.generation ~= myGeneration then
			return
		end
		RULES.bidFp.preparing = false
		RULES.bidFp.fpToName = targets
		IGNOREBID.SaveCache()

		local blindSet, unloadableSet = {}, {}
		for _, name in ipairs(blind) do
			blindSet[name] = true
		end
		for _, name in ipairs(unloadable) do
			unloadableSet[name] = true
		end
		RULES.bidFp.blind = blindSet
		RULES.bidFp.unloadable = unloadableSet

		local resolved = 0
		for _ in pairs(targets) do
			resolved = resolved + 1
		end
		if resolved > 0 then
			print("[Rules] Ignore Min Bid can now identify " .. tostring(resolved) .. " item(s) by mesh during an auction.")
		end
		-- Same two failure classes IGNOREBID.Rebuild already warns about, so
		-- a name that can never fire a bid rule is never silent about it.
		if #blind > 0 then
			warn("[Rules] No 3D model, an Ignore Min Bid rule naming these will never fire on them: "
				.. IGNOREBID.NameList(blind, 6))
		end
		if #unloadable > 0 then
			if IGNOREBID.exhausted then
				warn("[Rules] Not learned yet (item cache exhausted this session, rejoin then re-save the rule): "
					.. IGNOREBID.NameList(unloadable, 6))
			else
				warn("[Rules] Could not load a model for an Ignore Min Bid pick just now, will retry on the next save: "
					.. IGNOREBID.NameList(unloadable, 6))
			end
		end

		-- Pass finished while the editor may still be showing "still learning
		-- meshes now" -- replace it with the real per-rule result.
		if RULES.ED and RULES.ED.gui then
			RULES.ED.Render()
		end
	end)
end

-- Kicks the pass above the moment a rule actually needs it, instead of
-- waiting for a live auction to stumble into RULES.CheckGarage. Without
-- this, a rule loaded from a config slot (never edited this session) or just
-- saved from the editor sits with an empty bidFp.blind/unloadable until the
-- player happens to bid near a garage -- which the editor cannot tell apart
-- from "fully resolved, nothing to warn about". Cheap to call often: it is a
-- no-op whenever nothing is dirty, nothing is armed, or a pass is already running.
function RULES.MaybeRebuildBidFp()
	if RULES.bidFp.dirty and not RULES.bidFp.preparing and RULES.LaneArmed("bid") then
		RULES.RebuildBidFp()
	end
end

-- The Item Rules version of FORCEBID/IGNOREBID's veto-on-veto, evaluated per
-- Floorspace model. Returns true plus a description as soon as one item in
-- the garage matches a rule carrying "Ignore Min Bid".
--
-- Mutators and Condition always leak through a Floorspace model, so a bid
-- rule matching on mutation or Mint always works. Name, category, rarity
-- and Is-box traits used to be a hard "never" too, because the game STRIPS
-- the item name from the model (they are all literally called "Model" until
-- the auction resolves) -- but IGNOREBID already defeats exactly that with
-- learned mesh fingerprints, so a bid rule now resolves the same way: fetch
-- the model's fingerprint, look it up in RULES.bidFp.fpToName (built by
-- RULES.RebuildBidFp from every armed bid rule's own names/categories/
-- rarities/traits), and hand RULES.Decide the full identity when it hits.
-- Two things stay genuinely unfixable, both structural: a BOXED item has no
-- mesh of its own before the win, and value/weight/buff% are never on the
-- client pre-win for any item -- RULES.BidBlind still warns about those.
function RULES.CheckGarage(garage)
	if not RULES.LaneArmed("bid") then
		return false, nil
	end

	if RULES.bidFp.dirty then
		RULES.RebuildBidFp()
	end

	garage = ResolveNearbyGarage(garage)
	if not garage then
		warn("[Rules] Garage not resolved, Min Bid applies normally")
		return false, nil
	end

	local floorspace = garage:FindFirstChild("Floorspace")
	if not floorspace then
		warn("[Rules] Floorspace not found in " .. tostring(garage.Name))
		return false, nil
	end

	for _, item in ipairs(floorspace:GetChildren()) do
		local name = nil
		local fp = IGNOREBID.Fingerprint(item)
		if fp ~= "" then
			name = RULES.bidFp.fpToName[fp]
		end
		local itemDef = name and RULES.ItemDefByName(name) or nil

		local verdict = RULES.Decide("bid", {
			name = name,
			category = itemDef and itemDef.Category or nil,
			rarity = itemDef and itemDef.Rarity or nil,
			traits = itemDef and RULES.TraitsFor(itemDef, nil) or nil,
			mutations = ReadMutatorNames(item),
			condition = item:GetAttribute("Condition"),
		})
		if verdict == "force" then
			return true, "rule " .. tostring(RULES.lastRule)
		end
	end

	return false, nil
end

