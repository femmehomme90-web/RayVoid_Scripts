-- ---------------------------------------------------------
-- SAVE STORAGE. One hidden Input (Flag ItemRulesData) holds the whole rule
-- list as one JSON array -- see RULES.SerializeAll above for why. Hidden,
-- because it holds machine-written JSON and there is nothing useful a
-- person can do by typing into it -- but it is a real RayVoid Input with a
-- real Flag, which is the whole point: that is what makes the list travel
-- inside the user's saved config slots.
--
-- The OLD eight (Rule1Data..Rule8Data) stay, unused for new saves, purely
-- so a slot saved before this flag existed still hands its rules to the
-- script -- see RULES.MigrateLegacy. Dropping them would silently lose
-- every rule in every config slot saved so far, exactly the "renamed Flag"
-- mistake this project has been burned by before.
-- ---------------------------------------------------------
RULES.dataInputs = {}
RULES.hiddenInstances = {}

-- Staged legacy text, and the merge that turns it into RULES.rules. Every
-- one of the eight old flags can fire in the same synchronous burst (a
-- config slot loading all its flags at once), so a single legacy callback
-- cannot tell whether it is the only one -- RULES.legacyMergeScheduled is
-- what makes the FIRST one in a burst clear stale state from whatever slot
-- was loaded before it, and the deferred check run exactly once after all
-- of them (and ItemRulesData's own callback) have landed.
RULES.legacyText = {}
RULES.legacyMergeScheduled = false

function RULES.RecordLegacyText(ruleIndex, text)
	if not RULES.legacyMergeScheduled then
		-- Starting a fresh burst: drop whatever a DIFFERENT slot's load
		-- left in here, or migration could stitch two slots' rules together.
		RULES.legacyText = {}
		RULES.legacyMergeScheduled = true
		task.defer(function()
			RULES.legacyMergeScheduled = false
			-- Read the CURRENT flag value, not a cached boolean: on a live
			-- slot switch (not just autoload) this same code path runs
			-- again for whichever slot is now active, and only the live
			-- value tells us if THAT slot already has ItemRulesData.
			local blobFlag = Ui.Flags and Ui.Flags["ItemRulesData"]
			local blobText = blobFlag and blobFlag.CurrentValue
			if type(blobText) == "string" and blobText ~= "" then
				-- Even "[]" counts: it means this slot was already
				-- migrated to zero rules on purpose, not never touched.
				return
			end
			if RULES.MigrateLegacy(RULES.legacyText) then
				RULES.SaveAll()
				RULES.RefreshSummary()
				if RULES.ED and RULES.ED.gui then
					RULES.ED.Render()
				end
				print("[Rules] Migrated " .. #RULES.rules ..
					" rule(s) from the old per-slot save format. Save this config slot to keep it.")
			end
		end)
	end
	RULES.legacyText[ruleIndex] = text
end

for ruleIndex = 1, RULES.LEGACY_COUNT do
	local beforeBuild = RULES.PageChildSet()
	RULES.dataInputs[ruleIndex] = ItemRulesTab:CreateInput({
		Name = "Rule " .. ruleIndex .. " (saved data, old format)",
		CurrentValue = "",
		PlaceholderText = "managed by the rule editor",
		Flag = "Rule" .. ruleIndex .. "Data",
		RemoveTextAfterFocusLost = false,
		Callback = function(Text)
			RULES.RecordLegacyText(ruleIndex, Text)
		end,
	})
	if RULES.page then
		for _, child in ipairs(RULES.page:GetChildren()) do
			if not beforeBuild[child] then
				table.insert(RULES.hiddenInstances, child)
			end
		end
	end
end

do
	local beforeBuild = RULES.PageChildSet()
	RULES.allDataInput = ItemRulesTab:CreateInput({
		Name = "Item Rules (saved data)",
		CurrentValue = "",
		PlaceholderText = "managed by the rule editor",
		Flag = "ItemRulesData",
		RemoveTextAfterFocusLost = false,
		Callback = function(Text)
			if RULES.saving then
				-- Our own write, echoing back. The live rules are already right.
				return
			end
			RULES.DeserializeAll(Text)
			RULES.RefreshSummary()
			-- A config slot load arrives through here, so the window redraws
			-- if it happens to be open.
			if RULES.ED and RULES.ED.gui then
				RULES.ED.Render()
			end
		end,
	})
	if RULES.page then
		for _, child in ipairs(RULES.page:GetChildren()) do
			if not beforeBuild[child] then
				table.insert(RULES.hiddenInstances, child)
			end
		end
	end
end

for _, instance in ipairs(RULES.hiddenInstances) do
	pcall(function()
		instance.Visible = false
	end)
end

-- Writing the whole list back so the config slot picks it up. The flag
-- entry IS the settings table RayVoid snapshots (verified against the
-- library source 2026-09-12: RayfieldLibrary.Flags[InputSettings.Flag] =
-- InputSettings), so setting CurrentValue there is what makes the list
-- survive a slot save. The control's own :Set is tried first where it
-- exists, and neither path is allowed to throw.
function RULES.SaveAll()
	local text = RULES.SerializeAll()
	local control = RULES.allDataInput
	-- Writing the box fires its own Callback, which calls DeserializeAll and
	-- REPLACES the live list with one built from the text. That is right
	-- when the text came from a config slot and catastrophic when it came
	-- from us: an edit still in progress would be thrown away between
	-- keystrokes. The callback is only allowed to rebuild when the change
	-- came from outside.
	RULES.saving = true
	if control and control.Set then
		pcall(function()
			control:Set(text)
		end)
	end
	pcall(function()
		local flag = Ui.Flags and Ui.Flags["ItemRulesData"]
		if flag then
			flag.CurrentValue = text
		end
	end)
	RULES.saving = false
	RULES.RefreshSummary()
end

-- Every per-field edit in the editor window (label, effects, names,
-- setups...) calls RULES.Save(RULES.ED.current) after changing that one
-- rule. The whole list is one blob now, so saving any single rule means
-- re-serializing all of them -- kept under the old name so none of those
-- (many) call sites needed to change.
function RULES.Save(i)
	RULES.SaveAll()
end

-- Add / remove a rule slot. The editor window calls these directly; nothing
-- else needs to touch RULES.rules' length.
function RULES.AddRule()
	table.insert(RULES.rules, RULES.NewRule())
	RULES.COUNT = #RULES.rules
	RULES.SaveAll()
	return RULES.COUNT
end

function RULES.RemoveRuleAt(i)
	if i < 1 or i > #RULES.rules then
		return
	end
	table.remove(RULES.rules, i)
	RULES.EnsureAtLeastOneRule()
	RULES.SaveAll()
end

