-- =========================================================
-- ITEM INFO (last tab) -- read-only lookup over Modules.Items: each item's
-- Name/Category/Rarity/BasePrice/Weight and where it drops (EventExclusive
-- / Area(s) / Garages / SafeId / EnergyDrinkId / Interactive), plus flags
-- (Limited, PoliceExclusive, NoMarket, MinimumNetWorth, RequiresQuestUnlock,
-- SlotType, CarPart, storage crate, attribute-multiplier range). Rarity
-- colours come from Modules.Rarities (a colour table, useful here).
-- =========================================================
local ITEMINFO = {}

-- A function, NOT a plain do-block, on purpose. Luau allows 200 locals alive
-- at once in the main chunk, and a do-block's locals count on top of every
-- root local; this block sat at exactly 200 and the next root local added
-- anywhere above broke the whole script ("Out of local registers when trying
-- to allocate a: exceeded limit 200", 2026-10-13). Inside a function its
-- locals are its own.
function ITEMINFO.Build()
	local RarityColors = SafeRequire(ReplicatedStorage.Modules.Rarities, "Rarities") or {}

	local function hex(rarity)
		local entry = RarityColors[rarity]
		local col = type(entry) == "table" and entry.Color
		if typeof(col) == "Color3" then
			return string.format("#%02X%02X%02X",
				math.clamp(math.floor(col.R * 255 + 0.5), 0, 255),
				math.clamp(math.floor(col.G * 255 + 0.5), 0, 255),
				math.clamp(math.floor(col.B * 255 + 0.5), 0, 255))
		end
		return "#DDDDDD"
	end

	local function money(n)
		n = math.floor((tonumber(n) or 0) + 0.5)
		local s = tostring(n)
		while true do
			local s2, k = s:gsub("^(%-?%d+)(%d%d%d)", "%1,%2")
			s = s2
			if k == 0 then break end
		end
		return "$" .. s
	end

	local function asList(v)
		local t = {}
		if type(v) == "table" then
			for _, x in ipairs(v) do
				t[#t + 1] = tostring(x)
			end
		elseif v ~= nil then
			t[1] = tostring(v)
		end
		return t
	end

	local defByName = {}
	for _, def in pairs(Items) do
		SESSION.Breathe()
		if type(def) == "table" and type(def.Name) == "string" then
			defByName[def.Name] = def
		end
	end

	-- (title, content) for the "Item Lookup" paragraph. RichText.
	function ITEMINFO.Describe(name)
		local def = defByName[name]
		if not def then
			return "Item", "Unknown item."
		end
		local rarity = def.Rarity or "Uncommon"
		local col = hex(rarity)
		local title = string.format('<font color="%s"><b>%s</b></font>', col, name)

		local L = {}
		L[#L + 1] = string.format('%s    <font color="%s"><b>%s</b></font>    %s    %s kg',
			tostring(def.Category or "?"), col, rarity, money(def.BasePrice), tostring(def.Weight or "?"))
		L[#L + 1] = "<i>Base value only - the real price also depends on condition, grade and mutations.</i>"
		L[#L + 1] = ""
		L[#L + 1] = "<b>WHERE IT DROPS</b>"

		local any = false
		if def.EventExclusive then
			any = true
			L[#L + 1] = "- Event only: <b>" .. tostring(def.EventExclusive) .. "</b> (spawns while that event runs)"
		end
		local areas = asList(def.Area)
		if #areas > 0 then
			any = true
			L[#L + 1] = "- Area" .. (#areas > 1 and "s" or "") .. ": " .. table.concat(areas, ", ")
		end
		local garages = asList(def.Garages)
		if #garages > 0 then
			any = true
			L[#L + 1] = "- Garage types: " .. table.concat(garages, ", ")
		elseif #areas > 0 then
			L[#L + 1] = "- Garage types: any garage in the area" .. (#areas > 1 and "s" or "")
		end
		if def.SafeId ~= nil then
			any = true
			L[#L + 1] = "- From safes (Locksmith / Vault)"
		end
		if def.EnergyDrinkId ~= nil then
			any = true
			L[#L + 1] = "- Bought at the Energy Drink shop"
		end
		if def.Interactive == "FishingRod" then
			any = true
			L[#L + 1] = "- It is a fishing rod (equip it and fish)"
		end
		if rarity == "Lost" then
			any = true
			L[#L + 1] = "- Lost and Found box"
		end
		if not any then
			L[#L + 1] = "- Not a garage drop (quest reward, shop, fishing catch, or event-only)"
		end

		local notes = {}
		if def.Limited then
			notes[#notes + 1] = "Limited - timed-event item (e.g. Alien Invasion)"
		end
		if def.PoliceExclusive then
			notes[#notes + 1] = "Police event exclusive"
		end
		if def.NoMarket then
			notes[#notes + 1] = "Cannot be listed for sale on a shelf"
		end
		if def.MinimumNetWorth then
			notes[#notes + 1] = "Needs Net Worth of at least " .. money(def.MinimumNetWorth)
		end
		if type(def.RequiresQuestUnlock) == "table" then
			local rq = def.RequiresQuestUnlock
			if rq.NPC then
				notes[#notes + 1] = "Unlocked by " .. tostring(rq.NPC) .. "'s quest (level " .. tostring(rq.Level or "?") .. ")"
			elseif rq.Flag then
				notes[#notes + 1] = "Unlocked by quest progress (" .. tostring(rq.Flag) .. ")"
			end
		end
		if def.SlotType then
			notes[#notes + 1] = "Wearable accessory (" .. tostring(def.SlotType) .. " slot)"
		end
		if def.CarPart then
			notes[#notes + 1] = "Vehicle part" .. (def.VehiclePartSlot and (" - " .. tostring(def.VehiclePartSlot)) or "")
		end
		if def.IsStorageCrate then
			notes[#notes + 1] = "Storage crate (holds other items)"
		end
		if type(def.CrateCapacityRange) == "table" then
			notes[#notes + 1] = "Crate capacity: " .. tostring(def.CrateCapacityRange.min) .. " - " .. tostring(def.CrateCapacityRange.max)
		end
		if type(def.AttributeMultiplierRange) == "table" then
			notes[#notes + 1] = "Star roll: x" .. tostring(def.AttributeMultiplierRange.min)
				.. " to x" .. tostring(def.AttributeMultiplierRange.max) .. " of base value"
		end
		if #notes > 0 then
			L[#L + 1] = ""
			L[#L + 1] = "<b>NOTES</b>"
			for _, n in ipairs(notes) do
				L[#L + 1] = "- " .. n
			end
		end

		return title, table.concat(L, "\n")
	end

	-- Reverse index: "Area: X" / "Garage: X" / "Event: X" -> item list.
	local locSet = {}
	for _, def in pairs(Items) do
		SESSION.Breathe()
		if type(def) == "table" and type(def.Name) == "string" then
			for _, a in ipairs(asList(def.Area)) do
				locSet["Area: " .. a] = true
			end
			for _, g in ipairs(asList(def.Garages)) do
				locSet["Garage: " .. g] = true
			end
			if def.EventExclusive then
				locSet["Event: " .. tostring(def.EventExclusive)] = true
			end
		end
	end
	ITEMINFO.LOCATIONS = {}
	for k in pairs(locSet) do
		table.insert(ITEMINFO.LOCATIONS, k)
	end
	table.sort(ITEMINFO.LOCATIONS)

	local RARITY_RANK = { Junk = 0, Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5, Mythical = 6, Lost = 7 }

	function ITEMINFO.ItemsAt(loc)
		local kind, val = tostring(loc):match("^(%a+):%s*(.+)$")
		if not kind then
			return "Pick a location above."
		end
		local hits = {}
		for _, def in pairs(Items) do
			if type(def) == "table" and type(def.Name) == "string" then
				local match = false
				if kind == "Area" then
					for _, a in ipairs(asList(def.Area)) do
						if a == val then match = true break end
					end
				elseif kind == "Garage" then
					for _, g in ipairs(asList(def.Garages)) do
						if g == val then match = true break end
					end
				elseif kind == "Event" then
					match = (tostring(def.EventExclusive) == val)
				end
				if match then
					hits[#hits + 1] = def
				end
			end
		end
		if #hits == 0 then
			return "No items found for " .. tostring(loc)
		end
		table.sort(hits, function(a, b)
			local ra, rb = RARITY_RANK[a.Rarity] or 2, RARITY_RANK[b.Rarity] or 2
			if ra ~= rb then
				return ra > rb
			end
			return a.Name < b.Name
		end)
		local CAP = 70
		local lines = { "<b>" .. #hits .. " item(s) at " .. tostring(loc) .. "</b>", "" }
		for i, def in ipairs(hits) do
			if i > CAP then
				lines[#lines + 1] = "<i>... and " .. (#hits - CAP) .. " more - pick a garage type to narrow it down.</i>"
				break
			end
			lines[#lines + 1] = string.format('<font color="%s">%s</font>   <i>%s</i>   %s',
				hex(def.Rarity or "Uncommon"), def.Name, tostring(def.Rarity or "?"), money(def.BasePrice))
		end
		return table.concat(lines, "\n")
	end
end
ITEMINFO.Build()

ItemInfoTab:CreateSection("Item Lookup")

ITEMINFO.paragraph = ItemInfoTab:CreateRichParagraph({
	Title = "Item",
	Content = "Pick an item below, or type in the Search box.",
})

ITEMINFO.dropdown = ItemInfoTab:CreateDropdown({
	Name = "Item",
	Options = SESSION.CapList(ALL_ITEM_NAMES),
	CurrentOption = {},
	MultipleOptions = false,
	Flag = "ItemInfoDropdown",
	Callback = function(selected)
		local name = type(selected) == "table" and selected[1] or selected
		if type(name) ~= "string" or name == "" or SESSION.IsHint(name) then
			return
		end
		local ok, title, content = pcall(ITEMINFO.Describe, name)
		if ok then
			ITEMINFO.paragraph:Set({ Title = title, Content = content })
		else
			ITEMINFO.paragraph:Set({ Title = "Item", Content = "Could not read this item: " .. tostring(title) })
		end
	end,
})

CreateSearchBox(ItemInfoTab, ITEMINFO.dropdown, ALL_ITEM_NAMES,
	"ItemInfoSearch", "e.g. rolex, katana, cheese slice...")

ItemInfoTab:CreateSection("Browse by Location")

ITEMINFO.locParagraph = ItemInfoTab:CreateRichParagraph({
	Title = "Location",
	Content = "Pick an area, garage type or event to list every item that drops there.",
})

ITEMINFO.locDropdown = ItemInfoTab:CreateDropdown({
	Name = "Location",
	Options = SESSION.CapList(ITEMINFO.LOCATIONS),
	CurrentOption = {},
	MultipleOptions = false,
	Flag = "ItemInfoLocationDropdown",
	Callback = function(selected)
		local loc = type(selected) == "table" and selected[1] or selected
		if type(loc) ~= "string" or loc == "" or SESSION.IsHint(loc) then
			return
		end
		local ok, content = pcall(ITEMINFO.ItemsAt, loc)
		ITEMINFO.locParagraph:Set({ Title = "Location", Content = ok and content or ("Error: " .. tostring(content)) })
	end,
})

CreateSearchBox(ItemInfoTab, ITEMINFO.locDropdown, ITEMINFO.LOCATIONS,
	"ItemInfoLocationSearch", "e.g. power plant, alien garage, police...")

ItemInfoTab:CreateLabel("All " .. #ALL_ITEM_NAMES .. " items in the game, with the game's own "
	.. "values. Looking things up here changes nothing.")

-- Every tab, toggle and table exists from here on. A saved config / backup
-- loading at launch waits for this before flipping anything.
SESSION.built = true

-- =========================================================
-- UNLOAD HANDLE (dev reload) -- keep this LAST in the file
-- =========================================================
-- Registered only now, once every table, listener and UI object it touches
-- exists. The handshake at the top of the file calls it when this file is
-- re-executed, so a reload never doubles the UI, the listeners or the
-- loops. Order matters: flags first (loops exit on their next iteration),
-- listeners next (no more events into a dead instance), UI last.
--
-- `selfOnly` is the losing side of a simultaneous start (see the token
-- check below). It skips the two steps that reach outside this run:
-- DestroyAll would sweep the WINNER's window out of CoreGui, and clearing
-- getgenv().StorageHunters would erase the winner's handle.
do
	SESSION.Unload = function(selfOnly)
		SESSION.alive = false

		-- 1. Every loop flag off.
		for key in pairs(LOOPGUARDS) do
			LOOPGUARDS[key] = false
		end
		FARM.active = false
		COLLECT.active = false
		AUCTION.bidActive = false
		AUCTION.winActive = false
		OFFERS.autoAccept = false
		WASHGRADE.washActive = false
		WASHGRADE.gradeActive = false
		WASHGRADE.gradeVaultActive = false
		AUTOVAULT.active = false
		ENERGYDRINK.autoBuyEnabled = false
		ENERGYDRINK.autoUseEnabled = false
		AUTOSELL.enabled = false
		AUTOFISH.active = false
		AUTOMUSEUM.active = false
		AUTOREPAIR.active = false
		URANIUM.active = false
		URANIUM.spray = false
		TCAPSULE.active = false
		POWERPLANT.active = false
		TRAINQUEST.active = false
		LOSTITEMS.active = false
		MOVE.StopAll()
		QUEST.active = false
		COLLECTORKEEP.active = false
		VEHICLESPAWN.autoEnabled = false
		antiAfkActive = false
		pcall(SESSION.afk.MuteIdleKick, false)
		-- A reload must not leave a retry loop teleporting the player
		-- out from under the new run.
		RECONNECT.enabled = false

		-- Keep the mesh fingerprints learned this session: a reload in
		-- the middle of preparing a rarity would otherwise throw away up
		-- to 20s of model loading, and the user would pay it again.
		pcall(IGNOREBID.SaveCache)

		-- 2. Every root-level listener.
		for _, conn in ipairs(SESSION.connections) do
			pcall(function() conn:Disconnect() end)
		end
		SESSION.connections = {}

		-- 3. UI: the windows we build ourselves, then RayVoid (Destroy
		-- removes this run's window, DestroyAll sweeps any leftovers).
		-- Ours are parented to PlayerGui, so RayVoid's sweep does not
		-- reach them and a reload would leave them on screen forever.
		pcall(EVENTPREDICT.Close)
		pcall(RULES.ED.Close)
		pcall(function() Ui:Destroy() end)
		if not selfOnly then
			pcall(function() Ui:DestroyAll() end)
		end

		if selfOnly then
			print("[Reload] duplicate copy shut itself down")
		else
			if type(getgenv) == "function" then
				getgenv().StorageHunters = nil
			end
			print("[Reload] previous instance unloaded")
		end
	end

	-- Did another copy of this file start while this one was loading? The
	-- executor's teleport queue used to hand out three at once, and each of
	-- them ran its own auction FSM, its own reconnect loop and its own UI.
	-- Only the copy that still owns the token stays.
	if SESSION.token and type(getgenv) == "function" and getgenv().StorageHuntersRun ~= SESSION.token then
		warn("[Reload] another copy of the script started while this one was loading -- shutting this copy down so only one runs")
		SESSION.Unload(true)
	elseif type(getgenv) == "function" then
		getgenv().StorageHunters = { Unload = SESSION.Unload }
	end
end
