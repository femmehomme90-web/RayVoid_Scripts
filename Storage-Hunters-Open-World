-- name -> { { def = , id = }, ... } over Modules.Items, built on first use.
-- A list because one name can have more than one definition.
function RULES.ED.ItemDefs(name)
	if not RULES.ED.defsByName then
		local map = {}
		for id, def in pairs(Items) do
			if type(def) == "table" and type(def.Name) == "string" then
				map[def.Name] = map[def.Name] or {}
				table.insert(map[def.Name], { def = def, id = id })
			end
		end
		RULES.ED.defsByName = map
	end
	return RULES.ED.defsByName[name]
end

