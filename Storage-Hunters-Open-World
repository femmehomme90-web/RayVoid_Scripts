-- SETTINGS BACKUP (Player & Safety). "i can't save my config and its nowhere
-- to be found on the config list" (Delta, 2026-10-13). RayVoid saves into
-- sub-folders (RAYVOID/<PlaceId>/); this writes ONE plain .json file in the
-- executor's main folder, which every executor can do, and loads it back
-- through the same safe loader as above (features switched on one by one).
-- Its own on/off lives in its own little file, not in a config, so it still
-- works when configs do not.
-- =========================================================
SESSION.cfg.backupFile = "StorageHunters-settings-" .. tostring(LocalPlayer.UserId) .. ".json"
SESSION.cfg.autoFile = "StorageHunters-autoload-" .. tostring(LocalPlayer.UserId) .. ".txt"

function SESSION.cfg.Snapshot()
	local out = {}
	for name, flag in pairs(Ui.Flags or {}) do
		if type(flag) == "table" and flag.Type ~= "ColorPicker" then
			local v
			if typeof(flag.CurrentValue) == "boolean" then
				v = flag.CurrentValue
			elseif type(flag.CurrentOption) == "table" then
				v = {}
				for _, o in ipairs(flag.CurrentOption) do
					if type(o) == "string" and not SESSION.IsHint(o) then
						table.insert(v, o)
					end
				end
			elseif type(flag.CurrentValue) == "string" then
				v = flag.CurrentValue
			elseif type(flag.CurrentValue) == "number" and flag.CurrentValue == flag.CurrentValue
				and math.abs(flag.CurrentValue) ~= math.huge then
				v = flag.CurrentValue
			elseif type(flag.CurrentKeybind) == "string" then
				v = flag.CurrentKeybind
			end
			if v ~= nil then
				out[name] = v
			end
		end
	end
	return out
end

function SESSION.cfg.SaveBackup()
	if type(writefile) ~= "function" then
		SESSION.cfg.Notify("Settings backup", "This executor cannot save files.")
		return false
	end
	local ok, err = pcall(function()
		writefile(SESSION.cfg.backupFile, HttpService:JSONEncode({
			placeId = game.PlaceId,
			flags = SESSION.cfg.Snapshot(),
		}))
	end)
	if ok then
		print("[Config] Settings saved to " .. SESSION.cfg.backupFile)
		SESSION.cfg.Notify("Settings backup", "Saved.")
	else
		warn("[Config] Could not save the settings backup: " .. tostring(err))
		SESSION.cfg.Notify("Settings backup", "Could not save: " .. tostring(err))
	end
	return ok
end

function SESSION.cfg.LoadBackup(atLaunch)
	local data, why = SESSION.cfg.Read(SESSION.cfg.backupFile)
	if not data then
		warn("[Config] No settings backup to load: " .. tostring(why))
		SESSION.cfg.Notify("Settings backup", "Nothing to load: " .. tostring(why))
		return false
	end
	return SESSION.cfg.Apply(data, "settings backup", atLaunch)
end

function SESSION.cfg.AutoLoadOn()
	local ok, raw = pcall(function()
		if type(isfile) == "function" and not isfile(SESSION.cfg.autoFile) then
			return ""
		end
		return readfile(SESSION.cfg.autoFile)
	end)
	return ok and raw == "1"
end

