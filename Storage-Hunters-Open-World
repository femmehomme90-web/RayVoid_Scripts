-- ONE BOX PER RULE, not one box holding all of them. Eight long sentences in
-- a single paragraph was a wall the user could not scan; the
-- box borders are what the eye lands on. The boxes for untouched rules are
-- hidden rather than filled with "empty", so the tab only ever shows what
-- is real.
--
-- The POOL grows on demand (RULES.EnsureSummaryRows) rather than being
-- built to a fixed count: CreateParagraph works exactly the same called
-- later as it does now, verified against the live RayVoid source
-- (Tab:CreateInput/CreateParagraph just clone a template into the page and
-- register the Flag -- nothing about it requires happening upfront). It
-- never shrinks; a rule removed later just leaves its box hidden, same as
-- an untouched one. If the page lookup ever fails, every box in the pool
-- simply stays visible.
RULES.summaryRows = {}

-- RULES.page was resolved above, before the exclusion lists were collapsed.
-- Needed by EnsureSummaryRows below AND by the save-storage section further
-- down, so it is defined here, ahead of both.
function RULES.PageChildSet()
	local set = {}
	if RULES.page then
		for _, child in ipairs(RULES.page:GetChildren()) do
			set[child] = true
		end
	end
	return set
end

function RULES.EnsureSummaryRows(count)
	while #RULES.summaryRows < count do
		local idx = #RULES.summaryRows + 1
		local before = RULES.PageChildSet()
		local row = ItemRulesTab:CreateParagraph({
			Title = "Rule " .. idx,
			Content = "",
		})
		local instances = {}
		if RULES.page then
			for _, child in ipairs(RULES.page:GetChildren()) do
				if not before[child] then
					table.insert(instances, child)
				end
			end
		end
		RULES.summaryRows[idx] = { paragraph = row, instances = instances }
		pcall(function()
			for _, instance in ipairs(instances) do
				instance.Visible = false
			end
		end)
	end
end

