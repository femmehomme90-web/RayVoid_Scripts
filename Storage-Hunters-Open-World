function RULES.RefreshSummary()
	-- Covers the config-slot-load path, which sets rules from saved text
	-- without ever calling RULES.SaveAll: a rule loaded with "Ignore Min
	-- Bid" armed still needs its mesh fingerprints prepared once, or the
	-- editor silently shows nothing instead of "still learning".
	RULES.MaybeRebuildBidFp()
	RULES.EnsureSummaryRows(#RULES.rules)
	local shown = 0
	for i = 1, #RULES.summaryRows do
		local rule = RULES.rules[i]
		local row = RULES.summaryRows[i]
		local touched = rule ~= nil and (RULES.AnySet(rule.effects) or RULES.RuleHasCriteria(rule))
		if row then
			if touched then
				shown = shown + 1
				local title, matches, does = RULES.DescribeShort(i)
				if row.paragraph and row.paragraph.Set then
					pcall(function()
						row.paragraph:Set({ Title = title, Content = matches .. "\n" .. does })
					end)
				end
			end
			for _, instance in ipairs(row.instances) do
				pcall(function()
					instance.Visible = touched
				end)
			end
		end
	end
	-- The "nothing set" note doubles as the master-switch banner: shown
	-- whenever there is nothing armed to show OR the whole engine is paused,
	-- so a glance at the tab (no need to open the J editor) says which.
	local showNote = (shown == 0) or not RULES.enabled
	if RULES.emptyNote and RULES.emptyNote.Set then
		pcall(function()
			if not RULES.enabled then
				RULES.emptyNote:Set({
					Title = "Rules in force",
					Content = "OFF -- paused from the master switch in the rule editor (J).\nEvery tab's own filters are deciding, exactly as before.",
				})
			elseif shown == 0 then
				RULES.emptyNote:Set({
					Title = "Rules in force",
					Content = "No rules set. Every tab's own filters are deciding, exactly as before." .. "\n" .. "Open the editor above to make one.",
				})
			end
		end)
	end
	for _, instance in ipairs(RULES.emptyNoteInstances) do
		pcall(function()
			instance.Visible = showNote
		end)
	end
end

