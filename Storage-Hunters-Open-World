	if RULES.ED.mode == "filters" then
		RULES.ED.footer.Text = "Lists decide which items a lane touches. A rule beats a list for the items it names."
		return
	end
	RULES.ED.footer.Text = RULES.Describe(RULES.ED.current)
end

function RULES.ED.Render()
	if not RULES.ED.gui then
