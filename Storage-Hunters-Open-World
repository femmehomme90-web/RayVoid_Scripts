-- caps the whole chunk at 200 locals and seven spare handles is not what that
-- budget is for. Each old tab is now a SECTION on the page it moved to.

-- PLOT DETECTION
local function GetPlayerPlot()
	local plotsFolder = workspace:FindFirstChild("_Plots")
	if not plotsFolder then
		warn("[Plot] workspace._Plots not found")
		return nil
	end
	for _, plot in ipairs(plotsFolder:GetChildren()) do
		local ownerId = plot:GetAttribute("OwnerUserId")
		if ownerId and ownerId == LocalPlayer.UserId then
			return plot
		end
	end
	return nil
end

-- POSITION & TELEPORT HELPERS
local function GetPlayerTruck()
	for _, obj in ipairs(workspace:GetChildren()) do
		local ownerId = obj:GetAttribute("OwnerUserId")
		if ownerId and ownerId == LocalPlayer.UserId then
			if obj:GetAttribute("CargoWeight") ~= nil and obj:GetAttribute("CarPartAccelMult") ~= nil then
				return obj
			end
		end
	end
	return nil
end

local function GetSeatedVehicle()
	local character = LocalPlayer.Character
	if not character then return nil end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not (humanoid and humanoid.SeatPart) then return nil end

	local seat = humanoid.SeatPart
	if not seat:IsA("VehicleSeat") then return nil end

	local truck = GetPlayerTruck()
	if truck and seat:IsDescendantOf(truck) then
		return truck
	end

	return nil
end

local function ResolvePosition(instance)
	if not instance then
		return nil
	end

	-- A caller that already has the position. Not a fallback -- an identity.
	-- Added 2026-09-10 after Auto Quest handed this a Vector3 and every tour
	-- died on "IsA is not a valid member of Vector3", which is a whole class
	-- of bug this one branch closes for every call site.
	if typeof(instance) == "Vector3" then
		return instance
	end

	if instance:IsA("BasePart") then
		return instance.Position
	end

	if instance:IsA("Attachment") then
		return instance.WorldPosition
	end

	if instance:IsA("Model") then
		local ok, pivot = pcall(function()
			return instance:GetPivot()
		end)
		if ok then
			return pivot.Position
		end
	end

	-- Fallback: look for a BasePart or an Attachment anywhere in the descendants
	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("BasePart") then
			return descendant.Position
		end
	end
	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("Attachment") then
			return descendant.WorldPosition
		end
	end

	return nil
end

-- Remembered world positions for teleport targets. Every target here is
-- static world geometry -- area landmarks, shop pads, your own plot's
-- parking space -- so a position, once seen, stays correct for the session
-- and can be used when the object itself is no longer loaded.
--
-- This is what TP-FAR actually needed. The probe (2026-09-08) killed the
-- original "streaming breaks distant lookups" theory for the seven area
-- buttons: all seven resolved from 5015 studs away, so they were never
-- broken. Two real failures remained, and remembering fixes both:
--   * TP base -- workspace.UnpackZone does not exist at all, in either probe
--     run from either position. So TP base has ALWAYS run on its fallback
--     (your plot -> Furniture -> Parking Space), and that fallback is
--     plot-local, which is what streaming unloads at distance. It matches the
--     report exactly: hop to Back Alley first and TP base then works.
--   * CarGarage -- a genuine streaming failure. Its VehiclePad resolved at
--     394 studs and was gone at ~1000.
local TPCACHE = {
	positions = {},
}

function TPCACHE.ToPosition(position)
	local targetCFrame = CFrame.new(position + Vector3.new(0, 5, 0))
	local vehicle = GetSeatedVehicle()

	if vehicle then
		local primary = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
		if not primary then
			warn("[TP] No BasePart found in the vehicle")
			return false
		end

		local ok, err = pcall(function()
			if vehicle.PrimaryPart then
				vehicle:SetPrimaryPartCFrame(targetCFrame)
			else
				primary.CFrame = targetCFrame
			end
		end)
		if not ok then
			warn("[TP] Could not move the vehicle: " .. tostring(err))
			return false
		end
		-- Same as the farm's own truck teleport: an assembled vehicle that
		-- keeps its speed through an instant jump is the silent engine crash
		-- described at ZeroVelocity. Every TP button and the lost-item water
		-- trips come through here while seated, and this step was missing.
		for _, part in ipairs(vehicle:GetDescendants()) do
			if part:IsA("BasePart") then
				ZeroVelocity(part)
			end
		end
		task.wait()
	else
		SafeSetHRPCFrame(targetCFrame)
	end

	return true
end

-- Live lookup first, remembered position second. Returns position, source.
function TPCACHE.Resolve(key, findTarget)
	local ok, target = pcall(findTarget)
	local position = nil
	if ok and target then
		position = ResolvePosition(target)
	end

	if position then
		TPCACHE.positions[key] = position
		return position, "live"
	end

	local remembered = TPCACHE.positions[key]
	if remembered then
		return remembered, "remembered"
	end

	return nil, nil
end

-- The one entry point for every teleport button. A target that cannot be
-- found AND has never been seen is a real failure and says so out loud, with
-- the way out -- it used to be a silent no-op, which is what "the tp button
-- does not work" looked like from the outside.
-- Optional 4th arg: a fallback function (e.g. a GPS POI lookup) tried before
-- giving up, for targets that also have a remote position available.
function TPCACHE.Go(key, label, findTarget, fallbackFn)
	local position, source = TPCACHE.Resolve(key, findTarget)

	if not position and fallbackFn then
		local ok, fbPosition = pcall(fallbackFn)
		if ok and fbPosition then
			position = fbPosition
			source = "fallback"
		end
	end

	if not position then
		warn("[TP] " .. label .. ": not loaded right now and never seen this session, so there is no " ..
			"position to go to. Teleport to a nearby area first, then try this again.")
		return false
	end

	if source == "remembered" then
		DebugPrint("[TP] " .. label .. " is not loaded right now, using the position remembered from earlier")
	end

	return TPCACHE.ToPosition(position)
end

-- All GPS POIs (every category), name -> position, one remote round trip.
-- Kept separate from TPCACHE.ShopPOI's own lookup above (untouched -- that
-- one is farm-critical and already measured/verified): this cache only
-- backs the Teleport tab's own buttons.
function TPCACHE.LoadAllPOIs()
	-- Asked again after 5 min (event areas come and go), or after 30s when the
	-- last answer was empty -- it used to be asked once and never again.
	local age = os.clock() - (TPCACHE.poisAt or 0)
	if TPCACHE.allPois and age < 300 and (next(TPCACHE.allPois) ~= nil or age < 30) then
		return
	end
	TPCACHE.poisAt = os.clock()
	TPCACHE.allPois = TPCACHE.allPois or {}
	TPCACHE.poiCategory = TPCACHE.poiCategory or {}
	local gps = Events:FindFirstChild("GPS")
	local getPOIs = gps and gps:FindFirstChild("GetPOIs")
	if not getPOIs then
		return
	end
	local ok, data = pcall(function()
		return getPOIs:InvokeServer()
	end)
	if ok and type(data) == "table" and type(data.pois) == "table" then
		local fresh, categories = {}, {}
		for _, poi in ipairs(data.pois) do
			if type(poi.name) == "string" and typeof(poi.position) == "Vector3" then
				fresh[poi.name] = poi.position
				categories[poi.name] = poi.category
			end
		end
		TPCACHE.allPois, TPCACHE.poiCategory = fresh, categories
	end
end

-- Teleport straight to a named GPS POI (any category). Works from any
-- distance, same reasoning as ShopPOI above. Warns honestly if the name
-- is not currently in GPS (an event-only area whose event is not running).
function TPCACHE.GoToPOI(name, label)
	local position = TPCACHE.POIByName(name)
	if not position then
		warn("[TP] " .. (label or name) .. ": not in GPS right now (event not active, or the name changed)")
		TPCACHE.PrintPOINames()
		return false
	end
	return TPCACHE.ToPosition(position)
end

-- A GPS name, exact first, then ignoring case, spaces and punctuation -- and
-- the game's "Quck" typo either way, since it may get fixed. The exact-only
-- lookup is why a renamed POI made its button silently do nothing.
function TPCACHE.Squash(name)
	local s = string.gsub(string.lower(tostring(name)), "[^%w]", "")
	return (string.gsub(s, "quck", "quick"))
end
function TPCACHE.POIByName(name)
	TPCACHE.LoadAllPOIs()
	local pois = TPCACHE.allPois or {}
	if pois[name] then
		return pois[name]
	end
	local want = TPCACHE.Squash(name)
	for poiName, pos in pairs(pois) do
		if TPCACHE.Squash(poiName) == want then
			return pos
		end
	end
	return nil
end

-- Once per session, when a GPS lookup fails: every name the GPS has, so the
-- right one can be reported instead of guessed.
function TPCACHE.PrintPOINames()
	if TPCACHE.printedPois or not TPCACHE.allPois then
		return
	end
	TPCACHE.printedPois = true
	local names = {}
	for poiName in pairs(TPCACHE.allPois) do
		-- Not everyone's own shop, just the map's places.
		if (TPCACHE.poiCategory or {})[poiName] ~= "Player Shop" then
			table.insert(names, poiName)
		end
	end
	table.sort(names)
	warn("[TP] Places the GPS knows (" .. #names .. "): " .. table.concat(names, ", "))
end

-- Fallback function for TPCACHE.Go: resolve a GPS POI by name, for a
-- workspace-path target that also has a remote position available.
function TPCACHE.POIFallback(name)
	return function()
		return TPCACHE.POIByName(name)
	end
end

-- Your own shop's position, straight from the game's GPS. This is a REMOTE,
-- so unlike every piece of plot geometry it answers from ANY distance -- which
-- is what makes it the last resort for "go home" when nothing is loaded and
-- nothing was remembered.
--
-- That case is far more common than it sounds: TPCACHE only seeds "base" if
-- the player was standing on their plot 5s after load, and a script reloaded
-- mid-farm (every SH-dev click) is not. That is the whole of "TP base does
-- nothing from Farmyard" -- reported 2026-09-10.
function TPCACHE.ShopPOI()
	if TPCACHE.positions["shopPOI"] then
		return TPCACHE.positions["shopPOI"]
	end

	local gps = Events:FindFirstChild("GPS")
	local getPOIs = gps and gps:FindFirstChild("GetPOIs")
	if not getPOIs then
		return nil
	end

	local ok, data = pcall(function()
		return getPOIs:InvokeServer()
	end)
	if ok and type(data) == "table" and type(data.pois) == "table" then
		for _, poi in ipairs(data.pois) do
			if poi.category == "Player Shop" and typeof(poi.position) == "Vector3"
				and type(poi.name) == "string" and string.find(poi.name, LocalPlayer.Name, 1, true) then
				TPCACHE.positions["shopPOI"] = poi.position
				return poi.position
			end
		end
	end

	return nil
end

local function TeleportTo(target)
	local position = ResolvePosition(target)
	if not position then
		warn("[TP] Could not resolve a position for the target")
		return
	end

	TPCACHE.ToPosition(position)
end

-- Teleports only the player, never the vehicle: if seated, we get off
-- cleanly first (same wait logic as UnloadCargo) and the truck stays
-- where it was.
local function TeleportPlayerOnly(target)
	local position = ResolvePosition(target)
	if not position then
		warn("[TP] Could not resolve a position for the target")
		return
	end

	local vehicle = GetSeatedVehicle()
	if vehicle then
		local character = LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Sit = false

			local waited = 0
			while (humanoid.SeatPart ~= nil or humanoid:GetState() == Enum.HumanoidStateType.Seated) and waited < 2 do
				task.wait(0.1)
				waited = waited + 0.1
			end
			task.wait(0.3)
		end
	end

	SafeSetHRPCFrame(CFrame.new(position + Vector3.new(0, 5, 0)))
end

-- Teleport next to something and make sure it STAYS that way. A position
-- write can be undone a moment later: measured 2026-09-13, a teleport made
-- the instant the player left the seat of the just-recalled truck was pulled
-- back to where they stood within 0.12s, while the same teleport 0.5s, 1.5s
-- or 3s later held. The quest tour runs right after the truck recall, so the
-- Mayor refused all 8 prompts, fired from 1200 studs away, after a one-frame
-- reach check had already said "in reach". So: arrive, then require the
-- player to stay in reach for ARRIVE_HOLD, and teleport again if pulled away.
-- A check rather than a fixed pause, because three held trials do not prove
-- what the window is. `target` is an Instance; returns true once it held.
TPCACHE.ARRIVE_TRIES = 4
TPCACHE.ARRIVE_HOLD = 0.5
function TPCACHE.ArriveNear(target, reach)
	local function inReach()
		local hrp = GetFreshHRP()
		local pos = nil
		pcall(function()
			pos = target.Position
		end)
		return hrp ~= nil and pos ~= nil and (hrp.Position - pos).Magnitude <= reach
	end
	for attempt = 1, TPCACHE.ARRIVE_TRIES do
		TeleportPlayerOnly(target)
		local deadline = os.clock() + 2
		while os.clock() < deadline and not inReach() do
			task.wait(0.05)
		end
		if inReach() then
			local holdUntil = os.clock() + TPCACHE.ARRIVE_HOLD
			local held = true
			while os.clock() < holdUntil do
				if not inReach() then
					held = false
					break
				end
				task.wait(0.05)
			end
			if held then
				if attempt > 1 then
					DebugPrint("[TP] Arrived and stayed on attempt " .. attempt)
				end
				return true
			end
		end
		DebugPrint("[TP] Pulled away from the target after arriving, teleporting again ("
			.. attempt .. "/" .. TPCACHE.ARRIVE_TRIES .. ")")
		task.wait(0.2)
	end
	return false
end

-- Stand on the ground IN FRONT of an NPC, facing it, and settle there.
-- ArriveNear drops you 5 studs above the target's centre: for an NPC that is
-- standing on its head, and the server answered "too far" to the talk. So:
-- 4 studs in front at the NPC's own height, face it, stay put SETTLE seconds
-- (the server has to see you arrive), re-teleport if pulled away.
TPCACHE.SETTLE = 1.2
function TPCACHE.StandFacing(root, reach)
	reach = reach or 10
	local npcPos, look
	local okPos = pcall(function()
		npcPos = root.Position
		look = root.CFrame.LookVector
	end)
	if not okPos or not npcPos then
		return false
	end
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, -1)
	local dist = math.clamp(reach * 0.4, 3, 5)
	local spot = npcPos + flat * dist + Vector3.new(0, 0.5, 0)
	local face = Vector3.new(npcPos.X, spot.Y, npcPos.Z)
	for attempt = 1, TPCACHE.ARRIVE_TRIES do
		TeleportPlayerOnly(spot) -- gets you off a seat first
		SafeSetHRPCFrame(CFrame.lookAt(spot, face))
		local held = true
		local holdUntil = os.clock() + TPCACHE.SETTLE
		while os.clock() < holdUntil do
			local hrp = GetFreshHRP()
			if not hrp or (hrp.Position - npcPos).Magnitude > reach * 0.9 then
				held = false
				break
			end
			task.wait(0.05)
		end
		if held then
			return true
		end
		DebugPrint("[TP] Pulled away from the NPC, standing in front again (" .. attempt .. ")")
		task.wait(0.4)
	end
	return false
end

