-- =========================================================
-- AUTO-CLOSE THE REPAIR POPUP (Misc tab) -- passive, never moves the player.
-- =========================================================
-- Located live 2026-09-10, and the shape of this game's UI is why p8 failed
-- on 2026-09-08: nothing is created when a popup appears. The panel is
-- pre-built and hidden at
--
--   PlayerGui.UIControllerGui.NewDiscoveryOuter.DiscoveryPopup
--
-- and shown by flipping `Visible`. It still holds the LAST repair's text
-- while hidden, which is exactly what made "search for a screen containing
-- 'Repaired!'" match before anything had been repaired.
--
-- The panel is NOT repair-only: its module is `Screens.NewDiscovery` and the
-- same frame shows a plain "new item discovered" reveal, with the repair
-- extras (`RepairResultCard`, `ConditionReveal`, `ValueReveal`) left hidden.
-- So the trigger is `RepairContinueButton`, which is repair-specific and
-- flips Visible in lockstep with the popup -- watching the popup alone would
-- dismiss the user's rare-find reveals too, which nobody asked for.
--
-- Watch the TRANSITION, not the resting state: everything here is visible
-- and populated from the previous repair while the popup is closed.
local AUTOREPAIR = {
	active = false,
	busy = false,
	closed = 0,
	warned = false,
	-- Let the reveal animate before dismissing it. Long enough that we are
	-- not fighting the game's own opening tween, short enough to be
	-- unattended.
	DELAY = 0.5,
}

function AUTOREPAIR.Resolve()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then
		return nil, nil
	end
	local gui = pg:FindFirstChild("UIControllerGui")
	if not gui then
		return nil, nil
	end
	local outer = gui:FindFirstChild("NewDiscoveryOuter", true)
	if not outer then
		return nil, nil
	end
	local popup = outer:FindFirstChild("DiscoveryPopup")
	if not popup then
		return nil, nil
	end
	return popup, popup:FindFirstChild("RepairContinueButton")
end

-- MouseButton1Click is a real RBXScriptSignal, so :Fire() does not exist on
-- it. Same ladder as the AutoLoad ClaimButton, and the same rule: a method
-- that changes nothing is a FAILED method, not a successful one. Here the
-- proof is the popup going away.
function AUTOREPAIR.Click(popup, button)
	local function worked()
		local waited = 0
		while waited < 1.5 do
			if not popup.Visible then
				return true
			end
			task.wait(0.1)
			waited = waited + 0.1
		end
		return false
	end

	if type(firesignal) == "function" then
		local ok = pcall(function()
			firesignal(button.MouseButton1Click)
		end)
		if ok and worked() then
			return true, "firesignal"
		end
	end

	if type(getconnections) == "function" then
		local ok = pcall(function()
			for _, conn in ipairs(getconnections(button.MouseButton1Click)) do
				conn:Fire()
			end
		end)
		if ok and worked() then
			return true, "getconnections"
		end
	end

	-- Last resort, and gated on Visible: a virtual click on a hidden button
	-- lands on whatever is underneath it.
	if button.Visible and type(mousemoveabs) == "function" and type(mouse1click) == "function" then
		local ok = pcall(function()
			local pos = button.AbsolutePosition
			local size = button.AbsoluteSize
			mousemoveabs(pos.X + size.X / 2, pos.Y + size.Y / 2)
			task.wait(0.05)
			mouse1click()
		end)
		if ok and worked() then
			return true, "virtual mouse"
		end
	end

	return false, nil
end

function AUTOREPAIR.Handle(popup, button)
	if not AUTOREPAIR.active or AUTOREPAIR.busy then
		return
	end
	if not (button.Visible and popup.Visible) then
		return
	end
	AUTOREPAIR.busy = true
	task.spawn(function()
		task.wait(AUTOREPAIR.DELAY)
		-- Re-check: the player may have clicked Continue themselves while we
		-- waited, and the popup can be reused by a non-repair discovery.
		if AUTOREPAIR.active and popup.Visible and button.Visible then
			local ok, how = AUTOREPAIR.Click(popup, button)
			if ok then
				AUTOREPAIR.closed = AUTOREPAIR.closed + 1
				local name = popup:FindFirstChild("ItemName")
				DebugPrint("[AutoRepair] Closed the repair popup for "
					.. ((name and name.Text) or "an item")
					.. " via " .. tostring(how) .. " (" .. AUTOREPAIR.closed .. " this session)")
			elseif not AUTOREPAIR.warned then
				-- A popup left open sits over the screen until the player
				-- dismisses it, so this is a real failure, not chatter.
				AUTOREPAIR.warned = true
				warn("[AutoRepair] The repair popup would not close -- no click method worked. "
					.. "Dismiss it by hand; this warning is not repeated.")
			end
		end
		AUTOREPAIR.busy = false
	end)
end

do
	local popup, button = AUTOREPAIR.Resolve()
	if popup and button then
		SESSION.Track(button:GetPropertyChangedSignal("Visible"):Connect(function()
			AUTOREPAIR.Handle(popup, button)
		end))
		-- Both, because the order the game sets them in is its business and
		-- Handle is idempotent while busy.
		SESSION.Track(popup:GetPropertyChangedSignal("Visible"):Connect(function()
			AUTOREPAIR.Handle(popup, button)
		end))
	else
		-- Nothing to hook means the toggle would silently do nothing, which is
		-- the failure mode this file keeps warning about. Say it once, at load.
		warn("[AutoRepair] Could not find the repair popup (UIControllerGui.NewDiscoveryOuter.DiscoveryPopup). "
			.. "Auto-Close Repair Popup will do nothing this session -- the game's UI may have changed.")
	end
end

