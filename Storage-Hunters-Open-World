-- POLICE RAID (Misc tab) -- display only, no action.
-- Refreshed every 5s. Three states:
--   * seized garage active -> type / area / distance (+ whether the type
--     is checked, so whether "Prioritize Seized Garage" will act on it)
--   * in jail (LocalPlayer.JailReleaseAt in the future) -> countdown
--   * otherwise -> next seizure (LocalPlayer.PoliceSeizedGarageNextDueUnix,
--     exposed by the game, no RNG to reimplement)
-- =========================================================
MiscTab:CreateSection("Police Raid")

local policeRaidParagraph = MiscTab:CreateParagraph({
	Title = "Status",
	Content = "...",
})

task.spawn(function()
	local function playerPos()
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		return hrp and hrp.Position or nil
	end

	while LocalPlayer.Parent ~= nil and SESSION.alive do
		local content

		local seizedGarage = SEIZED.GetGarage()
		local jailReleaseAt = LocalPlayer:GetAttribute("JailReleaseAt")

		if seizedGarage then
			local area = seizedGarage:GetAttribute("AreaName") or "?"
			local distText = ""
			local pp = playerPos()
			local gp = pp and (ResolvePosition(seizedGarage))
			if pp and gp then
				distText = string.format(" - %.0f studs away", (gp - pp).Magnitude)
			end
			local scoped = FARM.selectedTypes[seizedGarage.Name]
			local willGrab
			if FARM.autoGrabAnySeized then
				willGrab = "Auto Farm will grab it (Auto-Grab Any Seized Garage is on)."
			elseif FARM.prioritizeSeized and scoped then
				willGrab = "Auto Farm will rush it (Prioritize Seized Garage is on and this type is checked)."
			elseif FARM.prioritizeSeized then
				willGrab = "This type is NOT checked in Garage Types, so Prioritize Seized Garage skips it. Turn on Auto-Grab Any Seized Garage, or check the type."
			else
				willGrab = "Turn on Prioritize Seized Garage or Auto-Grab Any Seized Garage (Auto Farm tab) to have it grabbed."
			end
			content = string.format("SEIZED NOW: %s (%s)%s\n%s", seizedGarage.Name, area, distText, willGrab)
		elseif type(jailReleaseAt) == "number" and jailReleaseAt > os.time() then
			content = "IN JAIL - out in " .. EVENTPREDICT.FormatDuration(jailReleaseAt - os.time())
				.. "\n(triggered by hauling stolen goods from a seized garage)"
		else
			local nextDue = SEIZED.NextDueUnix()
			if nextDue then
				local delta = nextDue - os.time()
				if delta > 0 then
					content = "Next police seizure: in " .. EVENTPREDICT.FormatDuration(delta)
				else
					content = "Next police seizure: due now / any moment"
				end
			else
				content = "No seizure active. Next-seizure time not available yet."
			end
		end

		pcall(function()
			policeRaidParagraph:Set({ Title = "Status", Content = content })
		end)

		task.wait(5)
	end
end)

