-- ANTI-AFK
local antiAfkActive = false
SESSION.afk = { text = "Off", muted = {} }

-- PHONE AND PC (2026-10-13 #2, "mobile users ... whenever they enable anti
-- afk their whole game crashes ... make it universal"). The crash was the
-- backup nudge added the day before: a faked VirtualUser click sent when
-- Roblox says you went idle. Delta on a phone has no mouse1click, so on a
-- phone that nudge was the ONLY thing running -- two minutes after the phone
-- was put down. What runs now:
--   1. EVERY device: Roblox's own idle-kick listener is switched off
--      (getconnections on LocalPlayer.Idled). Nothing is clicked or pressed,
--      so there is nothing for a phone to choke on. Back on with the toggle.
--   2. PC only: the original click every 60s, exactly as before.
--   3. PC only: the VirtualUser nudge when Roblox says idle (window in the
--      background, where a real click lands in some other window).
-- Phones never get 2 or 3.
function SESSION.afk.OnIdled()
	if not antiAfkActive or not SESSION.IsDesktop() then
		return
	end
	local ok = pcall(function()
		local vu = game:GetService("VirtualUser")
		vu:CaptureController()
		vu:ClickButton2(Vector2.new())
	end)
	SESSION.afk.nudge = (ok and "nudge sent " or "nudge failed ") .. os.date("%H:%M")
end
if SESSION.IsDesktop() then
	SESSION.Track(LocalPlayer.Idled:Connect(SESSION.afk.OnIdled))
end

-- on = true: every Idled listener but ours switched off; returns how many,
-- or nil when this executor cannot list them. on = false: all back on.
function SESSION.afk.MuteIdleKick(on)
	if not on then
		for _, c in ipairs(SESSION.afk.muted) do
			pcall(function()
				c:Enable()
			end)
		end
		SESSION.afk.muted = {}
		return 0
	end
	if type(getconnections) ~= "function" then
		return nil
	end
	local okList, list = pcall(getconnections, LocalPlayer.Idled)
	if not okList or type(list) ~= "table" then
		return nil
	end
	-- Ours only exists on PC; on a phone every listener goes, unread.
	local ours = SESSION.IsDesktop() and SESSION.afk.OnIdled or nil
	local muted = {}
	for _, c in ipairs(list) do
		pcall(function()
			if ours == nil or c.Function ~= ours then
				c:Disable()
				table.insert(muted, c)
			end
		end)
	end
	SESSION.afk.muted = muted
	return #muted
end

function SESSION.afk.Describe(desktop, click)
	local n = SESSION.afk.count
	if not desktop then
		if n and n > 0 then
			return "On (phone) -- Roblox's idle kick is switched off. Nothing is tapped or clicked."
		end
		return "On (phone) -- this executor cannot switch off Roblox's idle kick, and fake taps are not "
			.. "safe on a phone, so nothing else is tried. Turn on Auto Reconnect (below) so a kick brings you right back."
	end
	local parts = { (n and n > 0) and "idle kick switched off" or "idle kick still on (executor cannot switch it off)" }
	table.insert(parts, click)
	if SESSION.afk.nudge then
		table.insert(parts, SESSION.afk.nudge)
	end
	return "On (PC) -- " .. table.concat(parts, ", ")
end

local function StartAntiAfk()
	if LOOPGUARDS.antiAfk then return end
	LOOPGUARDS.antiAfk = true
	task.spawn(function()
		local desktop = SESSION.IsDesktop()
		local mutedAt = os.clock()
		while antiAfkActive and LOOPGUARDS.antiAfk do
			-- New listeners can appear (respawn, the game's own scripts).
			if os.clock() - mutedAt >= 300 then
				mutedAt = os.clock()
				SESSION.afk.count = SESSION.afk.MuteIdleKick(true)
			end
			-- PC: the original click, every 60s. It clicks wherever the cursor
			-- is -- keep the cursor off this menu.
			local click = "no click on this executor"
			if desktop and type(mouse1click) == "function" then
				local ok, err = pcall(function()
					mouse1click()
				end)
				if ok then
					DebugPrint("[AntiAFK] Simulated click")
					click = "last click " .. os.date("%H:%M")
				else
					warn("[AntiAFK] mouse1click failed: " .. tostring(err))
					click = "click failed"
				end
			end
			SESSION.afk.text = SESSION.afk.Describe(desktop, click)
			task.wait(60)
		end
		SESSION.afk.text = "Off"
		LOOPGUARDS.antiAfk = false
	end)
end

