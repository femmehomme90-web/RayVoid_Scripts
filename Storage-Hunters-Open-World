-- KEEP: one shared "never sell AND never place" list, read by both
-- IsPlaceableNow and AUTOSELL.RunPass, so the two lanes cannot disagree.
-- Built from item-definition fields, not names:
--   accessory     = def.SlotType (wearable; see the item card notes)
--   trophy        = def.Category == "Trophy"
--   vault         = def.SafeId
--   storage box   = def.IsStorageCrate
--   limited       = def.Limited
--   vehicle part  = def.CarPart
-- Legendary / Mythical go by rarity prefix ("legend", "myth"), so a
-- Mythic-vs-Mythical spelling does not matter. An Item Rule that FORCES a
-- sale/placement still wins, same as every other exclusion on those lanes.
-- One table = one root-level local (Lua 5.1 cap of 200).
local KEEP = {
	accessories = false,
	accMinActive = false,
	accMin = 0,
	accMaxActive = false,
	accMax = 1000000,
	trophies = false,
	legendary = false,
	mythical = false,
	vaults = false,
	storageBoxes = false,
	limited = false,
	exclusive = false,
	carParts = false,
	rarities = {},
	categories = {},
}

-- Returns why the item is kept (a short string), or nil if it may go.
-- `value` is the lane's own price (shelf price for place, pawn base value for
-- sell), used only by the accessory value window.
function KEEP.Reason(entry, def, value)
	if type(def) ~= "table" then
		return nil
	end
	if KEEP.accessories and def.SlotType ~= nil then
		local v = tonumber(value) or 0
		local inWindow = (not KEEP.accMinActive or v >= KEEP.accMin)
			and (not KEEP.accMaxActive or v <= KEEP.accMax)
		if inWindow then
			return "accessory"
		end
	end
	if KEEP.trophies and def.Category == "Trophy" then
		return "trophy"
	end
	if KEEP.vaults and def.SafeId ~= nil then
		return "vault"
	end
	if KEEP.storageBoxes and def.IsStorageCrate then
		return "storage box"
	end
	if KEEP.limited and def.Limited == true then
		return "limited"
	end
	-- Exclusive is NOT Limited: Limited = the timed-event drops (Alien
	-- Invasion); Exclusive = EventExclusive / PoliceExclusive items, the
	-- game's "Exclusive" collection bucket ("Fishing Season" is filed under
	-- Fish there, so not here either -- same rule as AutoSell's toggle).
	if KEEP.exclusive and ((def.EventExclusive and def.EventExclusive ~= "Fishing Season") or def.PoliceExclusive) then
		return "exclusive"
	end
	if KEEP.carParts and def.CarPart then
		return "vehicle part"
	end
	local rarity = type(def.Rarity) == "string" and def.Rarity or ""
	local lower = string.lower(rarity)
	if KEEP.legendary and string.sub(lower, 1, 6) == "legend" then
		return "legendary"
	end
	if KEEP.mythical and string.sub(lower, 1, 4) == "myth" then
		return "mythical"
	end
	if KEEP.rarities[rarity] then
		return "rarity " .. rarity
	end
	if type(def.Category) == "string" and KEEP.categories[def.Category] then
		return "category " .. def.Category
	end
	return nil
end

-- All distinct item names in the game, sorted alphabetically. Used for
-- the "specific item" exclusions (AutoPlace/AutoSell): we identify by
-- NAME, not by ItemId -- more readable in a dropdown, and a player who
-- excludes "Spoiler" thinks of the display name, not a numeric id.
local function GetAllItemNames()
	local seen = {}
	local names = {}
	for _, def in pairs(Items) do
		SESSION.Breathe()
		if type(def) == "table" and type(def.Name) == "string" and def.Name ~= "" then
			if not seen[def.Name] then
				seen[def.Name] = true
				table.insert(names, def.Name)
			end
		end
	end
	table.sort(names)
	return names
end

local ALL_ITEM_NAMES = GetAllItemNames()

-- Creates a reusable "exclude specific items by name" section, for
-- Pickup Filter / AutoSell / AutoPlace. RayVoid has no built-in search
-- in its dropdowns, so on top of the multi-select dropdown (to browse/
-- remove), a text field lets you type a name (exact or partial,
-- case-insensitive) and add it directly -- faster than scrolling a list
-- of 100+ items. Both write into the same set (targetSet), so they stay
-- consistent with each other.
-- Search field bound to a dropdown: typing filters `allOptions` (exact or
-- partial, case-insensitive) and refreshes the dropdown's options via
-- :Refresh(), which RayVoid has no built-in equivalent for. Same pattern as
-- the Skin Changer (confirmed working). Used by the item exclude sections,
-- by "Items that Ignore Min Bid", and by Garage Types.
--
-- `allOptions` is read at call time, so a list that is rebuilt elsewhere
-- (Garage Types is static, but the priority options are not) stays correct:
-- pass a function instead of a table when the list can change.
local function CreateSearchBox(tab, dropdown, allOptions, flag, placeholder)
	tab:CreateInput({
		Name = "Search",
		PlaceholderText = placeholder,
		RemoveTextAfterFocusLost = false,
		Flag = flag,
		Callback = function(text)
			local source = allOptions
			if type(source) == "function" then
				source = source()
			end

			local query = text:lower():match("^%s*(.-)%s*$")
			local filtered

			if query == "" then
				filtered = source
			else
				filtered = {}
				for _, name in ipairs(source) do
					if string.find(string.lower(name), query, 1, true) then
						table.insert(filtered, name)
					end
				end
			end

			if #filtered == 0 then
				filtered = { "(no results)" }
			end
			-- Never more than SESSION.LIST_CAP rows (an empty search used to
			-- redraw all ~1000 items at once).
			filtered = SESSION.CapList(filtered, dropdown and dropdown.CurrentOption)

			if dropdown and dropdown.Refresh then
				dropdown:Refresh(filtered)
			else
				warn("[SearchBox] dropdown has no :Refresh, search does nothing for " .. tostring(flag))
			end
		end,
	})
end

-- ONE way to ask "which of these?", used by every long list in the UI.
--
-- RayVoid collapses any multi-select holding more than one tick to the literal
-- word "Various", so the control cannot tell you what is in it -- the same
-- "control that lies about itself" problem the Garage Types box had. Rather
-- than solving it once per list, every long list now goes through here and
-- gets the same three things: a search box, a paragraph naming exactly what is
-- ticked, and a button to empty it.
--
-- opts: Name, Options (table, or a function when the list is rebuilt),
--       Flag, Set (the table to fill), Hint (one line, optional),
--       Placeholder (search hint), OnChange (extra callback, optional)
-- =========================================================
-- THE LANE FILTERS, REGISTERED RATHER THAN DRAWN ON A TAB
-- =========================================================
-- "which items?" used to be asked on five different tabs, which is the
-- duplication the user objected to (worklist Q5). Moving three of the five
-- onto the Item Rules tab was the wrong fix -- it relocated the problem and
-- made one page 1864px tall, and it left Auction and Processing behind, which
-- the user spotted immediately: "whats with the inconsistency?".
--
-- So every identity filter now REGISTERS itself here instead of living on a
-- page. The RayVoid control is still created -- it is the storage, and its
-- Flag is what makes the setting travel inside a config slot -- but its
-- elements are hidden and the rule editor window draws them, grouped by lane.
--
-- The window never reimplements a filter: it calls the control's own :Set(),
-- which RayVoid finishes by invoking that control's Callback. So the state
-- tables, IGNOREBID.Rebuild, the flag write and every other hook fire exactly
-- as if the dropdown had been clicked by hand. Verified against the library
-- source 2026-09-12: DropdownSettings:Set ends in Callback(NewOption).
--
-- What deliberately did NOT move: the numbers and the on/off switches. "Sell
-- Below $", "Max Value to Place", "Auto-Bid" and friends stay on their own
-- tabs, because they are what that lane IS rather than which items it is
-- about. That split is the user's own (2026-09-12).
local FILTERS = {
	ORDER = { "pickup", "place", "sell", "grade", "bid" },
	TITLE = {
		pickup = "Pickup  --  left on the ground",
		place  = "Shelves  --  never put up for sale",
		sell   = "AutoSell  --  never sold",
		grade  = "Grading  --  which rarities get graded",
		bid    = "Auction  --  ignores your Min Bid",
	},
	SHORT = {
		pickup = "Pickup",
		place  = "Shelves",
		sell   = "AutoSell",
		grade  = "Grading",
		bid    = "Auction",
	},
	-- What a lane cannot filter on, and why. Without this a missing box looks
	-- like an oversight; some of these are real limits and some are gaps left
	-- by history, and the window should not pretend they are the same thing.
	--
	-- A string or a list of strings, one line each (the pane does not wrap, so
	-- keep every line under ~85 characters). Corrected 2026-09-12 after the
	-- user asked why the five lanes offer such different boxes:
	--   * grade's entry restated NOTE's polarity and never mentioned that four
	--     channels are simply absent, so the emptiness looked unexplained.
	--   * bid's entry said "before a win the game only reveals mutations and
	--     condition" -- a reason the Item-names and Rarities boxes drawn
	--     directly above it disprove. IGNOREBID beats the name-stripping with
	--     learned mesh fingerprints, and it expands a rarity into names by a
	--     plain def.Rarity sweep, so any other definition field is reachable
	--     the same way. What actually stops it is cost and coverage, not data.
	CANNOT = {
		pickup = "No mutation or vault/drink boxes here: the pickup filter never had them. Use a rule.",
		place  = "No drink or exclusive boxes here: AutoPlace never had them. Use a rule.",
		sell   = nil,
		grade  = {
			"No name, category, mutation or limited boxes: Auto Grade never had them. Use a rule.",
			"\"Grade Vault Before Opening\" stays on the Processing tab: it is a sequencing",
			"switch, not a filter: with Auto Vault on it grades safes even if Auto",
			"Grade is off, so it is not something this list controls.",
		},
		bid = {
			"Boxed items never match whatever you tick: roughly half a garage cannot be",
			"identified by anyone before the win. That is the real ceiling here.",
			"No category/limited/vault boxes: they are reachable the same way rarities",
			"are, but each name costs ~68ms to learn and the preview cache dies near 141.",
			"Value is the one thing genuinely unknowable before a win.",
		},
	},
	NOTE = {
		pickup = "Anything picked here is walked past; the garage still finishes.",
		place  = "Anything picked here stays in your inventory, off the shelf.",
		sell   = "Anything picked here is kept rather than sold.",
		grade  = "These rarities ARE graded -- a keep-list, not a skip-list.",
		bid    = "A garage holding any of these is worth entering under Min Bid.",
	},
	entries = {},
	instances = {},
}

function FILTERS.Page(pageName)
	local page
	pcall(function()
		local rayfield = game:GetService("CoreGui"):FindFirstChild("RobloxGui")
		rayfield = rayfield and rayfield:FindFirstChild("Rayfield")
		local main = rayfield and rayfield:FindFirstChild("Main")
		local elements = main and main:FindFirstChild("Elements")
		page = elements and elements:FindFirstChild(pageName)
	end)
	return page
end

-- Builds the control, remembers every element it put on the page, and files it
-- under its lane. `build` returns the control; `options` is the list the picker
-- offers (a table, or a function when the list is rebuilt at runtime).
function FILTERS.Wrap(pageName, lane, label, kind, options, note, build)
	local page = FILTERS.Page(pageName)
	local before = {}
	if page then
		for _, child in ipairs(page:GetChildren()) do
			before[child] = true
		end
	end
	local control = build()
	if page then
		for _, child in ipairs(page:GetChildren()) do
			if not before[child] then
				table.insert(FILTERS.instances, child)
			end
		end
	end
	table.insert(FILTERS.entries, {
		lane = lane,
		label = label,
		kind = kind,
		options = options,
		note = note,
		control = control,
	})
	return control
end

function FILTERS.ForLane(lane)
	local out = {}
	for _, entry in ipairs(FILTERS.entries) do
		if entry.lane == lane then
			table.insert(out, entry)
		end
	end
	return out
end

-- What the control holds right now, read off the control itself so there is
-- one source of truth rather than a copy that can drift.
function FILTERS.Current(entry)
	if not entry.control then
		if entry.kind == "bool" then
			return false
		end
		return {}
	end
	if entry.kind == "bool" then
		return entry.control.CurrentValue == true
	end
	local list = {}
	if type(entry.control.CurrentOption) == "table" then
		for _, value in ipairs(entry.control.CurrentOption) do
			if not SESSION.IsHint(value) then
				table.insert(list, value)
			end
		end
	end
	table.sort(list)
	return list
end

function FILTERS.Set(entry, value)
	if not (entry.control and entry.control.Set) then
		warn("[Filters] " .. tostring(entry.label) .. " has no Set, so it cannot be changed from the window.")
		return false
	end
	local ok, err = pcall(function()
		entry.control:Set(value)
	end)
	if not ok then
		warn("[Filters] " .. tostring(entry.label) .. " refused a change: " .. tostring(err))
	end
	return ok
end

-- Called once every filter has been built.
function FILTERS.HideAll()
	for _, instance in ipairs(FILTERS.instances) do
		pcall(function()
			instance.Visible = false
		end)
	end
end

local function CreateMultiSelect(tab, opts)
	local dropdown, summary
	-- What the user actually ticked, in display terms. Tracked here rather
	-- than read back out of opts.Set, because some lists store something else
	-- (a drink id, an NPC name) under a friendlier label -- and the summary
	-- has to show the label the user clicked.
	local chosen = {}

	local function refresh()
		local content
		if #chosen == 0 then
			content = "Nothing ticked -- this list is not filtering anything."
		else
			content = "Ticked (" .. #chosen .. "): " .. table.concat(chosen, ", ")
		end
		if opts.Hint then
			content = opts.Hint .. "\n" .. content
		end
		if summary and summary.Set then
			pcall(function()
				summary:Set({ Title = opts.Name, Content = content })
			end)
		end
	end

	local function apply(selected)
		chosen = {}
		table.clear(opts.Set)
		for _, name in ipairs(selected) do
			-- The search box puts "(no results)" / "(N more ...)" rows in the
			-- list; they are messages, not options.
			if not SESSION.IsHint(name) then
				table.insert(chosen, name)
				local key = name
				if opts.KeyFor then
					key = opts.KeyFor(name)
				end
				if key ~= nil then
					opts.Set[key] = true
				end
			end
		end
		table.sort(chosen)
		refresh()
		if opts.OnChange then
			opts.OnChange(opts.Set, chosen)
		end
	end

	dropdown = tab:CreateDropdown({
		Name = opts.Name,
		Options = SESSION.CapList((type(opts.Options) == "function") and opts.Options() or opts.Options, opts.Default),
		CurrentOption = opts.Default or {},
		MultipleOptions = true,
		Flag = opts.Flag,
		Callback = apply,
	})

	CreateSearchBox(tab, dropdown, opts.Options, opts.Flag .. "Search",
		opts.Placeholder or "type to filter...")

	summary = tab:CreateParagraph({ Title = opts.Name, Content = "" })

	tab:CreateButton({
		Name = "Clear " .. opts.Name,
		Callback = function()
			pcall(function()
				dropdown:Set({})
			end)
			apply({})
		end,
	})

	-- RayVoid does NOT fire a dropdown's callback at build time, so a
	-- non-empty default would leave the state table empty while the control
	-- claimed otherwise. Seed it by hand -- the Alien Garage lesson.
	apply(opts.Default or {})
	return dropdown, refresh
end

-- A multi-select that belongs to a lane: the same control, but registered with
-- FILTERS and drawn by the rule editor window instead of sitting on a tab.
local function CreateLaneList(tab, pageName, lane, opts)
	return FILTERS.Wrap(pageName, lane, opts.Label or opts.Name, "list", opts.Options, opts.Hint, function()
		return CreateMultiSelect(tab, opts)
	end)
end

-- Same for the boolean traits (vault / limited / energy drink / exclusive):
-- they answer "which items?" just as much as a name list does.
local function CreateLaneToggle(tab, pageName, lane, label, note, settings)
	return FILTERS.Wrap(pageName, lane, label, "bool", nil, note, function()
		return tab:CreateToggle(settings)
	end)
end

local function CreateItemExcludeSection(tab, pageName, lane, targetSet, flagPrefix, hint)
	return CreateLaneList(tab, pageName, lane, {
		Label = "Item names",
		Name = flagPrefix .. " -- Exclude Specific Items",
		Options = ALL_ITEM_NAMES,
		Flag = flagPrefix .. "ExcludeItemsDropdown",
		Set = targetSet,
		Hint = hint,
		Placeholder = "e.g. spoiler, mags, exhaust...",
	})
end

-- SIZE FIT (copy of the game's shelf picker)
-- SnapPoint_* attachments carry SlotWidth/SlotDepth/SlotHeight. We
-- reproduce ShelfInteraction's test so we do not burn task.wait(0.4) on
-- slots that will refuse. Optional modules: if they are missing, the
-- fit check returns true instead of crashing.
local ItemLoader = SafeRequire(ReplicatedStorage.Modules.ItemLoader, "ItemLoader")
local FurnitureCfg = SafeRequire(ReplicatedStorage.Modules.Furniture, "FurnitureCfg")
-- Used to know the EXPECTED number of selling slots on a piece of
-- furniture (PlotConfig.GetShelfSellingSlots = max(1, def.SellingSlots
-- or 1)), independently of what Roblox streaming has already loaded
-- client-side. GetAvailableShelfSlots uses it to tell "base full" apart
-- from "plot not fully streamed yet" (empty podiums not yet appeared).
-- Optional: if absent, the check degrades to "1 slot per furniture".
local PlotCfg = SafeRequire(ReplicatedStorage.Modules.PlotConfig, "PlotConfig")

local itemBaseSizeCache = {}
local shelfToleranceCache = {}
local shelfExpectedSlotsCache = {}

-- Expected number of selling slots for a shelf furniture, read from the
-- game config (never from already-streamed attachments). Fallback 1.
local function GetShelfExpectedSlots(shelf)
	local itemId = shelf:GetAttribute("ItemId")
	if itemId == nil then
		return 1
	end
	local key = tostring(itemId)
	local cached = shelfExpectedSlotsCache[key]
	if cached ~= nil then
		return cached
	end
	local n = 1
	if PlotCfg and FurnitureCfg then
		local ok, result = pcall(function()
			local def = FurnitureCfg:GetById(key)
			return PlotCfg.GetShelfSellingSlots(def)
		end)
		if ok and type(result) == "number" and result >= 1 then
			n = math.floor(result + 0.5)
		end
	end
	shelfExpectedSlotsCache[key] = n
	return n
end

-- Base size of an item, cached by model name. ItemLoader can yield on
-- the first call, hence the cache: we pay only once.
-- false = model not found, we will never block on this item.
local function GetItemBaseSize(itemDef)
	if not ItemLoader or not itemDef or type(itemDef.Name) ~= "string" then
		return nil
	end

	local cached = itemBaseSizeCache[itemDef.Name]
	if cached ~= nil then
		if cached == false then
			return nil
		end
		return cached
	end

	local ok, model = pcall(function()
		return ItemLoader:GetItem(itemDef.Name)
	end)
	if not ok or not model or not model:IsA("Model") then
		itemBaseSizeCache[itemDef.Name] = false
		return nil
	end

	local ok2, size = pcall(function()
		local _, s = model:GetBoundingBox()
		return s
	end)

	-- The leak this guards against turns out not to happen: GetItem parents
	-- the model into PlayerGui.ItemPreviewCache (measured 2026-09-06), so
	-- Parent is never nil and Destroy never runs. Kept as-is -- it is correct
	-- either way, and destroying a model the game has cached would break its
	-- item previews.
	pcall(function()
		if model.Parent == nil then
			model:Destroy()
		end
	end)

	if not ok2 or not size then
		itemBaseSizeCache[itemDef.Name] = false
		return nil
	end

	itemBaseSizeCache[itemDef.Name] = size
	return size
end

-- Effective size: the model's bounding box * the size mutator's Scale.
-- nil = unknown size, the item will pass every check.
local function GetEntrySize(entry, itemDef)
	local base = GetItemBaseSize(itemDef)
	if not base then
		return nil
	end

	local scale = 1
	local ok, sizeMut = pcall(function()
		return MutatorModule:GetSizeMutator(entry)
	end)
	if ok and sizeMut then
		local ok2, sizeDef = pcall(function()
			return MutatorModule:GetSizeByName(sizeMut.name)
		end)
		if ok2 and sizeDef and sizeDef.Scale then
			scale = sizeDef.Scale
		end
	end

	return Vector3.new(base.X * scale, base.Y * scale, base.Z * scale)
end

-- Furniture tolerance, copied from ShelfInteraction:
--   "Large Floor Podium" -> no size check at all
--   "Podium"             -> tolerance x2 on width/depth
--   otherwise            -> x1
-- Returns (multiplier, skipSizeCheck)
local function GetShelfTolerance(shelfModel)
	local itemId = shelfModel:GetAttribute("ItemId")
	if not itemId or not FurnitureCfg then
		return 1, false
	end

	local key = tostring(itemId)
	local cached = shelfToleranceCache[key]
	if cached then
		return cached[1], cached[2]
	end

	local name = ""
	local ok, def = pcall(function()
		return FurnitureCfg:GetById(key)
	end)
	if ok and def and type(def.Name) == "string" then
		name = def.Name
	end

	local mult = 1
	local skip = false
	if string.find(name, "Large Floor Podium", 1, true) then
		skip = true
	elseif string.find(name, "Podium", 1, true) then
		mult = 2
	end

	shelfToleranceCache[key] = { mult, skip }
	return mult, skip
end

-- The item fits if its footprint fits within width x depth, one way OR
-- the other (it can be rotated), and if its height does not exceed
-- SlotHeight when that attribute exists.
local function FitsSlot(size, slot)
	if not size or slot.skipSizeCheck then
		return true
	end
	if not slot.width or not slot.depth then
		return true
	end

	local maxW = slot.width * slot.tolerance
	local maxD = slot.depth * slot.tolerance

	local fits = false
	if size.X <= maxW and size.Z <= maxD then
		fits = true
	elseif size.Z <= maxW and size.X <= maxD then
		fits = true
	end

	if fits and slot.height and size.Y > slot.height then
		fits = false
	end

	return fits
end

local function FitsAnySlot(size, slotList)
	for _, slot in ipairs(slotList) do
		if FitsSlot(size, slot) then
			return true
		end
	end
	return false
end

-- Returns freeSlots, allSlots, expectedSlotCount.
--   freeSlots : placeable NOW (free, out of cooldown)
--   allSlots  : every slot on the plot, occupied included. Used to know
--               whether an item is waiting for a spot to free up or
--               simply fits nowhere on this plot.
--   expectedSlotCount : TOTAL number of slots the plot SHOULD have
--               according to the game config (sum of SellingSlots for
--               each IsShelf furniture). If #allSlots < expectedSlotCount,
--               Roblox streaming has not finished loading the furniture
--               (empty podiums not yet appeared) -- PlaceItems treats that
--               case as "plot not ready, retry", never as "base full".
--               Without this, a half-streamed plot where only the OCCUPIED
--               podiums are loaded reads wrongly as saturated.
-- Which shelf spots are taken, asked of the SERVER. The plot's Stock folder
-- cannot answer that on arrival: the game's StockStreamer fills it one item at
-- a time after the base streams in, and measured 2026-09-13 it held 0-1 of 22
-- shelf items for the whole ~5s a placing stop lasts. Every spot looked free,
-- and the server answered "That shelf slot is already occupied!" ~15 times a
-- stop. GetShopStock is the call StockStreamer itself makes: an array of
-- { Attrs, CF, Template }, ~300ms, and it answers from anywhere on the map.
-- Returns a set "shelfGUID/SnapPoint_n" -> true, or nil plus the error.
function PLACE.FetchOccupiedSlots(plot)
	local ok, result = pcall(function()
		return REMOTES.GetShopStock:InvokeServer(plot)
	end)
	if not ok or type(result) ~= "table" then
		return nil, tostring(result)
	end
	local occupied = {}
	for _, entry in ipairs(result) do
		local attrs = type(entry) == "table" and entry.Attrs or nil
		if type(attrs) == "table" and attrs.ShelfGUID ~= nil and attrs.SnapPointName ~= nil then
			occupied[tostring(attrs.ShelfGUID) .. "/" .. tostring(attrs.SnapPointName)] = true
		end
	end
	return occupied
end

-- `occupiedOnServer` is PLACE.FetchOccupiedSlots's answer. Only PlaceItems
-- needs the free list to be true; the streaming wait in RunPlacingPhase reads
-- only the slot counts and passes nothing. The Stock folder is still read on
-- top, since an item placed a moment ago streams in there first.
local function GetAvailableShelfSlots(plot, occupiedOnServer)
	local freeSlots = {}
	local allSlots = {}
	local expectedSlotCount = 0

	local Furniture = plot:FindFirstChild("Furniture")
	if not Furniture then
		warn("[Place] Furniture not found in the plot")
		return freeSlots, allSlots, expectedSlotCount
	end

	local Stock = plot:FindFirstChild("Stock")
	local now = os.clock()

	for _, shelf in ipairs(Furniture:GetChildren()) do
		if shelf:GetAttribute("IsShelf") then
			local shelfGUID = shelf:GetAttribute("GUID")
			local tolerance, skipSizeCheck = GetShelfTolerance(shelf)
			expectedSlotCount = expectedSlotCount + GetShelfExpectedSlots(shelf)
			local occupied = {}

			if Stock then
				for _, stockItem in ipairs(Stock:GetChildren()) do
					if stockItem:GetAttribute("ShelfGUID") == shelfGUID then
						local snapName = stockItem:GetAttribute("SnapPointName")
						if snapName then
							occupied[snapName] = true
						end
					end
				end
			end

			for _, descendant in ipairs(shelf:GetDescendants()) do
				if descendant:IsA("Attachment") and descendant.Name:match("^SnapPoint") then
					local slot = {
						shelfGUID = shelfGUID,
						snapName = descendant.Name,
						attachment = descendant,
						width = descendant:GetAttribute("SlotWidth"),
						depth = descendant:GetAttribute("SlotDepth"),
						height = descendant:GetAttribute("SlotHeight"),
						tolerance = tolerance,
						skipSizeCheck = skipSizeCheck,
					}
					table.insert(allSlots, slot)

					local takenOnServer = occupiedOnServer ~= nil
						and occupiedOnServer[tostring(shelfGUID) .. "/" .. descendant.Name] == true
					if not occupied[descendant.Name] and not takenOnServer then
						local slotKey = shelfGUID .. "_" .. descendant.Name
						local pendingUntil = recentlyPlacedSlots[slotKey]
						local isPending = pendingUntil and pendingUntil > now

						if not isPending then
							if pendingUntil then
								recentlyPlacedSlots[slotKey] = nil
							end
							table.insert(freeSlots, slot)
						end
					end
				end
			end
		end
	end

	return freeSlots, allSlots, expectedSlotCount
end

-- ComputeStockPrice MUST be defined BEFORE IsPlaceableNow, because the
-- latter uses it to filter out null-priced items. No "local" here: the
-- variable is declared further up, for ShouldGradeEntry.
function ComputeStockPrice(entry, itemDef)
	local price = MutatorModule:CalculatePriceForEntry(itemDef.BasePrice or 0, entry)

	if entry.Grade and Grading.GradeMultipliers[entry.Grade] then
		price = math.floor(price * Grading.GradeMultipliers[entry.Grade] * 100 + 0.5) / 100
	end

	return price
end

-- An item is placeable now if it is neither favorited, nor null-priced,
-- nor dirty (while Wash is active), nor ungraded of a targeted rarity
-- (while Grade is active), nor excluded. Dirty/ungraded items are left
-- so Wash/Grade handle them first; they become placeable on the next
-- pass once washed/graded.
local function IsPlaceableNow(entry, itemDef, guid)
	if entry.Favorited == true then
		return false
	end

	-- The server will not list a quest item ("You cannot sell this item
	-- [Quest]", measured 2026-09-13 on the three delivery packages, every
	-- stop), and each attempt still used up a free spot for that pass.
	-- Structural, so no rule can force it.
	if type(entry.Mutators) == "table" then
		for _, mutation in ipairs(entry.Mutators) do
			if type(mutation) == "table" and mutation.name == "Quest" then
				return false
			end
		end
	end

	-- Held back for the collector / a quest / the plant: only the first N
	-- copies that are actually needed; extras are fair game.
	if COLLECTORKEEP.KeepsGuid(guid, entry.ItemId) then
		return false
	end

	-- Item Rules: beats this tab's own exclusions, but not Favorited above
	-- (a favourite is the user's hardest signal) and not the collector.
	--
	-- "Allow placing" deliberately overrides only the EXCLUSIONS, never the
	-- structural guards further down: the $0 price guard exists because the
	-- game sometimes hands back a BasePriceOverride of 0 and such an item
	-- goes on sale for nothing, and the Wash/Grade deferrals exist so an item
	-- is not shelved before the thing that makes it worth more has run. A
	-- rule saying "place this" is not the user asking for either of those.
	local ruleForced = false
	if RULES.LaneArmed("place") then
		local verdict = RULES.Decide("place", {
			name = itemDef.Name,
			category = itemDef.Category,
			rarity = itemDef.Rarity,
			mutations = entry.Mutators,
			traits = RULES.TraitsFor(itemDef, entry.ItemId),
			condition = entry.Condition,
			value = ComputeStockPrice(entry, itemDef),
			-- The ROLLED weight when the item has one (Uranium Ore, Hay, the
			-- crops, the eggs -- 20 of them roll per item), otherwise the
			-- item's fixed weight from its definition. Measured 2026-09-12:
			-- all 1039 item definitions carry a Weight, so a KG rule is not
			-- a uranium-only tool and should not behave like one.
			weight = entry.Weight or (type(itemDef) == "table" and itemDef.Weight) or nil,
		})
		if verdict == "block" then
			return false
		end
		ruleForced = (verdict == "force")
	end

	if not ruleForced then
		-- Vault items (safes): identified by the SafeId field in the def, not
		-- by a Category. Excluded if the toggle is active.
		if PLACE.excludeVault and itemDef.SafeId ~= nil then
			return false
		end

		if PLACE.excludeLimited and itemDef.Limited == true then
			return false
		end

		-- EventExclusive: same criterion as AUTOSELL's isExclusive ("Fishing
		-- Season" is filed under Fish game-side, not Exclusive).
		if PLACE.excludeExclusive and itemDef.EventExclusive and itemDef.EventExclusive ~= "Fishing Season" then
			return false
		end

		-- Exclusion by exact name (Spoiler, Mags, Exhaust, Hoverboard...):
		-- "usable" items we never want to place/sell, independently of their
		-- category or rarity.
		if type(itemDef.Name) == "string" and PLACE.excludedItemNames[itemDef.Name] then
			return false
		end

		-- Same pattern as AUTOSELL.excludedMutations: an item carrying one of
		-- the excluded mutations is never placed, whatever its category/
		-- rarity/value. entry.Mutators is already a decoded table here.
		if type(entry.Mutators) == "table" then
			for _, mutation in ipairs(entry.Mutators) do
				if type(mutation) == "table" and PLACE.excludedMutations[mutation.name] then
					return false
				end
			end
		end

		-- Mint is derived from Condition, not stored in Mutators, so it cannot
		-- be caught by the loop above. See IsMintCondition.
		if PLACE.excludedMutations["Mint"] and IsMintCondition(entry.Condition) then
			return false
		end
	end

	-- Price guard: an item whose computed price is null/absurd (often a
	-- server-side BasePriceOverride of 0) must NEVER be placed, or it goes
	-- on sale at $0 and no NPC buyer comes. We leave it in the inventory.
	-- Applies to a forced item too -- see the note above.
	local price = ComputeStockPrice(entry, itemDef)
	if type(price) ~= "number" or price < PLACE.MIN_STOCK_PRICE then
		return false
	end

	if not ruleForced then
		if KEEP.Reason(entry, itemDef, price) then
			return false
		end

		if PLACE.maxValueActive and price > PLACE.maxValue then
			return false
		end

		if PLACE.minValueActive and price < PLACE.minValue then
			return false
		end

		local rarity = itemDef.Rarity or "Uncommon"

		if PLACE.excludedRarities[rarity] then
			return false
		end
		if type(itemDef.Category) == "string" and PLACE.excludedCategories[itemDef.Category] then
			return false
		end
	end

	-- Let Wash handle dirty items before placing them
	if WASHGRADE.washActive and IsEntryDirty(entry) then
		return false
	end

	-- Let Grade handle the items it will ACTUALLY take. Same predicate as
	-- the handler: an item rejected by the value filter stays placeable,
	-- otherwise it would stay stuck in the inventory for life.
	if ShouldGradeEntry(entry, itemDef) then
		return false
	end

	return true
end

-- One placement pass. Assumes the player is ALREADY at the plot (never TPs).
-- Returns (placed, waiting, refused).
--   placed  : items actually placed this pass.
--   waiting : PLACEABLE items that found NO free slot but that would fit
--             in an occupied slot -- THE real "base full" signal (never
--             the oversized ones, or the Master would wrongly believe
--             the base is full).
--   refused : items sent to a FREE slot but rejected by the server
--             (REMOTES.PlaceStockItemResult(id, non-true), toast "That item
--             could not be listed") -- this is NOT "base full", the item
--             is just temporarily unlistable. Until 2026-09-13 nearly
--             every refusal was "That shelf slot is already occupied!",
--             because free spots were read from a Stock folder that had
--             not streamed in yet; see PLACE.FetchOccupiedSlots. The
--             Master must NOT block on the "BASE FULL" screen
--             for that -- it goes back to farming and retries on the next
--             cycle, which is enough (the transient state clears).
--   waiting == nil : plot/inventory unreachable OR streaming unfinished
--             (fewer slots loaded than the config announces) ->
--             RunPlacingPhase retries, concludes nothing.
local function PlaceItems()
	local plot = GetPlayerPlot()
	if not plot then
		warn("[Place] Plot not found")
		return 0, nil, 0
	end

	local invOk, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not invOk or type(inventory) ~= "table" then
		warn("[Place] GetPlayerInventory failed")
		return 0, nil, 0
	end

	local occupiedOnServer, fetchErr = PLACE.FetchOccupiedSlots(plot)
	if not occupiedOnServer then
		-- Not a guess from the Stock folder instead: that is the exact reading
		-- that sent every item at a taken spot. Retried like "not streamed yet".
		if not PLACE.stockFetchWarned then
			PLACE.stockFetchWarned = true
			warn("[Place] Could not ask the server which shelf spots are taken (" .. tostring(fetchErr) .. "), retrying")
		end
		return 0, nil, 0
	end
	PLACE.stockFetchWarned = false

	local freeSlots, allSlots, expectedSlotCount = GetAvailableShelfSlots(plot, occupiedOnServer)
	if #allSlots == 0 or (expectedSlotCount > 0 and #allSlots < expectedSlotCount) then
		-- Distinct from "really nothing to place" (remaining=0): here we do
		-- not yet have ALL the plot's slots -- Roblox streaming unfinished
		-- (common when arriving from a distant area; empty podiums often
		-- appear after the occupied ones). NOT "empty inventory" and
		-- ESPECIALLY not "base full": RunPlacingPhase must retry.
		-- This is THE cause of the "empty podiums are not taken into
		-- account, the base is declared full" bug: before, as long as there
		-- was >=1 loaded slot we went ahead, and if the only already-loaded
		-- slots were occupied -> permanent false "base full".
		warn(string.format("[Place] Only %d/%d shelf slot(s) loaded (streaming not finished?), retrying",
			#allSlots, expectedSlotCount))
		return 0, nil, 0
	end

	-- Best-fit: narrowest slots first. Combined with "first slot that
	-- accepts", this stops a small item from wasting a wide slot that a
	-- big item will need. Slots without constraints end up at the end of
	-- the list.
	table.sort(freeSlots, function(a, b)
		local areaA = math.huge
		local areaB = math.huge
		if not a.skipSizeCheck and a.width and a.depth then
			areaA = (a.width * a.tolerance) * (a.depth * a.tolerance)
		end
		if not b.skipSizeCheck and b.width and b.depth then
			areaB = (b.width * b.tolerance) * (b.depth * b.tolerance)
		end
		if areaA == areaB then
			return a.snapName < b.snapName
		end
		return areaA < areaB
	end)

	local placedCount = 0
	local waitingCount = 0
	local refusedCount = 0
	local usedSlot = {}
	local usedSlotCount = 0

	-- First-fit decreasing: we place items from LARGEST to smallest.
	-- Combined with the slot sort (narrowest to widest), each big item
	-- takes the smallest slot that still accepts it, and the small ones
	-- take what is left. Without this sort, pairs() iterates in an
	-- arbitrary order and a medium item can steal the only large slot a
	-- big item needed -- the latter then staying stuck in the inventory
	-- even though there was room.
	local queue = {}
	-- Counts separately the items held back BECAUSE they are waiting for
	-- Grade (ShouldGradeEntry): with Auto Grade active on many rarities
	-- and a farm faster than the grading throughput (~1 item per unlocked
	-- slot every 5s), a queue of "waiting for grade" items can build up
	-- -- they are NEVER counted as placeable until they are graded, which
	-- is intended (do not sell an ungraded item), but makes AutoPlace look
	-- "broken" to the user when it is just waiting its turn. Explicit log
	-- below to tell the two cases apart.
	local heldForGrade = 0
	for guid, entry in pairs(inventory) do
		local itemDef = Items[tostring(entry.ItemId)]
		if itemDef then
			if IsPlaceableNow(entry, itemDef, guid) then
				local size = GetEntrySize(entry, itemDef)
				-- Volume as the sort criterion. Unknown size (ItemLoader did not
				-- find the model) -> volume 0, handled last: it passes every size
				-- check, so we may as well not let it take a big slot ahead of
				-- an item whose size we know.
				local volume = 0
				if size then
					volume = size.X * size.Y * size.Z
				end
				table.insert(queue, { guid = guid, entry = entry, itemDef = itemDef, size = size, volume = volume })
			elseif ShouldGradeEntry(entry, itemDef) then
				heldForGrade = heldForGrade + 1
			end
		end
	end

	if heldForGrade > 0 then
		DebugPrint(string.format("[Place] %d item(s) held back waiting for Auto Grade (not a bug -- they'll become placeable once graded)", heldForGrade))
	end

	table.sort(queue, function(a, b)
		if a.volume == b.volume then
			return a.guid < b.guid
		end
		return a.volume > b.volume
	end)

	for _, task_ in ipairs(queue) do
		-- A reload can land mid-pass. The unloaded run no longer hears
		-- PlaceStockItemResult, so without this it kept firing one item every
		-- 3s timeout for ~25s after "[Reload] previous instance unloaded"
		-- (measured 2026-09-13). Same contract as every flag-less loop.
		if not SESSION.alive then
			return placedCount, waitingCount, refusedCount
		end
		local guid = task_.guid
		local entry = task_.entry
		local itemDef = task_.itemDef
		local size = task_.size

		do
			-- First free slot that accepts THIS item.
			local targetIndex = nil
			if usedSlotCount < #freeSlots then
				local si = 1
				while si <= #freeSlots and not targetIndex do
					if not usedSlot[si] and FitsSlot(size, freeSlots[si]) then
						targetIndex = si
					end
					si = si + 1
				end
			end

			if targetIndex then
				local slot = freeSlots[targetIndex]
				local price = ComputeStockPrice(entry, itemDef)
				local rotY = tonumber(itemDef.ShelfRotationY) or 0
				local cframe = slot.attachment.WorldCFrame * CFrame.Angles(0, math.rad(rotY), 0)

				-- Signature confirmed by reading the REAL game script
				-- (Players.<x>.PlayerScripts.ShelfInteraction, docId 113 via
				-- the `real` MCP, 2026-08-25): 10 arguments, NOT 9.
				-- arg7 (stockSurfaceMounted) and arg8 (decorGridStep) MUST be
				-- nil on a snap point (they only serve Build Mode, cf.
				-- Modules.Screens.BuildMode.PlacementSystem which uses them
				-- for real with arg9=false); arg9 = true is the "list for
				-- sale on a shelf slot" flag (not BuildMode).
				-- arg10 = requestId, a GUID generated client-side just before
				-- the call (HttpService:GenerateGUID(false)) -- the game uses
				-- it to correlate the REMOTES.PlaceStockItemResult confirmation.
				-- Our old call omitted it entirely (implicit nil): prime
				-- suspect for silently dropped placements, since the server
				-- could well dedupe/rate-limit requests without a distinct
				-- requestId. We now generate a real GUID on every call, just
				-- as the game does.
				local requestId = HttpService:GenerateGUID(false)

				local fireOk, err = pcall(function()
					REMOTES.PlaceStockItem:FireServer(guid, tostring(entry.ItemId), cframe, price,
						slot.shelfGUID, slot.snapName, nil, nil, true, requestId)
				end)

				if not fireOk then
					warn("[Place] PlaceStockItem failed: " .. tostring(err))
					return placedCount, waitingCount, refusedCount
				end

				-- Waits for the REAL server confirmation (REMOTES.PlaceStockItemResult,
				-- correlated by requestId) instead of guessing via an inventory
				-- count diff after a fixed delay -- more reliable under latency
				-- (the old 0.4s delay could be too short and make us believe a
				-- refusal when the placement was merely slow to confirm).
				-- 3s ceiling: the game itself gives up after 20s (cf.
				-- ShelfInteraction), but AutoPlace runs continuously so there
				-- is no need to wait that long here -- a placement not
				-- confirmed within 3s is treated as refused, and the next pass
				-- will retry if the item is still in the
				-- inventory.
				local waited = 0
				while pendingPlaceRequests[requestId] == nil and waited < 3 do
					task.wait(0.1)
					waited = waited + 0.1
				end

				local record = pendingPlaceRequests[requestId]
				local placed = record ~= nil and record.ok == true
				pendingPlaceRequests[requestId] = nil

				-- The slot is consumed either way: either the item is there, or
				-- the server refused it and retrying with another item would
				-- cost time for probably the same result. The next pass will
				-- pick it up.
				usedSlot[targetIndex] = true
				usedSlotCount = usedSlotCount + 1

				if placed then
					recentlyPlacedSlots[slot.shelfGUID .. "_" .. slot.snapName] = os.clock() + 3
					DebugPrint("[Place] Placed: " .. tostring(entry.ItemId) ..
						" @ $" .. tostring(price) .. " (slot " .. targetIndex .. ")")
					placedCount = placedCount + 1
				else
					-- The server rejected (success != true) or did not reply.
					-- This is NOT "base full": we had a free slot. The Master no
					-- longer blocks on "BASE FULL" for this -- it goes back to
					-- farming and retries next cycle (the transient state, e.g. an
					-- occupied slot not yet streamed, clears by itself).
					refusedCount = refusedCount + 1
					DebugPrint("[Place] Server refused: " .. tostring(entry.ItemId) ..
						" on " .. tostring(slot.shelfGUID) .. "/" .. tostring(slot.snapName))
				end
			else
				-- No FREE slot is suitable.
				if FitsAnySlot(size, allSlots) then
					-- it would fit in an occupied slot -> it is waiting for a sale
					waitingCount = waitingCount + 1
				end
				-- otherwise: too big for this whole plot, silently ignored
			end
		end
	end

	return placedCount, waitingCount, refusedCount
end

-- TRUCK DETECTION / TP ZONES
local function GetTruckDropTarget()
	-- workspace.UnpackZone was NOT present in either 2026-09-08 probe run,
	-- from two different positions, so this primary path is dead and the
	-- fallback below is what actually runs. The check stays because it costs
	-- one lookup and would be the better target if the game ever adds it.
	local unpackZone = workspace:FindFirstChild("UnpackZone")
	if unpackZone then
		local zonePart = unpackZone:IsA("BasePart") and unpackZone or unpackZone:FindFirstChildWhichIsA("BasePart")
		if zonePart then
			return zonePart
		end
	end

	-- Both of these are DebugPrint, not warn: failing to find the plot here
	-- is the normal case at distance, and TPCACHE.Go is what decides whether
	-- it is a real failure (nothing remembered either) or a non-event.
	local plot = GetPlayerPlot()
	if not plot then
		DebugPrint("[TruckTP] Player plot not loaded right now")
		return nil
	end

	local furniture = plot:FindFirstChild("Furniture")
	local fallback = furniture and furniture:FindFirstChild("Parking Space")
	if not fallback then
		DebugPrint("[TruckTP] Parking Space not loaded right now (plot > Furniture > Parking Space)")
		return nil
	end

	return fallback:IsA("BasePart") and fallback or fallback:FindFirstChildWhichIsA("BasePart")
end

local function TeleportToDrop()
	-- Live lookup, then the position remembered at load, then the GPS. The
	-- third tier is what makes this work from across the map: the first two
	-- are both plot geometry, and plot geometry is exactly what streaming
	-- takes away at distance.
	local position = TPCACHE.Resolve("base", GetTruckDropTarget)

	if not position then
		position = TPCACHE.ShopPOI()
		if position then
			TPCACHE.positions["base"] = position
			DebugPrint("[TP] TP base: the plot is not loaded and nothing was remembered, " ..
				"so this used your shop's GPS position")
		end
	end

	if not position then
		warn("[TP] TP base: the plot is not loaded, nothing was remembered this session, and the " ..
			"GPS did not return your shop. Teleport to a nearby area first, then try this again.")
		return false
	end

	return TPCACHE.ToPosition(position)
end

-- TP anchor for AutoPlace: any model from PlayerPlot.Furniture.
-- Placement must land INSIDE the base so that Roblox streaming has
-- loaded the shelves before PlaceItems(), so we do not reuse
-- GetTruckDropTarget (UnpackZone/Parking Space can be off-center
-- relative to the shelves themselves).
local function GetPlotFurnitureAnchor(plot)
	if not plot then
		return nil
	end

	local furniture = plot:FindFirstChild("Furniture")
	if not furniture then
		warn("[AutoPlace] Furniture not found in plot " .. tostring(plot.Name))
		return nil
	end

	local children = furniture:GetChildren()
	DebugPrint("[AutoPlace] Furniture contains " .. #children .. " item(s)")

	for _, model in ipairs(children) do
		local pos = ResolvePosition(model)
		if pos then
			DebugPrint("[AutoPlace] Anchor selected: " .. tostring(model.Name) ..
				string.format(" @ (%.1f, %.1f, %.1f)", pos.X, pos.Y, pos.Z))
			return model
		end
	end

	warn("[AutoPlace] No resolvable model found in " .. tostring(plot.Name) .. ".Furniture")
	return nil
end

-- Every zone/shop TP follows the same scheme: walk a path of child
-- names down from workspace, then TeleportTo. A data table + a
-- resolver replace 8 near-identical functions. Optional poiName: falls
-- back to the GPS position of that name if the workspace path is not
-- loaded and nothing was remembered yet this session.
local function TeleportToPath(path, label, poiName)
	local key = table.concat(path, ".")
	return TPCACHE.Go(key, label or key, function()
		local node = workspace
		for _, name in ipairs(path) do
			node = node:FindFirstChild(name)
			if not node then
				DebugPrint("[TP] workspace." .. key .. " not loaded right now")
				return nil
			end
		end
		return node
	end, poiName and TPCACHE.POIFallback(poiName))
end

-- Seed the base position once at load. You spawn on your own plot when you
-- join, so this is the one moment the Parking Space is certain to be loaded,
-- and it is precisely what TP base cannot resolve later from across the map.
-- One shot, no loop, so a reload cannot leave it running.
task.spawn(function()
	task.wait(5)
	if not SESSION.alive then
		return
	end
	if TPCACHE.Resolve("base", GetTruckDropTarget) then
		DebugPrint("[TP] Base position remembered at load")
	else
		DebugPrint("[TP] Base not loaded at load; TP base will remember it the first time you are there")
	end
end)

-- "Your base" and "your shop" are the same place: the GPS `Player Shop` POI is
-- the plot. There used to be a separate "TP base" button that walked plot
-- geometry instead, which failed from across the map because the plot is not
-- loaded -- so it is gone and this one button answers both. The GPS is a
-- remote and answers at any distance.
TeleportTab:CreateSection("Player")

TeleportTab:CreateButton({
	Name = "TP to Base (your shop)",
	Callback = function()
		-- TeleportToDrop, not the GPS directly: it tries the truck drop point
		-- first, which is the precise spot, and only falls back to the shop
		-- POI when the plot is not loaded. Going straight to the POI would
		-- throw away that precision for nothing.
		TeleportToDrop()
	end,
})

TeleportTab:CreateLabel("If seated in the Truck, it teleports with you")

