-- INVENTORY PROCESSING PIPELINE (Wash + Grade ONLY)
-- PASSIVE only (washing, grading): NEVER moves the player. Placement
-- lives exclusively in the Master Cycle via PlaceItems().
--
-- A handler defines:
--   IsEnabled()
--   PreparePass()   -> shared context (returning false disables the pass)
--   TryHandle(guid, entry, itemDef, context, inventory) -> "stop_pass" |
--       "claimed" | "unhandled"
local ItemHandlers = {}

local function RegisterItemHandler(handler)
	table.insert(ItemHandlers, handler)
end

local function AnyHandlerEnabled()
	for _, handler in ipairs(ItemHandlers) do
		if handler.IsEnabled() then
			return true
		end
	end
	return false
end

local function ProcessInventoryOnePass()
	if not AnyHandlerEnabled() then
		return
	end

	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not ok or type(inventory) ~= "table" then
		return
	end

	local contexts = {}
	for _, handler in ipairs(ItemHandlers) do
		if handler.IsEnabled() and handler.PreparePass then
			contexts[handler] = handler.PreparePass()
		end
	end

	-- Who goes first. `pairs` has no order at all, the slots are few, and a
	-- pass stops handing out work as soon as they are full -- so without this
	-- whichever items come out of the table first win every time. The order
	-- is the user's, from Processing Priority 1..3; see WASHGRADE.RankLess,
	-- which lives further down because a value priority needs
	-- ComputeStockPrice. The def rides along so scoring needs no second lookup.
	local order = {}
	for guid, entry in pairs(inventory) do
		table.insert(order, { guid = guid, entry = entry, def = Items[tostring(entry.ItemId)] })
	end
	table.sort(order, WASHGRADE.RankLess)

	for _, row in ipairs(order) do
		local guid, entry = row.guid, row.entry
		local isGradableFavoritedDrink = entry.Favorited == true and WASHGRADE.gradeEnergyDrinks
			and ENERGY_DRINK_ITEM_IDS[tostring(entry.ItemId)] == true

		if entry.Favorited ~= true or isGradableFavoritedDrink then
			local itemDef = row.def

			if itemDef then
				for _, handler in ipairs(ItemHandlers) do
					if handler.IsEnabled() and contexts[handler] ~= false then
						local result = handler.TryHandle(guid, entry, itemDef, contexts[handler], inventory)

						if result == "stop_pass" then
							return
						elseif result == "claimed" then
							break
						end
					end
				end
			elseif WASHGRADE.gradeEnergyDrinks and ENERGY_DRINK_ITEM_IDS[tostring(entry.ItemId)] then
				-- The other way a drink can be invisible to grading, which
				-- looks exactly like "the toggle does nothing" from outside.
				-- Said once, because this loop runs constantly.
				if not WASHGRADE.drinkNoDefWarned then
					WASHGRADE.drinkNoDefWarned = true
					warn("[AutoGrade] Grade Energy Drinks is on, but the game has no item entry for drink id " ..
						tostring(entry.ItemId) .. " -- it cannot be graded")
				end
			end
		end
	end
end

local function StartInventoryProcessingLoop()
	if LOOPGUARDS.inventoryProcessing then return end
	LOOPGUARDS.inventoryProcessing = true
	task.spawn(function()
		while LOOPGUARDS.inventoryProcessing and AnyHandlerEnabled() do
			-- Same reason as MakeSlotMachine.StartLoop: without this pcall, an
			-- error in a pass (Wash/Grade/Vault combined -- this is THE loop
			-- that sends items into the free slots) silently killed the
			-- coroutine -- no item is ever sent to a slot again, while the
			-- toggle stays ON and StartLoop() (which ONLY claims/collects
			-- already-occupied slots) keeps running with nothing to process.
			-- Symptom on the user side: Auto Wash/Grade/Vault "stops by
			-- itself" with no visible warn.
			local passOk, passErr = pcall(ProcessInventoryOnePass)
			if not passOk then
				warn("[InventoryPipeline] Pass failed, continuing: " .. tostring(passErr))
			end
			task.wait(1)
		end
		LOOPGUARDS.inventoryProcessing = false
	end)
end

-- ITEM CLASSIFICATION (shared by Wash / Grade / Place)
-- These predicates are deliberately standalone: PlaceItems() reuses
-- them without going through the pipeline, which lets placement live
-- entirely in the Master Cycle without depending on the handlers.
local function IsEntryDirty(entry)
	if type(entry.Mutators) ~= "table" then
		return false
	end
	for _, mutator in ipairs(entry.Mutators) do
		if type(mutator) == "table" and mutator.name == "Dirty" then
			return true
		end
	end
	return false
end

local function IsEntryGraded(entry)
	return entry.Grade ~= nil
end

-- SLOT MACHINES (Wash / Grade) -- shared factory
--
-- Same mechanic for both: unlocked slots -> start -> collect at
-- expiry -> claim. Only the remotes, the "ready to claim" field
-- (Washed/Grade) and the predicate vary. PASSIVE: never touch the HRP.
local function MakeSlotMachine(cfg)
	local evts = Events:WaitForChild(cfg.folder)
	local m = {
		getState = evts:WaitForChild("GetSlotState"),
		startRemote = evts:WaitForChild(cfg.startRemote),
		collectRemote = evts:WaitForChild(cfg.collectRemote),
		claimRemote = evts:WaitForChild(cfg.claimRemote),
		tag = cfg.tag,
		readyField = cfg.readyField,
		guardKey = cfg.guardKey,
		IsActive = cfg.IsActive,
		ShouldHandle = cfg.ShouldHandle,
		-- Optional: custom predicate for "ready to claim", when it is not
		-- a simple truthy field (e.g. Locksmith -- RewardItemId OR
		-- RewardDiamonds>0, not a single boolean). If absent, behavior is
		-- unchanged (Wash/Grade keep reading just readyField).
		IsReady = cfg.IsReady,
		-- guid -> os.clock() until which we do not retry sending this item
		-- to a slot (the server just refused it). Prevents a single "toxic"
		-- item from freezing the whole send queue.
		failedGuids = {},
		-- Seconds past the timer before collecting, and the pause between
		-- two remote calls. The server rate-limits these remotes ("Too fast").
		COLLECT_MARGIN = 2,
		CALL_SPACING = 1,
		-- os.clock() until which no Start is sent, set after a "Too fast".
		backoffUntil = 0,
	}

	-- The server reports a free slot as an EMPTY TABLE, not as nil (seen on
	-- TimeCapsule.GetSlotStates 2026-10-11: slots = { [1] = {} }). `{}` is
	-- truthy in Lua, so `if slots[i]` called every emptied slot occupied and
	-- nothing was ever sent again after the first claim. Keys may also come
	-- back as numbers or strings, so read both.
	function m.SlotData(slots, i)
		local d = slots[tostring(i)]
		if d == nil then
			d = slots[i]
		end
		if d == true then
			return true -- our own "just filled this pass" marker
		end
		if type(d) ~= "table" or next(d) == nil then
			return nil
		end
		return d
	end

	local function IsTooFast(r)
		return type(r) == "table" and type(r.error) == "string"
			and string.find(string.lower(r.error), "too fast", 1, true) ~= nil
	end

	function m.State()
		local ok, s = pcall(function()
			return m.getState:InvokeServer()
		end)
		if not ok or type(s) ~= "table" then
			warn("[" .. m.tag .. "] GetSlotState failed: " .. tostring(s))
			return 0, {}
		end
		return s.unlockedCount or 1, s.slots or {}
	end

	-- Map index -> "ready_to_collect" | "ready_to_claim". Empty slots or
	-- ones still running are not listed: nothing to do with them.
	function m.ReadySlots()
		local unlocked, slots = m.State()
		local now = workspace:GetServerTimeNow()
		local ready = {}
		for i = 1, unlocked do
			local d = m.SlotData(slots, i)
			if type(d) == "table" then
				local isReady = m.IsReady and m.IsReady(d) or d[m.readyField]
				if isReady then
					ready[i] = "ready_to_claim"
				-- Margin: the server answers "Too fast" when we collect on the
				-- exact tick the client clock says the timer ended.
				elseif ((d.StartTime or 0) + (d.Duration or 0)) - now <= -m.COLLECT_MARGIN then
					ready[i] = "ready_to_collect"
				end
			end
		end
		return ready
	end

	function m.Claim(i)
		local ok, r = pcall(function()
			return m.claimRemote:InvokeServer(i)
		end)
		if ok and r and r.success then
			DebugPrint("[" .. m.tag .. "] Slot " .. i .. " claimed")
		else
			warn("[" .. m.tag .. "] Claim slot " .. i .. " failed: " .. tostring(r and r.error))
		end
	end

	function m.Process(i, status)
		if status == "ready_to_claim" then
			m.Claim(i)
			return
		end
		local ok, r = pcall(function()
			return m.collectRemote:InvokeServer(i)
		end)
		if ok and r and r.success then
			DebugPrint("[" .. m.tag .. "] Slot " .. i .. " collected")
			task.wait(m.CALL_SPACING)
			m.Claim(i)
		else
			warn("[" .. m.tag .. "] Collect slot " .. i .. " failed: " .. tostring(r and r.error))
		end
	end

	function m.StartLoop()
		if LOOPGUARDS[m.guardKey] then
			return
		end
		LOOPGUARDS[m.guardKey] = true
		task.spawn(function()
			while m.IsActive() and LOOPGUARDS[m.guardKey] do
				-- pcall around the pass: an unexpected error here (e.g. a missing
				-- field on a slot, a remote returning an unexpected shape)
				-- silently killed the whole coroutine without touching the toggle
				-- -- the loop guard then stayed stuck at true forever (the next
				-- StartLoop() becomes a no-op), which shows up user-side as "Auto
				-- Wash/Grade stops by itself" with no visible warn. We log and
				-- continue rather than letting the error escape the while
				-- loop.
				local passOk, passErr = pcall(function()
					for i, status in pairs(m.ReadySlots()) do
						m.Process(i, status)
						task.wait(m.CALL_SPACING)
					end
				end)
				if not passOk then
					warn("[" .. m.tag .. "] Loop pass failed, continuing: " .. tostring(passErr))
				end
				task.wait(5)
			end
			LOOPGUARDS[m.guardKey] = false
		end)
	end

	RegisterItemHandler({
		IsEnabled = m.IsActive,

		PreparePass = function()
			local unlocked, slots = m.State()
			-- Purge guids whose failure cooldown has expired (see below).
			local now = os.clock()
			for g, until_ in pairs(m.failedGuids) do
				if until_ <= now then
					m.failedGuids[g] = nil
				end
			end
			return { unlockedCount = unlocked, slots = slots }
		end,

		TryHandle = function(guid, entry, itemDef, ctx)
			if not m.ShouldHandle(entry, itemDef) then
				return "unhandled"
			end

			-- Item the server already refused recently: we skip it (return
			-- "unhandled" = we continue with the OTHER items in the pass).
			-- BEFORE, a failure did "return stop_pass" and a single item
			-- that the server rejects repeatedly (often because it is
			-- already somewhere server-side, or an unexpected response
			-- shape) froze the WHOLE queue: nothing was ever sent to a slot
			-- again while the toggle stayed ON.
			-- Symptom on the user side: "Auto Wash / Auto Grade is playing
			-- up / does nothing any more".
			if m.failedGuids[guid] and m.failedGuids[guid] > os.clock() then
				return "unhandled"
			end

			local slot = nil
			for i = 1, ctx.unlockedCount do
				if not m.SlotData(ctx.slots, i) then
					slot = i
					break
				end
			end

			if not slot then
				return "claimed"
			end

			-- Rate-limited a moment ago: the item waits for a later pass
			-- rather than being sent into another "Too fast".
			if m.backoffUntil > os.clock() then
				return "claimed"
			end

			local ok, r = pcall(function()
				return m.startRemote:InvokeServer(slot, guid, "Inventory", nil)
			end)
			if ok and IsTooFast(r) then
				-- Not the item's fault: do not park it for 30s, just back off.
				m.backoffUntil = os.clock() + 3
				DebugPrint("[" .. m.tag .. "] Start rate-limited, backing off 3s")
				return "claimed"
			end
			if ok and r and r.success then
				DebugPrint("[" .. m.tag .. "] Item " .. tostring(guid) .. " sent to slot " .. slot)
				ctx.slots[tostring(slot)] = true
				task.wait(m.CALL_SPACING)
				-- "claimed" (not "stop_pass"): if another slot is free, the same
				-- pass can send another item to it instead of waiting for the
				-- next loop iteration.
				return "claimed"
			end

			-- Failure: we mark the item so it is not retried for 30s, and we
			-- CONTINUE the pass ("unhandled") instead of stopping everything.
			m.failedGuids[guid] = os.clock() + 30
			warn("[" .. m.tag .. "] Start failed for " .. tostring(guid) .. " (skipped 30s): " .. tostring(ok and r and r.error or r))
			return "unhandled"
		end,
	})

	return m
end

-- Forward declaration: ComputeStockPrice is defined further down (the
-- placement section) but Wash's max-value filter and ShouldGradeEntry both
-- need it here. The "local" keyword was removed from its real definition;
-- do NOT put it back, or you create a second variable and every reference
-- above that point stays nil forever.
local ComputeStockPrice

-- WHO GOES FIRST when the slots are few.
--
-- This orders the ONE pass that feeds both Wash and Grade, so it is not a
-- grading-only setting however it is labelled. It exists because `pairs` has
-- no order, the slots are few, and a pass stops handing out work as soon as
-- they are full -- so whichever items come out of the table first win every
-- time. That is the whole of "drinks are never graded": nothing rejected
-- them, they simply never got a slot. Energy drinks stay priority 1 by
-- default, which is the behaviour this replaces.
--
-- Deliberately no "Rarest first": the game ships no rarity ranking
-- (`Modules.Rarities` is a colour table, measured again 2026-09-12), so any
-- order would be one this script invented. Value is the honest stand-in.
WASHGRADE.PRIORITY_OPTIONS = {
	"None",
	"Energy drinks",
	"Safes (vault items)",
	"Limited items",
	"Highest value",
	"Lowest value",
	"Heaviest",
	"Lightest",
}

-- Computed once per item per pass, not once per comparison: table.sort calls
-- the comparator O(n log n) times and ComputeStockPrice is not free.
function WASHGRADE.RowValue(row)
	if row.value == nil then
		local ok, price = pcall(ComputeStockPrice, row.entry, row.def)
		if ok and type(price) == "number" then
			row.value = price
		else
			row.value = 0
		end
	end
	return row.value
end

function WASHGRADE.RowWeight(row)
	if row.weight == nil then
		local weight = row.entry.Weight
		if type(weight) ~= "number" and type(row.def) == "table" then
			weight = row.def.Weight
		end
		if type(weight) ~= "number" then
			weight = 0
		end
		row.weight = weight
	end
	return row.weight
end

-- Higher score goes first. Each option is one sort key; the three slots
-- compose, so "Safes, then Highest value" is safes first and the dearest safe
-- at the front of those.
function WASHGRADE.PriorityScore(name, row)
	if name == "Energy drinks" then
		if ENERGY_DRINK_ITEM_IDS[tostring(row.entry.ItemId)] == true then
			return 1
		end
		return 0
	elseif name == "Safes (vault items)" then
		if type(row.def) == "table" and row.def.SafeId ~= nil then
			return 1
		end
		return 0
	elseif name == "Limited items" then
		if type(row.def) == "table" and row.def.Limited == true then
			return 1
		end
		return 0
	elseif name == "Highest value" then
		return WASHGRADE.RowValue(row)
	elseif name == "Lowest value" then
		return -WASHGRADE.RowValue(row)
	elseif name == "Heaviest" then
		return WASHGRADE.RowWeight(row)
	elseif name == "Lightest" then
		return -WASHGRADE.RowWeight(row)
	end
	return 0
end

function WASHGRADE.RankLess(a, b)
	for slot = 1, 3 do
		local name = WASHGRADE.priority[slot]
		if name ~= nil then
			local scoreA = WASHGRADE.PriorityScore(name, a)
			local scoreB = WASHGRADE.PriorityScore(name, b)
			if scoreA ~= scoreB then
				return scoreA > scoreB
			end
		end
	end
	-- Arbitrary but STABLE: the same order every pass, so a tie cannot
	-- reshuffle and starve whoever lost the last one.
	return a.guid < b.guid
end

-- One callback for all three slots, same shape as GARAGEPRIORITY's: RayVoid
-- hands back either a table or a bare string depending on the version.
function WASHGRADE.MakePriorityCallback(slot)
	return function(selected)
		local value = selected
		if type(selected) == "table" then
			value = selected[1]
		end
		if value == nil or value == "None" then
			WASHGRADE.priority[slot] = nil
		else
			WASHGRADE.priority[slot] = value
		end
	end
end

