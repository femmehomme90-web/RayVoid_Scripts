local recentlyPlacedSlots = {}




-- Price floor: an item whose computed price falls below this is NEVER
-- placed. This is the safeguard against the server-side
-- BasePriceOverride=0 bug, which put items up for sale at $0 (unsellable,
-- no NPC buyer comes). We prefer to leave the item in the inventory.
