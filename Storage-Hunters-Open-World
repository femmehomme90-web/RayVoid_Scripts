-- =========================================================
-- ENERGY DRINKS (Auto-Buy + Auto-Use)
-- Static catalog id -> {Name, ItemId, MinNetWorth, ...} from
-- Modules.EnergyDrinks. Buying: EnergyShop.GetCatalog (live stock/price)
-- + EnergyShop.BuyDrink (1 unit/call). Use: UI.UseEnergyDrink(guid),
-- guid resolved from the inventory (same ItemIds as the catalog).
-- UI in its own "AutoBuy Drink" tab.
-- =========================================================
local ENERGYDRINK = {
	Catalog = SafeRequire(ReplicatedStorage.Modules.EnergyDrinks, "EnergyDrinks") or {},
	GetCatalog = Events:WaitForChild("EnergyShop"):WaitForChild("GetCatalog"),
	BuyDrink = Events:WaitForChild("EnergyShop"):WaitForChild("BuyDrink"),
	UseEnergyDrink = Events:WaitForChild("UI"):WaitForChild("UseEnergyDrink"),
	autoBuyEnabled = false,
	autoBuySelected = {}, -- set of drink ids ("1","2","3")
	autoUseEnabled = false,
	autoUseSelected = {},
	-- If active, RunAutoUsePass drinks NOTHING until ALL the types checked
	-- in "Drinks to Use" are simultaneously available in the inventory --
	-- drinking the stacks together maximizes luck instead of wasting the
	-- boost piecemeal, one type at a time.
	autoUseRequireAllTypes = false,
	-- Stop buying a tier once this many of it are already in the inventory.
	-- 0 = no target, which is the old behaviour: buy out the whole stock.
	-- Counted PER CHECKED TYPE, not as a combined total, because the auto-use
	-- side drinks one of each type together for maximum luck -- a target of 5
	-- means five of every checked drink, i.e. five full combined doses.
	stockTarget = 0,
	itemIdToDrinkId = {}, -- reverse map, built below
	-- Accessory loadout worn while drinking. Off by default; when on, the
	-- pass wears loadoutIndex, drinks, and puts the previous one straight
	-- back. loadoutIndex is the game's own 1-5 slot number.
	loadoutEnabled = false,
	loadoutIndex = nil,
	loadoutDropdown = nil,
	loadoutWarned = false,
	-- Set when a switch-back failed (auction still running) so the drink was
	-- spent but the player is left in the drink loadout. Must survive to the
	-- NEXT pass rather than being forgotten -- otherwise that pass sees the
	-- drink loadout already active, assumes it's the correct baseline, and
	-- never goes back. Measured: this is what left the player
	-- stuck in the drink loadout indefinitely.
	pendingRestore = nil,
	-- True for the WHOLE window between wearing the drink loadout and
	-- confirming the switch back -- not just after a failed restore
	-- (pendingRestore). TryEnterNextAuction checks this too: without it, a
	-- new auction starting in the gap between drinking and switching back is
	-- exactly what blocks that switch back. Measured 2026-09-12.
	swapInProgress = false,
}

for drinkId, def in pairs(ENERGYDRINK.Catalog) do
	if type(def) == "table" and def.ItemId then
		ENERGYDRINK.itemIdToDrinkId[tostring(def.ItemId)] = drinkId
	end
end

-- Same read as EnergyShop.lua (leaderstats["Net Worth"], RawValue
-- attribute first, fallback on the displayed Value).
function ENERGYDRINK.GetLocalNetWorth()
	local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
	local netWorthStat = leaderstats and leaderstats:FindFirstChild("Net Worth")
	if not netWorthStat then
		return 0
	end
	local raw = netWorthStat:GetAttribute("RawValue")
	if type(raw) == "number" then
		return raw
	end
	return tonumber(tostring(netWorthStat.Value):gsub("[^%d%.%-]", "")) or 0
end

function ENERGYDRINK.RunAutoBuyPass()
	if not ENERGYDRINK.autoBuyEnabled or next(ENERGYDRINK.autoBuySelected) == nil then
		return
	end

	local ok, data = pcall(function()
		return ENERGYDRINK.GetCatalog:InvokeServer()
	end)
	if not ok or type(data) ~= "table" or type(data.Drinks) ~= "table" then
		warn("[EnergyDrink] GetCatalog failed: " .. tostring(data))
		return
	end

	local netWorth = ENERGYDRINK.GetLocalNetWorth()

	-- How many of each checked type we already hold. Only read when a target
	-- is set, so the no-target path costs no extra remote call.
	local heldByDrinkId = {}
	if ENERGYDRINK.stockTarget > 0 then
		local invOk, inventory = pcall(function()
			return REMOTES.GetPlayerInventory:InvokeServer()
		end)
		if not invOk or type(inventory) ~= "table" then
			-- Without a count there is no way to respect the target, and
			-- buying blind would empty the shop -- exactly what the target
			-- exists to prevent. Skip this pass and say so.
			warn("[EnergyDrink] GetPlayerInventory failed, cannot honour the stock target this pass: " ..
				tostring(inventory))
			return
		end
		for _, entry in pairs(inventory) do
			local drinkId = ENERGYDRINK.itemIdToDrinkId[tostring(entry.ItemId)]
			if drinkId then
				heldByDrinkId[drinkId] = (heldByDrinkId[drinkId] or 0) + 1
			end
		end
	end

	-- Eligible tiers (checked, unlocked, in stock, below target).
	local entries = {}
	for _, drink in ipairs(data.Drinks) do
		local drinkId = tostring(drink.EnergyDrinkId)
		if ENERGYDRINK.autoBuySelected[drinkId] then
			local stock = drink.StockRemaining or 0
			local minNetWorth = drink.MinNetWorth or 0
			-- want = how many more of this tier to buy. Without a target the
			-- ceiling is the safety cap, i.e. the old buy-everything pass.
			local want = 400
			if ENERGYDRINK.stockTarget > 0 then
				want = ENERGYDRINK.stockTarget - (heldByDrinkId[drinkId] or 0)
			end

			if stock <= 0 then
				DebugPrint("[EnergyDrink] " .. tostring(drink.Name) .. " out of stock, skipping")
			elseif netWorth < minNetWorth then
				DebugPrint("[EnergyDrink] " .. tostring(drink.Name) .. " locked (Net Worth too low)")
			elseif want <= 0 then
				DebugPrint("[EnergyDrink] " .. tostring(drink.Name) .. " at target (" ..
					tostring(heldByDrinkId[drinkId] or 0) .. "/" .. ENERGYDRINK.stockTarget ..
					"), not buying")
			else
				table.insert(entries, { id = drink.EnergyDrinkId, name = drink.Name,
					stock = stock, bought = 0, want = want, active = true })
			end
		end
	end

	-- Round-robin: one purchase per active tier per wave, rather than
	-- exhausting the first tier before touching the next -- otherwise a
	-- big stock on tier 1 delays tier 2 by several seconds.
	local boughtTotal = 0
	local safetyCap = 400 -- global, all tiers combined
	local remaining = #entries

	while remaining > 0 and boughtTotal < safetyCap do
		remaining = 0
		for _, entry in ipairs(entries) do
			if entry.active then
				local buyOk, result = pcall(function()
					return ENERGYDRINK.BuyDrink:InvokeServer(entry.id)
				end)
				if buyOk and type(result) == "table" and result.success then
					entry.bought = entry.bought + 1
					boughtTotal = boughtTotal + 1
					entry.stock = result.stockRemaining or (entry.stock - 1)
					if entry.stock <= 0 or entry.bought >= entry.want then
						entry.active = false
					end
				else
					warn("[EnergyDrink] BuyDrink failed for " .. tostring(entry.name) .. ": " ..
						tostring(buyOk and result and result.error or result))
					entry.active = false
				end
				if entry.active then
					remaining = remaining + 1
				end
			end
		end
	end

	if boughtTotal >= safetyCap then
		warn("[EnergyDrink] Safety cap hit during auto-buy, stock may not be decreasing")
	end

	for _, entry in ipairs(entries) do
		if entry.bought > 0 then
			DebugPrint("[EnergyDrink] Bought " .. entry.bought .. "x " .. tostring(entry.name))
		end
	end
end

function ENERGYDRINK.RunAutoUsePass()
	if not ENERGYDRINK.autoUseEnabled or next(ENERGYDRINK.autoUseSelected) == nil then
		return
	end

	-- A previous pass drank successfully but the swap back failed (the
	-- auction was still running). That debt does not clear itself -- pay it
	-- before anything else, and hold off on drinking again until it does, or
	-- the player stays stuck in the drink loadout forever.
	if ENERGYDRINK.pendingRestore then
		local backOk, backErr = ENERGYDRINK.ActivateLoadout(ENERGYDRINK.pendingRestore)
		if backOk then
			DebugPrint("[EnergyDrink] Loadout " .. ENERGYDRINK.pendingRestore .. " put back on (retried)")
			ENERGYDRINK.pendingRestore = nil
		else
			DebugPrint("[EnergyDrink] Still owe a switch back to loadout " ..
				ENERGYDRINK.pendingRestore .. ": " .. tostring(backErr))
			return
		end
	end

	-- With the loadout option on, an auction is the wrong moment to drink:
	-- swapping accessories mid-lot is the thing the option exists to avoid,
	-- and a drink taken without the loadout is a drink wasted. Sit the
	-- auction out; the next pass is 10s away.
	if ENERGYDRINK.loadoutEnabled and ENERGYDRINK.loadoutIndex then
		local busy = AUCTION.BusyReason()
		if busy then
			DebugPrint("[EnergyDrink] Holding the drinks back: " .. busy)
			return
		end
	end

	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not ok or type(inventory) ~= "table" then
		warn("[EnergyDrink] GetPlayerInventory failed: " .. tostring(inventory))
		return
	end

	-- Groups the available GUIDs by drinkId, once for this pass: used for
	-- normal consumption AND for the "all types available" check.
	local availableByDrinkId = {}
	for guid, entry in pairs(inventory) do
		local drinkId = ENERGYDRINK.itemIdToDrinkId[tostring(entry.ItemId)]
		if drinkId and ENERGYDRINK.autoUseSelected[drinkId] then
			local list = availableByDrinkId[drinkId]
			if not list then
				list = {}
				availableByDrinkId[drinkId] = list
			end
			table.insert(list, guid)
		end
	end

	-- "Only Use When All Selected Available": maximizes luck by drinking
	-- all the checked types AT THE SAME TIME rather than piecemeal, one
	-- by one as soon as each is available -- which would waste the
	-- cumulative boost window of the other types not yet in stock. If a
	-- SINGLE checked type is missing, we drink NOTHING this pass and wait
	-- for the inventory (or the next purchase) to complete the set.
	if ENERGYDRINK.autoUseRequireAllTypes then
		for drinkId in pairs(ENERGYDRINK.autoUseSelected) do
			if not availableByDrinkId[drinkId] then
				DebugPrint("[EnergyDrink] Require-all-types: missing " ..
					tostring(ENERGYDRINK.Catalog[drinkId] and ENERGYDRINK.Catalog[drinkId].Name or drinkId) ..
					", skipping this pass")
				return
			end
		end
	end

	-- Nothing in stock this pass: no loadout churn for an empty round.
	if next(availableByDrinkId) == nil then
		return
	end

	-- The game REFUSES to change accessories during an auction -- measured
	-- Straight out of the remote's own reply. Auto Farm is in an
	-- auction most of the time, so trying anyway meant a refusal on nearly
	-- every pass. Wait for a gap instead; drinks keep, the boost does not.
	-- AUCTION.BusyReason is the single definition of "mid-auction" here.
	if ENERGYDRINK.loadoutEnabled and ENERGYDRINK.loadoutIndex then
		local busy = AUCTION.BusyReason()
		if busy then
			DebugPrint("[EnergyDrink] Not drinking yet: accessories cannot be changed while "
				.. tostring(busy) .. ", and a loadout was asked for.")
			return
		end
	end

	-- Accessories on before the first sip, off again after the last one.
	-- A false here means the switch could not be done, and the drinks are
	-- kept rather than spent without the loadout that was asked for.
	--
	-- swapInProgress covers this WHOLE window, through the restore below --
	-- not just a failed restore (pendingRestore, which only exists once a
	-- restore has already failed once). TryEnterNextAuction checks it too:
	-- without it, a new auction starting in the gap between drinking and the
	-- switch-back attempt is exactly what causes that switch-back to fail.
	-- Every exit path below clears it; the unconditional clear at the very
	-- end of the function is the backstop for the one that doesn't return
	-- early.
	local restoreTo = nil
	if ENERGYDRINK.loadoutEnabled and ENERGYDRINK.loadoutIndex then
		ENERGYDRINK.swapInProgress = true
		restoreTo = ENERGYDRINK.WearDrinkLoadout()
		if restoreTo == false then
			ENERGYDRINK.swapInProgress = false
			return
		end
	end

	-- Last gate before spending anything: the loadout was confirmed worn a
	-- moment ago, but reading the inventory and grouping it took time and a
	-- swap can be undone by the game (a respawn, the player's own click). A
	-- drink spent without the accessories is exactly what this feature exists
	-- to prevent, so it is checked here rather than assumed.
	if ENERGYDRINK.loadoutEnabled and ENERGYDRINK.loadoutIndex then
		local worn, why = ENERGYDRINK.LoadoutIsWorn(ENERGYDRINK.loadoutIndex)
		if not worn then
			warn("[EnergyDrink] Loadout " .. tostring(ENERGYDRINK.loadoutIndex) ..
				" is no longer worn (" .. tostring(why) .. "), so nothing is being drunk this pass.")
			if restoreTo then
				ENERGYDRINK.ActivateLoadout(restoreTo)
			end
			ENERGYDRINK.swapInProgress = false
			return
		end
	end

	-- The boosts stack: no reason to hold back, we consume EVERY copy
	-- found this pass. Spaced rather than fired back to back -- the pawn
	-- shop's rate limiter taught us the server answers "too fast" before it
	-- answers anything useful, and a drink the server drops is a drink gone.
	local drunk = 0
	for drinkId, guids in pairs(availableByDrinkId) do
		for _, guid in ipairs(guids) do
			if drunk > 0 then
				task.wait(ENERGYDRINK.DRINK_SPACING)
			end
			local useOk, useErr = pcall(function()
				ENERGYDRINK.UseEnergyDrink:FireServer(guid)
			end)
			if useOk then
				drunk = drunk + 1
				print("[EnergyDrink] Drank " .. tostring(ENERGYDRINK.Catalog[drinkId] and ENERGYDRINK.Catalog[drinkId].Name)
					.. (ENERGYDRINK.loadoutIndex and (" wearing loadout " .. ENERGYDRINK.loadoutIndex) or ""))
			else
				warn("[EnergyDrink] UseEnergyDrink failed: " .. tostring(useErr))
			end
		end
	end

	-- Hold the loadout on after the last sip. UseEnergyDrink is a fire-and-
	-- forget event with no result to wait on, so the server is still granting
	-- the boost when this line runs; switching back on the next instruction is
	-- what made the accessories miss the grant.
	if restoreTo and drunk > 0 then
		task.wait(ENERGYDRINK.DRINK_HOLD)
	end

	-- Switch back rather than waiting for the boost to expire: the boost
	-- length is not something the script can read, and leaving the player in
	-- the wrong accessories indefinitely is the worse failure.
	if restoreTo then
		local backOk, backErr = ENERGYDRINK.ActivateLoadout(restoreTo)
		if backOk then
			DebugPrint("[EnergyDrink] Loadout " .. restoreTo .. " put back on")
		else
			warn("[EnergyDrink] Drank, but could not switch back to loadout " ..
				tostring(restoreTo) .. ": " .. tostring(backErr) .. " -- will retry next pass")
			ENERGYDRINK.pendingRestore = restoreTo
		end
	end
	ENERGYDRINK.swapInProgress = false
end

-- ACCESSORY LOADOUT AROUND DRINKING
-- The luck accessories only matter for the few seconds the boost is being
-- granted, so wearing them permanently is not what the player wants: the pass
-- swaps to the chosen loadout, drinks, and swaps straight back.
--
-- Both remotes are read-only-ish and cheap. GetAccessoryLoadouts returns
-- { activeIndex = n, names = {["1"]="Luck", ...}, unlockedCount = n, ... },
-- and ActivateAccessoryLoadout takes the INDEX 1-5, not the name.
-- FindFirstChild, not WaitForChild: a missing folder must fail the feature
-- loudly, not hang the whole script at load.
ENERGYDRINK.AccessoriesFolder = Events:FindFirstChild("Accessories")
ENERGYDRINK.GetLoadouts = ENERGYDRINK.AccessoriesFolder
	and ENERGYDRINK.AccessoriesFolder:FindFirstChild("GetAccessoryLoadouts")
ENERGYDRINK.SetLoadout = ENERGYDRINK.AccessoriesFolder
	and ENERGYDRINK.AccessoriesFolder:FindFirstChild("ActivateAccessoryLoadout")
-- The one that says what is ACTUALLY on the character, slot -> { guid = },
-- rather than what the server has filed as the active slot number. Measured
-- ActiveIndex and the equipped GUIDs are two different facts and
-- the first flips first, which is how drinks were being spent bare.
ENERGYDRINK.GetEquipped = ENERGYDRINK.AccessoriesFolder
	and ENERGYDRINK.AccessoriesFolder:FindFirstChild("GetEquippedAccessories")

-- How long to let the swap settle once the server agrees it is done, and how
-- long to hold the drink loadout on after the last sip. The user reported
-- losing "SO many potions" to a swap that had not landed and
-- asked for at least a full second; these are that, with the verification
-- below doing the actual work.
ENERGYDRINK.LOADOUT_SETTLE = 1.25
ENERGYDRINK.DRINK_HOLD = 1.5
ENERGYDRINK.DRINK_SPACING = 0.35

-- Whole payload, or nil plus the reason.
function ENERGYDRINK.ReadLoadouts()
	if not ENERGYDRINK.GetLoadouts then
		return nil, "the game has no Accessories.GetAccessoryLoadouts remote"
	end
	local ok, data = pcall(function()
		return ENERGYDRINK.GetLoadouts:InvokeServer()
	end)
	if not ok or type(data) ~= "table" then
		return nil, tostring(data)
	end
	return data
end

-- What the loadout SAYS it contains: slot -> item GUID. The table comes back
-- keyed either by the number or by its string, depending on how the payload
-- crossed the wire, so both are tried.
function ENERGYDRINK.LoadoutGuids(data, index)
	local all = data and data.loadouts
	if type(all) ~= "table" then
		return nil
	end
	local entry = all[index]
	if type(entry) ~= "table" then
		entry = all[tostring(index)]
	end
	if type(entry) ~= "table" then
		return nil
	end
	local guids = {}
	for slot, guid in pairs(entry) do
		if type(guid) == "string" then
			guids[tostring(slot)] = guid
		end
	end
	return guids
end

-- What is ACTUALLY on the character right now: slot -> item GUID.
function ENERGYDRINK.EquippedGuids()
	if not ENERGYDRINK.GetEquipped then
		return nil, "the game has no Accessories.GetEquippedAccessories remote"
	end
	local ok, data = pcall(function()
		return ENERGYDRINK.GetEquipped:InvokeServer()
	end)
	if not ok or type(data) ~= "table" then
		return nil, tostring(data)
	end
	local guids = {}
	for slot, info in pairs(data) do
		if type(info) == "table" and type(info.guid) == "string" then
			guids[tostring(slot)] = info.guid
		end
	end
	return guids
end

-- Is every accessory the loadout names actually worn, and nothing else?
function ENERGYDRINK.LoadoutIsWorn(index)
	local data = ENERGYDRINK.ReadLoadouts()
	if not data then
		return false, "could not read the loadouts"
	end
	if tonumber(data.activeIndex) ~= index then
		return false, "the server still has loadout " .. tostring(data.activeIndex) .. " active"
	end
	local want = ENERGYDRINK.LoadoutGuids(data, index)
	if not want then
		-- No slot list for it at all. activeIndex agreeing is then the only
		-- fact available, and saying so beats inventing a stricter check.
		return true
	end
	local worn, why = ENERGYDRINK.EquippedGuids()
	if not worn then
		return false, "could not read the equipped accessories: " .. tostring(why)
	end
	for slot, guid in pairs(want) do
		if worn[slot] ~= guid then
			return false, "the " .. slot .. " slot is not wearing what loadout " .. index .. " asks for"
		end
	end
	for slot, guid in pairs(worn) do
		if want[slot] ~= guid then
			return false, "the " .. slot .. " slot is still wearing something the loadout does not ask for"
		end
	end
	return true
end

-- Switch, then CONFIRM -- twice, and on the character rather than on a flag.
--
-- The old version asked only whether the server's `activeIndex` had become the
-- target and returned the instant it had. That number flips when the request
-- is FILED, not when the accessories are on the avatar, so the drink went down
-- during the swap and the boost was lost. The user counted the cost in wasted
-- potions.
--
-- So now: wait for activeIndex AND for every GUID the loadout names to be the
-- GUID actually equipped in that slot (GetEquippedAccessories), then let it
-- settle for a full second and check the whole thing AGAIN, because a swap
-- that is still in flight can pass one instant and fail the next.
function ENERGYDRINK.ActivateLoadout(index)
	if not ENERGYDRINK.SetLoadout then
		return false, "the game has no Accessories.ActivateAccessoryLoadout remote"
	end

	local ok, reply = pcall(function()
		if ENERGYDRINK.SetLoadout:IsA("RemoteFunction") then
			return ENERGYDRINK.SetLoadout:InvokeServer(index)
		end
		ENERGYDRINK.SetLoadout:FireServer(index)
		return nil
	end)
	if not ok then
		return false, tostring(reply)
	end

	-- The server ANSWERS, and the old code threw the answer away. Measured
	-- ActivateAccessoryLoadout returns
	-- { success = false, error = "Accessories can't be changed during an
	-- auction." } and the script then sat out its whole timeout waiting for a
	-- flag the server had already refused to set. A refusal is now reported in
	-- the game's own words, immediately.
	if type(reply) == "table" and reply.success == false then
		return false, tostring(reply.error or "the server refused the loadout change")
	end

	local lastWhy = "the server never reported loadout " .. tostring(index) .. " as active"
	local deadline = os.clock() + 8
	while os.clock() < deadline do
		task.wait(0.2)
		local worn, why = ENERGYDRINK.LoadoutIsWorn(index)
		if worn then
			-- Settle, then re-confirm. This is the "at least a full second"
			-- the user asked for, spent AFTER the swap looks done rather than
			-- as a blind sleep before it.
			task.wait(ENERGYDRINK.LOADOUT_SETTLE)
			local stillWorn, stillWhy = ENERGYDRINK.LoadoutIsWorn(index)
			if stillWorn then
				return true
			end
			lastWhy = "the swap did not hold: " .. tostring(stillWhy)
		else
			lastWhy = tostring(why)
		end
	end
	return false, lastWhy
end

-- "1 - Luck" style entries, capped at what the player has actually unlocked.
-- Warns on the way out rather than returning an empty list quietly: a dropdown
-- with nothing in it looks like "no loadouts" when it means "could not ask".
function ENERGYDRINK.BuildLoadoutOptions()
	local data, why = ENERGYDRINK.ReadLoadouts()
	if not data then
		warn("[EnergyDrink] Could not read your accessory loadouts: " .. tostring(why) ..
			" -- the Loadout to Wear list stays empty")
		return {}
	end

	local unlocked = tonumber(data.unlockedCount) or 0
	local names = type(data.names) == "table" and data.names or {}
	local options = {}
	for index = 1, 5 do
		if index <= unlocked then
			local label = names[tostring(index)] or names[index]
			table.insert(options, index .. " - " .. tostring(label or ("Loadout " .. index)))
		end
	end
	return options
end

function ENERGYDRINK.RefreshLoadoutOptions()
	local options = ENERGYDRINK.BuildLoadoutOptions()
	if #options == 0 then
		return
	end

	local dropdown = ENERGYDRINK.loadoutDropdown
	if dropdown and dropdown.Refresh then
		pcall(function()
			dropdown:Refresh(options)
		end)
	end
end

-- Wears the chosen loadout. Returns the index to put back afterwards, or
-- nil when nothing needed changing, or false when it could not be done --
-- and false means the caller must NOT drink, because drinking without the
-- accessories is exactly what this option exists to prevent.
function ENERGYDRINK.WearDrinkLoadout()
	local target = ENERGYDRINK.loadoutIndex
	if not target then
		return nil
	end

	local data, why = ENERGYDRINK.ReadLoadouts()
	if not data then
		if not ENERGYDRINK.loadoutWarned then
			ENERGYDRINK.loadoutWarned = true
			warn("[EnergyDrink] Cannot read the accessory loadouts, so nothing is being drunk: " .. tostring(why))
		end
		return false
	end

	local previous = tonumber(data.activeIndex)
	if previous == target then
		-- "Already active" is a claim about the server's bookkeeping, not about
		-- the avatar, so it is checked against the equipped accessories before
		-- being believed. If the avatar disagrees, fall through and re-activate.
		local worn, why = ENERGYDRINK.LoadoutIsWorn(target)
		if worn then
			DebugPrint("[EnergyDrink] Loadout " .. target .. " is already worn, no switch needed")
			return nil
		end
		DebugPrint("[EnergyDrink] The server says loadout " .. target ..
			" is active but " .. tostring(why) .. " -- re-activating it")
		local reOk, reErr = ENERGYDRINK.ActivateLoadout(target)
		if not reOk then
			if not ENERGYDRINK.loadoutWarned then
				ENERGYDRINK.loadoutWarned = true
				warn("[EnergyDrink] Loadout " .. target ..
					" will not go on, so nothing is being drunk: " .. tostring(reErr))
			end
			return false
		end
		ENERGYDRINK.loadoutWarned = false
		return nil
	end

	local ok, err = ENERGYDRINK.ActivateLoadout(target)
	if not ok then
		if not ENERGYDRINK.loadoutWarned then
			ENERGYDRINK.loadoutWarned = true
			warn("[EnergyDrink] Could not switch to loadout " .. target ..
				", so nothing is being drunk: " .. tostring(err))
		end
		return false
	end

	ENERGYDRINK.loadoutWarned = false
	DebugPrint("[EnergyDrink] Wearing loadout " .. target .. " for the drink (was " .. tostring(previous) .. ")")
	return previous
end

ENERGYDRINK.intervalSeconds = 10

function ENERGYDRINK.Start()
	if LOOPGUARDS.energyDrink then return end
	LOOPGUARDS.energyDrink = true
	task.spawn(function()
		while (ENERGYDRINK.autoBuyEnabled or ENERGYDRINK.autoUseEnabled) and LOOPGUARDS.energyDrink do
			ENERGYDRINK.RunAutoBuyPass()
			ENERGYDRINK.RunAutoUsePass()
			task.wait(ENERGYDRINK.intervalSeconds)
		end
		LOOPGUARDS.energyDrink = false
	end)
end

-- Options sorted by numeric id (1, 2, 3...) for a stable order.
local ENERGYDRINK_OPTIONS = (function()
	local ids = {}
	for drinkId in pairs(ENERGYDRINK.Catalog) do
		table.insert(ids, drinkId)
	end
	table.sort(ids, function(a, b)
		return (tonumber(a) or 0) < (tonumber(b) or 0)
	end)
	local names = {}
	for _, drinkId in ipairs(ids) do
		table.insert(names, ENERGYDRINK.Catalog[drinkId].Name or ("Drink " .. drinkId))
	end
	return names, ids
end)()

-- RayVoid dropdowns return display names; we look up the matching
-- drink id from that name to build the set expected by
-- RunAutoBuyPass/RunAutoUsePass.
local function EnergyDrinkNameToId(name)
	for drinkId, def in pairs(ENERGYDRINK.Catalog) do
		if def.Name == name then
			return drinkId
		end
	end
	return nil
end

