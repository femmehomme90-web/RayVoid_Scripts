	local closeButton = Instance.new("TextButton")
	closeButton.Name = "CloseButton"
	closeButton.AnchorPoint = Vector2.new(1, 0.5)
	closeButton.Position = UDim2.new(1, -8, 0.5, 0)
	closeButton.Size = UDim2.fromOffset(28, 28)
	closeButton.BackgroundColor3 = Color3.fromRGB(60, 20, 20)
	closeButton.Font = Enum.Font.GothamBold
	closeButton.TextSize = 16
	closeButton.TextColor3 = Color3.fromRGB(255, 200, 200)
	closeButton.Text = "✕"
	closeButton.AutoButtonColor = true
	closeButton.Parent = titleBar

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 6)
	closeCorner.Parent = closeButton

	closeButton.MouseButton1Click:Connect(EVENTPREDICT.Close)

	-- Dragging: drag from the title bar. Standard Roblox pattern
	-- (InputBegan captures the start point + the frame's start position,
	-- InputChanged applies the delta, InputEnded stops it).
	-- Works with mouse AND touch (UserInputType.Touch).
	do
		local dragging = false
		local dragInputPos = nil
		local windowStartPos = nil

		titleBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragInputPos = input.Position
				windowStartPos = main.Position

				local connection
				connection = input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						connection:Disconnect()
					end
				end)
			end
		end)

		titleBar.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragInputPos
				main.Position = UDim2.new(
					windowStartPos.X.Scale, windowStartPos.X.Offset + delta.X,
					windowStartPos.Y.Scale, windowStartPos.Y.Offset + delta.Y
				)
			end
		end)
	end

	-- Body: scrollable list of events
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "List"
	scroll.Position = UDim2.fromOffset(0, 40)
	scroll.Size = UDim2.new(1, 0, 1, -40)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = main

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 6)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = scroll

	local listPadding = Instance.new("UIPadding")
	listPadding.PaddingTop = UDim.new(0, 10)
	listPadding.PaddingLeft = UDim.new(0, 12)
	listPadding.PaddingRight = UDim.new(0, 12)
	listPadding.PaddingBottom = UDim.new(0, 10)
	listPadding.Parent = scroll

	if #predictions == 0 then
		local emptyLabel = Instance.new("TextLabel")
		emptyLabel.BackgroundTransparency = 1
		emptyLabel.Size = UDim2.new(1, 0, 0, 60)
		emptyLabel.Font = Enum.Font.Gotham
		emptyLabel.TextSize = 14
		emptyLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
		emptyLabel.TextWrapped = true
		emptyLabel.Text = "No prediction data available (SpecialEventManager/SpecialEventConfig failed to load)."
		emptyLabel.Parent = scroll
		return
	end

	-- One row per event, created ONCE (by name, never recreated -- only
	-- LayoutOrder/Text/Color updated; UIListLayout reorders by itself
	-- without the flicker of a Destroy+recreate).
	--
	-- Two separate rhythms, not one:
	--   - Every SECOND: just a local computation (entry.nextStart/
	--     activeEndsAt already known - os.time()), zero calls to the game.
	--     That is what makes the countdown tick visibly.
	--   - Every REFRESH_INTERVAL seconds: actually calls
	--     GetEventPredictions() again and reloads the cache -- the only
	--     moment we go back to querying SpecialEventManager, to catch a
	--     real state change (an event starting/ending, reordering) without
	--     doing it on every display tick.
	local REFRESH_INTERVAL = 30

	local rowByName = {}
	local cachedPredictions = predictions

	for i, entry in ipairs(predictions) do
		local row = Instance.new("Frame")
		row.Name = entry.name
		row.LayoutOrder = i
		row.Size = UDim2.new(1, 0, 0, 44)
		row.BackgroundColor3 = Color3.fromRGB(38, 38, 46)
		row.BorderSizePixel = 0
		row.Parent = scroll

		local rowCorner = Instance.new("UICorner")
		rowCorner.CornerRadius = UDim.new(0, 8)
		rowCorner.Parent = row

		local nameLabel = Instance.new("TextLabel")
		nameLabel.BackgroundTransparency = 1
		nameLabel.Position = UDim2.fromOffset(12, 0)
		nameLabel.Size = UDim2.new(0.55, -12, 1, 0)
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextSize = 14
		nameLabel.TextColor3 = Color3.fromRGB(235, 235, 235)
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.Text = entry.name
		nameLabel.Parent = row

		local valueLabel = Instance.new("TextLabel")
		valueLabel.BackgroundTransparency = 1
		valueLabel.Position = UDim2.new(0.55, 0, 0, 0)
		valueLabel.Size = UDim2.new(0.45, -12, 1, 0)
		valueLabel.Font = Enum.Font.Gotham
		valueLabel.TextSize = 13
		valueLabel.TextColor3 = Color3.fromRGB(200, 200, 210)
		valueLabel.TextXAlignment = Enum.TextXAlignment.Right
		valueLabel.Text = "..."
		valueLabel.Parent = row

		rowByName[entry.name] = { frame = row, valueLabel = valueLabel }
	end

	-- Paints each row's text/color from the local cache
	-- (cachedPredictions) -- NO call to the game here, just arithmetic on
	-- already known values. Does NOT touch LayoutOrder: the order is only
	-- reevaluated by RefreshFromGame (otherwise the list would visually
	-- reorder every second for nothing as long as no real state change has
	-- happened).
	local function UpdateCountdownText()
		local now = os.time()
		for _, entry in ipairs(cachedPredictions) do
			local row = rowByName[entry.name]
			if row then
				if entry.activeNow then
					row.valueLabel.Text = "Active - ends in " .. EVENTPREDICT.FormatDuration((entry.activeEndsAt or now) - now)
					row.valueLabel.TextColor3 = Color3.fromRGB(120, 230, 140)
				elseif entry.nextStart then
					row.valueLabel.Text = "in " .. EVENTPREDICT.FormatDuration(entry.nextStart - now)
					row.valueLabel.TextColor3 = Color3.fromRGB(200, 200, 210)
				elseif not entry.scheduled then
					row.valueLabel.Text = "not scheduled"
					row.valueLabel.TextColor3 = Color3.fromRGB(160, 160, 170)
				else
					row.valueLabel.Text = "unknown"
					row.valueLabel.TextColor3 = Color3.fromRGB(160, 160, 170)
				end
			end
		end
	end

	-- ACTUALLY re-queries the game (GetEventPredictions), replaces the
	-- cache, and reorders the rows (LayoutOrder) accordingly. This is the
	-- only place that goes back to talking to SpecialEventManager once the
	-- window is open.
	local function RefreshFromGame()
		cachedPredictions = EVENTPREDICT.GetPredictions()
		for i, entry in ipairs(cachedPredictions) do
			local row = rowByName[entry.name]
			if row then
				row.frame.LayoutOrder = i
			end
		end
		UpdateCountdownText()
	end

	UpdateCountdownText()

	-- Single loop: visual countdown every second (local computation), and
	-- resynchronization with the game only every REFRESH_INTERVAL seconds.
	-- Stops by itself as soon as the window is closed (screenGui.Parent
	-- becomes nil after :Destroy()).
	task.spawn(function()
		local secondsSinceRefresh = 0
		while screenGui.Parent do
			task.wait(1)
			if not screenGui.Parent then
				break
			end
			secondsSinceRefresh = secondsSinceRefresh + 1
			if secondsSinceRefresh >= REFRESH_INTERVAL then
				secondsSinceRefresh = 0
				RefreshFromGame()
			else
				UpdateCountdownText()
			end
		end
	end)
end

