local function CountInventoryItems(inventory)
	local count = 0
	for _ in pairs(inventory) do
		count = count + 1
	end
	return count
end

local function GetInventoryCapacityInfo()
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not ok or type(inventory) ~= "table" then
		return nil, nil
	end

	local count = CountInventoryItems(inventory)
	local capacity = LocalPlayer:GetAttribute("InventoryCap")
	return count, capacity
end

-- True if the inventory exceeds `threshold` (fraction 0-1) of its capacity.
-- Acts as a safeguard for forced placement when "Place every N" > 1: we
-- trigger the unload BEFORE total saturation, so we do not collect into
-- a full inventory on the next container. If capacity is unknown, false.
local function IsInventoryNearFull(threshold)
	local count, capacity = GetInventoryCapacityInfo()
	if not count or not capacity or capacity <= 0 then
		return false
	end
	return count >= capacity * threshold
end

