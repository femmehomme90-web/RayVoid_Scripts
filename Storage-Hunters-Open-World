-- J opens and closes the rule editor, next to RayVoid's own K for the main
-- window. It is a real keybind control rather than a hardcoded key, because
-- RayVoid's own Settings tab lists only its own shortcut -- so a key of ours
-- that lives nowhere in the UI is one the user cannot see or change
-- (2026-09-12). Having a Flag also means the choice travels with the config
-- slot like everything else.
--
-- The control stores and displays the key; the listener below is what acts on
-- it. RayVoid's keybind also fires its callback on press, which here just
-- re-reads the same key -- harmless, and it keeps one owner of the toggle.
RULES.ED.HOTKEY = "J"
ItemRulesTab:CreateKeybind({
	Name = "Rule editor key",
	CurrentKeybind = "J",
	HoldToInteract = false,
	Flag = "ItemRulesHotkey",
	Callback = function(key)
		local name = tostring(key)
		if Enum.KeyCode[name] then
			RULES.ED.HOTKEY = name
		end
	end,
})

-- ...and then MOVE it next to RayVoid's own "Show/hide key", because that is
-- where a person looks for a shortcut. RayVoid builds its Settings tab itself
-- and gives us no handle on it, but the built page is an ordinary
-- ScrollingFrame, so the control we just made is reparented into it directly.
--
-- Every element on that page ships with LayoutOrder 0 and the layout sorts by
-- LayoutOrder, so inserting means renumbering: walk the page in its current
-- order, hand out 1, 2, 3..., and give ours the slot straight after
-- "Show/hide key". Done in a pcall -- the library is fetched from GitHub at
-- runtime, so if its Settings page ever changes shape the keybind simply
-- stays on the Item Rules tab and nothing breaks.
pcall(function()
	local rayfield = game:GetService("CoreGui"):FindFirstChild("RobloxGui")
	rayfield = rayfield and rayfield:FindFirstChild("Rayfield")
	local elements = rayfield and rayfield:FindFirstChild("Main")
	elements = elements and elements:FindFirstChild("Elements")
	local settings = elements and elements:FindFirstChild("Rayfield Settings")
	local ours = RULES.page and RULES.page:FindFirstChild("Rule editor key")
	if not (settings and ours) then
		return
	end

	local order = {}
	for _, child in ipairs(settings:GetChildren()) do
		if child:IsA("GuiObject") and child.Name ~= "Placeholder" then
			table.insert(order, child)
		end
	end
	ours.Parent = settings

	-- `slot`, not `next`: shadowing the global next() inside a file that uses
	-- it for table iteration is an ambush waiting for the next editor.
	local slot = 1
	for _, child in ipairs(order) do
		child.LayoutOrder = slot
		slot = slot + 1
		if child.Name == "Show/hide key" then
			ours.LayoutOrder = slot
			slot = slot + 1
		end
	end
	-- "Show/hide key" was not found, so it never got placed: park it at the end
	-- rather than leaving it at 0 and jumping to the top of the page.
	if ours.LayoutOrder == 0 then
		ours.LayoutOrder = slot
	end
end)

