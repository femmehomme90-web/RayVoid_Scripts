	local ground, groundIsNever = RULES.PickupBlind(RULES.ED.current)
	if #ground > 0 and groundIsNever then
		RULES.ED.Label(pane, "! \"Never pick up\" cannot see " .. table.concat(ground, ", ") .. ".",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "  An item on the ground has no KG and no buff %, and leaving one",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "  behind cannot be undone, so this never refuses one out there.",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "  Add \"Never sell / place / grade\" to act on it in your bag.",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
	elseif #ground > 0 then
		RULES.ED.Label(pane, "i  On the ground, pickup ignores " .. table.concat(ground, ", ") .. ".",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "  An item lying there only shows its name, category, rarity,",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "  condition and mutation names -- KG and % appear in the bag.",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "  So it is taken on the rest, and the full rule then decides what",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "  happens to it (sell / place / grade).",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
