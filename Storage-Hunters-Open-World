-- Flattens whatever shape the lane handed us into { name, luck } pairs.
-- A workspace carryable yields plain names (ReadMutatorNames) and a decoded
-- inventory entry yields { name = , luck = } tables; only the second carries
-- the per-item roll, so a name-only lane simply has no luck to test.
--
-- "Mint" is injected as a synthetic mutation when the item's Condition says so.
-- It is derived from Condition by the game's own IsMint/MINT_CONDITION and
-- never lands in the Mutators array, so without this a line naming Mint could
-- never match. Injected with no luck, so it can satisfy "has Mint" but never a
-- percentage threshold -- which is the truth about it.
function RULES.MutationList(context)
	local list = {}
	if type(context.mutations) == "table" then
		for _, mutation in ipairs(context.mutations) do
			if type(mutation) == "table" then
				list[#list + 1] = { name = mutation.name, luck = mutation.luck }
			elseif type(mutation) == "string" then
				list[#list + 1] = { name = mutation, luck = nil }
			end
		end
	end
	if context.condition ~= nil and IsMintCondition(context.condition) then
		list[#list + 1] = { name = "Mint", luck = nil }
	end
	return list
end

-- An alternative the user has actually filled in. A blank one -- no mutation
-- picked and no percentage typed -- is the row the editor puts there when you
-- add a line, and it must count for NOTHING. It used to count as "any mutation
-- at all", so clicking "+ Add setup" armed the rule against every item
-- carrying any mutation; with an effect already ticked that is a farm-wide
-- change from one click. Found 2026-09-12 by driving the real window, not by
-- reading this code -- the same way the last one was found.
function RULES.AltArmed(alt)
	return type(alt) == "table" and (alt.mutation ~= nil or alt.minPercent ~= nil)
end

-- Can this alternative say anything on a lane with `blind` channels? An alt
-- whose ONLY content is a percentage says nothing at all where percentages
-- cannot be read: dropping the % would turn "any mutation at 100%" into "any
-- mutation whatsoever", the widest rule there is made out of the narrowest.
-- So it is unevaluable there and accepts nothing, rather than everything.
function RULES.AltEvaluable(alt, blind)
	if not RULES.AltArmed(alt) then
		return false
	end
	if blind and blind.percent and alt.mutation == nil then
		return false
	end
	return true
end

function RULES.LineEvaluable(line, blind)
	if type(line) ~= "table" or type(line.alts) ~= "table" then
		return false
	end
	for _, alt in ipairs(line.alts) do
		if RULES.AltEvaluable(alt, blind) then
			return true
		end
	end
	return false
end

-- "Armed" is "evaluable by a lane that can see everything". One definition,
-- not two: a second copy of this test is exactly how the tab once rendered
-- "No rules set" over a rule that was matching.
function RULES.LineArmed(line)
	return RULES.LineEvaluable(line, nil)
end

-- One alternative: a mutation name (or the explicit "Any mutation"), optionally
-- with a minimum %. Choosing "Any mutation" deliberately IS stored, so that
-- "any mutation at 100%+" stays sayable while a blank row stays inert.
function RULES.AltAccepts(alt, mutation, blind)
	if alt.mutation ~= nil and alt.mutation ~= RULES.ANY_MUTATION then
		if type(mutation.name) ~= "string" or mutation.name ~= alt.mutation then
			return false
		end
	end
	if alt.minPercent ~= nil and not (blind and blind.percent) then
		-- luck is stored as a fraction (0.47) and read by the user as a
		-- percentage (47%) -- confirmed with them 2026-09-11. A mutation with
		-- no luck at all (a flag like Dirty, or any name-only lane) cannot
		-- satisfy a threshold, which is an honest "unknown" rather than a pass.
		if type(mutation.luck) ~= "number" or (mutation.luck * 100) < alt.minPercent then
			return false
		end
	end
	return true
end

-- A line is satisfied by ONE mutation matching ANY of its alternatives. That
-- is how "(100% diamond OR 50% corrupted)" is a single line rather than two
-- near-identical setups -- the thresholds differ per alternative, which a flat
-- set of names could never express.
function RULES.LineAccepts(line, mutation, blind)
	for _, alt in ipairs(line.alts) do
		if RULES.AltEvaluable(alt, blind) and RULES.AltAccepts(alt, mutation, blind) then
			return true
		end
	end
	return false
end

-- Every armed line must be satisfied by a DIFFERENT mutation on the item, so
-- "Secret >=50 + Secret >=50" needs two separate Secrets and cannot be
-- satisfied twice by one. That is an assignment problem, solved by
-- backtracking -- at most four lines against a handful of mutations, so the
-- search is nothing.
function RULES.LinesSatisfied(setup, context)
	local blind = context.blind
	local lines = {}
	for _, line in ipairs(setup.lines) do
		if RULES.LineEvaluable(line, blind) then
			lines[#lines + 1] = line
		end
	end
	if #lines == 0 then
		return true
	end

	local muts = RULES.MutationList(context)
	if #muts < #lines then
		return false
	end

	local used = {}
	local function assign(index)
		if index > #lines then
			return true
		end
		for m = 1, #muts do
			if not used[m] and RULES.LineAccepts(lines[index], muts[m], blind) then
				used[m] = true
				if assign(index + 1) then
					return true
				end
				used[m] = false
			end
		end
		return false
	end
	return assign(1)
end

-- The user's "SUM", chosen deliberately over the product (2026-09-11): a
-- higher product can mean a worse gavel to upgrade with. nil when the lane
-- carries no luck at all, so a total rule cannot match rather than matching 0.
function RULES.SumPercent(context)
	local total, seen = 0, false
	for _, mutation in ipairs(RULES.MutationList(context)) do
		if type(mutation.luck) == "number" then
			total = total + (mutation.luck * 100)
			seen = true
		end
	end
	if not seen then
		return nil
	end
	return total
end

-- Has the user actually put something in this setup? An empty setup is
-- ignored rather than treated as "anything qualifies" -- same reasoning as an
-- empty rule matching nothing.
function RULES.SetupArmed(setup)
	if type(setup) ~= "table" then
		return false
	end
	if setup.sumMin ~= nil then
		return true
	end
	for _, line in ipairs(setup.lines or {}) do
		if RULES.LineArmed(line) then
			return true
		end
	end
	return false
end

function RULES.AnySetupArmed(rule)
	for _, setup in ipairs(rule.setups or {}) do
		if RULES.SetupArmed(setup) then
			return true
		end
	end
	return false
end

-- Everything inside one setup ANDs together.
function RULES.SetupMatches(setup, context)
	local blind = context.blind
	if not RULES.LinesSatisfied(setup, context) then
		return false
	end
	if setup.sumMin ~= nil and not (blind and blind.sumPercent) then
		local total = RULES.SumPercent(context)
		if total == nil or total < setup.sumMin then
			return false
		end
	end
	return true
end

-- Does this setup have anything left once the lane's blind channels are
-- removed? A setup made only of percentages is silent on the ground, and a
-- silent setup must be skipped rather than treated as satisfied -- otherwise
-- "150% total" would qualify every item lying there.
function RULES.SetupEvaluable(setup, blind)
	if not RULES.SetupArmed(setup) then
		return false
	end
	if setup.sumMin ~= nil and not (blind and blind.sumPercent) then
		return true
	end
	for _, line in ipairs(setup.lines or {}) do
		if RULES.LineEvaluable(line, blind) then
			return true
		end
	end
	return false
end

-- "Which items is this rule about" -- the four identity lists combine by the
-- rule's own ALL / ANY switch (rule.matchAll). Fixed OR was tried first, on
-- the theory that people mean "gavels, or anything Legendary"; the user built
-- "Accessories + Limited" meaning AND, and it blocked every Limited item from
-- the shelves (2026-09-13). Fixed AND would have broken their saved "Weapon +
-- Gold Nugget" rule instead, and "names are OR, the rest AND" was rejected as
-- a hidden exception. Value, weight and the setups AND on top either way.
function RULES.IdentitySet(rule)
	return RULES.AnySet(rule.names) or RULES.AnySet(rule.categories)
		or RULES.AnySet(rule.rarities) or RULES.AnySet(rule.traits)
		or RULES.AnySet(rule.mutationNames)
end

-- One identity row against the item. Only called for a row that is filled in.
-- A field the lane cannot know (nil) fails the row: an honest "unknown".
function RULES.RowMatches(rule, row, context)
	if row == "names" then
		return context.name ~= nil and rule.names[context.name] == true
	elseif row == "categories" then
		return context.category ~= nil and rule.categories[context.category] == true
	elseif row == "rarities" then
		return context.rarity ~= nil and rule.rarities[context.rarity] == true
	elseif row == "traits" then
		if type(context.traits) ~= "table" then
			return false
		end
		for trait in pairs(rule.traits) do
			if context.traits[trait] then
				return true
			end
		end
	elseif row == "mutationNames" then
		-- Name-only: reuses the same flattening the Setup engine uses (so
		-- ground/pre-win mutation names and the synthetic Mint both work
		-- here too), but ignores luck entirely -- a tick here means "has it
		-- at all", never "at N%+".
		for _, m in ipairs(RULES.MutationList(context)) do
			if rule.mutationNames[m.name] then
				return true
			end
		end
	end
	return false
end

RULES.IDENTITY_ROWS = { "names", "categories", "rarities", "traits", "mutationNames" }

-- `skipRows` (optional, {rowName = true}) leaves a filled row out of the
-- verdict entirely -- used only by UnmatchableNames below, never by a real
-- lane: a lane must judge every row it can, but a STATIC check over an item
-- DEFINITION has no honest answer for a row that is rolled per instance.
function RULES.IdentityMatches(rule, context, skipRows)
	for _, row in ipairs(RULES.IDENTITY_ROWS) do
		if not (skipRows and skipRows[row]) and RULES.AnySet(rule[row]) then
			local passed = RULES.RowMatches(rule, row, context)
			if rule.matchAll and not passed then
				return false
			end
			if not rule.matchAll and passed then
				return true
			end
		end
	end
	-- ALL: every filled row passed (IdentitySet guarantees there was one).
	-- ANY: none did.
	if rule.matchAll then
		return true
	end
	return false
end

-- On ALL, a named item whose own category / rarity / Is boxes fail the other
-- rows can never match -- "Gold Pan" + Accessories is a rule about nothing,
-- since a Gold Pan is always a Tool. The editor shows these instead of
-- letting the rule sit there looking configured. `lookup(name)` returns a list
-- of { def = , id = } (an item name can have more than one definition); a
-- name is only reported when EVERY definition fails, and an unknown name is
-- not reported at all -- that would be claiming something we did not check.
function RULES.UnmatchableNames(rule, lookup)
	local out = {}
	if not rule.matchAll or not RULES.AnySet(rule.names) then
		return out
	end
	if not (RULES.AnySet(rule.categories) or RULES.AnySet(rule.rarities) or RULES.AnySet(rule.traits)) then
		return out
	end
	for name in pairs(rule.names) do
		local defs = lookup(name)
		if type(defs) == "table" and #defs > 0 then
			local any = false
			for _, entry in ipairs(defs) do
				local context = {
					name = name,
					category = entry.def.Category,
					rarity = entry.def.Rarity,
					traits = RULES.TraitsFor(entry.def, entry.id),
				}
				-- Mutations roll per instance; no item DEFINITION can rule
				-- one in or out, so this row is skipped here rather than
				-- reported as an impossible combination.
				if RULES.IdentityMatches(rule, context, { mutationNames = true }) then
					any = true
				end
			end
			if not any then
				table.insert(out, name)
			end
		end
	end
	table.sort(out)
	return out
end

-- Has the user put ANY criterion in this rule? One list, in one place, because
-- there were two and the copy drifted: a rule configured only with buff lines
-- rendered as "No rules set" while matching perfectly well, which is the exact
-- "control that lies about itself" failure this tab exists to avoid. Caught
-- 2026-09-11 by driving the real UI rather than by reading the code.
function RULES.RuleHasCriteria(rule)
	return RULES.IdentitySet(rule) or rule.minValue ~= nil or rule.maxValue ~= nil
		or rule.weightMin ~= nil or rule.weightMax ~= nil or RULES.AnySetupArmed(rule)
end

-- Does this rule say anything at all? A rule nobody has touched must never
-- match, so this is the gate before any matching happens.
function RULES.RuleIsArmed(rule)
	if not RULES.AnySet(rule.effects) then
		return false
	end
	return RULES.RuleHasCriteria(rule)
end

-- `context` is built by the caller, because the five lanes hold genuinely
-- different data (a workspace carryable's attributes vs. a decoded inventory
-- entry vs. a live auction lot) and value means a different thing in each --
-- there are three separate price formulas in this file and inventing a
-- fourth here would silently disagree with all of them.
--
--   { name, category, rarity, mutations, condition, value, weight, traits }
--
-- Any field the caller cannot know is left nil, and a rule that tests it
-- then cannot match -- an honest "unknown", not a false positive.
function RULES.Matches(rule, context)
	local blind = context.blind
	-- Did we actually get to test anything? A rule reduced to nothing by the
	-- lane's blind channels must match NOTHING, exactly as an empty rule does.
	-- Without this, "over 100 KG -> never pick up" would become "never pick up
	-- anything" the moment it hit the ground.
	local tested = false

	-- 1. Is this one of the items the rule is about?
	if RULES.IdentitySet(rule) then
		if not RULES.IdentityMatches(rule, context) then
			return false
		end
		tested = true
	end
	-- 2. Value always ANDs on top of identity.
	if rule.minValue ~= nil then
		if type(context.value) ~= "number" or context.value < rule.minValue then
			return false
		end
		tested = true
	end
	if rule.maxValue ~= nil then
		if type(context.value) ~= "number" or context.value > rule.maxValue then
			return false
		end
		tested = true
	end
	-- 3. So does weight, and for the same reason: it describes the item, not
	-- its buffs. A lane that cannot know the weight leaves it nil, and a rule
	-- testing it then cannot match -- an honest "unknown", not a pass. Where
	-- the whole LANE is blind to weight (pickup), the test is skipped instead:
	-- see the `blind` note on RULES.LANES for why that is safe there only.
	if not (blind and blind.weight) then
		if rule.weightMin ~= nil then
			if type(context.weight) ~= "number" or context.weight < rule.weightMin then
				return false
			end
			tested = true
		end
		if rule.weightMax ~= nil then
			if type(context.weight) ~= "number" or context.weight > rule.weightMax then
				return false
			end
			tested = true
		end
	end
	-- 4. If the rule lists setups the lane can read, ANY ONE qualifying is
	-- enough. Setups the lane is blind to are skipped, not failed.
	local sawSetup = false
	for _, setup in ipairs(rule.setups or {}) do
		if RULES.SetupEvaluable(setup, blind) then
			sawSetup = true
			if RULES.SetupMatches(setup, context) then
				return true
			end
		end
	end
	if sawSetup then
		return false
	end
	return tested
end

-- Is any rule at all going to speak about this lane? Every call site asks
-- this BEFORE building a context, because building one costs a JSON decode
-- and a price calculation per item and the overwhelmingly common case is
-- that the tab is empty.
function RULES.LaneArmed(lane)
	local laneEffects = RULES.LANES[lane]
	if not laneEffects then
		return false
	end
	for i = 1, RULES.COUNT do
		local rule = RULES.rules[i]
		if ((laneEffects.force and rule.effects[laneEffects.force])
			or (laneEffects.block and rule.effects[laneEffects.block]))
			and RULES.RuleIsArmed(rule) then
			return true
		end
	end
	return false
end

function RULES.Decide(lane, context)
	local laneEffects = RULES.LANES[lane]
	if not laneEffects then
		return nil
	end
	for i = 1, RULES.COUNT do
		local rule = RULES.rules[i]
		local forceSet = laneEffects.force and rule.effects[laneEffects.force]
		local blockSet = laneEffects.block and rule.effects[laneEffects.block]
		-- Blind channels are skipped for the FORCE half only, and that
		-- asymmetry is the whole safety of the idea. Widening an "always pick
		-- up" costs nothing: the item comes home and sell / place / grade then
		-- judge it on the full rule. Widening a "never pick up" leaves items
		-- on the ground for good, and nothing runs afterwards to correct it.
		-- So: pick it up on what you can read, but never refuse on something
		-- you could not check.
		context.blind = nil
		if not blockSet then
			context.blind = laneEffects.blind
		end
		if (forceSet or blockSet) and RULES.RuleIsArmed(rule) and RULES.Matches(rule, context) then
			RULES.lastRule = i
			-- Block wins inside a single rule: ticking both halves is a
			-- contradiction, and the safe reading of "never sell" is to keep.
			if blockSet then
				return "block"
			end
			return "force"
		end
	end
	return nil
end

-- ---------------------------------------------------------
-- Plain English, used by the tab summary AND by the editor window, so the
-- two can never describe the same rule differently.
-- ---------------------------------------------------------
function RULES.NamesOf(set, limit)
	local names = {}
	for name in pairs(set) do
		table.insert(names, name)
	end
	table.sort(names)
	if limit and #names > limit then
		return #names .. " selected"
	end
	return table.concat(names, " / ")
end

function RULES.DescribeAlt(alt)
	if not RULES.AltArmed(alt) then
		return "(not set)"
	end
	local who = alt.mutation or RULES.ANY_MUTATION
	if alt.minPercent then
		return who .. " " .. tostring(alt.minPercent) .. "%+"
	end
	return who
end

function RULES.DescribeLine(line)
	local parts = {}
	for _, alt in ipairs(line.alts) do
		if RULES.AltArmed(alt) then
			table.insert(parts, RULES.DescribeAlt(alt))
		end
	end
	if #parts == 0 then
		return ""
	end
	if #parts == 1 then
		return parts[1]
	end
	return "(" .. table.concat(parts, " or ") .. ")"
end

function RULES.DescribeSetup(setup)
	local parts = {}
	for _, line in ipairs(setup.lines or {}) do
		if RULES.LineArmed(line) then
			table.insert(parts, RULES.DescribeLine(line))
		end
	end
	if setup.sumMin then
		table.insert(parts, "all buffs total " .. tostring(setup.sumMin) .. "%+")
	end
	if #parts == 0 then
		return "(empty)"
	end
	return table.concat(parts, " + ")
end

function RULES.Describe(i)
	local rule = RULES.rules[i]
	local head = "Rule " .. i .. (rule.label ~= "" and (" \"" .. rule.label .. "\"") or "")

	local who = {}
	if RULES.AnySet(rule.names) then
		table.insert(who, "named " .. RULES.NamesOf(rule.names, 3))
	end
	if RULES.AnySet(rule.categories) then
		table.insert(who, "category " .. RULES.NamesOf(rule.categories, 3))
	end
	if RULES.AnySet(rule.rarities) then
		table.insert(who, "rarity " .. RULES.NamesOf(rule.rarities, 3))
	end
	if RULES.AnySet(rule.traits) then
		table.insert(who, "is " .. RULES.NamesOf(rule.traits, 3))
	end
	if RULES.AnySet(rule.mutationNames) then
		table.insert(who, "mutation " .. RULES.NamesOf(rule.mutationNames, 3))
	end

	local parts = {}
	if #who > 0 then
		table.insert(parts, table.concat(who, rule.matchAll and " and " or " or "))
	else
		table.insert(parts, "any item")
	end
	if rule.minValue then
		table.insert(parts, "worth " .. tostring(rule.minValue) .. "+")
	end
	if rule.maxValue then
		table.insert(parts, "worth " .. tostring(rule.maxValue) .. " or less")
	end
	if rule.weightMin then
		table.insert(parts, tostring(rule.weightMin) .. "KG or heavier")
	end
	if rule.weightMax then
		table.insert(parts, tostring(rule.weightMax) .. "KG or lighter")
	end

	local setupText = {}
	for _, setup in ipairs(rule.setups or {}) do
		if RULES.SetupArmed(setup) then
			table.insert(setupText, RULES.DescribeSetup(setup))
		end
	end

	local effects = {}
	for effect in pairs(rule.effects) do
		table.insert(effects, effect)
	end
	table.sort(effects)

	if not RULES.RuleHasCriteria(rule) and #effects == 0 then
		return head .. ": empty, does nothing."
	end
	if not RULES.RuleHasCriteria(rule) then
		return head .. ": NOT ACTIVE -- effects set but nothing to match on."
	end

	local body = table.concat(parts, ", ")
	if #setupText > 0 then
		body = body .. " that is " .. table.concat(setupText, ", OR ")
	end

	if #effects == 0 then
		return head .. ": NOT ACTIVE -- matches " .. body .. " but has no effect ticked."
	end
	return head .. ": " .. body .. "  ->  " .. table.concat(effects, ", ")
end

-- The tab shows one BOX per rule rather than one paragraph holding all eight:
-- eight long sentences in a single box is a wall, and the user could not keep
-- a visual overview of it (2026-09-12). So each rule answers three short
-- questions instead -- who am I, what do I match, what do I do -- and the
-- reader's eye gets the box borders to land on.
--
-- Returns title, whatItMatches, whatItDoes. Deliberately SHORTER than
-- Describe(): the full expansion lives in the editor window, this is the
-- glance. Kept under about 60 characters a line, the measured wrap width.
function RULES.Shorten(text, limit)
	if #text <= limit then
		return text
	end
	return string.sub(text, 1, limit - 3) .. "..."
end

function RULES.DescribeShort(i)
	local rule = RULES.rules[i]
	local touched = RULES.AnySet(rule.effects) or RULES.RuleHasCriteria(rule)
	local armed = RULES.RuleIsArmed(rule)

	local mark = "."
	if armed then
		mark = "[on]"
	elseif touched then
		mark = "[!]"
	end
	local name = rule.label
	if name == "" then
		name = touched and "(unnamed)" or "empty"
	end
	local title = i .. "   " .. mark .. "   " .. RULES.Shorten(name, 34)

	local who = {}
	if RULES.AnySet(rule.names) then
		table.insert(who, RULES.NamesOf(rule.names, 2))
	end
	if RULES.AnySet(rule.categories) then
		table.insert(who, RULES.NamesOf(rule.categories, 2))
	end
	if RULES.AnySet(rule.rarities) then
		table.insert(who, RULES.NamesOf(rule.rarities, 2))
	end
	if RULES.AnySet(rule.traits) then
		table.insert(who, RULES.NamesOf(rule.traits, 2))
	end
	if RULES.AnySet(rule.mutationNames) then
		table.insert(who, RULES.NamesOf(rule.mutationNames, 2))
	end
	local parts = {}
	if #who > 0 then
		table.insert(parts, table.concat(who, rule.matchAll and " and " or " or "))
	else
		table.insert(parts, "any item")
	end
	if rule.minValue then
		table.insert(parts, "worth " .. tostring(rule.minValue) .. "+")
	end
	if rule.maxValue then
		table.insert(parts, "worth up to " .. tostring(rule.maxValue))
	end
	if rule.weightMin then
		table.insert(parts, tostring(rule.weightMin) .. " KG+")
	end
	if rule.weightMax then
		table.insert(parts, "up to " .. tostring(rule.weightMax) .. " KG")
	end

	local armedSetups = 0
	local onlySetup = nil
	for _, setup in ipairs(rule.setups or {}) do
		if RULES.SetupArmed(setup) then
			armedSetups = armedSetups + 1
			onlySetup = setup
		end
	end
	if armedSetups == 1 then
		table.insert(parts, RULES.DescribeSetup(onlySetup))
	elseif armedSetups > 1 then
		table.insert(parts, "any of " .. armedSetups .. " buff setups")
	end

	local matches = RULES.Shorten(table.concat(parts, ", "), 62)
	if not RULES.RuleHasCriteria(rule) then
		matches = "nothing to match on yet"
	end

	local effects = {}
	for effect in pairs(rule.effects) do
		table.insert(effects, effect)
	end
	table.sort(effects)
	local does
	if #effects == 0 then
		does = "-> no effect ticked, so it does nothing"
	else
		does = RULES.Shorten("-> " .. table.concat(effects, ", "), 62)
	end

	return title, matches, does
end

-- Which parts of a rule cannot possibly work during an auction.
--
-- "Ignore Min Bid" is judged on a garage's Floorspace models BEFORE the lot is
-- won, and the game strips almost everything from them: RULES.CheckGarage is
-- handed mutation NAMES and Condition, and nothing else. So a bid rule that
-- also asks for an item name, a rarity, a value, a weight or a buff PERCENTAGE
-- can never fire -- it will sit there looking configured and do nothing.
--
-- This is the same honest-limits problem as the "Various" dropdown: the tab
-- already says it in prose, and prose is not enough once someone has actually
-- built such a rule. Returns the offending parts in plain words.
function RULES.BidBlind(i)
	local rule = RULES.rules[i]
	local blind = {}
	if not rule.effects["Ignore Min Bid"] then
		return blind
	end
	if RULES.AnySet(rule.names) then
		table.insert(blind, "the item names")
	end
	if RULES.AnySet(rule.categories) then
		table.insert(blind, "the categories")
	end
	if RULES.AnySet(rule.rarities) then
		table.insert(blind, "the rarities")
	end
	if RULES.AnySet(rule.traits) then
		table.insert(blind, "the Is boxes")
	end
	if rule.minValue ~= nil or rule.maxValue ~= nil then
		table.insert(blind, "the value range")
	end
	if rule.weightMin ~= nil or rule.weightMax ~= nil then
		table.insert(blind, "the KG range")
	end
	RULES.AddPercentParts(rule, blind)
	return blind
end

-- The percentage half of a blindness report. Both reports below call it, so
-- the two can never end up describing the same rule differently.
function RULES.AddPercentParts(rule, out)
	local sawPercent, sawSum = false, false
	for _, setup in ipairs(rule.setups or {}) do
		if setup.sumMin ~= nil then
			sawSum = true
		end
		for _, line in ipairs(setup.lines or {}) do
			for _, alt in ipairs(line.alts or {}) do
				if RULES.AltArmed(alt) and alt.minPercent ~= nil then
					sawPercent = true
				end
			end
		end
	end
	if sawPercent then
		table.insert(out, "every buff %")
	end
	if sawSum then
		table.insert(out, "the buff total %")
	end
end

-- What the PICKUP lane will quietly ignore in this rule. Unlike the bid
-- warning above, this is not a mistake and the rule still works -- it is just
-- wider on the ground than it is in the inventory, because an item lying
-- there has no KG and no buff %. Stated in the editor so the rule cannot be
-- wider than the person who wrote it believes.
-- The second return says WHICH half is affected: "Never pick up" does not
-- skip what it cannot read (see RULES.Decide), so for that half the same
-- criteria mean the rule never fires on the ground -- a warning, not a note.
function RULES.PickupBlind(i)
	local rule = RULES.rules[i]
	local blind = {}
	if not (rule.effects["Always pick up"] or rule.effects["Never pick up"]) then
		return blind, false
	end
	if rule.weightMin ~= nil or rule.weightMax ~= nil then
		table.insert(blind, "the KG range")
	end
	RULES.AddPercentParts(rule, blind)
	return blind, rule.effects["Never pick up"] == true
end

-- Where a rule and a lane's own list disagree about the same item.
--
-- The rule wins -- that is by design and every lane implements it -- but the
-- list is then sitting there showing a tick that no longer decides anything,
-- which is precisely the "control that lies about itself" failure this tab was
-- built to remove. So it is surfaced rather than left for the user to discover
-- when an item they thought was protected gets sold.
--
-- Only the FORCE direction can contradict: a rule that says "never sell" and a
-- list that says "never sell" agree with each other. Returns plain sentences.
RULES.LANE_LISTS = {
	pickup = { effect = "Always pick up", set = nil, what = "picked up" },
	place  = { effect = "Allow placing",  set = nil, what = "placed" },
	sell   = { effect = "Allow selling",  set = nil, what = "sold" },
}

function RULES.Contradictions(lane)
	local spec = RULES.LANE_LISTS[lane]
	local out = {}
	if not spec then
		return out
	end
	local excluded = spec.set
	if type(excluded) ~= "table" then
		return out
	end
	for i = 1, RULES.COUNT do
		local rule = RULES.rules[i]
		if RULES.RuleIsArmed(rule) and rule.effects[spec.effect] then
			for name in pairs(rule.names) do
				if excluded[name] then
					table.insert(out, name .. " -- rule " .. i .. " has it " .. spec.what .. " anyway")
				end
			end
		end
	end
	table.sort(out)
	if #out > 6 then
		local trimmed = {}
		for index = 1, 6 do
			trimmed[index] = out[index]
		end
		table.insert(trimmed, "...and " .. (#out - 6) .. " more")
		return trimmed
	end
	return out
end

-- ---------------------------------------------------------
-- Saving. Each rule is one JSON string in one RayVoid Input flag, which is
-- what makes rules travel inside the user's saved config slots (they keep
-- several -- test, CARGO, TOURNEY, StorageHunters). The editor window below
-- is only an editor: the flags remain the storage, so a slot load restores
-- rules exactly as it restores every other setting.
-- ---------------------------------------------------------
function RULES.SetToList(set)
	local list = {}
	for name in pairs(set) do
		table.insert(list, name)
	end
	table.sort(list)
	return list
end

function RULES.ListToSet(list, into)
	table.clear(into)
	if type(list) == "table" then
		for _, name in ipairs(list) do
			if type(name) == "string" then
				into[name] = true
			end
		end
	end
	return into
end

function RULES.Serialize(i)
	local rule = RULES.rules[i]
	local plain = {
		label = rule.label,
		effects = RULES.SetToList(rule.effects),
		names = RULES.SetToList(rule.names),
		categories = RULES.SetToList(rule.categories),
		rarities = RULES.SetToList(rule.rarities),
		traits = RULES.SetToList(rule.traits),
		mutationNames = RULES.SetToList(rule.mutationNames),
		match = rule.matchAll and "all" or "any",
		minValue = rule.minValue,
		maxValue = rule.maxValue,
		weightMin = rule.weightMin,
		weightMax = rule.weightMax,
		setups = {},
	}
	for _, setup in ipairs(rule.setups or {}) do
		local outSetup = { lines = {}, sumMin = setup.sumMin }
		for _, line in ipairs(setup.lines or {}) do
			local outLine = {}
			for _, alt in ipairs(line.alts or {}) do
				table.insert(outLine, { m = alt.mutation, p = alt.minPercent })
			end
			table.insert(outSetup.lines, outLine)
		end
		table.insert(plain.setups, outSetup)
	end
	-- An UNTOUCHED rule saves as the empty string rather than "{}", so a fresh
	-- config slot stays visibly empty instead of full of noise. "Untouched"
	-- has to include "no setups at all", not just "no criteria": a setup the
	-- user has added but not filled in yet is inert to the MATCHER, and if
	-- that made it vanish from the save the row would disappear from under
	-- them the moment they created it -- which is exactly what happened when
	-- this only checked RuleHasCriteria.
	if plain.label == "" and #plain.effects == 0 and #plain.setups == 0
		and not RULES.RuleHasCriteria(rule) then
		return ""
	end
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(plain)
	end)
	if not ok then
		warn("[Rules] Could not save rule " .. i .. ": " .. tostring(encoded))
		return ""
	end
	return encoded
end

function RULES.Deserialize(i, text)
	local rule = RULES.NewRule()
	RULES.rules[i] = rule
	if type(text) ~= "string" or text == "" then
		return true
	end
	local ok, plain = pcall(function()
		return HttpService:JSONDecode(text)
	end)
	if not ok or type(plain) ~= "table" then
		-- Loud, because a rule that silently fails to load is a farm quietly
		-- behaving differently from what the config slot says.
		warn("[Rules] Rule " .. i .. " could not be read back and has been left empty: " .. tostring(plain))
		return false
	end
	rule.label = type(plain.label) == "string" and plain.label or ""
	RULES.ListToSet(plain.effects, rule.effects)
	RULES.ListToSet(plain.names, rule.names)
	RULES.ListToSet(plain.categories, rule.categories)
	RULES.ListToSet(plain.rarities, rule.rarities)
	RULES.ListToSet(plain.traits, rule.traits)
	RULES.ListToSet(plain.mutationNames, rule.mutationNames)
	-- Written only since 2026-09-13. A rule saved before then was matched with
	-- fixed OR, so it loads as ANY and keeps meaning exactly what it did.
	rule.matchAll = (plain.match == "all")
	rule.minValue = tonumber(plain.minValue)
	rule.maxValue = tonumber(plain.maxValue)
	-- Weight moved from the setup up to the rule on 2026-09-12; a rule saved
	-- before that keeps working by reading it from wherever it was written.
	rule.weightMin = tonumber(plain.weightMin)
	rule.weightMax = tonumber(plain.weightMax)
	for _, inSetup in ipairs(plain.setups or {}) do
		local setup = RULES.NewSetup()
		setup.sumMin = tonumber(inSetup.sumMin)
		if rule.weightMin == nil then rule.weightMin = tonumber(inSetup.weightMin) end
		if rule.weightMax == nil then rule.weightMax = tonumber(inSetup.weightMax) end
		for _, inLine in ipairs(inSetup.lines or {}) do
			local line = RULES.NewLine()
			for _, inAlt in ipairs(inLine) do
				table.insert(line.alts, {
					mutation = type(inAlt.m) == "string" and inAlt.m or nil,
					minPercent = tonumber(inAlt.p),
				})
			end
			table.insert(setup.lines, line)
		end
		table.insert(rule.setups, setup)
	end
	return true
end

-- ---------------------------------------------------------
-- OPEN-ENDED STORAGE. RULES.rules is no longer fixed at 8: RULES.COUNT
-- tracks its CURRENT length and is kept in sync wherever the array's size
-- changes (below, and in RULES.AddRule / RULES.RemoveRuleAt in the UI
-- section). Every matcher loop already reads RULES.COUNT rather than a
-- literal 8, so nothing above this point needed to change.
--
-- Storage itself moves from "one flag per rule" (Rule1Data..Rule8Data,
-- capped by how many hidden RayVoid controls exist) to ONE flag holding a
-- JSON array of the per-rule JSON strings RULES.Serialize already produces
-- -- same trick as the buff line's "up to 20" choices, which live inside a
-- single rule's own blob for the same reason. An untouched rule is still
-- skipped (RULES.Serialize returns ""), so the array only ever lists real
-- rules; RULES.rules itself keeps whatever untouched slots the editor is
-- showing (e.g. a freshly clicked "Add rule") without saving them.
-- ---------------------------------------------------------
function RULES.SerializeAll()
	local list = {}
	for i = 1, #RULES.rules do
		local text = RULES.Serialize(i)
		if text ~= "" then
			table.insert(list, text)
		end
	end
	-- Always valid JSON, "[]" included -- that is what tells
	-- RULES.MigrateLegacy this slot has already been migrated (an old slot
	-- never wrote this flag at all, so its CurrentValue reads back as the
	-- control's own empty-string default, never "[]").
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(list)
	end)
	if not ok then
		warn("[Rules] Could not save the rule list: " .. tostring(encoded))
		return ""
	end
	return encoded
end

function RULES.EnsureAtLeastOneRule()
	if #RULES.rules == 0 then
		table.insert(RULES.rules, RULES.NewRule())
	end
	RULES.COUNT = #RULES.rules
end

function RULES.DeserializeAll(text)
	RULES.rules = {}
	if type(text) == "string" and text ~= "" then
		local ok, list = pcall(function()
			return HttpService:JSONDecode(text)
		end)
		if ok and type(list) == "table" then
			for _, ruleText in ipairs(list) do
				RULES.Deserialize(#RULES.rules + 1, ruleText)
			end
		else
			-- Loud, same reasoning as a single rule's Deserialize: a rule
			-- list that silently fails to load is a farm quietly behaving
			-- differently from what the config slot says.
			warn("[Rules] The saved rule list could not be read back and has been left empty: " .. tostring(list))
		end
	end
	RULES.EnsureAtLeastOneRule()
	return true
end

-- One-time upgrade path for a slot saved before this flag existed: it has
-- Rule1Data..Rule8Data (old per-slot flags) but no ItemRulesData at all.
-- legacyTexts is {[i]=text} for i = 1..RULES.LEGACY_COUNT, exactly what the
-- UI section's staging table collects from those flags' callbacks.
function RULES.MigrateLegacy(legacyTexts)
	local found = false
	for i = 1, RULES.LEGACY_COUNT do
		if type(legacyTexts[i]) == "string" and legacyTexts[i] ~= "" then
			found = true
			break
		end
	end
	if not found then
		return false
	end
	local migrated = {}
	for i = 1, RULES.LEGACY_COUNT do
		RULES.Deserialize(i, legacyTexts[i] or "")
		local rule = RULES.rules[i]
		if RULES.AnySet(rule.effects) or RULES.RuleHasCriteria(rule) or rule.label ~= "" then
			table.insert(migrated, rule)
		end
	end
	RULES.rules = migrated
	RULES.EnsureAtLeastOneRule()
	return true
end

-- =========================================================
-- COLLECTOR WHITELIST -- keep whatever the collector is asking for.
-- =========================================================
-- The collector NPC at your base wants one specific item per visit, and
-- handing it over is worth more than the item is. The danger is the rest of
-- the script: a low-value item is left on the ground by the pickup filter,
-- or sold by AutoSell, or shelved by AutoPlace, long before you know he
-- wanted it.
--
-- The wanted item needs NO remote and no quest state: it sits on the
-- collector model's own attributes (2026-09-08, Dex++). See
-- docs/game-reference.md, "The Collector".
--
-- Three effects, one question. Pickup, AutoSell and AutoPlace each ask
-- COLLECTORKEEP.Matches(itemId) and step aside. This is deliberately ONE
-- toggle and no filter of its own: the Item Rules tab (worklist RULES) will
-- own configurable matching, and a second place to configure the same thing
-- is exactly what Q5 ruled out.
local COLLECTORKEEP = {
	active = false,
	-- The wanted item id, as a STRING: the attribute is a string and Items
	-- is keyed by tostring(id), so everything here stays in string space.
	itemId = nil,
	itemName = nil,
	-- Changes per visit, so it is the right key for "this is a new ask".
	visitId = nil,
}

COLLECTORKEEP.POLL = 10

function COLLECTORKEEP.Forget(reason)
	if COLLECTORKEEP.itemId then
		DebugPrint("[CollectorKeep] " .. reason .. ", nothing whitelisted now")
	end
	COLLECTORKEEP.itemId = nil
	COLLECTORKEEP.itemName = nil
	COLLECTORKEEP.visitId = nil
end

function COLLECTORKEEP.Refresh()
	local shoppers = workspace:FindFirstChild("_NPCShoppers")
	local collector = shoppers and shoppers:FindFirstChild("Collector")

	if not collector then
		-- **NOT "he has left".** Measured 2026-09-10: the Collector streams
		-- out at about 300 studs, and the farm is essentially never that
		-- close to the base -- so this poll saw an empty folder on every
		-- single tick while farming and forgot the whitelist immediately.
		-- The feature could not have worked away from home.
		--
		-- Keeping the last known request instead fails in the safe direction:
		-- a stale whitelist costs one item being kept, forgetting it costs
		-- the item being sold. A genuinely new request brings a new
		-- CollectorVisitId, which is what actually replaces it below.
		return
	end

	-- Somebody else's collector: their item is not ours to hold on to.
	local ownerId = collector:GetAttribute("CollectorOwnerUserId")
	if ownerId ~= nil and ownerId ~= LocalPlayer.UserId then
		COLLECTORKEEP.Forget("Collector belongs to another player")
		return
	end

	local rawItemId = collector:GetAttribute("CollectorRequestedItemId")
	if rawItemId == nil then
		COLLECTORKEEP.Forget("Collector is not asking for anything")
		return
	end

	local itemId = tostring(rawItemId)
	local visitId = collector:GetAttribute("CollectorVisitId")

	if itemId == COLLECTORKEEP.itemId and visitId == COLLECTORKEEP.visitId then
		return
	end

	local itemDef = Items[itemId]
	COLLECTORKEEP.itemId = itemId
	COLLECTORKEEP.visitId = visitId
	COLLECTORKEEP.itemName = collector:GetAttribute("CollectorRequestedItemName")
		or (type(itemDef) == "table" and itemDef.Name)
		or ("item " .. itemId)

	-- Always printed: it changes what the farm keeps, and a whitelist you
	-- cannot see is indistinguishable from a filter that is misbehaving.
	print("[CollectorKeep] Collector wants " .. tostring(COLLECTORKEEP.itemName) ..
		" -- it will be picked up, and never sold or placed, until he has it")
end

-- The single question the three filters ask. Cheap enough to call per item.
-- Also answers for QUEST items (Quests tab -> "Keep Quest Items"): every item
-- a quest asks you to bring (Modules.Quests RequiredItems, e.g. Grandma's
-- Pickle Jar 1347) and every Power Plant part. Riding on this one question
-- means pickup, AutoSell and AutoPlace all keep them with no new hooks.
-- questIds / questNames are filled by QUEST.BuildKeepSet and POWERPLANT.
--
-- THE RIGHT AMOUNT, NOT ALL OF THEM (2026-10-11): this used to answer "yes"
-- for every copy forever, so the farm hoarded the collector's item by the
-- dozen. Now each kept item has a NEED (collector 1, a quest's RequiredItems
-- 1, a Power Plant part = how many open red spots want it), the inventory is
-- recounted every few seconds, and:
--   Matches(itemId)  -- pickup: true only while you have FEWER than needed
--   KeepsGuid(guid)  -- sell/place: true only for the first N copies held
COLLECTORKEEP.questActive = false
COLLECTORKEEP.questIds = {}   -- tostring(itemId) -> count needed (quests)
COLLECTORKEEP.plantNeed = {}  -- item name -> count needed (Power Plant spots)
COLLECTORKEEP.trainIds = {}   -- tostring(itemId) -> count needed (Train Conductor; filled only while it is on)
COLLECTORKEEP.have = {}       -- tostring(itemId) -> count in inventory
COLLECTORKEEP.haveNames = {}  -- item name -> count in inventory
COLLECTORKEEP.keepGuids = {}  -- guid -> true: these copies are the kept ones
COLLECTORKEEP.seenGuids = {}  -- guid -> true: every guid the last recount saw
COLLECTORKEEP.RECOUNT_EVERY = 5

-- How many of this item are wanted in total, across collector + quests + plant.
function COLLECTORKEEP.Need(id, name)
	local need = COLLECTORKEEP.trainIds[id] or 0
	if COLLECTORKEEP.questActive then
		need = math.max(need, COLLECTORKEEP.questIds[id] or 0)
		if name then
			need = math.max(need, COLLECTORKEEP.plantNeed[name] or 0)
		end
	end
	if COLLECTORKEEP.active and COLLECTORKEEP.itemId == id then
		need = math.max(need, 1)
	end
	-- The lost-items Key opens the Back Alley garage the Scythe is locked in.
	-- Sold = no Scythe for ~12h (it respawns), which is how set 1 stuck at 28/29.
	if name == "Key" and COLLECTORKEEP.keepLostKey ~= false then
		need = math.max(need, 1)
	end
	return need
end

function COLLECTORKEEP.Recount()
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not ok or type(inventory) ~= "table" then
		return
	end
	local have, haveNames, keep, seen = {}, {}, {}, {}
	-- Sorted guids: the SAME copies stay "the kept ones" from pass to pass.
	local guids = {}
	for guid in pairs(inventory) do
		table.insert(guids, guid)
	end
	table.sort(guids)
	for _, guid in ipairs(guids) do
		local entry = inventory[guid]
		local id = tostring(entry.ItemId)
		local def = Items[id]
		local name = type(def) == "table" and def.Name or nil
		seen[guid] = true
		have[id] = (have[id] or 0) + 1
		if name then
			haveNames[name] = (haveNames[name] or 0) + 1
		end
		local need = COLLECTORKEEP.Need(id, name)
		if need > 0 and have[id] <= need then
			keep[guid] = true
		end
	end
	COLLECTORKEEP.have, COLLECTORKEEP.haveNames = have, haveNames
	COLLECTORKEEP.keepGuids, COLLECTORKEEP.seenGuids = keep, seen
end

-- Pickup: still short of what is needed?
function COLLECTORKEEP.Matches(itemId)
	if itemId == nil then
		return false
	end
	local id = tostring(itemId)
	local def = Items[id]
	local name = type(def) == "table" and def.Name or nil
	local need = COLLECTORKEEP.Need(id, name)
	if need <= 0 then
		return false
	end
	local have = COLLECTORKEEP.have[id] or 0
	if name and COLLECTORKEEP.plantNeed[name] then
		have = math.max(have, COLLECTORKEEP.haveNames[name] or 0)
	end
	return have < need
end

-- Sell / place: is THIS copy one of the kept ones? A guid the last recount
-- has not seen yet (just unloaded) is kept if its item is wanted at all --
-- the safe side, until the next recount decides.
function COLLECTORKEEP.KeepsGuid(guid, itemId)
	if COLLECTORKEEP.keepGuids[guid] then
		return true
	end
	if not COLLECTORKEEP.seenGuids[guid] and itemId ~= nil then
		local id = tostring(itemId)
		local def = Items[id]
		return COLLECTORKEEP.Need(id, type(def) == "table" and def.Name or nil) > 0
	end
	return false
end

task.spawn(function()
	while SESSION.alive do
		if COLLECTORKEEP.active or COLLECTORKEEP.questActive or next(COLLECTORKEEP.trainIds) ~= nil then
			pcall(COLLECTORKEEP.Recount)
		end
		task.wait(COLLECTORKEEP.RECOUNT_EVERY)
	end
end)

function COLLECTORKEEP.StartLoop()
	if LOOPGUARDS.collectorKeep then
		return
	end
	LOOPGUARDS.collectorKeep = true
	task.spawn(function()
		while COLLECTORKEEP.active and LOOPGUARDS.collectorKeep and SESSION.alive do
			local ok, err = pcall(COLLECTORKEEP.Refresh)
			if not ok then
				warn("[CollectorKeep] Could not read the collector: " .. tostring(err))
			end
			task.wait(COLLECTORKEEP.POLL)
		end
		LOOPGUARDS.collectorKeep = false
	end)
end

-- The server announces what it is offering on UI.StartQuestDialog, and that
-- is the ONLY way to learn the quest name SendQuestDialogResult has to quote.
-- One listener, declared here because BOTH the collector (just below) and the
-- quest tour (far below) need it -- the collector is a quest NPC using the
-- same protocol, so a second listener would be the same event twice.
local QUESTDIALOG = { seq = 0, quest = nil, payload = nil }

do
	local okConn, connErr = pcall(function()
		SESSION.Track(Events.UI.StartQuestDialog.OnClientEvent:Connect(function(payload)
			local name
			if type(payload) == "table" then
				name = payload.QuestName or payload.questName or payload.Name
			elseif type(payload) == "string" then
				name = payload
			end
			if name then
				QUESTDIALOG.quest = name
			end
			-- Kept whole: the dialog's own options say which Response the
			-- server wants (an offer is "accept", a hand-in is not).
			QUESTDIALOG.payload = payload
			-- Bumped even when the shape was unexpected, so a caller stops
			-- waiting rather than sitting out its full timeout.
			QUESTDIALOG.seq = QUESTDIALOG.seq + 1
		end))
	end)
	if not okConn then
		-- Without this a quest or a collector request can be reached but never
		-- answered, so it is a real failure and not chatter.
		warn("[Quests] Could not listen to UI.StartQuestDialog (" .. tostring(connErr)
			.. ") -- Auto Quest and Collector auto-accept can claim, but cannot accept anything new.")
	end
	-- Proof an "accept" landed: the server announces it on Quest.NewQuestAccepted.
	QUESTDIALOG.acceptSeq = 0
	pcall(function()
		local q = Events:FindFirstChild("Quest")
		local ev = q and q:FindFirstChild("NewQuestAccepted")
		if ev then
			QUESTDIALOG.acceptHooked = true
			SESSION.Track(ev.OnClientEvent:Connect(function()
				QUESTDIALOG.acceptSeq = QUESTDIALOG.acceptSeq + 1
			end))
		end
	end)
end

-- =========================================================
-- COLLECTOR AUTO-ACCEPT -- take his request when it is for an area you farm.
-- =========================================================
-- Measured live 2026-09-10, first time a Collector had been caught spawned:
-- `workspace._NPCShoppers.Collector`, a normal character model at your own
-- base (39 studs from the player, 6 minutes on the ground before he left).
-- All five attributes reach the client:
--   CollectorRequestedItemId "403" (string)   CollectorVisitId <guid>
--   CollectorRequestedItemName "Pressure Cooker"
--   CollectorOwnerUserId 575892711            CollectorCanTalk true
-- Prompt: HumanoidRootPart.NPCQuestAttachment.NPCQuestPrompt, reach 10,
-- HoldDuration 0, RequiresLineOfSight false, ActionText "Talk".
--
-- Protocol is the ordinary quest one, and his offer options are literally
-- `Response = "accept"` / `Response = "dismiss_collector"`.
--
-- **It never declines.** Nothing on record says whether declining spends the
-- visit -- `CollectorVisitId` appears in zero client scripts and the server
-- owns the return cooldown -- so an area we do not want is simply left alone,
-- which is exactly what happens with this switched off. The one thing that
-- cannot be worse is talking when the item is ALREADY in the inventory: that
-- is a hand-over, not a new commitment, so it happens whatever the area says.
--
-- Six minutes on the ground and a base that the farm only visits every N
-- wins means "if I happen to be in range" would almost never fire, so this
-- teleports -- and therefore runs from the Master Cycle, which owns the HRP,
-- exactly like the quest tour.
local COLLECTORAUTO = {
	active = false,
	areas = {},             -- areaName -> true, from the dropdown
	options = {},           -- area names for the dropdown
	acceptedVisit = nil,    -- CollectorVisitId we have already accepted
	acceptedItemId = nil,   -- ...and what it asked for, so we can watch for it
	skippedVisit = nil,     -- one line per visit, not one per check
	lastTripAt = 0,
	handled = 0,
	-- **He is only visible from the base.** Measured 2026-09-10: he streams
	-- out at ~300 studs and there is no at-distance signal at all -- the
	-- QuestExclamation_Collector GUI is not present even standing next to
	-- him. So "is he there?" cannot be asked from the farm; the only way to
	-- know is to go and look, and these are how often that is worth doing.
	TRIP_EVERY = 300,
	-- Longer once this visit has already been dealt with, one way or the
	-- other. He stays put for hours with the same CollectorVisitId, so going
	-- back at the short interval would be a round trip for nothing.
	REVISIT_EVERY = 900,
	-- The base has to stream in after the teleport before he exists.
	STREAM_WAIT = 4,
	-- Same measured lesson as Auto Quest: the server refuses the prompt until
	-- it has seen us arrive, and says so by returning false.
	TRIGGER_TRIES = 8,
	TRIGGER_RETRY = 0.3,
}

-- Every area the game's own item table knows about. Ten of them; 140 items
-- carry no Area at all, and one of those is reported rather than guessed at.
function COLLECTORAUTO.BuildOptions()
	local set = {}
	for _, def in pairs(Items) do
		SESSION.Breathe()
		if type(def) == "table" and type(def.Name) == "string" then
			local a = def.Area
			if type(a) == "table" then
				for _, one in ipairs(a) do
					set[tostring(one)] = true
				end
			elseif type(a) == "string" and a ~= "" then
				set[a] = true
			end
		end
	end
	local list = {}
	for name in pairs(set) do
		table.insert(list, name)
	end
	table.sort(list)
	COLLECTORAUTO.options = list
	return list
end

-- Ours, present, and able to talk. Returns model, itemId, visitId.
function COLLECTORAUTO.Resolve()
	local shoppers = workspace:FindFirstChild("_NPCShoppers")
	local collector = shoppers and shoppers:FindFirstChild("Collector")
	if not collector then
		return nil
	end
	local ownerId = collector:GetAttribute("CollectorOwnerUserId")
	if ownerId ~= nil and ownerId ~= LocalPlayer.UserId then
		return nil
	end
	if collector:GetAttribute("CollectorCanTalk") == false then
		return nil
	end
	local rawItemId = collector:GetAttribute("CollectorRequestedItemId")
	if rawItemId == nil then
		return nil
	end
	return collector, tostring(rawItemId), collector:GetAttribute("CollectorVisitId")
end

-- true / false, or nil for "the item carries no area at all", which the
-- caller reports rather than silently treating as a mismatch. In practice his
-- item always comes out of a garage loot table and always has one, so nil is a
-- real surprise -- 140 of the 1039 items have no Area, none of them his.
function COLLECTORAUTO.AreaMatches(itemId)
	local def = Items[itemId]
	local area = type(def) == "table" and def.Area or nil
	if type(area) == "table" then
		for _, one in ipairs(area) do
			if COLLECTORAUTO.areas[tostring(one)] then
				return true
			end
		end
		return false
	end
	if type(area) == "string" and area ~= "" then
		return COLLECTORAUTO.areas[area] == true
	end
	return nil
end

function COLLECTORAUTO.HasItem(itemId)
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not ok or type(inventory) ~= "table" then
		return false
	end
	for _, entry in pairs(inventory) do
		if tostring(entry.ItemId) == itemId then
			return true
		end
	end
	return false
end

-- Teleport to him, fire the prompt until the server takes it, answer "accept".
-- Returns true when the server actually accepted the prompt.
function COLLECTORAUTO.Talk(collector, label)
	local root = collector:FindFirstChild("HumanoidRootPart")
	if not root then
		warn("[CollectorAuto] The Collector has no HumanoidRootPart, cannot reach him.")
		return false
	end

	local reach = 10
	pcall(function()
		local prompt = root:FindFirstChild("NPCQuestAttachment")
		prompt = prompt and prompt:FindFirstChild("NPCQuestPrompt")
		if prompt then
			reach = prompt.MaxActivationDistance
		end
	end)
	-- Arrive AND stay (TPCACHE.ArriveNear). This used to fire the prompt even
	-- when the reach wait ran out, which the server can only refuse.
	if not TPCACHE.ArriveNear(root, reach * 0.85) then
		warn("[CollectorAuto] Could not stay within reach of the Collector (pulled away "
			.. TPCACHE.ARRIVE_TRIES .. " times), so nothing was " .. label .. ".")
		return false
	end

	local accepted = false
	for attempt = 1, COLLECTORAUTO.TRIGGER_TRIES do
		local okTrigger, ret = pcall(function()
			return Events.UI.QuestPromptTriggered:InvokeServer(collector)
		end)
		if not okTrigger then
			warn("[CollectorAuto] QuestPromptTriggered failed: " .. tostring(ret))
			return false
		end
		if ret ~= false then
			accepted = true
			DebugPrint("[CollectorAuto] " .. label .. ": prompt accepted on attempt " .. attempt)
			break
		end
		task.wait(COLLECTORAUTO.TRIGGER_RETRY)
	end
	if not accepted then
		warn("[CollectorAuto] The Collector kept refusing the prompt (" .. COLLECTORAUTO.TRIGGER_TRIES
			.. " tries), so nothing was " .. label .. ".")
		return false
	end

	-- The offer dialog carries the quest name the answer has to quote. A
	-- hand-over needs no answer at all, so silence here is not a failure.
	local seqBefore = QUESTDIALOG.seq
	local waitUntil = os.clock() + 2
	while os.clock() < waitUntil and QUESTDIALOG.seq == seqBefore do
		task.wait(0.05)
	end
	local questName = QUESTDIALOG.quest
	if questName and not string.find(questName, "'s Reward", 1, true) then
		local okAnswer, answerErr = pcall(function()
			Events.UI.SendQuestDialogResult:FireServer(collector, questName, "accept")
		end)
		if not okAnswer then
			warn("[CollectorAuto] SendQuestDialogResult failed: " .. tostring(answerErr))
			return false
		end
		print("[CollectorAuto] Accepted the Collector's request: " .. tostring(questName))
	end
	return true
end

-- Where the base is, from anywhere. His own spot once we have stood next to
-- him, otherwise the base position TPCACHE seeds at load while the player is
-- still standing on their plot. Both are REMEMBERED positions, and that is
-- the whole point: at 300 studs nothing about the base is loaded, so there is
-- nothing live to resolve.
function COLLECTORAUTO.BasePosition()
	local remembered = TPCACHE.positions["collector"] or TPCACHE.positions["base"]
	if remembered then
		return remembered
	end
	if COLLECTORAUTO.poiBase then
		return COLLECTORAUTO.poiBase
	end

	-- Nothing remembered. TPCACHE's "base" is only seeded at load if the
	-- player happened to be standing on their plot, and a farm that was
	-- already running is not -- measured 2026-09-10, this was nil and the
	-- first trip had nowhere to go.
	--
	-- So ask the game's own GPS, which is a remote and therefore answers from
	-- any distance, unlike every piece of plot geometry. The player's own
	-- shop POI sits within a few studs of where the Collector stands.
	local poi = TPCACHE.ShopPOI()
	if poi then
		COLLECTORAUTO.poiBase = poi
	end
	return poi
end

-- Go home and look. Returns true when the trip found him, whatever we then
-- decided to do about it.
function COLLECTORAUTO.Trip()
	local base = COLLECTORAUTO.BasePosition()
	if not base then
		-- Nothing remembered and nothing loaded: say so rather than teleport
		-- to the origin. Same failure mode TP-FAR had, same treatment.
		warn("[CollectorAuto] No remembered base position yet, so there is nowhere to go. "
			.. "Use TP base once, or let the farm place a load, and this will work from then on.")
		return false
	end

	TeleportPlayerOnly(base)

	local collector, itemId, visitId
	local deadline = os.clock() + COLLECTORAUTO.STREAM_WAIT
	while os.clock() < deadline do
		collector, itemId, visitId = COLLECTORAUTO.Resolve()
		if collector then
			break
		end
		task.wait(0.25)
	end

	if not collector then
		DebugPrint("[CollectorAuto] Went to the base, nobody there this time.")
		return false
	end

	-- Remember exactly where he stands, so every later trip lands on him
	-- rather than on the plot anchor.
	local root = collector:FindFirstChild("HumanoidRootPart")
	if root then
		TPCACHE.positions["collector"] = root.Position
	end

	-- Ordered so the ordinary "accept it" path costs no inventory round trip:
	-- the area test is a table lookup, HasItem is a remote.
	local def = Items[itemId]
	local itemLabel = tostring(type(def) == "table" and def.Name or ("item " .. tostring(itemId)))
	local label

	if visitId ~= nil and visitId == COLLECTORAUTO.acceptedVisit then
		-- Already accepted this visit. Only worth another word once the item
		-- is actually in the bag. Once handed over it is consumed, so this
		-- stops finding it and the visit goes quiet by itself.
		if not COLLECTORAUTO.HasItem(itemId) then
			DebugPrint("[CollectorAuto] Still waiting to find " .. itemLabel .. " for the Collector.")
			return true
		end
		label = "handed over"
	else
		local match = COLLECTORAUTO.AreaMatches(itemId)
		if match then
			label = "accepted"
		elseif COLLECTORAUTO.HasItem(itemId) then
			-- We already own what he wants, so there is no commitment to
			-- protect us from and the area filter has nothing to say.
			label = "handed over"
		else
			if COLLECTORAUTO.skippedVisit ~= visitId then
				COLLECTORAUTO.skippedVisit = visitId
				if match == nil then
					warn("[CollectorAuto] The Collector wants " .. itemLabel .. ", which has no area in the game's "
						.. "item table, so the area filter cannot judge it. His prompt is left alone.")
				else
					print("[CollectorAuto] The Collector wants " .. itemLabel
						.. ", which is not in a ticked area -- leaving his prompt alone.")
				end
			end
			return true
		end
	end

	local okTalk, talked = pcall(function()
		return COLLECTORAUTO.Talk(collector, label)
	end)
	if not okTalk then
		warn("[CollectorAuto] Talking to the Collector failed: " .. tostring(talked))
		return true
	end
	if talked then
		COLLECTORAUTO.acceptedVisit = visitId
		COLLECTORAUTO.acceptedItemId = itemId
		COLLECTORAUTO.handled = COLLECTORAUTO.handled + 1
		if label == "handed over" then
			-- Consumed on hand-over, so stop watching the inventory for it.
			COLLECTORAUTO.acceptedItemId = nil
		end
		FARM.Moved()
	end
	return true
end

-- Called from the Master Cycle's SEARCHING branch. One boolean test when off.
--
-- This is a TIMER, not a presence check, and that is the whole correction of
-- 2026-09-10: the first build asked "is the Collector in _NPCShoppers?" from
-- wherever the farm happened to be, which at 300+ studs is always "no". It
-- would never have fired once.
function COLLECTORAUTO.RunIfDue()
	if not COLLECTORAUTO.active then
		return
	end

	local interval = COLLECTORAUTO.TRIP_EVERY
	if COLLECTORAUTO.acceptedItemId then
		-- Already accepted: the only reason to go back is to hand the item
		-- over, and whether we are carrying it is readable from right here.
		-- No blind trips while we are still out looking for it.
		if COLLECTORAUTO.HasItem(COLLECTORAUTO.acceptedItemId) then
			interval = 0
		else
			interval = COLLECTORAUTO.REVISIT_EVERY
		end
	elseif COLLECTORAUTO.skippedVisit ~= nil then
		-- Deliberately left alone. He keeps the same request for hours, so
		-- going back at the short interval is a round trip for nothing.
		interval = COLLECTORAUTO.REVISIT_EVERY
	end

	if (os.clock() - COLLECTORAUTO.lastTripAt) < interval then
		return
	end
	if AUCTION.BusyReason() then
		return
	end

	-- Charged whether the trip finds anything or not, so a server that never
	-- spawns him cannot turn into a trip home every master tick.
	COLLECTORAUTO.lastTripAt = os.clock()
	COLLECTORAUTO.Trip()
end

local function GetCarryableItemDef(item)
	local itemId = item:GetAttribute("ItemId")
	if itemId ~= nil then
		local def = Items[tostring(itemId)]
		if def then
			return def
		end
	end

	if not ItemsByName then
		ItemsByName = {}
		for _, def in pairs(Items) do
			if type(def) == "table" and type(def.Name) == "string" then
				ItemsByName[def.Name] = def
			end
		end
	end

	return ItemsByName[item.Name]
end

-- True if the item is excluded from pickup by category or rarity. If the
-- def cannot be found we return false: better to pick up an item we
-- failed to identify than to leave it on the ground forever.
-- Estimated price of a carryable, same formula as ComputeStockPrice/AUTOSELL
-- but without the grade multiplier (a carryable not yet picked up is
-- never graded). Reads Mutator AND Mutators like ReadMutatorNames, but
-- keeps the full objects (not just the names): MutatorModule needs the
-- whole structure to compute the price bonus.
local function GetCarryableValue(item, itemDef)
	local mutators = {}
	for _, attrName in ipairs({ "Mutator", "Mutators" }) do
		local raw = item:GetAttribute(attrName)
		if type(raw) == "string" and raw ~= "" and raw ~= "[]" then
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
			if ok and type(decoded) == "table" then
				for _, mutation in ipairs(decoded) do
					table.insert(mutators, mutation)
				end
			end
		end
	end

	local syntheticEntry = { Mutators = mutators }
	local ok, price = pcall(function()
		return MutatorModule:CalculatePriceForEntry(itemDef.BasePrice or 0, syntheticEntry)
	end)
	if ok and type(price) == "number" then
		return price
	end
	return itemDef.BasePrice or 0
end

local function IsCarryableExcluded(item)
	-- Given up on by the collecting phase's stuck guard: never retried, or
	-- every later garage would sit out the same 2.5 minutes on it.
	if SESSION.abandoned and SESSION.abandoned[item] then
		return true
	end

	-- The collector's item is never left on the ground, whatever the value
	-- filter or the exclusion lists say. First check, so nothing below can
	-- overrule it.
	if COLLECTORKEEP.Matches(item:GetAttribute("ItemId")) then
		return false
	end

	-- Item Rules, second: a rule beats the tab's own filters but not the
	-- collector's whitelist. Costs nothing while the Item Rules tab is empty.
	if RULES.LaneArmed("pickup") then
		local ruleDef = GetCarryableItemDef(item)
		local verdict = RULES.Decide("pickup", {
			name = ruleDef and ruleDef.Name or nil,
			category = ruleDef and ruleDef.Category or nil,
			rarity = ruleDef and ruleDef.Rarity or nil,
			mutations = ReadMutatorNames(item),
			traits = RULES.TraitsFor(ruleDef, item:GetAttribute("ItemId")),
			condition = item:GetAttribute("Condition"),
			value = ruleDef and GetCarryableValue(item, ruleDef) or nil,
		})
		if verdict == "force" then
			return false
		elseif verdict == "block" then
			return true
		end
	end

	local def = nil
	if next(COLLECT.excludedCategories) ~= nil or next(COLLECT.excludedRarities) ~= nil or next(COLLECT.excludedItemNames) ~= nil or next(COLLECT.excludedMutations) ~= nil or COLLECT.excludeLimited or COLLECT.excludeVault then
		def = GetCarryableItemDef(item)
		if def then
			if COLLECT.excludedRarities[def.Rarity or "Uncommon"] then
				return true
			end
			if COLLECT.excludeLimited and def.Limited == true then
				return true
			end
			if COLLECT.excludeVault and def.SafeId ~= nil then
				return true
			end
			if type(def.Category) == "string" and COLLECT.excludedCategories[def.Category] then
				return true
			end
			if type(def.Name) == "string" and COLLECT.excludedItemNames[def.Name] then
				return true
			end
			if next(COLLECT.excludedMutations) ~= nil then
				for _, mutationName in ipairs(ReadMutatorNames(item)) do
					if COLLECT.excludedMutations[mutationName] then
						return true
					end
				end
				if COLLECT.excludedMutations["Mint"] and IsMintCondition(item:GetAttribute("Condition")) then
					return true
				end
			end
		end
	end

	if COLLECT.minValueActive then
		def = def or GetCarryableItemDef(item)
		if def then
			local value = GetCarryableValue(item, def)
			if type(value) == "number" and value < COLLECT.minValue then
				return true
			end
		end
	end

	return false
end

