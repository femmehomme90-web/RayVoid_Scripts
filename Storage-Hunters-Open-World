function WASHGRADE.SV.Money(n)
	n = math.floor(tonumber(n) or 0)
	local s = tostring(math.abs(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return "$" .. out
end

function WASHGRADE.SV.Clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	if seconds >= 60 then
		return string.format("%dm %02ds", math.floor(seconds / 60), seconds % 60)
	end
	return seconds .. "s"
end

-- One line per unlocked slot: "Slot 2: Golden Lamp (Rare) -- $12,400 -- 1m 05s left".
function WASHGRADE.SV.Describe(m)
	local ok, s = pcall(function()
		return m.getState:InvokeServer()
	end)
	if not ok or type(s) ~= "table" then
		return "Could not read the slots: " .. tostring(s), 0, 0
	end
	local slots = s.slots or {}
	local unlocked = s.unlockedCount or 1
	local now = workspace:GetServerTimeNow()
	local lines, used, total = {}, 0, 0
	for i = 1, unlocked do
		local d = m.SlotData(slots, i)
		if type(d) == "table" then
			used = used + 1
			local data = type(d.ItemData) == "table" and d.ItemData or d
			local def = Items[tostring(data.ItemId)]
			local name = type(def) == "table" and def.Name or ("item " .. tostring(data.ItemId))
			local rarity = type(def) == "table" and def.Rarity or nil
			local value = 0
			if type(def) == "table" and ComputeStockPrice then
				local okPrice, price = pcall(ComputeStockPrice, data, def)
				if okPrice and type(price) == "number" then
					value = price
				end
			end
			total = total + value
			local left = ((d.StartTime or 0) + (d.Duration or 0)) - now
			local timer = left > 0 and (WASHGRADE.SV.Clock(left) .. " left") or "done, collecting"
			table.insert(lines, string.format("Slot %d: %s%s -- %s -- %s", i, name,
				rarity and (" (" .. rarity .. ")") or "", WASHGRADE.SV.Money(value), timer))
		else
			table.insert(lines, string.format("Slot %d: empty", i))
		end
	end
	local header = string.format("%d/%d full%s, worth %s in total", used, unlocked,
		used >= unlocked and " (ALL FULL)" or "", WASHGRADE.SV.Money(total))
	return header .. "\n" .. table.concat(lines, "\n"), used, unlocked
end

function WASHGRADE.SV.Refresh()
	for _, pair in ipairs({ { WASHGRADE.SV.washParagraph, WASH, "Wash slots" }, { WASHGRADE.SV.gradeParagraph, GRADE, "Grade slots" } }) do
		local text, used, unlocked = WASHGRADE.SV.Describe(pair[2])
		pcall(function()
			pair[1]:Set({ Title = string.format("%s (%d/%d)", pair[3], used, unlocked), Content = text })
		end)
	end
end

