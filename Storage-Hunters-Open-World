-- SHARED rarity list. Despite the GRADE_ name and living under this banner,
-- it feeds every rarity dropdown in the script: Auto Grade, AutoSell,
-- AutoPlace and the Min Bid override. It sits here only because Auto Grade
-- needed it first. Nothing below this comment is Auto Grade specific.
-- ---------------------------------------------------------------
-- Built from the rarities items ACTUALLY have, not from Modules.Rarities.
-- That module is a list of colours, not a list of rarities, and the two do
-- not match: it includes "Trophy" (really a Category, 2 items) and "Limited"
-- (really a tag mutation, cf. FORCEBID's note on TagMutations), neither of
-- which any item carries as a rarity, and it omits "Common", which one item
-- does have. Offering rarities that can never match made every rarity
-- dropdown in the script -- Grade, AutoSell, AutoPlace, Min Bid -- quietly
-- wrong. Verified against all 1039 items.
local GRADE_RARITY_OPTIONS = (function()
	local seen = {}
	local names = {}
	for _, def in pairs(Items) do
		if type(def) == "table" and type(def.Rarity) == "string" and def.Rarity ~= "" then
			if not seen[def.Rarity] then
				seen[def.Rarity] = true
				table.insert(names, def.Rarity)
			end
		end
	end
	table.sort(names)
	return names
end)()


-- Value filter: above this threshold we do NOT grade. A bad roll
-- (Replica, 1 star) divides the item's value; the risk is not worth
-- it on expensive pieces. (ComputeStockPrice is forward-declared above,
-- before Wash, which needs it too.)

-- Single predicate: "should this item go to grading now?".
-- Read by the GRADE handler AND by IsPlaceableNow. Both MUST read the
-- same rule: if the handler skips an item that IsPlaceableNow still
-- refuses to place, the item stays stuck in the inventory forever.
local function ShouldGradeEntry(entry, itemDef)
	-- Item Rules first: a rule is the user saying so in as many words, and it
	-- outranks even the Grade Vault bypass below. Inert while the tab is empty.
	if RULES.LaneArmed("grade") then
		local verdict = RULES.Decide("grade", {
			name = itemDef.Name,
			category = itemDef.Category,
			rarity = itemDef.Rarity,
			mutations = entry.Mutators,
			traits = RULES.TraitsFor(itemDef, entry.ItemId),
			condition = entry.Condition,
			value = ComputeStockPrice(entry, itemDef),
			-- The ROLLED weight when the item has one (Uranium Ore, Hay, the
			-- crops, the eggs -- 20 of them roll per item), otherwise the
			-- item's fixed weight from its definition. Measured:
			-- all 1039 item definitions carry a Weight, so a KG rule is not
			-- a uranium-only tool and should not behave like one.
			weight = entry.Weight or (type(itemDef) == "table" and itemDef.Weight) or nil,
		})
		if verdict == "force" then
			return not IsEntryGraded(entry)
		elseif verdict == "block" then
			return false
		end
	end

	-- Grade Vault: a safe (itemDef.SafeId) must be graded BEFORE
	-- AutoVault opens it, if both toggles are active. This path is
	-- completely independent of gradeActive/gradeRarities/gradeMax/
	-- gradeMin -- a safe goes through as soon as this toggle is on,
	-- whatever its rarity or value. We return early so we never fall
	-- into the normal rarity filter below.
	if itemDef.SafeId ~= nil then
		if WASHGRADE.gradeVaultActive and AUTOVAULT.active then
			return not IsEntryGraded(entry)
		end
		-- Otherwise a safe follows exactly the same path as any other
		-- item: the normal rarity/value filter below applies (so a safe
		-- of a checked rarity can still get graded even without Grade
		-- Vault active).
	end

	if not WASHGRADE.gradeActive then
		return false
	end

	local isEnergyDrink = ENERGY_DRINK_ITEM_IDS[tostring(entry.ItemId)] == true
	local drinkPass = isEnergyDrink and WASHGRADE.gradeEnergyDrinks

	-- Energy drinks do not necessarily have a rarity relevant to this
	-- filter -- with the toggle active they go through whatever the
	-- rarities checked in Rarities to Grade.
	if not drinkPass then
		local rarity = itemDef.Rarity or "Uncommon"
		if not WASHGRADE.gradeRarities[rarity] then
			return false
		end
	end

	if IsEntryGraded(entry) then
		return false
	end

	-- A drink the user has explicitly asked to grade also skips the value
	-- filters, exactly as a Grade Vault safe does at the top of this
	-- function. Reason: ComputeStockPrice reads itemDef.BasePrice, and a
	-- drink is priced by the Energy Shop rather than by BasePrice, so it
	-- computes near zero -- which means ANY Min Value setting silently threw
	-- away every drink while the toggle sat there switched on. A control
	-- that cannot do the thing its name promises is the bug, not the filter.
	if drinkPass then
		return true
	end

	-- The value test comes AFTER IsEntryGraded: the item is therefore
	-- necessarily ungraded here, and ComputeStockPrice does return its
	-- value BEFORE grading (no grade multiplier applied).
	if WASHGRADE.gradeMaxActive then
		local value = ComputeStockPrice(entry, itemDef)
		if type(value) == "number" and value > WASHGRADE.gradeMax then
			return false
		end
	end

	if WASHGRADE.gradeMinActive then
		local value = ComputeStockPrice(entry, itemDef)
		if type(value) == "number" and value < WASHGRADE.gradeMin then
			return false
		end
	end

	return true
end

-- Accepts "50000", "50k", "1.5m", "$50,000".
local function ParseValueInput(text)
	if type(text) ~= "string" then
		return nil
	end

	local cleaned = string.gsub(text, "[%s%$,]", "")
	cleaned = string.lower(cleaned)

	local number, suffix = string.match(cleaned, "^(%d+%.?%d*)([kmbt]?)$")
	if not number then
		return nil
	end

	local value = tonumber(number)
	if not value then
		return nil
	end

	local multipliers = { k = 1000, m = 1000000, b = 1000000000, t = 1000000000000 }
	if suffix ~= "" and multipliers[suffix] then
		value = value * multipliers[suffix]
	end

	return value
end

