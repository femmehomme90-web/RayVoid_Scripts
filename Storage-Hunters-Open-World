-- Used by the AutoFish module further down (EnsureUsableFishingRod) to
-- identify fishing rods in the inventory and equip one.
-- Formerly also used by IsPlaceableNow to exclude rods from the
-- AutoPlace -- exclusion removed at Zachary's request:
-- AutoPlace may now sell rods like any other
-- item.
local function isFishRodDef(def)
	if not def then
		return false
	end
	if def.Interactive == "FishingRod" then
		return true
	end
	-- Safety net: all known tiers ("Fishing Rod", "Scrap Fishing Rod",
	-- "Carbon Fishing Rod") contain "Fishing Rod" in their display name,
	-- even if Interactive were to go missing/change.
	if type(def.Name) == "string" and string.find(def.Name, "Fishing Rod", 1, true) then
		return true
	end
	return false
end

