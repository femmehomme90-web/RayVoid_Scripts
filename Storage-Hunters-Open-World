FARM.toggle = AutoFarmTab:CreateToggle({
	Name = "Auto Farm",
	CurrentValue = false,
	Flag = "AutoFarmToggle",
	Callback = function(Value)
		if Value and SESSION.landedPublic then
			-- We were in a private server minutes ago and this one is public (see
			-- PRIVATE SERVER WATCH). However the player got here -- our reconnect,
			-- Roblox's, or their own rejoin -- refuse rather than farm in a
			-- stranger's server. This is also the path RayVoid takes when it
			-- restores the saved toggle on arrival, which is the whole point: that
			-- restore is what would otherwise start the farm unattended.
			--
			-- The override is this same switch, asked twice. No extra control: the
			-- second flip IS the confirmation and the warning says so. The 3s floor
			-- separates a person flipping it from RayVoid's restore at load, which
			-- lands in the first moment and must never count as the answer.
			if SESSION.publicRefusedAt and (os.clock() - SESSION.publicRefusedAt) > 3 then
				SESSION.landedPublic = false
				SESSION.ForgetPrivateRecord()
				warn("[Server] Auto Farm switched on again -- taking that as deliberate. Farming in this public server.")
			else
				SESSION.publicRefusedAt = os.clock()
				warn("[Server] Auto Farm refused: you were in a private server minutes ago and this one is public. "
					.. "Switch Auto Farm on again if you want to farm here anyway.")
				FARM.active = false
				-- Put the switch back visually, out of line: :Set() re-enters this
				-- callback, and doing that inside it fights RayVoid's own restore.
				task.spawn(function()
					task.wait(0.2)
					if FARM.toggle and FARM.toggle.Set then
						pcall(function()
							FARM.toggle:Set(false)
						end)
					end
				end)
				return
			end
		end
		FARM.active = Value
		if FARM.active then
			-- Auto Farm takes exclusive control. We force Auto Collect ON
			-- visually (collection happens in the Master Cycle), after
			-- remembering what the user actually wanted.
			COLLECT.userWants = COLLECT.active -- snapshot before the override
			COLLECT.active = true
			if COLLECT.toggle and COLLECT.toggle.Set then
				pcall(function()
					COLLECT.toggle:Set(true)
				end)
			end
			MasterCycleLoop()
		else
			-- We restore the state the user wanted. If they had never enabled
			-- Auto Collect, we set it back to false (and its standalone loop
			-- does not start). If they had enabled it, it resumes.
			COLLECT.active = COLLECT.userWants
			if COLLECT.toggle and COLLECT.toggle.Set then
				pcall(function()
					COLLECT.toggle:Set(COLLECT.userWants)
				end)
			end
			if COLLECT.active then
				StartAutoCollect()
			end
		end
	end,
})

