-- POLICE RAID / SEIZED GARAGE ("Police" event)
-- Verified in game (place v286): the server SEIZES one of your NORMAL
-- auction garages. Same .Name / GarageId / AreaName / GUID -- no new
-- type or area to declare. Client-side markers:
--   * a "SeizedDressing" child placed under the garage
--   * the server sends you the GUID via Events.Misc.SeizedGarage("Set", guid)
--     and clears it via ("Clear", guid) -- one seizure at a time, PER PLAYER.
-- The seized garage's lot carries [Redacted] items (x1.25) and rarely
-- [Seized] (x15). Loading that loot into the truck triggers a police
-- chase (server-handled, nothing to do here).
-- A single root-level local for the whole feature (CLAUDE.md rule).
local SEIZED = {
	activeGuid = nil,
	dressingName = "SeizedDressing",
}

do
	local SeizedGarageRemote = Events:WaitForChild("Misc"):WaitForChild("SeizedGarage")

	SESSION.Track(SeizedGarageRemote.OnClientEvent:Connect(function(action, guid)
		if action == "Set" and type(guid) == "string" then
			SEIZED.activeGuid = guid
		elseif action == "Clear" then
			if guid == nil or guid == SEIZED.activeGuid then
				SEIZED.activeGuid = nil
			end
		end
	end))

	-- Like the game client (SeizedGarageClient): asks for the current state
	-- at startup, in case the script is (re)loaded during a seizure.
	task.defer(function()
		pcall(function()
			SeizedGarageRemote:FireServer()
		end)
	end)
end

-- The currently seized garage (Model under workspace._Debris.Garages), or
-- nil. We resolve by the GUID received from the remote; fallback on the
-- "SeizedDressing" child if the GUID has not arrived yet (script loaded
-- mid-seizure).
function SEIZED.GetGarage()
	local Debris = workspace:FindFirstChild("_Debris")
	local GaragesFolder = Debris and Debris:FindFirstChild("Garages")
	if not GaragesFolder then
		return nil
	end
	if SEIZED.activeGuid then
		for _, g in ipairs(GaragesFolder:GetChildren()) do
			if g:GetAttribute("GUID") == SEIZED.activeGuid then
				return g
			end
		end
	end
	for _, g in ipairs(GaragesFolder:GetChildren()) do
		if g:FindFirstChild(SEIZED.dressingName) then
			return g
		end
	end
	return nil
end

function SEIZED.IsActive()
	return SEIZED.GetGarage() ~= nil
end

-- Unix timestamp of the next seizure scheduled for THIS player -- the
-- game exposes it directly on LocalPlayer, no RNG to reimplement. nil if
-- absent.
function SEIZED.NextDueUnix()
	local v = LocalPlayer:GetAttribute("PoliceSeizedGarageNextDueUnix")
	if type(v) == "number" and v > 0 then
		return v
	end
	return nil
end

-- Entry {garage, entrySquare, promptPart, prompt} of the seized garage,
-- or nil. Same shape as GetEligibleGarages() so the Master Cycle consumes
-- it as is. ignoreTypeFilter:
--   nil/false -> returns the entry only if the type is checked in Garage
--                Types ("Prioritize Seized Garage")
--   true      -> any type, even unchecked ("Auto-Grab Any Seized
--                Garage")
function SEIZED.GetEligibleEntry(ignoreTypeFilter)
	local g = SEIZED.GetGarage()
	if not g then
		return nil
	end
	if not ignoreTypeFilter and not FARM.selectedTypes[g.Name] then
		return nil
	end
	local entrySquare = g:FindFirstChild("EntrySquare")
	local promptPart = entrySquare and entrySquare:FindFirstChild("PromptPart")
	local prompt = promptPart and promptPart:FindFirstChild("EnterAuction")
	if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
		return {
			garage = g,
			entrySquare = entrySquare,
			promptPart = promptPart,
			prompt = prompt,
		}
	end
	return nil
end


-- AUTO FARM (garages) -- the full sequencing is handled by the Master
-- Cycle further down, not here.
local function GetAllGarages()
	local Debris = workspace:FindFirstChild("_Debris")
	local GaragesFolder = Debris and Debris:FindFirstChild("Garages")
	if not GaragesFolder then
		return {}
	end
	return GaragesFolder:GetChildren()
end

-- Garage types / areas removed from the game but still listed in
-- Modules.Garages and Modules.Areas (dead entries; a future place version
-- will remove them, meanwhile we filter them ourselves). Selecting one of
-- these types did nothing anyway -- GetEligibleGarages never finds the
-- matching instance in _Debris.Garages. A single root-level local
-- (CLAUDE.md rule).
local REMOVED = {
	garagePatterns = { "Alien Garage", "Jurassic" },
	areaNames = { ["Alien Invasion"] = true, ["Jurassic"] = true },
}

function REMOVED.IsGarageType(name)
	for _, pattern in ipairs(REMOVED.garagePatterns) do
		if string.find(name, pattern, 1, true) then
			return true
		end
	end
	return false
end

-- Built from ReplicatedStorage.Modules.Garages rather than hardcoded:
-- this table's keys ARE the exact name matching garage.Name in game
-- (unlike def.Name, which is only a display label often shared between
-- several variants -- "Scrap Garage 2" and "Scrap Garage 3" both have
-- Name="Scrap Garage"). The module also contains non-garage entries
-- (DEFAULT_FLOOR_LUCK_MIN/MAX, ResolveMinAuctionValue) which we filter by
-- type(def)=="table" and the presence of def.Name, plus the removed types
-- (REMOVED.IsGarageType).
local function GetAllGarageTypeNames()
	local names = {}
	for key, def in pairs(Garages) do
		if type(def) == "table" and type(def.Name) == "string" and not REMOVED.IsGarageType(key) then
			table.insert(names, key)
		end
	end
	table.sort(names)
	return names
end

local FARM_GARAGE_TYPE_OPTIONS = GetAllGarageTypeNames()

-- FIXED location groups, deduced by keyword in the type name -- the
-- game's Garages module contains no real location info (just
-- MinNetWorth/DoorType/NumItems/EntryCost), so this grouping is an
-- assumption to confirm/adjust in game, not official data. Built
-- dynamically against FARM_GARAGE_TYPE_OPTIONS: a new game type that
-- matches a keyword joins its group automatically, no need to touch
-- this again.
-- Built from ReplicatedStorage.Modules.Areas (the real official area ->
-- garage types mapping, via GarageIds), not by guessing from a keyword
-- in the name. A priority slot can therefore target a whole area
-- ("Cargo Ship", "Lucky Beach", "Power Plant"...) just as much as an
-- individual garage type. The removed areas/types
-- (REMOVED.areaNames / REMOVED.IsGarageType) are excluded.
local LOCATION_GROUPS = {}
do
	local areaNames = {}
	for areaName, def in pairs(Areas) do
		if type(def) == "table" and type(def.GarageIds) == "table" and not REMOVED.areaNames[areaName] then
			table.insert(areaNames, areaName)
		end
	end
	table.sort(areaNames)

	for _, areaName in ipairs(areaNames) do
		local members = {}
		local memberList = {}
		for garageTypeName in pairs(Areas[areaName].GarageIds) do
			if not REMOVED.IsGarageType(garageTypeName) then
				members[garageTypeName] = true
				table.insert(memberList, garageTypeName)
			end
		end
		table.sort(memberList)
		if #memberList > 0 then
			table.insert(LOCATION_GROUPS, { name = areaName, members = members, memberList = memberList })
		end
	end
end

-- A priority slot can contain either a group name or an individual
-- garage type. Returns the set of types covered by the chosen value
-- (the whole group, or just that single type).
local function ResolvePriorityTypeSet(value)
	if not value or value == "None" then
		return nil
	end
	for _, group in ipairs(LOCATION_GROUPS) do
		if group.name == value then
			return group.members
		end
	end
	return { [value] = true }
end

-- types = {[1]=highest priority, ...}, nil if "None". A garage listed
-- here comes BEFORE distance.
-- The option list used to be built once here, holding every area group and
-- every garage type. It is now computed by GARAGEPRIORITY.BuildOptions()
-- from what is checked in Garage Types, so there is no static list any more.
local GARAGEPRIORITY = {
	types = { nil, nil, nil, nil },
}

-- A single callback parameterized by slot: avoids duplicating the same
-- parsing logic 3x (RayVoid returns either a table or a string
-- depending on the version, cf. "Place every N containers" above).
function GARAGEPRIORITY.MakeCallback(slotIndex)
	return function(selected)
		local value = selected
		if type(selected) == "table" then
			value = selected[1]
		end
		if value == nil or value == "None" then
			GARAGEPRIORITY.types[slotIndex] = nil
		else
			GARAGEPRIORITY.types[slotIndex] = value
		end
	end
end

-- The 3 priority dropdowns, filled in when the UI is built, so the options
-- can be narrowed later. Kept on the table rather than as root-level locals
-- (Lua 5.1 caps them at 200).
GARAGEPRIORITY.dropdowns = {}

-- Only what is actually checked in "Garage Types" is worth offering here: a
-- priority slot pointing at an unchecked type does nothing, because
-- GetEligibleGarages filters on FARM.selectedTypes first. Offering all 40+
-- types made it look as though picking one was enough.
--
-- Area names (Business Bay, Lucky Beach, ...) are deliberately NOT offered.
-- They used to be, so a slot could target a whole area, but an area is not a
-- garage type and never appears in the Garage Types list above, which made it
-- look like a stray entry. LOCATION_GROUPS and ResolvePriorityTypeSet still
-- handle a group value if one is ever restored here.
function GARAGEPRIORITY.BuildOptions()
	local options = { "None" }

	for _, garageName in ipairs(FARM_GARAGE_TYPE_OPTIONS) do
		if FARM.selectedTypes[garageName] then
			table.insert(options, garageName)
		end
	end

	return options
end

-- Called whenever the Garage Types selection changes. A slot holding a value
-- that is no longer offered is cleared -- and said out loud, because
-- silently keeping a priority the user can no longer see in the list is
-- exactly the kind of invisible state that causes "why is it going there?".
function GARAGEPRIORITY.RefreshOptions()
	local options = GARAGEPRIORITY.BuildOptions()

	local stillOffered = {}
	for _, name in ipairs(options) do
		stillOffered[name] = true
	end

	for slotIndex = 1, 4 do
		local current = GARAGEPRIORITY.types[slotIndex]
		if current and not stillOffered[current] then
			GARAGEPRIORITY.types[slotIndex] = nil
			warn(string.format(
				"[GaragePriority] Priority %d was '%s', which is no longer checked in Garage Types -- cleared",
				slotIndex, tostring(current)))
		end

		local dropdown = GARAGEPRIORITY.dropdowns[slotIndex]
		if dropdown and dropdown.Refresh then
			pcall(function()
				dropdown:Refresh(options)
			end)
		end
	end
end


-- AREA POSITION (to move closer to an area whose garages are not yet
-- streamed). Universal: works for any garage type, no longer needs the
-- hand-written STREAMING_ANCHOR_PATHS table (which only covered Power
-- Plant + Business Bay). Three sources, in
-- order:
--   1. GPS POIs (Events.GPS.GetPOIs) -- every permanent area is there
--      with an exact position. Cached once (server round-trip).
--   2. Areas.GetMascotNavTarget(garageId) -- resolves workspace.Areas.<area>.
--      <Mascot>, only for areas that have a Mascot.
--   3. The workspace.Areas.<area> model itself, if it is already (at
--      least partially) loaded.
-- Returns nil if no source resolves (e.g. "Cargo Ship" -- an event area,
-- absent from POIs, without a Mascot, not under workspace.Areas at rest).
local AREAPOS = {
	poiCache = nil, -- areaName -> Vector3, filled on the 1st call
}

function AREAPOS.LoadPOIs()
	if AREAPOS.poiCache then
		return
	end
	AREAPOS.poiCache = {}
	local gps = Events:FindFirstChild("GPS")
	local getPOIs = gps and gps:FindFirstChild("GetPOIs")
	if not getPOIs then
		return
	end
	local ok, data = pcall(function()
		return getPOIs:InvokeServer()
	end)
	if ok and type(data) == "table" and type(data.pois) == "table" then
		for _, poi in ipairs(data.pois) do
			if poi.category == "Area" and type(poi.name) == "string" and typeof(poi.position) == "Vector3" then
				AREAPOS.poiCache[poi.name] = poi.position
			end
		end
	end
end

-- Returns (position, areaName) or (nil, areaName|nil).
function AREAPOS.ForGarageType(garageTypeName)
	local areaName
	local ok = pcall(function()
		areaName = Areas.GetGarageAreaName(garageTypeName)
	end)
	if not ok or type(areaName) ~= "string" then
		return nil, nil
	end

	AREAPOS.LoadPOIs()
	if AREAPOS.poiCache and AREAPOS.poiCache[areaName] then
		return AREAPOS.poiCache[areaName], areaName
	end

	local mok, _, mpos = pcall(function()
		return Areas.GetMascotNavTarget(garageTypeName)
	end)
	if mok and typeof(mpos) == "Vector3" then
		return mpos, areaName
	end

	local areasFolder = workspace:FindFirstChild("Areas")
	local areaModel = areasFolder and areasFolder:FindFirstChild(areaName)
	if areaModel then
		local p = ResolvePosition(areaModel)
		if p then
			return p, areaName
		end
	end

	return nil, areaName
end


local function GetEligibleGarages()
	local eligible = {}
	for _, garage in ipairs(GetAllGarages()) do
		if FARM.selectedTypes[garage.Name] then
			local entrySquare = garage:FindFirstChild("EntrySquare")
			local promptPart = entrySquare and entrySquare:FindFirstChild("PromptPart")
			local prompt = promptPart and promptPart:FindFirstChild("EnterAuction")

			if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
				table.insert(eligible, {
					garage = garage,
					entrySquare = entrySquare,
					promptPart = promptPart,
					prompt = prompt,
				})
			end
		end
	end
	return eligible
end

local function GetFarmReferencePosition()
	if FARM.preferNearestToVehicle then
		local truck = GetPlayerTruck()
		if truck then
			local truckPosition = ResolvePosition(truck)
			if truckPosition then
				return truckPosition
			end
		end
	end
	local hrp = GetFreshHRP()
	if hrp then
		return hrp.Position
	end
	return HRP.Position
end

-- On FARM (not a root-level local -- Lua 5.1 caps at 200).
FARM.truckMaxDistance = 100

local function TeleportPlayerAndTruck(targetPosition)
	local targetCFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))
	local vehicle = GetSeatedVehicle()
	DebugPrint("[AutoFarm] TeleportPlayerAndTruck: seated=" .. tostring(vehicle ~= nil))

	if vehicle then
		local primary = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
		if not primary then
			warn("[AutoFarm] No BasePart found in the vehicle")
			SafeSetHRPCFrame(targetCFrame)
			return
		end
		if vehicle.PrimaryPart then
			vehicle:SetPrimaryPartCFrame(targetCFrame)
		else
			primary.CFrame = targetCFrame
		end
		-- Residual velocity on an assembled vehicle (wheels/suspensions/
		-- joints) after an instant TP = brutal physics discontinuity, the
		-- likely source of the crash during AutoFarm (never in standalone,
		-- which never teleports the truck).
		for _, part in ipairs(vehicle:GetDescendants()) do
			if part:IsA("BasePart") then
				ZeroVelocity(part)
			end
		end
		task.wait()
		return
	end

	-- Not seated: we teleport ONLY the player here. The truck catch-up
	-- (VEHICLESPAWN) now happens AFTER the auction starts, so it no longer
	-- delays entering the bid.
	SafeSetHRPCFrame(targetCFrame)
	DebugPrint("[AutoFarm] Player teleported (not seated)")
end

-- Catches the truck up once the auction has started: if the player is not
-- seated in it (otherwise it already followed via TeleportPlayerAndTruck)
-- and the truck is too far, we request its spawn and exit the seat as
-- soon as the game seats us. Never blocks entering the auction.
local function CatchUpVehicle(targetPosition)
	if GetSeatedVehicle() then
		return
	end

	local truck = GetPlayerTruck()
	if not truck then
		warn("[AutoFarm] Player truck not found, cannot catch up")
		return
	end

	-- Double read, 0.3s apart, before concluding "too far": a SINGLE
	-- read right after a big TP (the player jumping far to place/farm
	-- while the truck stays behind) can land on a position not yet
	-- resynchronized client-side (streaming -- confirmed active on this
	-- game, ModelStreamingMode.Default) and give a momentarily wrong
	-- distance -- reported by players as "the truck is seen as too far
	-- when it is not". Requiring BOTH reads to agree on "too far" before
	-- requesting a respawn costs 0.3s in the worst case, but avoids a
	-- pointless recall (and the visual glitch it causes) on a transient
	-- reading.
	local function ReadTruckDistance()
		local pos = ResolvePosition(truck)
		if not pos then
			return nil
		end
		return (targetPosition - pos).Magnitude
	end

	local firstDistance = ReadTruckDistance()
	if firstDistance and firstDistance <= FARM.truckMaxDistance then
		DebugPrint(string.format("[AutoFarm] Truck already close enough (%.0f studs), no catch-up", firstDistance))
		return
	end

	task.wait(0.3)

	local secondDistance = ReadTruckDistance()
	if secondDistance and secondDistance <= FARM.truckMaxDistance then
		DebugPrint(string.format("[AutoFarm] Truck close enough on 2nd read (%.0f -> %.0f studs, 1st read was stale/transient), no catch-up", firstDistance or -1, secondDistance))
		return
	end

	DebugPrint(string.format("[AutoFarm] Truck confirmed far on 2 reads (%.0f then %.0f studs, threshold %.0f), requesting catch-up",
		firstDistance or -1, secondDistance or -1, FARM.truckMaxDistance))

	-- Official remote rather than a manual CFrame: avoids the physics
	-- discontinuity on the assembled vehicle (wheels/suspensions/joints).
	-- RequestAndWait (instead of a single-attempt Request+WaitAndExit)
	-- retries if the server does not answer in time -- the most likely
	-- cause of "the truck does not teleport next to the player".
	if not VEHICLESPAWN.RequestAndWait(3) then
		warn("[AutoFarm] Vehicle spawn request failed, truck may be left behind")
	end
end

-- Auto Farm sitting there doing nothing is indistinguishable from Auto Farm
-- being broken, and every dead end in TryEnterNextAuction used to be a
-- DebugPrint -- silent unless SH-debug-toggle turned it on. So the blocking
-- ones say it out loud instead. Once per reason, though: the master
-- cycle comes back here every 2s and a line per pass would bury the console.
-- FARM.Busy() clears the latch when a garage is actually taken, so a later
-- stall speaks again rather than being swallowed as a repeat.
function FARM.Idle(reason)
	if FARM.idleReason == reason and (os.clock() - (FARM.idleAt or 0)) < 30 then
		return
	end
	FARM.idleReason = reason
	FARM.idleAt = os.clock()
	warn("[AutoFarm] on, but not farming: " .. reason)
end

-- When something last actually moved. The stall watchdog in the master cycle
-- used to time the auction STATE instead, and the state is a poor proxy for
-- progress: SEARCHING covers travelling, entering a garage, waiting for the
-- bid window to open AND the whole unload/place trip home, any of which runs
-- past 90s with the farm working perfectly. Stamped on a garage taken, on
-- every bid update, and at the end of a collect pass.
function FARM.Moved()
	FARM.progressAt = os.clock()
end

function FARM.Busy()
	FARM.idleReason = nil
	FARM.Moved()
end

-- The stall watchdog inside the master cycle only looks between steps, so a
-- step that never returns -- a call that is never answered -- is exactly what
-- it cannot see: measured, Auto Farm sat frozen for 25 minutes and
-- printed nothing at all. This runs from the Wild West watchdog loop instead
-- (its own thread, always on) and reads the loop's heartbeat. It only WARNS:
-- a legitimate step, a long placement trip, can also run for minutes, and
-- cutting one off mid-way is worse than a message. Once per stall.
FARM.STALL_WARN_SECONDS = 300
function FARM.CheckStall()
	if not LOOPGUARDS.masterCycle or not FARM.tickAt then
		return
	end
	local stuckFor = os.clock() - FARM.tickAt
	if stuckFor >= FARM.STALL_WARN_SECONDS and FARM.stallWarnedFor ~= FARM.tickAt then
		FARM.stallWarnedFor = FARM.tickAt
		warn(string.format("[AutoFarm] The master cycle has been inside one step for %.0f s (%s). If it does not clear it is stuck, and reloading the script restarts it",
			stuckFor, tostring(FARM.step)))
	end
end

-- Master cycle pacing. Normally the loop ticks at 0.5s while BIDDING and 2s
-- between search attempts, which is fine when it is waiting on the game. But
-- after an exit we KNOW is final -- a Min Bid skip, or an auction lost -- there
-- is nothing to wait for, and those two waits together cost up to 2.5s before
-- the next garage is even looked for. That is the dead time the auction-start
-- potion is bought to remove.
--
-- So the exits that know set FARM.hurryUntil, and every wait inside the window
-- collapses to a short slice. Outside it nothing changes, so an idle farm is no
-- busier than before and TryEnterNextAuction is not hammered.
FARM.HURRY_WINDOW = 5
FARM.HURRY_SLICE = 0.4

function FARM.PacedWait(seconds)
	if os.clock() < (FARM.hurryUntil or 0) then
		seconds = math.min(seconds, FARM.HURRY_SLICE)
	end
	task.wait(seconds)
end

function FARM.Hurry()
	FARM.hurryUntil = os.clock() + FARM.HURRY_WINDOW
end

local function TryEnterNextAuction()
	-- A horse race is due (see noNewAuctionUntil). Measured: Race
	-- pauses the farm only 20 s ahead with 10 s to spare, and a lot takes ~40 s
	-- from fee to collected, so one entered late either skipped the race
	-- (11:45) or was left uncollected.
	if os.clock() < FARM.noNewAuctionUntil then
		DebugPrint("[AutoFarm] A horse race is due -- not starting a new auction")
		return
	end
	if os.clock() < FARM.cooldownUntil then
		-- THE HOLE, found from the user's log: four "On cooldown"
		-- lines counting down a full 15s with no auction between them.
		--
		-- The 15s is armed the moment a garage is committed to, and every way
		-- an auction can END clears it -- Min Bid skip, lost, and (since
		-- yesterday) won. But if the auction never STARTS, there is no exit
		-- path, so nothing clears it and the farm sits out the whole 15s for a
		-- garage it never got into. The prompt can simply not take: someone
		-- else took the garage first, the Lost & Found popup ate it, the
		-- prompt was out of range on arrival.
		--
		-- Nothing signals "the prompt did not take", so this is a timeout --
		-- but a short one against the game's own 3s start timer, not 15s. If
		-- the auction did start we are not in SEARCHING and never reach here.
		if FARM.committedAt and (os.clock() - FARM.committedAt) > FARM.AUCTION_START_GRACE then
			FARM.deadCommits = FARM.deadCommits + 1
			local line = "[AutoFarm] " .. tostring(FARM.committedGarage or "that garage") ..
				" never started an auction after " .. FARM.AUCTION_START_GRACE ..
				"s -- someone else probably took it. Moving to the next garage instead of waiting out the cooldown."
			if not FARM.deadCommitWarned then
				FARM.deadCommitWarned = true
				warn(line)
			else
				DebugPrint(line .. " (" .. FARM.deadCommits .. " so far this session)")
			end
			FARM.cooldownUntil = 0
			FARM.committedAt = nil
			FARM.committedGarage = nil
			FARM.Hurry()
		else
			DebugPrint("[AutoFarm] On cooldown, " .. string.format("%.1f", FARM.cooldownUntil - os.clock()) .. "s")
			return
		end
	end

	-- Settle window after an auction ends: the "Sold to" and the
	-- carryable spawn arrive AFTER the bid UI closes. Leaving now would
	-- abandon a lot we may have just won, with the collection cut off
	-- midway.
	if os.clock() < AUCTION.settleUntil then
		DebugPrint("[AutoFarm] Settling after last auction, waiting before entering a new one")
		return
	end

	-- Safety: never move on to a new garage if items of ours are still on
	-- the ground. The master should not get here in that case, but if the
	-- FSM has desynchronized (state forced by a game event), this avoids
	-- abandoning a half-empty garage.
	if CountOwnedCarryablePrompts() > 0 then
		FARM.groundSince = FARM.groundSince or os.clock()
		if (os.clock() - FARM.groundSince) > 30 then
			FARM.Idle("items of yours are still on the ground -- no new auction is entered until they are collected")
		end
		DebugPrint("[AutoFarm] Items still on the ground, not entering a new auction yet")
		return
	end
	FARM.groundSince = nil

	-- The game only allows the drink-loadout swap back while SEARCHING, and
	-- entering a new auction here is a choice this function makes, not
	-- something the game forces on us -- unlike the auction itself. Checking
	-- only pendingRestore (a restore that already failed once) leaves the gap
	-- BEFORE that: WearDrinkLoadout has switched to the drink loadout, the
	-- drink is in flight, and the switch back hasn't been attempted yet --
	-- committing to a new garage in that window is exactly what makes the
	-- switch back fail a moment later. swapInProgress covers that gap too.
	if ENERGYDRINK.loadoutEnabled and (ENERGYDRINK.pendingRestore or ENERGYDRINK.swapInProgress) then
		DebugPrint("[AutoFarm] Holding off a new auction: EnergyDrink is mid-swap or still owes a switch back")
		return
	end

	local target = nil
	local referencePosition = GetFarmReferencePosition()

	-- SEIZED garage (Police event): absolute priority, before GARAGEPRIORITY
	-- and distance. Short window + [Redacted]/[Seized] lot (x15).
	--   prioritizeSeized  -> only if its type is checked in Garage Types
	--   autoGrabAnySeized -> any type (SEIZED.GetEligibleEntry with
	--                        ignoreTypeFilter = true)
	-- Once that garage is complete (bid/win/collect + unload/place handle
	-- the rest), the Master returns to SEARCHING and we come back here: if
	-- a seized garage remains we take it, else we continue normal farming.
	if FARM.prioritizeSeized or FARM.autoGrabAnySeized then
		local seizedEntry = SEIZED.GetEligibleEntry(FARM.autoGrabAnySeized)
		if seizedEntry then
			target = seizedEntry
			DebugPrint("[AutoFarm] Seized garage active, overriding priority/distance: " .. target.garage.Name)
		end
	end

	if not target then
		if next(FARM.selectedTypes) == nil then
			-- RayVoid restores saved toggles/dropdowns by iterating flags with
			-- pairs(), so on an autoload the Auto Farm toggle can fire before
			-- the Garage Types dropdown's restore has landed -- a real but
			-- self-correcting race, not a real empty selection. 2s covers that
			-- restore without hiding a genuinely empty list for long.
			if not FARM.activatedAt or (os.clock() - FARM.activatedAt) > 2 then
				FARM.Idle("no garage type is ticked in the Garage Types list")
			end
			return
		end

		local eligible = GetEligibleGarages()
		if #eligible == 0 then
			-- No eligible instance. Two causes: (a) the chosen areas are too
			-- far and Roblox streaming has unloaded their garages -- moving
			-- closer makes them appear; (b) there really is no auction
			-- available for those types right now.
			-- We PROBE: TP to the area of a chosen type (position resolved by
			-- AREAPOS -- GPS POI, mascot, or area model -- universal, no more
			-- hand-written list), we wait for streaming, we RE-SCAN in the
			-- same pass. If something loads -> we continue with it. Still
			-- nothing -> cooldown on the area (no looping back and forth) and
			-- we hand back control.
			local probedArea = nil
			local arrivedAt = os.clock()
			for garageName in pairs(FARM.selectedTypes) do
				local anchorPos, areaName = AREAPOS.ForGarageType(garageName)
				if anchorPos and areaName
					and (FARM.areaProbeCooldown[areaName] or 0) <= os.clock() then
					DebugPrint("[AutoFarm] No eligible garage, moving to " .. areaName .. " to stream its garages in")
					-- Unburied: Business Bay's POI is 11 studs underground, and this is
					-- the move that follows every outlaw sweep (the player is at the
					-- Sheriff, so the bay's garages have streamed out).
					local landing = TPCACHE.Unburied(anchorPos)
					if landing ~= anchorPos then
						DebugPrint(string.format("[AutoFarm] %s's map position is underground, landing %.0f studs higher", areaName, landing.Y - anchorPos.Y))
					end
					TeleportPlayerAndTruck(landing)
					arrivedAt = os.clock()
					-- The check from afar can lose the streaming race (see Unburied);
					-- standing there, it cannot. Spends the streaming wait below.
					if landing == anchorPos and TPCACHE.LiftIfBuried(anchorPos, TeleportPlayerAndTruck) then
						DebugPrint("[AutoFarm] " .. areaName .. "'s map position was underground after all, moved up onto the surface")
					end
					probedArea = areaName
					break
				end
			end

			if not probedArea then
				FARM.Idle("no auction is up for the ticked garage types, and their areas are unreachable or on a back-off")
				return
			end

			-- 2s from arrival for the garages to stream in; LiftIfBuried may
			-- already have spent it.
			task.wait(math.max(0, 2 - (os.clock() - arrivedAt)))
			eligible = GetEligibleGarages()
			if #eligible == 0 then
				FARM.areaProbeCooldown[probedArea] = os.clock() + 45
				FARM.Idle("nothing to bid on at " .. probedArea .. " -- backing off 45s, will retry")
				return
			end
			DebugPrint("[AutoFarm] " .. #eligible .. " eligible garage(s) after moving to " .. probedArea)
		else
			DebugPrint("[AutoFarm] " .. #eligible .. " eligible garage(s) found")
		end

		-- Priority: we first look for an eligible instance of a type from the
		-- priority list, in order (1 = highest priority). If found, it is
		-- kept even if a non-priority garage is closer.
		-- If several eligible instances share the SAME slot (e.g. a location
		-- group with several garage tiers in it), we take the highest tier
		-- (highest MinNetWorth in the Garages module), not the closest -- a
		-- priority slot targets "the best garage of this area/type", not
		-- "the fastest to reach". The sort uses the real MinNetWorth value
		-- from the Garages module, not a number extracted from the name --
		-- name digits do not faithfully reproduce the real tier (e.g.
		-- "Scrap Garage 2" and "Scrap Garage 3" share the same
		-- MinNetWorth=0).
		for slotIndex, priorityValue in ipairs(GARAGEPRIORITY.types) do
			if priorityValue then
				local typeSet = ResolvePriorityTypeSet(priorityValue)
				local matches = {}
				for _, entry in ipairs(eligible) do
					if typeSet and typeSet[entry.garage.Name] then
						table.insert(matches, entry)
					end
				end

				if #matches > 0 then
					table.sort(matches, function(a, b)
						local defA = Garages[a.garage.Name]
						local defB = Garages[b.garage.Name]
						local worthA = (type(defA) == "table" and defA.MinNetWorth) or 0
						local worthB = (type(defB) == "table" and defB.MinNetWorth) or 0
						if worthA ~= worthB then
							return worthA > worthB
						end
						-- Same tier: distance breaks the tie.
						local posA = ResolvePosition(a.entrySquare) or ResolvePosition(a.promptPart)
						local posB = ResolvePosition(b.entrySquare) or ResolvePosition(b.promptPart)
						if not posA then
							return false
						end
						if not posB then
							return true
						end
						return (posA - referencePosition).Magnitude < (posB - referencePosition).Magnitude
					end)
					target = matches[1]
					DebugPrint("[AutoFarm] Priority " .. slotIndex .. " (" .. priorityValue .. ") matched, overriding distance sort")
					break
				end
			end
		end

		if not target then
			table.sort(eligible, function(a, b)
				local posA = ResolvePosition(a.entrySquare) or ResolvePosition(a.promptPart)
				local posB = ResolvePosition(b.entrySquare) or ResolvePosition(b.promptPart)
				if not posA then
					return false
				end
				if not posB then
					return true
				end
				return (posA - referencePosition).Magnitude < (posB - referencePosition).Magnitude
			end)
			target = eligible[1]
		end
	end

	-- Stand next to the PROMPT, not the entry square.
	--
	-- Measured, and it explains the whole "garage never
	-- started an auction" problem: the entry square sits ~6.3 studs from the
	-- prompt part, and the teleport adds 3 more upward, so the player landed
	-- 9.3 studs away from a prompt whose MaxActivationDistance is 7. Out of
	-- range on EVERY garage type except Beach Hut (whose parts are 2.4 apart).
	-- fireproximityprompt then does nothing at all, and says nothing either.
	--
	-- It ever worked only by accident: the character is dropped 3 studs up,
	-- and if gravity pulled it back down into range before the fire, the
	-- prompt took. That is why it looked like a random ~50% failure.
	local promptPosition = ResolvePosition(target.promptPart)
	local entryPosition = promptPosition or ResolvePosition(target.entrySquare)
	if not entryPosition then
		warn("[AutoFarm] Could not resolve a position for " .. target.garage.Name)
		return
	end

	FARM.Busy()

	-- The 15s cooldown is armed HERE, at the moment we commit to this
	-- garage -- NOT at the end of this function. Do not move it back.
	--
	-- Everything below (the prompt, the truck catch-up) blocks this
	-- coroutine for seconds, and the auction can be
	-- over before it returns: the Min Bid skip and the "lost" handler both
	-- run on the remote-event thread, and both clear this cooldown because
	-- there is nothing left to wait for. With the arm at the end, it ran
	-- AFTER their clear and put the full 15s back -- which is the long AFK
	-- the user caught, counting 13.0 -> 0.9 straight after a
	-- truck catch-up. Armed here, any exit path's clear always lands last
	-- and wins.
	FARM.cooldownUntil = os.clock() + 15
	-- Remembered so the gate at the top of this function can tell "an auction
	-- is running" from "the prompt never took". Cleared by SetAuctionState.
	FARM.committedAt = os.clock()
	FARM.committedGarage = target.garage.Name

	-- The hurry window belongs to the exit that opened it, and it has
	-- already done its job by now: it collapsed the wait that brought us
	-- back here. Closing it on commitment means a window still open below
	-- can only have been opened by THIS garage's exit, which is what the
	-- catch-up guard at the end of this function relies on.
	FARM.hurryUntil = 0

	DebugPrint("[AutoFarm] Cible: " .. target.garage.Name)

	-- Every step of the entry is timed, because "1-3 seconds for no reason"
	-- (user) cannot be answered by reading code -- the waits left
	-- here are all conditional, so only a real run says which one is paying.
	-- Debug-only, so a normal run is unaffected.
	local stepAt = os.clock()
	TeleportPlayerAndTruck(entryPosition)
	DebugPrint(string.format("[Timing] teleport %.2fs", os.clock() - stepAt))

	-- Wait until the prompt is genuinely REACHABLE, measured against its own
	-- MaxActivationDistance and the prompt part's real position.
	--
	-- The previous version compared the player to `entryPosition` against a
	-- hardcoded 10 studs, which the teleport satisfied in the same instant --
	-- so it always broke immediately and fired from 9.3 studs out. Checking
	-- the thing we actually need to be near is both correct and faster: it
	-- exits the moment the prompt is in reach rather than on a timer.
	stepAt = os.clock()
	local reach = 7
	pcall(function()
		reach = target.prompt.MaxActivationDistance
	end)
	local arriveDeadline = os.clock() + 1.5
	local inReach = false
	while os.clock() < arriveDeadline do
		local hrp = GetFreshHRP()
		if hrp and promptPosition and (hrp.Position - promptPosition).Magnitude <= (reach * 0.85) then
			inReach = true
			break
		end
		task.wait(0.03)
	end
	if not inReach then
		-- Out of reach after a second and a half means the prompt cannot be
		-- fired at all, so the garage is lost before we start. That stops the
		-- loop making progress, so it warns rather than whispering.
		local hrp = GetFreshHRP()
		warn(string.format("[AutoFarm] %s: still %.1f studs from its prompt (reaches %.1f) -- cannot start this auction",
			target.garage.Name,
			(hrp and promptPosition) and (hrp.Position - promptPosition).Magnitude or -1,
			reach))
	end
	DebugPrint(string.format("[Timing] arrival %.2fs (in reach: %s)", os.clock() - stepAt, tostring(inReach)))

	-- These prompts carry HoldDuration = 1, but that costs us nothing:
	-- measured, Real's fireproximityprompt ignores HoldDuration
	-- and triggers within a frame either way. Do not "optimise" it again.
	--
	-- Fire, then WAIT FOR THE FEE, and re-fire if it does not come. Captured
	-- live: the server refuses an entry made while the previous auction of that
	-- garage is still wrapping up -- which is exactly what we do, because we
	-- leave on a Min Bid skip and re-target within 70ms. The refusal is silent
	-- and looks identical to being accepted, so the old code fired once, saw
	-- nothing, and sat out five seconds. The block is over in about two, so
	-- retrying every 400ms lands the entry as soon as the server will take it.
	stepAt = os.clock()
	local entered = false
	for attempt = 1, 6 do
		local before = FARM.feePaidSeq or 0
		local ok, err = pcall(function()
			fireproximityprompt(target.prompt)
		end)
		if not ok then
			warn("[AutoFarm] fireproximityprompt failed: " .. tostring(err))
			break
		end

		-- If the area's Lost & Found box holds something, the server parks the
		-- entry behind a "Before you start" question and no fee comes. The
		-- remote is the "yes, override" answer; sent blind 0.1s after the
		-- prompt so it cannot overtake the prompt trigger on the wire, and
		-- without touching the popup, which is only cosmetic once answered.
		local deadline = os.clock() + 0.5
		local overrideAt = os.clock() + 0.1
		local overrideSent = false
		while os.clock() < deadline do
			if (FARM.feePaidSeq or 0) ~= before then
				entered = true
				break
			end
			if not overrideSent and os.clock() >= overrideAt then
				overrideSent = true
				pcall(function()
					REMOTES.LostFoundOverride:FireServer(true)
				end)
			end
			task.wait(0.03)
		end

		if entered then
			DebugPrint(string.format("[Timing] prompt %.2fs (accepted on attempt %d)",
				os.clock() - stepAt, attempt))
			break
		end
	end

	if not entered then
		-- Six tries over ~2.4s and the server never charged us. Something other
		-- than the usual "previous auction still closing" is in the way.
		DebugPrint(string.format("[Timing] prompt %.2fs (never accepted)", os.clock() - stepAt))
	end

	-- Truck catch-up AFTER the auction starts: no longer delays entering
	-- the bid. Skipped when the auction is already over -- a Min Bid skip
	-- resolves in under a second, well inside the 0.3s double read plus
	-- the 3s spawn wait below, and pulling the truck to a garage we have
	-- just walked out of is pure dead time. The next garage catches it up.
	if AUCTION.state == "SEARCHING" and os.clock() < (FARM.hurryUntil or 0) then
		DebugPrint("[AutoFarm] Auction already over, skipping the truck catch-up here")
	else
		CatchUpVehicle(entryPosition)
	end
end

-- =========================================================
-- AUTO QUEST -- tour the quest NPCs you pick and accept / claim for you.
-- =========================================================
-- **The worklist said this needed a decision between "passive" and
-- "touring" because the NPC model could only come from a proximity prompt.
-- That premise is wrong, measured: every quest NPC is an ordinary
-- model in `workspace` carrying an `NPCQuestPrompt`, so scanning for the
-- prompt yields the model AND its position.** 18 of them, all reach 10 and
-- HoldDuration 0. Touring is therefore not the expensive option it looked
-- like, which is why the user's "go to the chosen NPCs, deliberately" is
-- what is built here.
--
-- The protocol is the captured one (docs/game-reference.md):
--   accept: UI.QuestPromptTriggered:InvokeServer(model)
--           -> UI.StartQuestDialog gives the quest name
--           -> UI.SendQuestDialogResult:FireServer(model, questName, "accept")
--   claim : triggering the prompt is enough -- the reward is granted before
--           any answer is given. A reward dialog is recognised by its
--           QuestName being "<NPCName>'s Reward".
--
-- On safety, and it is the whole reason this shipped the night after a Master
-- Cycle change broke item pickup: this is OFF by default and the ONLY thing
-- it adds to the Master Cycle is `QUEST.RunTourIfDue()`, which returns on a
-- boolean before touching anything when the toggle is off. A farm with Auto
-- Quest off runs byte-for-byte the same sequence as before.
local QUEST = {
	active = false,
	selected = {},          -- npcName -> true, from the dropdown
	options = {},           -- display labels for the dropdown ("Ted - Farmyard")
	labels = {},            -- display label -> npcName
	areas = {},             -- npcName -> area string, or false for "no area"
	cooldown = {},          -- npcName -> os.clock() before which we skip it
	npcCache = nil,
	npcCacheAt = 0,
	lastTourAt = 0,
	handled = 0,
	warned = false,
	dropdown = nil,
	-- Scanning every workspace descendant is not free, and quest NPCs do not
	-- move or respawn, so this is cached for two minutes.
	CACHE_FOR = 120,
	-- Between tours. A quest does not become available often; this is not a
	-- polling loop, it is a "have a look now and then" timer.
	TOUR_EVERY = 90,
	-- After talking to one NPC, do not go back for 5 minutes even if its
	-- exclamation mark is still up -- that is how a server-side refusal
	-- stops becoming an infinite round trip.
	NPC_COOLDOWN = 300,
	-- The server refuses the prompt until it has seen us arrive, so the
	-- trigger is fired and re-fired rather than waited out. Measured
	-- ~1500 stud teleport: refused at 0.00s / 0.25s / 0.50s,
	-- accepted at 1.00s. 8 tries at 0.3s covers ~2.5s of server lag.
	TRIGGER_TRIES = 8,
	TRIGGER_RETRY = 0.3,
}

function QUEST.ScanNPCs()
	if QUEST.npcCache and (os.clock() - QUEST.npcCacheAt) < QUEST.CACHE_FOR then
		return QUEST.npcCache
	end
	local found = {}
	local ok, err = pcall(function()
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d.Name == "NPCQuestPrompt" then
				local model = d:FindFirstAncestorOfClass("Model")
				local root = model and model:FindFirstChild("HumanoidRootPart")
				if model and root then
					found[model.Name] = { model = model, prompt = d, root = root }
				end
			end
		end
	end)
	if not ok then
		warn("[AutoQuest] Could not scan for quest NPCs: " .. tostring(err))
		return QUEST.npcCache or {}
	end
	QUEST.npcCache = found
	QUEST.npcCacheAt = os.clock()
	return found
end

-- Which NPCs currently want talking to. The game puts a
-- `QuestExclamation_<NPCName>` BillboardGui in PlayerGui for exactly those,
-- which is a far cheaper signal than reconstructing state from
-- Quest.QuestStateSync -- and it is the same mark the player sees.
function QUEST.PendingNames()
	local names = {}
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then
		return names
	end
	for _, g in ipairs(pg:GetChildren()) do
		if g:IsA("BillboardGui") and string.sub(g.Name, 1, 17) == "QuestExclamation_" and g.Enabled then
			names[string.sub(g.Name, 18)] = true
		end
	end
	return names
end

-- The game's own quest table, keyed by NPC name (22 entries). It answers both
-- questions the dropdown has: "is this a real quest giver" and "which area".
QUEST.Defs = SafeRequire(ReplicatedStorage.Modules.Quests, "Quests")

-- Deliberately static -- "is a quest giver at all", never "has a quest right
-- now". A list that changes with quest availability would silently drop the
-- user's saved ticks every time a quest was handed in, because RayVoid draws
-- no row for a saved option that is missing from the current option list
-- (the Alien Garage bug). Who actually gets VISITED is still
-- decided per tour by the exclamation mark, which is the live half.
--
-- Measured: this drops the Museum Attendant (a shop NPC that
-- carries an NPCQuestPrompt but has no Quests entry, and whose prompt is
-- disabled) and nothing else, 18 -> 17. TollboothGuard stays because it
-- genuinely is one: "Caffeine Roadblock", gated on 2.5M net worth.
function QUEST.IsQuestGiver(name)
	if not QUEST.Defs then
		-- Without the module there is no filter to apply. Say so rather than
		-- quietly showing an empty dropdown.
		if not QUEST.warnedNoDefs then
			QUEST.warnedNoDefs = true
			warn("[AutoQuest] Modules.Quests is unavailable, so every NPC carrying a quest prompt is listed "
				.. "(the Museum Attendant and other non-quest NPCs included).")
		end
		return true
	end
	local def = QUEST.Defs[name]
	return type(def) == "table" and type(def.Levels) == "table" and next(def.Levels) ~= nil
end

-- "Ted - Farmyard": the name is what the user recognises, the area is what
-- they pick by. Three sources, best first.
function QUEST.AreaFor(name, entry)
	local cached = QUEST.areas[name]
	if cached ~= nil then
		return cached or nil
	end

	local area
	-- 1. The module's own Area field, which 15 of the 17 carry.
	local def = QUEST.Defs and QUEST.Defs[name]
	if type(def) == "table" and type(def.Area) == "string" and def.Area ~= "" then
		area = def.Area
	end

	-- 2. Otherwise the Areas folder the model sits in. Parent paths only
	--    answer this for some NPCs -- the Mall ones live under
	--    "Mall - Shop NPCs.Quest NPC" with no area anywhere in the path.
	if not area and entry and entry.model then
		local areasFolder = workspace:FindFirstChild("Areas")
		local node = entry.model
		while areasFolder and node and node ~= workspace do
			if node.Parent == areasFolder then
				area = node.Name
				break
			end
			node = node.Parent
		end
	end

	-- 3. Last, the nearest area POI -- the game's own GPS list, the same data
	--    the area teleports use. Capped at 300 studs: a label naming an area
	--    the NPC is nowhere near would be worse than no label at all, so
	--    those (Terry, TollboothGuard) simply show their bare name.
	if not area and entry and entry.root then
		local okPOI = pcall(function()
			AREAPOS.LoadPOIs()
		end)
		if okPOI and AREAPOS.poiCache then
			local best, bestDistance = nil, 300
			local here = entry.root.Position
			for areaName, position in pairs(AREAPOS.poiCache) do
				local distance = (position - here).Magnitude
				if distance < bestDistance then
					best, bestDistance = areaName, distance
				end
			end
			area = best
		end
	end

	QUEST.areas[name] = area or false
	return area
end

function QUEST.BuildOptions()
	local npcs = QUEST.ScanNPCs()
	local list = {}
	table.clear(QUEST.labels)
	QUEST.skipped = 0
	for name, entry in pairs(npcs) do
		if QUEST.IsQuestGiver(name) then
			local area = QUEST.AreaFor(name, entry)
			local label = area and (name .. " - " .. area) or name
			QUEST.labels[label] = name
			table.insert(list, label)
		else
			QUEST.skipped = QUEST.skipped + 1
		end
	end
	-- Sorted by label, so by NPC name: the name is what is looked for.
	table.sort(list)
	QUEST.options = list
	return list
end

-- The dropdown hands back display labels. Straight lookup first; the split is
-- for a label saved by an older build (a bare "Ted") or one whose area suffix
-- has since changed, so a tick survives instead of quietly doing nothing.
function QUEST.NameFromLabel(label)
	local name = QUEST.labels[label]
	if name then
		return name
	end
	return string.match(label, "^(.-) %- ") or label
end

function QUEST.RefreshOptions()
	local list = QUEST.BuildOptions()
	if QUEST.dropdown and QUEST.dropdown.Refresh then
		pcall(function()
			QUEST.dropdown:Refresh(list)
		end)
	end
	return list
end

-- Talk to one NPC: teleport, fire its prompt, answer the dialog.
-- Returns true when the NPC was actually reached and spoken to.
function QUEST.Talk(name, entry)
	local pos
	local okPos = pcall(function()
		pos = entry.root.Position
	end)
	if not okPos or not pos then
		DebugPrint("[AutoQuest] " .. name .. " has no position any more, skipping")
		return false
	end

	-- The HumanoidRootPart, not the Vector3: TeleportPlayerOnly resolves an
	-- INSTANCE. Handing it a position threw on every single tour until
	-- ("IsA is not a valid member of Vector3"), which is why Auto
	-- Quest had never once completed a visit.
	--
	-- In reach against the prompt's own radius, AND staying there: see
	-- TPCACHE.ArriveNear for the pull-back that made the Mayor refuse every
	-- prompt.
	local reach = 10
	pcall(function()
		reach = entry.prompt.MaxActivationDistance
	end)
	if not TPCACHE.ArriveNear(entry.root, reach * 0.85) then
		warn("[AutoQuest] Could not stay within reach of " .. name .. " (pulled away "
			.. TPCACHE.ARRIVE_TRIES .. " times), skipping")
		return false
	end

	-- A visit is up to TWO talks. The first resolves whatever the exclamation
	-- mark was for. If that turned out to be a reward CLAIM, the NPC offers
	-- its next level straight afterwards -- so a second trigger takes it now
	-- instead of leaving it to wait out NPC_COOLDOWN (5 minutes) while it was
	-- on offer the whole time. Levels carrying a ClaimDialog are the ones this
	-- matters for; a level without one auto-rewards and hands back the next
	-- offer on the FIRST trigger, which is why Ted went reward -> "Cattle
	-- Drive" in a single talk.
	--
	-- Two is a hard ceiling rather than "keep going until it stops": a chain
	-- that never ended would pin the farm here, and one claim plus one offer
	-- is the whole of what the game hands back.
	local didSomething = false
	for round = 1, 2 do
		local seqBefore = QUESTDIALOG.seq
		QUESTDIALOG.quest = nil

		-- Triggering the prompt is what grants a finished quest's reward -- the
		-- capture showed the reward already landed before any answer was given.
		-- So for a claim this single call is the whole job.
		--
		-- **But the client being in range is not the server being convinced.**
		-- Measured: after the tour's teleport the server refuses this
		-- for the best part of a second, and it says so in the RETURN VALUE --
		-- `false` for refused, `true` for accepted, with the dialog following
		-- ~50ms later. The first build threw that boolean away and read "no
		-- dialog" as "must have been a reward claim", so every single tour
		-- reported success while achieving precisely nothing.
		--
		-- So: fire and re-fire until the server says yes, the same shape the
		-- garage entry had to learn. `nil` is treated as "no answer either way"
		-- and falls through to the dialog wait rather than being read as refusal.
		--
		-- Round 2 gets a short budget on purpose: we are already standing there
		-- and the server has already accepted us once, so there is no arrival to
		-- wait out -- and "nothing more here" is the common answer, which must
		-- not cost 2.4s on every claim.
		local tries = (round == 1) and QUEST.TRIGGER_TRIES or 2
		local accepted = false
		for attempt = 1, tries do
			-- Pulled away between tries: a prompt fired from out of reach can
			-- only be refused, so go back before spending the attempt.
			local hrpNow = GetFreshHRP()
			if hrpNow and (hrpNow.Position - pos).Magnitude > reach then
				DebugPrint("[AutoQuest] Pulled away from " .. name .. " between tries, going back")
				TPCACHE.ArriveNear(entry.root, reach * 0.85)
			end
			local okTrigger, ret = pcall(function()
				return Events.UI.QuestPromptTriggered:InvokeServer(entry.model)
			end)
			if not okTrigger then
				warn("[AutoQuest] QuestPromptTriggered failed for " .. name .. ": " .. tostring(ret))
				return didSomething
			end
			if ret ~= false then
				accepted = true
				DebugPrint("[AutoQuest] " .. name .. ": prompt accepted on attempt " .. attempt)
				break
			end
			task.wait(QUEST.TRIGGER_RETRY)
		end

		if not accepted then
			-- On the follow-up talk this is the ordinary "nothing more here"
			-- answer rather than a failure: we already got what we came for.
			if didSomething then
				break
			end
			-- Proof of failure, and it is worth as much as proof of success: the
			-- visit did nothing, so it must not be reported as if it had.
			warn("[AutoQuest] " .. name .. " kept refusing the prompt ("
				.. tries .. " tries) -- the server never accepted us as being there. Nothing was accepted or claimed.")
			return false
		end

		-- Wait for the server to say what it is offering. A reward claim answers
		-- too ("<NPCName>'s Reward"), so silence here is NOT the normal claim
		-- path -- it is an accepted prompt that produced nothing, and it says so.
		local dialogDeadline = os.clock() + ((round == 1) and 2 or 1)
		while os.clock() < dialogDeadline and QUESTDIALOG.seq == seqBefore do
			task.wait(0.05)
		end

		local questName = QUESTDIALOG.quest
		if not questName then
			if didSomething then
				break
			end
			warn("[AutoQuest] " .. name .. ": the server took the prompt but sent no dialog, so nothing was accepted or claimed.")
			return false
		end

		-- "<NPCName>'s Reward" is the finished-quest dialog. The reward is
		-- already ours by now, so there is nothing to accept -- but the next
		-- level is on offer, which is what round 2 is for.
		--
		-- print, not DebugPrint: a tour that works is silent otherwise, and on
		-- That cost a round trip -- the reward landed, the next
		-- quest was taken, and with nothing in the console it read as the
		-- feature stopping half way.
		if string.find(questName, "'s Reward", 1, true) then
			print("[AutoQuest] " .. name .. ": claimed the reward for \"" .. questName .. "\"")
			didSomething = true
		else
			local okAnswer, answerErr = pcall(function()
				Events.UI.SendQuestDialogResult:FireServer(entry.model, questName, "accept")
			end)
			if not okAnswer then
				warn("[AutoQuest] SendQuestDialogResult failed for " .. name .. ": " .. tostring(answerErr))
				return didSomething
			end
			print("[AutoQuest] " .. name .. ": accepted \"" .. questName .. "\"")
			return true
		end
	end

	return didSomething
end

-- Called from the Master Cycle's SEARCHING branch. Returns immediately and
-- costs one boolean test when the feature is off.
function QUEST.RunTourIfDue()
	if not QUEST.active then
		return
	end
	if (os.clock() - QUEST.lastTourAt) < QUEST.TOUR_EVERY then
		return
	end

	-- Never mid-lot. AUCTION.BusyReason() is the single definition of that,
	-- shared with the vehicle failsafe.
	local busy = AUCTION.BusyReason()
	if busy then
		return
	end

	local pending = QUEST.PendingNames()
	local npcs = QUEST.ScanNPCs()

	local todo = {}
	for name in pairs(pending) do
		if QUEST.selected[name] and npcs[name] and os.clock() > (QUEST.cooldown[name] or 0) then
			table.insert(todo, name)
		end
	end

	-- Nothing to do is the common case: charge the timer so we do not rescan
	-- the workspace every single master tick.
	QUEST.lastTourAt = os.clock()
	if #todo == 0 then
		return
	end

	table.sort(todo)
	DebugPrint("[AutoQuest] Touring " .. #todo .. " NPC(s): " .. table.concat(todo, ", "))

	for _, name in ipairs(todo) do
		-- Re-check every iteration: the farm can be switched off, or an
		-- auction can start, in the middle of a tour.
		if not (QUEST.active and FARM.active) or AUCTION.BusyReason() then
			break
		end
		-- The second return of pcall is Talk's own answer, not an error, when
		-- the call did not throw. It is counted only when it says the visit
		-- actually did something -- "we went there" is not "it worked".
		local okTalk, talked = pcall(function()
			return QUEST.Talk(name, npcs[name])
		end)
		if not okTalk then
			warn("[AutoQuest] Talking to " .. name .. " failed: " .. tostring(talked))
		elseif talked then
			QUEST.handled = QUEST.handled + 1
			-- A tour is progress, so the master cycle's 90s stall watchdog
			-- must not read it as a farm standing still.
			FARM.Moved()
		end
		-- Cooled down whether it worked or not. An NPC the server keeps
		-- refusing must not become a round trip on every tour -- this is the
		-- "what clears the timer, and what if nothing does" rule.
		QUEST.cooldown[name] = os.clock() + QUEST.NPC_COOLDOWN
		task.wait(0.3)
	end

	-- The tour moved the player away from the truck. Nothing special to do:
	-- the next garage entry runs its own catch-up, which is exactly the path
	-- that already handles a truck left behind.
	QUEST.lastTourAt = os.clock()
end

-- MASTER CYCLE -- SOLE owner of the HRP while FARM.active.
-- SEARCHING -> BIDDING (passive) -> COLLECTING -> Unload -> Place.
-- No other loop moves the HRP: standalone AutoCollect stops on
-- `not FARM.active`, PlaceItems never navigates (the plot TP is done
-- HERE), Wash/Grade are passive.

-- Lock that PREVENTS RunPlacingPhase from being called (never triggers
-- anything itself). True = farm/collection continue, but no base TP and
-- no inventory unload.

-- Number of containers to collect before forcing an unload (placement).
-- 1 = unload after EVERY container (default, ultra-safe). Up to 7.
-- Set via the "Place every N containers" dropdown on the Auto Farm tab.

-- Counter of containers actually collected since the last placement.
-- Only incremented on a won+emptied container, not on a Min Bid skip.

local function RunCollectingPhase()
	while AUCTION.state == "COLLECTING" and FARM.active do
		-- Heartbeat for FARM.CheckStall: this loop legitimately runs for a while.
		FARM.tickAt = os.clock()
		-- NOT gated on COLLECT.active, deliberately (worklist D1, found
		-- 2026-09-10). Auto Farm forces that flag on when it starts, but
		-- nothing stopped it being unticked afterwards -- and then the won lot
		-- was never picked up, owned carryables held the FSM in COLLECTING,
		-- every following garage's bid UI was discarded by the FSM ("Bidding
		-- UI opened while COLLECTING, ignored"), the Min Bid check that lives
		-- inside that path never ran, and the farm won each cheap lot by
		-- default -- paying an entry fee a time and dropping more loot.
		-- Collecting what the farm wins is the Master Cycle's job and is not
		-- optional while it runs.
		CollectOnce(function()
			return AUCTION.state == "COLLECTING" and FARM.active
		end)

		-- UNCONDITIONAL YIELD: a pass that collects nothing and yields
		-- nowhere loops thousands of times per second -> starved client ->
		-- crash with no Lua error.
		-- NEVER make this wait conditional. Its LENGTH is fair game though:
		-- 0.2s rather than 0.5s, matching the sibling debounce loop, since all
		-- this decides is how soon the phase notices the ground is clear.
		task.wait(0.2)
	end
end

local function RunUnloadingPhase()
	DebugPrint("[MasterCycle] UNLOADING phase (truck unload)")
	UnloadCargo()
end

-- Places until only non-placeable items remain. Base full: we wait for
-- auto-accept sales, or we block with an alert if auto-accept is off
-- (otherwise we would wait forever).
local function RunPlacingPhase()
	DebugPrint("[MasterCycle] Phase PLACING")

	-- The ONLY place in the script that TPs to the plot. Truck left behind.
	-- We target a Furniture model, not the plot: its pivot can be too far
	-- for streaming to have loaded the shelves.
	local plot = GetPlayerPlot()
	if not plot then
		warn("[MasterCycle] Plot not found, placement phase cancelled")
		return
	end

	local anchor = GetPlotFurnitureAnchor(plot)
	if not anchor then
		warn("[MasterCycle] No Furniture anchor found, placement phase cancelled")
		return
	end

	TeleportPlayerOnly(anchor)

	-- Adaptive streaming wait: instead of a fixed task.wait(0.6) (often
	-- too short for a big base or an arrival from a distant area -> empty
	-- podiums not yet loaded made the base read as full), we loop until
	-- the number of loaded slots reaches what the game config announces,
	-- capped at 4s.
	do
		local streamDeadline = os.clock() + 4
		while os.clock() < streamDeadline and FARM.active do
			local _, allNow, expectedNow = GetAvailableShelfSlots(plot)
			if #allNow > 0 and (expectedNow == 0 or #allNow >= expectedNow) then
				break
			end
			task.wait(0.25)
		end
	end

	local baseFullSince = nil -- os.clock() of the moment the base became full
	local notReadyDeadline = nil -- os.clock() of the 1st "plot not ready" attempt

	while FARM.active do
		-- Heartbeat for FARM.CheckStall: a full base can wait here for minutes.
		FARM.tickAt = os.clock()
		local placed, remaining, refused = PlaceItems()

		if placed > 0 then
			-- Progress: we reset both waiting states.
			notReadyDeadline = nil
			baseFullSince = nil
			HideInventoryFullMessage()
			HideCriticalMessage()
			DebugPrint(string.format("[MasterCycle] %d item(s) placed, %d remaining", placed, remaining))
			task.wait(0.3)

		elseif remaining == nil then
			-- Plot not found, inventory unreachable, OR shelf slots not yet
			-- loaded (streaming unfinished -- common when arriving from a
			-- distant area). NOT "nothing to place": we retry, with a cap so
			-- we do not stay stuck for good if the plot is really broken
			-- rather than merely slow.
			if not notReadyDeadline then
				notReadyDeadline = os.clock() + 15
			end
			if os.clock() > notReadyDeadline then
				warn("[MasterCycle] Plot/shelf slots still not ready after 15s, giving up on this placement pass")
				break
			end
			DebugPrint("[MasterCycle] Plot/shelf slots not ready yet, retrying...")
			task.wait(1)

		elseif remaining == 0 then
			-- Nothing left to place NOW: either the inventory holds only
			-- non-placeable items (unload complete), or the server rejected
			-- the last candidates (`refused`) even though free slots were
			-- available -- either way we go back to farming rather than
			-- blocking on "BASE FULL". Rejected items stay in the inventory
			-- and will be retried on the next cycle.
			HideInventoryFullMessage()
			HideCriticalMessage()
			if refused and refused > 0 then
				DebugPrint(string.format("[MasterCycle] %d item(s) refused by the server despite free slots -- back to Farm, will retry", refused))
			else
				DebugPrint("[MasterCycle] Inventory emptied, back to Farm")
			end
			break

		else
			-- placed == 0 AND remaining > 0: BASE FULL. We have items to
			-- place but no free slot. We wait for the auto-accept trade to
			-- sell placed items and free up shelves.
			notReadyDeadline = nil
			if not baseFullSince then
				baseFullSince = os.clock()
			end

			if not OFFERS.autoAccept then
				-- Without auto-accept, nothing will ever free the base: we
				-- block with a fullscreen alert. We do NOT go back to
				-- farming (farming with a full inventory is pointless).
				HideInventoryFullMessage()
				ShowCriticalMessage("BASE FULL - Enable 'Auto-Accept Offers' to sell and free up space. Farm paused.")
				warn("[MasterCycle] Base full AND Auto-Accept Offers disabled -> farm blocked (enable auto-accept)")
			else
				HideCriticalMessage()
				ShowInventoryFullMessage("Base full - waiting for sales to free space (auto-accept)...")
			end

			task.wait(3) -- we retry regularly, infinite retry (intended)
		end
	end

	-- Counter reset: we just unloaded, we start from zero.
	FARM.sinceLastPlace = 0
end

local function MasterCycleLoop()
	if LOOPGUARDS.masterCycle then
		-- Normal for a double click. A dead end if the loop died without
		-- clearing the guard -- and the two are indistinguishable in silence,
		-- which is exactly how a farm that will never start again presents.
		warn("[AutoFarm] the master cycle is already marked running, not starting a second one")
		return
	end
	LOOPGUARDS.masterCycle = true
	warn("[AutoFarm] master cycle started")

	-- Adopt loot left over from a previous run. A re-execute (hot reload, or
	-- a rejoin) restarts the FSM at SEARCHING with no memory of the auction it
	-- won, but the lot it won is still on the ground -- and that deadlocks:
	-- TryEnterNextAuction refuses to enter a new garage while items of ours
	-- are down, and the only state that picks them up is COLLECTING, reached
	-- solely by the "Sold to" dialogue, which fired before this run existed.
	-- Neither side moves and nothing says so. Start in COLLECTING instead;
	-- the debounce loop drops back to SEARCHING once the ground is clear.
	if AUCTION.state == "SEARCHING" and CountOwnedCarryablePrompts() > 0 then
		warn("[AutoFarm] loot from an earlier run is still on the ground -- collecting it before searching")
		SetAuctionState("COLLECTING")
	end

	task.spawn(function()
		-- A state that never moves is the other way this stalls in silence:
		-- TryEnterNextAuction is only reached while SEARCHING, so anything
		-- stuck elsewhere prints nothing at all. It needs BOTH halves though:
		-- timing the state alone cried wolf constantly, because SEARCHING is
		-- the catch-all state and sits happily over 90s while the farm hops
		-- garages or drives home to place. FARM.progressAt is the other half.
		local stateSeen, stateSince = nil, os.clock()
		FARM.tickAt = os.clock()
		FARM.step = "starting"
		while FARM.active do
			FARM.tickAt = os.clock()
			if AUCTION.state ~= stateSeen then
				stateSeen = AUCTION.state
				stateSince = os.clock()
			elseif AUCTION.winRunning then
				-- Auto-Win holds BIDDING on purpose while it waits the auction
				-- out from outside the zone. That is the plan, not a stall.
				stateSince = os.clock()
			else
				local quietSince = stateSince
				if (FARM.progressAt or 0) > quietSince then
					quietSince = FARM.progressAt
				end
				if (os.clock() - quietSince) > 90 then
					stateSince = os.clock()
					FARM.progressAt = os.clock()
					FARM.Idle("nothing has moved for 90s -- no garage taken, no bid, no collection (auction state: " .. tostring(stateSeen) .. ")")
				end
			end
			-- pcall around EACH iteration: without it, an uncaught error
			-- anywhere in this branch (TryEnterNextAuction,
			-- RunPlacingPhase/PlaceItems included) crashes the coroutine
			-- BEFORE reaching "LOOPGUARDS.masterCycle = false" on exiting
			-- the while -- the guard stays stuck at true forever, so even
			-- unchecking/rechecking Auto Farm restarts nothing
			-- (StartLoop-style: "if LOOPGUARDS.masterCycle then return end").
			-- This is the most likely scenario behind "AutoPlace stops by
			-- itself, no visible error" -- the error does exist, but nothing
			-- displays it if the F9 console is not open. We log and continue
			-- rather than letting the whole master cycle die.
			local iterOk, iterErr = pcall(function()
			if AUCTION.winRunning then
				-- The Auto-Win sequence owns the HRP for the time it takes to
				-- leave the zone and wait for the win. The master must neither
				-- teleport nor change garage: it waits.
				--
				-- 0.15s, not 0.5s: this is purely how quickly the master
				-- NOTICES the sequence has finished, and at 0.5s it was adding
				-- up to half a second of its own after every single win.
				task.wait(0.15)
			elseif AUCTION.state == "SEARCHING" then
				-- FARM.step is only ever read by FARM.CheckStall, to say WHERE a
				-- step that never returned is stuck.
				FARM.step = "recalling the truck"
				-- The Master Cycle owns the HRP, so the vehicle failsafe (which
				-- seats the player) runs here rather than on its own timer loop.
				VEHICLESPAWN.RunAutoIfDue()
				FARM.step = "touring the quest NPCs"
				-- Same reason, same place: the quest tour moves the player, so it
				-- cannot be a rival loop. Returns on a boolean when Auto Quest is
				-- off, which is the default -- a farm with the toggle off runs
				-- exactly the sequence it ran before this existed.
				QUEST.RunTourIfDue()
				FARM.step = "visiting the Collector"
				-- Third of the same kind: the Collector stands at your base
				-- and is gone in about six minutes, so this teleports too and
				-- therefore belongs here rather than on a loop of its own.
				COLLECTORAUTO.RunIfDue()
				FARM.step = "looking for a garage to enter"
				TryEnterNextAuction()
				FARM.step = "waiting between garage searches"
				FARM.PacedWait(2)
			elseif AUCTION.state == "COLLECTING" then
				FARM.step = "collecting the lot"
				RunCollectingPhase()

				-- Safeguard: RunCollectingPhase stops as soon as the state
				-- leaves COLLECTING, but nothing guarantees _Carryables is
				-- really empty at that moment (transition slightly early
				-- depending on latency/item count). We recheck and retry as
				-- long as items of ours remain, capped in time so the whole
				-- Auto Farm is not blocked on a permanently uncollectable
				-- item.
				local recheckDeadline = os.clock() + 30
				while FARM.active and CountOwnedCarryablePrompts() > 0 and os.clock() < recheckDeadline do
					-- Same reason as RunCollectingPhase: not gated on
					-- COLLECT.active.
					CollectOnce(function()
						return FARM.active
					end)
					task.wait(0.5)
				end
				if FARM.active and CountOwnedCarryablePrompts() > 0 then
					warn("[MasterCycle] Items still left in _Carryables after 30s, moving on anyway")
				end

				if FARM.active then
					-- Container actually collected: we increment the counter.
					FARM.sinceLastPlace = FARM.sinceLastPlace + 1

					-- We ALWAYS unload the truck into the inventory after the
					-- container (otherwise items stay in the truck).
					FARM.step = "unloading the truck"
					RunUnloadingPhase()

					-- Placement (and base TP) only if AutoPlace is active AND the
					-- container threshold is reached. Safeguard: inventory >90%
					-- forces placement so we do not collect into a full inventory.
					local placementRan = false
					if not FARM.placeDisabled then
						local reachedThreshold = FARM.sinceLastPlace >= FARM.placeEveryN
						local invForced = IsInventoryNearFull(0.90)

						if reachedThreshold or invForced then
							if invForced and not reachedThreshold then
								DebugPrint("[MasterCycle] Inventory ~full (>90%) before threshold, forcing placement")
							end
							FARM.step = "placing items at the base"
							RunPlacingPhase()

							-- Short cooldown after placement: without it,
							-- TryEnterNextAuction restarts on the next
							-- iteration although we have only just arrived
							-- at the base. If the farm area is far (so
							-- unloaded by streaming from the base), eligible
							-- comes back empty and the
							-- STREAMING_ANCHOR_PATHS fallback teleports
							-- immediately to the area anchor -- the player
							-- gets sent straight back, as if the placement
							-- had never happened. Leaves time to really get
							-- going again properly.
							FARM.cooldownUntil = os.clock() + 3
							placementRan = true
						else
							DebugPrint(string.format("[MasterCycle] %d/%d containers before unload", FARM.sinceLastPlace, FARM.placeEveryN))
						end
					else
						DebugPrint("[MasterCycle] AutoPlace disabled, skipping placement (inventory not emptied)")
					end

					-- The whole pass above blocks this coroutine, so the watchdog
					-- below only gets to look once it is over -- and would read the
					-- minutes a full placement run takes as a state that never moved.
					FARM.Moved()

					-- The garage is finished: collected, truck emptied, and placed
					-- if it was due. Everything the 15s entry cooldown was armed
					-- for at commit time has now actually happened, so whatever is
					-- left of it is dead time -- the same dead time the Min Bid
					-- skip and the lost auction already had taken off them. The
					-- WIN path never got it, which is how winning ended up being
					-- the slowest way to reach the next garage.
					--
					-- Placement is the exception: it arms its own 3s deliberately
					-- (see above) and that one stands. The hurry window still
					-- opens either way, so the retry cadence is 0.4s instead of 2s
					-- the moment the gate is clear.
					if not placementRan then
						FARM.cooldownUntil = 0
					end
					FARM.Hurry()
				end
			else
				-- BIDDING: we do nothing, we let REMOTES.UpdateBidEvent handle it.
				FARM.PacedWait(0.5)
			end
			end)
			if not iterOk then
				warn("[MasterCycle] Iteration failed, continuing: " .. tostring(iterErr))
				-- Guaranteed yield even if the error recurs immediately
				-- (e.g. state broken in a loop): without it, an error that
				-- resurfaces without ever passing through an inner task.wait()
				-- would loop empty -> starved client.
				task.wait(0.5)
			end
		end
		LOOPGUARDS.masterCycle = false
		warn("[AutoFarm] master cycle stopped")
		-- The master has stopped (Auto Farm turned off): we clean up the
		-- overlays that might have stayed displayed (e.g. base full alert).
		HideInventoryFullMessage()
		HideCriticalMessage()
	end)
end

