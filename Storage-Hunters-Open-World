-- =========================================================
-- AUTO RECONNECT (Misc tab) -- get back in after a disconnect or kick.
--
-- Two independent detectors, because missing the disconnect means the
-- whole feature silently does nothing:
--   * GuiService.ErrorMessageChanged  -- Roblox's own connection-error signal
--   * CoreGui.RobloxPromptGui.promptOverlay "ErrorPrompt" -- the grey
--     "Disconnected" box, caught both when it is added and by a 3s poll
--     (a reused prompt is made visible again rather than re-created, and
--     ChildAdded would never fire for that one).
-- Both funnel into RECONNECT.Go, which is idempotent: the first one to
-- notice starts the retry loop, the second is a no-op.
--
-- ONE call: TeleportService:Teleport(placeId, player). It is the only one
-- that actually moves the player on Real (confirmed in game 2026-09-07),
-- and it lands the user back in their private server.
--
-- Do NOT replace it with TeleportToPlaceInstance. That looked like the
-- right answer -- it is the only call that names a specific server -- but
-- on Real it returns cleanly, fires no TeleportInitFailed, and does
-- nothing whatsoever: one log line and then silence, with the player still
-- sitting on the dead server. It was shipped and it broke reconnecting.
--
-- The retry is OPEN-ENDED on purpose: home internet can be gone for
-- minutes. Delays step 5 / 10 / 20 / 30 / 45 / 60s and then stay at 60s
-- forever. Every attempt is warned, and TeleportInitFailed is listened to so
-- a refusal from Roblox is printed rather than swallowed.
--
-- There is no private server link, and there will not be one. Every
-- route was tried in game on 2026-09-07 and all of them failed; the table is
-- in docs/game-reference.md so this is not re-investigated. Short version:
-- TeleportToPrivateServer is server-only, nothing else resolves a link code,
-- and Real does not send the account cookie so the web API is out too. The
-- JobId above is the only handle on a specific server we get.
--
-- Coming back with the script running is already handled: the AutoLoad block
-- armed queue_on_teleport at startup and TeleportService counts as a
-- teleport. It is deliberately NOT re-armed here -- Real's queue appends.
--
-- ARRIVAL IS DANGEROUS. CoreGui survives a teleport, so the disconnect
-- prompt that triggered the rejoin is STILL THERE on the new server. The
-- first version polled for it and immediately fired another teleport on
-- arrival, which left the client behind Roblox's teleport screen with the
-- whole UI visible but dead to clicks. Hence: the leftover prompt is cleared
-- at startup, signals are ignored for GRACE seconds after load, and a
-- teleport that Roblox has accepted blocks any further attempt.
-- =========================================================
local RECONNECT = {
	-- On by default: a disconnect with this off ends the farm silently,
	-- which is the exact thing the feature exists to prevent.
	enabled = true,
	-- The server we are in right now, and the only one a reconnect will
	-- accept. In a private server, this IS the private server.
	jobId = game.JobId,
	inPrivateServer = (game.PrivateServerId or "") ~= "",
	rejoining = false,
	teleporting = false,
	teleportingSince = 0,
	startedAt = os.clock(),
	-- Seconds after load during which a disconnect signal is ignored. Arrival
	-- carries the previous server's leftovers; reacting to them teleports the
	-- player straight back out.
	GRACE = 10,
	file = "SH-reconnect.json",
	paragraph = nil,
	-- Every rejoin this script starts is written down (a file: each rejoin is
	-- a fresh run). More than MAX_IN_A_ROW of them inside ROW_WINDOW seconds
	-- is a loop -- something kicks the player on every arrival -- and it stops
	-- instead of going round all night ("it keeps having them rejoin").
	historyFile = "SH-reconnect-history.txt",
	MAX_IN_A_ROW = 3,
	ROW_WINDOW = 900,
	stopped = nil, -- why it stopped, shown in the status
	skipUntil = 0,
}

-- Is this client actually still connected? While it is, NetworkClient holds
-- its replicator; a kick or a drop removes it. Only trusted when it was seen
-- at startup -- not every executor can look there. nil = cannot tell.
-- (A function, not a do-block: main-chunk locals are capped at 200.)
function RECONNECT.FindNet()
	local ok, net = pcall(function()
		return game:GetService("NetworkClient")
	end)
	local okKids, kids = pcall(function()
		return #net:GetChildren()
	end)
	if ok and okKids and kids > 0 then
		RECONNECT.net = net
	end
end
RECONNECT.FindNet()

function RECONNECT.Connected()
	if not RECONNECT.net then
		return nil
	end
	local ok, kids = pcall(function()
		return #RECONNECT.net:GetChildren()
	end)
	if not ok then
		return nil
	end
	return kids > 0
end

-- What Roblox says happened: its error message plus the text on the prompt.
function RECONNECT.ErrorText(prompt)
	local parts = {}
	pcall(function()
		local msg = game:GetService("GuiService"):GetErrorMessage()
		if type(msg) == "string" and msg ~= "" then
			table.insert(parts, msg)
		end
	end)
	if prompt then
		pcall(function()
			for _, d in ipairs(prompt:GetDescendants()) do
				if d:IsA("TextLabel") and d.Text ~= "" and #parts < 6 then
					table.insert(parts, d.Text)
				end
			end
		end)
	end
	return table.concat(parts, " | ")
end

function RECONNECT.ErrorCode()
	local ok, code = pcall(function()
		return game:GetService("GuiService"):GetErrorCode()
	end)
	return (ok and typeof(code) == "EnumItem") and code.Name or ""
end

-- Rejoins this script started, oldest first: { at = os.time(), why = text }.
function RECONNECT.History()
	local list = {}
	if type(isfile) ~= "function" or type(readfile) ~= "function" then
		return list
	end
	local ok, raw = pcall(function()
		return isfile(RECONNECT.historyFile) and readfile(RECONNECT.historyFile) or ""
	end)
	if not ok or type(raw) ~= "string" then
		return list
	end
	for line in string.gmatch(raw, "[^\n]+") do
		local at, why = string.match(line, "^(%d+) ?(.*)$")
		if at then
			table.insert(list, { at = tonumber(at), why = why })
		end
	end
	return list
end

function RECONNECT.Remember(reason)
	if type(writefile) ~= "function" then
		return
	end
	local list = RECONNECT.History()
	table.insert(list, { at = os.time(), why = (string.gsub(tostring(reason), "[\r\n]+", " ")) })
	local lines = {}
	for i = math.max(1, #list - 9), #list do
		table.insert(lines, list[i].at .. " " .. list[i].why)
	end
	pcall(function()
		writefile(RECONNECT.historyFile, table.concat(lines, "\n"))
	end)
end

-- Is this "disconnected" signal worth a rejoin? Every "no" is said out loud
-- (console + status), so a rejoin that does not happen is never a mystery.
function RECONNECT.ShouldRejoin(reason)
	-- 1. Still connected? Then it was some other Roblox message (a failed
	-- teleport shows the same grey box) and a rejoin would throw the player out
	-- of a working server. A real drop removes the replicator within seconds.
	local connected = RECONNECT.Connected()
	local waited = 0
	while connected and waited < 10 and SESSION.alive do
		task.wait(1)
		waited = waited + 1
		connected = RECONNECT.Connected()
	end
	local text = string.lower(tostring(reason) .. " " .. RECONNECT.ErrorCode())
	if connected == nil and (string.find(text, "teleport", 1, true) and not string.find(text, "disconnect", 1, true)) then
		connected = true -- cannot check; a teleport message alone is not a drop
	end
	if connected then
		local now = os.clock()
		if now - (RECONNECT.skipLast or 0) > 60 then
			RECONNECT.skipFirst = now
		end
		RECONNECT.skipLast = now
		-- A message that stays up for 10 minutes is trusted after all, in case
		-- the connection check is wrong on this executor.
		if now - RECONNECT.skipFirst < 600 then
			if RECONNECT.skipText ~= reason then
				RECONNECT.skipText = reason
				warn("[Reconnect] Not rejoining, you are still connected. Roblox said: " .. tostring(reason))
			end
			RECONNECT.skipUntil = now + 30
			return false
		end
		warn("[Reconnect] the disconnect message has been up for 10 minutes -- rejoining anyway")
	end

	-- 2. Kicked because this account joined from somewhere else (phone, second
	-- PC). Rejoining would kick THAT one, and they would kick each other forever.
	if string.find(text, "different device", 1, true) or string.find(text, "another device", 1, true)
		or string.find(text, "duplicate", 1, true) then
		RECONNECT.stopped = "this account was opened on another device, so it did not rejoin (that would kick the other one)."
		warn("[Reconnect] Not rejoining: " .. RECONNECT.stopped)
		RECONNECT.SetStatus(RECONNECT.Describe())
		return false
	end

	-- 3. Kicked again and again right after arriving: a loop, not bad luck.
	local recent = 0
	for _, entry in ipairs(RECONNECT.History()) do
		if os.time() - entry.at < RECONNECT.ROW_WINDOW then
			recent = recent + 1
		end
	end
	if recent >= RECONNECT.MAX_IN_A_ROW then
		RECONNECT.stopped = "you were sent back " .. recent .. " times in " .. math.floor(RECONNECT.ROW_WINDOW / 60)
			.. " minutes, so something keeps kicking you. Last reason: " .. tostring(reason)
		warn("[Reconnect] Stopped: " .. RECONNECT.stopped)
		RECONNECT.SetStatus(RECONNECT.Describe())
		SESSION.cfg.Notify("Auto Reconnect stopped", "Kicked " .. recent .. " times in a row -- see Misc > Auto Reconnect.")
		return false
	end

	local code = RECONNECT.ErrorCode()
	RECONNECT.Remember(tostring(reason) .. ((code ~= "" and code ~= "OK") and (" [" .. code .. "]") or ""))
	return true
end

function RECONNECT.SetStatus(text)
	if RECONNECT.paragraph then
		pcall(function()
			RECONNECT.paragraph:Set({ Title = "Status", Content = text })
		end)
	end
end

function RECONNECT.Save()
	if type(writefile) ~= "function" then
		warn("[Reconnect] this executor has no writefile -- the Auto Reconnect setting will not be remembered")
		return
	end
	local ok, err = pcall(function()
		writefile(RECONNECT.file, HttpService:JSONEncode({ enabled = RECONNECT.enabled }))
	end)
	if not ok then
		warn("[Reconnect] could not save " .. RECONNECT.file .. ": " .. tostring(err))
	end
end

function RECONNECT.Load()
	if type(isfile) ~= "function" or type(readfile) ~= "function" then
		return
	end
	local ok, saved = pcall(function()
		if not isfile(RECONNECT.file) then
			return nil
		end
		return HttpService:JSONDecode(readfile(RECONNECT.file))
	end)
	if not ok then
		warn("[Reconnect] could not read " .. RECONNECT.file .. ": " .. tostring(saved))
		return
	end
	if type(saved) == "table" and type(saved.enabled) == "boolean" then
		RECONNECT.enabled = saved.enabled
	end
end

function RECONNECT.Describe()
	local head = ""
	if SESSION.landedPublic then
		head = "!! THIS IS A PUBLIC SERVER. You were in a private server minutes ago and the rejoin did "
			.. "not put you back -- it was most likely shut down while you were out. Auto Farm is "
			.. "blocked. Rejoin your private server yourself, or switch Auto Farm on a second "
			.. "time to farm here anyway.\n\n"
	end
	if not RECONNECT.enabled then
		return head .. "Off. A disconnect will end the session."
	end
	-- What sent you back last time, so "why do I keep rejoining" has an answer.
	local tail = ""
	local history = RECONNECT.History()
	local last = history[#history]
	if last and os.time() - last.at < 3600 then
		tail = "\n\nLast rejoin: " .. os.date("%H:%M", last.at) .. " -- " .. last.why
		if string.find(string.lower(last.why), "idle", 1, true) then
			tail = tail .. "\nThat was Roblox's 20-minute idle kick: turn on Anti-AFK (Player & Safety tab)."
		end
	end
	if RECONNECT.stopped then
		return head .. "Stopped: " .. RECONNECT.stopped
			.. "\nPress Rejoin Now to go back yourself, or switch Auto Reconnect off and on to re-arm it." .. tail
	end
	return head .. "On. A disconnect reconnects you, and keeps trying until it works."
		.. "\nRetries after 5s, 10, 20, 30, 45, then once a minute for as long as it takes." .. tail
end

-- The retry loop. Called by both detectors and by the Rejoin Now button;
-- a second caller is a no-op while the first is still running.
-- `force` skips the arrival grace period -- only the button passes it.
function RECONNECT.Go(reason, force)
	if not RECONNECT.enabled or RECONNECT.rejoining or LOOPGUARDS.reconnect then
		return
	end
	if not force and (os.clock() - RECONNECT.startedAt) < RECONNECT.GRACE then
		-- We just arrived. Anything shouting "disconnected" this early is a
		-- leftover of the server we came FROM, and acting on it teleports the
		-- player straight back out.
		DebugPrint("[Reconnect] ignoring this signal, still inside the arrival grace period: " .. tostring(reason))
		return
	end
	if not force and (RECONNECT.stopped or os.clock() < RECONNECT.skipUntil) then
		return
	end
	RECONNECT.rejoining = true
	LOOPGUARDS.reconnect = true

	task.spawn(function()
		if not force then
			local okCheck, go = pcall(RECONNECT.ShouldRejoin, reason)
			if not okCheck then
				warn("[Reconnect] the rejoin check failed (" .. tostring(go) .. "), rejoining anyway")
			elseif not go then
				LOOPGUARDS.reconnect = false
				RECONNECT.rejoining = false
				return
			end
		end
		if string.find(string.lower(tostring(reason) .. " " .. RECONNECT.ErrorCode()), "idle", 1, true) then
			warn("[Reconnect] Roblox kicked you for being idle 20 minutes -- turn on Anti-AFK (Player & Safety tab) so it stops happening")
		end
		local delays = { 5, 10, 20, 30, 45, 60 }
		local attempt = 0
		local target = RECONNECT.inPrivateServer and "your private server" or "the same server"

		while RECONNECT.enabled and LOOPGUARDS.reconnect and SESSION.alive do
			if RECONNECT.teleporting then
				-- Roblox has accepted a teleport and is loading. Firing another
				-- one now stacks them, and the client ends up stuck behind the
				-- teleport screen with the UI drawn but dead to clicks.
				-- But a teleport that is accepted and then never completes must not
				-- park this loop forever in silence: that is indistinguishable from
				-- the feature being broken. Give it 20s, say so, and try again.
				if (os.clock() - RECONNECT.teleportingSince) > 20 then
					RECONNECT.teleporting = false
					warn("[Reconnect] Roblox took the teleport 20s ago and it never went through -- trying again")
				end
				task.wait(1)
			else
				attempt = attempt + 1
				warn("[Reconnect] " .. reason .. " -- attempt " .. attempt .. " to rejoin " .. target
					.. " (place " .. tostring(game.PlaceId) .. ", server " .. tostring(RECONNECT.jobId) .. ")")
				RECONNECT.SetStatus("Rejoining " .. target .. " -- attempt " .. attempt .. "\nReason: " .. reason)

				local ok, err = pcall(function()
					game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
				end)
				if not ok then
					warn("[Reconnect] the teleport call itself failed: " .. tostring(err))
				end

				-- If it worked the client is already leaving and nothing below
				-- ever runs. If it did not, wait and try again -- forever, on
				-- the same server. There is no second choice by design.
				local pause = delays[attempt] or delays[#delays]
				local waited = 0
				while waited < pause and RECONNECT.enabled and LOOPGUARDS.reconnect and SESSION.alive do
					task.wait(1)
					waited = waited + 1
				end
			end
		end

		LOOPGUARDS.reconnect = false
		RECONNECT.rejoining = false
	end)
end

do
	RECONNECT.Load()

	SESSION.Track(game:GetService("TeleportService").TeleportInitFailed:Connect(function(_, result, message)
		RECONNECT.teleporting = false
		warn("[Reconnect] Roblox refused the teleport: " .. tostring(result) .. " " .. tostring(message))
		RECONNECT.SetStatus("Roblox refused the teleport: " .. tostring(message) .. "\nStill retrying the same server.")
	end))

	-- Roblox tells us when it has actually taken a teleport on. While that is
	-- true the retry loop must not fire another one.
	SESSION.Track(LocalPlayer.OnTeleport:Connect(function(state)
		if state == Enum.TeleportState.Failed then
			RECONNECT.teleporting = false
			warn("[Reconnect] the teleport failed -- still retrying")
		else
			RECONNECT.teleporting = true
			RECONNECT.teleportingSince = os.clock()
		end
	end))

	SESSION.Track(game:GetService("GuiService").ErrorMessageChanged:Connect(function(message)
		-- An emptied message is Roblox clearing an error, not a new one. It used
		-- to be read as "connection lost" and start a rejoin from a working server.
		if type(message) ~= "string" or message == "" then
			return
		end
		RECONNECT.Go(message)
	end))

	-- The disconnect prompt lives in CoreGui, which needs executor-level
	-- access -- pcall'd, and said out loud if it is not reachable, because
	-- without it only the GuiService signal is left.
	-- In its own thread: where CoreGui cannot be seen, the two waits below run
	-- their full 20s each, and the menu used to sit unfinished behind them.
	task.spawn(function()
		local promptOk, overlay = pcall(function()
			return game:GetService("CoreGui"):WaitForChild("RobloxPromptGui", 20):WaitForChild("promptOverlay", 20)
		end)

		if promptOk and overlay then
			-- CoreGui is NOT rebuilt by a teleport, so the prompt from the
			-- disconnect we just recovered from is still sitting here on arrival --
			-- and it is a full-screen modal, which is why the script's own UI drew
			-- fine but swallowed every click. Hide it, loudly.
			local leftover = overlay:FindFirstChild("ErrorPrompt")
			if leftover then
				warn("[Reconnect] a disconnect prompt from the previous server was still on screen -- hiding it, it blocks every click")
				pcall(function()
					leftover.Visible = false
				end)
			end

			-- The prompt's own words go along: they say WHY (idle, kicked, another
			-- device...), which decides whether a rejoin makes sense at all.
			SESSION.Track(overlay.ChildAdded:Connect(function(child)
				if child.Name == "ErrorPrompt" then
					task.wait(0.5) -- its text is filled in a moment after it appears
					RECONNECT.Go("Roblox error box: " .. RECONNECT.ErrorText(child))
				end
			end))

			-- Backstop for a prompt that is re-shown rather than re-created, which
			-- ChildAdded would never see.
			task.spawn(function()
				while SESSION.alive do
					local prompt = overlay:FindFirstChild("ErrorPrompt")
					if prompt and prompt.Visible and not RECONNECT.rejoining
						and not RECONNECT.stopped and os.clock() >= RECONNECT.skipUntil then
						RECONNECT.Go("Roblox error box: " .. RECONNECT.ErrorText(prompt))
					end
					task.wait(3)
				end
			end)
		else
			warn("[Reconnect] the Roblox disconnect prompt is not reachable on this executor -- only the GuiService error signal is left, which may miss a silent disconnect")
		end
	end)
end

