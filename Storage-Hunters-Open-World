-- =========================================================
-- AUTO GOLD PAN (Wild West event). Protocol measured
-- (docs/wild-west-event.md): GoldPanAction:FireServer(tool, token, action),
-- action one of Use/Hold/Release/Cancel/Collect/Sync. Holding is NOT one
-- "Hold" -- the server's HoldLeaseSeconds is 0.55s, so "Hold" is re-fired
-- here on an interval comfortably under that (0.1s, matching the real
-- client's 0.15s) for as long as the phase is Filling/Panning, or the
-- fill/pan progress reverts on its own. A session left idle (tool
-- unequipped by something else, e.g. Auto Fish/Auto Collect grabbing the
-- tool slot) can be lost for a real use with nothing collected -- measured
-- live -- so this never fights another feature for the tool slot, it just
-- stops the cycle and retries next pass.
--
-- Takes over from Auto Farm while it works: pauses it through FARM.toggle
-- (same as a manual click, so Auto Collect's snapshot/restore and the
-- master cycle stop/start all happen exactly as they would by hand) once
-- the auction FSM is idle (AUCTION.BusyReason(), never mid-auction), then
-- teleports to GOLDPAN.SPOT -- the one sand+water spot measured live
-- Both in reach from that exact standing position, no walking
-- needed between fill and pan. Resumes Auto Farm to whatever it was once
-- out of usable pans. This whole section is event-only: delete it together
-- with docs/wild-west-event.md once the event ends (2026-09-26).
-- =========================================================
local GOLDPAN = {
	active = false,
	Surface = SafeRequire(ReplicatedStorage.Modules.GoldPanSurface, "GoldPanSurface"),
	tool = nil,
	holdPulseSeconds = 0.1,
	lastNoPanNotifyAt = 0,
	warnedNoPan = false,
	collectsThisSession = 0,
	SPOT = Vector3.new(-820.0596923828125, 1700.3621826171875, -548.6385498046875),
}

-- A used-up Gold Pan is NOT removed from the inventory (Consumable applies
-- to the item being usable, not to it disappearing) -- it sits there with
-- Condition 0 and a "Broken" mutator, same signal isFishEntryBroken already
-- reads for fishing rods (measured live 2026-09-13). Skip those or this
-- picks the same dead pan forever while good ones sit unused.
function GOLDPAN.FindPanGuid()
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not ok or type(inventory) ~= "table" then
		warn("[GoldPan] GetPlayerInventory failed: " .. tostring(inventory))
		return nil
	end
	for guid, entry in pairs(inventory) do
		if tostring(entry.ItemId) == "1046" and not isFishEntryBroken(entry) then
			return guid
		end
	end
	return nil
end

-- Ignores Item Rules on purpose: a broken Gold Pan is worthless for panning
-- but the user's own rules elsewhere keep it (that's what those rules are
-- for), so this is a separate, narrow pass that sells ONLY entries carrying
-- the Broken mutator, via the same Pawn.SellItems remote AutoSell uses.
function GOLDPAN.SellBrokenPans()
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not ok or type(inventory) ~= "table" then
		warn("[GoldPan] GetPlayerInventory failed: " .. tostring(inventory))
		return
	end

	local guids = {}
	for guid, entry in pairs(inventory) do
		if tostring(entry.ItemId) == "1046" and isFishEntryBroken(entry) then
			table.insert(guids, guid)
		end
	end
	if #guids == 0 then
		return
	end

	local sellOk, result = pcall(function()
		return AUTOSELL.SellItems:InvokeServer(guids)
	end)
	if sellOk and type(result) == "table" and result.success then
		print("[GoldPan] Sold " .. #guids .. " broken Gold Pan(s) for $" .. tostring(result.totalEarned))
	else
		local reason = "unknown"
		if sellOk and type(result) == "table" and result.error then
			reason = tostring(result.error)
		else
			reason = tostring(result)
		end
		warn("[GoldPan] Selling broken Gold Pans failed: " .. reason)
	end
end

GOLDPAN.sellBrokenEnabled = false
GOLDPAN.sellBrokenIntervalSeconds = 30

function GOLDPAN.StartSellBroken()
	if LOOPGUARDS.goldPanSellBroken then
		return
	end
	LOOPGUARDS.goldPanSellBroken = true
	task.spawn(function()
		while GOLDPAN.sellBrokenEnabled and LOOPGUARDS.goldPanSellBroken and SESSION.alive do
			GOLDPAN.SellBrokenPans()
			task.wait(GOLDPAN.sellBrokenIntervalSeconds)
		end
		LOOPGUARDS.goldPanSellBroken = false
	end)
end

function GOLDPAN.EnsureEquipped()
	local character = LocalPlayer.Character
	local existing = character and character:FindFirstChildOfClass("Tool")
	if existing and existing.Name == "Gold Pan" then
		local usesLeft = existing:GetAttribute("GoldPanUsesLeft")
		if usesLeft == nil or usesLeft > 0 then
			GOLDPAN.tool = existing
			return true
		end
	end

	local guid = GOLDPAN.FindPanGuid()
	if not guid then
		if os.clock() - GOLDPAN.lastNoPanNotifyAt > 15 then
			GOLDPAN.lastNoPanNotifyAt = os.clock()
			DebugPrint("[GoldPan] No Gold Pan in inventory, waiting...")
		end
		GOLDPAN.tool = nil
		return false
	end

	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		pcall(function() humanoid:UnequipTools() end)
		task.wait(0.2)
	end

	local equipOk, equipErr = pcall(function()
		REMOTES.EquipItem:FireServer(guid)
	end)
	if not equipOk then
		warn("[GoldPan] EquipItem failed: " .. tostring(equipErr))
		return false
	end

	local newTool
	for _ = 1, 20 do
		task.wait(0.1)
		local char2 = LocalPlayer.Character
		local candidate = char2 and char2:FindFirstChildOfClass("Tool")
		if candidate and candidate.Name == "Gold Pan" then
			newTool = candidate
			break
		end
	end
	if not newTool then
		warn("[GoldPan] Equip did not produce a Gold Pan Tool")
		return false
	end
	GOLDPAN.tool = newTool
	return true
end

-- Drives one tool through as much of Empty -> Filling -> Filled -> Loaded ->
-- Panning -> Revealed -> Collect as the surface underfoot/in reach allows,
-- then returns. Never teleports or moves the HRP -- if sand or water is not
-- in reach it just waits, exactly like Grade/Wash are passive by design.
function GOLDPAN.RunOneCycle()
	local tool = GOLDPAN.tool
	local Surface = GOLDPAN.Surface
	if not tool or not Surface then
		return
	end

	local character = LocalPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end

	-- phase starts as nil, NOT a guessed "Empty" -- guessing wrong here is a
	-- real, measured bug: if the Sync reply is even slightly
	-- late, an assumed "Empty" fires "Use" into a session that is already
	-- Filling server-side, which resets its progress to 0. The proven-good
	-- pattern (a clean isolated test, same run) is to wait for the FIRST
	-- real server phase before acting at all.
	local phase, token = nil, nil
	local conn
	conn = REMOTES.GoldPanState.OnClientEvent:Connect(function(firedTool, data)
		if firedTool == tool and type(data) == "table" then
			token = data.Token
			phase = data.Phase
		end
	end)

	-- Picks up whatever session the server already has open for this tool
	-- (it may still be Filled/Loaded/Filling from an earlier interrupted
	-- pass). Poll briefly rather than a fixed wait -- a fixed wait is
	-- exactly the race that caused the bug above.
	REMOTES.GoldPanAction:FireServer(tool, nil, "Sync")
	local syncWaited = 0
	while phase == nil and syncWaited < 2 do
		task.wait(0.1)
		syncWaited = syncWaited + 0.1
	end

	local lastHoldAt = 0
	local lastActedPhase = nil
	local startedAt = os.clock()
	-- Set the moment we start waiting for sand/water underfoot, cleared
	-- the moment that wait ends. If it runs past a few seconds the player
	-- has almost certainly drifted off GOLDPAN.SPOT (MaxMoveWhilePanning
	-- is only 3 studs) -- the user found this happens from ANY movement
	-- after the initial teleport. Bailing out here lets the outer loop's
	-- own position check re-teleport and retry immediately, instead of
	-- sitting there stalled for the full 30s cycle timeout.
	local stallSince = nil

	while GOLDPAN.active and tool.Parent and os.clock() - startedAt < 30 do
		if phase == "Revealed" then
			REMOTES.GoldPanAction:FireServer(tool, token, "Collect")
			task.wait(0.4)
			GOLDPAN.collectsThisSession = GOLDPAN.collectsThisSession + 1
			print("[GoldPan] Collected a haul (" .. GOLDPAN.collectsThisSession .. " this session)")
			break
		elseif phase == "Broken" or phase == "Closed" then
			DebugPrint("[GoldPan] Session ended: " .. tostring(phase))
			break
		elseif phase == "Filling" or phase == "Panning" then
			-- Track that we were mid-hold: if the lease expires and the
			-- server reverts to Empty/Loaded, lastActedPhase must NOT still
			-- read as that same phase from before we started holding, or
			-- the Empty/Loaded branch below sees "already acted" and never
			-- re-fires "Use" -- stuck until the 30s cycle timeout. Measured
			-- live: Panning reverted to Loaded at 40% progress
			-- and sat there doing nothing until the timeout killed it.
			lastActedPhase = phase
			stallSince = nil
			local now = os.clock()
			if now - lastHoldAt >= GOLDPAN.holdPulseSeconds then
				lastHoldAt = now
				REMOTES.GoldPanAction:FireServer(tool, token, "Hold")
			end
			task.wait()
		elseif phase == "Empty" then
			if not Surface.FindSand(character, hrp) then
				if lastActedPhase ~= "waitSand" then
					DebugPrint("[GoldPan] Waiting for sand underfoot")
					lastActedPhase = "waitSand"
					stallSince = os.clock()
				elseif stallSince and os.clock() - stallSince > 3 then
					DebugPrint("[GoldPan] Off the sand for 3s+, likely drifted -- bailing to re-teleport")
					break
				end
				task.wait(1)
			elseif lastActedPhase ~= phase then
				lastActedPhase = phase
				stallSince = nil
				REMOTES.GoldPanAction:FireServer(tool, token, "Use")
				task.wait(0.15)
			else
				task.wait(0.15)
			end
		elseif phase == "Loaded" then
			if not Surface.FindWater(character, hrp) then
				if lastActedPhase ~= "waitWater" then
					DebugPrint("[GoldPan] Pan full, waiting for water in reach")
					lastActedPhase = "waitWater"
					stallSince = os.clock()
				elseif stallSince and os.clock() - stallSince > 3 then
					DebugPrint("[GoldPan] Off the water for 3s+, likely drifted -- bailing to re-teleport")
					break
				end
				task.wait(1)
			elseif lastActedPhase ~= phase then
				lastActedPhase = phase
				stallSince = nil
				REMOTES.GoldPanAction:FireServer(tool, token, "Use")
				task.wait(0.15)
			else
				task.wait(0.15)
			end
		elseif phase == "Filled" then
			if lastActedPhase ~= phase then
				lastActedPhase = phase
				REMOTES.GoldPanAction:FireServer(tool, token, "Cancel")
			end
			task.wait(0.15)
		else
			task.wait(0.3)
		end
	end

	conn:Disconnect()
end

-- Thin wrappers over the ONE shared Auto Farm hold that every Wild West
-- feature goes through (GOLDPAN.WW.PauseFarm, declared further down -- a
-- later declaration is fine because these bodies only run at call time).
-- Gold Pan used to keep its own separate hold, which meant it and a combat
-- feature could each independently decide Auto Farm was theirs to switch
-- back on; sharing the refcount is what stops the loser of that race
-- restarting the farm underneath the winner.
function GOLDPAN.PauseFarm()
	if not GOLDPAN.WW.PauseFarm("GoldPan", 60, GOLDPAN.WW.PRIORITY.GoldPan) then
		return false
	end
	-- Panning can be switched off during the auction wait inside there.
	if not GOLDPAN.active then
		GOLDPAN.WW.ResumeFarm("GoldPan")
		return false
	end
	return true
end

function GOLDPAN.ResumeFarm()
	GOLDPAN.WW.ResumeFarm("GoldPan")
end

GOLDPAN.intervalSeconds = 1

function GOLDPAN.Start()
	if LOOPGUARDS.goldPan then
		return
	end
	LOOPGUARDS.goldPan = true
	task.spawn(function()
		while GOLDPAN.active and LOOPGUARDS.goldPan and SESSION.alive do
			-- Lowest priority of the Wild West features (GOLDPAN.WW.PRIORITY),
			-- so it never preempts anything -- but it DOES claim the floor
			-- now. It used to pan without claiming at all, which left the
			-- lock reading "free" for the whole time a pan session owned the
			-- player's position and the tool slot: an outlaw sweep coming due
			-- saw nothing to yield to and took the character mid-cycle. That
			-- is the user's "outlaw barges in" seen from the other side.
			local haveGuid = GOLDPAN.FindPanGuid()
			if haveGuid then
				GOLDPAN.WW.ClearBlocked(GOLDPAN, "warnedNoPan", "[GoldPan] Got a Gold Pan back")
			end
			if GOLDPAN.WW.ShouldYield(GOLDPAN.WW.PRIORITY.GoldPan) then
				GOLDPAN.WW.Announce(GOLDPAN.WW.PRIORITY.GoldPan, "GoldPan", 6)
				task.wait(2)
			elseif not haveGuid then
				-- Silent before this (confirmed: inventory can
				-- genuinely hit zero pans, worked and broken both, once the last
				-- one is used up and sold, and the toggle just idles forever with
				-- nothing in the console to say why -- reads as "it stopped" with
				-- no explanation). Same latched pattern as the no-gun case below:
				-- one line when it starts, one when Auto Farm hands it a fresh
				-- pan and it can resume.
				GOLDPAN.WW.ReportBlocked(GOLDPAN, "warnedNoPan",
					"[GoldPan] Auto Gold Pan is ON but you have no Gold Pan in inventory (used up and sold) -- waiting for Auto Farm to find another one")
				task.wait(5)
			elseif not GOLDPAN.WW.Claim(GOLDPAN.WW.PRIORITY.GoldPan, "GoldPan", 120) then
				task.wait(2)
			elseif not GOLDPAN.PauseFarm() then
				GOLDPAN.WW.Release("GoldPan")
				task.wait(5)
			else
				-- Contained so an error mid-cycle cannot kill the loop while
				-- it holds the floor and the Auto Farm hold -- the release
				-- below has to run on every path, including a thrown one.
				local panOk, panErr = pcall(function()
				TeleportPlayerOnly(GOLDPAN.SPOT)
				task.wait(0.6)
				while GOLDPAN.active and LOOPGUARDS.goldPan and SESSION.alive and GOLDPAN.FindPanGuid() do
					-- Checked EVERY cycle, not just on the way in: one cycle
					-- runs up to 30s and a full pan stock is minutes, so
					-- without this a race or a defense coming due had to wait
					-- out the entire stock before anything would hand over.
					if GOLDPAN.WW.ShouldYield(GOLDPAN.WW.PRIORITY.GoldPan) then
						print("[GoldPan] Something more important needs the floor, stopping after this pan")
						break
					end
					GOLDPAN.WW.Renew("GoldPan", 120)
					-- RunOneCycle only detects drift and bails -- it never
					-- re-teleports itself. Without this check, any accidental
					-- move away from GOLDPAN.SPOT (the user walking, a launch,
					-- anything) left every following cycle stuck off sand/water,
					-- silently eating the whole pan stock and Auto Farm's hold
					-- for nothing.
					local hrp = GetFreshHRP()
					if hrp and (hrp.Position - GOLDPAN.SPOT).Magnitude > 5 then
						DebugPrint("[GoldPan] Drifted off the pan spot, re-teleporting")
						TeleportPlayerOnly(GOLDPAN.SPOT)
						task.wait(0.6)
					end
					if GOLDPAN.EnsureEquipped() then
						GOLDPAN.RunOneCycle()
					else
						break
					end
					task.wait(0.15)
				end
				end)
				if not panOk then
					warn("[GoldPan] Pan session errored: " .. tostring(panErr))
				end
				GOLDPAN.ResumeFarm()
				GOLDPAN.WW.Release("GoldPan")
			end
			task.wait(GOLDPAN.intervalSeconds)
		end
		GOLDPAN.ResumeFarm()
		GOLDPAN.WW.Release("GoldPan")
		LOOPGUARDS.goldPan = false
	end)
end

