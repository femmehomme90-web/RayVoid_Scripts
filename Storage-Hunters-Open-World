	RULES.ED.Button(head, "remove", UDim2.fromOffset(58, 18), UDim2.new(1, -66, 0, 1), {
		bg = RULES.ED.BAD, textSize = 11,
		onClick = function()
			table.remove(setup.lines, lineIndex)
			RULES.Save(RULES.ED.current)
			RULES.ED.Render()
		end,
	})

	for altIndex = 1, #line.alts do
		RULES.ED.BuildAltRow(card, setup, line, altIndex, altIndex + 1)
	end

	if #line.alts < RULES.MAX_ALTS then
		local addRow = RULES.ED.Row(card, 24, 100)
		RULES.ED.Button(addRow, "+ or ...", UDim2.fromOffset(80, 20), UDim2.fromOffset(30, 2), {
			bg = RULES.ED.CARD, textSize = 12,
			onClick = function()
				table.insert(line.alts, { mutation = nil, minPercent = nil })
				RULES.Save(RULES.ED.current)
				RULES.ED.Render()
			end,
		})
	end
	return card
end

function RULES.ED.BuildSetup(parent, rule, setupIndex, order)
	local setup = rule.setups[setupIndex]
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, -4, 0, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = RULES.ED.CARD
	card.BorderSizePixel = 0
	card.LayoutOrder = order
	card.Parent = parent
	RULES.ED.Corner(card, 8)

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = card
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 6)
	padding.PaddingBottom = UDim.new(0, 8)
	padding.PaddingLeft = UDim.new(0, 8)
	padding.PaddingRight = UDim.new(0, 8)
	padding.Parent = card

	local head = RULES.ED.Row(card, 22, 1)
	RULES.ED.Label(head, "Buff setup " .. setupIndex .. "   -   " .. RULES.DescribeSetup(setup),
		UDim2.new(1, -70, 0, 22), UDim2.fromOffset(0, 0), { bold = true })
	RULES.ED.Button(head, "delete", UDim2.fromOffset(58, 20), UDim2.new(1, -62, 0, 1), {
		bg = RULES.ED.BAD, textSize = 11,
		onClick = function()
			table.remove(rule.setups, setupIndex)
			RULES.Save(RULES.ED.current)
			RULES.ED.Render()
		end,
	})

	for lineIndex = 1, #setup.lines do
		RULES.ED.BuildLine(card, setup, lineIndex, lineIndex + 1)
	end

	if #setup.lines < RULES.MAX_LINES then
		local addRow = RULES.ED.Row(card, 24, 50)
		RULES.ED.Button(addRow, "+ and another mutation", UDim2.fromOffset(170, 22), UDim2.fromOffset(0, 1), {
			bg = RULES.ED.CARD2, textSize = 12,
			onClick = function()
				table.insert(setup.lines, { alts = { { mutation = nil, minPercent = nil } } })
				RULES.Save(RULES.ED.current)
				RULES.ED.Render()
			end,
		})
	end

	local totals = RULES.ED.Row(card, 26, 60)
	RULES.ED.Label(totals, "or all its buffs together add up to at least",
		UDim2.fromOffset(236, 26), UDim2.fromOffset(0, 0), { color = RULES.ED.DIM })
	RULES.ED.NumberBox(totals, setup.sumMin, UDim2.fromOffset(56, 22), UDim2.fromOffset(238, 2), "any",
		function(value)
			setup.sumMin = value
			RULES.Save(RULES.ED.current)
			RULES.ED.Render()
		end)
	RULES.ED.Label(totals, "%", UDim2.fromOffset(14, 26), UDim2.fromOffset(298, 0), { color = RULES.ED.DIM })
	return card
end

-- One lane's lists. Every row drives the REAL RayVoid control through its own
-- :Set(), so the lane's state table, its hooks (IGNOREBID.Rebuild and friends)
-- and the config flag all update exactly as if the dropdown had been clicked
-- by hand. Nothing here re-implements a filter.
function RULES.ED.RenderFilters()
	local pane = RULES.ED.right
	local lane = RULES.ED.lane or FILTERS.ORDER[1]
	local order = 0
	local function nextOrder()
		order = order + 1
		return order
	end

	RULES.ED.Label(pane, FILTERS.TITLE[lane] or lane,
		UDim2.new(1, 0, 0, 22), nil, { bold = true, color = RULES.ED.ACCENT, order = nextOrder() })
	RULES.ED.Label(pane, FILTERS.NOTE[lane] or "", UDim2.new(1, 0, 0, 18), nil,
		{ color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
	local cannot = FILTERS.CANNOT[lane]
	if type(cannot) == "string" then
		cannot = { cannot }
	end
	for _, line in ipairs(cannot or {}) do
		RULES.ED.Label(pane, line, UDim2.new(1, 0, 0, 18), nil,
			{ color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
	end

	local entries = FILTERS.ForLane(lane)
	if #entries == 0 then
		RULES.ED.Label(pane, "This lane has no item lists.", UDim2.new(1, 0, 0, 20), nil,
			{ color = RULES.ED.DIM, order = nextOrder() })
		return
	end

	for _, entry in ipairs(entries) do
		if entry.kind == "bool" then
			local on = FILTERS.Current(entry) == true
			local row = RULES.ED.Row(pane, 26, nextOrder())
			RULES.ED.Button(row, (on and "[x]  " or "[  ]  ") .. entry.label,
				UDim2.new(1, -4, 0, 24), UDim2.fromOffset(0, 1), {
					bg = on and RULES.ED.GOOD or RULES.ED.CARD,
					align = Enum.TextXAlignment.Left,
					padLeft = 8,
					onClick = function()
						FILTERS.Set(entry, not on)
						RULES.ED.Render()
					end,
				})
			if entry.note then
				RULES.ED.Label(pane, "        " .. entry.note, UDim2.new(1, 0, 0, 16), nil,
					{ color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
			end
		else
			local current = FILTERS.Current(entry)
			local picked = {}
			for _, value in ipairs(current) do
				picked[value] = true
			end
			local shown = (#current == 0) and "nothing" or table.concat(current, ", ")
			local row = RULES.ED.Row(pane, 28, nextOrder())
			RULES.ED.Label(row, entry.label, UDim2.fromOffset(108, 28), UDim2.fromOffset(0, 0),
				{ color = RULES.ED.DIM })
			RULES.ED.Button(row, "(" .. #current .. ")  " .. shown,
				UDim2.new(1, -178, 0, 24), UDim2.fromOffset(110, 2), {
					align = Enum.TextXAlignment.Left,
					padLeft = 8,
					color = (#current > 0) and RULES.ED.TEXT or RULES.ED.DIM,
					onClick = function()
						local options = entry.options
						if type(options) == "function" then
							options = options()
						end
						RULES.ED.OpenPicker(entry.label, options or {},
							function(option)
								return picked[option] == true
							end,
							function(option)
								if picked[option] then
									picked[option] = nil
								else
									picked[option] = true
								end
								local list = {}
								for value in pairs(picked) do
									table.insert(list, value)
								end
								table.sort(list)
								FILTERS.Set(entry, list)
							end)
					end,
				})
			RULES.ED.Button(row, "clear", UDim2.fromOffset(58, 24), UDim2.new(1, -62, 0, 2), {
				bg = RULES.ED.CARD,
				color = RULES.ED.DIM,
				onClick = function()
					FILTERS.Set(entry, {})
					RULES.ED.Render()
				end,
			})

			-- The row's button is one line wide and truncates, so the full
			-- selection is spelled out underneath. RayVoid's own control
			-- collapses to "Various" and this window replaced the paragraph
			-- that used to expand it -- without this, a 43-name list has no
			-- place on screen where you can actually read it.
			if #current > 0 then
				local full = table.concat(current, ", ")
				local label = RULES.ED.Label(pane, full, UDim2.new(1, -12, 0, 0), nil,
					{ color = RULES.ED.DIM, textSize = 11, wrapped = true, order = nextOrder() })
				label.AutomaticSize = Enum.AutomaticSize.Y
				label.TextYAlignment = Enum.TextYAlignment.Top
				local pad = Instance.new("UIPadding")
				pad.PaddingLeft = UDim.new(0, 112)
				pad.PaddingBottom = UDim.new(0, 4)
				pad.Parent = label
			end
		end
	end

	-- The bid lane has feedback nothing else has: which of the chosen items are
	-- actually learned, and which can never be learned at all. That paragraph
	-- stayed on the Auction tab when the lists moved in here, which left the
	-- control and the only thing that explains it on different screens.
	if lane == "bid" then
		local status = IGNOREBID.statusText
		if type(status) == "string" and status ~= "" then
			RULES.ED.Label(pane, "WHAT IS ACTUALLY WATCHED", UDim2.new(1, 0, 0, 20), nil,
				{ bold = true, color = RULES.ED.ACCENT, order = nextOrder() })
			local label = RULES.ED.Label(pane, status, UDim2.new(1, -12, 0, 0), nil,
				{ color = RULES.ED.DIM, textSize = 11, wrapped = true, order = nextOrder() })
			label.AutomaticSize = Enum.AutomaticSize.Y
			label.TextYAlignment = Enum.TextYAlignment.Top
		end
		RULES.ED.Label(pane, "Mutations always work. Items and rarities must be learned first",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "with \"Learn ALL Items\" on the Auction tab. Boxed items never match.",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
	end

	-- Where a rule and a list disagree about the same item the RULE wins, so
	-- the list is left showing something that is no longer true. Saying so is
	-- the point: a control that lies quietly is the failure this whole tab
	-- exists to avoid.
	local clashes = RULES.Contradictions(lane)
	if #clashes > 0 then
		RULES.ED.Label(pane, "! A RULE OVERRIDES THIS LIST FOR:", UDim2.new(1, 0, 0, 20), nil,
			{ bold = true, color = RULES.ED.WARN, order = nextOrder() })
		for _, line in ipairs(clashes) do
			RULES.ED.Label(pane, "   " .. line, UDim2.new(1, 0, 0, 18), nil,
				{ color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
		end
	end
end

function RULES.ED.RenderRight()
	local pane = RULES.ED.right
	for _, child in ipairs(pane:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end

	if RULES.ED.mode == "filters" then
		RULES.ED.RenderFilters()
		return
	end

	local rule = RULES.rules[RULES.ED.current]
	local order = 0
	local function nextOrder()
		order = order + 1
		return order
	end

	-- Name
	local nameRow = RULES.ED.Row(pane, 28, nextOrder())
	RULES.ED.Label(nameRow, "Call it", UDim2.fromOffset(96, 28), UDim2.fromOffset(0, 0), { color = RULES.ED.DIM })
	local nameBox = Instance.new("TextBox")
	nameBox.Size = UDim2.new(1, -106, 0, 24)
	nameBox.Position = UDim2.fromOffset(100, 2)
	nameBox.BackgroundColor3 = RULES.ED.BAR
	nameBox.BorderSizePixel = 0
	nameBox.Font = Enum.Font.Gotham
	nameBox.TextSize = 13
	nameBox.TextColor3 = RULES.ED.TEXT
	nameBox.TextXAlignment = Enum.TextXAlignment.Left
	nameBox.PlaceholderText = "e.g. keep good gavels"
	nameBox.PlaceholderColor3 = RULES.ED.DIM
	nameBox.ClearTextOnFocus = false
	nameBox.Text = rule.label or ""
	nameBox.Parent = nameRow
	RULES.ED.Corner(nameBox, 5)
	local namePad = Instance.new("UIPadding")
	namePad.PaddingLeft = UDim.new(0, 8)
	namePad.Parent = nameBox
	nameBox.FocusLost:Connect(function()
		rule.label = nameBox.Text or ""
		RULES.Save(RULES.ED.current)
		RULES.ED.RenderLeft()
		RULES.ED.RenderFooter()
	end)

	-- ALL / ANY as two buttons rather than a dropdown, so the mode in force is
	-- on screen without opening anything. The header used to say "any one of
	-- these is enough" in small print, and that was not enough.
	local modeRow = RULES.ED.Row(pane, 28, nextOrder())
	RULES.ED.Label(modeRow, "APPLIES TO", UDim2.fromOffset(96, 28), UDim2.fromOffset(0, 0),
		{ bold = true, color = RULES.ED.ACCENT })
	local function modeButton(text, value, x)
		local on = (rule.matchAll == value)
		RULES.ED.Button(modeRow, (on and "[x]  " or "[  ]  ") .. text, UDim2.fromOffset(120, 24), UDim2.fromOffset(x, 2), {
			bg = on and RULES.ED.ACCENT or RULES.ED.CARD,
			color = on and RULES.ED.TEXT or RULES.ED.DIM,
			onClick = function()
				rule.matchAll = value
				RULES.Save(RULES.ED.current)
				RULES.ED.Render()
			end,
		})
	end
	modeButton("ALL rows", true, 100)
	modeButton("ANY row", false, 226)
	local modeHint = RULES.ED.Label(pane, rule.matchAll
		and "The item must pass every row you filled in. Within one row, any tick is enough."
		or "Passing any one row you filled in is enough.",
		UDim2.new(1, -12, 0, 0), nil, { color = RULES.ED.DIM, textSize = 11, wrapped = true, order = nextOrder() })
	modeHint.AutomaticSize = Enum.AutomaticSize.Y

	RULES.ED.PickerRow(pane, nextOrder(), "Item name", rule.names, ALL_ITEM_NAMES)
	RULES.ED.TickedList(pane, nextOrder(), rule.names)
	RULES.ED.PickerRow(pane, nextOrder(), "Mutation", rule.mutationNames, FORCEBID.options)
	RULES.ED.TickedList(pane, nextOrder(), rule.mutationNames)
	RULES.ED.PickerRow(pane, nextOrder(), "Category", rule.categories, AUTOPLACE_CATEGORY_OPTIONS)
	RULES.ED.TickedList(pane, nextOrder(), rule.categories)
	RULES.ED.PickerRow(pane, nextOrder(), "Rarity", rule.rarities, GRADE_RARITY_OPTIONS)
	RULES.ED.TickedList(pane, nextOrder(), rule.rarities)
	RULES.ED.PickerRow(pane, nextOrder(), "Is", rule.traits, RULES.TRAIT_OPTIONS)
	RULES.ED.TickedList(pane, nextOrder(), rule.traits)

	local impossible = RULES.UnmatchableNames(rule, RULES.ED.ItemDefs)
	if #impossible > 0 then
		local warnLabel = RULES.ED.Label(pane,
			"! Can never match on ALL -- their own category, rarity or Is box fails another row: "
				.. table.concat(impossible, ", "),
			UDim2.new(1, -12, 0, 0), nil, { color = RULES.ED.WARN, textSize = 11, wrapped = true, order = nextOrder() })
		warnLabel.AutomaticSize = Enum.AutomaticSize.Y
	end

	local valueRow = RULES.ED.Row(pane, 28, nextOrder())
	RULES.ED.Label(valueRow, "Worth", UDim2.fromOffset(96, 28), UDim2.fromOffset(0, 0), { color = RULES.ED.DIM })
	RULES.ED.Label(valueRow, "from", UDim2.fromOffset(34, 28), UDim2.fromOffset(100, 0), { color = RULES.ED.DIM })
	RULES.ED.NumberBox(valueRow, rule.minValue, UDim2.fromOffset(88, 24), UDim2.fromOffset(134, 2), "anything",
		function(value)
			rule.minValue = value
			RULES.Save(RULES.ED.current)
			RULES.ED.RenderFooter()
		end)
	RULES.ED.Label(valueRow, "to", UDim2.fromOffset(20, 28), UDim2.fromOffset(228, 0), { color = RULES.ED.DIM })
	RULES.ED.NumberBox(valueRow, rule.maxValue, UDim2.fromOffset(88, 24), UDim2.fromOffset(250, 2), "anything",
		function(value)
			rule.maxValue = value
			RULES.Save(RULES.ED.current)
			RULES.ED.RenderFooter()
		end)

	local weightRow = RULES.ED.Row(pane, 28, nextOrder())
	RULES.ED.Label(weightRow, "Weighs", UDim2.fromOffset(96, 28), UDim2.fromOffset(0, 0), { color = RULES.ED.DIM })
	RULES.ED.Label(weightRow, "from", UDim2.fromOffset(34, 28), UDim2.fromOffset(100, 0), { color = RULES.ED.DIM })
	RULES.ED.NumberBox(weightRow, rule.weightMin, UDim2.fromOffset(88, 24), UDim2.fromOffset(134, 2), "any KG",
		function(value)
			rule.weightMin = value
			RULES.Save(RULES.ED.current)
			RULES.ED.RenderFooter()
		end)
	RULES.ED.Label(weightRow, "to", UDim2.fromOffset(20, 28), UDim2.fromOffset(228, 0), { color = RULES.ED.DIM })
	RULES.ED.NumberBox(weightRow, rule.weightMax, UDim2.fromOffset(88, 24), UDim2.fromOffset(250, 2), "any KG",
		function(value)
			rule.weightMax = value
			RULES.Save(RULES.ED.current)
			RULES.ED.RenderFooter()
		end)
	RULES.ED.Label(weightRow, "KG", UDim2.fromOffset(30, 28), UDim2.fromOffset(344, 0), { color = RULES.ED.DIM })

	RULES.ED.Label(pane, "Every item has a weight. Uranium Ore, Hay, the crops and the eggs roll their own.",
		UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
	RULES.ED.Label(pane, "! KG only works on items ALREADY IN YOUR INVENTORY (sell / place / grade).",
		UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
	RULES.ED.Label(pane, "  The game does not reveal a weight while the lot is still up for auction.",
		UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })

	RULES.ED.Label(pane, "MUTATION BUFFS  --  minimum %, stacking multiple buffs, gavels and anything else that rolls them",
		UDim2.new(1, 0, 0, 22), nil, { bold = true, color = RULES.ED.ACCENT, order = nextOrder() })
	RULES.ED.Label(pane, "Leave this empty unless you need a %. Just \"has this mutation\" is the Mutation row above.",
		UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
	RULES.ED.Label(pane, "! Buff % only works on items ALREADY IN YOUR INVENTORY (sell / place / grade).",
		UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
	RULES.ED.Label(pane, "  During an auction the game shows a gavel's buff NAMES but never their %.",
		UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
	RULES.ED.Label(pane, "  So use a buff NAME on its own to bid; add a % only to sort what you won.",
		UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })

	if #rule.setups == 0 then
		RULES.ED.Label(pane, "No buff requirement: anything matching the boxes above qualifies.",
			UDim2.new(1, 0, 0, 20), nil, { color = RULES.ED.DIM, order = nextOrder() })
	else
		RULES.ED.Label(pane, "It only has to match ONE of these setups.",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
	end

	for setupIndex = 1, #rule.setups do
		RULES.ED.BuildSetup(pane, rule, setupIndex, nextOrder())
	end

	if #rule.setups < RULES.MAX_SETUPS then
		local addRow = RULES.ED.Row(pane, 28, nextOrder())
		RULES.ED.Button(addRow, "+ Another way to qualify", UDim2.fromOffset(180, 24), UDim2.fromOffset(0, 2), {
			bg = RULES.ED.ACCENT, bold = true,
			onClick = function()
				table.insert(rule.setups, { lines = { { alts = { { mutation = nil, minPercent = nil } } } } })
				RULES.Save(RULES.ED.current)
				RULES.ED.Render()
			end,
		})
	end

	RULES.ED.Label(pane, "EFFECTS", UDim2.new(1, 0, 0, 22), nil,
		{ bold = true, color = RULES.ED.ACCENT, order = nextOrder() })

	local blind = RULES.BidBlind(RULES.ED.current)
	if #blind > 0 then
		RULES.ED.Label(pane, "! \"Ignore Min Bid\" cannot see " .. table.concat(blind, ", ") .. ".",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "  During an auction it gets mutation NAMES and nothing else,",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "  so this rule will never make it enter a garage as written.",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "  Its other effects (pick up / sell / place / grade) are fine.",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
	end

	local ground, groundIsNever = RULES.PickupBlind(RULES.ED.current)
	if #ground > 0 and groundIsNever then
		RULES.ED.Label(pane, "! \"Never pick up\" cannot see " .. table.concat(ground, ", ") .. ".",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "  An item on the ground has no KG and no buff %, and leaving one",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "  behind cannot be undone, so this never refuses one out there.",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.WARN, textSize = 11, order = nextOrder() })
		RULES.ED.Label(pane, "  Add \"Never sell / place / grade\" to act on it in your bag.",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
	elseif #ground > 0 then
		RULES.ED.Label(pane, "i  On the ground, pickup ignores " .. table.concat(ground, ", ") .. ".",
			UDim2.new(1, 0, 0, 18), nil, { color = RULES.ED.DIM, textSize = 11, order = nextOrder() })
