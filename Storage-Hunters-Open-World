	end
	table.sort(ids, function(a, b)
		return (tonumber(a) or 0) < (tonumber(b) or 0)
	end)
	local names = {}
	for _, drinkId in ipairs(ids) do
		table.insert(names, ENERGYDRINK.Catalog[drinkId].Name or ("Drink " .. drinkId))
	end
	return names, ids
end)()

-- RayVoid dropdowns return display names; we look up the matching
