-- =========================================================
-- AUTO FISH
-- Cast + reel in a loop on the nearest water part. Reuses the
-- truck/plot/placement from the rest of the script (GetPlayerTruck,
-- HasCargoRoom, UnloadCargo, GetPlayerPlot, GetPlotFurnitureAnchor,
-- PlaceItems, TeleportPlayerOnly) rather than duplicating that logic.
-- =========================================================

-- entry.Mutators (from REMOTES.GetPlayerInventory) is already a decoded Lua
-- table -- no JSONDecode needed as for an instance attribute.
local function isFishEntryBroken(entry)
	if type(entry.Mutators) ~= "table" then
		return false
	end
	for _, mutation in ipairs(entry.Mutators) do
		if type(mutation) == "table" and mutation.name == "Broken" then
			return true
		end
	end
	return false
end

-- Once equipped, the physical Tool exposes its mutations as JSON
-- attributes (Mutator/Mutators), same read as ReadMutatorNames/isItemBroken.
local function NotifyFish(text, color, duration)
	pcall(function()
		REMOTES.Notify:FireServer(text, color, duration or 3)
	end)
end

-- We cannot reliably read a Tool's "broken" state once it is in hand
-- (Mutator/Mutators are not usable there, confirmed in game). Simpler
-- and more reliable: on EVERY cast, we unequip whatever is in hand and
-- re-equip a rod chosen from the server inventory (where the broken
-- state does read correctly, via entry.Mutators).
local function EnsureUsableFishingRod()
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not ok or type(inventory) ~= "table" then
		warn("[AutoFish] GetPlayerInventory failed: " .. tostring(inventory))
		return false
	end

	local rodCount = 0
	local usableCount = 0
	local candidateGuid = nil
	for guid, entry in pairs(inventory) do
		local def = Items[tostring(entry.ItemId)]
		if isFishRodDef(def) then
			rodCount = rodCount + 1
			local broken = isFishEntryBroken(entry)
			DebugPrint(string.format(
				"[AutoFish] inventory rod guid=%s ItemId=%s broken=%s",
				guid, tostring(entry.ItemId), tostring(broken)
			))
			if not broken then
				usableCount = usableCount + 1
				if not candidateGuid then
					candidateGuid = guid
				end
			end
		end
	end
	DebugPrint(string.format("[AutoFish] %d rod(s) in inventory, %d usable", rodCount, usableCount))

	if not candidateGuid then
		if os.clock() - AUTOFISH.lastRodNotifyAt > 15 then
			AUTOFISH.lastRodNotifyAt = os.clock()
			NotifyFish("No usable fishing rod in inventory. Waiting...", Color3.fromRGB(220, 80, 80), 4)
		end
		return false
	end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		pcall(function()
			humanoid:UnequipTools()
		end)
		task.wait(0.2)
	end

	DebugPrint("[AutoFish] equipping candidate guid=" .. tostring(candidateGuid))
	local equipOk, equipErr = pcall(function()
		REMOTES.EquipItem:FireServer(candidateGuid)
	end)
	if not equipOk then
		warn("[AutoFish] EquipItem failed: " .. tostring(equipErr))
		return false
	end

	task.wait(0.5) -- let the server materialize the Tool
	return true
end

local function FindNearbyWater()
	local hrp = GetFreshHRP()
	if not hrp then
		return nil
	end

	local best, bestDist = nil, math.huge
	for _, part in ipairs(workspace:GetDescendants()) do
		if part:IsA("BasePart") and string.lower(part.Name) == "water" then
			local dist = (part.Position - hrp.Position).Magnitude
			if dist <= 250 and dist < bestDist then
				best = part
				bestDist = dist
			end
		end
	end
	return best
end

-- Unloads the truck into the inventory if it is nearly full. Same guard
-- as CollectOnce for the garage auto farm -- reused as is.
local function AUTOFISH_MaybeUnloadTruck()
	local truck = GetPlayerTruck()
	if truck and not HasCargoRoom(truck) then
		DebugPrint("[AutoFish] Truck almost full, unloading")
		UnloadCargo()
	end
end

-- TP to the plot, place everything placeable, then return to the
-- starting water part. Reuses PlaceItems as is (same filters, same slot
-- logic as the garage AutoPlace).
-- The reference Pond for AutoFish: near the Mall's Fisherman NPC. Used
-- both as the return point after placement and for the TP button.
local function GetFishingPond()
	local mall = workspace:FindFirstChild("Mall - Shop NPCs")
	local questNpc = mall and mall:FindFirstChild("Quest NPC")
	local fisherman = questNpc and questNpc:FindFirstChild("Fisherman")
	if not fisherman then
		warn("[AutoFish] workspace[\"Mall - Shop NPCs\"][\"Quest NPC\"].Fisherman not found")
		return nil
	end
	return fisherman
end

local function AUTOFISH_RunPlacingPhase()
	-- We go through the vehicle first (like the garage Master Cycle): the
	-- catches land in the cargo, not directly in the inventory, so there is
	-- nothing to place until the truck is emptied. Unconditional here
	-- (unlike AUTOFISH_MaybeUnloadTruck which only unloads if nearly full)
	-- since we are heading to the base anyway.
	UnloadCargo()

	local plot = GetPlayerPlot()
	if not plot then
		warn("[AutoFish] Plot not found, placement skipped")
		return
	end

	local anchor = GetPlotFurnitureAnchor(plot)
	if not anchor then
		warn("[AutoFish] No Furniture anchor found, placement skipped")
		return
	end

	local pond = GetFishingPond()

	TeleportPlayerOnly(anchor)
	task.wait(0.6)

	-- Safeguard: if the garage AutoFarm is also running (FARM.active), IT
	-- owns the placement/plot TP -- we do not collide with the Master
	-- Cycle's RunPlacingPhase on the same plot.
	local notReadyDeadline = nil
	while not FARM.active and AUTOFISH.active do
		local placed, remaining = PlaceItems()
		if placed > 0 then
			notReadyDeadline = nil
			task.wait(0.3)
		elseif remaining == nil then
			-- Plot/slots not ready yet (streaming), not "finished".
			if not notReadyDeadline then
				notReadyDeadline = os.clock() + 15
			end
			if os.clock() > notReadyDeadline then
				warn("[AutoFish] Plot/shelf slots still not ready after 15s, giving up on this placement pass")
				break
			end
			task.wait(1)
		else
			break
		end
	end

	if pond and pond.Parent then
		TeleportPlayerOnly(pond)
		task.wait(0.5)
	elseif AUTOFISH.water and AUTOFISH.water.Parent then
		-- Safety net if the Pond was not found: at least return to the
		-- starting water part rather than staying at the plot.
		TeleportPlayerOnly(AUTOFISH.water)
		task.wait(0.5)
	end
end

local function RunAutoFishLoop()
	if LOOPGUARDS.autoFish then
		return
	end
	LOOPGUARDS.autoFish = true

	task.spawn(function()
		AUTOFISH.water = FindNearbyWater()
		if not AUTOFISH.water then
			warn("[AutoFish] No water part found within 250 studs, stopping")
			AUTOFISH.active = false
			LOOPGUARDS.autoFish = false
			return
		end

		if not EnsureUsableFishingRod() then
			warn("[AutoFish] No usable (non-broken) fishing rod found, stopping")
			AUTOFISH.active = false
			LOOPGUARDS.autoFish = false
			return
		end

		while AUTOFISH.active and LOOPGUARDS.autoFish do
			if not EnsureUsableFishingRod() then
				warn("[AutoFish] Rod broken and no replacement available, waiting for one...")
				while AUTOFISH.active and not EnsureUsableFishingRod() do
					task.wait(1)
				end
				if not AUTOFISH.active then
					break
				end
				DebugPrint("[AutoFish] Usable rod found, resuming")
			end

			AUTOFISH_MaybeUnloadTruck()

			local reelSeen = false
			local doneData = nil

			local conn
			conn = REMOTES.FishingState.OnClientEvent:Connect(function(phase, data)
				if phase == "reel" and not reelSeen then
					reelSeen = true
				elseif phase == "done" then
					doneData = data or {}
				end
			end)

			local castOk, castErr = pcall(function()
				REMOTES.FishingCast:FireServer(AUTOFISH.water, AUTOFISH.water.Position)
			end)
			if not castOk then
				warn("[AutoFish] FishingCast failed: " .. tostring(castErr))
				conn:Disconnect()
				break
			end

			local waited = 0
			while AUTOFISH.active and not reelSeen and not doneData and waited < 10 do
				task.wait(0.1)
				waited = waited + 0.1
			end

			if reelSeen and not doneData then
				local w = 0
				while AUTOFISH.active and w < AUTOFISH.waitBeforeFire and not doneData do
					task.wait(0.1)
					w = w + 0.1
				end

				if not doneData and AUTOFISH.active then
					local fireOk, fireErr = pcall(function()
						REMOTES.FishingResult:FireServer("caught")
					end)
					if not fireOk then
						warn("[AutoFish] FishingResult failed: " .. tostring(fireErr))
					end

					local w2 = 0
					while not doneData and w2 < 5 do
						task.wait(0.1)
						w2 = w2 + 0.1
					end
				end
			end

			conn:Disconnect()

			if doneData and doneData.reason == "caught" then
				AUTOFISH.catchesSinceLastPlace = AUTOFISH.catchesSinceLastPlace + 1
			end

			-- Periodic placement (like placeEveryNContainers for the
			-- garages) OR forced if the inventory is nearly full.
			-- DISABLED for now: we just want to fish, nothing else.
			if AUTOFISH.active and AUTOFISH.placeEnabled then
				local reachedThreshold = AUTOFISH.catchesSinceLastPlace >= AUTOFISH.placeEveryN
				local invForced = IsInventoryNearFull(0.90)
				if reachedThreshold or invForced then
					DebugPrint("[AutoFish] Placement phase (threshold=" .. tostring(reachedThreshold) .. " forced=" .. tostring(invForced) .. ")")
					AUTOFISH_RunPlacingPhase()
					AUTOFISH.catchesSinceLastPlace = 0
				end
			end

			task.wait(0.5)
		end

		LOOPGUARDS.autoFish = false
	end)
end

