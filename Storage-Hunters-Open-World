-- RayVoid collapses any multi-select with more than one option checked to
-- the word "Various", so the Garage Types dropdown never shows what is
-- actually selected. That string comes from the vendored UI library, which
-- this project treats as read-only, so the dropdown is left alone and this
-- line underneath reports the real selection instead.
--
-- Defined before the dropdown because RayVoid fires the callback while
-- restoring a saved config, i.e. during CreateDropdown itself.
FARM.knownTypes = {}
for _, garageName in ipairs(FARM_GARAGE_TYPE_OPTIONS) do
	FARM.knownTypes[garageName] = true
end

-- Writes a pruned selection back into the dropdown. :Set re-fires the
-- callback with the clean list (no stale entries, so no second prune) and
-- replaces CurrentOption, which is what a slot save serialises. If the
-- restore fires before CreateDropdown has returned the handle, park the
-- list and let the catch-up right after the dropdown apply it.
function FARM.PushCleanTypes(kept)
	if FARM.typesDropdown and FARM.typesDropdown.Set then
		FARM.typesDropdown:Set(kept)
	else
		FARM.pendingCleanTypes = kept
	end
end

function FARM.RefreshTypesSummary()
	if not FARM.typesParagraph then
		-- Called from the callback during CreateDropdown, before the
		-- paragraph exists. The explicit call after creating it catches up.
		return
	end

	local names = {}
	for garageName in pairs(FARM.selectedTypes) do
		table.insert(names, garageName)
	end
	table.sort(names)

	if #names == 0 then
		FARM.typesParagraph:Set({
			Title = "Checked: none",
			Content = "No garage type is selected, so Auto Farm has nothing to enter.",
		})
	else
		FARM.typesParagraph:Set({
			Title = "Checked: " .. #names,
			Content = table.concat(names, ", "),
		})
	end
end

