-- REAL confirmation of a placement, by requestId (GUID generated at
-- FireServer time). Confirmed by reading the real game script
-- (ShelfInteraction, docId 113 via the `real` MCP, 2026-08-25): the server
-- replies through this event with (requestId, success). PlaceItems() waits
-- for that reply instead of guessing via an inventory count diff before/
-- after a fixed delay -- the old method could get it wrong under latency
-- (delay too short = wrongly "server refused") or conversely miss a real
-- failure if the count had changed for another reason meanwhile.
local pendingPlaceRequests = {}

SESSION.Track(REMOTES.PlaceStockItemResult.OnClientEvent:Connect(function(requestId, success)
	if typeof(requestId) ~= "string" then
		return
	end
	local now = os.clock()
	pendingPlaceRequests[requestId] = { ok = (success == true), at = now }

	-- PlaceItems clears only the entries it actually waited for, so a
	-- confirmation arriving after its 3s window -- or one for a request whose
	-- FireServer failed before any wait began -- would sit here on a fresh
	-- GUID key forever. A night of farming is thousands of placements, so that
	-- is an unbounded table on a client that never restarts. Swept on write,
	-- the same shape MakeSlotMachine already uses for failedGuids. 10s is well
	-- past the 3s anyone waits, so this can never drop a live answer.
	for id, record in pairs(pendingPlaceRequests) do
		if (now - record.at) > 10 then
			pendingPlaceRequests[id] = nil
		end
	end
end))

