-- Everything the game says about the collection, so the missing names are
-- known instead of guessed. Shapes not measured: dumped in full, and any
-- name paired with a false / "not found" flag is listed as missing.
function LOSTITEMS.Dump(v, indent, depth, out)
	if type(v) ~= "table" or depth > 6 then
		table.insert(out, indent .. tostring(v))
		return
	end
	for k, x in pairs(v) do
		if type(x) == "table" then
			table.insert(out, indent .. tostring(k) .. " = {")
			LOSTITEMS.Dump(x, indent .. "  ", depth + 1, out)
			table.insert(out, indent .. "}")
		else
			table.insert(out, indent .. tostring(k) .. " = " .. tostring(x))
		end
	end
end

function LOSTITEMS.Report()
	local have, missing = {}, {}
	local function scan(t, depth)
		if type(t) ~= "table" or depth > 6 then
			return
		end
		local name = t.Name or t.name or t.ItemName or t.itemName
		if type(name) == "string" then
			local found = t.Found or t.found or t.Collected or t.collected or t.Claimed or t.claimed or t.Owned or t.owned
			if found == false then
				missing[name] = true
			elseif found then
				have[name] = true
			end
		end
		for k, x in pairs(t) do
			if type(k) == "string" and type(x) == "boolean" then
				if x then
					have[k] = true
				else
					missing[k] = true
				end
			elseif type(x) == "table" then
				scan(x, depth + 1)
			end
		end
	end
	print("===== LOST ITEMS REPORT =====")
	for _, remote in ipairs({ "GetLostItems", "LostItemsStatus" }) do
		local ok, res = LOSTITEMS.Remote(remote)
		local lines = {}
		LOSTITEMS.Dump(ok and res or ("error " .. tostring(res)), "  ", 0, lines)
		print(remote .. ":\n" .. table.concat(lines, "\n"))
		if ok then
			scan(res, 0)
		end
	end
	-- Guide names the game did not say we have, and we did not take.
	for _, name in ipairs(LOSTITEMS.GUIDE) do
		if not have[name] and not LOSTITEMS.taken[name] and next(have) ~= nil then
			missing[name] = true
		end
	end
	local list = {}
	local guideSet = {}
	for _, name in ipairs(LOSTITEMS.GUIDE) do
		guideSet[name] = true
	end
	for name in pairs(missing) do
		-- Only real item names, not flags like "success" / "unlocked".
		local isItem = guideSet[name] or TRAINQUEST.IdForName(name) ~= nil
		if isItem and not have[name] and not LOSTITEMS.taken[name] then
			local where = LOSTITEMS.known[name] and (" (seen at " .. tostring(LOSTITEMS.known[name]) .. ")") or ""
			table.insert(list, name .. where)
		end
	end
	table.sort(list)
	print("Missing (" .. #list .. "): " .. (#list > 0 and table.concat(list, ", ") or "none the game reported"))
	print("===== END =====")
	LOSTITEMS.status = "Missing (" .. #list .. "): " .. (#list > 0 and table.concat(list, ", ") or "see console")
	return list
end

