-- PLOT DETECTION
local function GetPlayerPlot()
	local plotsFolder = workspace:FindFirstChild("_Plots")
	if not plotsFolder then
		warn("[Plot] workspace._Plots not found")
		return nil
	end
	for _, plot in ipairs(plotsFolder:GetChildren()) do
		local ownerId = plot:GetAttribute("OwnerUserId")
		if ownerId and ownerId == LocalPlayer.UserId then
			return plot
		end
	end
	return nil
end

-- POSITION & TELEPORT HELPERS
local function GetPlayerTruck()
	for _, obj in ipairs(workspace:GetChildren()) do
		local ownerId = obj:GetAttribute("OwnerUserId")
		if ownerId and ownerId == LocalPlayer.UserId then
			if obj:GetAttribute("CargoWeight") ~= nil and obj:GetAttribute("CarPartAccelMult") ~= nil then
				return obj
			end
		end
	end
	return nil
end

local function GetSeatedVehicle()
	local character = LocalPlayer.Character
	if not character then return nil end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not (humanoid and humanoid.SeatPart) then return nil end

	local seat = humanoid.SeatPart
	if not seat:IsA("VehicleSeat") then return nil end

	local truck = GetPlayerTruck()
	if truck and seat:IsDescendantOf(truck) then
		return truck
	end

	return nil
end

local function ResolvePosition(instance)
	if not instance then
		return nil
	end

	-- A caller that already has the position. Not a fallback -- an identity.
	-- Added after Auto Quest handed this a Vector3 and every tour
	-- died on "IsA is not a valid member of Vector3", which is a whole class
	-- of bug this one branch closes for every call site.
	if typeof(instance) == "Vector3" then
		return instance
	end

	if instance:IsA("BasePart") then
		return instance.Position
	end

	if instance:IsA("Attachment") then
		return instance.WorldPosition
	end

	if instance:IsA("Model") then
		local ok, pivot = pcall(function()
			return instance:GetPivot()
		end)
		if ok then
			return pivot.Position
		end
	end

	-- Fallback: look for a BasePart or an Attachment anywhere in the descendants
	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("BasePart") then
			return descendant.Position
		end
	end
	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("Attachment") then
			return descendant.WorldPosition
		end
	end

	return nil
end

-- Remembered world positions for teleport targets. Every target here is
-- static world geometry -- area landmarks, shop pads, your own plot's
-- parking space -- so a position, once seen, stays correct for the session
-- and can be used when the object itself is no longer loaded.
--
-- This is what TP-FAR actually needed. The probe killed the
-- original "streaming breaks distant lookups" theory for the seven area
-- buttons: all seven resolved from 5015 studs away, so they were never
-- broken. Two real failures remained, and remembering fixes both:
--   * TP base -- workspace.UnpackZone does not exist at all, in either probe
--     run from either position. So TP base has ALWAYS run on its fallback
--     (your plot -> Furniture -> Parking Space), and that fallback is
--     plot-local, which is what streaming unloads at distance. It matches the
--     report exactly: hop to Back Alley first and TP base then works.
--   * CarGarage -- a genuine streaming failure. Its VehiclePad resolved at
--     394 studs and was gone at ~1000.
local TPCACHE = {
	positions = {},
}

function TPCACHE.ToPosition(position)
	local targetCFrame = CFrame.new(position + Vector3.new(0, 5, 0))
	local vehicle = GetSeatedVehicle()

	if vehicle then
		local primary = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
		if not primary then
			warn("[TP] No BasePart found in the vehicle")
			return false
		end

		if vehicle.PrimaryPart then
			vehicle:SetPrimaryPartCFrame(targetCFrame)
		else
			primary.CFrame = targetCFrame
		end
	else
		SafeSetHRPCFrame(targetCFrame)
	end

	return true
end

-- Live lookup first, remembered position second. Returns position, source.
function TPCACHE.Resolve(key, findTarget)
	local ok, target = pcall(findTarget)
	local position = nil
	if ok and target then
		position = ResolvePosition(target)
	end

	if position then
		TPCACHE.positions[key] = position
		return position, "live"
	end

	local remembered = TPCACHE.positions[key]
	if remembered then
		return remembered, "remembered"
	end

	return nil, nil
end

-- The one entry point for every teleport button. A target that cannot be
-- found AND has never been seen is a real failure and says so out loud, with
-- the way out -- it used to be a silent no-op, which is what "the tp button
-- does not work" looked like from the outside.
-- Optional 4th arg: a fallback function (e.g. a GPS POI lookup) tried before
-- giving up, for targets that also have a remote position available.
function TPCACHE.Go(key, label, findTarget, fallbackFn)
	local position, source = TPCACHE.Resolve(key, findTarget)

	if not position and fallbackFn then
		local ok, fbPosition = pcall(fallbackFn)
		if ok and fbPosition then
			position = fbPosition
			source = "fallback"
		end
	end

	if not position then
		warn("[TP] " .. label .. ": not loaded right now and never seen this session, so there is no " ..
			"position to go to. Teleport to a nearby area first, then try this again.")
		return false
	end

	if source == "remembered" then
		DebugPrint("[TP] " .. label .. " is not loaded right now, using the position remembered from earlier")
	end

	return TPCACHE.ToPosition(position)
end

-- All GPS POIs (every category), name -> position, one remote round trip.
-- Kept separate from TPCACHE.ShopPOI's own lookup above (untouched -- that
-- one is farm-critical and already measured/verified): this cache only
-- backs the Teleport tab's own buttons.
function TPCACHE.LoadAllPOIs()
	if TPCACHE.allPois then
		return
	end
	TPCACHE.allPois = {}
	local gps = Events:FindFirstChild("GPS")
	local getPOIs = gps and gps:FindFirstChild("GetPOIs")
	if not getPOIs then
		return
	end
	local ok, data = pcall(function()
		return getPOIs:InvokeServer()
	end)
	if ok and type(data) == "table" and type(data.pois) == "table" then
		for _, poi in ipairs(data.pois) do
			if type(poi.name) == "string" and typeof(poi.position) == "Vector3" then
				TPCACHE.allPois[poi.name] = poi.position
			end
		end
	end
end

-- Teleport straight to a named GPS POI (any category). Works from any
-- distance, same reasoning as ShopPOI above. Warns honestly if the name
-- is not currently in GPS (an event-only area whose event is not running).
function TPCACHE.GoToPOI(name, label)
	TPCACHE.LoadAllPOIs()
	local position = TPCACHE.allPois and TPCACHE.allPois[name]
	if not position then
		warn("[TP] " .. (label or name) .. ": not in GPS right now (event not active, or the name changed)")
		return false
	end
	return TPCACHE.ToPosition(position)
end

-- Fallback function for TPCACHE.Go: resolve a GPS POI by name, for a
-- workspace-path target that also has a remote position available.
function TPCACHE.POIFallback(name)
	return function()
		TPCACHE.LoadAllPOIs()
		local position = TPCACHE.allPois and TPCACHE.allPois[name]
		-- Business Bay's POI is underground (see TPCACHE.Unburied).
		if position then
			position = TPCACHE.Unburied(position)
		end
		return position
	end
end

-- Your own shop's position, straight from the game's GPS. This is a REMOTE,
-- so unlike every piece of plot geometry it answers from ANY distance -- which
-- is what makes it the last resort for "go home" when nothing is loaded and
-- nothing was remembered.
--
-- That case is far more common than it sounds: TPCACHE only seeds "base" if
-- the player was standing on their plot 5s after load, and a script reloaded
-- mid-farm (every SH-dev click) is not. That is the whole of "TP base does
-- nothing from Farmyard" -- reported.
function TPCACHE.ShopPOI()
	if TPCACHE.positions["shopPOI"] then
		return TPCACHE.positions["shopPOI"]
	end

	local gps = Events:FindFirstChild("GPS")
	local getPOIs = gps and gps:FindFirstChild("GetPOIs")
	if not getPOIs then
		return nil
	end

	local ok, data = pcall(function()
		return getPOIs:InvokeServer()
	end)
	if ok and type(data) == "table" and type(data.pois) == "table" then
		for _, poi in ipairs(data.pois) do
			if poi.category == "Player Shop" and typeof(poi.position) == "Vector3"
				and type(poi.name) == "string" and string.find(poi.name, LocalPlayer.Name, 1, true) then
				TPCACHE.positions["shopPOI"] = poi.position
				return poi.position
			end
		end
	end

	return nil
end

local function TeleportTo(target)
	local position = ResolvePosition(target)
	if not position then
		warn("[TP] Could not resolve a position for the target")
		return
	end

	TPCACHE.ToPosition(position)
end

-- Teleports only the player, never the vehicle: if seated, we get off
-- cleanly first (same wait logic as UnloadCargo) and the truck stays
-- where it was.
local function TeleportPlayerOnly(target)
	local position = ResolvePosition(target)
	if not position then
		warn("[TP] Could not resolve a position for the target")
		return
	end

	local vehicle = GetSeatedVehicle()
	if vehicle then
		local character = LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Sit = false

			local waited = 0
			while (humanoid.SeatPart ~= nil or humanoid:GetState() == Enum.HumanoidStateType.Seated) and waited < 2 do
				task.wait(0.1)
				waited = waited + 0.1
			end
			task.wait(0.3)
		end
	end

	SafeSetHRPCFrame(CFrame.new(position + Vector3.new(0, 5, 0)))
end

-- WHERE A CHARACTER CAN STAND. Neither the spots this script works out (N
-- studs off a target) nor the positions the game hands out are always open
-- ground, and a teleport into solid geometry leaves the player stuck inside
-- it. Both measured at Business Bay: 52 of 960 points on a
-- 50-stud ring around roaming outlaws were inside solid buildings
-- (Areas.Business Bay.Parts), and the area's own GPS POI sits at Y 1708.8,
-- 11 studs under the road, inside the 25-stud-thick grassbase slab.
--
-- Our own character, roaming outlaws and bodies on the ground are ignored:
-- none of them can trap anyone, and an outlaw's own feet are the last
-- resort when nothing near it is open.
function TPCACHE.GeometryParams()
	local ignore = { LocalPlayer.Character }
	for _, name in ipairs({ "_Outlaws", "_Carryables" }) do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(ignore, folder)
		end
	end
	local rays = RaycastParams.new()
	rays.FilterType = Enum.RaycastFilterType.Exclude
	rays.FilterDescendantsInstances = ignore
	rays.RespectCanCollide = true
	local box = OverlapParams.new()
	box.FilterType = Enum.RaycastFilterType.Exclude
	box.FilterDescendantsInstances = ignore
	box.RespectCanCollide = true
	return rays, box
end

-- True when a character standing on `ground` would be inside something solid.
-- The box starts 1.5 studs up so the floor itself and a kerb do not count.
function TPCACHE.Blocked(ground, box)
	if not box then
		local _
		_, box = TPCACHE.GeometryParams()
	end
	return #workspace:GetPartBoundsInBox(CFrame.new(ground + Vector3.new(0, 3.5, 0)), Vector3.new(3, 4, 3), box) > 0
end

-- The ground under `spot` when a character can stand there, else nil. The ray
-- starts above the spot: one that starts inside a solid block does not see
-- that block, so it finds the floor under it and Blocked then catches it.
function TPCACHE.OpenGround(spot)
	local rays, box = TPCACHE.GeometryParams()
	local floor = workspace:Raycast(spot + Vector3.new(0, 4, 0), Vector3.new(0, -24, 0), rays)
	if not floor or TPCACHE.Blocked(floor.Position, box) then
		return nil
	end
	return floor.Position
end

-- LocalPlayer:RequestStreamAroundAsync answers about 255 times per session and
-- then never again, for EVERY caller -- the game's own included, and the
-- timeout it is given does not stop the wait. Measured, right after
-- a rejoin: 252 back-to-back calls came back in 0.05 s each and the 253rd never
-- returned (a DevForum thread reports 255 as well); a rejoin gives the whole
-- budget back. The game's horse race asks once per race, so a script that
-- spends the budget cancels every race -- "The start area didn't load in time"
-- -- until the client rejoins. This script used to ask on every 1 s retry of an
-- outlaw too far away to measure -- the likely spender (inferred: nothing was
-- counted at the time, and the first wedge came 2-3 hours into a session, the
-- second within minutes of a rejoin). So it may spend STREAM_BUDGET per
-- session, counted in getgenv() so a script reload does not restart the count,
-- and only where nothing else does the job (Unburied; a far outlaw is landed
-- on by UnloadedFeet instead). Returns answered, and a second true when it
-- refused to ask at all.
--
-- The same call also froze the two threads that made it (an outlaw sweep, Auto
-- Farm held off for 2.4 hours; the Master Cycle, dead until a reload). A pcall
-- cannot save a call that never comes back, so it is asked from its own thread
-- and the caller waits on a clock instead. A request that never answers stays
-- parked; once STREAM_MAX_PARKED of them are, the game is not answering at all
-- and nothing more is asked until one comes back.
TPCACHE.STREAM_BUDGET = 30
TPCACHE.STREAM_MAX_PARKED = 3
TPCACHE.streamParked = 0
function TPCACHE.StreamAround(position, seconds)
	local env = ENV or TPCACHE
	if (env.SHStreamCalls or 0) >= TPCACHE.STREAM_BUDGET then
		if not TPCACHE.streamBudgetWarned then
			TPCACHE.streamBudgetWarned = true
			warn("[TP] Used all " .. TPCACHE.STREAM_BUDGET .. " of the streaming requests this script may make per session -- Roblox stops answering them after about 255 in total and the horse race needs its share. Not asking for more (teleports still work, far areas just take a moment longer to load)")
		end
		return false, true
	end
	if TPCACHE.streamParked >= TPCACHE.STREAM_MAX_PARKED then
		if not TPCACHE.streamCapWarned then
			TPCACHE.streamCapWarned = true
			warn("[TP] " .. TPCACHE.STREAM_MAX_PARKED .. " streaming requests have gone unanswered -- not asking for more until one comes back (teleports still work, far areas just take a moment longer to load). Horse races are cancelled by the game in this state until you rejoin")
		end
		return false, true
	end
	env.SHStreamCalls = (env.SHStreamCalls or 0) + 1
	local answered = false
	TPCACHE.streamParked = TPCACHE.streamParked + 1
	task.spawn(function()
		pcall(function()
			LocalPlayer:RequestStreamAroundAsync(position, seconds)
		end)
		answered = true
		TPCACHE.streamParked = TPCACHE.streamParked - 1
		TPCACHE.streamCapWarned = false
	end)
	local deadline = os.clock() + seconds + 1
	while not answered and os.clock() < deadline and SESSION.alive do
		task.wait(0.05)
	end
	if answered then
		TPCACHE.streamWarned = false
	elseif SESSION.alive and not TPCACHE.streamWarned then
		TPCACHE.streamWarned = true
		warn("[TP] The game did not answer a streaming request within " .. (seconds + 1) .. " s -- carrying on without it (teleports still work, far areas just take a moment longer to load)")
	end
	return answered
end

-- `position` when a character fits there, otherwise the first surface coming
-- down from 60 studs above it. For a destination the GAME supplies, which
-- can be buried (the Business Bay POI above). Returns `position` unchanged
-- when nothing is found, so it can lift a teleport but never lose one.
--
-- Yields up to ~2.5s when the spot is far away. Streaming is on (radius
-- 1024), so from across the map there is nothing there to check against and
-- every spot looks open -- which is exactly when the Farm uses this, coming
-- back from the Sheriff after an outlaw sweep. RequestStreamAroundAsync
-- returns before the parts arrive: measured, the Power Plant
-- ground was still missing straight after it and present 0.5s later.
--
-- Even that wait can lose the race: seen, from 5000 studs
-- away the road over the Business Bay POI streamed in before the grassbase
-- slab around it, and the POI passed. So a lift, once measured, is kept for
-- the session (the map does not move), and the Farm re-checks on arrival
-- with TPCACHE.LiftIfBuried. "A roof overhead and no floor below" is NOT a
-- usable test from afar: tried the same day, far away floors arrive after
-- roofs, and it would have put Club and Warehouse visits on their roofs.
-- Both live in getgenv() so a script reload keeps what was measured: the map
-- does not move, and every reload asking again would spend the streaming
-- budget (see StreamAround) on answers already known.
TPCACHE.lifts = (ENV and ENV.SHLifts) or {}
-- Positions LiftIfBuried found open while standing on them, with the ground
-- streamed in around them: a check from afar is skipped for those.
TPCACHE.clean = (ENV and ENV.SHClean) or {}
if ENV then
	ENV.SHLifts = TPCACHE.lifts
	ENV.SHClean = TPCACHE.clean
end
function TPCACHE.Unburied(position)
	local key = tostring(position)
	if TPCACHE.lifts[key] then
		return TPCACHE.lifts[key]
	end
	local rays, box = TPCACHE.GeometryParams()
	local hrp = GetFreshHRP()
	if not hrp or (hrp.Position - position).Magnitude > 700 then
		if TPCACHE.clean[key] then
			return position
		end
		local _, refused = TPCACHE.StreamAround(position, 2)
		if refused then
			-- Nothing was asked, so nothing will stream in to wait for.
			return position
		end
		local deadline = os.clock() + 2
		while not workspace:Raycast(position + Vector3.new(0, 60, 0), Vector3.new(0, -120, 0), rays)
			and os.clock() < deadline do
			task.wait(0.1)
		end
		-- The first part in is not necessarily all of them.
		task.wait(0.3)
	end
	if not TPCACHE.Blocked(position, box) then
		return position
	end
	local top = workspace:Raycast(position + Vector3.new(0, 60, 0), Vector3.new(0, -60, 0), rays)
	if top then
		TPCACHE.lifts[key] = top.Position
		return top.Position
	end
	return position
end

-- The on-arrival half of Unburied, for a teleport that went to `position`
-- unlifted: standing there now, everything around it is streaming in, so
-- keep checking for a moment and move the player up onto the surface the
-- instant `position` turns out to be buried. `moveTo(ground)` does the move,
-- so a caller that carries the truck along can keep doing so. Returns true
-- when it had to lift.
function TPCACHE.LiftIfBuried(position, moveTo)
	local deadline = os.clock() + 2
	repeat
		local lifted = TPCACHE.Unburied(position)
		if lifted ~= position then
			moveTo(lifted)
			return true
		end
		task.wait(0.1)
	until os.clock() > deadline
	-- Two seconds of looking from on top of it, and still open -- with ground
	-- there to look at, since a spot whose surroundings have not arrived reads
	-- open too: no need to ask the game about it from afar again.
	local hrp = GetFreshHRP()
	if hrp and (hrp.Position - position).Magnitude <= 700 then
		local rays = TPCACHE.GeometryParams()
		if workspace:Raycast(position + Vector3.new(0, 60, 0), Vector3.new(0, -120, 0), rays) then
			TPCACHE.clean[tostring(position)] = true
		end
	end
	return false
end

-- Teleport next to something and make sure it STAYS that way. A position
-- write can be undone a moment later: measured, a teleport made
-- the instant the player left the seat of the just-recalled truck was pulled
-- back to where they stood within 0.12s, while the same teleport 0.5s, 1.5s
-- or 3s later held. The quest tour runs right after the truck recall, so the
-- Mayor refused all 8 prompts, fired from 1200 studs away, after a one-frame
-- reach check had already said "in reach". So: arrive, then require the
-- player to stay in reach for ARRIVE_HOLD, and teleport again if pulled away.
-- A check rather than a fixed pause, because three held trials do not prove
-- what the window is. `target` is an Instance; returns true once it held.
-- `holdSeconds` overrides ARRIVE_HOLD for a caller that knows no seat was
-- just left (the pull-back was only ever seen right after one).
TPCACHE.ARRIVE_TRIES = 4
TPCACHE.ARRIVE_HOLD = 0.5
function TPCACHE.ArriveNear(target, reach, holdSeconds)
	local function inReach()
		local hrp = GetFreshHRP()
		local pos = nil
		pcall(function()
			pos = target.Position
		end)
		return hrp ~= nil and pos ~= nil and (hrp.Position - pos).Magnitude <= reach
	end
	for attempt = 1, TPCACHE.ARRIVE_TRIES do
		TeleportPlayerOnly(target)
		local deadline = os.clock() + 2
		while os.clock() < deadline and not inReach() do
			task.wait(0.05)
		end
		if inReach() then
			local holdUntil = os.clock() + (holdSeconds or TPCACHE.ARRIVE_HOLD)
			local held = true
			while os.clock() < holdUntil do
				if not inReach() then
					held = false
					break
				end
				task.wait(0.05)
			end
			if held then
				if attempt > 1 then
					DebugPrint("[TP] Arrived and stayed on attempt " .. attempt)
				end
				return true
			end
		end
		DebugPrint("[TP] Pulled away from the target after arriving, teleporting again ("
			.. attempt .. "/" .. TPCACHE.ARRIVE_TRIES .. ")")
		task.wait(0.2)
	end
	return false
end

