-- ONE BOX PER RULE, not one box holding all eight. Eight long sentences in a
-- single paragraph was a wall the user could not scan (2026-09-12); the box
-- borders are what the eye lands on. The boxes for untouched rules are hidden
-- rather than filled with "empty", so the tab only ever shows what is real.
--
-- Built upfront, because RayVoid has no way to add an element later -- the
-- hiding is the same page-child trick the exclusion lists and the save slots
-- use. If the page lookup ever fails, all eight simply stay visible.
RULES.summaryRows = {}

RULES.emptyNoteBefore = {}
if RULES.page then
	for _, child in ipairs(RULES.page:GetChildren()) do
		RULES.emptyNoteBefore[child] = true
	end
end
RULES.emptyNote = ItemRulesTab:CreateParagraph({
	Title = "Rules in force",
	Content = "No rules set. Every tab's own filters are deciding, exactly as before." .. "\n" .. "Open the editor above to make one.",
})
RULES.emptyNoteInstances = {}
if RULES.page then
	for _, child in ipairs(RULES.page:GetChildren()) do
		if not RULES.emptyNoteBefore[child] then
			table.insert(RULES.emptyNoteInstances, child)
		end
	end
end

for ruleIndex = 1, RULES.COUNT do
	local before = {}
	if RULES.page then
		for _, child in ipairs(RULES.page:GetChildren()) do
			before[child] = true
		end
	end
	local row = ItemRulesTab:CreateParagraph({
		Title = "Rule " .. ruleIndex,
		Content = "",
	})
	local instances = {}
	if RULES.page then
		for _, child in ipairs(RULES.page:GetChildren()) do
			if not before[child] then
				table.insert(instances, child)
			end
		end
	end
	RULES.summaryRows[ruleIndex] = { paragraph = row, instances = instances }
end

function RULES.RefreshSummary()
	local shown = 0
	for i = 1, RULES.COUNT do
		local rule = RULES.rules[i]
		local touched = RULES.AnySet(rule.effects) or RULES.RuleHasCriteria(rule)
		local row = RULES.summaryRows[i]
		if row then
			if touched then
				shown = shown + 1
				local title, matches, does = RULES.DescribeShort(i)
				if row.paragraph and row.paragraph.Set then
					pcall(function()
						row.paragraph:Set({ Title = title, Content = matches .. "\n" .. does })
					end)
				end
			end
			for _, instance in ipairs(row.instances) do
				pcall(function()
					instance.Visible = touched
				end)
			end
		end
	end
	-- The "nothing set" note is the only thing shown when nothing is.
	for _, instance in ipairs(RULES.emptyNoteInstances) do
		pcall(function()
			instance.Visible = (shown == 0)
		end)
	end
end

