	RULES.ED.Close()

	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "ItemRulesEditor"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 60
	screenGui.Parent = playerGui
	RULES.ED.gui = screenGui

	local main = Instance.new("Frame")
	main.AnchorPoint = Vector2.new(0.5, 0.5)
	main.Position = UDim2.fromScale(0.5, 0.5)
	main.Size = UDim2.fromOffset(880, 560)
	main.BackgroundColor3 = RULES.ED.BG
	main.BorderSizePixel = 0
	main.ClipsDescendants = true
	main.Parent = screenGui
	RULES.ED.main = main
	RULES.ED.Corner(main, 10)

	local titleBar = Instance.new("Frame")
	titleBar.Size = UDim2.new(1, 0, 0, 40)
	titleBar.BackgroundColor3 = RULES.ED.BAR
	titleBar.BorderSizePixel = 0
	titleBar.Parent = main

	RULES.ED.Label(titleBar, "Item Rules", UDim2.new(1, -54, 1, 0), UDim2.fromOffset(14, 0),
		{ bold = true, textSize = 16 })
	RULES.ED.Button(titleBar, "X", UDim2.fromOffset(28, 28), UDim2.new(1, -36, 0, 6), {
		bg = Color3.fromRGB(60, 20, 20), color = Color3.fromRGB(255, 200, 200), bold = true,
		onClick = RULES.ED.Close,
	})

	-- Same drag pattern as the predictions window: mouse and touch.
	do
		local dragging = false
		local dragInputPos = nil
		local windowStartPos = nil
