-- Whatever a remote hands back as "where": Vector3, CFrame, an Instance, or a
-- table carrying one of those. Shapes of GetCargoTrainNavTarget were not
-- measured, so every plausible one is accepted.
function TPCACHE.AnyToPosition(v, depth)
	depth = depth or 0
	if v == nil or depth > 2 then
		return nil
	end
	local t = typeof(v)
	if t == "Vector3" then
		return v
	elseif t == "CFrame" then
		return v.Position
	elseif t == "Instance" then
		local ok, pos = pcall(ResolvePosition, v)
		return ok and pos or nil
	elseif t == "table" then
		for _, k in ipairs({ "position", "Position", "target", "Target", "pos", "cframe", "CFrame", "instance", "part" }) do
			local pos = TPCACHE.AnyToPosition(v[k], depth + 1)
			if pos then
				return pos
			end
		end
	end
	return nil
end

-- GPS POI by case-insensitive substring, for names we have not measured
-- ("Time Capsule" vs "TimeCapsule" vs "Time Capsule Shop").
function TPCACHE.FindPOIMatch(fragment)
	TPCACHE.LoadAllPOIs()
	if not TPCACHE.allPois then
		return nil
	end
	fragment = string.lower(fragment)
	for name, pos in pairs(TPCACHE.allPois) do
		local squashed = string.lower(string.gsub(tostring(name), "%s", ""))
		-- Never someone's shop just because their name contains the word.
		if (TPCACHE.poiCategory or {})[name] ~= "Player Shop" and string.find(squashed, fragment, 1, true) then
			return pos
		end
	end
	return nil
end

-- A spot a few studs IN FRONT of an object, at its base, instead of its
-- centre: landing on its centre put you inside or on top of it, out of reach
-- of its prompt. "Front" = the object's LookVector; ToPosition adds the
-- usual +5 Y so you drop onto the ground there.
function TPCACHE.NearInstance(inst, gap)
	gap = gap or 4
	local cf, size
	local ok = pcall(function()
		if inst:IsA("Model") then
			cf, size = inst:GetBoundingBox()
		elseif inst:IsA("BasePart") then
			cf, size = inst.CFrame, inst.Size
		end
	end)
	if not ok or not cf then
		local pos = TPCACHE.AnyToPosition(inst)
		return pos
	end
	local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	look = look.Unit
	local reach = math.max(size.X, size.Z) / 2 + gap
	local base = cf.Position - Vector3.new(0, size.Y / 2, 0)
	return base + look * reach
end

-- The Mines (added 2026-10-13 by request; area of the Sept 27 update). Its
-- GPS entry was never measured, so: the GPS under its likely names, then any
-- GPS name with "mine" in it, then the area itself in the workspace (its
-- Lost and Found box or a Mine Bunker garage, else the area's centre).
function TPCACHE.GoMines()
	TPCACHE.LoadAllPOIs()
	local pois = TPCACHE.allPois or {}
	local gps = pois["The Mines"] or pois["Mines"] or pois["The Mine"] or pois["Mine"]
		or TPCACHE.FindPOIMatch("mine")
	if gps then
		return TPCACHE.ToPosition(gps)
	end
	return TPCACHE.Go("mines", "The Mines", function()
		local areas = workspace:FindFirstChild("Areas")
		local area
		for _, a in ipairs(areas and areas:GetChildren() or {}) do
			if string.find(string.lower(a.Name), "mine", 1, true) then
				area = a
				break
			end
		end
		local spot = area and (area:FindFirstChild("Lost and Found Box", true)
			or area:FindFirstChild("Mine Bunker", true))
		if spot then
			return TPCACHE.NearInstance(spot, 4)
		end
		local bunker = TPCACHE.FindByName("mine bunker")
		if bunker then
			return TPCACHE.NearInstance(bunker, 4)
		end
		return area and TPCACHE.AnyToPosition(area) or nil
	end)
end

-- First instance whose name contains `fragment` (case-insensitive) and that
-- passes `accept`. One-shot scan on a button press only.
function TPCACHE.FindByName(fragment, accept)
	fragment = string.lower(fragment)
	for _, d in ipairs(workspace:GetDescendants()) do
		if (d:IsA("Model") or d:IsA("BasePart"))
			and string.find(string.lower(d.Name), fragment, 1, true)
			and (not accept or accept(d)) then
			return d
		end
	end
	return nil
end

function TPCACHE.HasTrainAncestor(inst)
	local node = inst.Parent
	while node and node ~= workspace do
		local n = string.lower(node.Name)
		if string.find(n, "train", 1, true) or string.find(n, "cargo", 1, true) or string.find(n, "station", 1, true) then
			return true
		end
		node = node.Parent
	end
	return false
end

-- The train itself MOVES, so this goes to its PLATFORM (where the Train
-- Conductor and the train's Lost and Found bin stand), which does not. Found
-- by the conductor NPC, then by a Lost and Found under a train/cargo/station
-- parent, then the GPS; remembered once found. Lands in front of the
-- conductor so his prompt is in reach.
-- The Train Conductor NPC model (has a Humanoid), or nil when not streamed in.
function TPCACHE.FindConductor()
	return TPCACHE.FindByName("conductor", function(d)
		return d:IsA("Model") and d:FindFirstChildWhichIsA("Humanoid") ~= nil
	end) or TPCACHE.FindByName("conductor")
end

-- Shared by the button and the Train Conductor ticket quests. Returns true on arrival.
function TPCACHE.GoTrainPlatform()
	return TPCACHE.Go("trainPlatform", "Cargo Train platform", function()
		local npc = TPCACHE.FindConductor()
		if npc then
			return TPCACHE.NearInstance(npc, 4)
		end
		local bin = TPCACHE.FindByName("lost and found", TPCACHE.HasTrainAncestor)
		if bin then
			return TPCACHE.NearInstance(bin, 4)
		end
		return nil
	end, function()
		return TPCACHE.FindPOIMatch("conductor") or TPCACHE.FindPOIMatch("trainstation")
			or TPCACHE.FindPOIMatch("cargotrain")
	end)
end

-- Where the cargo train IS right now. It stops at different stations, so a
-- remembered platform is often the wrong one -- that is why the old button
-- only "sometimes" worked. Live sources, best first, never cached:
--   1. the game's own GPS target for the train (SpecialEvent.GetCargoTrainNavTarget)
--   2. the train model itself, if it is streamed in
-- Returns a position to land on, or nil (no train in this server right now).
function TPCACHE.CargoTrainPos()
	local se = Events:FindFirstChild("SpecialEvent")
	local nav = se and se:FindFirstChild("GetCargoTrainNavTarget")
	if nav then
		local ok, res = pcall(function()
			return nav:InvokeServer()
		end)
		if not TPCACHE.loggedTrainNav then
			TPCACHE.loggedTrainNav = true
			local shown = tostring(res)
			if type(res) == "table" then
				pcall(function()
					shown = game:GetService("HttpService"):JSONEncode(res)
				end)
			end
			print("[TP] GetCargoTrainNavTarget -> " .. (ok and shown or ("error " .. shown)))
		end
		if ok and res ~= nil then
			local pos = TPCACHE.AnyToPosition(res)
			if not pos and type(res) == "table" then
				for _, v in pairs(res) do
					pos = TPCACHE.AnyToPosition(v)
					if pos then
						break
					end
				end
			end
			if not pos and type(res) == "string" then
				pos = TPCACHE.FindPOIMatch(string.lower(string.gsub(res, "%s", "")))
			end
			if pos then
				return pos, "gps"
			end
		end
	end
	return nil
end

-- The train ITSELF, if streamed in: a model named like a train part
-- (train / locomotive / wagon / boxcar / "Train Container N" -- the auction
-- containers ride on it), never the platform, station, tracks or the
-- Conductor. Nearest to `hint` (the GPS target) when there are several.
-- Returns a spot on its roof.
TPCACHE.TRAIN_WORDS = { "cargotrain", "traincontainer", "locomotive", "wagon", "boxcar", "traincar", "train" }
TPCACHE.TRAIN_NOT = { "station", "platform", "track", "rail", "conductor", "trainer", "sign", "ticket", "npc" }
function TPCACHE.FindTrainModel(hint)
	local best, bestScore
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("Model") then
			local n = string.lower(string.gsub(d.Name, "[%s_%-]", ""))
			local hit = false
			for _, w in ipairs(TPCACHE.TRAIN_WORDS) do
				if string.find(n, w, 1, true) then
					hit = true
					break
				end
			end
			for _, w in ipairs(TPCACHE.TRAIN_NOT) do
				if hit and string.find(n, w, 1, true) then
					hit = false
				end
			end
			if hit and not d:FindFirstChildWhichIsA("Humanoid") then
				local ok, cf, size = pcall(function()
					return d:GetBoundingBox()
				end)
				if ok and size and size.Magnitude > 8 then
					local roof = cf.Position + Vector3.new(0, size.Y / 2 + 3, 0)
					-- Closer to the GPS target wins; without one, the biggest.
					local score = hint and (roof - hint).Magnitude or -size.Magnitude
					if not bestScore or score < bestScore then
						best, bestScore = roof, score
					end
				end
			end
		end
	end
	return best
end

function TPCACHE.GoCargoTrain()
	local gps = TPCACHE.CargoTrainPos()
	-- Load the area the GPS points at, so the train model streams in.
	if gps then
		pcall(function()
			LocalPlayer:RequestStreamAroundAsync(gps, 3)
		end)
		task.wait(0.5)
	end
	-- The train itself first: the GPS may point at the NEXT station while the
	-- train is still rolling, which is the "not the exact location" bug.
	local roof = TPCACHE.FindTrainModel(gps)
	if roof and (not gps or (roof - gps).Magnitude < 1500) then
		print("[TP] Cargo Train: landing on the train itself")
		TeleportPlayerOnly(roof)
		return true
	end
	if gps then
		print("[TP] Cargo Train: train not loaded, going to where the game's GPS points")
		TeleportPlayerOnly(gps)
		-- Arrived: now it should be loaded -- hop onto it if it is.
		task.wait(1)
		roof = TPCACHE.FindTrainModel(gps)
		if roof and (roof - gps).Magnitude < 600 then
			TeleportPlayerOnly(roof)
		end
		return true
	end
	warn("[TP] The cargo train is not in this server right now (it comes every hour at :00) -- going to the platform instead")
	return TPCACHE.GoTrainPlatform()
end

