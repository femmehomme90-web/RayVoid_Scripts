-- =========================================================
-- ITEM RULES -- one place to say what happens to an item.
-- =========================================================
-- The problem this exists to solve (worklist Q5, the user's words): "make
-- sure there are absolutely no duplicate filters/settings to configure. that
-- could get very messy and confusing fast". Today "which items?" is asked
-- five times with five sets of controls -- Pickup, AutoSell, AutoPlace,
-- Grade, and the bid overrides -- so excluding one category means ticking it
-- in three places and hoping they agree.
--
-- A rule is a MATCH plus a set of EFFECTS. Rules are ORDERED and the first
-- one that has something to say about a lane wins, which is what makes
-- "X except Y" expressible with no special cases at all:
--
--   1. Uranium Ore AND value under 40k  ->  allow selling, never place
--   2. Mint                             ->  always pick up, never sell
--
-- ...reads top to bottom, so rule 1 carves its exception out of rule 2. That
-- generalises to every future collision; hardcoding "Mint means mint except
-- uranium" would have answered exactly one of them.
--
-- STAGING, and it matters: this engine is wired into all five lanes but
-- every slot starts EMPTY, and an empty slot matches nothing. A rule with no
-- criteria matches NOTHING rather than everything -- deliberately, because
-- the opposite default would turn a half-typed rule into a farm-wide effect.
-- So with the tab untouched, Decide() answers nil everywhere and each lane's
-- existing filter decides exactly as it did before. The old per-tab filters
-- move in one at a time, tested in game between each.
local RULES = {
	-- CURRENT length of RULES.rules, kept in sync wherever that array's size
	-- changes. Not a ceiling any more -- see RULES.AddRule.
	COUNT = 8,
	-- Fixed forever: the number of old per-slot save flags (Rule1Data..
	-- Rule8Data) a slot saved before ItemRulesData existed can have. Used
	-- only by the migration path, never by the matcher or the live count.
	LEGACY_COUNT = 8,
	-- A rule is ONE effect plus a list of alternative SETUPS. Setups are OR
	-- ("keep the gavel if it looks like any of these"), the requirement lines
	-- inside a setup are AND, and each line must be satisfied by a DIFFERENT
	-- mutation on the item. The caps below come from the user's own gavel
	-- spec (2026-09-11): four setups covered the whole of it, two lines
	-- covered its widest setup, and two alternatives covered
	-- "(100% diamond OR 50% corrupted)". Each has room to spare.
	-- These are editor limits only (the "+" buttons); the matcher and
	-- Deserialize take any number. MAX_ALTS was 3 and ran out in real use
	-- (2026-09-13); nothing depends on it being small, so it is 20.
	MAX_SETUPS = 6,
	MAX_LINES = 4,
	MAX_ALTS = 20,
	-- Synthetic entry on a line's mutation picker, so "+ 100% any other"
	-- needs no special field: it is an ordinary alternative that accepts any
	-- mutation, and the distinct-mutation rule makes "any OTHER" fall out.
	ANY_MUTATION = "Any mutation",
	rules = {},
	-- Lane -> the two effects that can force or block it. Kept as data so a
	-- new lane is one line here plus one call site, not a new branch.
	-- `blind` names the criteria a lane physically cannot read, and which it
	-- therefore SKIPS instead of failing on. Only pickup has one. An item
	-- lying on the ground shows its name, category, rarity, condition and
	-- mutation NAMES -- it has no KG and no buff %, both of which exist only
	-- once the item is in the inventory. Failing on them made "Uranium Ore,
	-- 30 KG and up -> always pick up" unable to ever fire, which is not what
	-- anyone typing that means: they mean the ore, and the KG is about what
	-- happens to it afterwards. Skipping is safe HERE and nowhere else,
	-- because the same item is checked again by sell / place / grade, which
	-- do see both. The bid lane is deliberately given NO blind list: ignoring
	-- a criterion there spends the entry fee on a partial match and there is
	-- no second pass to correct it, so its blindness stays a warning
	-- (RULES.BidBlind) rather than a silent skip. And even on pickup the skip
	-- applies to "Always pick up" only, never to "Never pick up" -- see
	-- RULES.Decide for why.
	LANES = {
		pickup = { force = "Always pick up", block = "Never pick up",
			blind = { weight = true, percent = true, sumPercent = true } },
		sell   = { force = "Allow selling",  block = "Never sell" },
		place  = { force = "Allow placing",  block = "Never place" },
		grade  = { force = "Allow grading",  block = "Never grade" },
		bid    = { force = "Ignore Min Bid", block = nil },
		-- No force half: there is no "always wash" to ask for, only "keep
		-- this dirty" (2026-09-13, the gavel case -- dirty is worth more to
		-- keep than washed for some setups, and Wash had no per-item say at
		-- all before this).
		wash   = { force = nil,              block = "Never wash" },
	},
}

-- Grouped by polarity, not by lane: every "always allow it through" effect
