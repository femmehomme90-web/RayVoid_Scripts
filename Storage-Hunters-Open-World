-- POLICE RAID / SEIZED GARAGE ("Police" event)
-- Verified in game (place v286): the server SEIZES one of your NORMAL
-- auction garages. Same .Name / GarageId / AreaName / GUID -- no new
-- type or area to declare. Client-side markers:
--   * a "SeizedDressing" child placed under the garage
--   * the server sends you the GUID via Events.Misc.SeizedGarage("Set", guid)
--     and clears it via ("Clear", guid) -- one seizure at a time, PER PLAYER.
-- The seized garage's lot carries [Redacted] items (x1.25) and rarely
-- [Seized] (x15). Loading that loot into the truck triggers a police
-- chase (server-handled, nothing to do here).
-- A single root-level local for the whole feature (CLAUDE.md rule).
local SEIZED = {
	activeGuid = nil,
	dressingName = "SeizedDressing",
}

do
	local SeizedGarageRemote = Events:WaitForChild("Misc"):WaitForChild("SeizedGarage")

	SESSION.Track(SeizedGarageRemote.OnClientEvent:Connect(function(action, guid)
		if action == "Set" and type(guid) == "string" then
			SEIZED.activeGuid = guid
		elseif action == "Clear" then
			if guid == nil or guid == SEIZED.activeGuid then
				SEIZED.activeGuid = nil
			end
		end
	end))

	-- Like the game client (SeizedGarageClient): asks for the current state
	-- at startup, in case the script is (re)loaded during a seizure.
	task.defer(function()
		pcall(function()
			SeizedGarageRemote:FireServer()
		end)
	end)
end

-- The currently seized garage (Model under workspace._Debris.Garages), or
-- nil. We resolve by the GUID received from the remote; fallback on the
-- "SeizedDressing" child if the GUID has not arrived yet (script loaded
-- mid-seizure).
function SEIZED.GetGarage()
	local Debris = workspace:FindFirstChild("_Debris")
	local GaragesFolder = Debris and Debris:FindFirstChild("Garages")
	if not GaragesFolder then
		return nil
	end
	if SEIZED.activeGuid then
		for _, g in ipairs(GaragesFolder:GetChildren()) do
			if g:GetAttribute("GUID") == SEIZED.activeGuid then
				return g
			end
		end
	end
	for _, g in ipairs(GaragesFolder:GetChildren()) do
		if g:FindFirstChild(SEIZED.dressingName) then
			return g
		end
	end
	return nil
end

function SEIZED.IsActive()
	return SEIZED.GetGarage() ~= nil
end

-- Unix timestamp of the next seizure scheduled for THIS player -- the
-- game exposes it directly on LocalPlayer, no RNG to reimplement. nil if
-- absent.
function SEIZED.NextDueUnix()
	local v = LocalPlayer:GetAttribute("PoliceSeizedGarageNextDueUnix")
	if type(v) == "number" and v > 0 then
		return v
	end
	return nil
end

-- Entry {garage, entrySquare, promptPart, prompt} of the seized garage,
-- or nil. Same shape as GetEligibleGarages() so the Master Cycle consumes
-- it as is. ignoreTypeFilter:
--   nil/false -> returns the entry only if the type is checked in Garage
--                Types ("Prioritize Seized Garage")
--   true      -> any type, even unchecked ("Auto-Grab Any Seized
--                Garage")
function SEIZED.GetEligibleEntry(ignoreTypeFilter)
	local g = SEIZED.GetGarage()
	if not g then
		return nil
	end
	if not ignoreTypeFilter and not FARM.selectedTypes[g.Name] then
		return nil
	end
	local entrySquare = g:FindFirstChild("EntrySquare")
	local promptPart = entrySquare and entrySquare:FindFirstChild("PromptPart")
	local prompt = promptPart and promptPart:FindFirstChild("EnterAuction")
	if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
		return {
			garage = g,
			entrySquare = entrySquare,
			promptPart = promptPart,
			prompt = prompt,
		}
	end
	return nil
end


-- AUTO FARM (garages) -- the full sequencing is handled by the Master
-- Cycle further down, not here.
local function GetAllGarages()
	local Debris = workspace:FindFirstChild("_Debris")
	local GaragesFolder = Debris and Debris:FindFirstChild("Garages")
	if not GaragesFolder then
		return {}
	end
	return GaragesFolder:GetChildren()
end

-- Garage types / areas removed from the game but still listed in
-- Modules.Garages and Modules.Areas (dead entries; a future place version
-- will remove them, meanwhile we filter them ourselves). Selecting one of
-- these types did nothing anyway -- GetEligibleGarages never finds the
-- matching instance in _Debris.Garages. A single root-level local
-- (CLAUDE.md rule).
local REMOVED = {
	garagePatterns = { "Alien Garage", "Jurassic" },
	areaNames = { ["Alien Invasion"] = true, ["Jurassic"] = true },
}

function REMOVED.IsGarageType(name)
	for _, pattern in ipairs(REMOVED.garagePatterns) do
		if string.find(name, pattern, 1, true) then
			return true
		end
	end
	return false
end

-- Built from ReplicatedStorage.Modules.Garages rather than hardcoded:
-- this table's keys ARE the exact name matching garage.Name in game
-- (unlike def.Name, which is only a display label often shared between
-- several variants -- "Scrap Garage 2" and "Scrap Garage 3" both have
-- Name="Scrap Garage"). The module also contains non-garage entries
-- (DEFAULT_FLOOR_LUCK_MIN/MAX, ResolveMinAuctionValue) which we filter by
-- type(def)=="table" and the presence of def.Name, plus the removed types
-- (REMOVED.IsGarageType).
local function GetAllGarageTypeNames()
	local names = {}
	for key, def in pairs(Garages) do
		if type(def) == "table" and type(def.Name) == "string" and not REMOVED.IsGarageType(key) then
			table.insert(names, key)
		end
	end
	table.sort(names)
	return names
end

local FARM_GARAGE_TYPE_OPTIONS = GetAllGarageTypeNames()

-- FIXED location groups, deduced by keyword in the type name -- the
-- game's Garages module contains no real location info (just
-- MinNetWorth/DoorType/NumItems/EntryCost), so this grouping is an
-- assumption to confirm/adjust in game, not official data. Built
-- dynamically against FARM_GARAGE_TYPE_OPTIONS: a new game type that
-- matches a keyword joins its group automatically, no need to touch
-- this again.
-- Built from ReplicatedStorage.Modules.Areas (the real official area ->
-- garage types mapping, via GarageIds), not by guessing from a keyword
-- in the name. A priority slot can therefore target a whole area
-- ("Cargo Ship", "Lucky Beach", "Power Plant"...) just as much as an
-- individual garage type. The removed areas/types
-- (REMOVED.areaNames / REMOVED.IsGarageType) are excluded.
local LOCATION_GROUPS = {}
do
	local areaNames = {}
	for areaName, def in pairs(Areas) do
		if type(def) == "table" and type(def.GarageIds) == "table" and not REMOVED.areaNames[areaName] then
			table.insert(areaNames, areaName)
		end
	end
	table.sort(areaNames)

	for _, areaName in ipairs(areaNames) do
		local members = {}
		local memberList = {}
		for garageTypeName in pairs(Areas[areaName].GarageIds) do
			if not REMOVED.IsGarageType(garageTypeName) then
				members[garageTypeName] = true
				table.insert(memberList, garageTypeName)
			end
		end
		table.sort(memberList)
		if #memberList > 0 then
			table.insert(LOCATION_GROUPS, { name = areaName, members = members, memberList = memberList })
		end
	end
end

-- A priority slot can contain either a group name or an individual
-- garage type. Returns the set of types covered by the chosen value
-- (the whole group, or just that single type).
local function ResolvePriorityTypeSet(value)
	if not value or value == "None" then
		return nil
	end
	for _, group in ipairs(LOCATION_GROUPS) do
		if group.name == value then
			return group.members
		end
	end
	return { [value] = true }
end

-- types = {[1]=highest priority, ...}, nil if "None". A garage listed
-- here comes BEFORE distance.
-- The option list used to be built once here, holding every area group and
-- every garage type. It is now computed by GARAGEPRIORITY.BuildOptions()
-- from what is checked in Garage Types, so there is no static list any more.
local GARAGEPRIORITY = {
	types = { nil, nil, nil },
}

-- A single callback parameterized by slot: avoids duplicating the same
-- parsing logic 3x (RayVoid returns either a table or a string
-- depending on the version, cf. "Place every N containers" above).
function GARAGEPRIORITY.MakeCallback(slotIndex)
	return function(selected)
		local value = selected
		if type(selected) == "table" then
			value = selected[1]
		end
		if value == nil or value == "None" then
			GARAGEPRIORITY.types[slotIndex] = nil
		else
			GARAGEPRIORITY.types[slotIndex] = value
		end
	end
end

-- The 3 priority dropdowns, filled in when the UI is built, so the options
-- can be narrowed later. Kept on the table rather than as root-level locals
-- (Lua 5.1 caps them at 200).
GARAGEPRIORITY.dropdowns = {}

-- Only what is actually checked in "Garage Types" is worth offering here: a
-- priority slot pointing at an unchecked type does nothing, because
-- GetEligibleGarages filters on FARM.selectedTypes first. Offering all 40+
-- types made it look as though picking one was enough.
--
-- Area names (Business Bay, Lucky Beach, ...) are deliberately NOT offered.
-- They used to be, so a slot could target a whole area, but an area is not a
-- garage type and never appears in the Garage Types list above, which made it
-- look like a stray entry. LOCATION_GROUPS and ResolvePriorityTypeSet still
-- handle a group value if one is ever restored here.
function GARAGEPRIORITY.BuildOptions()
	local options = { "None" }

	for _, garageName in ipairs(FARM_GARAGE_TYPE_OPTIONS) do
		if FARM.selectedTypes[garageName] then
			table.insert(options, garageName)
		end
	end

	return options
end

-- Called whenever the Garage Types selection changes. A slot holding a value
-- that is no longer offered is cleared -- and said out loud, because
-- silently keeping a priority the user can no longer see in the list is
-- exactly the kind of invisible state that causes "why is it going there?".
function GARAGEPRIORITY.RefreshOptions()
	local options = GARAGEPRIORITY.BuildOptions()

	local stillOffered = {}
	for _, name in ipairs(options) do
		stillOffered[name] = true
	end

	for slotIndex = 1, 3 do
		local current = GARAGEPRIORITY.types[slotIndex]
		if current and not stillOffered[current] then
			GARAGEPRIORITY.types[slotIndex] = nil
			warn(string.format(
				"[GaragePriority] Priority %d was '%s', which is no longer checked in Garage Types -- cleared",
				slotIndex, tostring(current)))
		end

		local dropdown = GARAGEPRIORITY.dropdowns[slotIndex]
		if dropdown and dropdown.Refresh then
			pcall(function()
				dropdown:Refresh(options)
			end)
		end
	end
end


-- AREA POSITION (to move closer to an area whose garages are not yet
-- streamed). Universal: works for any garage type, no longer needs the
-- hand-written STREAMING_ANCHOR_PATHS table (which only covered Power
-- Plant + Business Bay). Three sources, in
-- order:
--   1. GPS POIs (Events.GPS.GetPOIs) -- every permanent area is there
--      with an exact position. Cached once (server round-trip).
--   2. Areas.GetMascotNavTarget(garageId) -- resolves workspace.Areas.<area>.
--      <Mascot>, only for areas that have a Mascot.
--   3. The workspace.Areas.<area> model itself, if it is already (at
--      least partially) loaded.
-- Returns nil if no source resolves (e.g. "Cargo Ship" -- an event area,
-- absent from POIs, without a Mascot, not under workspace.Areas at rest).
local AREAPOS = {
	poiCache = nil, -- areaName -> Vector3, filled on the 1st call
}

function AREAPOS.LoadPOIs()
	if AREAPOS.poiCache then
		return
	end
	AREAPOS.poiCache = {}
	local gps = Events:FindFirstChild("GPS")
	local getPOIs = gps and gps:FindFirstChild("GetPOIs")
	if not getPOIs then
		return
	end
	local ok, data = pcall(function()
		return getPOIs:InvokeServer()
	end)
	if ok and type(data) == "table" and type(data.pois) == "table" then
		for _, poi in ipairs(data.pois) do
			if poi.category == "Area" and type(poi.name) == "string" and typeof(poi.position) == "Vector3" then
				AREAPOS.poiCache[poi.name] = poi.position
			end
		end
	end
end

-- Returns (position, areaName) or (nil, areaName|nil).
function AREAPOS.ForGarageType(garageTypeName)
	local areaName
	local ok = pcall(function()
		areaName = Areas.GetGarageAreaName(garageTypeName)
	end)
	if not ok or type(areaName) ~= "string" then
		return nil, nil
	end

	AREAPOS.LoadPOIs()
	if AREAPOS.poiCache and AREAPOS.poiCache[areaName] then
		return AREAPOS.poiCache[areaName], areaName
	end

	local mok, _, mpos = pcall(function()
		return Areas.GetMascotNavTarget(garageTypeName)
	end)
	if mok and typeof(mpos) == "Vector3" then
		return mpos, areaName
	end

	local areasFolder = workspace:FindFirstChild("Areas")
	local areaModel = areasFolder and areasFolder:FindFirstChild(areaName)
	if areaModel then
		local p = ResolvePosition(areaModel)
		if p then
			return p, areaName
		end
	end

	return nil, areaName
end


-- The garage types the farm may hunt: the ticked list plus whatever a quest
-- needs right now (the quest ones are tried FIRST, see GetEligibleGarages).
function FARM.TypeSet()
	if next(FARM.questGroups) == nil then
		return FARM.selectedTypes
	end
	local union = {}
	for name in pairs(FARM.selectedTypes) do
		union[name] = true
	end
	for _, group in pairs(FARM.questGroups) do
		for name in pairs(group.types) do
			union[name] = true
		end
	end
	return union
end

-- Quest groups, best rank first (ties by key so the order is stable).
function FARM.SortedQuestGroups()
	local list = {}
	for key, group in pairs(FARM.questGroups) do
		if next(group.types) ~= nil then
			table.insert(list, { key = key, rank = group.rank or 99, types = group.types })
		end
	end
	table.sort(list, function(a, b)
		if a.rank ~= b.rank then
			return a.rank < b.rank
		end
		return a.key < b.key
	end)
	return list
end

local function GetEligibleGarages()
	-- Quest garages first, in quest priority order: the top NPC's garages if
	-- any is up, else the next NPC's, ... Only when none is up does the farm
	-- fall back to the ticked list, so it never idles waiting.
	for _, group in ipairs(FARM.SortedQuestGroups()) do
		local questOnly = FARM.EligibleFor(group.types)
		if #questOnly > 0 then
			if FARM.lastQuestGroup ~= group.key then
				FARM.lastQuestGroup = group.key
				print("[AutoFarm] Farming for quest: " .. group.key)
			end
			return questOnly
		end
	end
	return FARM.EligibleFor(FARM.selectedTypes)
end

function FARM.EligibleFor(types)
	local eligible = {}
	for _, garage in ipairs(GetAllGarages()) do
		if types[garage.Name] then
			local entrySquare = garage:FindFirstChild("EntrySquare")
			local promptPart = entrySquare and entrySquare:FindFirstChild("PromptPart")
			local prompt = promptPart and promptPart:FindFirstChild("EnterAuction")

			if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
				table.insert(eligible, {
					garage = garage,
					entrySquare = entrySquare,
					promptPart = promptPart,
					prompt = prompt,
				})
			end
		end
	end
	return eligible
end

local function GetFarmReferencePosition()
	if FARM.preferNearestToVehicle then
		local truck = GetPlayerTruck()
		if truck then
			local truckPosition = ResolvePosition(truck)
			if truckPosition then
				return truckPosition
			end
		end
	end
	local hrp = GetFreshHRP()
	if hrp then
		return hrp.Position
	end
	return HRP.Position
end

-- On FARM (not a root-level local -- Lua 5.1 caps at 200).
FARM.truckMaxDistance = 100

local function TeleportPlayerAndTruck(targetPosition)
	local targetCFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))
	local vehicle = GetSeatedVehicle()
	DebugPrint("[AutoFarm] TeleportPlayerAndTruck: seated=" .. tostring(vehicle ~= nil))

	if vehicle then
		local primary = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
		if not primary then
			warn("[AutoFarm] No BasePart found in the vehicle")
			SafeSetHRPCFrame(targetCFrame)
			return
		end
		if vehicle.PrimaryPart then
			vehicle:SetPrimaryPartCFrame(targetCFrame)
		else
			primary.CFrame = targetCFrame
		end
		-- Residual velocity on an assembled vehicle (wheels/suspensions/
		-- joints) after an instant TP = brutal physics discontinuity, the
		-- likely source of the crash during AutoFarm (never in standalone,
		-- which never teleports the truck).
		for _, part in ipairs(vehicle:GetDescendants()) do
			if part:IsA("BasePart") then
				ZeroVelocity(part)
			end
		end
		task.wait()
		return
	end

	-- Not seated: we teleport ONLY the player here. The truck catch-up
	-- (VEHICLESPAWN) now happens AFTER the auction starts, so it no longer
	-- delays entering the bid.
	SafeSetHRPCFrame(targetCFrame)
	DebugPrint("[AutoFarm] Player teleported (not seated)")
end

-- Catches the truck up once the auction has started: if the player is not
-- seated in it (otherwise it already followed via TeleportPlayerAndTruck)
-- and the truck is too far, we request its spawn and exit the seat as
-- soon as the game seats us. Never blocks entering the auction.
local function CatchUpVehicle(targetPosition)
	if GetSeatedVehicle() then
		return
	end

	local truck = GetPlayerTruck()
	if not truck then
		-- Gone from the map: spawn it rather than give up (it used to return
		-- here, and the farm then sat in the garage trying to load items into
		-- a truck that did not exist).
		print("[AutoFarm] Truck is not on the map -- spawning it")
		if not VEHICLESPAWN.RequestAndWait(3) then
			warn("[AutoFarm] Could not spawn the truck -- items cannot be picked up until it is here")
		end
		return
	end

	-- Double read, 0.3s apart, before concluding "too far": a SINGLE
	-- read right after a big TP (the player jumping far to place/farm
	-- while the truck stays behind) can land on a position not yet
	-- resynchronized client-side (streaming -- confirmed active on this
	-- game, ModelStreamingMode.Default) and give a momentarily wrong
	-- distance -- reported by players as "the truck is seen as too far
	-- when it is not". Requiring BOTH reads to agree on "too far" before
	-- requesting a respawn costs 0.3s in the worst case, but avoids a
	-- pointless recall (and the visual glitch it causes) on a transient
	-- reading.
	local function ReadTruckDistance()
		local pos = ResolvePosition(truck)
		if not pos then
			return nil
		end
		return (targetPosition - pos).Magnitude
	end

	local firstDistance = ReadTruckDistance()
	if firstDistance and firstDistance <= FARM.truckMaxDistance then
		DebugPrint(string.format("[AutoFarm] Truck already close enough (%.0f studs), no catch-up", firstDistance))
		return
	end

	task.wait(0.3)

	local secondDistance = ReadTruckDistance()
	if secondDistance and secondDistance <= FARM.truckMaxDistance then
		DebugPrint(string.format("[AutoFarm] Truck close enough on 2nd read (%.0f -> %.0f studs, 1st read was stale/transient), no catch-up", firstDistance or -1, secondDistance))
		return
	end

	DebugPrint(string.format("[AutoFarm] Truck confirmed far on 2 reads (%.0f then %.0f studs, threshold %.0f), requesting catch-up",
		firstDistance or -1, secondDistance or -1, FARM.truckMaxDistance))

	-- Official remote rather than a manual CFrame: avoids the physics
	-- discontinuity on the assembled vehicle (wheels/suspensions/joints).
	-- RequestAndWait (instead of a single-attempt Request+WaitAndExit)
	-- retries if the server does not answer in time -- the most likely
	-- cause of "the truck does not teleport next to the player".
	if not VEHICLESPAWN.RequestAndWait(3) then
		warn("[AutoFarm] Vehicle spawn request failed, truck may be left behind")
	end
end

-- Auto Farm sitting there doing nothing is indistinguishable from Auto Farm
-- being broken, and every dead end in TryEnterNextAuction used to be a
-- DebugPrint -- silent unless SH-debug-toggle turned it on. So the blocking
-- ones say it out loud instead. Once per reason, though: the master
-- cycle comes back here every 2s and a line per pass would bury the console.
-- FARM.Busy() clears the latch when a garage is actually taken, so a later
-- stall speaks again rather than being swallowed as a repeat.
function FARM.Idle(reason)
	if FARM.idleReason == reason and (os.clock() - (FARM.idleAt or 0)) < 30 then
		return
	end
	FARM.idleReason = reason
	FARM.idleAt = os.clock()
	warn("[AutoFarm] on, but not farming: " .. reason)
end

-- When something last actually moved. The stall watchdog in the master cycle
-- used to time the auction STATE instead, and the state is a poor proxy for
-- progress: SEARCHING covers travelling, entering a garage, waiting for the
-- bid window to open AND the whole unload/place trip home, any of which runs
-- past 90s with the farm working perfectly. Stamped on a garage taken, on
-- every bid update, and at the end of a collect pass.
function FARM.Moved()
	FARM.progressAt = os.clock()
end

function FARM.Busy()
	FARM.idleReason = nil
	FARM.Moved()
end

-- Master cycle pacing. Normally the loop ticks at 0.5s while BIDDING and 2s
-- between search attempts, which is fine when it is waiting on the game. But
-- after an exit we KNOW is final -- a Min Bid skip, or an auction lost -- there
-- is nothing to wait for, and those two waits together cost up to 2.5s before
-- the next garage is even looked for. That is the dead time the auction-start
-- potion is bought to remove.
--
-- So the exits that know set FARM.hurryUntil, and every wait inside the window
-- collapses to a short slice. Outside it nothing changes, so an idle farm is no
-- busier than before and TryEnterNextAuction is not hammered.
FARM.HURRY_WINDOW = 5
FARM.HURRY_SLICE = 0.4

function FARM.PacedWait(seconds)
	if os.clock() < (FARM.hurryUntil or 0) then
		seconds = math.min(seconds, FARM.HURRY_SLICE)
	end
	task.wait(seconds)
end

function FARM.Hurry()
	FARM.hurryUntil = os.clock() + FARM.HURRY_WINDOW
end

local function TryEnterNextAuction()
	if os.clock() < FARM.cooldownUntil then
		-- THE HOLE, found 2026-09-09 from the user's log: four "On cooldown"
		-- lines counting down a full 15s with no auction between them.
		--
		-- The 15s is armed the moment a garage is committed to, and every way
		-- an auction can END clears it -- Min Bid skip, lost, and (since
		-- yesterday) won. But if the auction never STARTS, there is no exit
		-- path, so nothing clears it and the farm sits out the whole 15s for a
		-- garage it never got into. The prompt can simply not take: someone
		-- else took the garage first, the Lost & Found popup ate it, the
		-- prompt was out of range on arrival.
		--
		-- Nothing signals "the prompt did not take", so this is a timeout --
		-- but a short one against the game's own 3s start timer, not 15s. If
		-- the auction did start we are not in SEARCHING and never reach here.
		if FARM.committedAt and (os.clock() - FARM.committedAt) > FARM.AUCTION_START_GRACE then
			FARM.deadCommits = FARM.deadCommits + 1
			local line = "[AutoFarm] " .. tostring(FARM.committedGarage or "that garage") ..
				" never started an auction after " .. FARM.AUCTION_START_GRACE ..
				"s -- someone else probably took it. Moving to the next garage instead of waiting out the cooldown."
			if not FARM.deadCommitWarned then
				FARM.deadCommitWarned = true
				warn(line)
			else
				DebugPrint(line .. " (" .. FARM.deadCommits .. " so far this session)")
			end
			FARM.cooldownUntil = 0
			FARM.committedAt = nil
			FARM.committedGarage = nil
			FARM.Hurry()
		else
			DebugPrint("[AutoFarm] On cooldown, " .. string.format("%.1f", FARM.cooldownUntil - os.clock()) .. "s")
			return
		end
	end

	-- Settle window after an auction ends: the "Sold to" and the
	-- carryable spawn arrive AFTER the bid UI closes. Leaving now would
	-- abandon a lot we may have just won, with the collection cut off
	-- midway.
	if os.clock() < AUCTION.settleUntil then
		DebugPrint("[AutoFarm] Settling after last auction, waiting before entering a new one")
		return
	end

	-- Safety: never move on to a new garage if items of ours are still on
	-- the ground. The master should not get here in that case, but if the
	-- FSM has desynchronized (state forced by a game event), this avoids
	-- abandoning a half-empty garage.
	if CountOwnedCarryablePrompts() > 0 then
		FARM.groundSince = FARM.groundSince or os.clock()
		if (os.clock() - FARM.groundSince) > 30 then
			FARM.Idle("items of yours are still on the ground -- no new auction is entered until they are collected")
		end
		DebugPrint("[AutoFarm] Items still on the ground, not entering a new auction yet")
		return
	end
	FARM.groundSince = nil

	-- The game only allows the drink-loadout swap back while SEARCHING, and
	-- entering a new auction here is a choice this function makes, not
	-- something the game forces on us -- unlike the auction itself. Checking
	-- only pendingRestore (a restore that already failed once) leaves the gap
	-- BEFORE that: WearDrinkLoadout has switched to the drink loadout, the
	-- drink is in flight, and the switch back hasn't been attempted yet --
	-- committing to a new garage in that window is exactly what makes the
	-- switch back fail a moment later. swapInProgress covers that gap too.
	if ENERGYDRINK.loadoutEnabled and (ENERGYDRINK.pendingRestore or ENERGYDRINK.swapInProgress) then
		DebugPrint("[AutoFarm] Holding off a new auction: EnergyDrink is mid-swap or still owes a switch back")
		return
	end

	local target = nil
	local referencePosition = GetFarmReferencePosition()

	-- SEIZED garage (Police event): absolute priority, before GARAGEPRIORITY
	-- and distance. Short window + [Redacted]/[Seized] lot (x15).
	--   prioritizeSeized  -> only if its type is checked in Garage Types
	--   autoGrabAnySeized -> any type (SEIZED.GetEligibleEntry with
	--                        ignoreTypeFilter = true)
	-- Once that garage is complete (bid/win/collect + unload/place handle
	-- the rest), the Master returns to SEARCHING and we come back here: if
	-- a seized garage remains we take it, else we continue normal farming.
	if FARM.prioritizeSeized or FARM.autoGrabAnySeized then
		local seizedEntry = SEIZED.GetEligibleEntry(FARM.autoGrabAnySeized)
		if seizedEntry then
			target = seizedEntry
			DebugPrint("[AutoFarm] Seized garage active, overriding priority/distance: " .. target.garage.Name)
		end
	end

	if not target then
		if next(FARM.TypeSet()) == nil then
			FARM.Idle("no garage type is ticked in the Garage Types list")
			return
		end

		local eligible = GetEligibleGarages()
		if #eligible == 0 then
			-- No eligible instance. Two causes: (a) the chosen areas are too
			-- far and Roblox streaming has unloaded their garages -- moving
			-- closer makes them appear; (b) there really is no auction
			-- available for those types right now.
			-- We PROBE: TP to the area of a chosen type (position resolved by
			-- AREAPOS -- GPS POI, mascot, or area model -- universal, no more
			-- hand-written list), we wait for streaming, we RE-SCAN in the
			-- same pass. If something loads -> we continue with it. Still
			-- nothing -> cooldown on the area (no looping back and forth) and
			-- we hand back control.
			local probedArea = nil
			for garageName in pairs(FARM.TypeSet()) do
				local anchorPos, areaName = AREAPOS.ForGarageType(garageName)
				if anchorPos and areaName
					and (FARM.areaProbeCooldown[areaName] or 0) <= os.clock() then
					DebugPrint("[AutoFarm] No eligible garage, moving to " .. areaName .. " to stream its garages in")
					TeleportPlayerAndTruck(anchorPos)
					probedArea = areaName
					break
				end
			end

			if not probedArea then
				FARM.Idle("no auction is up for the ticked garage types, and their areas are unreachable or on a back-off")
				return
			end

			task.wait(2)
			eligible = GetEligibleGarages()
			if #eligible == 0 then
				FARM.areaProbeCooldown[probedArea] = os.clock() + 45
				FARM.Idle("nothing to bid on at " .. probedArea .. " -- backing off 45s, will retry")
				return
			end
			DebugPrint("[AutoFarm] " .. #eligible .. " eligible garage(s) after moving to " .. probedArea)
		else
			DebugPrint("[AutoFarm] " .. #eligible .. " eligible garage(s) found")
		end

		-- Priority: we first look for an eligible instance of a type from the
		-- priority list, in order (1 = highest priority). If found, it is
		-- kept even if a non-priority garage is closer.
		-- If several eligible instances share the SAME slot (e.g. a location
		-- group with several garage tiers in it), we take the highest tier
		-- (highest MinNetWorth in the Garages module), not the closest -- a
		-- priority slot targets "the best garage of this area/type", not
		-- "the fastest to reach". The sort uses the real MinNetWorth value
		-- from the Garages module, not a number extracted from the name --
		-- name digits do not faithfully reproduce the real tier (e.g.
		-- "Scrap Garage 2" and "Scrap Garage 3" share the same
		-- MinNetWorth=0).
		for slotIndex, priorityValue in ipairs(GARAGEPRIORITY.types) do
			if priorityValue then
				local typeSet = ResolvePriorityTypeSet(priorityValue)
				local matches = {}
				for _, entry in ipairs(eligible) do
					if typeSet and typeSet[entry.garage.Name] then
						table.insert(matches, entry)
					end
				end

				if #matches > 0 then
					table.sort(matches, function(a, b)
						local defA = Garages[a.garage.Name]
						local defB = Garages[b.garage.Name]
						local worthA = (type(defA) == "table" and defA.MinNetWorth) or 0
						local worthB = (type(defB) == "table" and defB.MinNetWorth) or 0
						if worthA ~= worthB then
							return worthA > worthB
						end
						-- Same tier: distance breaks the tie.
						local posA = ResolvePosition(a.entrySquare) or ResolvePosition(a.promptPart)
						local posB = ResolvePosition(b.entrySquare) or ResolvePosition(b.promptPart)
						if not posA then
							return false
						end
						if not posB then
							return true
						end
						return (posA - referencePosition).Magnitude < (posB - referencePosition).Magnitude
					end)
					target = matches[1]
					DebugPrint("[AutoFarm] Priority " .. slotIndex .. " (" .. priorityValue .. ") matched, overriding distance sort")
					break
				end
			end
		end

		if not target then
			table.sort(eligible, function(a, b)
				local posA = ResolvePosition(a.entrySquare) or ResolvePosition(a.promptPart)
				local posB = ResolvePosition(b.entrySquare) or ResolvePosition(b.promptPart)
				if not posA then
					return false
				end
				if not posB then
					return true
				end
				return (posA - referencePosition).Magnitude < (posB - referencePosition).Magnitude
			end)
			target = eligible[1]
		end
	end

	-- Stand next to the PROMPT, not the entry square.
	--
	-- Measured in game 2026-09-09, and it explains the whole "garage never
	-- started an auction" problem: the entry square sits ~6.3 studs from the
	-- prompt part, and the teleport adds 3 more upward, so the player landed
	-- 9.3 studs away from a prompt whose MaxActivationDistance is 7. Out of
	-- range on EVERY garage type except Beach Hut (whose parts are 2.4 apart).
	-- fireproximityprompt then does nothing at all, and says nothing either.
	--
	-- It ever worked only by accident: the character is dropped 3 studs up,
	-- and if gravity pulled it back down into range before the fire, the
	-- prompt took. That is why it looked like a random ~50% failure.
	local promptPosition = ResolvePosition(target.promptPart)
	local entryPosition = promptPosition or ResolvePosition(target.entrySquare)
	if not entryPosition then
		warn("[AutoFarm] Could not resolve a position for " .. target.garage.Name)
		return
	end

	FARM.Busy()

	-- The 15s cooldown is armed HERE, at the moment we commit to this
	-- garage -- NOT at the end of this function. Do not move it back.
	--
	-- Everything below (the prompt, the truck catch-up) blocks this
	-- coroutine for seconds, and the auction can be
	-- over before it returns: the Min Bid skip and the "lost" handler both
	-- run on the remote-event thread, and both clear this cooldown because
	-- there is nothing left to wait for. With the arm at the end, it ran
	-- AFTER their clear and put the full 15s back -- which is the long AFK
	-- the user caught on 2026-09-08, counting 13.0 -> 0.9 straight after a
	-- truck catch-up. Armed here, any exit path's clear always lands last
	-- and wins.
	FARM.cooldownUntil = os.clock() + 15
	-- Remembered so the gate at the top of this function can tell "an auction
	-- is running" from "the prompt never took". Cleared by SetAuctionState.
	FARM.committedAt = os.clock()
	FARM.committedGarage = target.garage.Name

	-- The hurry window belongs to the exit that opened it, and it has
	-- already done its job by now: it collapsed the wait that brought us
	-- back here. Closing it on commitment means a window still open below
	-- can only have been opened by THIS garage's exit, which is what the
	-- catch-up guard at the end of this function relies on.
	FARM.hurryUntil = 0

	DebugPrint("[AutoFarm] Cible: " .. target.garage.Name)

	-- Every step of the entry is timed, because "1-3 seconds for no reason"
	-- (user, 2026-09-09) cannot be answered by reading code -- the waits left
	-- here are all conditional, so only a real run says which one is paying.
	-- Debug-only, so a normal run is unaffected.
	local stepAt = os.clock()
	TeleportPlayerAndTruck(entryPosition)
	DebugPrint(string.format("[Timing] teleport %.2fs", os.clock() - stepAt))

	-- Wait until the prompt is genuinely REACHABLE, measured against its own
	-- MaxActivationDistance and the prompt part's real position.
	--
	-- The previous version compared the player to `entryPosition` against a
	-- hardcoded 10 studs, which the teleport satisfied in the same instant --
	-- so it always broke immediately and fired from 9.3 studs out. Checking
	-- the thing we actually need to be near is both correct and faster: it
	-- exits the moment the prompt is in reach rather than on a timer.
	stepAt = os.clock()
	local reach = 7
	pcall(function()
		reach = target.prompt.MaxActivationDistance
	end)
	local arriveDeadline = os.clock() + 1.5
	local inReach = false
	while os.clock() < arriveDeadline do
		local hrp = GetFreshHRP()
		if hrp and promptPosition and (hrp.Position - promptPosition).Magnitude <= (reach * 0.85) then
			inReach = true
			break
		end
		task.wait(0.03)
	end
	if not inReach then
		-- Out of reach after a second and a half means the prompt cannot be
		-- fired at all, so the garage is lost before we start. That stops the
		-- loop making progress, so it warns rather than whispering.
		local hrp = GetFreshHRP()
		warn(string.format("[AutoFarm] %s: still %.1f studs from its prompt (reaches %.1f) -- cannot start this auction",
			target.garage.Name,
			(hrp and promptPosition) and (hrp.Position - promptPosition).Magnitude or -1,
			reach))
	end
	DebugPrint(string.format("[Timing] arrival %.2fs (in reach: %s)", os.clock() - stepAt, tostring(inReach)))

	-- These prompts carry HoldDuration = 1, but that costs us nothing:
	-- measured 2026-09-09, Real's fireproximityprompt ignores HoldDuration
	-- and triggers within a frame either way. Do not "optimise" it again.
	--
	-- Fire, then WAIT FOR THE FEE, and re-fire if it does not come. Captured
	-- live: the server refuses an entry made while the previous auction of that
	-- garage is still wrapping up -- which is exactly what we do, because we
	-- leave on a Min Bid skip and re-target within 70ms. The refusal is silent
	-- and looks identical to being accepted, so the old code fired once, saw
	-- nothing, and sat out five seconds. The block is over in about two, so
	-- retrying every 400ms lands the entry as soon as the server will take it.
	stepAt = os.clock()
	local entered = false
	for attempt = 1, 6 do
		local before = FARM.feePaidSeq or 0
		local ok, err = pcall(function()
			fireproximityprompt(target.prompt)
		end)
		if not ok then
			warn("[AutoFarm] fireproximityprompt failed: " .. tostring(err))
			break
		end

		-- If the area's Lost & Found box holds something, the server parks the
		-- entry behind a "Before you start" question and no fee comes. The
		-- remote is the "yes, override" answer; sent blind 0.1s after the
		-- prompt so it cannot overtake the prompt trigger on the wire, and
		-- without touching the popup, which is only cosmetic once answered.
		local deadline = os.clock() + 0.5
		local overrideAt = os.clock() + 0.1
		local overrideSent = false
		while os.clock() < deadline do
			if (FARM.feePaidSeq or 0) ~= before then
				entered = true
				break
			end
			if not overrideSent and os.clock() >= overrideAt then
				overrideSent = true
				pcall(function()
					REMOTES.LostFoundOverride:FireServer(true)
				end)
			end
			task.wait(0.03)
		end

		if entered then
			DebugPrint(string.format("[Timing] prompt %.2fs (accepted on attempt %d)",
				os.clock() - stepAt, attempt))
			break
		end
	end

	if not entered then
		-- Six tries over ~2.4s and the server never charged us. Something other
		-- than the usual "previous auction still closing" is in the way.
		DebugPrint(string.format("[Timing] prompt %.2fs (never accepted)", os.clock() - stepAt))
	end

	-- Truck catch-up AFTER the auction starts: no longer delays entering
	-- the bid. Skipped when the auction is already over -- a Min Bid skip
	-- resolves in under a second, well inside the 0.3s double read plus
	-- the 3s spawn wait below, and pulling the truck to a garage we have
	-- just walked out of is pure dead time. The next garage catches it up.
	if AUCTION.state == "SEARCHING" and os.clock() < (FARM.hurryUntil or 0) then
		DebugPrint("[AutoFarm] Auction already over, skipping the truck catch-up here")
	else
		CatchUpVehicle(entryPosition)
	end
end

-- =========================================================
-- AUTO QUEST -- tour the quest NPCs you pick and accept / claim for you.
-- =========================================================
-- **The worklist said this needed a decision between "passive" and
-- "touring" because the NPC model could only come from a proximity prompt.
-- That premise is wrong, measured 2026-09-10: every quest NPC is an ordinary
-- model in `workspace` carrying an `NPCQuestPrompt`, so scanning for the
-- prompt yields the model AND its position.** 18 of them, all reach 10 and
-- HoldDuration 0. Touring is therefore not the expensive option it looked
-- like, which is why the user's "go to the chosen NPCs, deliberately" is
-- what is built here.
--
-- The protocol is the captured one (docs/game-reference.md):
--   accept: UI.QuestPromptTriggered:InvokeServer(model)
--           -> UI.StartQuestDialog gives the quest name
--           -> UI.SendQuestDialogResult:FireServer(model, questName, "accept")
--   claim : triggering the prompt is enough -- the reward is granted before
--           any answer is given. A reward dialog is recognised by its
--           QuestName being "<NPCName>'s Reward".
--
-- On safety, and it is the whole reason this shipped the night after a Master
-- Cycle change broke item pickup: this is OFF by default and the ONLY thing
-- it adds to the Master Cycle is `QUEST.RunTourIfDue()`, which returns on a
-- boolean before touching anything when the toggle is off. A farm with Auto
-- Quest off runs byte-for-byte the same sequence as before.
local QUEST = {
	active = false,
	selected = {},          -- npcName -> true, from the dropdown
	priority = {},          -- [1..3] -> npcName, visited first in that order
	lastPos = {},           -- npcName -> Vector3 last seen (survives streaming out)
	standalone = false,     -- true while touring WITHOUT Auto Farm
	-- Off for good (user, 2026-10-12): Auto Farm farms YOUR garage list; quests
	-- only get their items delivered (QUEST.HasItemsFor). Kept as a field so the
	-- old quest-garage code stays inert instead of being half-removed.
	farmForQuests = false,
	deliverCooldown = {},   -- npcName -> os.clock() until which no delivery trip
	options = {},           -- display labels for the dropdown ("Ted - Farmyard")
	labels = {},            -- display label -> npcName
	areas = {},             -- npcName -> area string, or false for "no area"
	cooldown = {},          -- npcName -> os.clock() before which we skip it
	npcCache = nil,
	npcCacheAt = 0,
	lastTourAt = 0,
	handled = 0,
	warned = false,
	dropdown = nil,
	-- Scanning every workspace descendant is not free, and quest NPCs do not
	-- move or respawn, so this is cached for two minutes.
	CACHE_FOR = 120,
	-- Between tours. A quest does not become available often; this is not a
	-- polling loop, it is a "have a look now and then" timer.
	TOUR_EVERY = 90,
	-- After talking to one NPC, do not go back for 5 minutes even if its
	-- exclamation mark is still up -- that is how a server-side refusal
	-- stops becoming an infinite round trip.
	NPC_COOLDOWN = 300,
	-- The server refuses the prompt until it has seen us arrive, so the
	-- trigger is fired and re-fired rather than waited out. Measured
	-- 2026-09-10, ~1500 stud teleport: refused at 0.00s / 0.25s / 0.50s,
	-- accepted at 1.00s. 8 tries at 0.3s covers ~2.5s of server lag.
	TRIGGER_TRIES = 8,
	TRIGGER_RETRY = 0.3,
}

function QUEST.ScanNPCs()
	if QUEST.npcCache and (os.clock() - QUEST.npcCacheAt) < QUEST.CACHE_FOR then
		return QUEST.npcCache
	end
	local found = {}
	local ok, err = pcall(function()
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d.Name == "NPCQuestPrompt" then
				local model = d:FindFirstAncestorOfClass("Model")
				local root = model and model:FindFirstChild("HumanoidRootPart")
				if model and root then
					found[model.Name] = { model = model, prompt = d, root = root }
					-- Remembered for when it streams out (see QUEST.Reach).
					QUEST.lastPos[model.Name] = root.Position
				end
			end
		end
	end)
	if not ok then
		warn("[AutoQuest] Could not scan for quest NPCs: " .. tostring(err))
		return QUEST.npcCache or {}
	end
	QUEST.npcCache = found
	QUEST.npcCacheAt = os.clock()
	return found
end

-- Which NPCs currently want talking to. The game puts a
-- `QuestExclamation_<NPCName>` BillboardGui in PlayerGui for exactly those,
-- which is a far cheaper signal than reconstructing state from
-- Quest.QuestStateSync -- and it is the same mark the player sees.
function QUEST.PendingNames()
	local names = {}
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then
		return names
	end
	for _, g in ipairs(pg:GetChildren()) do
		if g:IsA("BillboardGui") and string.sub(g.Name, 1, 17) == "QuestExclamation_" and g.Enabled then
			names[string.sub(g.Name, 18)] = true
		end
	end
	-- Second source: the server's own Quest.ExclamationMarkUpdate, which also
	-- covers an NPC whose billboard is not around (streamed out).
	for name, on in pairs(QUEST.marks) do
		if on then
			names[name] = true
		end
	end
	return names
end

-- Payload shape not measured, so read it loosely: a string that is a quest
-- NPC's name is the who, a boolean is the on/off (default on), and a table
-- of name -> bool is read as a whole list.
QUEST.marks = {}
pcall(function()
	local questEvents = Events:FindFirstChild("Quest")
	local mark = questEvents and questEvents:FindFirstChild("ExclamationMarkUpdate")
	if not mark then
		return
	end
	SESSION.Track(mark.OnClientEvent:Connect(function(...)
		local args = { ... }
		local who, state = nil, true
		for _, a in ipairs(args) do
			if type(a) == "string" then
				who = a
			elseif type(a) == "boolean" then
				state = a
			elseif type(a) == "table" then
				for k, v in pairs(a) do
					if type(k) == "string" and type(v) == "boolean" then
						QUEST.marks[k] = v
					end
				end
			end
		end
		if who then
			QUEST.marks[who] = state
		end
	end))
end)

-- The game's own quest table, keyed by NPC name (22 entries). It answers both
-- questions the dropdown has: "is this a real quest giver" and "which area".
QUEST.Defs = SafeRequire(ReplicatedStorage.Modules.Quests, "Quests")

-- Deliberately static -- "is a quest giver at all", never "has a quest right
-- now". A list that changes with quest availability would silently drop the
-- user's saved ticks every time a quest was handed in, because RayVoid draws
-- no row for a saved option that is missing from the current option list
-- (the Alien Garage bug, 2026-09-08). Who actually gets VISITED is still
-- decided per tour by the exclamation mark, which is the live half.
--
-- Measured 2026-09-10: this drops the Museum Attendant (a shop NPC that
-- carries an NPCQuestPrompt but has no Quests entry, and whose prompt is
-- disabled) and nothing else, 18 -> 17. TollboothGuard stays because it
-- genuinely is one: "Caffeine Roadblock", gated on 2.5M net worth.
function QUEST.IsQuestGiver(name)
	if not QUEST.Defs then
		-- Without the module there is no filter to apply. Say so rather than
		-- quietly showing an empty dropdown.
		if not QUEST.warnedNoDefs then
			QUEST.warnedNoDefs = true
			warn("[AutoQuest] Modules.Quests is unavailable, so every NPC carrying a quest prompt is listed "
				.. "(the Museum Attendant and other non-quest NPCs included).")
		end
		return true
	end
	local def = QUEST.Defs[name]
	return type(def) == "table" and type(def.Levels) == "table" and next(def.Levels) ~= nil
end

-- "Ted - Farmyard": the name is what the user recognises, the area is what
-- they pick by. Three sources, best first.
function QUEST.AreaFor(name, entry)
	local cached = QUEST.areas[name]
	if cached ~= nil then
		return cached or nil
	end

	local area
	-- 1. The module's own Area field, which 15 of the 17 carry.
	local def = QUEST.Defs and QUEST.Defs[name]
	if type(def) == "table" and type(def.Area) == "string" and def.Area ~= "" then
		area = def.Area
	end

	-- 2. Otherwise the Areas folder the model sits in. Parent paths only
	--    answer this for some NPCs -- the Mall ones live under
	--    "Mall - Shop NPCs.Quest NPC" with no area anywhere in the path.
	if not area and entry and entry.model then
		local areasFolder = workspace:FindFirstChild("Areas")
		local node = entry.model
		while areasFolder and node and node ~= workspace do
			if node.Parent == areasFolder then
				area = node.Name
				break
			end
			node = node.Parent
		end
	end

	-- 3. Last, the nearest area POI -- the game's own GPS list, the same data
	--    the area teleports use. Capped at 300 studs: a label naming an area
	--    the NPC is nowhere near would be worse than no label at all, so
	--    those (Terry, TollboothGuard) simply show their bare name.
	if not area and entry and entry.root then
		local okPOI = pcall(function()
			AREAPOS.LoadPOIs()
		end)
		if okPOI and AREAPOS.poiCache then
			local best, bestDistance = nil, 300
			local here = entry.root.Position
			for areaName, position in pairs(AREAPOS.poiCache) do
				local distance = (position - here).Magnitude
				if distance < bestDistance then
					best, bestDistance = areaName, distance
				end
			end
			area = best
		end
	end

	QUEST.areas[name] = area or false
	return area
end

function QUEST.BuildOptions()
	local npcs = QUEST.ScanNPCs()
	local list = {}
	table.clear(QUEST.labels)
	QUEST.skipped = 0
	for name, entry in pairs(npcs) do
		if QUEST.IsQuestGiver(name) then
			local area = QUEST.AreaFor(name, entry)
			local label = area and (name .. " - " .. area) or name
			QUEST.labels[label] = name
			table.insert(list, label)
		else
			QUEST.skipped = QUEST.skipped + 1
		end
	end
	-- Sorted by label, so by NPC name: the name is what is looked for.
	table.sort(list)
	QUEST.options = list
	return list
end

-- The dropdown hands back display labels. Straight lookup first; the split is
-- for a label saved by an older build (a bare "Ted") or one whose area suffix
-- has since changed, so a tick survives instead of quietly doing nothing.
function QUEST.NameFromLabel(label)
	local name = QUEST.labels[label]
	if name then
		return name
	end
	return string.match(label, "^(.-) %- ") or label
end

function QUEST.RefreshOptions()
	local list = QUEST.BuildOptions()
	if QUEST.dropdown and QUEST.dropdown.Refresh then
		pcall(function()
			QUEST.dropdown:Refresh(list)
		end)
	end
	return list
end

-- Talk to one NPC: teleport, fire its prompt, answer the dialog.
-- Returns true when the NPC was actually reached and spoken to.
function QUEST.Talk(name, entry)
	local pos
	local okPos = pcall(function()
		pos = entry.root.Position
	end)
	if not okPos or not pos then
		DebugPrint("[AutoQuest] " .. name .. " has no position any more, skipping")
		return false
	end

	-- The HumanoidRootPart, not the Vector3: TeleportPlayerOnly resolves an
	-- INSTANCE. Handing it a position threw on every single tour until
	-- 2026-09-10 ("IsA is not a valid member of Vector3"), which is why Auto
	-- Quest had never once completed a visit.
	--
	-- In reach against the prompt's own radius, AND staying there: see
	-- TPCACHE.ArriveNear for the pull-back that made the Mayor refuse every
	-- prompt on 2026-09-13.
	local reach = 10
	pcall(function()
		reach = entry.prompt.MaxActivationDistance
	end)
	-- In FRONT of the NPC, on the ground, facing it -- not on its head (the
	-- server's "too far"), and settled before the first trigger ("too fast").
	if not TPCACHE.StandFacing(entry.root, reach) then
		warn("[AutoQuest] Could not stay in front of " .. name .. " (pulled away "
			.. TPCACHE.ARRIVE_TRIES .. " times), skipping")
		return false
	end

	-- A visit is up to TWO talks. The first resolves whatever the exclamation
	-- mark was for. If that turned out to be a reward CLAIM, the NPC offers
	-- its next level straight afterwards -- so a second trigger takes it now
	-- instead of leaving it to wait out NPC_COOLDOWN (5 minutes) while it was
	-- on offer the whole time. Levels carrying a ClaimDialog are the ones this
	-- matters for; a level without one auto-rewards and hands back the next
	-- offer on the FIRST trigger, which is why Ted went reward -> "Cattle
	-- Drive" in a single talk on 2026-09-11.
	--
	-- Two is a hard ceiling rather than "keep going until it stops": a chain
	-- that never ended would pin the farm here, and one claim plus one offer
	-- is the whole of what the game hands back.
	local didSomething = false
	for round = 1, 2 do
		local seqBefore = QUESTDIALOG.seq
		QUESTDIALOG.quest = nil

		-- Triggering the prompt is what grants a finished quest's reward -- the
		-- capture showed the reward already landed before any answer was given.
		-- So for a claim this single call is the whole job.
		--
		-- **But the client being in range is not the server being convinced.**
		-- Measured 2026-09-10: after the tour's teleport the server refuses this
		-- for the best part of a second, and it says so in the RETURN VALUE --
		-- `false` for refused, `true` for accepted, with the dialog following
		-- ~50ms later. The first build threw that boolean away and read "no
		-- dialog" as "must have been a reward claim", so every single tour
		-- reported success while achieving precisely nothing.
		--
		-- So: fire and re-fire until the server says yes, the same shape the
		-- garage entry had to learn. `nil` is treated as "no answer either way"
		-- and falls through to the dialog wait rather than being read as refusal.
		--
		-- Round 2 gets a short budget on purpose: we are already standing there
		-- and the server has already accepted us once, so there is no arrival to
		-- wait out -- and "nothing more here" is the common answer, which must
		-- not cost 2.4s on every claim.
		local tries = (round == 1) and QUEST.TRIGGER_TRIES or 2
		local accepted = false
		for attempt = 1, tries do
			-- Pulled away between tries: a prompt fired from out of reach can
			-- only be refused, so go back before spending the attempt.
			local hrpNow = GetFreshHRP()
			if hrpNow and (hrpNow.Position - pos).Magnitude > reach * 0.9 then
				DebugPrint("[AutoQuest] Pulled away from " .. name .. " between tries, going back")
				TPCACHE.StandFacing(entry.root, reach)
			end
			local okTrigger, ret = pcall(function()
				return Events.UI.QuestPromptTriggered:InvokeServer(entry.model)
			end)
			if not okTrigger then
				warn("[AutoQuest] QuestPromptTriggered failed for " .. name .. ": " .. tostring(ret))
				return didSomething
			end
			if ret ~= false then
				accepted = true
				DebugPrint("[AutoQuest] " .. name .. ": prompt accepted on attempt " .. attempt)
				break
			end
			task.wait(QUEST.TRIGGER_RETRY)
		end

		if not accepted then
			-- On the follow-up talk this is the ordinary "nothing more here"
			-- answer rather than a failure: we already got what we came for.
			if didSomething then
				break
			end
			-- Proof of failure, and it is worth as much as proof of success: the
			-- visit did nothing, so it must not be reported as if it had.
			warn("[AutoQuest] " .. name .. " kept refusing the prompt ("
				.. tries .. " tries) -- the server never accepted us as being there. Nothing was accepted or claimed.")
			return false, true
		end

		-- Wait for the server to say what it is offering. A reward claim answers
		-- too ("<NPCName>'s Reward"), so silence here is NOT the normal claim
		-- path -- it is an accepted prompt that produced nothing, and it says so.
		local dialogDeadline = os.clock() + ((round == 1) and 4 or 2)
		while os.clock() < dialogDeadline and QUESTDIALOG.seq == seqBefore do
			task.wait(0.05)
		end

		local questName = QUESTDIALOG.quest
		if not questName then
			if didSomething then
				break
			end
			warn("[AutoQuest] " .. name .. ": the server took the prompt but sent no dialog, so nothing was accepted or claimed.")
			return false, true
		end

		-- "<NPCName>'s Reward" is the finished-quest dialog. The reward is
		-- already ours by now, so there is nothing to accept -- but the next
		-- level is on offer, which is what round 2 is for.
		--
		-- print, not DebugPrint: a tour that works is silent otherwise, and on
		-- 2026-09-11 that cost a round trip -- the reward landed, the next
		-- quest was taken, and with nothing in the console it read as the
		-- feature stopping half way.
		if string.find(questName, "'s Reward", 1, true) then
			print("[AutoQuest] " .. name .. ": claimed the reward for \"" .. questName .. "\"")
			QUEST.SetCurrent(name, nil)
			didSomething = true
		else
			-- Answer with what the dialog itself offers. Always sending
			-- "accept" was right for an offer but wrong for a hand-in
			-- (Grandma's RequiresTurnIn levels), which is why those never
			-- completed. "accept" stays the fallback when no option is read.
			local response = QUEST.PickResponse(QUESTDIALOG.payload)
			if response == nil then
				-- Only "decline"-type options: an in-progress quest with
				-- nothing to hand in. Leave it alone rather than decline it.
				DebugPrint("[AutoQuest] " .. name .. ": \"" .. questName .. "\" is still in progress, nothing to hand in")
				QUEST.SetCurrent(name, questName)
				return didSomething
			end
			-- Answer like a person who read the dialog: an instant answer was
			-- dropped by the server ("too fast"). Still in front of the NPC?
			task.wait(0.8)
			local hrpAns = GetFreshHRP()
			if hrpAns and (hrpAns.Position - pos).Magnitude > reach * 0.9 then
				TPCACHE.StandFacing(entry.root, reach)
			end
			local acceptBefore = QUESTDIALOG.acceptSeq
			local okAnswer, answerErr = pcall(function()
				Events.UI.SendQuestDialogResult:FireServer(entry.model, questName, response)
			end)
			if not okAnswer then
				warn("[AutoQuest] SendQuestDialogResult failed for " .. name .. ": " .. tostring(answerErr))
				return didSomething
			end
			if response == "accept" then
				-- Wait for the server's "new quest accepted". No word = it did not
				-- take: say so and return false so the tour talks to them again.
				local confirmBy = os.clock() + 3
				while QUESTDIALOG.acceptHooked and QUESTDIALOG.acceptSeq == acceptBefore and os.clock() < confirmBy do
					task.wait(0.1)
				end
				if QUESTDIALOG.acceptHooked and QUESTDIALOG.acceptSeq == acceptBefore then
					warn("[AutoQuest] " .. name .. ": answered \"accept\" for \"" .. questName
						.. "\" but the server did not confirm -- will try again")
					return didSomething, true
				end
				print("[AutoQuest] " .. name .. ": accepted \"" .. questName .. "\"")
				QUEST.SetCurrent(name, questName)
				return true
			end
			-- A hand-in: the NPC may offer the next level straight away, so
			-- this goes round once more like a reward claim does.
			print("[AutoQuest] " .. name .. ": answered \"" .. questName .. "\" with \"" .. response .. "\"")
			QUEST.SetCurrent(name, nil)
			didSomething = true
			task.wait(0.5)
		end
	end

	return didSomething
end

-- Called from the Master Cycle's SEARCHING branch. Returns immediately and
-- costs one boolean test when the feature is off.
-- One tour at a time: the master cycle, the standalone loop and the
-- "Complete All" button can all ask for one.
function QUEST.RunTourIfDue()
	if QUEST.touring then
		return 0
	end
	QUEST.touring = true
	local ok, visited = pcall(QUEST.TourBody)
	QUEST.touring = false
	-- A forced tour is one-shot, whoever ran it.
	QUEST.forceAll = false
	if not ok then
		warn("[AutoQuest] Tour failed: " .. tostring(visited))
		return 0
	end
	return visited
end

function QUEST.TourBody()
	if not QUEST.active and not QUEST.forceAll then
		return
	end
	if not QUEST.forceAll and (os.clock() - QUEST.lastTourAt) < QUEST.TOUR_EVERY then
		return
	end

	-- Never mid-lot. AUCTION.BusyReason() is the single definition of that,
	-- shared with the vehicle failsafe.
	local busy = AUCTION.BusyReason()
	if busy then
		return
	end

	local pending = QUEST.PendingNames()
	local npcs = QUEST.ScanNPCs()

	-- NOT "npcs[name]" alone: the map streams, so an NPC across the map is
	-- simply not in workspace and was silently never visited although its
	-- "!" was up. QUEST.Reach travels to load it in.
	local todo = {}
	for name in pairs(pending) do
		if QUEST.selected[name] and os.clock() > (QUEST.cooldown[name] or 0) then
			table.insert(todo, name)
		end
	end
	-- A quest in progress shows no "!", so after a rejoin we would never
	-- learn what it is. One visit per ticked NPC per session reads it (the
	-- "still in progress" dialog names the quest) so the farm can work on it.
	-- Needed to know which items to deliver, so always on.
	for name in pairs(QUEST.selected) do
		if not pending[name] and QUEST.current[name] == nil and not QUEST.learnTried[name]
			and os.clock() > (QUEST.cooldown[name] or 0) then
			QUEST.learnTried[name] = true
			table.insert(todo, name)
		end
	end
	-- Deliveries: you now own everything an NPC's quest asks you to bring,
	-- so take it to them -- no waiting for a "!" (an item quest may not show
	-- one) and no 5-minute talk cooldown, only a 10-minute delivery one.
	pcall(COLLECTORKEEP.Recount)
	for name in pairs(QUEST.selected) do
		if not pending[name] and QUEST.HasItemsFor(name)
			and os.clock() > (QUEST.deliverCooldown[name] or 0) and not table.find(todo, name) then
			-- 10 min: if the NPC did not take them, no trip every tour all night.
			QUEST.deliverCooldown[name] = os.clock() + 600
			print("[AutoQuest] You have the items for " .. name .. "'s \"" .. tostring(QUEST.current[name])
				.. "\" -- taking them over")
			table.insert(todo, 1, name)
		end
	end
	-- "Complete All Accepted Quests": every quest giver, right now, no
	-- cooldowns -- the "!" is not trusted to be up for a finished quest.
	if QUEST.forceAll then
		todo = {}
		local seenName = {}
		for name in pairs(QUEST.Defs or {}) do
			if QUEST.IsQuestGiver(name) and name ~= "Collector" and not seenName[name] then
				seenName[name] = true
				table.insert(todo, name)
			end
		end
	end
	QUEST.RebuildFarmGroups()

	-- Nothing to do is the common case: charge the timer so we do not rescan
	-- the workspace every single master tick.
	QUEST.lastTourAt = os.clock()
	if #todo == 0 then
		return
	end

	-- Priority 1..3 first (Quests tab), then alphabetical. Before this the
	-- order was alphabetical only, so the NPC you cared about could wait
	-- behind everyone else on a long tour.
	table.sort(todo, function(a, b)
		local ra, rb = QUEST.Rank(a), QUEST.Rank(b)
		if ra ~= rb then
			return ra < rb
		end
		return a < b
	end)
	DebugPrint("[AutoQuest] Touring " .. #todo .. " NPC(s): " .. table.concat(todo, ", "))

	local visited = 0
	for _, name in ipairs(todo) do
		-- Re-check every iteration: the farm (or standalone mode) can be
		-- switched off, or an auction can start, in the middle of a tour.
		if (not QUEST.active and not QUEST.forceAll) or not (FARM.active or QUEST.standalone or QUEST.forceRunning)
			or AUCTION.BusyReason() then
			break
		end
		if QUEST.forceAll then
			QUEST.forceStatus = string.format("Visiting %s (%d/%d)", name, visited + 1, #todo)
		end
		visited = visited + 1
		-- The second return of pcall is Talk's own answer, not an error, when
		-- the call did not throw. It is counted only when it says the visit
		-- actually did something -- "we went there" is not "it worked".
		local okTalk, talked = pcall(function()
			local entry = QUEST.Reach(name)
			if not entry then
				warn("[AutoQuest] " .. name .. " has a quest for you but could not be found (never seen this session, "
					.. "and no area to look in). Walk past them once and it will remember.")
				return false
			end
			local result, retry = QUEST.Talk(name, entry)
			-- Refused / no dialog / accept not confirmed: one more go after a
			-- pause, standing in front again (Talk does that itself).
			if retry and not result then
				task.wait(2)
				QUEST.npcCache = nil
				entry = QUEST.Reach(name) or entry
				result = QUEST.Talk(name, entry)
			end
			return result
		end)
		if not okTalk then
			warn("[AutoQuest] Talking to " .. name .. " failed: " .. tostring(talked))
		elseif talked then
			QUEST.handled = QUEST.handled + 1
			-- A tour is progress, so the master cycle's 90s stall watchdog
			-- must not read it as a farm standing still.
			FARM.Moved()
		end
		-- Cooled down whether it worked or not. An NPC the server keeps
		-- refusing must not become a round trip on every tour -- this is the
		-- "what clears the timer, and what if nothing does" rule.
		QUEST.cooldown[name] = os.clock() + QUEST.NPC_COOLDOWN
		-- The server re-sends the mark if there is still something to do.
		QUEST.marks[name] = nil
		task.wait(0.3)
	end

	-- The tour moved the player away from the truck. Nothing special to do:
	-- the next garage entry runs its own catch-up, which is exactly the path
	-- that already handles a truck left behind.
	QUEST.lastTourAt = os.clock()
	return visited
end

-- Get a live NPC entry, travelling to load it in if it has streamed out:
-- loaded now -> as is; else its last-seen spot; else its quest area's GPS
-- position (Modules.Quests[name].Area). Rescans for up to 4s after arriving.
function QUEST.Reach(name)
	local entry = QUEST.ScanNPCs()[name]
	if entry and entry.model.Parent and entry.root.Parent then
		return entry
	end
	local target = QUEST.lastPos[name]
	if target then
		TPCACHE.ToPosition(target)
	else
		local def = QUEST.Defs and QUEST.Defs[name]
		local area = type(def) == "table" and def.Area or nil
		if not (type(area) == "string" and TPCACHE.GoToPOI(area, area)) then
			return nil
		end
	end
	local deadline = os.clock() + 4
	repeat
		task.wait(1) -- each rescan walks the whole workspace; keep it to ~4
		QUEST.npcCache = nil
		entry = QUEST.ScanNPCs()[name]
	until entry or os.clock() > deadline
	return entry
end

-- Lower = earlier. Unranked NPCs share the last rank.
function QUEST.Rank(name)
	for slot = 1, 3 do
		if QUEST.priority[slot] == name then
			return slot
		end
	end
	return 99
end

-- Which Response to send for a dialog. The payload's shape is the server's,
-- so every { Response = "..." } anywhere in it is collected. Returns:
--   "accept" when nothing was readable (the old behaviour),
--   nil when every option is a way out (decline/close/...),
--   otherwise the best real option: hand-in words first, then "accept".
QUEST.EXIT_RESPONSES = {
	decline = true, dismiss_collector = true, close = true, goodbye = true, bye = true,
	leave = true, cancel = true, exit = true, back = true, no = true, later = true,
}

function QUEST.PickResponse(payload)
	local found = {}
	local function walk(v, depth)
		if type(v) ~= "table" or depth > 6 then
			return
		end
		if type(v.Response) == "string" then
			table.insert(found, v.Response)
		end
		for _, x in pairs(v) do
			walk(x, depth + 1)
		end
	end
	walk(payload, 0)
	if #found == 0 then
		return "accept"
	end
	local real = {}
	for _, r in ipairs(found) do
		if not QUEST.EXIT_RESPONSES[string.lower(r)] then
			table.insert(real, r)
		end
	end
	if #real == 0 then
		return nil
	end
	for _, word in ipairs({ "turn", "hand", "deliver", "give", "claim", "complete" }) do
		for _, r in ipairs(real) do
			if string.find(string.lower(r), word, 1, true) then
				return r
			end
		end
	end
	for _, r in ipairs(real) do
		if string.lower(r) == "accept" then
			return r
		end
	end
	return real[1]
end

-- Every item any quest asks you to BRING, from the game's own quest table:
-- RequiredItems keys (Grandma's Pickle Jar 1347, Cookies 1348, Milk Jug 1349
-- ...) and any ItemId named inside RequiredTasks. Plus every item whose
-- definition mentions the Power Plant parts. Feeds COLLECTORKEEP.Matches.
function QUEST.BuildKeepSet()
	local ids = COLLECTORKEEP.questIds
	table.clear(ids)
	if type(QUEST.Defs) == "table" then
		for _, npc in pairs(QUEST.Defs) do
			if type(npc) == "table" and type(npc.Levels) == "table" then
				for _, level in pairs(npc.Levels) do
					if type(level) == "table" then
						if type(level.RequiredItems) == "table" then
							for id, want in pairs(level.RequiredItems) do
								if want then
									ids[tostring(id)] = math.max(ids[tostring(id)] or 0, type(want) == "number" and want or 1)
								end
							end
						end
						if type(level.RequiredTasks) == "table" then
							for _, task_ in pairs(level.RequiredTasks) do
								if type(task_) == "table" and task_.ItemId ~= nil then
									ids[tostring(task_.ItemId)] = math.max(ids[tostring(task_.ItemId)] or 0, type(task_.Target) == "number" and task_.Target or 1)
								end
							end
						end
					end
				end
			end
		end
	end
	-- Power Plant parts: any def field whose NAME mentions the plant
	-- (e.g. PowerPlantTier / PowerPlantPart). The spot names learned at the
	-- plant (POWERPLANT.Learn) cover parts this misses.
	for id, def in pairs(Items) do
		if type(def) == "table" then
			for key in pairs(def) do
				if type(key) == "string" and string.find(string.lower(key), "powerplant", 1, true) then
					ids[tostring(id)] = math.max(ids[tostring(id)] or 0, 1)
					break
				end
			end
		end
	end
	local n = 0
	for _ in pairs(ids) do
		n = n + 1
	end
	return n
end

-- =========================================================
-- POWER PLANT PARTS (Engineer's "Restore The Plant" Tier 1-4).
-- Measured 2026-10-11 from Modules.Quests.Engineer: parts drop in auction
-- garages; "the red spots around the plant show what I need. Just walk up to
-- one and the part slots in." The spots are workspace.Areas["Power Plant"]
-- .PartsToFind. So: when the inventory holds a part, go to the plant, stand
-- on its spot, and confirm it left the inventory.
-- Matching a spot to a part is by NAME (spot name or its ItemId / ItemName /
-- PartName attribute). The first visit prints what the spots are called, so
-- a mismatch is visible in the console rather than silent.
-- =========================================================
local POWERPLANT = {
	active = false,
	lastRunAt = -math.huge,
	RUN_EVERY = 120,
	installed = 0,
	learned = false,
	spotNames = {}, -- name -> true
}

function POWERPLANT.Folder()
	local areas = workspace:FindFirstChild("Areas")
	local plant = areas and areas:FindFirstChild("Power Plant")
	return plant and plant:FindFirstChild("PartsToFind"), plant
end

-- Every key a spot answers to.
function POWERPLANT.SpotKeys(spot)
	local keys = { spot.Name }
	for _, attr in ipairs({ "ItemId", "ItemName", "PartName", "Part", "Item" }) do
		local v = spot:GetAttribute(attr)
		if v ~= nil then
			table.insert(keys, tostring(v))
		end
	end
	return keys
end

-- Remember what the spots are called (they stream out when you leave the
-- plant) and hand the names to the keep list.
function POWERPLANT.Learn()
	local folder = POWERPLANT.Folder()
	if not folder then
		return false
	end
	local sample = {}
	-- Rebuilt every visit: a filled spot disappears, so the need drops with it.
	local need = {}
	for _, spot in ipairs(folder:GetChildren()) do
		for _, key in ipairs(POWERPLANT.SpotKeys(spot)) do
			POWERPLANT.spotNames[key] = true
			need[key] = (need[key] or 0) + 1
		end
		if #sample < 8 then
			table.insert(sample, spot.Name .. "(" .. spot.ClassName .. ")")
		end
	end
	COLLECTORKEEP.plantNeed = need
	if not POWERPLANT.learned then
		POWERPLANT.learned = true
		print("[PowerPlant] " .. #folder:GetChildren() .. " red spot(s) still open, e.g. " .. table.concat(sample, ", "))
	end
	return true
end

-- Inventory entries that are parts: by keep-list id, or by a learned name.
function POWERPLANT.PartsInInventory()
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	local parts = {}
	if not ok or type(inventory) ~= "table" then
		return parts
	end
	for guid, entry in pairs(inventory) do
		local def = Items[tostring(entry.ItemId)]
		local name = type(def) == "table" and def.Name or nil
		if (name and POWERPLANT.spotNames[name]) or POWERPLANT.spotNames[tostring(entry.ItemId)] then
			table.insert(parts, { guid = guid, name = name or tostring(entry.ItemId), id = tostring(entry.ItemId) })
		end
	end
	return parts, inventory
end

function POWERPLANT.FindSpot(part)
	local folder = POWERPLANT.Folder()
	if not folder then
		return nil
	end
	for _, spot in ipairs(folder:GetChildren()) do
		for _, key in ipairs(POWERPLANT.SpotKeys(spot)) do
			if key == part.name or key == part.id then
				return spot
			end
		end
	end
	return nil
end

-- Stand on the spot, touch it, fire its prompt if it has one.
function POWERPLANT.TouchSpot(spot)
	local pos = TPCACHE.AnyToPosition(spot)
	if not pos then
		return
	end
	SafeSetHRPCFrame(CFrame.new(pos + Vector3.new(0, 3, 0)))
	task.wait(0.3)
	local hrp = GetFreshHRP()
	for _, d in ipairs(spot:GetDescendants()) do
		if hrp and d:IsA("BasePart") and firetouchinterest then
			pcall(firetouchinterest, hrp, d, 0)
			pcall(firetouchinterest, hrp, d, 1)
		elseif d:IsA("ProximityPrompt") and fireproximityprompt then
			pcall(fireproximityprompt, d)
		end
	end
	if spot:IsA("BasePart") and hrp and firetouchinterest then
		pcall(firetouchinterest, hrp, spot, 0)
		pcall(firetouchinterest, hrp, spot, 1)
	end
end

function POWERPLANT.StillHave(guid)
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	return ok and type(inventory) == "table" and inventory[guid] ~= nil
end

-- Called from the same two places as the quest tour. Returns how many spots
-- it visited (so the standalone loop knows to put you back).
function POWERPLANT.RunIfDue()
	if not POWERPLANT.active then
		return 0
	end
	if (os.clock() - POWERPLANT.lastRunAt) < POWERPLANT.RUN_EVERY then
		return 0
	end
	if AUCTION.BusyReason() then
		return 0
	end
	POWERPLANT.lastRunAt = os.clock()

	-- Never seen the spots: one trip to learn them (and this is also when a
	-- freshly started quest's first parts get noticed).
	local parts = POWERPLANT.PartsInInventory()
	if POWERPLANT.learned and #parts == 0 then
		return 0
	end

	if not TeleportToPath({ "Areas", "Power Plant", "Engineer" }, "Power Plant", "Power Plant") then
		warn("[PowerPlant] Could not get to the Power Plant")
		return 0
	end
	local deadline = os.clock() + 5
	while os.clock() < deadline and not POWERPLANT.Folder() do
		task.wait(0.25)
	end
	if not POWERPLANT.Learn() then
		warn("[PowerPlant] Areas.Power Plant.PartsToFind did not load -- no red spots to install on")
		return 1
	end

	parts = POWERPLANT.PartsInInventory()
	local visited = 1
	for _, part in ipairs(parts) do
		if not POWERPLANT.active or AUCTION.BusyReason() then
			break
		end
		local spot = POWERPLANT.FindSpot(part)
		if not spot then
			DebugPrint("[PowerPlant] No open red spot for " .. part.name .. " (already installed, or a different tier)")
		else
			visited = visited + 1
			POWERPLANT.TouchSpot(spot)
			task.wait(1.5)
			if POWERPLANT.StillHave(part.guid) then
				-- Maybe it has to be in hand: equip it and stand there again.
				pcall(function()
					REMOTES.EquipItem:FireServer(part.guid)
				end)
				task.wait(0.5)
				POWERPLANT.TouchSpot(spot)
				task.wait(1.5)
			end
			if POWERPLANT.StillHave(part.guid) then
				warn("[PowerPlant] " .. part.name .. " did not install at spot \"" .. spot.Name .. "\"")
			else
				POWERPLANT.installed = POWERPLANT.installed + 1
				print("[PowerPlant] Installed " .. part.name .. " (" .. POWERPLANT.installed .. " this session)")
				if FARM.Moved then
					FARM.Moved()
				end
			end
		end
	end
	return visited
end

-- =========================================================
-- TRAIN CONDUCTOR TICKET QUESTS (Easy / Medium / Hard).
-- What is known (2026-10-11): the Conductor on the Cargo Train platform offers
-- three jobs an hour -- Easy 5, Medium 10, Hard 15 Train Tickets -- to recover
-- lost items. Remotes: Events.TrainConductor.GetState / HandIn / ClaimDaily /
-- GetTracker (+ TrackerChanged). Item defs name where they drop
-- (SourceGarageId, e.g. "Train Container 3").
-- NOT measured: the shapes of GetState / HandIn / GetTracker. So the state is
-- read loosely (any table carrying an item id or name is a request), every
-- remote's first answer is printed once, and HandIn tries the plausible
-- argument shapes and remembers the one that works.
-- Loop: read requests -> keep exactly that many copies (COLLECTORKEEP.trainIds)
-- -> point the farm at the garages that drop them (FARM.questGroups) or pick
-- them up off the map -> hand in at the Conductor -> claim the daily.
-- =========================================================
local TRAINQUEST = {
	active = false,
	farmForIt = true,
	events = Events:FindFirstChild("TrainConductor"),
	lastRunAt = -math.huge,
	RUN_EVERY = 30,
	lastDailyAt = -math.huge,
	DAILY_EVERY = 600,
	logged = {},
	requests = {},
	goodVariant = nil,
	handedIn = 0,
	byName = nil,
	status = "Off",
	-- Which jobs to take, easiest first. Set from the Quests tab.
	difficulties = { Easy = true, Medium = true, Hard = true },
}

function TRAINQUEST.Short(v, depth)
	depth = depth or 0
	if type(v) ~= "table" then
		return typeof(v) == "Instance" and v:GetFullName() or tostring(v)
	end
	if depth > 3 then
		return "{...}"
	end
	local parts = {}
	for k, x in pairs(v) do
		table.insert(parts, tostring(k) .. "=" .. TRAINQUEST.Short(x, depth + 1))
		if #parts >= 14 then
			table.insert(parts, "...")
			break
		end
	end
	return "{" .. table.concat(parts, ", ") .. "}"
end

function TRAINQUEST.LogOnce(key, text)
	if not TRAINQUEST.logged[key] then
		TRAINQUEST.logged[key] = true
		print("[TrainQuest] " .. key .. ": " .. text)
	end
end

function TRAINQUEST.Call(name, ...)
	local remote = TRAINQUEST.events and TRAINQUEST.events:FindFirstChild(name)
	if not remote then
		return false, "no remote " .. name
	end
	local args = table.pack(...)
	return pcall(function()
		if remote:IsA("RemoteFunction") then
			return remote:InvokeServer(table.unpack(args, 1, args.n))
		end
		remote:FireServer(table.unpack(args, 1, args.n))
		return true
	end)
end

function TRAINQUEST.Succeeded(r)
	if r == true then
		return true
	end
	if type(r) == "table" then
		return r.success == true or r.Success == true or r.ok == true
	end
	return false
end

function TRAINQUEST.IdForName(name)
	if not TRAINQUEST.byName then
		TRAINQUEST.byName = {}
		for id, def in pairs(Items) do
			if type(def) == "table" and type(def.Name) == "string" then
				TRAINQUEST.byName[string.lower(def.Name)] = tostring(id)
			end
		end
	end
	return TRAINQUEST.byName[string.lower(tostring(name))]
end

-- Any table node that names an item is a request. Difficulty = the nearest
-- string key above it ("Easy", "Medium", "Hard") or its own Difficulty field.
-- Case-insensitive field read: the state's key spelling was never measured.
function TRAINQUEST.Field(t, ...)
	for _, want in ipairs({ ... }) do
		for k, v in pairs(t) do
			if type(k) == "string" and string.lower(k) == want then
				return v
			end
		end
	end
	return nil
end

function TRAINQUEST.ParseRequests(state)
	local out = {}
	local F = TRAINQUEST.Field
	local function count(t)
		local n = F(t, "amount", "count", "quantity", "required", "requiredamount", "target", "needed", "goal")
		return type(n) == "number" and n or 1
	end
	local function done(t)
		local d = F(t, "completed", "claimed", "done", "handedin", "finished")
		if d == true then
			return true
		end
		local progress = F(t, "progress", "delivered", "current")
		local n = F(t, "amount", "count", "quantity", "required", "requiredamount", "target", "needed", "goal")
		return type(progress) == "number" and type(n) == "number" and n > 0 and progress >= n
	end
	local function walk(t, key, depth)
		if type(t) ~= "table" or depth > 6 then
			return
		end
		local id = F(t, "itemid", "requireditemid", "item_id", "targetitemid", "requireditem")
		if type(id) == "table" then
			id = nil
		elseif type(id) == "string" and not Items[id] then
			id = TRAINQUEST.IdForName(id)
		end
		if id == nil then
			local name = F(t, "itemname", "item", "requireditemname", "targetitem")
			if type(name) == "number" then
				id = name
			elseif type(name) == "string" then
				id = TRAINQUEST.IdForName(name)
			end
		end
		-- A bare "Name" only counts when the node also says how many.
		if id == nil and type(t.Name or t.name) == "string" and F(t, "amount", "count", "quantity", "required") ~= nil then
			id = TRAINQUEST.IdForName(t.Name or t.name)
		end
		if id ~= nil and Items[tostring(id)] and not done(t) then
			table.insert(out, {
				id = tostring(id),
				name = Items[tostring(id)].Name,
				count = count(t),
				key = F(t, "difficulty", "tier", "jobid", "id", "key") or key,
			})
			return
		end
		-- { [itemId] = count } maps (RequiredItems style) -- only under a key
		-- that says so, or a plain {5, 10, 15} would read as items 1, 2, 3.
		local lk = string.lower(tostring(key or ""))
		local isItemMap = string.find(lk, "item", 1, true) or string.find(lk, "require", 1, true)
		for k, x in pairs(t) do
			if isItemMap and (type(x) == "number" or x == true) and Items[tostring(k)] and not done(t) then
				table.insert(out, {
					id = tostring(k),
					name = Items[tostring(k)].Name,
					count = type(x) == "number" and x or 1,
					key = key,
				})
			end
		end
		for k, x in pairs(t) do
			-- Rewards name items too (tickets) -- they are not asks.
			local skip = type(k) == "string" and string.find(string.lower(k), "reward", 1, true)
			if type(x) == "table" and not skip then
				walk(x, type(k) == "string" and k or key, depth + 1)
			end
		end
	end
	walk(state, nil, 0)
	return out
end

-- Garage types that drop this item, from its definition.
-- Order matters. Items list where they drop in `Garages` (garage types) and
-- `Area` (any garage there) -- the same fields Item Info shows. The first
-- version only read SourceGarageId, which is the TRAIN container, so a job
-- for an ordinary item pointed the farm at a container that is only around
-- once an hour and nothing got farmed. Normal garages first, train last.
function TRAINQUEST.SourcesFor(id)
	local def = Items[id]
	local out = {}
	if type(def) ~= "table" then
		return out
	end
	local seen = {}
	local function add(g)
		if type(g) == "string" and not seen[g] then
			seen[g] = true
			table.insert(out, g)
		end
	end
	local garages = def.Garages
	if type(garages) == "string" then
		add(garages)
	elseif type(garages) == "table" then
		for k, g in pairs(garages) do
			add(type(g) == "string" and g or (g == true and k or nil))
		end
	end
	if #out == 0 then
		local areas = type(def.Area) == "table" and def.Area or { def.Area }
		for _, a in pairs(areas) do
			if type(a) == "string" then
				for g in pairs(QUEST.GaragesInArea(a)) do
					add(g)
				end
			end
		end
	end
	for _, field in ipairs({ "SourceGarageId", "SourceGarageIds", "SourceGarage", "Garage", "GarageId" }) do
		local v = def[field]
		if type(v) == "string" then
			add(v)
		elseif type(v) == "table" then
			for k, x in pairs(v) do
				if type(x) == "string" then
					add(x)
				elseif x == true and type(k) == "string" then
					add(k)
				end
			end
		end
	end
	return out
end

function TRAINQUEST.Have(id)
	return COLLECTORKEEP.have[id] or 0
end

-- Reads the state and updates the keep counts + the farm's quest garages.
function TRAINQUEST.Update()
	local ok, state = TRAINQUEST.Call("GetState")
	if not ok then
		TRAINQUEST.status = "GetState failed: " .. tostring(state)
		return nil
	end
	TRAINQUEST.LogOnce("GetState", TRAINQUEST.Short(state))
	local requests = TRAINQUEST.ParseRequests(state)
	-- The tracker is the job you have TAKEN (what the HUD tracks): merge it.
	local okT, tracker = TRAINQUEST.Call("GetTracker")
	if okT and type(tracker) == "table" then
		TRAINQUEST.LogOnce("GetTracker", TRAINQUEST.Short(tracker))
		local have = {}
		for _, r in ipairs(requests) do
			have[r.id .. "|" .. tostring(r.key)] = true
		end
		for _, r in ipairs(TRAINQUEST.ParseRequests(tracker)) do
			if not have[r.id .. "|" .. tostring(r.key)] then
				table.insert(requests, r)
			end
		end
	end
	-- Print the state again whenever it changes, so a stuck job is visible.
	local shape = TRAINQUEST.Short(state)
	if shape ~= TRAINQUEST.lastShape then
		TRAINQUEST.lastShape = shape
		DebugPrint("[TrainQuest] state now: " .. shape)
	end
	TRAINQUEST.requests = requests
	pcall(COLLECTORKEEP.Recount)
	local ids, types = {}, {}
	for _, r in ipairs(requests) do
		ids[r.id] = math.max(ids[r.id] or 0, r.count)
		if TRAINQUEST.Have(r.id) < r.count and TRAINQUEST.farmForIt then
			for _, g in ipairs(TRAINQUEST.SourcesFor(r.id)) do
				-- Only names the farm knows as garage types, or it hunts a ghost.
				if table.find(FARM_GARAGE_TYPE_OPTIONS, g) then
					types[g] = true
				else
					TRAINQUEST.LogOnce("unknown garage " .. g, "not a garage type the farm knows; " .. r.name .. " cannot be farmed for")
				end
			end
		end
	end
	-- Task-style jobs ("win 3 auctions at Stable Garage", "find items in the
	-- Farmyard"): any garage type or area named anywhere in the job (rewards
	-- aside) is farmed too.
	if TRAINQUEST.farmForIt then
		local function scan(t, depth)
			if type(t) ~= "table" or depth > 6 then
				return
			end
			for k, v in pairs(t) do
				local skip = type(k) == "string" and string.find(string.lower(k), "reward", 1, true)
				if not skip then
					if type(v) == "string" then
						if table.find(FARM_GARAGE_TYPE_OPTIONS, v) then
							types[v] = true
						else
							for g in pairs(QUEST.GaragesInArea(v)) do
								types[g] = true
							end
						end
					elseif type(v) == "table" then
						scan(v, depth + 1)
					end
				end
			end
		end
		scan(state, 0)
		if okT then
			scan(tracker, 0)
		end
	end
	COLLECTORKEEP.trainIds = ids
	TRAINQUEST.farmTypes = types
	-- Rank 50: after the NPCs you ranked 1-3, before unranked ones (99).
	FARM.questGroups.train = next(types) and { rank = 50, types = types } or nil
	return requests
end

-- A requested item lying on the map (lost items): a model with its exact
-- name and a prompt. Picked up like any farm item.
function TRAINQUEST.PickUpFromMap(r)
	local target
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled then
			local model = d:FindFirstAncestorWhichIsA("Model")
			if model and (model.Name == r.name or model:GetAttribute("ItemId") == tonumber(r.id)
				or tostring(model:GetAttribute("ItemId")) == r.id) then
				target = d
				break
			end
		end
	end
	if not target then
		return false
	end
	local pos = TPCACHE.AnyToPosition(target.Parent)
	if not pos then
		return false
	end
	TPCACHE.ToPosition(pos)
	task.wait(0.6)
	pcall(fireproximityprompt, target)
	task.wait(1)
	print("[TrainQuest] Picked up " .. r.name .. " off the map")
	return true
end

-- One guid of this item from the inventory, or nil.
function TRAINQUEST.GuidOf(id)
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if ok and type(inventory) == "table" then
		for guid, entry in pairs(inventory) do
			if tostring(entry.ItemId) == id and entry.Favorited ~= true then
				return guid
			end
		end
	end
	return nil
end

-- HandIn's arguments were never measured: try each plausible shape, keep the winner.
function TRAINQUEST.HandIn(r)
	local guid = TRAINQUEST.GuidOf(r.id)
	local variants = {
		{ "key", function() return TRAINQUEST.Call("HandIn", r.key) end },
		{ "guid", function() return TRAINQUEST.Call("HandIn", guid) end },
		{ "key+guid", function() return TRAINQUEST.Call("HandIn", r.key, guid) end },
		{ "itemId", function() return TRAINQUEST.Call("HandIn", tonumber(r.id) or r.id) end },
		{ "none", function() return TRAINQUEST.Call("HandIn") end },
	}
	if TRAINQUEST.goodVariant then
		for i, v in ipairs(variants) do
			if v[1] == TRAINQUEST.goodVariant then
				table.remove(variants, i)
				table.insert(variants, 1, v)
				break
			end
		end
	end
	for _, v in ipairs(variants) do
		if (v[1] == "key" and r.key == nil) or ((v[1] == "guid" or v[1] == "key+guid") and not guid) then
			continue
		end
		local ok, res = v[2]()
		TRAINQUEST.LogOnce("HandIn(" .. v[1] .. ")", TRAINQUEST.Short(ok and res or ("error " .. tostring(res))))
		if ok and TRAINQUEST.Succeeded(res) then
			TRAINQUEST.goodVariant = v[1]
			TRAINQUEST.handedIn = TRAINQUEST.handedIn + 1
			print("[TrainQuest] Handed in " .. r.name .. " (" .. tostring(r.key) .. ")")
			return true
		end
		task.wait(0.6)
	end
	return false
end

-- ---------------------------------------------------------
-- Talking to the Conductor the way a player does: open his window, press
-- his own buttons. No remote for "accept a job" exists (TrainConductor has
-- only GetState / HandIn / ClaimDaily / GetTracker), so taking a job lives
-- in his UI or his dialog -- pressing those buttons runs the game's own code
-- with the game's own arguments, whatever they are.
-- ---------------------------------------------------------

-- Every visible button on screen: { button, text }. Text = its own text, the
-- labels inside it and its name, lower-cased.
function TRAINQUEST.Buttons()
	local out = {}
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then
		return out
	end
	for _, b in ipairs(pg:GetDescendants()) do
		if b:IsA("GuiButton") and b.Visible then
			local shown, node = true, b.Parent
			while node and node ~= pg do
				if (node:IsA("GuiObject") and not node.Visible) or (node:IsA("LayerCollector") and not node.Enabled) then
					shown = false
					break
				end
				node = node.Parent
			end
			if shown then
				local text = (b:IsA("TextButton") and b.Text or "") .. " " .. b.Name
				for _, l in ipairs(b:GetDescendants()) do
					if l:IsA("TextLabel") then
						text = text .. " " .. l.Text
					end
				end
				table.insert(out, { button = b, text = string.lower(text) })
			end
		end
	end
	return out
end

-- Press a button as a click would: its own connections first, then
-- firesignal, then a real mouse click on its centre.
function TRAINQUEST.Press(button)
	if type(getconnections) == "function" then
		for _, sig in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up" }) do
			local okC, conns = pcall(getconnections, button[sig])
			if okC and type(conns) == "table" and #conns > 0 then
				for _, c in ipairs(conns) do
					pcall(function()
						if c.Fire then
							c:Fire()
						elseif c.Function then
							c.Function()
						end
					end)
				end
				return true
			end
		end
	end
	if type(firesignal) == "function" then
		for _, sig in ipairs({ "Activated", "MouseButton1Click" }) do
			if pcall(firesignal, button[sig]) then
				return true
			end
		end
	end
	-- No real-mouse fallback on purpose: a screen click lands on whatever is
	-- on top there -- this menu included -- and that is exactly the stray
	-- "auto clicking" an overnight run cannot have.
	return false
end

-- Press the first NEW button (not on screen before we talked -- so never one
-- of this script's own) whose text has one of `words`. Returns its text.
function TRAINQUEST.PressWord(before, words, avoid)
	local buttons = TRAINQUEST.Buttons()
	for _, w in ipairs(words) do
		for _, rec in ipairs(buttons) do
			if not before[rec.button] and string.find(rec.text, w, 1, true) then
				local bad = false
				for _, a in ipairs(avoid or {}) do
					if string.find(rec.text, a, 1, true) then
						bad = true
						break
					end
				end
				if not bad then
					TRAINQUEST.Press(rec.button)
					return rec.text
				end
			end
		end
	end
	return nil
end

TRAINQUEST.ACCEPT_WORDS = { "accept", "start", "take", "begin", "confirm", "select", "choose", "yes" }
TRAINQUEST.HANDIN_WORDS = { "hand in", "handin", "turn in", "deliver", "submit", "give", "complete" }
TRAINQUEST.CLAIM_WORDS = { "claim", "collect" }
TRAINQUEST.CLOSE_WORDS = { "close", "exit", "leave", "goodbye", "bye", "done", "back" }

-- Go to the Conductor, stand in front of him, open his window/dialog.
-- Returns the set of buttons that were on screen BEFORE (to tell his new
-- ones apart), or nil when he could not be reached.
function TRAINQUEST.OpenConductor()
	if not TPCACHE.GoTrainPlatform() then
		return nil
	end
	task.wait(0.8)
	local npc = TPCACHE.FindConductor()
	if not npc then
		TRAINQUEST.status = "Could not find the Conductor at the platform"
		return nil
	end
	local root = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart or npc:FindFirstChildWhichIsA("BasePart", true)
	local prompt = npc:FindFirstChildWhichIsA("ProximityPrompt", true)
	local reach = prompt and prompt.MaxActivationDistance or 10
	if root then
		TPCACHE.StandFacing(root, reach)
	end
	local before = {}
	for _, rec in ipairs(TRAINQUEST.Buttons()) do
		before[rec.button] = true
	end
	local seqBefore = QUESTDIALOG.seq
	for attempt = 1, 4 do
		if prompt then
			pcall(function()
				prompt.RequiresLineOfSight = false
			end)
			if prompt.Name == "NPCQuestPrompt" then
				pcall(function()
					Events.UI.QuestPromptTriggered:InvokeServer(npc)
				end)
			end
			pcall(fireproximityprompt, prompt)
		end
		task.wait(1)
		-- Opened: new buttons on screen, or a quest-style dialog arrived.
		local opened = QUESTDIALOG.seq ~= seqBefore
		for _, rec in ipairs(TRAINQUEST.Buttons()) do
			if not before[rec.button] then
				opened = true
				break
			end
		end
		if opened then
			break
		end
	end
	-- What he showed, once per session: the one line needed if a word is off.
	local texts = {}
	for _, rec in ipairs(TRAINQUEST.Buttons()) do
		if not before[rec.button] then
			table.insert(texts, "[" .. rec.text .. "]")
		end
	end
	TRAINQUEST.LogOnce("Conductor buttons", #texts > 0 and table.concat(texts, " ") or "none appeared")
	TRAINQUEST.dialogSeq = seqBefore
	return before, npc
end

-- Wanted difficulties, easiest first.
function TRAINQUEST.Wanted()
	local out = {}
	for _, d in ipairs({ "Easy", "Medium", "Hard" }) do
		if TRAINQUEST.difficulties[d] then
			table.insert(out, d)
		end
	end
	return out
end

-- Take jobs: in his window press "Easy" (etc.) then "Accept"; in a quest
-- dialog answer with the option naming the difficulty. Returns true when
-- the state shows a job afterwards.
function TRAINQUEST.TakeJobs()
	local before, npc = TRAINQUEST.OpenConductor()
	if not before then
		return false
	end
	-- Quest-style dialog (same protocol as the other NPCs).
	if QUESTDIALOG.seq ~= TRAINQUEST.dialogSeq and QUESTDIALOG.quest then
		local options = {}
		local function walk(v, depth)
			if type(v) == "table" and depth < 7 then
				if type(v.Response) == "string" then
					table.insert(options, v.Response)
				end
				for _, x in pairs(v) do
					walk(x, depth + 1)
				end
			end
		end
		walk(QUESTDIALOG.payload, 0)
		TRAINQUEST.LogOnce("Conductor dialog", QUESTDIALOG.quest .. " options: " .. table.concat(options, ", "))
		local pick
		for _, d in ipairs(TRAINQUEST.Wanted()) do
			for _, o in ipairs(options) do
				if string.find(string.lower(o), string.lower(d), 1, true) then
					pick = o
					break
				end
			end
			if pick then
				break
			end
		end
		pick = pick or QUEST.PickResponse(QUESTDIALOG.payload)
		if pick then
			task.wait(0.8)
			pcall(function()
				Events.UI.SendQuestDialogResult:FireServer(npc, QUESTDIALOG.quest, pick)
			end)
			print("[TrainQuest] Answered the Conductor with \"" .. pick .. "\"")
			task.wait(1)
		end
	end
	-- His own window.
	for _, d in ipairs(TRAINQUEST.Wanted()) do
		local hit = TRAINQUEST.PressWord(before, { string.lower(d) })
		if hit then
			task.wait(0.6)
			local acc = TRAINQUEST.PressWord(before, TRAINQUEST.ACCEPT_WORDS, { "decline", "cancel" })
			print("[TrainQuest] Pressed \"" .. hit .. "\"" .. (acc and (" then \"" .. acc .. "\"") or ""))
			task.wait(0.8)
		end
	end
	-- A window with only an Accept (one job offered).
	local acc = TRAINQUEST.PressWord(before, TRAINQUEST.ACCEPT_WORDS, { "decline", "cancel" })
	if acc then
		print("[TrainQuest] Pressed \"" .. acc .. "\"")
		task.wait(0.8)
	end
	local claim = TRAINQUEST.PressWord(before, TRAINQUEST.CLAIM_WORDS)
	if claim then
		print("[TrainQuest] Pressed \"" .. claim .. "\"")
		task.wait(0.6)
	end
	TRAINQUEST.PressWord(before, TRAINQUEST.CLOSE_WORDS)
	local requests = TRAINQUEST.Update() or {}
	if #requests == 0 then
		warn("[TrainQuest] Talked to the Conductor but no job shows as taken. The \"Conductor buttons\" "
			.. "line above lists what his window offered -- send it over if this keeps happening.")
	end
	return #requests > 0
end

-- Hand in through his window (and the HandIn remote). Returns how many.
function TRAINQUEST.HandInAll(ready)
	local before = TRAINQUEST.OpenConductor()
	if not before then
		return 0
	end
	local n = 0
	for _ = 1, #ready + 1 do
		local hit = TRAINQUEST.PressWord(before, TRAINQUEST.HANDIN_WORDS)
		if not hit then
			break
		end
		print("[TrainQuest] Pressed \"" .. hit .. "\"")
		n = n + 1
		TRAINQUEST.handedIn = TRAINQUEST.handedIn + 1
		task.wait(1)
		TRAINQUEST.PressWord(before, TRAINQUEST.CLAIM_WORDS)
		task.wait(0.5)
	end
	-- Remote fallback for whatever his window did not take.
	pcall(COLLECTORKEEP.Recount)
	for _, r in ipairs(ready) do
		if TRAINQUEST.Have(r.id) >= r.count and TRAINQUEST.HandIn(r) then
			n = n + 1
		end
	end
	TRAINQUEST.PressWord(before, TRAINQUEST.CLOSE_WORDS)
	return n
end

function TRAINQUEST.ClaimDailyIfDue()
	if os.clock() - TRAINQUEST.lastDailyAt < TRAINQUEST.DAILY_EVERY then
		return
	end
	TRAINQUEST.lastDailyAt = os.clock()
	local ok, res = TRAINQUEST.Call("ClaimDaily")
	TRAINQUEST.LogOnce("ClaimDaily", TRAINQUEST.Short(ok and res or ("error " .. tostring(res))))
end

-- Called by the Master Cycle (SEARCHING) and by the standalone quest loop.
-- Returns how many trips it made (0 = nothing moved you).
function TRAINQUEST.RunIfDue()
	if not TRAINQUEST.active or not TRAINQUEST.events then
		return 0
	end
	if os.clock() - TRAINQUEST.lastRunAt < TRAINQUEST.RUN_EVERY then
		return 0
	end
	if AUCTION.BusyReason() then
		return 0
	end
	TRAINQUEST.lastRunAt = os.clock()
	TRAINQUEST.ClaimDailyIfDue()

	local requests = TRAINQUEST.Update()
	if not requests then
		return 0
	end
	local trips = 0

	-- "they keep getting teleported to the conductor even when they have the
	-- quest" (2026-10-13). Every trip to him now goes through VisitDue: at
	-- most one trip per 10 min whatever the reason, except straight after a
	-- hand-in that worked (to take the next job).
	local function VisitDue()
		return TRAINQUEST.visitNow or os.clock() - (TRAINQUEST.lastVisitAt or -math.huge) >= 600
	end
	local function Visited()
		TRAINQUEST.lastVisitAt = os.clock()
		TRAINQUEST.visitNow = false
	end

	-- Nothing offered/accepted yet: talk to the Conductor once, then re-read.
	-- (A task-style job reads as no ITEMS but does name garages: that is a
	-- taken job, not "no job".)
	if #requests == 0 and next(TRAINQUEST.farmTypes or {}) == nil then
		-- Jobs refresh hourly. Backs off when talking does not produce a job
		-- it can read (10 -> 20 -> 40 -> 60 min) -- which is also what
		-- happens when you DO have a job the game describes in a way this
		-- cannot read, so that case costs one trip an hour at most.
		if os.clock() - (TRAINQUEST.lastTalkAt or -math.huge) < (TRAINQUEST.talkGap or 600) or not VisitDue() then
			TRAINQUEST.status = "No open job right now (they refresh hourly)"
			return 0
		end
		TRAINQUEST.lastTalkAt = os.clock()
		Visited()
		TRAINQUEST.status = "No job taken -- going to the Conductor to take one"
		trips = trips + 1
		TRAINQUEST.lastClaimVisit = os.clock()
		local okTake, takeErr = pcall(TRAINQUEST.TakeJobs)
		if not okTake then
			warn("[TrainQuest] Taking a job failed: " .. tostring(takeErr))
		end
		requests = TRAINQUEST.Update() or {}
		if #requests == 0 and next(TRAINQUEST.farmTypes or {}) == nil then
			TRAINQUEST.talkGap = math.min((TRAINQUEST.talkGap or 600) * 2, 3600)
			TRAINQUEST.status = "No job could be read after talking to the Conductor (they refresh hourly).\n"
				.. "Next try in " .. math.floor(TRAINQUEST.talkGap / 60) .. " min. "
				.. "If the game shows one taken, press 'Dump Train State' and send the console."
			return trips
		end
	end
	TRAINQUEST.talkGap = 600 -- a job is open: back to the normal pace
	-- Task-style job (garages, no items): every 20 min, go press his
	-- hand-in / claim buttons in case it is finished.
	if #requests == 0 and os.clock() - (TRAINQUEST.lastClaimVisit or -math.huge) > 1200 and VisitDue() then
		TRAINQUEST.lastClaimVisit = os.clock()
		Visited()
		trips = trips + 1
		pcall(TRAINQUEST.HandInAll, {})
	end

	-- Short ones lying on the map: go get them.
	for _, r in ipairs(requests) do
		if TRAINQUEST.Have(r.id) < r.count and #TRAINQUEST.SourcesFor(r.id) == 0 then
			if TRAINQUEST.PickUpFromMap(r) then
				trips = trips + 1
			end
		end
	end
	pcall(COLLECTORKEEP.Recount)

	-- Hand in everything we now have enough of.
	local ready = {}
	for _, r in ipairs(requests) do
		if TRAINQUEST.Have(r.id) >= r.count then
			table.insert(ready, r)
		end
	end
	-- A hand-in that did not take used to be retried on EVERY 30s pass -- a
	-- trip to the Conductor every half minute, all night. Now it waits 10 min,
	-- then 20, 40, 60 between tries.
	local handInWait = os.clock() - (TRAINQUEST.handInFailAt or -math.huge) < (TRAINQUEST.handInGap or 0)
	if #ready > 0 and not handInWait and VisitDue() then
		trips = trips + 1
		Visited()
		local okH, n = pcall(TRAINQUEST.HandInAll, ready)
		if not okH or n == 0 then
			if not okH then
				warn("[TrainQuest] Hand-in failed: " .. tostring(n))
			else
				warn("[TrainQuest] Have the items but nothing was handed in -- see the \"Conductor buttons\" and HandIn lines above")
			end
			TRAINQUEST.handInFailAt = os.clock()
			TRAINQUEST.handInGap = math.min(math.max((TRAINQUEST.handInGap or 0) * 2, 600), 3600)
		else
			TRAINQUEST.handInFailAt, TRAINQUEST.handInGap = nil, 0
			-- Job done: take the next one straight away instead of in 10 min.
			TRAINQUEST.lastTalkAt = nil
			TRAINQUEST.visitNow = true
		end
		TRAINQUEST.Update()
	end

	local lines = {}
	for _, r in ipairs(TRAINQUEST.requests) do
		local src = TRAINQUEST.SourcesFor(r.id)
		table.insert(lines, string.format("%s: %s %d/%d%s", tostring(r.key or "?"), r.name,
			math.min(TRAINQUEST.Have(r.id), r.count), r.count, #src > 0 and (" -- from " .. table.concat(src, ", ")) or " -- on the map"))
	end
	local farming = {}
	for g in pairs(TRAINQUEST.farmTypes or {}) do
		table.insert(farming, g)
	end
	table.sort(farming)
	if #farming > 0 then
		table.insert(lines, "Farming: " .. table.concat(farming, ", ", 1, math.min(#farming, 6))
			.. (#farming > 6 and (" +" .. (#farming - 6) .. " more") or ""))
		if not FARM.active then
			table.insert(lines, "!! Turn Auto Farm ON -- it is what wins those garages.")
			TRAINQUEST.LogOnce("farm off", "the job's items come from garages; Auto Farm is off, so nothing is farmed. Turn Auto Farm on.")
		end
	elseif #TRAINQUEST.requests > 0 then
		table.insert(lines, "These items do not drop from any garage the farm knows.")
	end
	TRAINQUEST.status = (#lines > 0 and table.concat(lines, "\n") or "No open job") .. "\nHanded in this session: " .. TRAINQUEST.handedIn
	if trips > 0 and FARM.Moved then
		FARM.Moved()
	end
	return trips
end

-- Prints everything needed to finish wiring this up if the game's shapes differ.
function TRAINQUEST.Dump()
	print("===== TRAIN CONDUCTOR DUMP =====")
	if not TRAINQUEST.events then
		print("Events.TrainConductor not found")
		return
	end
	for _, child in ipairs(TRAINQUEST.events:GetChildren()) do
		print("remote: " .. child.ClassName .. " " .. child.Name)
	end
	for _, name in ipairs({ "GetState", "GetTracker" }) do
		local ok, res = TRAINQUEST.Call(name)
		print(name .. ": " .. TRAINQUEST.Short(ok and res or ("error " .. tostring(res))))
	end
	local mods = ReplicatedStorage:FindFirstChild("Modules")
	local cfg = mods and mods:FindFirstChild("TrainConductorConfig")
	if cfg then
		local ok, data = pcall(require, cfg)
		print("TrainConductorConfig: " .. TRAINQUEST.Short(ok and data or ("error " .. tostring(data))))
	end
	local client = mods and mods:FindFirstChild("TrainConductorClient")
	if client and type(decompile) == "function" then
		local ok, src = pcall(decompile, client)
		if ok and type(src) == "string" then
			for line in string.gmatch(src, "[^\n]+") do
				if string.find(line, "Server", 1, true) or string.find(line, "Difficulty", 1, true)
					or string.find(line, "HandIn", 1, true) or string.find(line, "Tracker", 1, true) then
					print("  client> " .. string.sub(line, 1, 200))
				end
			end
		end
	end
	local reqs = TRAINQUEST.ParseRequests(select(2, TRAINQUEST.Call("GetState")) or {})
	print("parsed " .. #reqs .. " request(s):")
	for _, r in ipairs(reqs) do
		print(string.format("  [%s] %s x%d (id %s) from: %s", tostring(r.key), r.name, r.count, r.id,
			table.concat(TRAINQUEST.SourcesFor(r.id), ", ")))
	end
	print("===== END =====")
end

-- =========================================================
-- QUEST-DRIVEN FARMING: each NPC's CURRENT quest picks the garages.
-- Every talk tells us the quest's name (accept / "still in progress" /
-- hand-in), and Modules.Quests has that level's tasks:
--   auction_win GarageId        -> that garage (Ted: Stable Garage)
--   find_* / AreaScoped tasks    -> any garage in the NPC's area (Farmyard)
--   power_plant_part_tier*       -> Power Plant garages
--   RequiredItems                -> the garages that drop those items
-- (sell / clean / repair tasks need no garage: AutoSell / Wash / the
-- wrench do them.) The farm hunts those garages, NPC priority 1 first, until
-- the NPC's quest changes -- i.e. it was handed in and the next one taken.
-- =========================================================
QUEST.current = {}      -- npcName -> QuestName of the quest in progress
QUEST.learnTried = {}   -- npcName -> true: visited once just to read its quest
QUEST.areaGarages = {}  -- area -> { garageName = true } (cache)

function QUEST.LevelFor(name, questName)
	local def = QUEST.Defs and QUEST.Defs[name]
	if type(def) ~= "table" or type(def.Levels) ~= "table" or not questName then
		return nil
	end
	for _, level in pairs(def.Levels) do
		if type(level) == "table" and level.QuestName == questName then
			return level
		end
	end
	return nil
end

function QUEST.GaragesInArea(area)
	if not area then
		return {}
	end
	if QUEST.areaGarages[area] then
		return QUEST.areaGarages[area]
	end
	local set = {}
	for _, g in ipairs(FARM_GARAGE_TYPE_OPTIONS) do
		local ok, a = pcall(function()
			return Areas.GetGarageAreaName(g)
		end)
		if ok and a == area then
			set[g] = true
		end
	end
	QUEST.areaGarages[area] = set
	return set
end

function QUEST.GaragesForLevel(name, level)
	local types = {}
	local function add(g)
		if type(g) ~= "string" then
			return
		end
		if table.find(FARM_GARAGE_TYPE_OPTIONS, g) then
			types[g] = true
			return
		end
		QUEST.warnedGarage = QUEST.warnedGarage or {}
		if not QUEST.warnedGarage[g] then
			QUEST.warnedGarage[g] = true
			warn("[AutoQuest] " .. name .. "'s quest wants garage \"" .. g .. "\", which the farm does not know")
		end
	end
	local def = QUEST.Defs and QUEST.Defs[name]
	local area = (type(def) == "table" and type(def.Area) == "string" and def.Area) or QUEST.AreaFor(name)
	if type(level.RequiredTasks) == "table" then
		for _, t in pairs(level.RequiredTasks) do
			if type(t) == "table" then
				local kind = tostring(t.Type or "")
				if t.GarageId then
					add(t.GarageId)
				elseif string.sub(kind, 1, 16) == "power_plant_part" then
					for g in pairs(QUEST.GaragesInArea("Power Plant")) do
						types[g] = true
					end
				elseif t.AreaScoped or string.sub(kind, 1, 5) == "find_" then
					for g in pairs(QUEST.GaragesInArea(area)) do
						types[g] = true
					end
				end
			end
		end
	end
	if type(level.RequiredItems) == "table" then
		for id, want in pairs(level.RequiredItems) do
			if want then
				for _, g in ipairs(TRAINQUEST.SourcesFor(tostring(id))) do
					add(g)
				end
			end
		end
	end
	return types
end

-- Can the bot finish this quest with NO work from you? Repairs need the
-- wrench by hand, so a quest with a repair task is skipped (the farm does not
-- waste hours on garages for a quest that would stall on it anyway).
-- Clean = Auto Wash, sell = Auto Place's shelf sales, wins/finds = the farm.
QUEST.MANUAL_TASKS = { repair_item = "repairs" }

function QUEST.Doable(level)
	if type(level.RequiredTasks) == "table" then
		for _, t in pairs(level.RequiredTasks) do
			local why = type(t) == "table" and QUEST.MANUAL_TASKS[tostring(t.Type)]
			if why then
				return false, why
			end
		end
	end
	return true
end

-- Total task size, so among equal priorities the SHORTEST quest goes first.
function QUEST.Size(level)
	local total = 0
	if type(level.RequiredTasks) == "table" then
		for _, t in pairs(level.RequiredTasks) do
			if type(t) == "table" and type(t.Target) == "number" then
				total = total + t.Target
			end
		end
	end
	return total
end

-- Rebuilds every "npc:<name>" farm group from what we know right now.
function QUEST.RebuildFarmGroups()
	for key in pairs(FARM.questGroups) do
		if string.sub(key, 1, 4) == "npc:" then
			FARM.questGroups[key] = nil
		end
	end
	if not (QUEST.active and QUEST.farmForQuests) then
		return
	end
	for name, questName in pairs(QUEST.current) do
		if QUEST.selected[name] then
			local level = QUEST.LevelFor(name, questName)
			local doable, why = false, nil
			if level then
				doable, why = QUEST.Doable(level)
			end
			if level and not doable then
				QUEST.skipNoted = QUEST.skipNoted or {}
				if QUEST.skipNoted[name] ~= questName then
					QUEST.skipNoted[name] = questName
					print("[AutoQuest] Skipping " .. name .. "'s \"" .. questName .. "\": it needs " .. why .. " (by hand)")
				end
			elseif level then
				local types = QUEST.GaragesForLevel(name, level)
				if next(types) ~= nil then
					-- Your priority first; then the shortest quest first.
					FARM.questGroups["npc:" .. name] = {
						rank = QUEST.Rank(name) + math.min(QUEST.Size(level), 9999) / 10000,
						types = types,
					}
				end
			end
		end
	end
end

-- Called by QUEST.Talk with what the dialog said (nil = handed in / claimed).
function QUEST.SetCurrent(name, questName)
	if QUEST.current[name] ~= questName then
		QUEST.current[name] = questName
		if questName then
			local wants = QUEST.ItemsWanted(name)
			local list = {}
			for id, n in pairs(wants) do
				local def = Items[id]
				table.insert(list, n .. "x " .. (type(def) == "table" and tostring(def.Name) or id))
			end
			print("[AutoQuest] " .. name .. " is on \"" .. questName .. "\""
				.. (#list > 0 and (" -- will deliver: " .. table.concat(list, ", ")) or ""))
		end
	end
	QUEST.RebuildFarmGroups()
end

-- itemId -> count the NPC's current quest asks you to bring ({} if none).
function QUEST.ItemsWanted(name)
	local out = {}
	local level = QUEST.LevelFor(name, QUEST.current[name])
	if type(level) == "table" and type(level.RequiredItems) == "table" then
		for id, want in pairs(level.RequiredItems) do
			if want then
				out[tostring(id)] = type(want) == "number" and want or 1
			end
		end
	end
	return out
end

-- True when the inventory holds everything the NPC's current quest asks for.
function QUEST.HasItemsFor(name)
	local wants = QUEST.ItemsWanted(name)
	if next(wants) == nil then
		return false
	end
	for id, n in pairs(wants) do
		if (COLLECTORKEEP.have[id] or 0) < n then
			return false
		end
	end
	return true
end

-- Cancel every quest (the game's Quests menu does it one at a time through
-- Quest.GetQuestCancelInfo / Quest.CancelQuest). Their arguments were never
-- measured, so: ask the info remote what is cancellable, then for every
-- quest NPC try the plausible argument shapes and stop at the first one the
-- server says yes to. Every first answer is printed.
function QUEST.CancelAll()
	local qe = Events:FindFirstChild("Quest")
	local infoR = qe and qe:FindFirstChild("GetQuestCancelInfo")
	local cancelR = qe and qe:FindFirstChild("CancelQuest")
	if not cancelR then
		warn("[AutoQuest] The game has no Quest.CancelQuest remote -- cannot cancel")
		return 0
	end
	local function call(remote, ...)
		local args = table.pack(...)
		return pcall(function()
			if remote:IsA("RemoteFunction") then
				return remote:InvokeServer(table.unpack(args, 1, args.n))
			end
			remote:FireServer(table.unpack(args, 1, args.n))
			return nil
		end)
	end
	local function yes(r)
		return r == true or (type(r) == "table" and (r.success == true or r.Success == true or r.ok == true))
	end
	-- Who to try: every quest giver, plus any name the info remote lists.
	local names, seen = {}, {}
	local function addName(n)
		if type(n) == "string" and not seen[n] then
			seen[n] = true
			table.insert(names, n)
		end
	end
	if infoR then
		local ok, info = call(infoR)
		print("[AutoQuest] GetQuestCancelInfo() -> " .. TRAINQUEST.Short(ok and info or ("error " .. tostring(info))))
		if ok and type(info) == "table" then
			for k, v in pairs(info) do
				addName(type(k) == "string" and k or nil)
				if type(v) == "table" then
					addName(v.NPCName or v.npcName or v.NPC or v.npc or v.Name or v.name)
				end
			end
		end
	end
	for n in pairs(QUEST.Defs or {}) do
		if QUEST.IsQuestGiver(n) then
			addName(n)
		end
	end
	-- The server rate-limits cancelling (that is the "cooldown" that made
	-- one click cancel only some). So: one call every GAP seconds, an answer
	-- that mentions a cooldown / wait / too fast is waited out and retried,
	-- and the whole list is gone through again until a pass cancels nothing.
	local GAP = 1.2
	local function isCooldown(res)
		local text = string.lower(TRAINQUEST.Short(res))
		return string.find(text, "cooldown", 1, true) or string.find(text, "wait", 1, true)
			or string.find(text, "too fast", 1, true) or string.find(text, "slow down", 1, true)
			or string.find(text, "rate", 1, true)
	end
	local cancelled, logged = 0, false
	local done = {}
	for pass = 1, 4 do
		local thisPass = 0
		for _, npc in ipairs(names) do
			if not done[npc] then
				local questName = QUEST.current[npc]
				local variants = {
					{ "npc", npc },
					{ "npc+quest", npc, questName },
					{ "quest", questName },
					{ "table", { NPCName = npc, QuestName = questName } },
				}
				-- The shape that worked once is tried first from then on.
				if QUEST.cancelVariant then
					for i, v in ipairs(variants) do
						if v[1] == QUEST.cancelVariant then
							table.remove(variants, i)
							table.insert(variants, 1, v)
							break
						end
					end
				end
				if infoR and not logged then
					local ok, info = call(infoR, npc)
					if ok and info ~= nil then
						logged = true
						print("[AutoQuest] GetQuestCancelInfo(\"" .. npc .. "\") -> " .. TRAINQUEST.Short(info))
					end
				end
				for _, v in ipairs(variants) do
					if v[2] ~= nil then
						local ok, res = call(cancelR, v[2], v[3])
						local tries = 0
						while ok and not yes(res) and isCooldown(res) and tries < 5 do
							tries = tries + 1
							task.wait(3)
							ok, res = call(cancelR, v[2], v[3])
						end
						task.wait(GAP)
						if ok and yes(res) then
							QUEST.cancelVariant = v[1]
							cancelled, thisPass = cancelled + 1, thisPass + 1
							done[npc] = true
							QUEST.current[npc] = nil
							print("[AutoQuest] Cancelled " .. npc .. "'s quest" .. (questName and (" \"" .. questName .. "\"") or ""))
							break
						end
						if not QUEST.cancelLogged then
							QUEST.cancelLogged = true
							print("[AutoQuest] CancelQuest(" .. tostring(v[2]) .. ") -> " .. TRAINQUEST.Short(ok and res or ("error " .. tostring(res))))
						end
						-- Once a shape is known, the others are not worth a call each.
						if QUEST.cancelVariant then
							break
						end
					end
				end
			end
		end
		if thisPass == 0 then
			break
		end
		print("[AutoQuest] Cancel pass " .. pass .. ": " .. thisPass .. " cancelled, checking again for any left")
		task.wait(2)
	end
	QUEST.RebuildFarmGroups()
	print("[AutoQuest] Cancel all: " .. cancelled .. " quest(s) cancelled")
	if cancelled == 0 then
		warn("[AutoQuest] Nothing was cancelled. If you do have quests, the CancelQuest line above shows the game's answer -- send it over.")
	end
	return cancelled
end

-- Auto Quest / Power Plant WITHOUT Auto Farm. The Master Cycle owns the HRP
-- while the farm runs, so this loop only acts while the farm is OFF, and
-- stands down the moment it comes on (the farm then calls both itself).
-- After a trip it puts you back where you were standing.
function QUEST.StartStandalone()
	if LOOPGUARDS.questStandalone then
		return
	end
	LOOPGUARDS.questStandalone = true
	task.spawn(function()
		while (QUEST.active or POWERPLANT.active or TRAINQUEST.active) and LOOPGUARDS.questStandalone and SESSION.alive do
			-- Fishing owns your spot like the farm does; a lost-item sweep
			-- holds the mover lock -- wait for either rather than fight it.
			if not FARM.active and not AUTOFISH.active and SESSION.Claim("quests") then
				QUEST.standalone = true
				local hrp = GetFreshHRP()
				local home = hrp and hrp.CFrame
				local ok, visited = pcall(function()
					local a = QUEST.RunTourIfDue() or 0
					local b = POWERPLANT.RunIfDue() or 0
					local c = TRAINQUEST.RunIfDue() or 0
					return a + b + c
				end)
				if not ok then
					warn("[AutoQuest] Tour failed, continuing: " .. tostring(visited))
				elseif type(visited) == "number" and visited > 0 and home and not FARM.active then
					task.wait(0.5)
					SafeSetHRPCFrame(home)
					DebugPrint("[AutoQuest] Back where you were before the tour")
				end
				QUEST.standalone = false
				SESSION.Release("quests")
			end
			task.wait(5)
		end
		QUEST.standalone = false
		LOOPGUARDS.questStandalone = false
	end)
end

-- MASTER CYCLE -- SOLE owner of the HRP while FARM.active.
-- SEARCHING -> BIDDING (passive) -> COLLECTING -> Unload -> Place.
-- No other loop moves the HRP: standalone AutoCollect stops on
-- `not FARM.active`, PlaceItems never navigates (the plot TP is done
-- HERE), Wash/Grade are passive.

-- Lock that PREVENTS RunPlacingPhase from being called (never triggers
-- anything itself). True = farm/collection continue, but no base TP and
-- no inventory unload.

-- Number of containers to collect before forcing an unload (placement).
-- 1 = unload after EVERY container (default, ultra-safe). Up to 7.
-- Set via the "Place every N containers" dropdown on the Auto Farm tab.

-- Counter of containers actually collected since the last placement.
-- Only incremented on a won+emptied container, not on a Min Bid skip.

local function RunCollectingPhase()
	-- STUCK GUARD (2026-10-13, "it would be stuck trying to pickup items").
	-- Pickups only land when the truck is close, and this loop used to retry
	-- forever when it was not -- all night, if the truck had despawned. Now:
	-- no item gone for 8s -> bring the truck over (again every 20s); nothing
	-- picked up for 150s -> leave what is left and go to the next garage.
	local lastCount, lastProgressAt, lastTruckAt = nil, os.clock(), 0
	while AUCTION.state == "COLLECTING" and FARM.active do
		local count = CountOwnedCarryablePrompts()
		if lastCount == nil or count < lastCount then
			lastProgressAt = os.clock()
		end
		lastCount = count
		local stuckFor = os.clock() - lastProgressAt
		if count > 0 and stuckFor > 8 and os.clock() - lastTruckAt > 20 then
			lastTruckAt = os.clock()
			local hrp = GetFreshHRP()
			if hrp then
				print("[AutoFarm] Items are not going into the truck -- bringing the truck over")
				pcall(CatchUpVehicle, hrp.Position)
			end
		end
		if count > 0 and stuckFor > 150 then
			warn("[AutoFarm] Could not pick up the last " .. count .. " item(s) for 2.5 min -- leaving them and moving on")
			-- Weak keys: an item the game removes is forgotten with it.
			SESSION.abandoned = SESSION.abandoned or setmetatable({}, { __mode = "k" })
			local carryables = workspace:FindFirstChild("_Carryables")
			for _, item in ipairs(carryables and carryables:GetChildren() or {}) do
				if item:GetAttribute("Owner") == LocalPlayer.UserId then
					SESSION.abandoned[item] = true
				end
			end
			SetAuctionState("SEARCHING")
			break
		end
		-- NOT gated on COLLECT.active, deliberately (worklist D1, found
		-- 2026-09-10). Auto Farm forces that flag on when it starts, but
		-- nothing stopped it being unticked afterwards -- and then the won lot
		-- was never picked up, owned carryables held the FSM in COLLECTING,
		-- every following garage's bid UI was discarded by the FSM ("Bidding
		-- UI opened while COLLECTING, ignored"), the Min Bid check that lives
		-- inside that path never ran, and the farm won each cheap lot by
		-- default -- paying an entry fee a time and dropping more loot.
		-- Collecting what the farm wins is the Master Cycle's job and is not
		-- optional while it runs.
		CollectOnce(function()
			return AUCTION.state == "COLLECTING" and FARM.active
		end)

		-- UNCONDITIONAL YIELD: a pass that collects nothing and yields
		-- nowhere loops thousands of times per second -> starved client ->
		-- crash with no Lua error.
		-- NEVER make this wait conditional. Its LENGTH is fair game though:
		-- 0.2s rather than 0.5s, matching the sibling debounce loop, since all
		-- this decides is how soon the phase notices the ground is clear.
		task.wait(0.2)
	end
end

local function RunUnloadingPhase()
	DebugPrint("[MasterCycle] UNLOADING phase (truck unload)")
	UnloadCargo()
end

-- Places until only non-placeable items remain. Base full: we wait for
-- auto-accept sales, or we block with an alert if auto-accept is off
-- (otherwise we would wait forever).
local function RunPlacingPhase()
	DebugPrint("[MasterCycle] Phase PLACING")

	-- The ONLY place in the script that TPs to the plot. Truck left behind.
	-- We target a Furniture model, not the plot: its pivot can be too far
	-- for streaming to have loaded the shelves.
	local plot = GetPlayerPlot()
	if not plot then
		warn("[MasterCycle] Plot not found, placement phase cancelled")
		return
	end

	local anchor = GetPlotFurnitureAnchor(plot)
	if not anchor then
		warn("[MasterCycle] No Furniture anchor found, placement phase cancelled")
		return
	end

	-- GRADE BEFORE PLACE: fill every free Wash/Grade slot from what was just
	-- unloaded BEFORE anything is shelved, instead of racing the 1s pipeline
	-- loop. Items Grade will take are also held back by IsPlaceableNow
	-- (ShouldGradeEntry), so even with all slots busy they wait their turn.
	if AnyHandlerEnabled() then
		local okPre, errPre = pcall(ProcessInventoryOnePass)
		if not okPre then
			warn("[MasterCycle] Grade-first pass failed: " .. tostring(errPre))
		end
	end

	TeleportPlayerOnly(anchor)

	-- Adaptive streaming wait: instead of a fixed task.wait(0.6) (often
	-- too short for a big base or an arrival from a distant area -> empty
	-- podiums not yet loaded made the base read as full), we loop until
	-- the number of loaded slots reaches what the game config announces,
	-- capped at 4s.
	do
		local streamDeadline = os.clock() + 4
		while os.clock() < streamDeadline and FARM.active do
			local _, allNow, expectedNow = GetAvailableShelfSlots(plot)
			if #allNow > 0 and (expectedNow == 0 or #allNow >= expectedNow) then
				break
			end
			task.wait(0.25)
		end
	end

	local baseFullSince = nil -- os.clock() of the moment the base became full
	local notReadyDeadline = nil -- os.clock() of the 1st "plot not ready" attempt

	while FARM.active do
		local placed, remaining, refused = PlaceItems()

		if placed > 0 then
			-- Progress: we reset both waiting states.
			notReadyDeadline = nil
			baseFullSince = nil
			HideInventoryFullMessage()
			HideCriticalMessage()
			DebugPrint(string.format("[MasterCycle] %d item(s) placed, %d remaining", placed, remaining))
			task.wait(0.3)

		elseif remaining == nil then
			-- Plot not found, inventory unreachable, OR shelf slots not yet
			-- loaded (streaming unfinished -- common when arriving from a
			-- distant area). NOT "nothing to place": we retry, with a cap so
			-- we do not stay stuck for good if the plot is really broken
			-- rather than merely slow.
			if not notReadyDeadline then
				notReadyDeadline = os.clock() + 15
			end
			if os.clock() > notReadyDeadline then
				warn("[MasterCycle] Plot/shelf slots still not ready after 15s, giving up on this placement pass")
				break
			end
			DebugPrint("[MasterCycle] Plot/shelf slots not ready yet, retrying...")
			task.wait(1)

		elseif remaining == 0 then
			-- Nothing left to place NOW: either the inventory holds only
			-- non-placeable items (unload complete), or the server rejected
			-- the last candidates (`refused`) even though free slots were
			-- available -- either way we go back to farming rather than
			-- blocking on "BASE FULL". Rejected items stay in the inventory
			-- and will be retried on the next cycle.
			HideInventoryFullMessage()
			HideCriticalMessage()
			if refused and refused > 0 then
				DebugPrint(string.format("[MasterCycle] %d item(s) refused by the server despite free slots -- back to Farm, will retry", refused))
			else
				DebugPrint("[MasterCycle] Inventory emptied, back to Farm")
			end
			break

		else
			-- placed == 0 AND remaining > 0: BASE FULL. We have items to
			-- place but no free slot. We wait for the auto-accept trade to
			-- sell placed items and free up shelves.
			notReadyDeadline = nil
			if not baseFullSince then
				baseFullSince = os.clock()
			end

			if not OFFERS.autoAccept then
				-- Without auto-accept, nothing will ever free the base: we
				-- block with a fullscreen alert. We do NOT go back to
				-- farming (farming with a full inventory is pointless).
				HideInventoryFullMessage()
				ShowCriticalMessage("BASE FULL - Enable 'Auto-Accept Offers' to sell and free up space. Farm paused.")
				warn("[MasterCycle] Base full AND Auto-Accept Offers disabled -> farm blocked (enable auto-accept)")
			else
				HideCriticalMessage()
				ShowInventoryFullMessage("Base full - waiting for sales to free space (auto-accept)...")
			end

			task.wait(3) -- we retry regularly, infinite retry (intended)
		end
	end

	-- Counter reset: we just unloaded, we start from zero.
	FARM.sinceLastPlace = 0
end

local function MasterCycleLoop()
	if LOOPGUARDS.masterCycle then
		-- Normal for a double click. A dead end if the loop died without
		-- clearing the guard -- and the two are indistinguishable in silence,
		-- which is exactly how a farm that will never start again presents.
		warn("[AutoFarm] the master cycle is already marked running, not starting a second one")
		return
	end
	LOOPGUARDS.masterCycle = true
	warn("[AutoFarm] master cycle started")

	-- Adopt loot left over from a previous run. A re-execute (hot reload, or
	-- a rejoin) restarts the FSM at SEARCHING with no memory of the auction it
	-- won, but the lot it won is still on the ground -- and that deadlocks:
	-- TryEnterNextAuction refuses to enter a new garage while items of ours
	-- are down, and the only state that picks them up is COLLECTING, reached
	-- solely by the "Sold to" dialogue, which fired before this run existed.
	-- Neither side moves and nothing says so. Start in COLLECTING instead;
	-- the debounce loop drops back to SEARCHING once the ground is clear.
	if AUCTION.state == "SEARCHING" and CountOwnedCarryablePrompts() > 0 then
		warn("[AutoFarm] loot from an earlier run is still on the ground -- collecting it before searching")
		SetAuctionState("COLLECTING")
	end

	task.spawn(function()
		-- A state that never moves is the other way this stalls in silence:
		-- TryEnterNextAuction is only reached while SEARCHING, so anything
		-- stuck elsewhere prints nothing at all. It needs BOTH halves though:
		-- timing the state alone cried wolf constantly, because SEARCHING is
		-- the catch-all state and sits happily over 90s while the farm hops
		-- garages or drives home to place. FARM.progressAt is the other half.
		local stateSeen, stateSince = nil, os.clock()
		while FARM.active do
			if AUCTION.state ~= stateSeen then
				stateSeen = AUCTION.state
				stateSince = os.clock()
			elseif AUCTION.winRunning then
				-- Auto-Win holds BIDDING on purpose while it waits the auction
				-- out from outside the zone. That is the plan, not a stall.
				stateSince = os.clock()
			else
				local quietSince = stateSince
				if (FARM.progressAt or 0) > quietSince then
					quietSince = FARM.progressAt
				end
				if (os.clock() - quietSince) > 90 then
					stateSince = os.clock()
					FARM.progressAt = os.clock()
					FARM.Idle("nothing has moved for 90s -- no garage taken, no bid, no collection (auction state: " .. tostring(stateSeen) .. ")")
				end
			end
			-- pcall around EACH iteration: without it, an uncaught error
			-- anywhere in this branch (TryEnterNextAuction,
			-- RunPlacingPhase/PlaceItems included) crashes the coroutine
			-- BEFORE reaching "LOOPGUARDS.masterCycle = false" on exiting
			-- the while -- the guard stays stuck at true forever, so even
			-- unchecking/rechecking Auto Farm restarts nothing
			-- (StartLoop-style: "if LOOPGUARDS.masterCycle then return end").
			-- This is the most likely scenario behind "AutoPlace stops by
			-- itself, no visible error" -- the error does exist, but nothing
			-- displays it if the F9 console is not open. We log and continue
			-- rather than letting the whole master cycle die.
			local iterOk, iterErr = pcall(function()
			if AUCTION.winRunning then
				-- The Auto-Win sequence owns the HRP for the time it takes to
				-- leave the zone and wait for the win. The master must neither
				-- teleport nor change garage: it waits.
				--
				-- 0.15s, not 0.5s: this is purely how quickly the master
				-- NOTICES the sequence has finished, and at 0.5s it was adding
				-- up to half a second of its own after every single win.
				task.wait(0.15)
			elseif AUCTION.state == "SEARCHING" then
				-- The Master Cycle owns the HRP, so the vehicle failsafe (which
				-- seats the player) runs here rather than on its own timer loop.
				VEHICLESPAWN.RunAutoIfDue()
				-- Same reason, same place: the quest tour moves the player, so it
				-- cannot be a rival loop. Returns on a boolean when Auto Quest is
				-- off, which is the default -- a farm with the toggle off runs
				-- exactly the sequence it ran before this existed.
				QUEST.RunTourIfDue()
				-- Same kind: installs Power Plant parts you are carrying.
				-- Returns on a boolean when its toggle is off.
				POWERPLANT.RunIfDue()
				-- Train Conductor tickets: hand-ins + daily. While a job is
				-- open it also points the farm at the containers that drop
				-- the asked items (FARM.questGroups).
				TRAINQUEST.RunIfDue()
				-- Third of the same kind: the Collector stands at your base
				-- and is gone in about six minutes, so this teleports too and
				-- therefore belongs here rather than on a loop of its own.
				COLLECTORAUTO.RunIfDue()
				TryEnterNextAuction()
				FARM.PacedWait(2)
			elseif AUCTION.state == "COLLECTING" then
				RunCollectingPhase()

				-- Safeguard: RunCollectingPhase stops as soon as the state
				-- leaves COLLECTING, but nothing guarantees _Carryables is
				-- really empty at that moment (transition slightly early
				-- depending on latency/item count). We recheck and retry as
				-- long as items of ours remain, capped in time so the whole
				-- Auto Farm is not blocked on a permanently uncollectable
				-- item.
				local recheckDeadline = os.clock() + 30
				while FARM.active and CountOwnedCarryablePrompts() > 0 and os.clock() < recheckDeadline do
					-- Same reason as RunCollectingPhase: not gated on
					-- COLLECT.active.
					CollectOnce(function()
						return FARM.active
					end)
					task.wait(0.5)
				end
				if FARM.active and CountOwnedCarryablePrompts() > 0 then
					warn("[MasterCycle] Items still left in _Carryables after 30s, moving on anyway")
				end

				if FARM.active then
					-- Container actually collected: we increment the counter.
					FARM.sinceLastPlace = FARM.sinceLastPlace + 1

					-- We ALWAYS unload the truck into the inventory after the
					-- container (otherwise items stay in the truck).
					RunUnloadingPhase()

					-- Placement (and base TP) only if AutoPlace is active AND the
					-- container threshold is reached. Safeguard: inventory >90%
					-- forces placement so we do not collect into a full inventory.
					local placementRan = false
					if not FARM.placeDisabled then
						local reachedThreshold = FARM.sinceLastPlace >= FARM.placeEveryN
						local invForced = IsInventoryNearFull(0.90)

						if reachedThreshold or invForced then
							if invForced and not reachedThreshold then
								DebugPrint("[MasterCycle] Inventory ~full (>90%) before threshold, forcing placement")
							end
							RunPlacingPhase()

							-- Short cooldown after placement: without it,
							-- TryEnterNextAuction restarts on the next
							-- iteration although we have only just arrived
							-- at the base. If the farm area is far (so
							-- unloaded by streaming from the base), eligible
							-- comes back empty and the
							-- STREAMING_ANCHOR_PATHS fallback teleports
							-- immediately to the area anchor -- the player
							-- gets sent straight back, as if the placement
							-- had never happened. Leaves time to really get
							-- going again properly.
							FARM.cooldownUntil = os.clock() + 3
							placementRan = true
						else
							DebugPrint(string.format("[MasterCycle] %d/%d containers before unload", FARM.sinceLastPlace, FARM.placeEveryN))
						end
					else
						DebugPrint("[MasterCycle] AutoPlace disabled, skipping placement (inventory not emptied)")
					end

					-- The whole pass above blocks this coroutine, so the watchdog
					-- below only gets to look once it is over -- and would read the
					-- minutes a full placement run takes as a state that never moved.
					FARM.Moved()

					-- The garage is finished: collected, truck emptied, and placed
					-- if it was due. Everything the 15s entry cooldown was armed
					-- for at commit time has now actually happened, so whatever is
					-- left of it is dead time -- the same dead time the Min Bid
					-- skip and the lost auction already had taken off them. The
					-- WIN path never got it, which is how winning ended up being
					-- the slowest way to reach the next garage.
					--
					-- Placement is the exception: it arms its own 3s deliberately
					-- (see above) and that one stands. The hurry window still
					-- opens either way, so the retry cadence is 0.4s instead of 2s
					-- the moment the gate is clear.
					if not placementRan then
						FARM.cooldownUntil = 0
					end
					FARM.Hurry()
				end
			else
				-- BIDDING: we do nothing, we let REMOTES.UpdateBidEvent handle it.
				FARM.PacedWait(0.5)
			end
			end)
			if not iterOk then
				warn("[MasterCycle] Iteration failed, continuing: " .. tostring(iterErr))
				-- Guaranteed yield even if the error recurs immediately
				-- (e.g. state broken in a loop): without it, an error that
				-- resurfaces without ever passing through an inner task.wait()
				-- would loop empty -> starved client.
				task.wait(0.5)
			end
		end
		LOOPGUARDS.masterCycle = false
		warn("[AutoFarm] master cycle stopped")
		-- The master has stopped (Auto Farm turned off): we clean up the
		-- overlays that might have stayed displayed (e.g. base full alert).
		HideInventoryFullMessage()
		HideCriticalMessage()
	end)
end

