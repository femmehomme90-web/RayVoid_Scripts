-- =========================================================
-- UNLOAD HANDLE (dev reload) -- keep this LAST in the file
-- =========================================================
-- Registered only now, once every table, listener and UI object it touches
-- exists. The handshake at the top of the file calls it when this file is
-- re-executed, so a reload never doubles the UI, the listeners or the
-- loops. Order matters: flags first (loops exit on their next iteration),
-- listeners next (no more events into a dead instance), UI last.
--
-- `selfOnly` is the losing side of a simultaneous start (see the token
-- check below). It skips the two steps that reach outside this run:
-- DestroyAll would sweep the WINNER's window out of CoreGui, and clearing
-- getgenv().StorageHunters would erase the winner's handle.
do
	SESSION.Unload = function(selfOnly)
		SESSION.alive = false

		-- 1. Every loop flag off.
		for key in pairs(LOOPGUARDS) do
			LOOPGUARDS[key] = false
		end
		FARM.active = false
		COLLECT.active = false
		AUCTION.bidActive = false
		AUCTION.winActive = false
		OFFERS.autoAccept = false
		WASHGRADE.washActive = false
		WASHGRADE.gradeActive = false
		WASHGRADE.gradeVaultActive = false
		AUTOVAULT.active = false
		ENERGYDRINK.autoBuyEnabled = false
		ENERGYDRINK.autoUseEnabled = false
		AUTOSELL.enabled = false
		AUTOFISH.active = false
		GOLDPAN.active = false
		GOLDPAN.sellBrokenEnabled = false
		GOLDPAN.WW.Outlaw.active = false
		GOLDPAN.WW.Race.active = false
		GOLDPAN.WW.TownDefense.active = false
		AUTOMUSEUM.active = false
		AUTOREPAIR.active = false
		URANIUM.active = false
		QUEST.active = false
		COLLECTORKEEP.active = false
		VEHICLESPAWN.autoEnabled = false
		antiAfkActive = false
		-- The game's idle rejoin goes back to how the game shipped it; the
		-- next run takes its own hold if it needs one.
		SESSION.idleRejoinHolds = {}
		pcall(SESSION.ApplyIdleRejoin, true, "unload")
		-- A reload must not leave a retry loop teleporting the player
		-- out from under the new run.
		RECONNECT.enabled = false
		-- Before the listeners go: the hide hold is one of them, and without
		-- it a player hidden under the town would fall out of the map.
		pcall(GOLDPAN.WW.TownDefense.Surface)

		-- Keep the mesh fingerprints learned this session: a reload in
		-- the middle of preparing a rarity would otherwise throw away up
		-- to 20s of model loading, and the user would pay it again.
		pcall(IGNOREBID.SaveCache)

		-- 2. Every root-level listener.
		for _, conn in ipairs(SESSION.connections) do
			pcall(function() conn:Disconnect() end)
		end
		SESSION.connections = {}

		-- 3. UI: the windows we build ourselves, then RayVoid (Destroy
		-- removes this run's window, DestroyAll sweeps any leftovers).
		-- Ours are parented to PlayerGui, so RayVoid's sweep does not
		-- reach them and a reload would leave them on screen forever.
		pcall(EVENTPREDICT.Close)
		pcall(RULES.ED.Close)
		pcall(function() Ui:Destroy() end)
		if not selfOnly then
			pcall(function() Ui:DestroyAll() end)
		end

		if selfOnly then
			print("[Reload] duplicate copy shut itself down")
		else
			if type(getgenv) == "function" then
				getgenv().StorageHunters = nil
			end
			print("[Reload] previous instance unloaded")
		end
	end

	-- Did another copy of this file start while this one was loading? The
	-- executor's teleport queue used to hand out three at once, and each of
	-- them ran its own auction FSM, its own reconnect loop and its own UI.
	-- Only the copy that still owns the token stays.
	if SESSION.token and type(getgenv) == "function" and getgenv().StorageHuntersRun ~= SESSION.token then
		warn("[Reload] another copy of the script started while this one was loading -- shutting this copy down so only one runs")
		SESSION.Unload(true)
	elseif type(getgenv) == "function" then
		getgenv().StorageHunters = {
			Unload = SESSION.Unload,
			-- Test hook: Auto Pause can only be exercised by a stranger joining.
			-- This hands it a stand-in, e.g. CheckPlayer({ Name = "Someone" }), so
			-- the switch-off can be verified alone in a server. A reload puts the
			-- saved toggles back afterwards.
			CheckPlayer = RECONNECT.CheckPlayer,
		}
	end
end
