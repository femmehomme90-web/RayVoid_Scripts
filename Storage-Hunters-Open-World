-- Every control a tab creates goes through here: counted for the loading
-- status, and the build breathes (see BUILD PACING at the top).
function SESSION.Built(kind, first)
	SESSION.made = SESSION.made + 1
	SESSION.madeAt = os.clock()
	if kind == "CreateSection" and type(first) == "string" then
		SESSION.stage = first
	end
	SESSION.Breathe()
end

function SESSION.WrapTab(tab)
	if type(tab) ~= "table" then
		return tab
	end
	for key, real in pairs(tab) do
		if type(real) == "function" and string.sub(key, 1, 6) == "Create" then
			tab[key] = function(self, ...)
				local out = table.pack(real(self, ...))
				SESSION.Built(key, ...)
				return table.unpack(out, 1, out.n)
			end
		end
	end
	return tab
end

SESSION.realCreateTab = Window.CreateTab
Window.CreateTab = function(self, ...)
	return SESSION.WrapTab(SESSION.realCreateTab(self, ...))
end

-- TEXT THAT FITS ITS BOX (2026-10-13, "make sure the words actually fit in
-- the box. like under Load my backup when the script starts, the words are
-- outside"). A RayVoid label is a fixed-height box: a sentence longer than
-- one line wraps straight out of its top and bottom. Each label now grows to
-- its text, and a paragraph whose text runs past its box grows too. Both are
-- re-checked whenever their text changes (status boxes update all the time).
function SESSION.FitLabel(frame)
	local title = frame:FindFirstChild("Title")
	if not (title and title:IsA("TextLabel")) then
		return
	end
	if frame:GetAttribute("SHBaseH") == nil then
		frame:SetAttribute("SHBaseH", math.max(frame.Size.Y.Offset, 30))
	end
	local base = frame:GetAttribute("SHBaseH")
	local inset = title.Position.X.Offset
	title.TextWrapped = true
	title.AnchorPoint = Vector2.new(title.AnchorPoint.X, 0.5)
	title.Position = UDim2.new(title.Position.X.Scale, inset, 0.5, 0)
	local h = math.ceil(title.TextBounds.Y)
	if h <= 0 then
		return
	end
	local width = UDim.new(1, -(inset + 10))
	if title.Size.X ~= width or math.abs(title.Size.Y.Offset - h) > 1 then
		title.Size = UDim2.new(width, UDim.new(0, h))
	end
	local want = math.max(base, h + 18)
	if math.abs(frame.Size.Y.Offset - want) > 1 then
		frame.Size = UDim2.new(frame.Size.X, UDim.new(frame.Size.Y.Scale, want))
	end
end

function SESSION.FitParagraph(frame)
	local content = frame:FindFirstChild("Content")
	if not (content and content:IsA("TextLabel")) then
		return
	end
	content.TextWrapped = true
	local title = frame:FindFirstChild("Title")
	if title and title:IsA("TextLabel") then
		title.TextWrapped = true
	end
	local textH = math.ceil(content.TextBounds.Y)
	if textH <= 0 or frame.AbsoluteSize.Y <= 0 then
		return
	end
	if frame:GetAttribute("SHBaseH") == nil then
		frame:SetAttribute("SHBaseH", frame.Size.Y.Offset)
	end
	local top = content.AbsolutePosition.Y - frame.AbsolutePosition.Y
	local need = math.ceil(top + textH + 12)
	-- Only boxes the text actually overflows are touched (or ones grown here
	-- before, so they can shrink back when their text gets shorter).
	if need <= frame.AbsoluteSize.Y + 1 and not frame:GetAttribute("SHGrown") then
		return
	end
	frame:SetAttribute("SHGrown", true)
	local want = math.max(frame:GetAttribute("SHBaseH"), need)
	if math.abs(frame.Size.Y.Offset - want) > 1 then
		frame.Size = UDim2.new(frame.Size.X, UDim.new(frame.Size.Y.Scale, want))
	end
	if content.Size.Y.Scale == 0 and math.abs(content.Size.Y.Offset - textH) > 1 then
		content.Size = UDim2.new(content.Size.X, UDim.new(0, textH))
	end
end

function SESSION.FitElement(child)
	if not child:IsA("Frame") then
		return
	end
	local fit
	if child:FindFirstChild("Content") and child:FindFirstChild("Title") then
		fit = SESSION.FitParagraph
	elseif child.Name == "Label" and child:FindFirstChild("Title") then
		fit = SESSION.FitLabel
	else
		return
	end
	local function run()
		pcall(fit, child)
	end
	for _, part in ipairs({ child:FindFirstChild("Title"), child:FindFirstChild("Content") }) do
		if part and part:IsA("TextLabel") then
			part:GetPropertyChangedSignal("TextBounds"):Connect(run)
		end
	end
	child:GetPropertyChangedSignal("AbsoluteSize"):Connect(run)
	task.defer(run)
end

-- Watches every page (one per tab) for the labels and paragraphs put on it.
function SESSION.FitPages()
	local elements = SESSION.rayfield and SESSION.rayfield.Main:FindFirstChild("Elements")
	if not elements then
		warn("[UI] menu window not found -- long labels may spill out of their boxes")
		return
	end
	for _, page in ipairs(elements:GetChildren()) do
		if page:IsA("ScrollingFrame") and page.Name ~= "Template" then
			for _, child in ipairs(page:GetChildren()) do
				SESSION.FitElement(child)
			end
			SESSION.Track(page.ChildAdded:Connect(SESSION.FitElement))
			-- Taller boxes must still scroll fully into view ("i cant scroll
			-- all the way down to read the full thing", 2026-10-11).
			local layout = page:FindFirstChildOfClass("UIListLayout")
			if layout and page.AutomaticCanvasSize == Enum.AutomaticSize.None then
				local function sync()
					page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
				end
				SESSION.Track(layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(sync))
				sync()
			end
		end
	end
end

-- =========================================================
-- SAFE CONFIG LOADING (2026-10-13). Delta users: "i can't load my previous
-- configs and it will automatically close my roblox app". RayVoid's loader
-- applies every saved control on the same frame, so every feature saved as ON
-- (farm, quests, fishing, lost items, fly...) starts in the same instant --
-- more than a phone takes. Every way RayVoid loads a config (its Load button
-- and auto-load on launch) goes through Ui:LoadConfiguration, so it is
-- replaced here with one that:
--   * reads the file inside pcall (a bad file is a message, not a crash)
--   * applies the settings first (lists, boxes), a few per frame
--   * then switches features ON one at a time, 0.5s apart
--   * skips controls this version no longer has
-- The same applier loads the backup file from Player & Safety (written to the
-- executor's main folder, for executors where RayVoid's own save fails).
-- =========================================================
SESSION.cfg = { loading = false }

function SESSION.cfg.Notify(title, text)
	pcall(function()
		Ui:Notify({ Title = title, Content = text, Duration = 5, Force = true })
	end)
end

function SESSION.cfg.Apply(data, label, atLaunch)
	if SESSION.cfg.loading then
		warn("[Config] Already loading settings -- wait for that to finish")
		return false
	end
	SESSION.cfg.loading = true
	local ok, err = pcall(function()
		if atLaunch then
			-- Right after joining: let the character and the game settle first.
			-- Up to 5 min: a phone builds the menu in breaths (BUILD PACING).
			local waited = 0
			while not (SESSION.built and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
				and waited < 300 and SESSION.alive do
				task.wait(0.5)
				waited = waited + 0.5
			end
			task.wait(3)
		end
		local flags = Ui.Flags or {}
		local settings, toggles, skipped = {}, {}, 0
		for name, value in pairs(data) do
			local flag = flags[name]
			if type(flag) ~= "table" or type(flag.Set) ~= "function" or flag.Type == "ColorPicker" then
				skipped = skipped + 1
			elseif typeof(flag.CurrentValue) == "boolean" then
				-- Already in that state: nothing to do (most saved toggles are off).
				if flag.CurrentValue ~= (value == true) then
					table.insert(toggles, { name, flag, value == true })
				end
			else
				table.insert(settings, { name, flag, value })
			end
		end
		for i, rec in ipairs(settings) do
			pcall(function()
				rec[2]:Set(rec[3])
			end)
			if i % 5 == 0 then
				task.wait()
			end
		end
		-- Offs first, then ons; Auto Farm last so everything it reads is set.
		table.sort(toggles, function(a, b)
			if a[3] ~= b[3] then
				return not a[3]
			end
			if (a[1] == "AutoFarmToggle") ~= (b[1] == "AutoFarmToggle") then
				return b[1] == "AutoFarmToggle"
			end
			return a[1] < b[1]
		end)
		for _, rec in ipairs(toggles) do
			if not SESSION.alive then
				return
			end
			task.wait(rec[3] and 0.5 or 0.05)
			local okSet, setErr = pcall(function()
				rec[2]:Set(rec[3])
			end)
			if not okSet then
				warn("[Config] " .. rec[1] .. " could not be restored: " .. tostring(setErr))
			end
		end
		print("[Config] Loaded " .. tostring(label) .. ": " .. #settings .. " setting(s), "
			.. #toggles .. " switch(es) changed" .. (skipped > 0 and (", " .. skipped .. " old one(s) skipped") or ""))
	end)
	SESSION.cfg.loading = false
	if ok then
		SESSION.cfg.Notify(tostring(label), "Settings loaded.")
	else
		warn("[Config] Loading " .. tostring(label) .. " failed: " .. tostring(err))
		SESSION.cfg.Notify(tostring(label), "Could not load these settings.")
	end
	return ok
end

-- Reads one JSON settings file. Returns the flag table, or nil + why.
function SESSION.cfg.Read(path)
	if type(readfile) ~= "function" then
		return nil, "this executor cannot read files"
	end
	local ok, raw = pcall(function()
		if type(isfile) == "function" and not isfile(path) then
			return nil
		end
		return readfile(path)
	end)
	if not ok or type(raw) ~= "string" or raw == "" then
		return nil, "file not found"
	end
	local okJ, parsed = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not okJ or type(parsed) ~= "table" then
		return nil, "the file is damaged"
	end
	if parsed.placeId ~= nil and parsed.placeId ~= game.PlaceId then
		return nil, "it was made for another game"
	end
	return type(parsed.flags) == "table" and parsed.flags or parsed
end

-- RayVoid keeps its configs at RAYVOID/<PlaceId>/<name>.rfld.
pcall(function()
	Ui.LoadConfiguration = function(_, slotName, retry)
		if type(slotName) ~= "string" or slotName == "" then
			return
		end
		local data, why = SESSION.cfg.Read("RAYVOID/" .. tostring(game.PlaceId) .. "/" .. slotName .. ".rfld")
		if not data then
			warn("[Config] Could not load " .. slotName .. ": " .. tostring(why))
			SESSION.cfg.Notify(slotName, "Could not load: " .. tostring(why))
			return
		end
		task.spawn(SESSION.cfg.Apply, data, slotName, retry == true)
	end
end)

