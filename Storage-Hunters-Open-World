-- The server charges the entry fee the instant it ACCEPTS us into a garage,
-- about 20ms after the prompt is fired. Captured live 2026-09-09: that is the
-- only unambiguous "you are in" signal the game sends. A refused entry sends
-- ToggleAuctionArea(true) exactly like an accepted one, and no fee -- which is
-- why firing the prompt and hoping looked like the garage silently ignoring us.
REMOTES.AuctionFeePaid = REMOTES.AuctionEvents:WaitForChild("AuctionFeePaid")
SESSION.Track(REMOTES.AuctionFeePaid.OnClientEvent:Connect(function(amount)
	FARM.feePaidSeq = (FARM.feePaidSeq or 0) + 1
	-- The fee IS the commit resolving: we are in, and the ~6s countdown the
	-- game runs before bidding is now none of our business. Clearing this
	-- stops the dead-commit grace from firing on a garage we have paid for --
	-- measured entry-to-bidding is 6.5s against an 8s grace, which is not
	-- enough margin to leave to chance.
	FARM.committedAt = nil
	DebugPrint("[AutoFarm] Entry accepted, fee " .. tostring(amount) .. " paid")
end))
REMOTES.NPCChat = REMOTES.UIEvents:WaitForChild("NPCChat")
REMOTES.Notify = REMOTES.UIEvents:WaitForChild("Notify")


-- Forward declaration: RunAutoWinSequence (defined just below) calls
-- SetAuctionState to hand control back to the master at the end of the
-- sequence, while SetAuctionState is written further down.
-- The "local" was removed from its definition; do NOT put it back.
local SetAuctionState

-- Finds the AuctionZone slab containing us. The name alone is not
-- enough: there are dozens of "AuctionZone" parts in the world, several
-- with an identical full path (duplicated garages).
local function FindContainingAuctionZone(hrp)
	-- Fast path: the garage the server announced to us.
	if AUCTION.garage and AUCTION.garage.Parent then
		local zone = AUCTION.garage:FindFirstChild("AuctionZone")
		if zone and zone:IsA("BasePart") then
			return zone
		end
	end

	-- Otherwise: the nearest zone that contains us horizontally.
	local best = nil
	local bestDist = math.huge

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == "AuctionZone" then
			local rel = obj.CFrame:PointToObjectSpace(hrp.Position)
			local half = obj.Size / 2

			if math.abs(rel.X) <= half.X
				and math.abs(rel.Z) <= half.Z
				and math.abs(rel.Y) <= AUTOWIN.ZONE_Y_TOL then
				local dist = (obj.Position - hrp.Position).Magnitude
				if dist < bestDist then
					best = obj
					bestDist = dist
				end
			end
		end
	end

	return best
end

-- Point just beyond the nearest edge, at unchanged height. We exit
-- along the axis that requires the least movement, which minimizes the
-- risk of landing in a neighboring garage's zone.
local function ComputeExitCFrame(hrp, zone)
	local rel = zone.CFrame:PointToObjectSpace(hrp.Position)
	local half = zone.Size / 2

	local neededX = half.X - math.abs(rel.X)
	local neededZ = half.Z - math.abs(rel.Z)

	local newX = rel.X
	local newZ = rel.Z

	if neededZ <= neededX then
		local sign = 1
		if rel.Z < 0 then
			sign = -1
		end
		newZ = sign * (half.Z + AUTOWIN.EXIT_MARGIN)
	else
		local sign = 1
		if rel.X < 0 then
			sign = -1
		end
		newX = sign * (half.X + AUTOWIN.EXIT_MARGIN)
	end

	local worldPos = zone.CFrame:PointToWorldSpace(Vector3.new(newX, rel.Y, newZ))
	return CFrame.new(worldPos)
end

-- Full sequence. Takes control of the HRP for the round trip: do NOT
-- start macro navigation in parallel.
function RunAutoWinSequence()
	if AUCTION.winRunning then
		return
	end
	AUCTION.winRunning = true
	AUCTION.wonThisAuction = true
	AUCTION.abort = false
	AUCTION.abortNextRequiredBid = nil

	local released = false
	local function Release()
		if released then
			return
		end
		released = true
		pcall(function()
			REMOTES.RequestAuctionPause:FireServer(false)
		end)
	end

	local ok, err = pcall(function()
		local hrp = GetFreshHRP()
		if not hrp then
			warn("[AutoWin] No HumanoidRootPart")
			return
		end

		-- 1. freeze: NPCs can no longer outbid
		local pauseOk, pauseErr = pcall(function()
			REMOTES.RequestAuctionPause:FireServer(true)
		end)
		if not pauseOk then
			warn("[AutoWin] RequestAuctionPause failed: " .. tostring(pauseErr))
			return
		end
		DebugPrint("[AutoWin] Auction paused, leaving the zone")

		task.wait(0.3)

		-- 2. leave the zone, by only a few studs
		local origin = hrp.CFrame
		local zone = FindContainingAuctionZone(hrp)

		if not zone then
			warn("[AutoWin] AuctionZone not found, aborting (staying in the auction)")
			return
		end

		local exitCFrame = ComputeExitCFrame(hrp, zone)
		DebugPrint(string.format("[AutoWin] Exiting %.1f studs to %s",
			(exitCFrame.Position - origin.Position).Magnitude, tostring(zone:GetFullName())))
		hrp.CFrame = exitCFrame

		-- 3. hold outside the zone. Without continuous repositioning the
		-- character falls back or drifts into the region before the 10s end.
		--
		-- We do NOT come back on a simple delay: we wait for the server
		-- confirmation (REMOTES.AuctionPickupStart), with a floor and a ceiling.
		-- Coming back too early gives an NPC time for one last bid.
		AUCTION.resolved = false
		local elapsed = 0

		while AUCTION.winActive do
			local live = GetFreshHRP()
			if live then
				live.CFrame = exitCFrame
				live.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			end

			if AUCTION.abort then
				DebugPrint("[AutoWin] Abort signal received, cutting the hold short")
				break
			end

			-- Win confirmed by the server: we can come back in.
			-- Normally we still respect the AUTOWIN.WAIT floor (safety
			-- margin), but Fast Win removes it -- the lot is already ours,
			-- waiting longer serves no purpose.
			if AUCTION.resolved and (AUCTION.fastWin or elapsed >= AUTOWIN.WAIT) then
				break
			end
			if elapsed >= AUTOWIN.MAX_WAIT then
				DebugPrint("[AutoWin] No pickup confirmation, giving up the hold")
				break
			end

			task.wait(0.25)
			elapsed = elapsed + 0.25
		end

		-- Hold after confirmation: we let the win seal itself before
		-- putting the player back in the zone. Pointless if aborted.
		local settle = 0
		while not AUCTION.abort and settle < AUTOWIN.SETTLE and AUCTION.winActive do
			local live = GetFreshHRP()
			if live then
				live.CFrame = exitCFrame
				live.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			end
			task.wait(0.25)
			settle = settle + 0.25
		end

		DebugPrint(string.format("[AutoWin] Held %.1fs (resolved=%s), returning",
			elapsed + settle, tostring(AUCTION.resolved)))

		-- 4. return
		local back = GetFreshHRP()
		if back then
			back.CFrame = origin
			back.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			back.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end

		-- Stabilization: the carryables have just spawned in the same spot.
		-- Without this pause, RunCollectingPhase chains a TP during collision
		-- resolution -> silent crash.
		task.wait(0.3)
		local settled = GetFreshHRP()
		if settled then
			settled.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			settled.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end
	end)

	if not ok then
		warn("[AutoWin] Sequence failed: " .. tostring(err))
	end

	-- Always release, even on error: a pause left active blocks the
	-- following auctions.
	Release()
	AUCTION.winRunning = false

	if AUCTION.abort then
		AUCTION.abort = false
		AUCTION.wonThisAuction = false -- we did not really win; a future return to the lead must be able to restart the hold
		local rebidAmount = AUCTION.abortNextRequiredBid
		AUCTION.abortNextRequiredBid = nil

		task.wait(0.2) -- let the position/pause stabilize server-side
		if type(rebidAmount) == "number" and (not AUCTION.maxBid or rebidAmount <= AUCTION.maxBid) then
			local rebidOk, rebidErr = pcall(function()
				REMOTES.BidRemote:FireServer()
			end)
			if rebidOk then
				DebugPrint("[AutoWin] Rebid fired after aborted hold")
			else
				warn("[AutoWin] Rebid after abort failed: " .. tostring(rebidErr))
			end
		else
			DebugPrint("[AutoWin] Outbid amount exceeds Max Bid, not rebidding")
		end
	end

	-- Resynchronization. If we won, the "Sold to <name>" already switched
	-- to COLLECTING and that state must not be overwritten. Otherwise we
	-- stayed stuck in BIDDING because of the guard above: we hand control
	-- back to the master so it goes looking for an auction again.
	task.wait(1.5)
	if AUCTION.state == "BIDDING" then
		local biddingUiOpen = false
		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
		if playerGui then
			biddingUiOpen = playerGui:FindFirstChild("AuctionBidding") ~= nil
		end
		if not biddingUiOpen then
			DebugPrint("[AutoWin] Auction over, releasing state to the master")
			SetAuctionState("SEARCHING")
		end
	end
end

function SetAuctionState(newState)
	if newState == AUCTION.state then
		return
	end
	DebugPrint(string.format("[AuctionFSM] %s -> %s", AUCTION.state, newState))
	AUCTION.state = newState
	-- The state moved, so whatever we committed to has resolved into
	-- something. Only a commit that never became an auction leaves this set.
	-- On the way out it also gives the one number that matters for entry
	-- speed: how long the garage took to go from "we walked in" to "bidding".
	if FARM.committedAt then
		if newState == "BIDDING" then
			DebugPrint(string.format("[Timing] garage -> bidding took %.2fs total",
				os.clock() - FARM.committedAt))
		end
		FARM.committedAt = nil
	end
	if newState == "BIDDING" then
		AUCTION.checkedMinBid = false
		AUCTION.wonThisAuction = false
		-- Belongs to the auction we are entering, not the one that ended.
		AUCTION.outcomeKnown = false
	end
end

local function CountOwnedCarryablePrompts()
	local count = 0
	local carryables = workspace:FindFirstChild("_Carryables")
	if not carryables then
		return 0
	end
	for _, item in ipairs(carryables:GetChildren()) do
		local owner = item:GetAttribute("Owner")
		-- Consistent with CollectItem: only our own items count.
		-- An item with owner==nil is not collectable, it must not prevent
		-- the COLLECTING -> SEARCHING transition. If COLLECT.skipBroken is
		-- active, a broken item does not count either, or the garage would
		-- stay stuck in COLLECTING while we cannot/will not repair it.
		if owner == LocalPlayer.UserId
			and not (COLLECT.skipBroken and isItemBroken(item))
			and not IsCarryableExcluded(item) then
			-- DEEP scan (GetDescendants), not just the direct children of a
			-- BasePart: confirmed by an in-game dump that some items (e.g.
			-- "Decoration Lamp") keep their prompt deeper in the hierarchy
			-- (item.Base.PickupPromptAnchor.PickupPrompt, one level more
			-- than expected). The shallow check missed those items, making
			-- them wrongly appear to have "no prompt".
			local hasPrompt = false
			for _, descendant in ipairs(item:GetDescendants()) do
				if descendant:IsA("ProximityPrompt") then
					count = count + 1
					hasPrompt = true
				end
			end
			-- Item is ours, not excluded/broken, but NO prompt found
			-- anywhere in the hierarchy: this time it really is suspicious
			-- (pickup window expired server-side?), not a mere scan-depth
			-- problem.
			if not hasPrompt then
				DebugPrint("[AutoFarm] Owned item with NO pickup prompt anywhere in its hierarchy (likely orphaned/expired): " .. item.Name)
			end
		end
	end
	return count
end

SESSION.Track(REMOTES.ToggleAuctionArea.OnClientEvent:Connect(function(inOwnGarage, garageModel)
	if inOwnGarage then
		AUCTION.garage = garageModel
	end
end))

SESSION.Track(REMOTES.ToggleBiddingUI.OnClientEvent:Connect(function(isOpen)
	if isOpen then
		-- NEVER overwrite COLLECTING: if the bid UI reopens while we are
		-- collecting a won garage (prompt retriggered, passing near another
		-- zone...), switching to BIDDING would cut RunCollectingPhase in
		-- half and leave the garage half empty. We let the collection
		-- finish; the FSM will return to SEARCHING by itself when
		-- _Carryables is empty.
		if AUCTION.state == "COLLECTING" then
			DebugPrint("[AuctionFSM] Bidding UI opened while COLLECTING, ignored")
			return
		end
		SetAuctionState("BIDDING")
	else
		-- Leaving the zone closes the bid UI and would switch to SEARCHING.
		-- During Auto-Win it is WE who left, and deliberately: we stay in
		-- BIDDING so the master does not go looking for another garage.
		-- The state will be corrected by the "Sold to ..." (COLLECTING) or
		-- by the end of the sequence.
		if AUCTION.state == "BIDDING" and not AUCTION.winRunning then
			if AUCTION.deliberateLeave then
				-- We left of our own accord (Min Bid): nothing to wait for.
				AUCTION.deliberateLeave = false
			else
				-- Auction ended on us: we do not know yet whether we won.
				-- The "Sold to" and the carryables arrive just after, so we
				-- block any new search for a few seconds.
				--
				-- This is a CEILING, not a fixed wait: the "Sold to" handler
				-- below clears it the moment the outcome is actually known,
				-- which is normally well under a second. The 5s only runs in
				-- full when no "Sold to" ever arrives.
				--
				-- If "Sold to <someone else>" already arrived before the UI
				-- closed, the outcome is known right now and there is
				-- nothing to settle for at all.
				AUCTION.settleUntil = AUCTION.outcomeKnown and 0 or (os.clock() + 5)
				-- The 15s entry cooldown is for a REAL garage visit, where
				-- the collection itself takes that long. This auction is
				-- over, so whatever is left of it is dead time: the pair of
				-- them is what produced the ~10s freeze after losing an
				-- auction. Same reset the Min Bid exit already did.
				FARM.cooldownUntil = 0
				if AUCTION.outcomeKnown then
					-- The two events arrive in either order, and only the
					-- other ordering was opening the hurry window. Identical
					-- losses were coming back at 0.4s or at 2s purely
					-- depending on which message the server sent first.
					FARM.Hurry()
				end
				DebugPrint("[AuctionFSM] Auction ended, settling before searching again")
			end
			SetAuctionState("SEARCHING")
		end
	end
end))

SESSION.Track(REMOTES.NPCChat.OnClientEvent:Connect(function(character, message, _, _)
	if type(message) ~= "string" then
		return
	end

	local winnerName = string.match(message, "Sold to (.+)!")
	if not winnerName then
		return
	end

	local speakerGarage = character and character.Parent
	if speakerGarage ~= AUCTION.garage then
		return
	end

	if winnerName == LocalPlayer.Name then
		-- Win confirmed: we switch to COLLECTING, the settle window is no
		-- longer needed (COLLECTING is now what blocks any new
		-- search).
		AUCTION.settleUntil = 0
		SetAuctionState("COLLECTING")
	else
		-- Somebody else won it. That is exactly the answer the settle
		-- window exists to wait for: nothing is coming for us and no
		-- carryables will spawn, so any remaining wait is dead time.
		--
		-- This message and the bid UI closing arrive in either order, so
		-- the flag is set unconditionally and BOTH sides act on it: here
		-- if the UI already closed, and in the UI-close handler above if
		-- it has not yet. Reset when the next auction enters BIDDING.
		AUCTION.outcomeKnown = true
		if AUCTION.state == "SEARCHING" then
			AUCTION.settleUntil = 0
			FARM.cooldownUntil = 0
			FARM.Hurry()
			DebugPrint("[AuctionFSM] Lost to " .. tostring(winnerName) ..
				", nothing to settle for -- searching again now")
		end
	end
end))

task.spawn(function()
	-- Debounce: Count()==0 must stay true for 1.5s before confirming the
	-- transition. Without this, if a garage's carryables do not all
	-- replicate at the same instant (the broken item appears before the
	-- others, for example), a transient reading of 0 makes us abandon the
	-- garage before the valid items have finished appearing.
	local zeroSince = nil
	while SESSION.alive do
		if AUCTION.state == "COLLECTING" and CountOwnedCarryablePrompts() == 0 then
			zeroSince = zeroSince or os.clock()
			if os.clock() - zeroSince >= 1.5 then
				SetAuctionState("SEARCHING")
				zeroSince = nil
			end
		else
			zeroSince = nil
		end
		-- 0.2s rather than 0.5s. The 1.5s hold above is the real debounce and
		-- it stays; this is only how often it is looked at, and at 0.5s it was
		-- adding up to half a second of its own on top, on every won garage.
		task.wait(0.2)
	end
end)

-- AUTO COLLECT (low-level part: picking up an item)
-- CollectItem makes a micro-adjustment of the HRP (6 studs) to get into
-- the prompt's activation zone. That is LOCAL fine positioning, not
-- macro navigation -> allowed everywhere (standalone and master).
local ACTIVATION_DISTANCE = 10

REMOTES.HotbarEvents = Events:WaitForChild("Hotbar")
REMOTES.EquipTool = REMOTES.HotbarEvents:WaitForChild("EquipTool")

-- Auto-equips the wrench (Wrench0) on a broken item before picking it
-- up. Can be disabled if the player wants to pick up broken items as is.
-- Remembers whether the USER themselves enabled Auto Collect. Distinct
-- from `COLLECT.active`, which Auto Farm forces to true. Used to restore
-- the state the user wanted when Auto Farm is turned off (otherwise the
-- standalone collect loop would start though the user never asked for it).

local function GetCarryablePrompts()
	local prompts = {}
	local carryables = workspace:FindFirstChild("_Carryables")
	if not carryables then
		warn("[AutoCollect] workspace._Carryables not found")
		return prompts
	end
	for _, item in ipairs(carryables:GetChildren()) do
		-- Filter AT THE LIST LEVEL: a carryable belonging to another player
		-- (or unassigned, owner == -1/nil) is not collectable. Including
		-- them made CollectItem iterate over items that exit immediately,
		-- hence a whole pass without a single yield.
		-- If COLLECT.skipBroken is active, a broken item is filtered here
		-- too: never retried, CollectItem is not even called on it.
		if item:GetAttribute("Owner") == LocalPlayer.UserId
			and not (COLLECT.skipBroken and isItemBroken(item))
			and not IsCarryableExcluded(item) then
			-- DEEP scan (GetDescendants), not only the direct children of a
			-- BasePart: confirmed by an in-game dump that some items keep
			-- their prompt deeper in the hierarchy (e.g.
			-- item.Base.PickupPromptAnchor.PickupPrompt).
			for _, descendant in ipairs(item:GetDescendants()) do
				if descendant:IsA("ProximityPrompt") then
					table.insert(prompts, descendant)
				end
			end
		end
	end
	return prompts
end

local function isWrenchEquipped()
	local character = LocalPlayer.Character
	if not character then return false end
	return character:FindFirstChild("Wrench0") ~= nil
end

-- Returns true ONLY if a pickup was actually attempted (so if the
-- function yielded). Every early-exit path returns false: the caller
-- MUST know that no time elapsed, otherwise it loops without yielding
-- and starves the client (freeze then crash, with no Lua error).
local function CollectItem(prompt)
	-- The item's Model: we walk up the ancestors until we find the one
	-- whose parent is _Carryables, whatever the prompt's depth below it
	-- (2 or 3 levels depending on the item type).
	local itemModel = nil
	do
		local current = prompt
		while current and current.Parent do
			if current.Parent.Name == "_Carryables" then
				itemModel = current
				break
			end
			current = current.Parent
		end
	end
	if not itemModel then
		return false
	end

	-- Cascading position resolution -- prompt.Parent is sometimes the
	-- BasePart directly (old structure), sometimes an intermediate
	-- Attachment ("PickupPromptAnchor", confirmed by in-game dumps on
	-- several items: item.Base.PickupPromptAnchor.PickupPrompt). If
	-- neither, we look further instead of giving up right away: walk up
	-- the ancestors to itemModel looking for a BasePart, then as a last
	-- resort GetPivot() on the Model (always works, whatever the internal
	-- structure). Covers a future change to the game's structure with no
	-- new fix needed.
	local promptParent = prompt.Parent
	local targetPosition

	if promptParent and promptParent:IsA("BasePart") then
		targetPosition = promptParent.Position
	elseif promptParent and promptParent:IsA("Attachment") then
		targetPosition = promptParent.WorldPosition
	end

	if not targetPosition then
		local current = promptParent
		while current and current ~= itemModel.Parent do
			if current:IsA("BasePart") then
				targetPosition = current.Position
				break
			elseif current:IsA("Attachment") then
				targetPosition = current.WorldPosition
				break
			end
			current = current.Parent
		end
	end

	if not targetPosition then
		local ok, pivot = pcall(function()
			return itemModel:GetPivot()
		end)
		if ok and pivot then
			targetPosition = pivot.Position
			DebugPrint("[AutoCollect] Position resolved via GetPivot() fallback for " .. itemModel.Name)
		end
	end

	if not targetPosition then
		warn("[AutoCollect] Could not resolve any position for prompt under " .. prompt:GetFullName())
		return false
	end

	-- Double guard: GetCarryablePrompts already filters by Owner, but the
	-- owner can change between building the list and here.
	local owner = itemModel:GetAttribute("Owner")
	if owner ~= LocalPlayer.UserId then
		return false
	end

	local hrp = GetFreshHRP()
	if not hrp then
		warn("[AutoCollect] No fresh HumanoidRootPart, skipping this item")
		return false
	end

	-- We use the prompt's real activation range (instead of a fixed low
	-- threshold): this avoids teleporting for items already well within
	-- range, and cuts the number of TPs during AutoCollect accordingly
	-- (hence the number of possible physics discontinuities).
	local activationRange = prompt.MaxActivationDistance
	if type(activationRange) ~= "number" or activationRange <= 0 then
		activationRange = ACTIVATION_DISTANCE
	end
	-- Safety margin: we aim slightly below the real range, to stay
	-- tolerant if the server is slightly stricter than the client on
	-- distance.
	local effectiveRange = math.max(activationRange - 1, 2)

	local distance = (hrp.Position - targetPosition).Magnitude

	if distance > effectiveRange then
		local direction = (targetPosition - hrp.Position).Unit
		local newPosition = targetPosition - direction * effectiveRange
		if not SafeSetHRPCFrame(CFrame.new(newPosition, targetPosition)) then
			return false
		end
		task.wait(0.1)
	end

	if COLLECT.repairEnabled and isItemBroken(itemModel) and not isWrenchEquipped() then
		local equipOk, equipErr = pcall(function()
			REMOTES.EquipTool:FireServer("Wrench0")
		end)
		if not equipOk then
			warn("[AutoCollect] EquipTool failed: " .. tostring(equipErr))
		end
		task.wait(0.1)
	end

	local ok, err = pcall(function()
		fireproximityprompt(prompt)
	end)
	if not ok then
		warn("[AutoCollect] fireproximityprompt failed: " .. tostring(err))
	end

	task.wait(prompt.HoldDuration + 0.1)
	return true
end

-- Picks up every available prompt, re-scanning _Carryables on EACH item
-- (not just once at the start of the pass): an item appearing along the
-- way is seen immediately. Unloads the truck if nearly full.
-- shouldContinue() allows a clean interruption.
-- Returns the NUMBER of items collected -- NOT a boolean: a pass with
-- no yield (another player's prompts) made the caller loop forever
-- without yielding -> starved client -> crash with no Lua error.
local function CollectOnce(shouldContinue)
	local collected = 0
	-- "Already attempted" guard (per prompt instance) within THIS pass:
	-- without it, an item that always fails (e.g. broken, failed repair)
	-- would always stay at the head of the fresh list and block the
	-- processing of the other items in the same pass indefinitely.
	local attempted = {}

	while shouldContinue() do
		-- Re-scan on EACH item, not just once at the start of the pass: an
		-- item appearing along the way (a garage revealing its items in
		-- several waves) is seen immediately, not 0.5s later on the next
		-- call to CollectOnce.
		local prompts = GetCarryablePrompts()

		local target = nil
		for _, prompt in ipairs(prompts) do
			if not attempted[prompt] then
				target = prompt
				break
			end
		end

		if not target then
			break
		end

		attempted[target] = true

		local truck = GetPlayerTruck()
		if truck and not HasCargoRoom(truck) then
			DebugPrint("[CargoManager] Truck almost full, unloading")
			UnloadCargo()
		end

		if target.Parent then
			if CollectItem(target) then
				collected = collected + 1
			end
		else
			-- Item already gone between the scan and here (collected another
			-- way, removed by the server...): CollectItem was not called, so
			-- no yield is guaranteed. Explicit yield so we never loop with no
			-- time elapsed (freeze/crash with no Lua error).
			task.wait()
		end
	end

	return collected
end

-- STANDALONE loop: runs ONLY if Auto Farm is disabled. If Auto Farm
-- turns on while it is running, it stops by itself (the not FARM.active
-- condition) and hands control back to the Master Cycle.
local function StartAutoCollect()
	if LOOPGUARDS.collect then return end
	LOOPGUARDS.collect = true
	task.spawn(function()
		while COLLECT.active and LOOPGUARDS.collect and not FARM.active do
			CollectOnce(function()
				return COLLECT.active and not FARM.active
			end)
			-- Unconditional yield, same reason as RunCollectingPhase.
			task.wait(0.5)
		end
		LOOPGUARDS.collect = false
	end)
end

