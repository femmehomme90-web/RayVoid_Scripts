	Callback = function(selected)
		-- A saved config can carry types the game has since removed (the
		-- Alien Garages, seen). RayVoid draws no row for those,
		-- so they could never be unticked and sat in the "Checked:" line
		-- for good. Keep only what the game still has, and push the clean
