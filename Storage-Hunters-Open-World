-- FRESH HRP (anti-crash)
-- Character/HRP can go stale after a respawn. Writing .CFrame on a stale
-- instance can crash the executor WITHOUT a visible Lua error in the
-- console. Every position write must go through here.
local function GetFreshHRP()
	local char = LocalPlayer.Character
	if not char then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart")
end

-- Zeroes a BasePart's linear/angular velocity. After an instant
-- teleport, residual velocity (especially on a vehicle assembled with
-- wheels/suspensions/joints) can make the physics engine compute a
-- huge discontinuity all at once -> silent engine crash, with no Lua
-- error.
local function ZeroVelocity(part)
	if not part then
		return
	end
	pcall(function()
		part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end)
end

-- Writes .CFrame on a fresh HRP, guarded by pcall, then zeroes its
-- velocity and gives the physics engine a frame to stabilize.
-- Returns true/false.
local function SafeSetHRPCFrame(cframe)
	local hrp = GetFreshHRP()
	if not hrp then
		warn("[SafeTP] No fresh HumanoidRootPart available, teleport skipped")
		return false
	end
	local ok, err = pcall(function()
		hrp.CFrame = cframe
	end)
	if not ok then
		warn("[SafeTP] Failed to set HRP CFrame: " .. tostring(err))
		return false
	end
	ZeroVelocity(hrp)
	task.wait()
	return true
end

