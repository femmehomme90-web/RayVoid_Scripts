-- AUTO COLLECT TIME CAPSULE -- passive, never touches the HRP.
-- COLLECT ONLY: placing costs gems (TimeCapsuleConfig.ValueTiers PlaceCost),
-- so the user puts items in by hand. Never places, never buys a roll.
--
-- How the capsule works (TimeCapsuleConfig.CycleSeconds = 300, fan wikis
-- 2026-10): every 5 minutes it rolls Cobwebbed 2.5% / Antique 0.5% / Ancient
-- 0.1% / Timeless 0.025% (GetSlotStates.tierChances); on a miss nothing
-- happens and it rolls again. Once ONE lands the item is done -- it cannot
-- roll again -- so "done" = the slot holds any time mutation, and that is
-- the moment we collect. Expect ~2.5h per item on average (3.125%/roll).
--
-- Two triggers: TierMutated (the game's own UI listens to it; arg2 is the
-- mutation name) for an instant collect, and a poll as a backstop in case
-- the event was missed or its first argument is not a slot index.
-- One table = one root-level local (Lua 5.1 cap of 200).
local TCAPSULE = {
	active = false,
	events = Events:WaitForChild("TimeCapsule", 10),
	TIERS = { Cobwebbed = true, Antique = true, Ancient = true, Timeless = true },
	-- slotIndex -> os.clock() until which we do not retry a refused collect.
	failed = {},
	-- The shape of an occupied slot was never measured: print it once, so a
	-- failure report shows exactly where the mutation lives.
	shapeLogged = false,
	busy = false,
}

function TCAPSULE.State()
	if not TCAPSULE.events then
		return nil
	end
	local ok, s = pcall(function()
		return TCAPSULE.events.GetSlotStates:InvokeServer()
	end)
	if not ok or type(s) ~= "table" then
		DebugPrint("[TimeCapsule] GetSlotStates failed: " .. tostring(s))
		return nil
	end
	-- Pick up any tier a future update adds.
	if type(s.tierChances) == "table" then
		for name in pairs(s.tierChances) do
			TCAPSULE.TIERS[name] = true
		end
	end
	return s
end

function TCAPSULE.Short(v, depth)
	depth = depth or 0
	if type(v) ~= "table" then
		return tostring(v)
	end
	if depth > 3 then
		return "{...}"
	end
	local parts = {}
	for k, x in pairs(v) do
		table.insert(parts, tostring(k) .. "=" .. TCAPSULE.Short(x, depth + 1))
		if #parts >= 12 then
			table.insert(parts, "...")
			break
		end
	end
	return "{" .. table.concat(parts, ", ") .. "}"
end

-- Where can the landed mutation be? Only in places that mean "this item HAS
-- it": a Mutators-style entry ({ name = "Antique" }) or a string field whose
-- key says tier/mutat ("Tier", "CurrentMutator", ...). A bare list of tier
-- names (e.g. a list of possible outcomes) does NOT count, or we would pull
-- the item out before anything landed and waste the gems.
function TCAPSULE.FindTier(v, depth)
	depth = depth or 0
	if type(v) ~= "table" or depth > 5 then
		return nil
	end
	if type(v.name) == "string" and TCAPSULE.TIERS[v.name] then
		return v.name
	end
	for k, x in pairs(v) do
		if type(x) == "string" and type(k) == "string" and TCAPSULE.TIERS[x] then
			local key = string.lower(k)
			if string.find(key, "tier", 1, true) or string.find(key, "mutat", 1, true) then
				return x
			end
		elseif type(x) == "table" then
			local hit = TCAPSULE.FindTier(x, depth + 1)
			if hit then
				return hit
			end
		end
	end
	return nil
end

function TCAPSULE.Collect(index, tier)
	if TCAPSULE.failed[index] and TCAPSULE.failed[index] > os.clock() then
		return
	end
	local ok, r = pcall(function()
		return TCAPSULE.events.CollectItem:InvokeServer(index)
	end)
	if ok and (r == true or (type(r) == "table" and r.success)) then
		print("[TimeCapsule] Collected slot " .. index .. " (" .. tostring(tier) .. ")")
	else
		TCAPSULE.failed[index] = os.clock() + 30
		warn("[TimeCapsule] Collect slot " .. index .. " failed (retry in 30s): "
			.. TCAPSULE.Short(ok and r or ("error: " .. tostring(r))))
	end
end

function TCAPSULE.RunPass()
	if TCAPSULE.busy then
		return
	end
	TCAPSULE.busy = true
	local passOk, passErr = pcall(function()
		local s = TCAPSULE.State()
		if not s or type(s.slots) ~= "table" then
			return
		end
		for key, slot in pairs(s.slots) do
			local index = tonumber(key)
			if index and type(slot) == "table" and next(slot) ~= nil then
				if not TCAPSULE.shapeLogged then
					TCAPSULE.shapeLogged = true
					print("[TimeCapsule] slot " .. index .. " contents: " .. TCAPSULE.Short(slot))
				end
				local tier = TCAPSULE.FindTier(slot)
				if tier then
					TCAPSULE.Collect(index, tier)
					task.wait(1)
				end
			end
		end
	end)
	TCAPSULE.busy = false
	if not passOk then
		warn("[TimeCapsule] Pass failed, continuing: " .. tostring(passErr))
	end
end

function TCAPSULE.StartLoop()
	if LOOPGUARDS.timeCapsule then
		return
	end
	LOOPGUARDS.timeCapsule = true
	task.spawn(function()
		while TCAPSULE.active and LOOPGUARDS.timeCapsule do
			TCAPSULE.RunPass()
			-- Rolls are 5 minutes apart and the event covers the instant
			-- case; this is only the backstop.
			task.wait(15)
		end
		LOOPGUARDS.timeCapsule = false
	end)
end

-- Instant path. Connected once; inert unless the toggle is on.
if TCAPSULE.events then
	local mutated = TCAPSULE.events:FindFirstChild("TierMutated")
	if mutated then
		mutated.OnClientEvent:Connect(function(a1, a2)
			if not (TCAPSULE.active and SESSION.alive) then
				return
			end
			print("[TimeCapsule] TierMutated: " .. TCAPSULE.Short(a1) .. " -> " .. tostring(a2))
			task.spawn(function()
				task.wait(1) -- let the server finish writing the slot
				local index = tonumber(a1)
				if not index and type(a1) == "table" then
					index = tonumber(a1.slotIndex or a1.SlotIndex or a1.index or a1.slot)
				end
				if index and type(a2) == "string" and TCAPSULE.TIERS[a2] then
					TCAPSULE.Collect(index, a2)
				else
					TCAPSULE.RunPass()
				end
			end)
		end)
	end
end

