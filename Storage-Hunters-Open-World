-- =========================================================
-- WILD WEST COMBAT (Outlaws, Town Defense) -- shared gun-fire and
-- corpse-pickup logic, so the two features below don't duplicate it.
-- Protocol measured via Real MCP: equip any owned gun
-- with the ordinary Events.Inventory.EquipItem:FireServer(guid), then
-- Events.Misc.GunAction:FireServer(tool, "Fire", worldPosition) damages
-- whatever is at that position server-side (aim is a raw Vector3, not a
-- target reference) and Events.Misc.GunAction:FireServer(tool, "Reload")
-- refills it. A killed Outlaw's OutlawState attribute becomes "Gone" and
-- its body drops into workspace._Carryables as a Model carrying
-- GetAttribute("OutlawCorpse") == true and Owner == 0 (free-for-all, NOT
-- the killer's UserId) -- confirmed live: GetCarryablePrompts() (Auto
-- Collect's own carryable scan, above) filters strictly on
-- Owner == LocalPlayer.UserId, so it will never pick these up; hence the
-- dedicated CollectCorpses() below instead of reusing that scan.
-- TownDefenseConfig's "BanditLootLifetimeSeconds" field name strongly
-- suggests bandit kills drop the same OutlawCorpse-tagged body, so
-- CollectCorpses()/TurnInToSheriff() are shared with Town Defense too;
-- not independently confirmed live (no wave has been fought yet).
-- =========================================================
-- Nested under GOLDPAN.WW rather than a new root-level local: the file
-- was already at the true (undercounted) local ceiling -- see
-- "Root-level locals" in CLAUDE.md -- and GOLDPAN is already the
-- Wild-West-event-scoped table slated for the same deletion date, so it
-- costs zero new slots to hang the rest of the event's features off it.
GOLDPAN.WW = {}

-- Shared arbitration between the Wild West features that all compete for
-- the same tool slot and player movement: Race > Town Defense > Outlaws
-- > Gold Panning (the user's own ordering) -- missing a race
-- costs a 15-minute wait, town defense wastes a 30-min cooldown on
-- death, an outlaw sweep just resumes later, and gold panning already
-- tolerates interruption.
--
-- EXACTLY ONE feature holds the floor at a time. Priority decides who
-- stands down and who gets to queue -- it never lets two run at once.
-- The first version of this got that wrong in two ways the user hit in
-- game ("outlaw barges in"):
--   * Claim() overwrote the lock unconditionally, so a feature that
--     checked ShouldYield at its loop top and then spent a second
--     equipping a gun would stamp its OWN lower priority over whoever had
--     taken the floor in the meantime. Both then saw a lock they were
--     happy with and drove the character together.
--   * Nothing ever waited for a holder to let go. Preempting was just
--     "claim it and hope", with a fixed 2s guess for the handoff.
-- Now: Claim() only ever takes a FREE floor, and a higher-priority
-- feature preempts by queueing an intent (Want) that the holder sees at
-- its next loop-top ShouldYield and stands down for, then waiting for the
-- floor to actually clear. Still cooperative -- a feature inside a
-- blocking call (Engage's 10s window, one Gold Pan cycle) finishes it
-- first -- but it is now a real handoff instead of two owners.
--
-- Both the lock and the queued intent carry a DEADLINE. A coroutine that
-- dies between claiming and releasing used to leave the floor held
-- forever, which is the "everything stops and never comes back" failure;
-- an expired hold is treated as gone.
GOLDPAN.WW.PRIORITY = { Race = 4, TownDefense = 3, Outlaw = 2, GoldPan = 1 }
GOLDPAN.WW.Lock = nil
GOLDPAN.WW.LockName = nil
GOLDPAN.WW.LockUntil = 0
GOLDPAN.WW.Want = nil
GOLDPAN.WW.WantName = nil
GOLDPAN.WW.WantUntil = 0

-- The current holder's priority, or nil. Expiring a stale hold here means
-- every reader gets the correction for free; the watchdog loop further down
-- also calls it, for the case where no feature loop is running to.
function GOLDPAN.WW.Holder()
	if GOLDPAN.WW.Lock and os.clock() > GOLDPAN.WW.LockUntil then
		warn("[WildWest] " .. tostring(GOLDPAN.WW.LockName) .. " held the floor past its deadline -- clearing it")
		GOLDPAN.WW.Lock, GOLDPAN.WW.LockName = nil, nil
	end
	GOLDPAN.WW.ExpireHandoff()
	return GOLDPAN.WW.Lock
end

function GOLDPAN.WW.Waiting()
	if GOLDPAN.WW.Want and os.clock() > GOLDPAN.WW.WantUntil then
		GOLDPAN.WW.Want, GOLDPAN.WW.WantName = nil, nil
	end
	return GOLDPAN.WW.Want
end

-- Keeps a queued intent alive while a feature is merely watching ShouldYield
-- from its own "waiting to start" loop, rather than inside Acquire()'s wait
-- loop (the only other place Want gets set). Found: Outlaw
-- polled ShouldYield==true for the whole length of a Town Defense run
-- without ever calling Acquire, so Want stayed nil throughout; the instant
-- Defense ended, ResumeFarm saw nobody Waiting() and resumed Auto Farm
-- outright instead of a Handoff -- Farm then teleported and committed to (and
-- paid the entry fee for) a brand new garage before Outlaw's next poll tick
-- registered Want and forced a real pause. Call every poll while
-- ShouldYield is true; seconds should clear the poll interval so one missed
-- tick does not leave a stale Want, but ~3x it so jitter cannot lapse it
-- between ticks either.
function GOLDPAN.WW.Announce(myPriority, name, seconds)
	GOLDPAN.WW.Want, GOLDPAN.WW.WantName = myPriority, name
	GOLDPAN.WW.WantUntil = os.clock() + (seconds or 6)
end

-- Stand down if something more important holds the floor OR is queued for
-- it. The "is queued" half is what turns preemption into a handoff: the
-- holder gets told to finish up before the preemptor touches anything.
function GOLDPAN.WW.ShouldYield(myPriority)
	local holder = GOLDPAN.WW.Holder()
	if holder and GOLDPAN.WW.LockName ~= nil and holder > myPriority then
		return true
	end
	local waiting = GOLDPAN.WW.Waiting()
	if waiting and waiting > myPriority then
		return true
	end
	return false
end

-- Takes the floor ONLY if it is free or already ours. Never overwrites
-- another holder -- callers that outrank the holder wait for it through
-- Acquire() below instead.
function GOLDPAN.WW.Claim(myPriority, name, holdSeconds)
	local holder = GOLDPAN.WW.Holder()
	if holder and GOLDPAN.WW.LockName ~= name then
		return false
	end
	local waiting = GOLDPAN.WW.Waiting()
	if waiting and GOLDPAN.WW.WantName ~= name and waiting > myPriority then
		return false
	end
	GOLDPAN.WW.Lock = myPriority
	GOLDPAN.WW.LockName = name
	GOLDPAN.WW.LockUntil = os.clock() + (holdSeconds or 120)
	if GOLDPAN.WW.WantName == name then
		GOLDPAN.WW.Want, GOLDPAN.WW.WantName = nil, nil
	end
	GOLDPAN.WW.SyncBusy()
	return true
end

-- Pushes the deadline out for work that is legitimately still going, so
-- the stale-hold watchdog only ever fires on a hold nobody is driving.
function GOLDPAN.WW.Renew(name, holdSeconds)
	if GOLDPAN.WW.LockName == name then
		GOLDPAN.WW.LockUntil = os.clock() + (holdSeconds or 120)
	elseif GOLDPAN.WW.LockName == nil and GOLDPAN.WW.Hold.owners[name] then
		-- The lease lapsed while this holder was merely slow, and Holder()
		-- cleared the lock. A holder that is still running takes it back
		-- rather than being treated as dead -- a dead one never gets here, and
		-- ReleaseOrphans gives its Auto Farm hold back instead.
		GOLDPAN.WW.Lock, GOLDPAN.WW.LockName = GOLDPAN.WW.PRIORITY[name], name
		GOLDPAN.WW.LockUntil = os.clock() + (holdSeconds or 120)
		GOLDPAN.WW.SyncBusy()
	end
end

-- Queues an intent, waits for the holder to stand down on its own, then
-- takes the floor. Returns false if it could not get it in time or if
-- something even more important got in front -- and a false return means
-- the caller must NOT proceed, not that it may barge in anyway.
function GOLDPAN.WW.Acquire(myPriority, name, holdSeconds, waitSeconds)
	waitSeconds = waitSeconds or 10
	if GOLDPAN.WW.Claim(myPriority, name, holdSeconds) then
		return true
	end

	local waiting = GOLDPAN.WW.Waiting()
	if waiting and waiting > myPriority then
		return false
	end
	local holder = GOLDPAN.WW.Holder()
	if holder and holder > myPriority then
		return false
	end

	GOLDPAN.WW.Want, GOLDPAN.WW.WantName = myPriority, name
	GOLDPAN.WW.WantUntil = os.clock() + waitSeconds + 5
	DebugPrint("[WildWest] " .. name .. " is asking " .. tostring(GOLDPAN.WW.LockName) .. " for the floor")

	local deadline = os.clock() + waitSeconds
	while os.clock() < deadline and SESSION.alive do
		task.wait(0.5)
		if GOLDPAN.WW.Claim(myPriority, name, holdSeconds) then
			print("[WildWest] " .. name .. " took the floor")
			return true
		end
		local queued = GOLDPAN.WW.Waiting()
		if queued and queued > myPriority then
			break
		end
	end

	-- Give up cleanly. Leaving Want set would keep every lower-priority
	-- feature standing down for a handoff that is no longer coming.
	if GOLDPAN.WW.WantName == name then
		GOLDPAN.WW.Want, GOLDPAN.WW.WantName = nil, nil
	end
	warn("[WildWest] " .. name .. " gave up waiting for " .. tostring(GOLDPAN.WW.LockName) .. " to release the floor")
	return false
end

function GOLDPAN.WW.Release(name)
	if GOLDPAN.WW.LockName == name then
		GOLDPAN.WW.Lock, GOLDPAN.WW.LockName = nil, nil
	end
	if GOLDPAN.WW.WantName == name then
		GOLDPAN.WW.Want, GOLDPAN.WW.WantName = nil, nil
	end
	GOLDPAN.WW.SyncBusy()
end

-- VEHICLESPAWN.RunAutoIfDue reads SESSION.goldPanning to decide whether the
-- automatic truck recall may seat the player. Derive it from BOTH the floor
-- and the farm hold: Race holds the floor for the whole 75s lead window but
-- only pauses Auto Farm for the last 20s of it, and a recall landing in that
-- gap seats the player in the truck seconds before the mount.
function GOLDPAN.WW.SyncBusy()
	SESSION.goldPanning = (GOLDPAN.WW.Lock ~= nil) or (GOLDPAN.WW.Hold.count > 0)
end

GOLDPAN.WW.Combat = {
	-- Any owned gun works; Revolver/Antique Pistol/Shotgun/Uzi/SMG/Sniper
	-- Rifle/Handgun item ids from ReplicatedStorage.Modules.GunConfig.
	-- Re-measured against the game's own GunConfig, which is
	-- the authority: its keys are 223 Uzi, 224 SMG, 225 Sniper Rifle,
	-- 226 Handgun, 227 P90, 1049 Revolver, 1131 Antique Pistol,
	-- 1133 Shotgun. The P90 was missing from this list, so a player whose
	-- only gun was a P90 counted as unarmed and neither outlaw hunting nor
	-- town defense would ever start. Items with Category == "Weapon" but no
	-- GunConfig entry (Bat, Knife, grenades, Bazooka...) are deliberately
	-- absent: GunAction only drives real guns.
	weaponItemIds = {
		["223"] = true, ["224"] = true, ["225"] = true, ["226"] = true,
		["227"] = true, ["1049"] = true, ["1131"] = true, ["1133"] = true,
	},
	-- The vehicle recall has its own server-side cooldown -- confirmed
	-- live, two straight "explicitly rejected by server"
	-- refusals in a row. It used to be tracked here, which meant only the
	-- corpse recalls respected it and Auto Farm's truck catch-up did not;
	-- it now lives on VEHICLESPAWN (cooldownUntil / cooldownSeconds), which
	-- owns the remote, so every caller waits out the same clock. The numbers
	-- behind it are in that table's comment.
	-- How close the car must be for a body's "Add to Vehicle". Measured
	-- With the Flying UFO, car pivot to body: accepted at 32,
	-- 84, 85, 131 and 156 studs, refused at 194 ("Your vehicle is too far
	-- away").
	truckReachStuds = 100,
	-- Where the player stands, away from the body, when calling the car.
	-- Too close and a big car lands on top of the body, which blocks the
	-- pickup. The two numbers are tied: the car lands 18-33
	-- studs from the player (measured), so standoff + 33 must stay under
	-- truckReachStuds -- at 50 against the old 60, every recall landed
	-- "too far" and the player never went to the body.
	recallStandoffStuds = 50,
	-- Per-corpse retry state, keyed by the corpse INSTANCE (not name --
	-- every corpse of a kind shares a Name, so a name lookup can silently
	-- match a different corpse). Without this a corpse whose pickup keeps
	-- failing got the full teleport-recall-approach-fire sequence redone
	-- every ~1s pass forever (the user's "teleports around... 0 checks",
	-- 2026-09-16) -- now a failed attempt buys it corpseRetryCooldown
	-- seconds of peace, and corpseMaxAttempts failures in a row gives up
	-- on it outright until the next pass finds it gone (collected by
	-- someone else, or its own lifetime timer despawning it).
	-- corpseMaxAttempts was 3 (15s of patience) -- too little: a body is
	-- not even carryable until its ~2.5s ragdoll settles, and the vehicle
	-- recall this whole thing depends on has its OWN 15s cooldown, so 3
	-- tries could burn out before either had a real chance to clear (the
	-- user's report, 2026-09-16: outlaws given up on within seconds of
	-- dying). Raised to 12 -- generous against those two delays, but
	-- still well under the corpse's own 180s despawn timer, so a genuinely
	-- unreachable body is not held onto for nothing.
	corpseAttempts = {},
	-- 1.5, not 5: a refused body no longer just waits and tries again from
	-- the same spot, it gets the car moved (corpseRecallAfterFails), so the
	-- long pause bought nothing but a slower pickup.
	corpseRetryCooldown = 1.5,
	corpseMaxAttempts = 12,
	-- Refusals in a row, with the car IN reach, before the car is called
	-- again from recallStandoffStuds away (the user's call 2026-09-17).
	-- Measured the same day: after a Town Defense win, 15 bodies loaded and
	-- then two were refused 12 times each with the car parked 23 studs away
	-- -- "in reach", so nothing ever moved it. Bodies lie densely after a
	-- defense and a big car parked on or beside one blocks it (inferred from
	-- the note above, not re-measured).
	corpseRecallAfterFails = 2,
	-- os.clock() of the last recall, and how many there have been. The first
	-- decides how long to hold still next to a body (see CollectCorpses); the
	-- second is reported after a defense so a pickup can be judged.
	lastRecallAt = 0,
	carMoves = 0,
}

-- FindFirstChild, NOT WaitForChild: GunAction is a Wild-West-event-only
-- remote, not a permanent one. A hard WaitForChild here (as it was
-- originally written) hung the ENTIRE script load the moment the event
-- remote wasn't present -- confirmed, "Infinite yield
-- possible on ... WaitForChild(GunAction)" followed by the whole reload
-- never completing, leaving nothing working. Looked up fresh each call
-- (not cached) so it also recovers on its own if the event comes back.
-- PEEK FIRING -- come up, shoot, drop back under the ground before a bandit
-- can answer. Measured against roaming outlaws, and it is
-- the ONLY thing that beat them: 3 cycles of 0.5s up / 1.8s under killed one
-- for 8 damage taken, where standing in the open cost 64 damage in 15s.
--
-- It works because of one number in the game's own config: a bandit needs
-- ReactionMinSeconds (1.0 in a defense, 0.75 roaming) of holding us in sight
-- before it fires, and losing sight starts it again. Our own shots have no
-- such delay. So exposure shorter than their reaction is a real asymmetry,
-- and it is the only one that exists here.
--
-- Everything else was measured and ruled OUT, so nothing below
-- should be "improved" back into them:
--   * Distance and height do nothing to ROAMING OUTLAWS (1.5 degree spread).
--     They hit 12/12 at 100 studs and 2/2 at 200 studs straight overhead. The
--     old standoff this replaces was built on BanditAccuracy's SpreadDegrees
--     reducing with range; for them it does not. Town Defense bandits are a
--     different AI (4 degrees) and DO fall off with range: see
--     defenseFireDistances.
--   * Dodging does nothing. Teleporting every 0.1s over a 12-26 stud radius
--     still took 14 hits from 15 shots.
--   * Cover is exactly symmetric. Sinking into the ground a stud at a time,
--     our shots and theirs stopped landing at the SAME depth (both 36/40 at
--     the surface, both 0 once the head was ~3 studs down). There is no spot
--     that shoots out but cannot be shot into, including inside the slab.
--   * The client is trusted for nothing. Holding Humanoid.Health at 100 just
--     masked the display while the server marched its own tally 92 -> 23;
--     the outlaws' hitboxes blown up to a 300-stud box that contained us
--     gave 0 damage; a self-made "Sniper Rifle" Tool gave 0, and a spoofed
--     ItemId or GunAmmo on the real one changed neither damage nor ammo.
--   * The server caps the fire rate: 15 shots sent in one frame registered
--     ONE. Paced at 0.09s, 14 of 15 land -- about 100 damage a second, which
--     is why a peek is worth taking at all.
--
-- Two older measurements still hold and are load-bearing:
--   * The server checks line of sight on OUR shots too, so a firing spot
--     must have a real clear line and the hiding spot can never be one.
--   * Straight above a target does not hit; the ray's first hit has to be a
--     part parented DIRECTLY to the target model, not an accessory on it.
GOLDPAN.WW.Combat.pinConn = nil
-- The CFrame the hold writes every frame (nil when nothing is held). Read
-- by the hold itself each frame, so FaceTarget can turn a held character
-- without releasing it -- a release under the slab would lift the player.
GOLDPAN.WW.Combat.pinCFrame = nil
-- os.clock() of the last time Pin or FaceTarget moved or turned the player,
-- and how long a rocket waits after that. The SERVER picks a rocket's origin
-- from where it thinks the character is, and it lags a teleport -- measured
-- 2026-09-17 with 40-stud moves: fired 0.03 s and 0.06 s after, the rocket
-- left the OLD spot; 0.18 s after, a point 15 studs short of the new one (a
-- rocket starting there can fly back through the player); 0.12 s twice, 0.25 s
-- twice and 0.5 s all left the new spot.
GOLDPAN.WW.Combat.movedAt = 0
GOLDPAN.WW.Combat.rocketSettleSeconds = 0.25
-- How long a critical hold (see EngageFromCover) waits in cover before it
-- allows one more watching bandit: well under the 37 s roof stint measured
-- not to cancel a defense.
GOLDPAN.WW.Combat.criticalHoldSeconds = 8
GOLDPAN.WW.Combat.criticalNoticeAt = 0
-- Roaming outlaws only (see defenseFireDistances for Town Defense): close,
-- because range buys nothing against them and a short line is the one most
-- likely to be clear. Tried in order until one has a clear shot.
GOLDPAN.WW.Combat.fireDistances = { 25, 35, 45, 60 }
-- Town Defense picks its peek spot by risk, not by nearness (FiringSpot,
-- SpotRisk): a defense bandit's shot lands inside a 4 degree cone
-- (TownDefenseConfig.BanditAccuracy.SpreadDegrees), so how often it hits
-- falls with distance, while our own P90 has Range 400 and SpreadAngle 0
-- (GunConfig 227) and loses nothing. Measured off OutlawCombatFX
-- "Shot" over one defense, a hit being a tracer ending within 3.5 studs of the
-- player: shooters under 20 studs 4/7, 20-30 14/33, 30-40 1/5, 40-55 2/8,
-- 55-75 1/4, over 75 0/16 -- 18 of the 31 hits came from within 30 studs,
-- and the ring around the TARGET does not keep the other bandits out of it.
-- (The old "range buys nothing" was measured on roaming outlaws, 1.5 degrees.)
GOLDPAN.WW.Combat.defenseFireDistances = { 25, 35, 45, 60, 75, 90 }
-- Up for less than their reaction, down for long enough that the AI notices
-- it lost us. Both numbers are measured, and the hide is the fiddly one:
--   0.05s hide -- USELESS. 11 of 11 of their shots hit, 4.9 damage/second,
--     exactly the 4.8 of standing perfectly still. A dip that short falls
--     between two AI ticks and is never seen, so the timer never resets.
--   0.5s hide -- works. 18s of it drew zero shots with the target alive,
--     and end to end it killed 4 outlaws in 13.8s for 32 damage taken.
--   1.8s hide -- also works, no better, and a third of the firing time.
-- 0.6 for a little margin over the 0.5 that was tested. Defense bandits
-- react SLOWER than the roaming outlaws these numbers came from
-- (ReactionMinSeconds 1.0 vs 0.75), so this is the conservative direction.
--
-- The exposure is 0.45, not the 0.8 these were first measured at, because
-- damage taken tracks the fraction of time we are visible and wave 5 puts up
-- to 8 bandits on the field: one outlaw cost 2.3 damage/second at 0.8/0.6,
-- and eight lines of sight at that rate outruns the 1 HP/s regen by a mile.
-- 0.45 up / 0.6 down is 43% visible instead of 57%, and still lands about 5
-- shots a cycle because the server accepts one every 0.09s.
GOLDPAN.WW.Combat.exposeSeconds = 0.45
GOLDPAN.WW.Combat.hideSeconds = 0.6
-- Shots from one spot with the target's health unmoved before that spot is
-- written off for this target (see EngageFromCover). 12 is about 1.1s of
-- firing -- two peeks -- so a target that simply walked behind something for a
-- moment is not enough to lose the spot, but a fence rail the raycast passed
-- through is caught in a couple of seconds instead of the full 20s engage.
GOLDPAN.WW.Combat.blockedShotThreshold = 12
-- How far a new spot must be from one that did not work. The obstruction is
-- usually a fence line or a crop patch, so a few studs sideways is not enough.
GOLDPAN.WW.Combat.badSpotRadius = 12
-- How far below the underside of the ground to sit while hidden.
GOLDPAN.WW.Combat.coverDropStuds = 8

-- Holds the player at a point every frame. Nothing else keeps a character
-- in mid-air, and the same hold is what keeps one under the town while
-- hiding. Cleared by Unpin on every exit path, and by SESSION.Unload
-- (tracked) -- if neither ran the player would hang there for good.
-- `faceTowards` turns the held character to look at that point (level).
-- Without it the hold faces world -Z, and a rocket leaves ~3.8 studs in
-- FRONT of the character -- measured: a target behind got a
-- rocket launched on the far side that flew back through the player.
function GOLDPAN.WW.Combat.Pin(position, faceTowards)
	local me = GOLDPAN.WW.Combat
	me.Unpin()
	local character = LocalPlayer.Character
	me.pinCFrame = CFrame.new(position)
	me.movedAt = os.clock()
	if faceTowards then
		local level = Vector3.new(faceTowards.X, position.Y, faceTowards.Z)
		if (level - position).Magnitude > 0.1 then
			me.pinCFrame = CFrame.lookAt(position, level)
		end
	end
	me.pinConn = SESSION.Track(game:GetService("RunService").Heartbeat:Connect(function()
		if LocalPlayer.Character ~= character then
			me.Unpin()
			return
		end
		local hrp = GetFreshHRP()
		local target = me.pinCFrame
		if hrp and target then
			pcall(function() hrp.CFrame = target end)
			ZeroVelocity(hrp)
		end
	end))
end

-- Turns the character to look at `position` (level), where it stands --
-- through the hold when one is on, since the hold rewrites the CFrame every
-- frame. Returns true when it had to turn; either way movedAt tells a rocket
-- how long to wait for the server to see it. Within ~25 degrees is left alone.
function GOLDPAN.WW.Combat.FaceTarget(position)
	local me = GOLDPAN.WW.Combat
	local hrp = GetFreshHRP()
	if not hrp then
		return false
	end
	local current = me.pinCFrame or hrp.CFrame
	local from = current.Position
	local flat = Vector3.new(position.X - from.X, 0, position.Z - from.Z)
	if flat.Magnitude < 0.1 then
		return false
	end
	local look = current.LookVector
	local lookFlat = Vector3.new(look.X, 0, look.Z)
	if lookFlat.Magnitude > 0.1 and lookFlat.Unit:Dot(flat.Unit) > 0.9 then
		return false
	end
	local turned = CFrame.lookAt(from, from + flat)
	if me.pinCFrame then
		me.pinCFrame = turned
	end
	pcall(function() hrp.CFrame = turned end)
	me.movedAt = os.clock()
	return true
end

-- Releases the hold, and NEVER leaves the character under a floor while
-- doing it. There is nothing below the town's ground slab (measured: a
-- raycast 3000 studs down hits nothing), so a release down there drops the
-- player out of the world and the game kills them -- which is how a defense
-- ended `Defeat` at 100 HP in wave 1 when the last bandit died
-- mid-hide. A reload (SESSION.Unload) hits the same case, so the lift lives
-- here rather than in one caller: if something solid is directly overhead,
-- the player is put on top of it before the hold goes.
function GOLDPAN.WW.Combat.Unpin()
	local me = GOLDPAN.WW.Combat
	if me.pinConn then
		pcall(function() me.pinConn:Disconnect() end)
		me.pinConn = nil
	end
	me.pinCFrame = nil
	local hrp = GetFreshHRP()
	if not hrp then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LocalPlayer.Character }
	params.RespectCanCollide = true
	-- Ground below means letting go is safe, and that covers every ordinary
	-- release (a firing spot, a street, a roof). Only the hiding spot under
	-- the slab has nothing at all under it.
	if workspace:Raycast(hrp.Position, Vector3.new(0, -300, 0), params) then
		return
	end
	local roof = workspace:Raycast(hrp.Position, Vector3.new(0, 60, 0), params)
	if not roof then
		return
	end
	-- Stand on whatever was overhead: from well above it, the first surface
	-- coming down is its top.
	local top = workspace:Raycast(roof.Position + Vector3.new(0, 40, 0), Vector3.new(0, -60, 0), params)
	if top then
		pcall(function() hrp.CFrame = CFrame.new(top.Position + Vector3.new(0, 4, 0)) end)
		ZeroVelocity(hrp)
	end
end

-- True when a shot fired from `from` would actually reach `model`: the
-- first thing the ray meets must be a part of the model itself.
function GOLDPAN.WW.Combat.HasClearShot(from, model)
	local rootPart = model:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LocalPlayer.Character }
	local result = workspace:Raycast(from, (rootPart.Position - from) * 1.02, params)
	return result ~= nil and result.Instance.Parent == model
end

-- Where to stand to shoot `model` from one of `distances` studs away: the
-- first spot that is open ground (TPCACHE.OpenGround) AND sees the target --
-- `canSee(hrpPosition)` when given, else HasClearShot from head height.
-- Nearest distance first; at each, bearings start on the side facing
-- `towards` and fan out 30 degrees at a time both ways. Returns the ground
-- point, for TeleportPlayerOnly; nil when nothing qualifies.
--
-- Every spot an outlaw sweep teleports to near a target comes through here.
-- They used to be bare points N studs off the target, which at Business Bay
-- put the player inside solid buildings (see TPCACHE.GeometryParams).
function GOLDPAN.WW.Combat.OpenSpotNear(model, distances, towards, canSee)
	local me = GOLDPAN.WW.Combat
	local rootPart = model:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return nil
	end
	local center = rootPart.Position
	-- A target near the edge of streaming range (1024) can be loaded while the
	-- ground around it is not, and then every spot fails the floor test and
	-- this returns nil. The old fix asked the game to stream that ground on
	-- every retry, which spends the session's ~255 streaming requests and
	-- with them the game's own horse race (see TPCACHE.StreamAround); the
	-- caller lands on the target instead (UnloadedFeet).
	local bearing = Vector3.new(towards.X - center.X, 0, towards.Z - center.Z)
	if bearing.Magnitude < 0.1 then
		bearing = Vector3.new(1, 0, 0)
	end
	bearing = bearing.Unit
	for _, distance in ipairs(distances) do
		for step = 0, 6 do
			local signs = { 1, -1 }
			if step == 0 or step == 6 then
				signs = { 1 }
			end
			for _, sign in ipairs(signs) do
				local direction = CFrame.Angles(0, math.rad(30 * step * sign), 0):VectorToWorldSpace(bearing)
				local ground = TPCACHE.OpenGround(center + direction * distance)
				if ground then
					local hrpAt = ground + Vector3.new(0, 3, 0)
					local sees
					if canSee then
						sees = canSee(hrpAt)
					else
						sees = me.HasClearShot(hrpAt + Vector3.new(0, 1.5, 0), model)
					end
					if sees then
						return ground
					end
				end
			end
		end
	end
	return nil
end

-- Where to land on an outlaw more than 700 studs from `from` when nothing
-- around it has streamed in. Nothing there can be measured -- no floor to
-- test a spot against -- so its own feet are the one point known to be open
-- (it is walking there), and arriving is what streams the area in. The caller
-- fires from there; a target that walks off is followed by the next pass, which
-- by then can measure real ground. nil when the outlaw is close, or the floor
-- under it IS loaded (then OpenGround has already answered and said no for a
-- reason).
function GOLDPAN.WW.Combat.UnloadedFeet(rootPart, from)
	if (rootPart.Position - from).Magnitude <= 700 then
		return nil
	end
	local rays = TPCACHE.GeometryParams()
	if workspace:Raycast(rootPart.Position + Vector3.new(0, 4, 0), Vector3.new(0, -24, 0), rays) then
		return nil
	end
	GOLDPAN.WW.Combat.farLandings = (GOLDPAN.WW.Combat.farLandings or 0) + 1
	DebugPrint("[WildWestCombat] Nothing is streamed in around the outlaw, "
		.. string.format("%.0f", (rootPart.Position - from).Magnitude) .. " studs away -- landing on it")
	return rootPart.Position - Vector3.new(0, 3, 0)
end

-- The outlaw's own feet, when its Humanoid reports a floor under it. This is
-- the last resort the sweep always meant its "feet" to be, and it cannot be
-- TPCACHE.OpenGround: that rejects a spot when ANY solid part's box overlaps
-- it, and east of the farm two huge terrain MeshParts (376x87x376 and
-- 684x450x835, both CanCollide) overlap ground an outlaw is plainly walking on.
-- Measured at (763, 1724, 876): the floor is a Road part, those two
-- meshes are all that overlap, the outlaw's Humanoid says FloorMaterial Plastic,
-- and the sweep stood 180 s "retrying as it moves" with Auto Farm off (9 of
-- 125 sweeps in one console). Something an outlaw stands on is open ground.
function GOLDPAN.WW.Combat.StandingFeet(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local rootPart = model:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart or humanoid.FloorMaterial == Enum.Material.Air then
		return nil
	end
	return rootPart.Position - Vector3.new(0, 3, 0)
end

-- A firing spot for `model`: level with it, close, clear line, and inside
-- `bounds` when the caller has one to respect (Town Defense must not leave
-- its box). Level on purpose -- height was measured to buy nothing at all (see
-- PEEK FIRING above), and a flat line is the one most likely to be
-- unobstructed.
-- nil means nothing clear was found and the caller should close in instead.
-- `avoid` is a list of positions that have already been fired from without
-- doing damage (see EngageFromCover): the raycast says the line is clear and
-- the server disagrees -- a fence rail, a crop mesh, anything our ray passes
-- through but a real shot does not. There is no way to tell from here which,
-- so a spot that did not work is simply not offered again for this target.
-- `maxSeen`, when given, rejects any spot more than that many OTHER bandits
-- can see; the second return value is then true when a clear line existed
-- but every spot on it was too exposed (see EngageFromCover's critical hold).
-- With `bounds` (Town Defense) the choice among the spots that pass is the
-- lowest SpotRisk over defenseFireDistances; without it, the fewest other
-- bandits seeing the spot, nearest first.
function GOLDPAN.WW.Combat.FiringSpot(model, bounds, avoid, maxSeen)
	local me = GOLDPAN.WW.Combat
	local rootPart = model:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return nil
	end
	local origin = rootPart.Position
	local y = origin.Y
	local limit, half
	if bounds then
		limit = bounds.CFrame
		half = bounds.Size / 2
		y = math.min(y, bounds.Position.Y + half.Y - 6)
	end
	-- The spot is scored, not taken first-come: a peek exposes us to EVERY
	-- enemy that can see it, not just the one being shot at, and the damage
	-- taken scales with that count. Measured against a single
	-- outlaw, a peek cycle took 2.3 damage/second; a wave-5 defense puts up
	-- to MaxConcurrentEnemies (8) on the field at once, and eight lines of
	-- sight at that rate kills the player faster than 1 HP/s heals it. So
	-- the best spot is the one that sees the target and as few others as
	-- possible -- shooting from behind a building rather than in the open.
	local best, bestScore = nil, math.huge
	-- Without the defense's own config there is nothing to rank by, and every
	-- spot would tie at zero risk -- so fall back to the count.
	local config = GOLDPAN.WW.TownDefense and GOLDPAN.WW.TownDefense.Config
	local useRisk = bounds ~= nil and config ~= nil and config.EnemyTag ~= nil
	local distances = me.fireDistances
	if useRisk then
		distances = me.defenseFireDistances
	end
	local checked = 0
	-- Only counted to explain a nil return (see below) -- not spent on the
	-- normal case, so this costs nothing when a spot is actually found.
	local outOfBounds, avoided, blocked = 0, 0, 0
	local exposedOnly = false
	for _, distance in ipairs(distances) do
		for angle = 0, 330, 30 do
			-- 48 candidates, each costing a ray plus one per live enemy: with a
			-- full wave on the field that is hundreds of rays, and doing them
			-- all in one frame is what a client gets killed for.
			checked = checked + 1
			if checked % 16 == 0 then
				task.wait()
			end
			local radians = math.rad(angle)
			local spot = Vector3.new(origin.X + math.cos(radians) * distance, y, origin.Z + math.sin(radians) * distance)
			local ok = true
			if limit then
				local local_ = limit:PointToObjectSpace(spot)
				ok = math.abs(local_.X) < half.X - 4 and math.abs(local_.Y) < half.Y - 4 and math.abs(local_.Z) < half.Z - 4
			end
			if not ok then
				outOfBounds = outOfBounds + 1
			end
			-- The raw ring point, level with the target -- deliberately NOT
			-- filtered to open ground (TPCACHE.OpenGround), unlike the outlaw
			-- sweep's spots. Tried (10bd7bf): it throws out the spots
			-- tucked into scenery, and those are the ones the fewest bandits can
			-- see. Measured on the town's real geometry, 12 bandit positions: the
			-- best spot's exposure summed to 15 with the filter against 9
			-- without, and 6 of the 12 best spots were exactly such tucked-in
			-- ones. With the filter live the player took 1.5-2x the damage in
			-- waves 3-4 and won 1 defense in 5; the builds that won six in a row
			-- used the raw point. The hold (Pin) keeps the player there, so
			-- overlapping a wall traps no one.
			local hrpAt = nil
			if ok then
				hrpAt = spot
			end
			if hrpAt and avoid then
				for _, bad in ipairs(avoid) do
					if (bad - hrpAt).Magnitude < me.badSpotRadius then
						hrpAt = nil
						avoided = avoided + 1
						break
					end
				end
			end
			-- From the head, which is what has to see the target.
			if hrpAt and me.HasClearShot(hrpAt + Vector3.new(0, 1.5, 0), model) then
				-- The count is only needed for the caller's limit, or as the
				-- score when there is no risk to rank by.
				local seen = 0
				if maxSeen or not useRisk then
					seen = me.EnemiesSeeing(hrpAt, model)
				end
				if maxSeen and seen > maxSeen then
					exposedOnly = true
				else
					local score = seen
					if useRisk then
						score = me.SpotRisk(hrpAt)
					end
					if score < bestScore then
						best, bestScore = hrpAt, score
						if not useRisk and seen == 0 then
							-- Nothing else can shoot back from here; stop looking.
							return hrpAt
						end
					end
				end
			elseif hrpAt then
				blocked = blocked + 1
			end
		end
	end
	if not best and exposedOnly then
		-- Not a missing line, just the caller's exposure limit: no warn.
		return nil, true
	end
	if not best then
		warn(string.format(
			"[WildWestCombat] FiringSpot: all %d candidates rejected for %s at %d, %d, %d (%s HP) -- %d out of bounds, %d avoid-listed, %d no clear shot",
			checked, model.Name, math.floor(origin.X), math.floor(origin.Y), math.floor(origin.Z),
			tostring(model:FindFirstChildOfClass("Humanoid") and math.floor(model:FindFirstChildOfClass("Humanoid").Health)),
			outOfBounds, avoided, blocked))
	end
	return best
end

-- How much a Town Defense bandit line of sight to `spot` is worth fearing,
-- summed over every live bandit that can see it (the target too): 1 over the
-- square of its distance, floored at 15 studs. A shot's scatter is an angle,
-- so the share that hits something player-sized falls with the square of the
-- distance -- the shape the shot log follows (see defenseFireDistances).
-- Only the defense's own bandits: roaming outlaws do not fire during one.
function GOLDPAN.WW.Combat.SpotRisk(spot)
	local me = GOLDPAN.WW.Combat
	local config = GOLDPAN.WW.TownDefense and GOLDPAN.WW.TownDefense.Config
	local tag = config and config.EnemyTag
	if not tag then
		return 0
	end
	local from = spot + Vector3.new(0, 1.5, 0)
	local risk = 0
	for _, model in ipairs(game:GetService("CollectionService"):GetTagged(tag)) do
		if model:IsA("Model") and model.Parent then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local rootPart = model:FindFirstChild("HumanoidRootPart")
			if humanoid and rootPart and humanoid.Health > 0 then
				local distance = (rootPart.Position - spot).Magnitude
				if distance <= 220 and me.HasClearShot(from, model) then
					risk = risk + 1 / (math.max(distance, 15) ^ 2)
				end
			end
		end
	end
	return risk
end

-- How many live enemies OTHER than `exclude` have a clear line to `spot`.
-- Both enemy kinds are counted: Town Defense tags its bandits, roaming
-- outlaws live in workspace._Outlaws.
-- `onlyTag` restricts the check to one CollectionService tag instead of
-- every combat NPC in the game. Town Defense's roof safety needs this: a
-- roaming Outlaw Bounty target (workspace._Outlaws, its own unrelated
-- feature, present whether or not a defense is even running) has no part in
-- a defense and never fires on the player during one, but without this it
-- still counted as "seeing" a roof and voided it -- the user watched a roof
-- outlaws visibly could not hit them from get rejected as unsafe, then died
-- with nowhere else to go. FiringSpot's peek-spot scoring
-- (below) is a heuristic, not a safety gate, and still weighs every nearby
-- gun -- only the roof's strict "is this really zero visibility" check
-- needed narrowing.
function GOLDPAN.WW.Combat.EnemiesSeeing(spot, exclude, onlyTag)
	local me = GOLDPAN.WW.Combat
	local from = spot + Vector3.new(0, 1.5, 0)
	local seen = 0
	local function consider(model)
		if model == exclude or not model.Parent then
			return
		end
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local rootPart = model:FindFirstChild("HumanoidRootPart")
		if not humanoid or not rootPart or humanoid.Health <= 0 then
			return
		end
		-- Far enough away that its own shots are not the problem this pass.
		if (rootPart.Position - spot).Magnitude > 220 then
			return
		end
		if me.HasClearShot(from, model) then
			seen = seen + 1
		end
	end
	if onlyTag then
		for _, model in ipairs(game:GetService("CollectionService"):GetTagged(onlyTag)) do
			if model:IsA("Model") then
				consider(model)
			end
		end
		return seen
	end
	local config = GOLDPAN.WW.TownDefense and GOLDPAN.WW.TownDefense.Config
	local tag = config and config.EnemyTag
	if tag then
		for _, model in ipairs(game:GetService("CollectionService"):GetTagged(tag)) do
			if model:IsA("Model") then
				consider(model)
			end
		end
	end
	local outlaws = workspace:FindFirstChild("_Outlaws")
	if outlaws then
		for _, model in ipairs(outlaws:GetChildren()) do
			consider(model)
		end
	end
	return seen
end

-- Somewhere to duck below `position`: the underside of whatever ground is
-- under it, dropped coverDropStuds further. Measured by raycasting UP from
-- far below, because the first surface met coming up IS the underside, and
-- that slab is what has to end up between us and a bandit.
-- nil when there is nothing solid overhead to hide under, or when the spot
-- would leave `bounds` (leaving the box loses a Town Defense outright).
function GOLDPAN.WW.Combat.CoverUnder(position, bounds)
	local me = GOLDPAN.WW.Combat
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LocalPlayer.Character }
	params.RespectCanCollide = true
	local top = workspace:Raycast(position + Vector3.new(0, 30, 0), Vector3.new(0, -140, 0), params)
	if not top then
		return nil
	end
	local under = workspace:Raycast(
		Vector3.new(position.X, top.Position.Y - 250, position.Z),
		Vector3.new(0, 245, 0),
		params
	)
	if not under or (top.Position.Y - under.Position.Y) < 2 then
		return nil
	end
	local spot = Vector3.new(position.X, under.Position.Y - me.coverDropStuds, position.Z)
	if bounds then
		local inBox = bounds.CFrame:PointToObjectSpace(spot)
		local half = bounds.Size / 2
		if math.abs(inBox.X) > half.X - 4 or math.abs(inBox.Y) > half.Y - 4 or math.abs(inBox.Z) > half.Z - 4 then
			return nil
		end
	end
	return spot
end

-- OPTIONAL ROCKET OPENER. Nobody has to own a Bazooka (item 233) -- without
-- one every peek is just the gun, exactly as before. With one, a peek opens
-- with a rocket: measured, 40 damage to the target twice
-- over, and BazookaConfig adds 25 more to up to 3 others within 12 studs,
-- which is the only splash damage available to us at all. Equipping it
-- measured 0.11s and swapping back 0.11s, and its reload runs while it is
-- unequipped, so the rocket costs a quarter second of the peek and the blast
-- lands while we are already back under cover.
GOLDPAN.WW.Combat.bazookaItemId = "233"
-- EVERY owned Bazooka, each with its own reload. Measured with
-- three of them: each holds one rocket and reloads on its own (2.0 s), but
-- the game's FireCooldown (0.8 s) is per PLAYER -- three fired inside 0.53 s
-- landed ONE rocket between them. So several launchers do not burst; they
-- keep a loaded one in hand every ~0.85 s instead of every 2.5 s.
GOLDPAN.WW.Combat.bazookaGuids = nil
GOLDPAN.WW.Combat.bazookaReady = {}
GOLDPAN.WW.Combat.rocketCooldownUntil = 0
GOLDPAN.WW.Combat.rocketPlayerCooldown = 0.85
-- BazookaConfig.RocketSpeed. A rocket is a projectile, not a hitscan, so the
-- aim leads a walking target by its velocity over the flight time. Measured
-- Against the root: 40, 40, 40 and two 0s -- rockets are not
-- reliable hits, which is why the gun still fires after every one.
GOLDPAN.WW.Combat.rocketSpeed = 100
GOLDPAN.WW.Combat.gunGuid = nil
-- BazookaConfig.BlastRadius (18) plus a margin.
GOLDPAN.WW.Combat.rocketMinDistance = 22
-- Counted so a defense can report whether the rocket opener actually fired;
-- a silent no-op here is worth about a third of our damage in wave 5.
GOLDPAN.WW.Combat.rocketsFired = 0

-- Equips one exact inventory item and waits for THAT instance. Matching on
-- ItemId is not enough once someone owns several of a thing: with three
-- Bazookas in a row, "a Tool with ItemId 233 is in hand" came back true
-- instantly for the second and third, because the first was still held.
function GOLDPAN.WW.Combat.EquipExactAndWait(guid, seconds)
	pcall(function() REMOTES.EquipItem:FireServer(guid) end)
	local deadline = os.clock() + (seconds or 1)
	repeat
		task.wait(0.03)
		local character = LocalPlayer.Character
		local held = character and character:FindFirstChildOfClass("Tool")
		if held and held:GetAttribute("EquippedGuid") == guid then
			return held
		end
	until os.clock() > deadline
	return nil
end

-- Every Bazooka the player owns, looked up once per session. An empty list
-- latches too, so a player without one never pays for the lookup again; a
-- failed inventory call does not, and is retried next time.
function GOLDPAN.WW.Combat.FindBazookaGuids()
	local me = GOLDPAN.WW.Combat
	if me.bazookaGuids then
		return me.bazookaGuids
	end
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not ok or type(inventory) ~= "table" then
		return nil
	end
	local list = {}
	for guid, entry in pairs(inventory) do
		if tostring(entry.ItemId) == me.bazookaItemId then
			table.insert(list, guid)
		end
	end
	me.bazookaGuids = list
	return list
end

-- Launchers fired and not yet reloading. Measured with three,
-- standalone: a Bazooka only STARTS its reload while it is in hand -- 0.3 s
-- after the shot (AutoReloadDelay), or the instant an empty one is equipped
-- (BazookaReloading already true when the Tool appears). Once started, the
-- reload finishes with the launcher put away (loaded 2-3 s later, equipped
-- 0.07 s). The opener used to swap back to the gun 0.1 s after the shot,
-- before the reload could start, so a fired launcher stayed EMPTY until it
-- was next picked -- and that pick fired nothing. An explicit "Reload" sent
-- 0.05 s after the shot did not start it either (one try). So each fired
-- launcher is picked up once more while hiding, which costs one swap under
-- cover and no time in the open.
GOLDPAN.WW.Combat.needsReload = {}
-- BazookaConfig.ReloadTime (2.01), rounded up.
GOLDPAN.WW.Combat.reloadSeconds = 2.1
-- Picks that found the launcher empty. Should stay near 0 now; reported
-- after a defense next to rocketsFired.
GOLDPAN.WW.Combat.rocketsEmpty = 0

function GOLDPAN.WW.Combat.IsLauncher(tool)
	return tool ~= nil and tostring(tool:GetAttribute("ItemId")) == GOLDPAN.WW.Combat.bazookaItemId
end

-- The launcher to fire next: not waiting for its reload to be started, and
-- past the time its last reload should have finished.
function GOLDPAN.WW.Combat.ReadyLauncher()
	local me = GOLDPAN.WW.Combat
	local guids = me.FindBazookaGuids()
	if not guids then
		return nil
	end
	local now = os.clock()
	for _, guid in ipairs(guids) do
		if not me.needsReload[guid] and now >= (me.bazookaReady[guid] or 0) then
			return guid
		end
	end
	return nil
end

-- True when the launcher in hand holds a rocket. Waits a moment, because
-- BazookaAmmo has been seen to read 0 right after the Tool appears; a
-- BazookaReloading flag settles it at once.
function GOLDPAN.WW.Combat.LauncherLoaded(tool)
	local deadline = os.clock() + 0.15
	repeat
		if not tool.Parent or tool:GetAttribute("BazookaReloading") == true then
			return false
		end
		if (tool:GetAttribute("BazookaAmmo") or 0) >= 1 then
			return true
		end
		task.wait(0.03)
	until os.clock() > deadline
	return false
end

-- True when a rocket fired from `from` at `to` would not hit something solid
-- well short of the target. Only a hit in the first 60% of the way counts as
-- blocked: `BlastRadius` is 18 and `OutlawDamageRadius` 12, so a rocket that
-- clips something close to the target still does its damage, and rejecting
-- those would cost more rockets than it saves. RespectCanCollide, because a
-- projectile passes straight through the non-solid decoration that an
-- ordinary raycast stops at.
function GOLDPAN.WW.Combat.RocketPathClear(from, to, target)
	local muzzle = from + Vector3.new(0, 1.5, 0)
	local direction = to - muzzle
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LocalPlayer.Character, target }
	params.RespectCanCollide = true
	local hit = workspace:Raycast(muzzle, direction, params)
	if not hit then
		return true
	end
	return (hit.Position - muzzle).Magnitude > direction.Magnitude * 0.6
end

-- The gun back into our hands, by exact guid when we know it.
function GOLDPAN.WW.Combat.GunBack()
	local me = GOLDPAN.WW.Combat
	me.gunGuid = me.gunGuid or me.FindWeaponGuid()
	local gun = me.gunGuid and me.EquipExactAndWait(me.gunGuid, 0.8)
	if not gun then
		gun = me.EnsureWeaponEquipped()
	end
	return gun
end

-- Starts the reload of every launcher fired since the last call, by holding
-- each one for a moment (see needsReload). With `stage`, then keeps the next
-- LOADED launcher in hand for the coming peek, so the rocket flies the
-- instant we are up instead of after a swap in the open. Returns the Tool
-- in hand afterwards (nil when nothing changed hands).
function GOLDPAN.WW.Combat.ReloadLaunchers(stage)
	local me = GOLDPAN.WW.Combat
	local changed = false
	for guid in pairs(me.needsReload) do
		local launcher = me.EquipExactAndWait(guid, 0.6)
		if launcher then
			changed = true
			local deadline = os.clock() + 0.25
			while launcher.Parent and os.clock() < deadline and launcher:GetAttribute("BazookaReloading") ~= true
				and (launcher:GetAttribute("BazookaAmmo") or 0) < 1 do
				task.wait(0.03)
			end
			if launcher:GetAttribute("BazookaReloading") ~= true and (launcher:GetAttribute("BazookaAmmo") or 0) < 1 then
				-- Never seen: an empty launcher in hand that did not start on its
				-- own. Ask once, and say so, since a launcher that never reloads is
				-- a third of the damage in wave 5.
				local misc = ReplicatedStorage.Events:FindFirstChild("Misc")
				local action = misc and misc:FindFirstChild("BazookaAction")
				if action then
					pcall(function() action:FireServer(launcher, "Reload") end)
				end
				GOLDPAN.WW.ReportBlocked(me, "reloadWarned",
					"[WildWestCombat] A Bazooka did not start reloading when picked up -- asked it to reload")
			end
			me.bazookaReady[guid] = os.clock() + me.reloadSeconds
			me.needsReload[guid] = nil
		end
	end
	if stage and os.clock() + 0.3 >= me.rocketCooldownUntil then
		local pick = me.ReadyLauncher()
		local held = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
		if pick and held and held:GetAttribute("EquippedGuid") == pick then
			return held
		end
		local launcher = pick and me.EquipExactAndWait(pick, 0.6)
		if launcher then
			return launcher
		end
	end
	local held = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
	if changed or me.IsLauncher(held) then
		return me.GunBack()
	end
	return nil
end

-- One rocket at `target`, then the gun straight back into our hands.
-- Fires the launcher already in hand when one was staged under cover, and
-- otherwise swaps to a ready one first. Returns the gun Tool to carry on
-- with (a swap DESTROYS the old Tool instance, so the caller must take this
-- one) and whether a rocket flew. nil/false when nothing changed hands: no
-- bazooka, none ready, or the target too close.
function GOLDPAN.WW.Combat.RocketOpener(target, currentTool)
	local me = GOLDPAN.WW.Combat
	local held = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
	local staged = nil
	if me.IsLauncher(held) then
		staged = held
	end
	if currentTool and currentTool.Parent and not me.IsLauncher(currentTool) then
		me.gunGuid = me.gunGuid or currentTool:GetAttribute("EquippedGuid")
	end
	me.gunGuid = me.gunGuid or me.FindWeaponGuid()

	local rootPart = target and target:FindFirstChild("HumanoidRootPart")
	local hrp = GetFreshHRP()
	local misc = ReplicatedStorage.Events:FindFirstChild("Misc")
	local action = misc and misc:FindFirstChild("BazookaAction")
	-- Never rocket something close enough to catch us in the blast.
	-- BazookaConfig.BlastRadius is 18, and the nearest firing spot is 25, so
	-- this only bites when the target has walked in since the spot was
	-- picked -- which is exactly when it would hurt.
	local canFire = true
	if not rootPart or not hrp or not action or not me.gunGuid or os.clock() < me.rocketCooldownUntil then
		canFire = false
	elseif (rootPart.Position - hrp.Position).Magnitude < me.rocketMinDistance then
		canFire = false
	elseif not me.RocketPathClear(hrp.Position, rootPart.Position, target) then
		-- A rocket is a real projectile: it stops at the first solid thing,
		-- unlike the gun's hitscan and unlike the raycast FiringSpot used to
		-- pick this spot (which ignores nothing and sees through nothing the
		-- same way). Around the Wild West farm that is a fence rail, and the
		-- rocket is worth 40 damage -- the peek is better spent on the gun.
		canFire = false
	end

	local rocket = nil
	if canFire and staged then
		rocket = staged
	elseif canFire then
		local pick = me.ReadyLauncher()
		if pick then
			rocket = me.EquipExactAndWait(pick, 0.8)
		end
	end
	if not rocket and not staged then
		return nil, false
	end

	local fired = false
	if rocket then
		local guid = rocket:GetAttribute("EquippedGuid")
		-- The rocket leaves ~3.8 studs in front of the character (measured
		-- Off BazookaFX "Launch"), so a target behind us got one
		-- fired back through the player. Turn first, then give the server
		-- rocketSettleSeconds from the last move or turn to catch up (see
		-- movedAt); LauncherLoaded's own wait below counts toward it.
		me.FaceTarget(rootPart.Position)
		if me.LauncherLoaded(rocket) then
			local settle = me.movedAt + me.rocketSettleSeconds - os.clock()
			if settle > 0 then
				task.wait(settle)
			end
			-- At the body, led by the target's horizontal velocity over the flight
			-- time. NOT low: measured, aiming 1.5 studs under the root
			-- missed a STANDING target twice for 0 -- the rocket lands short and
			-- the splash does not reach -- where aiming at the root hit for 40.
			local distance = (rootPart.Position - hrp.Position).Magnitude
			local velocity = rootPart.AssemblyLinearVelocity
			local lead = Vector3.new(velocity.X, 0, velocity.Z) * (distance / me.rocketSpeed)
			pcall(function() action:FireServer(rocket, "Fire", rootPart.Position + lead) end)
			fired = true
			me.rocketsFired = (me.rocketsFired or 0) + 1
			me.rocketCooldownUntil = os.clock() + me.rocketPlayerCooldown
			if guid then
				me.needsReload[guid] = true
			end
		else
			-- Picking up an empty launcher starts its reload (measured), so this
			-- pick already did what a hide would have.
			me.rocketsEmpty = (me.rocketsEmpty or 0) + 1
			if guid then
				me.needsReload[guid] = nil
				me.bazookaReady[guid] = os.clock() + me.reloadSeconds
			end
		end
	end
	return me.GunBack(), fired
end

-- Fights `model` in peek cycles: up at a spot with a clear line for less
-- than a bandit's reaction time, then under the ground for longer than it
-- takes them to lose the aim. See PEEK FIRING above for why this and
-- nothing else. `coverSpot` overrides where to duck to -- Town Defense
-- passes its own measured hiding spot, which is known to stay inside the
-- arena box.
-- Returns true if the target is down, false if it timed out or the caller
-- aborted, nil when no clear firing spot exists at all, so the caller can
-- fall back to point-blank Engage on a target under a roof.
-- `maxSeenFn`, when given, is asked before every peek for the most OTHER
-- bandits the peek spot may be visible to (nil = no limit); see the critical
-- hold below.
function GOLDPAN.WW.Combat.EngageFromCover(tool, model, maxSeconds, shouldAbort, bounds, coverSpot, maxSeenFn)
	local me = GOLDPAN.WW.Combat
	local deadline = os.clock() + (maxSeconds or 20)
	local gunAction = me.GetGunAction()
	if not gunAction then
		warn("[WildWestCombat] GunAction remote not found, aborting engage")
		return false
	end
	local everPinned = false
	-- The surface spot the player was last pinned at, and the only safe place
	-- to let go of them. NOTHING is below the town slab (measured: a raycast
	-- 3000 studs down hits nothing), so dropping the pin while hidden
	-- down there leaves the character falling out of the world, and the game
	-- kills it.
	-- Measured: wave 1's last bandit died while we were
	-- hidden, the pin was released there, and the defense ended `Defeat --
	-- All defenders have been eliminated` five seconds later, at 100 HP.
	local surface = nil
	local function release()
		local root = GetFreshHRP()
		if surface and root and root.Position.Y < surface.Y - 4 then
			pcall(function() root.CFrame = CFrame.new(surface) end)
			ZeroVelocity(root)
		end
		GOLDPAN.WW.Combat.Unpin()
	end
	-- Spots whose shots did nothing (see badSpots / FiringSpot). The raycast
	-- and the server disagree around the Wild West farm -- fences, crops --
	-- and without this the peek loop fires from the same blocked spot until
	-- maxSeconds runs out, which is pure wasted time.
	local badSpots = {}
	local shotsAtSpot, healthAtSpot, lastSpot = 0, nil, nil
	local heldSince = nil
	-- The caller's limit, loosened by one watching bandit for every
	-- criticalHoldSeconds already spent holding -- never dropped all at once.
	-- Seen: 23 HP -> 7 HP inside a critical hold, and the
	-- fight after the last roof stint (back at 17) was the death. The old drop
	-- to "any spot" after 8 s is the likely way in (inferred -- that run had
	-- no per-hit log).
	local function limitNow()
		if not maxSeenFn then
			return nil
		end
		local limit = maxSeenFn()
		if limit ~= nil and heldSince then
			limit = limit + math.floor((os.clock() - heldSince) / me.criticalHoldSeconds)
		end
		return limit
	end
	while os.clock() < deadline and SESSION.alive do
		if shouldAbort and shouldAbort() then
			release()
			return false
		end
		-- A weapon swap DESTROYS the old Tool instance, so a gone tool means
		-- "get another one", never "the target is dead" -- reading it as the
		-- latter would report every rocket opener as a kill. A launcher staged
		-- in hand under cover is left there: RocketOpener fires it on the way up.
		local inHand = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
		if me.IsLauncher(inHand) then
			tool = inHand
		elseif not tool or not tool.Parent then
			tool = me.EnsureWeaponEquipped()
			if not tool then
				release()
				return false
			end
		end
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local rootPart = model:FindFirstChild("HumanoidRootPart")
		if not model.Parent or not humanoid or not rootPart or humanoid.Health <= 0 then
			release()
			return true
		end
		-- FiringSpot itself warns with the rejection breakdown when it comes
		-- back nil -- silent before 2026-09-18, which looked identical to
		-- "target out of range."
		-- CRITICAL HOLD (the user's call 2026-09-18, after a wave 5 won on 10 HP:
		-- the roof time was spent at 12:12:04 and the player peeked on at
		-- 10-21 HP, where one boss hit -- measured at 20 -- ends the run).
		-- While maxSeenFn sets a limit, a peek goes up only where at most that
		-- many other bandits can see; with none, it waits in cover (healing
		-- 1 HP/s) and looks again, allowing one more bandit per
		-- criticalHoldSeconds (limitNow), so the player is never out of reach
		-- long enough to cancel the defense.
		local maxSeen = limitNow()
		local spot, exposedOnly = me.FiringSpot(model, bounds, badSpots, maxSeen)
		while not spot and exposedOnly and coverSpot and os.clock() < deadline and SESSION.alive do
			if not heldSince then
				heldSince = os.clock()
				if os.clock() - (me.criticalNoticeAt or 0) > 30 then
					me.criticalNoticeAt = os.clock()
					local who = "no other bandit"
					if maxSeen and maxSeen > 0 then
						who = "at most " .. maxSeen .. " other bandit"
					end
					print(string.format("[AutoTownDefense] Down to %d HP with no roof time left -- holding in cover, only peeking where %s can see",
						math.floor(LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
							and LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health or 0), who))
				end
			end
			-- A hold can come before this engage's first peek, when `surface`
			-- is still unset -- and release() only lifts the player back up
			-- when it has one. Without this, any exit from the hold let go of
			-- them under the slab, with nothing below to stand on (found by
			-- review 2026-09-18; the 10:19 Defeat on 2026-09-17 was that fall).
			-- Where they stand now is surface: every engage starts up top.
			if not surface then
				local standing = GetFreshHRP()
				if standing and standing.Position.Y > coverSpot.Y + 10 then
					surface = standing.Position
				end
			end
			me.Pin(coverSpot, rootPart.Position)
			local holdUntil = os.clock() + 0.5
			while os.clock() < holdUntil and SESSION.alive do
				if shouldAbort and shouldAbort() then
					release()
					return false
				end
				if humanoid.Health <= 0 or not model.Parent then
					release()
					return true
				end
				task.wait(0.1)
			end
			maxSeen = limitNow()
			spot, exposedOnly = me.FiringSpot(model, bounds, badSpots, maxSeen)
		end
		if spot then
			heldSince = nil
		end
		if not spot then
			release()
			-- false, not nil, after a critical hold: nil sends the caller to
			-- close in point-blank, the last thing to do at this health.
			if everPinned or exposedOnly then
				return false
			end
			return nil
		end
		local cover = coverSpot or me.CoverUnder(spot, bounds)
		surface = spot
		everPinned = true
		-- The spot is re-picked every cycle and is usually the same one, so the
		-- shot count carries over until it really moves.
		if not lastSpot or (lastSpot - spot).Magnitude > 2 then
			lastSpot, shotsAtSpot, healthAtSpot = spot, 0, humanoid.Health
		end

		-- UP. The target walks, so the line is re-checked every cycle
		-- rather than trusted for the whole engage.
		-- Facing the target: a rocket starts in front of the character.
		me.Pin(spot, rootPart.Position)
		task.wait(0.12)
		-- A rocket first when one is loaded, then the gun for the rest of
		-- the peek. Silently skipped by anyone without a Bazooka.
		local swapped = me.RocketOpener(model, tool)
		if swapped then
			tool = swapped
		end
		if not tool or not tool.Parent or me.IsLauncher(tool) then
			tool = me.GunBack()
			if not tool then
				release()
				return false
			end
		end
		local expose = os.clock() + me.exposeSeconds
		while os.clock() < expose and os.clock() < deadline and SESSION.alive do
			if humanoid.Health <= 0 or not model.Parent then
				release()
				return true
			end
			-- shouldAbort is only checked between peeks otherwise (top of this
			-- outer loop, and every 0.15s while hidden below) -- this window is
			-- up to exposeSeconds (0.45s) of standing in the open with no check
			-- at all, the same gap Engage() was fixed for on 2026-09-16 (see its
			-- comment). Town Defense passes a low-health abort here; a lower
			-- Retreat Health % leaves less HP to survive a burst inside it.
			if shouldAbort and shouldAbort() then
				release()
				return false
			end
			if tool:GetAttribute("GunReloading") then
				task.wait(0.1)
			elseif (tool:GetAttribute("GunAmmo") or 0) <= 0 then
				-- Reload under cover, never standing in the open.
				pcall(function() gunAction:FireServer(tool, "Reload") end)
				break
			else
				-- 0.09s: measured as the fastest pace the server accepts,
				-- 14 of 15 shots. Sending them faster registers ONE.
				pcall(function() gunAction:FireServer(tool, "Fire", rootPart.Position) end)
				shotsAtSpot = shotsAtSpot + 1
				task.wait(0.09)
			end
		end

		-- Shots leaving but no health coming off means something the raycast
		-- went through is stopping them (the Wild West farm's fences and crops
		-- do this). Same test Engage already makes; here it moves the spot
		-- instead of standing in one place until maxSeconds runs out.
		if shotsAtSpot >= me.blockedShotThreshold and healthAtSpot and humanoid.Health >= healthAtSpot then
			table.insert(badSpots, spot)
			lastSpot = nil
			DebugPrint(string.format("[WildWestCombat] %d shots from one spot did nothing to %s -- something is in the way, moving",
				shotsAtSpot, model.Name))
		elseif healthAtSpot and humanoid.Health < healthAtSpot then
			shotsAtSpot, healthAtSpot = 0, humanoid.Health
		end

		-- DOWN.
		if cover then
			me.Pin(cover, rootPart.Position)
			local hidden = os.clock() + me.hideSeconds
			-- Under cover: start the reload of the launcher just fired, and hold
			-- the next loaded one ready for the way up (see needsReload).
			local inHand = me.ReloadLaunchers(true)
			if inHand then
				tool = inHand
			end
			while os.clock() < hidden and os.clock() < deadline and SESSION.alive do
				if shouldAbort and shouldAbort() then
					release()
					return false
				end
				if humanoid.Health <= 0 or not model.Parent then
					release()
					return true
				end
				task.wait(0.15)
			end
		else
			-- Nothing to duck under here. Keep fighting rather than stall,
			-- but this is the case that costs health -- it is the old
			-- stand-and-trade, and the warn says so once per engage.
			GOLDPAN.WW.ReportBlocked(me, "noCoverWarned",
				"[WildWestCombat] No ground to duck under near " .. model.Name .. ", trading shots in the open")
			local inHand = me.ReloadLaunchers(false)
			if inHand then
				tool = inHand
			end
			task.wait(0.1)
		end
	end
	release()
	return false
end

function GOLDPAN.WW.Combat.GetGunAction()
	local misc = ReplicatedStorage.Events:FindFirstChild("Misc")
	return misc and misc:FindFirstChild("GunAction")
end

-- A latched, one-line-per-transition report for "this feature owns a toggle
-- that is on but can never do anything". DebugPrint was the wrong level for
-- it: with debug off, Auto Defend Town with no gun in the inventory is a
-- switch the user flicks on and watches do literally nothing, with no clue
-- why -- which is exactly what happened. Latched so a 1s poll
-- cannot bury the console, and cleared again when the blocker goes away so
-- the recovery is visible too.
function GOLDPAN.WW.ReportBlocked(holder, key, message)
	if holder[key] then
		return
	end
	holder[key] = true
	warn(message)
end

function GOLDPAN.WW.ClearBlocked(holder, key, message)
	if not holder[key] then
		return
	end
	holder[key] = false
	if message then
		print(message)
	end
end

function GOLDPAN.WW.Combat.FindWeaponGuid()
	local ok, inventory = pcall(function()
		return REMOTES.GetPlayerInventory:InvokeServer()
	end)
	if not ok or type(inventory) ~= "table" then
		warn("[WildWestCombat] GetPlayerInventory failed: " .. tostring(inventory))
		return nil
	end
	for guid, entry in pairs(inventory) do
		if GOLDPAN.WW.Combat.weaponItemIds[tostring(entry.ItemId)] then
			return guid
		end
	end
	return nil
end

-- Equips whatever gun is already in hand if it qualifies, otherwise
-- equips one from inventory. Returns the Tool, or nil if none owned.
function GOLDPAN.WW.Combat.EnsureWeaponEquipped()
	local character = LocalPlayer.Character
	local existing = character and character:FindFirstChildOfClass("Tool")
	if existing and GOLDPAN.WW.Combat.weaponItemIds[tostring(existing:GetAttribute("ItemId"))] then
		return existing
	end

	local guid = GOLDPAN.WW.Combat.FindWeaponGuid()
	if not guid then
		return nil
	end

	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		pcall(function() humanoid:UnequipTools() end)
		task.wait(0.2)
	end

	local equipOk, equipErr = pcall(function()
		REMOTES.EquipItem:FireServer(guid)
	end)
	if not equipOk then
		warn("[WildWestCombat] EquipItem failed: " .. tostring(equipErr))
		return nil
	end
	task.wait(0.5)

	character = LocalPlayer.Character
	return character and character:FindFirstChildOfClass("Tool")
end

-- Fires on `model` (needs a live Humanoid + HumanoidRootPart) until it
-- dies, stops existing, or `maxSeconds` runs out -- the timeout exists so
-- a target that walks out of range or despawns mid-fight cannot hang the
-- caller's loop forever. GunAmmo/GunReloading live on the TOOL instance
-- (measured from the game's own GunClient), not the character.
--
-- `shouldAbort`, if given, is checked every loop pass AND sliced into the
-- longest single wait below (the 1.5s reload wait) so it is never blind
-- for more than ~0.3s. Town Defense passes one that reads the player's OWN
-- health; without this, a caller could sit inside one up-to-10s Engage call
-- with the low-health flee check outside it never getting a chance to run
-- at all -- confirmed live 2026-09-16: `HealthOk()` is only checked between
-- Engage calls, and wave 5's damage output killed the player inside one.
-- Outlaw Hunt does not pass one and is unaffected.
--
-- Also tracks shots-fired-without-damage: firing at a raw world position
-- (GunAction "Fire", not a raycast or a target reference) means something
-- between the player and that exact point -- a hay bale the target is
-- standing in/behind, confirmed from a screenshot -- can
-- eat every shot even at the point-blank standoff both callers already
-- use. Rather than model the geometry (unmeasured whether the server's
-- hit check even uses line of sight), this just notices "several shots
-- fired, target's Health hasn't moved" and tries a different angle around
-- the target before giving up -- the same shape of fix as the wall-corner
-- issue this function's callers already standoff-fixed once.
function GOLDPAN.WW.Combat.Engage(tool, model, maxSeconds, shouldAbort)
	local deadline = os.clock() + (maxSeconds or 10)
	local shotsSinceReposition = 0
	local healthAtRepositionStart = nil
	local repositionsLeft = 4
	local noDamageShotThreshold = 10
	-- SESSION.alive as well as the clock: a reload must not leave the old
	-- run firing a gun for another ten seconds while the new one drives.
	while os.clock() < deadline and SESSION.alive do
		if shouldAbort and shouldAbort() then
			return false
		end
		if not model.Parent or not tool.Parent then
			return true
		end
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local rootPart = model:FindFirstChild("HumanoidRootPart")
		if not humanoid or not rootPart or humanoid.Health <= 0 then
			return true
		end
		if not healthAtRepositionStart then
			healthAtRepositionStart = humanoid.Health
		end
		local gunAction = GOLDPAN.WW.Combat.GetGunAction()
		if not gunAction then
			warn("[WildWestCombat] GunAction remote not found, aborting engage")
			return false
		end

		if tool:GetAttribute("GunReloading") then
			task.wait(0.3)
		elseif tool:GetAttribute("GunAmmo") == 0 then
			pcall(function() gunAction:FireServer(tool, "Reload") end)
			local waited = 0
			while waited < 1.5 and not (shouldAbort and shouldAbort()) do
				task.wait(0.3)
				waited = waited + 0.3
			end
		else
			pcall(function() gunAction:FireServer(tool, "Fire", rootPart.Position) end)
			shotsSinceReposition = shotsSinceReposition + 1
			task.wait(0.12)
		end

		if shotsSinceReposition >= noDamageShotThreshold then
			if humanoid.Health >= healthAtRepositionStart and repositionsLeft > 0 then
				repositionsLeft = repositionsLeft - 1
				local hrp = GetFreshHRP()
				if hrp then
					local direction = rootPart.Position - hrp.Position
					if direction.Magnitude < 0.1 then
						direction = Vector3.new(1, 0, 0)
					else
						direction = direction.Unit
					end
					-- 90 degrees each retry, so 4 attempts sweep all the
					-- way around the target before this gives up on it.
					local rotated = CFrame.Angles(0, math.rad(90), 0):VectorToWorldSpace(direction)
					-- Still 4 studs (Town Defense uses this too and must not
					-- leave its box), but only onto open ground that sees the
					-- target: a blind point beside a target walking along a
					-- wall is inside the wall.
					local spot = GOLDPAN.WW.Combat.OpenSpotNear(model, { 4 }, rootPart.Position - rotated)
					if spot then
						TeleportPlayerOnly(spot)
						task.wait(0.2)
						DebugPrint("[WildWestCombat] " .. shotsSinceReposition .. " shots on " .. model.Name .. " with no damage -- trying a different angle")
					else
						DebugPrint("[WildWestCombat] " .. shotsSinceReposition .. " shots on " .. model.Name .. " with no damage, and no open ground beside it -- staying put")
					end
				end
			end
			shotsSinceReposition = 0
			healthAtRepositionStart = humanoid.Health
		end
	end
	return false
end

-- Scans _Carryables for defeated-Outlaw bodies (OutlawCorpse attribute,
-- NOT the Owner-filtered GetCarryablePrompts() above) and fires each
-- one's PickupPrompt after teleporting into range.
-- The prompt itself says "Add to Vehicle": a successful pickup REPARENTS
-- the corpse into the truck's cargo hold (confirmed:
-- Workspace._Carryables.Outlaw became Workspace."Flying UFO".Outlaw) --
-- it does not destroy the instance or clear its Parent, so checking
-- `item.Parent == nil` for success looked like permanent failure on
-- every single successful pickup. That false negative sent this
-- function through several wrong "fixes" (driving the vehicle by hand
-- via SetPrimaryPartCFrame, waiting out the seat timing) that were never
-- the actual problem -- confirmed by re-testing the plain
-- VEHICLESPAWN.RequestAndWait recall (the same one CatchUpVehicle above
-- already uses for auction pickup) and finding it lands the truck within
-- ~15-35 studs of wherever the player currently is -- usually, not always:
-- right after a long teleport it can land at the previous spot instead,
-- so the distance is measured after every recall. The other real fix was
-- checking the right thing: is the corpse still a child of `carryables`,
-- not whether it has any parent at all.
function GOLDPAN.WW.Combat.TruckDistance(position)
	local truck = GetPlayerTruck()
	local ok, pivot = pcall(function() return truck:GetPivot() end)
	if not (truck and ok and pivot) then
		return math.huge
	end
	return (pivot.Position - position).Magnitude
end

-- Every body still waiting on the ground, as { item, position } pairs.
-- Skips bodies CollectCorpses gave up on, same as AnyCorpseWaiting.
function GOLDPAN.WW.Combat.WaitingCorpses()
	local list = {}
	local carryables = workspace:FindFirstChild("_Carryables")
	if not carryables then
		return list
	end
	for _, item in ipairs(carryables:GetChildren()) do
		local state = GOLDPAN.WW.Combat.corpseAttempts[item]
		if item:GetAttribute("OutlawCorpse") and not (state and state.gaveUp) then
			local ok, pivot = pcall(function() return item:GetPivot() end)
			if ok and pivot then
				table.insert(list, { item = item, position = pivot.Position })
			end
		end
	end
	return list
end

-- Calls the car to `spot`: the player stands there, the car lands 18-33
-- studs away (measured) and the player climbs back out. The server's recall
-- cooldown is armed by RequestAndWait itself (VEHICLESPAWN.cooldownUntil).
function GOLDPAN.WW.Combat.RecallCarAt(spot)
	local me = GOLDPAN.WW.Combat
	local hrp = GetFreshHRP()
	local far = (not hrp) or (hrp.Position - spot).Magnitude > 300
	TeleportPlayerOnly(spot)
	-- Measured: a recall fired 0.2-0.3s after a 600-1500 stud
	-- teleport sometimes (2 of 13 trials) landed the car back where the player
	-- had come FROM and pulled the player back into it; 2s later it landed
	-- right. The game also pauses the player for ~0.3s while a far area loads
	-- (GameplayPaused). Both were only ever seen after FAR teleports, so a hop
	-- across town settles briefly instead of for a full second (inferred; the
	-- caller measures where the car landed either way).
	local pauseDeadline = os.clock() + 5
	while LocalPlayer.GameplayPaused and os.clock() < pauseDeadline do
		task.wait(0.1)
	end
	if far then
		task.wait(1)
	else
		task.wait(0.3)
	end
	-- RequestAndWait arms VEHICLESPAWN.cooldownUntil on every request it
	-- fires, accepted or not: the server's cooldown applies after a SUCCESSFUL
	-- recall too, so the next corpse -- and Auto Farm's catch-up -- waits it
	-- out instead of firing (and losing) its own request.
	VEHICLESPAWN.RequestAndWait(2)
	me.lastRecallAt = os.clock()
	me.carMoves = me.carMoves + 1
end

-- Where to stand when calling the car for the body at `position`:
-- recallStandoffStuds away from it, on whichever side is farthest from every
-- OTHER waiting body, so the car does not land on the next one instead.
-- Bodies lie close together after a defense. A lone outlaw has no
-- neighbours, and then the side nearest the player wins (the shortest hop,
-- which is what this always did before).
--
-- Only open ground counts (TPCACHE.OpenGround): the player stands there for
-- the recall, and at Business Bay 52 of 960 of these points were inside a
-- solid building (measured 2026-09-18). With none open on the ring, closer
-- rings are tried -- still inside the car's reach, see recallStandoffStuds
-- -- and last the body's own spot, which is open: an outlaw died there.
function GOLDPAN.WW.Combat.StandoffSpot(position, exclude)
	local me = GOLDPAN.WW.Combat
	local others = {}
	for _, corpse in ipairs(me.WaitingCorpses()) do
		if corpse.item ~= exclude then
			table.insert(others, corpse.position)
		end
	end
	local hrp = GetFreshHRP()
	local best, bestClear, bestHop
	for _, radius in ipairs({ me.recallStandoffStuds, 40, 30 }) do
		for angle = 0, 330, 30 do
			local radians = math.rad(angle)
			local spot = TPCACHE.OpenGround(position + Vector3.new(math.cos(radians), 0, math.sin(radians)) * radius)
			if spot then
				-- In 10-stud steps up to 60: past that a neighbour is out of the
				-- car's landing range (18-33 studs) either way, and the hop decides.
				local clear = 60
				for _, other in ipairs(others) do
					clear = math.min(clear, (other - spot).Magnitude)
				end
				clear = math.floor(clear / 10)
				local hop = 0
				if hrp then
					hop = (hrp.Position - spot).Magnitude
				end
				if not best or clear > bestClear or (clear == bestClear and hop < bestHop) then
					best, bestClear, bestHop = spot, clear, hop
				end
			end
		end
		if best then
			return best
		end
	end
	DebugPrint("[WildWestCombat] No open ground around the body to call the car from, calling it to the body itself")
	return TPCACHE.OpenGround(position) or position
end

-- ONE car for the whole town after a defense (the user's call 2026-09-17):
-- the bodies lie close together there, so one recall to a spot within reach
-- of most of them beats the per-body recalls an outlaw sweep needs across the
-- map. Stands where the most bodies stay in reach of wherever the car lands,
-- and away from any single body so it does not park on one. Waits out the
-- recall cooldown, because this is the one recall the pickup is planned
-- around. Returns how many bodies were waiting.
function GOLDPAN.WW.Combat.CallCarToCorpses(label)
	local me = GOLDPAN.WW.Combat
	local corpses = me.WaitingCorpses()
	if #corpses == 0 then
		return 0
	end
	local allInReach = true
	for _, corpse in ipairs(corpses) do
		if me.TruckDistance(corpse.position) > me.truckReachStuds then
			allInReach = false
			break
		end
	end
	if allInReach then
		print(string.format("%s The car is already in reach of all %d bodies", label, #corpses))
		return #corpses
	end
	local center = Vector3.new(0, 0, 0)
	for _, corpse in ipairs(corpses) do
		center = center + corpse.position
	end
	center = center / #corpses
	-- The car lands up to 33 studs from the player (measured), so a body only
	-- counts as covered with that margin left inside truckReachStuds.
	local covers = me.truckReachStuds - 35
	local best, bestScore, bestCovered
	for _, radius in ipairs({ 0, 30, 60 }) do
		for angle = 0, 330, 30 do
			local radians = math.rad(angle)
			local spot = center + Vector3.new(math.cos(radians), 0, math.sin(radians)) * radius
			local covered, nearest = 0, math.huge
			for _, corpse in ipairs(corpses) do
				local distance = (corpse.position - spot).Magnitude
				nearest = math.min(nearest, distance)
				if distance <= covers then
					covered = covered + 1
				end
			end
			-- Coverage first; among equals, the spot farthest from any body
			-- (up to 40 studs, past which the car cannot land on one).
			local score = covered * 100 + math.min(nearest, 40)
			if not best or score > bestScore then
				best, bestScore, bestCovered = spot, score, covered
			end
		end
	end
	local cooldown = VEHICLESPAWN.cooldownUntil - os.clock()
	if cooldown > 0 then
		task.wait(cooldown)
	end
	me.RecallCarAt(best)
	print(string.format("%s Called the car to town for %d bodies (%d in reach of where it was sent)", label, #corpses, bestCovered))
	return #corpses
end

function GOLDPAN.WW.Combat.CollectCorpses()
	local me = GOLDPAN.WW.Combat
	local carryables = workspace:FindFirstChild("_Carryables")
	if not carryables then
		return 0
	end

	local attempts = me.corpseAttempts
	-- Drop tracking for anything no longer in _Carryables (collected or
	-- despawned) so this table stays the size of what is currently on the
	-- ground, not everything ever seen this session.
	for corpse in pairs(attempts) do
		if corpse.Parent ~= carryables then
			attempts[corpse] = nil
		end
	end

	local collected = 0
	for _, item in ipairs(carryables:GetChildren()) do
		-- Same reason as Engage: this teleports repeatedly and can recall the
		-- truck, so a torn-down run has to stop partway rather than finish the
		-- list under the new run's feet.
		if SESSION.alive and item.Parent and item:GetAttribute("OutlawCorpse") then
			local state = attempts[item]
			-- A body waiting for its car move skips the retry pause; the recall
			-- cooldown below is what paces that.
			local coolingDown = state and not state.moveCar and (os.clock() - state.lastAttemptAt) < me.corpseRetryCooldown
			if state and state.gaveUp then
				-- Already tried and failed corpseMaxAttempts times; leave it
				-- for the next CollectCorpses call, which prunes it the
				-- moment it is gone.
			elseif coolingDown then
				DebugPrint("[WildWestCombat] " .. item.Name .. " failed recently, waiting before retrying")
			else
			local succeeded = false
			local refused = false
			local prompt = nil
			for _, descendant in ipairs(item:GetDescendants()) do
				if descendant:IsA("ProximityPrompt") then
					prompt = descendant
					break
				end
			end

			local pivotOk, pivot = pcall(function() return item:GetPivot() end)
			local hrp = GetFreshHRP()
			-- Only a recall or a fired prompt counts as an attempt. A pass that
			-- merely waited out the recall cooldown used to count as well, so
			-- with several bodies queued behind one recall every 15s, the later
			-- ones ran out of attempts before their turn ever came.
			local tried = false
			if prompt and pivotOk and pivot and hrp then
				local reach = me.truckReachStuds
				local moveCar = state and state.moveCar
				if moveCar or me.TruckDistance(pivot.Position) > reach then
					if os.clock() < VEHICLESPAWN.cooldownUntil then
						DebugPrint("[WildWestCombat] Recall still on cooldown, skipping " .. item.Name .. " this pass")
					else
						tried = true
						if moveCar then
							print(string.format("[WildWestCombat] %s was refused %d times with the car in reach -- calling the car %d studs away from it and trying again",
								item.Name, state.refusedSinceMove, me.recallStandoffStuds))
						else
							DebugPrint("[WildWestCombat] No car close enough, recalling one to " .. item.Name)
						end
						-- Recalling lands the car wherever the player stands, so
						-- stand off first (see recallStandoffStuds).
						me.RecallCarAt(me.StandoffSpot(pivot.Position, item))
						if state then
							state.moveCar = false
							state.refusedSinceMove = 0
						end
						moveCar = false
					end
				end

				-- Measured, never assumed from the recall: RequestAndWait only
				-- says the player got seated, not where. This used to fire the
				-- prompt on its word alone, so a recall that landed at the old
				-- spot meant "Your vehicle is too far away" on every try.
				local truckDistance = me.TruckDistance(pivot.Position)
				if not moveCar and truckDistance <= reach then
					tried = true
					-- Hold still next to the body only while a seat exit can still
					-- pull the player back: that was only ever seen within 0.12s
					-- of leaving a just-recalled car (see ArriveNear). Every body
					-- after the first in a row is 0.15s instead of 0.5s.
					local hold = nil
					if (os.clock() - me.lastRecallAt) > 3 then
						hold = 0.15
					end
					-- ArriveNear, not a bare teleport: a teleport made just
					-- after leaving the seat of a recalled car is pulled back
					-- within ~0.12s (measured 2026-09-13), which fired this
					-- prompt from 30 studs away. PickupDistance is 10.
					if TPCACHE.ArriveNear(prompt.Parent, 8, hold) then
						-- Read before firing: a picked-up body is renamed
						-- (TossActor_<guid>) on its way into the car.
						local name = item.Name
						pcall(function() fireproximityprompt(prompt) end)
						-- Done the moment the body leaves the ground, rather than
						-- after a fixed wait.
						-- item.Parent, not carryables:FindFirstChild(item.Name):
						-- every corpse of a kind shares a Name, so with two down
						-- at once the name lookup can find the OTHER one.
						local loadDeadline = os.clock() + (prompt.HoldDuration or 0) + 0.6
						repeat
							task.wait(0.05)
						until item.Parent ~= carryables or os.clock() > loadDeadline
						if item.Parent ~= carryables then
							succeeded = true
							collected = collected + 1
							print("[WildWestCombat] Loaded " .. name .. " into the car")
						else
							refused = true
							warn(string.format("[WildWestCombat] Fired the pickup prompt on %s but it is still on the ground (car %.0f studs away)",
								name, truckDistance))
						end
					else
						DebugPrint("[WildWestCombat] Could not stay next to " .. item.Name .. ", retrying later")
					end
				elseif tried then
					DebugPrint(string.format("[WildWestCombat] Recall for %s left the car %.0f studs away, retrying later", item.Name, truckDistance))
				end
			end

			if succeeded then
				attempts[item] = nil
			elseif tried then
				state = state or { count = 0, refusedSinceMove = 0 }
				state.count = state.count + 1
				state.lastAttemptAt = os.clock()
				-- A refusal with the car in reach is the case waiting does not
				-- fix; after corpseRecallAfterFails of them the car is moved.
				if refused then
					state.refusedSinceMove = (state.refusedSinceMove or 0) + 1
					if state.refusedSinceMove >= me.corpseRecallAfterFails then
						state.moveCar = true
					end
				end
				if state.count >= me.corpseMaxAttempts then
					state.gaveUp = true
					warn("[WildWestCombat] Giving up on " .. item.Name .. " after " .. state.count .. " failed pickups")
				end
				attempts[item] = state
			end
			end
		end
	end
	return collected
end

-- OutlawBounty.Trade sweeps every non-favorited/non-quest Outlaw body
-- from inventory AND vehicles in one call; a no-op with nothing to turn
-- in just gets the Sheriff's "no outlaws" line, which is harmless.
function GOLDPAN.WW.Combat.TurnInToSheriff()
	local sheriff = game:GetService("CollectionService"):GetTagged("BountyHunterNPC")[1]
	if not sheriff then
		return false
	end

	local hrp = GetFreshHRP()
	local posOk, sheriffPosition = pcall(function() return sheriff:GetPivot().Position end)
	if hrp and posOk then
		local offset = sheriffPosition - hrp.Position
		if offset.Magnitude > 9 then
			TeleportPlayerOnly(sheriffPosition - offset.Unit * 8)
			task.wait(0.2)
		end
	end

	-- InvokeServer has no timeout of its own, so a Sheriff that never answers
	-- would park the calling loop for good -- still holding the floor and the
	-- Auto Farm hold, which is what a night with no auctions looked like on
	-- (this call was a guess from the timing, never observed).
	-- Asked from its own thread: a silent server now costs 10 s and a warning.
	-- (Hardening only: the freeze that was actually measured is the streaming
	-- request in TPCACHE.StreamAround, not this call.)
	local answered, ok, result = false, nil, nil
	task.spawn(function()
		ok, result = pcall(function()
			return ReplicatedStorage.Events.OutlawBounty.Trade:InvokeServer(sheriff)
		end)
		answered = true
	end)
	local deadline = os.clock() + 10
	while not answered and os.clock() < deadline and SESSION.alive do
		task.wait(0.1)
	end
	if not answered then
		if SESSION.alive then
			warn("[WildWestCombat] The Sheriff did not answer the turn-in within 10 s -- giving up on it this time")
		end
		return false, "no answer"
	end
	return ok, result
end

-- Checked before the Outlaw loop's periodic Sheriff catch-up: without
-- this, "30s since the last turn-in" alone counted as work even with
-- nothing owned, so the very first 30s tick (lastTurnInAt starts at 0)
-- fired a Sheriff visit for nothing, and it kept firing every 30s after
-- that -- teleporting away mid-Gold-Pan-session with no outlaw to show
-- for it. Confirmed: a picked-up Outlaw reparents into
-- the TRUCK's cargo (Workspace."<truck>".Outlaw, keeping its OutlawCorpse
-- attribute), it does NOT show up in GetPlayerInventory at all -- that
-- was the first version of this check, and it returned 0 with 3 real
-- outlaws sitting in the truck, i.e. it would have blocked the catch-up
-- from ever firing again.
function GOLDPAN.WW.Combat.HasOutlawsToTurnIn()
	local truck = GetPlayerTruck()
	if not truck then
		return false
	end
	for _, child in ipairs(truck:GetChildren()) do
		if child:GetAttribute("OutlawCorpse") then
			return true
		end
	end
	return false
end

function GOLDPAN.WW.Combat.AnyCorpseWaiting()
	local carryables = workspace:FindFirstChild("_Carryables")
	if not carryables then
		return false
	end
	for _, item in ipairs(carryables:GetChildren()) do
		-- A body CollectCorpses gave up on is not "waiting": counting it kept
		-- a sweep idling, with Auto Farm off, until the 180s sweep cap.
		local state = GOLDPAN.WW.Combat.corpseAttempts[item]
		if item:GetAttribute("OutlawCorpse") and not (state and state.gaveUp) then
			return true
		end
	end
	return false
end

-- Master Cycle is the sole owner of the HRP while FARM.active (hard
-- constraint, see CLAUDE.md) -- so panning, hunting, racing and defending,
-- which all teleport the player directly, must hold Auto Farm off while
-- they run rather than fight it for control.
--
-- ONE shared record of who is holding it, keyed by feature name, NOT a
-- per-feature snapshot. Per-feature snapshots is what "farm restarts
-- mid-fight" was (user): the second feature to pause recorded
-- "Auto Farm was already off", then the FIRST one to finish restored what
-- IT had seen and switched Auto Farm back on underneath the feature still
-- running -- the Master Cycle driving the truck around in the middle of a
-- town defense, with the second feature unable to re-pause because its own
-- holdingFarm flag said it already had. Auto Farm and Auto Fish now go
-- back on only when the LAST holder lets go.
GOLDPAN.WW.Hold = {
	owners = {},
	count = 0,
	wasFarmActive = false,
	wasFishActive = false,
	handoffUntil = 0,
	-- owner -> os.clock() it was first seen holding Auto Farm without holding
	-- the floor lock (see ReleaseOrphans). Cleared when the owner holds the
	-- lock again or its hold is gone.
	orphanSince = {},
}

-- `auctionWaitSeconds` is a per-caller budget for the auction FSM, because
-- Race cannot spend 60s waiting inside a 20s mount window. Waiting at all
-- is the point: the old combat pause skipped AUCTION.BusyReason entirely
-- and would yank the player out of a live lot. Returns false when it gave
-- up, and a false return means the caller must not proceed.
-- `myPriority` lets the wait below bail the moment something more important
-- queues for the floor -- without it, a feature that had already claimed
-- the floor would sit inside a 60s auction wait doing nothing while a race
-- it outranks nothing timed out waiting for it. Returns false when it gave
-- up, and a false return means the caller must not proceed.
function GOLDPAN.WW.PauseFarm(reason, auctionWaitSeconds, myPriority)
	local hold = GOLDPAN.WW.Hold
	if hold.owners[reason] then
		return true
	end

	if hold.count == 0 then
		local waited = 0
		local budget = auctionWaitSeconds or 60
		while SESSION.alive and AUCTION.BusyReason() and waited < budget do
			if myPriority and GOLDPAN.WW.ShouldYield(myPriority) then
				DebugPrint("[WildWest] " .. reason .. " stopped waiting on the auction, something more important needs the floor")
				return false
			end
			task.wait(1)
			waited = waited + 1
		end
		local blocked = AUCTION.BusyReason()
		if blocked then
			DebugPrint("[WildWest] " .. reason .. " stood down, still mid-auction: " .. tostring(blocked))
			return false
		end

		-- The wait for LOOPGUARDS.masterCycle is not a courtesy -- it is the
		-- only thing that tells us the Master Cycle has actually let go of
		-- the HRP, and it is the WHOLE point of pausing. It used to time out
		-- after 5s and return true regardless, which is far short of one
		-- collecting-and-placing iteration: the feature then mounted a horse
		-- or teleported to an outlaw while the farm was still driving the
		-- truck. Report the failure instead, and let the caller retry.
		hold.wasFarmActive = FARM.active
		if FARM.active and FARM.toggle and FARM.toggle.Set then
			DebugPrint("[WildWest] Pausing Auto Farm for " .. reason)
			pcall(function() FARM.toggle:Set(false) end)
			local guardWaited = 0
			while LOOPGUARDS.masterCycle and guardWaited < 25 and SESSION.alive do
				task.wait(0.25)
				guardWaited = guardWaited + 0.25
			end
			if LOOPGUARDS.masterCycle then
				warn("[WildWest] " .. reason .. ": Auto Farm has not finished its cycle yet, backing off rather than fighting it for the player")
				hold.wasFarmActive = false
				pcall(function() FARM.toggle:Set(true) end)
				return false
			end
		end

		-- Auto Fish is gated on `not FARM.active`, so turning Auto Farm off
		-- above does not leave it alone -- it RELEASES it. It then puts a rod
		-- in the same Tool slot every one of these features needs for a gun,
		-- a pan or a horse.
		hold.wasFishActive = AUTOFISH.active
		if AUTOFISH.active and AUTOFISH.toggle and AUTOFISH.toggle.Set then
			print("[WildWest] Pausing Auto Fish for " .. reason .. " -- they share the tool slot")
			pcall(function() AUTOFISH.toggle:Set(false) end)
			local fishWaited = 0
			while LOOPGUARDS.autoFish and fishWaited < 20 and SESSION.alive do
				task.wait(0.25)
				fishWaited = fishWaited + 0.25
			end
			if LOOPGUARDS.autoFish then
				warn("[WildWest] " .. reason .. ": Auto Fish has not put the rod down yet, backing off")
				if hold.wasFarmActive and FARM.toggle and FARM.toggle.Set then
					pcall(function() FARM.toggle:Set(true) end)
				end
				pcall(function() AUTOFISH.toggle:Set(true) end)
				hold.wasFarmActive, hold.wasFishActive = false, false
				return false
			end
		end

		-- Checked AGAIN now that the Master Cycle has let go. The check above
		-- ran while it was still mid-iteration, and that iteration can pay a
		-- garage's entry fee on its way out -- and the auction FSM runs on its
		-- own, so a stopped farm does not stop it. Measured 2026-09-18 11:06:
		-- "Pausing Auto Farm for TownDefense", then "Entry accepted, fee 10
		-- paid"; the defense joined, the lot opened, and Auto Win teleported
		-- the player 312 studs back to the garage and held them there 10 s:
		-- Defeat, "The defenders have left town." Only a lot being bid on
		-- moves the player (Auto Win); a lot won meanwhile (COLLECTING) goes
		-- back to the farm to pick up, just below.
		local function lotInFlight()
			return AUCTION.winRunning or AUCTION.state == "BIDDING"
				or (AUCTION.feePaidAt ~= nil and (os.clock() - AUCTION.feePaidAt) < 10)
		end
		local lotWaited = 0
		while SESSION.alive and lotInFlight() and lotWaited < budget do
			if myPriority and GOLDPAN.WW.ShouldYield(myPriority) then
				break
			end
			task.wait(0.5)
			lotWaited = lotWaited + 0.5
		end
		if lotInFlight() then
			warn("[WildWest] " .. reason .. ": Auto Farm entered an auction on its way out (" .. tostring(AUCTION.BusyReason()) ..
				") -- letting it finish before taking the player")
			if hold.wasFarmActive and FARM.toggle and FARM.toggle.Set then
				pcall(function() FARM.toggle:Set(true) end)
			end
			if hold.wasFishActive and AUTOFISH.toggle and AUTOFISH.toggle.Set then
				pcall(function() AUTOFISH.toggle:Set(true) end)
			end
			hold.wasFarmActive, hold.wasFishActive = false, false
			return false
		end
		if lotWaited > 0 then
			print(string.format("[WildWest] %s waited %.0f s for an auction Auto Farm had just entered", reason, lotWaited))
		end
		-- A lot WON while we waited is still on the garage floor, and only
		-- the Master Cycle picks it up -- so the farm gets the player back to
		-- collect it and the caller tries again on its next poll. Measured
		-- Outlaw waited out the bidding, took the player the
		-- moment the lot was won, and a $65k lot was left uncollected.
		if AUCTION.state == "COLLECTING" then
			print("[WildWest] " .. reason .. ": Auto Farm just won a lot and has not picked it up yet -- letting it collect first")
			if hold.wasFarmActive and FARM.toggle and FARM.toggle.Set then
				pcall(function() FARM.toggle:Set(true) end)
			end
			if hold.wasFishActive and AUTOFISH.toggle and AUTOFISH.toggle.Set then
				pcall(function() AUTOFISH.toggle:Set(true) end)
			end
			hold.wasFarmActive, hold.wasFishActive = false, false
			return false
		end
	end

	hold.owners[reason] = true
	hold.count = hold.count + 1
	-- A handoff placeholder exists only to keep the hold alive across the
	-- gap between one feature letting go and the next taking over; the
	-- moment a real owner arrives it has done its job.
	if reason ~= "Handoff" and hold.owners.Handoff then
		hold.owners.Handoff = nil
		hold.count = hold.count - 1
	end
	GOLDPAN.WW.SyncBusy()
	return true
end

function GOLDPAN.WW.ResumeFarm(reason)
	local hold = GOLDPAN.WW.Hold
	if not hold.owners[reason] then
		return
	end
	hold.owners[reason] = nil
	hold.count = hold.count - 1
	if hold.count > 0 then
		DebugPrint("[WildWest] " .. reason .. " let go, but " .. hold.count .. " still holding Auto Farm")
		GOLDPAN.WW.SyncBusy()
		return
	end

	hold.count = 0
	-- Something is already queued for the floor, so switching Auto Farm back
	-- on here would start the Master Cycle teleporting for the half second
	-- before the next feature pauses it again -- and the next feature would
	-- then have to wait out the cycle it just started (see the guard wait in
	-- PauseFarm). Hand the hold over instead of dropping it.
	if reason ~= "Handoff" and GOLDPAN.WW.Waiting() then
		hold.owners.Handoff = true
		hold.count = 1
		hold.handoffUntil = os.clock() + 90
		DebugPrint("[WildWest] " .. reason .. " handed the Auto Farm hold straight to the next feature")
		GOLDPAN.WW.SyncBusy()
		return
	end

	if SESSION.alive and hold.wasFarmActive and FARM.toggle and FARM.toggle.Set then
		DebugPrint("[WildWest] Resuming Auto Farm")
		pcall(function() FARM.toggle:Set(true) end)
	end
	-- After Auto Farm, not before: Auto Fish's own loop waits on
	-- `not FARM.active`, so handing it back first would have it start casting
	-- in the gap before Auto Farm is on again.
	if SESSION.alive and hold.wasFishActive and AUTOFISH.toggle and AUTOFISH.toggle.Set then
		print("[WildWest] Resuming Auto Fish")
		pcall(function() AUTOFISH.toggle:Set(true) end)
	end
	hold.wasFarmActive, hold.wasFishActive = false, false
	GOLDPAN.WW.SyncBusy()
end

-- The handoff placeholder above is the one hold with no loop behind it, so
-- it is the one that could keep Auto Farm off if the feature it was left
-- for never turned up. Called from Holder(), which every ShouldYield goes
-- through, so any running Wild West loop expires it within a couple of
-- seconds of the deadline.
function GOLDPAN.WW.ExpireHandoff()
	local hold = GOLDPAN.WW.Hold
	if hold.owners.Handoff and os.clock() > (hold.handoffUntil or 0) then
		warn("[WildWest] Nobody picked up the Auto Farm handoff -- giving it back")
		GOLDPAN.WW.ResumeFarm("Handoff")
	end
end

-- Every feature takes the floor lock BEFORE it pauses Auto Farm and gives the
-- lock back AFTER it resumes it, so a Farm hold whose owner no longer holds
-- the lock belongs to a coroutine that died or hung. Holder() expires such a
-- lock for exactly that reason but used to leave the Farm hold behind, which
-- kept Auto Farm off for good: measured, an Outlaw sweep's hold
-- outlived its lock by 2.4 hours -- a night of Wild West and no auctions.
-- The grace comes on top of the lock's own lease (that already had to lapse
-- before the lock was cleared), and a holder that is merely slow takes its
-- lock back on its next Renew, which clears the orphan mark -- only one that
-- never renews again is cut off.
GOLDPAN.WW.orphanGraceSeconds = 60

function GOLDPAN.WW.ReleaseOrphans()
	local hold = GOLDPAN.WW.Hold
	local now = os.clock()
	local stale = {}
	for owner in pairs(hold.owners) do
		if owner ~= "Handoff" then
			if GOLDPAN.WW.LockName == owner then
				hold.orphanSince[owner] = nil
			elseif not hold.orphanSince[owner] then
				hold.orphanSince[owner] = now
			elseif now - hold.orphanSince[owner] >= GOLDPAN.WW.orphanGraceSeconds then
				table.insert(stale, owner)
			end
		end
	end
	for owner in pairs(hold.orphanSince) do
		if not hold.owners[owner] then
			hold.orphanSince[owner] = nil
		end
	end
	for _, owner in ipairs(stale) do
		warn(string.format("[WildWest] %s has held Auto Farm for %.0f s without holding the floor -- its loop looks stuck, giving Auto Farm back (that feature may stay stuck until the script is reloaded)",
			owner, now - hold.orphanSince[owner]))
		hold.orphanSince[owner] = nil
		GOLDPAN.WW.ResumeFarm(owner)
	end
end

-- Its own loop, not a check inside Holder(): the feature loops only call
-- Holder() while they are running, and a stuck one is exactly the case where
-- nothing is calling it. Nothing else starts or stops it -- it is two table
-- reads every 5s.
function GOLDPAN.WW.StartWatchdog()
	if LOOPGUARDS.wwWatchdog then
		return
	end
	LOOPGUARDS.wwWatchdog = true
	task.spawn(function()
		while LOOPGUARDS.wwWatchdog and SESSION.alive do
			-- Two guards, so an error in one cannot starve the other. Each
			-- warns once, then stays quiet until it has run clean again.
			local expireOk, expireErr = pcall(GOLDPAN.WW.Holder)
			if expireOk then
				GOLDPAN.WW.watchdogExpireWarned = false
			elseif not GOLDPAN.WW.watchdogExpireWarned then
				GOLDPAN.WW.watchdogExpireWarned = true
				warn("[WildWest] Watchdog could not check the floor lock: " .. tostring(expireErr))
			end
			local orphanOk, orphanErr = pcall(GOLDPAN.WW.ReleaseOrphans)
			if orphanOk then
				GOLDPAN.WW.watchdogOrphanWarned = false
			elseif not GOLDPAN.WW.watchdogOrphanWarned then
				GOLDPAN.WW.watchdogOrphanWarned = true
				warn("[WildWest] Watchdog could not check the Auto Farm hold: " .. tostring(orphanErr))
			end
			local stallOk, stallErr = pcall(FARM.CheckStall)
			if stallOk then
				GOLDPAN.WW.watchdogStallWarned = false
			elseif not GOLDPAN.WW.watchdogStallWarned then
				GOLDPAN.WW.watchdogStallWarned = true
				warn("[WildWest] Watchdog could not check the master cycle: " .. tostring(stallErr))
			end
			task.wait(5)
		end
		LOOPGUARDS.wwWatchdog = false
	end)
end

GOLDPAN.WW.StartWatchdog()

-- =========================================================
-- OUTLAW BOUNTIES (Wild West event) -- hunts roaming outlaws with any
-- owned gun, collects the bodies, turns them in. Confirmed live
-- Equip -> fire -> OutlawState "Gone" -> body in
-- _Carryables all measured directly, not guessed.
-- =========================================================
GOLDPAN.WW.Outlaw = {
	active = false,
	intervalSeconds = 1,
	engageRange = 25,
	-- Close enough to be essentially standing on the outlaw, not just
	-- "in range": the user found a wall corner sitting between player and
	-- target at the old 20-stud standoff, silently eating every shot.
	-- A wall segment being between two nearly-overlapping points is rare,
	-- so this is cheaper than raycasting for line of sight.
	closeDistance = 4,
	-- Where to stand for a rocket: outside RocketOpener's own rocketMinDistance
	-- (22, itself BlastRadius 18 plus margin), close enough that the 100 stud/s
	-- projectile lands in about a quarter second.
	rocketStandoff = 26,
	-- Past this the rocket's 100 stud/s flight gives a walking outlaw too long
	-- to leave the aim point, so it is worth moving in first.
	rocketMaxRange = 120,
	-- Below this, the gun finishes faster than the standoff costs, and the
	-- rocket would be spent on an outlaw already nearly down.
	rocketMinHealth = 45,
	warnedNoGun = false,
	-- Each roaming outlaw respawns on its OWN 150s timer when killed
	-- (LassoConfig.RespawnSeconds), not as a batch -- so hunting one the
	-- moment it appears means pausing/resuming Auto Farm constantly as
	-- they trickle back in one at a time. Waiting for every slot to fill
	-- (LassoConfig.OutlawCount, 8) before engaging turns that into one
	-- Farm-paused sweep per full cycle instead. A sweep once started runs
	-- to the end even as the roaming count drops below the threshold
	-- mid-sweep, rather than stopping and resuming Farm partway.
	--
	-- `pending` is a sweep that is DUE but has not run yet -- queued rather
	-- than fired the instant it is decided. That split is the whole fix for
	-- the user's "outlaw barges in": the 160s timer now only
	-- decides that a sweep is owed, and the sweep itself waits for the floor
	-- to be free. A race or a wave delays it; nothing cancels it, and
	-- lastSweepAt is stamped when a sweep actually STARTS, not when it was
	-- merely decided, so time spent waiting is not charged against the next
	-- one.
	pending = false,
	-- Wall-clock cap on one sweep, so a target that cannot be killed (stuck
	-- geometry, a despawn race) cannot hold the floor indefinitely.
	maxSweepSeconds = 180,
	-- A full batch is a REASON to sweep, not a licence to sweep constantly.
	-- Without this floor, a batch the sweep cannot clear -- no gun owned, or
	-- outlaws whose HumanoidRootPart has not streamed in, so FindTarget
	-- rejects every one CountRoaming counted -- ends the sweep instantly,
	-- leaves the count still at 8, and re-declares it on the very next tick.
	-- That tears Auto Farm and Auto Fish down and restarts them every few
	-- seconds forever, with a Master Cycle teleport on each restart.
	minSweepGapSeconds = 30,
	minRoamingToEngage = 8,
	-- Fallback so this never waits indefinitely: measured
	-- that the population did NOT reliably reach 8/8 within the expected
	-- ~150s window (stuck at 2/8 well past it, cause not confirmed) -- so
	-- rather than trust the theoretical respawn math, sweep whatever is
	-- currently up at least this often, whichever check (full batch or
	-- this timer) comes first.
	sweepIntervalSeconds = 160,
	lastSweepAt = 0,
}
do
	local lassoConfig = SafeRequire(ReplicatedStorage.Modules.LassoConfig, "LassoConfig")
	if lassoConfig and lassoConfig.OutlawCount then
		GOLDPAN.WW.Outlaw.minRoamingToEngage = lassoConfig.OutlawCount
	end
end

function GOLDPAN.WW.Outlaw.CountRoaming()
	local count = 0
	for _, model in ipairs(game:GetService("CollectionService"):GetTagged("LassoOutlaw")) do
		if model.Parent and not model:GetAttribute("TownDefenseId") and model:GetAttribute("OutlawState") == "Roaming" then
			count = count + 1
		end
	end
	return count
end

function GOLDPAN.WW.Outlaw.FindTarget()
	local hrp = GetFreshHRP()
	if not hrp then
		return nil
	end
	local best, bestDistance
	for _, model in ipairs(game:GetService("CollectionService"):GetTagged("LassoOutlaw")) do
		if model.Parent and not model:GetAttribute("TownDefenseId") then
			local state = model:GetAttribute("OutlawState")
			if state == "Roaming" or state == "Fighting" then
				local rootPart = model:FindFirstChild("HumanoidRootPart")
				if rootPart then
					local distance = (rootPart.Position - hrp.Position).Magnitude
					if not bestDistance or distance < bestDistance then
						best, bestDistance = model, distance
					end
				end
			end
		end
	end
	return best
end

-- One sweep, start to finish. It owns the floor and the Auto Farm hold for
-- its whole duration and gives BOTH back on every exit path.
--
-- Written as its own function with a single exit on purpose: as an inline
-- block inside the loop it had three ways out that released neither -- the
-- natural end of a sweep whose last corpse was collected on the killing
-- pass being one of them -- and each of those left Auto Farm switched off
-- with nothing left running to switch it back on.
--
-- Returns true when the sweep is FINISHED (nothing left to hunt or carry),
-- false when it was deferred or interrupted and still owes the caller a
-- run.
function GOLDPAN.WW.Outlaw.RunSweep()
	local me = GOLDPAN.WW.Outlaw
	-- 40s, not a few: the handoff is cooperative, so the wait has to outlast
	-- the LONGEST blocking call of whatever is below us -- one Gold Pan
	-- cycle, capped at 30s. A shorter wait gives up before panning ever
	-- reaches its next yield check, clears the request, and the sweep never
	-- gets in at all. An outlaw sweep loses nothing by waiting.
	if not GOLDPAN.WW.Acquire(GOLDPAN.WW.PRIORITY.Outlaw, "Outlaw", me.maxSweepSeconds, 40) then
		return false
	end
	-- 45s of auction budget: an outlaw sweep is the one thing here that
	-- loses nothing by waiting, so it is the one that should wait longest
	-- rather than pull the player out of a live lot.
	if not GOLDPAN.WW.PauseFarm("Outlaw", 45, GOLDPAN.WW.PRIORITY.Outlaw) then
		GOLDPAN.WW.Release("Outlaw")
		return false
	end

	me.lastSweepAt = os.clock()
	local sweepDeadline = os.clock() + me.maxSweepSeconds
	local finished = false
	-- Town Defense zeroes the shared counter when its own run ends, so this is
	-- a difference, floored at 0, not a running total.
	local rocketsAtStart = GOLDPAN.WW.Combat.rocketsFired or 0

	-- Everything between here and the release runs inside a pcall. Without
	-- it a single error -- a corpse despawning between two lines, a respawn
	-- mid-teleport -- kills the coroutine holding BOTH the floor and the
	-- Auto Farm hold, which reads to the user as "outlaws just stopped and
	-- the farm never came back". The Master Cycle wraps its own iterations
	-- for exactly this reason.
	local sweepOk, sweepErr = pcall(function()
	while me.active and LOOPGUARDS.autoOutlaw and SESSION.alive do
		if GOLDPAN.WW.ShouldYield(GOLDPAN.WW.PRIORITY.Outlaw) then
			print("[AutoOutlaw] Standing down mid-sweep -- picking it back up when the floor is free")
			break
		end
		if os.clock() > sweepDeadline then
			warn("[AutoOutlaw] Sweep ran past " .. me.maxSweepSeconds .. "s, stopping so it cannot hold the floor")
			finished = true
			break
		end
		-- 120s, not the time left on the sweep: this deadline exists to spot
		-- a DEAD coroutine, so it has to be comfortably longer than the
		-- longest blocking call that follows it. CollectCorpses can spend
		-- ~25s in a single truck recall, and a floor that expires under a
		-- live holder is worse than no watchdog -- it lets a second feature
		-- claim and drive the character alongside this one. The real cap on
		-- how long a sweep may run is sweepDeadline, checked above.
		GOLDPAN.WW.Renew("Outlaw", 120)

		-- Equipping happens INSIDE the claim, never before it: it takes the
		-- Tool slot, and doing it on the way to a claim that might be refused
		-- is exactly how this used to pull the pan out of the player's hands
		-- for a sweep it then did not run.
		local tool = GOLDPAN.WW.Combat.EnsureWeaponEquipped()
		if not tool then
			warn("[AutoOutlaw] No gun in inventory, cannot sweep")
			finished = true
			break
		end

		local target = me.FindTarget()
		if target then
			local rootPart = target:FindFirstChild("HumanoidRootPart")
			local hrp = GetFreshHRP()
			-- Open with a rocket when one is loaded (the user's call). 40 damage
			-- plus 25 splash on up to 4 more within 12 studs, against an outlaw's
			-- 100 HP -- and roaming outlaws walk toward the player, so they arrive
			-- in clumps the splash pays for. Skipped rather than waited for: a
			-- launcher reloads in ~2.1s, about as long as the gun needs anyway, so
			-- a sweep never stands still for one.
			--
			-- The standoff is the point of the extra teleport: BlastRadius is 18
			-- and RocketOpener refuses inside rocketMinDistance (22), so firing
			-- from the 4-stud kill spot would fire nothing at all.
			if rootPart and hrp and GOLDPAN.WW.Combat.ReadyLauncher() then
				local humanoid = target:FindFirstChildOfClass("Humanoid")
				local health = humanoid and humanoid.Health or 100
				if health > me.rocketMinHealth then
					-- Only move for the shot when we are actually too close or too
					-- far. Measured over 14 kills: a rocket shortens the
					-- fight itself by about half a second (1.7s vs 2.1s average,
					-- 1.1s vs 1.6s median), which a standoff teleport fired on
					-- every kill would have spent again before the first shot. A
					-- target already between rocketStandoff and rocketMaxRange is
					-- shot from where we stand.
					local distance = (rootPart.Position - hrp.Position).Magnitude
					local placed = true
					if distance < me.rocketStandoff or distance > me.rocketMaxRange then
						-- Open ground the rocket can fly from (OpenSpotNear), on our
						-- side first. 35 and 45 are for when nothing at 26 is open:
						-- all three sit outside rocketMinDistance and well inside
						-- rocketMaxRange.
						local aim = rootPart.Position
						local spot = GOLDPAN.WW.Combat.OpenSpotNear(target, { me.rocketStandoff, 35, 45 }, hrp.Position, function(from)
							return GOLDPAN.WW.Combat.RocketPathClear(from, aim, target)
						end)
						if spot then
							TeleportPlayerOnly(spot)
							-- Turned at once, so RocketOpener's settle wait covers the
							-- move and the turn together instead of one after the other.
							GOLDPAN.WW.Combat.FaceTarget(rootPart.Position)
							GOLDPAN.WW.Combat.movedAt = os.clock()
						else
							placed = false
							DebugPrint("[AutoOutlaw] No open ground to rocket " .. target.Name .. " from, using the gun")
						end
					end
					local gun, fired = nil, false
					if placed then
						gun, fired = GOLDPAN.WW.Combat.RocketOpener(target, tool)
					end
					-- A swap DESTROYS the old Tool instance, so Engage has to be
					-- given the one that came back, not the one we walked in with.
					if gun then
						tool = gun
					end
					if fired then
						DebugPrint("[AutoOutlaw] Opened with a rocket")
					end
					-- Engage reads a destroyed Tool as "the target is down", and a
					-- weapon swap DESTROYS the old Tool, so a rocket that came back
					-- without a gun must be fixed HERE. Left alone it reports every
					-- rocket opener as a kill and the sweep waits on a body that
					-- never lands.
					if not tool or not tool.Parent or GOLDPAN.WW.Combat.IsLauncher(tool) then
						tool = GOLDPAN.WW.Combat.GunBack()
					end
					rootPart = target:FindFirstChild("HumanoidRootPart")
					hrp = GetFreshHRP()
				end
			end
			if not tool or not tool.Parent then
				warn("[AutoOutlaw] Lost the gun after the rocket opener, picking a new one next pass")
				task.wait(0.3)
			else
				local inReach = true
				if rootPart and hrp then
					local distance = (rootPart.Position - hrp.Position).Magnitude
					-- engageRange, unchanged: a rocket standoff (26) is outside it,
					-- so a rocket opener always closes in afterwards, while a plain
					-- pass still shoots from wherever it already stood -- when it
					-- can see the target from there. Seen at Business
					-- Bay: 11 rounds of "10 shots ... with no damage" on one outlaw
					-- in a single sweep.
					local seen = GOLDPAN.WW.Combat.HasClearShot(hrp.Position + Vector3.new(0, 1.5, 0), target)
					if distance > me.engageRange or not seen then
						-- Open ground with a clear shot (OpenSpotNear), on our side
						-- first; last resort the outlaw's own feet, which cannot be
						-- inside anything -- it is walking there. Still unmeasured
						-- because it is too far to have streamed in: land on it. Or
						-- measured wrongly, blocked by terrain meshes it is standing
						-- among: land on it too (StandingFeet).
						local spot = GOLDPAN.WW.Combat.OpenSpotNear(target, { me.closeDistance, 8, 12 }, hrp.Position)
							or TPCACHE.OpenGround(rootPart.Position)
							or GOLDPAN.WW.Combat.UnloadedFeet(rootPart, hrp.Position)
							or GOLDPAN.WW.Combat.StandingFeet(target)
						if spot then
							TeleportPlayerOnly(spot)
							task.wait(0.3)
						else
							-- Not shot from out of range: that is 10s of fire into
							-- nothing. The outlaw walks, so the next pass tries again.
							inReach = false
							if me.warnedNoGround ~= target then
								me.warnedNoGround = target
								warn("[AutoOutlaw] No open ground near the outlaw at " .. tostring(Vector3.new(math.floor(rootPart.Position.X), math.floor(rootPart.Position.Y), math.floor(rootPart.Position.Z))) .. " -- not teleporting there, retrying as it moves")
							end
							task.wait(1)
						end
					end
				end
				-- NO peek cycles out here -- the user's call. A lone
				-- roaming outlaw does about 5 damage a second and dies in a
				-- couple of seconds of fire, so ducking for cover between bursts
				-- only makes the sweep slower for damage the 1 HP/s regen covers
				-- anyway. Peeking is for Town Defense, where six of them shoot
				-- at once. Plain stand-and-shoot here.
				local killed = false
				if inReach then
					killed = GOLDPAN.WW.Combat.Engage(tool, target, 10)
				end
				if killed then
					-- Measured: a launcher only STARTS its reload while it is in
					-- hand, so a fired one stays empty until it is picked up again.
					-- The ragdoll wait below is dead time anyway, so the pick-up
					-- costs the sweep nothing and the next kill has one ready.
					local back = GOLDPAN.WW.Combat.ReloadLaunchers()
					if back then
						tool = back
					end
					-- Measured: a killed outlaw lies in _Outlaws as
					-- "Gone" for ~2.5s (RagdollSeconds) before the same model
					-- moves to _Carryables and gets its PickupPrompt. Collecting
					-- straight after the kill found nothing, and after the last
					-- kill of a sweep nothing was left to hunt or carry, so the
					-- sweep ended and left that body on the ground.
					local bodyDeadline = os.clock() + 5
					while os.clock() < bodyDeadline and SESSION.alive and target.Parent
						and not target:FindFirstChild("PickupPrompt", true) do
						task.wait(0.2)
					end
				end
			end
		end

		-- Re-checked between the kill and the pickup: CollectCorpses
		-- teleports repeatedly and can recall the truck, so a race that
		-- queued while we were mid-Engage should not have to wait out all
		-- of that too.
		if GOLDPAN.WW.ShouldYield(GOLDPAN.WW.PRIORITY.Outlaw) then
			print("[AutoOutlaw] Standing down before the pickup run -- picking it back up after")
			break
		end

		-- Load only. The Sheriff is visited once, after the loop.
		GOLDPAN.WW.Combat.CollectCorpses()

		if not target and not GOLDPAN.WW.Combat.AnyCorpseWaiting() then
			finished = true
			break
		end
		task.wait(me.intervalSeconds)
	end
	end)
	if not sweepOk then
		warn("[AutoOutlaw] Sweep errored: " .. tostring(sweepErr))
	end

	local rocketsThisSweep = math.max(0, (GOLDPAN.WW.Combat.rocketsFired or 0) - rocketsAtStart)
	if rocketsThisSweep > 0 then
		print("[AutoOutlaw] Rockets fired this sweep: " .. rocketsThisSweep)
	end

	-- ONE Sheriff trip per sweep, on the way out (the user's call,
	-- 2026-09-17). Outlaws come back as a batch, so a trip after every kill
	-- was a teleport and a far-area load per body for nothing: the Sheriff
	-- empties the whole car in one prompt, and Town Defense already loads
	-- all its bodies before a single turn-in. Done on EVERY way out, a
	-- stand-down or an error included, and before Auto Farm gets the car
	-- back: the old per-kill trip never let bodies ride along while the
	-- farm drives and unloads it, and that has never been tested.
	if SESSION.alive and GOLDPAN.WW.Combat.HasOutlawsToTurnIn() then
		GOLDPAN.WW.Renew("Outlaw", 30)
		local bodies = 0
		local truck = GetPlayerTruck()
		if truck then
			for _, child in ipairs(truck:GetChildren()) do
				if child:GetAttribute("OutlawCorpse") then
					bodies = bodies + 1
				end
			end
		end
		local nuggetsBefore = LocalPlayer:GetAttribute("GoldNuggets")
		-- Twice, not once. Seen: a trip took nothing and the
		-- body rode along until the NEXT sweep paid it (+50 for 4 bodies).
		-- Cause not captured -- the Trade call itself did not error -- so this
		-- retries rather than explains, and 1.2s beats the 0.5s it used to
		-- allow for the car to replicate before the check calls it a failure.
		for attempt = 1, 2 do
			-- TurnInToSheriff returns the remote's own ok/result, so unpack both:
			-- next time this fails the console says what the Sheriff answered
			-- instead of only that the bodies stayed put.
			local turnOk, invokeOk, invokeResult = pcall(GOLDPAN.WW.Combat.TurnInToSheriff)
			if not turnOk then
				warn("[AutoOutlaw] Sheriff turn-in errored: " .. tostring(invokeOk))
			else
				DebugPrint("[AutoOutlaw] Sheriff answered: ok=" .. tostring(invokeOk) .. " result=" .. tostring(invokeResult))
			end
			task.wait(1.2)
			if not (SESSION.alive and GOLDPAN.WW.Combat.HasOutlawsToTurnIn()) then
				break
			end
			if attempt == 1 then
				DebugPrint("[AutoOutlaw] The Sheriff took nothing, trying once more")
			end
		end
		local nuggetsAfter = LocalPlayer:GetAttribute("GoldNuggets")
		if GOLDPAN.WW.Combat.HasOutlawsToTurnIn() then
			warn("[AutoOutlaw] Visited the Sheriff twice but outlaw bodies are still in the car -- they ride along to the next sweep")
		elseif type(nuggetsBefore) == "number" and type(nuggetsAfter) == "number" then
			print("[AutoOutlaw] Turned in " .. bodies .. " bodies at the Sheriff: nuggets " ..
				nuggetsBefore .. " -> " .. nuggetsAfter .. " (+" .. (nuggetsAfter - nuggetsBefore) .. ")")
		else
			print("[AutoOutlaw] Turned in " .. bodies .. " bodies at the Sheriff")
		end
	end

	GOLDPAN.WW.ResumeFarm("Outlaw")
	GOLDPAN.WW.Release("Outlaw")
	return finished
end

function GOLDPAN.WW.Outlaw.Start()
	if LOOPGUARDS.autoOutlaw then
		return
	end
	LOOPGUARDS.autoOutlaw = true
	task.spawn(function()
		while GOLDPAN.WW.Outlaw.active and LOOPGUARDS.autoOutlaw and SESSION.alive do
			local me = GOLDPAN.WW.Outlaw
			if not me.pending then
				local sinceSweep = os.clock() - me.lastSweepAt
				local roamingCount = me.CountRoaming()
				local fullBatch = roamingCount >= me.minRoamingToEngage
					and sinceSweep >= me.minSweepGapSeconds
				local timerDue = sinceSweep >= me.sweepIntervalSeconds
				-- Gun ownership is checked HERE, before anything is queued --
				-- not inside the sweep after Auto Farm has already been
				-- switched off. Ownership only, no equip: taking the tool slot
				-- on the way to a sweep that cannot happen is how this used to
				-- pull the pan out of the player's hands.
				if roamingCount > 0 and (fullBatch or timerDue) then
					if GOLDPAN.WW.Combat.FindWeaponGuid() then
						GOLDPAN.WW.ClearBlocked(me, "warnedNoGun", "[AutoOutlaw] Gun found, outlaw sweeps are live again")
						me.pending = true
						print("[AutoOutlaw] " .. roamingCount .. " outlaws up (" ..
							(fullBatch and "full batch" or (me.sweepIntervalSeconds .. "s timer")) ..
							") -- queued for a sweep")
					else
						me.lastSweepAt = os.clock()
						GOLDPAN.WW.ReportBlocked(me, "warnedNoGun",
							"[AutoOutlaw] Auto Hunt Outlaws is ON but you own no gun -- it cannot do anything until you have one (Handgun, Revolver, Uzi, SMG, P90, Sniper Rifle, Shotgun or Antique Pistol)")
					end
				end
			end

			if not me.pending then
				task.wait(me.intervalSeconds)
			elseif GOLDPAN.WW.ShouldYield(GOLDPAN.WW.PRIORITY.Outlaw) then
				GOLDPAN.WW.Announce(GOLDPAN.WW.PRIORITY.Outlaw, "Outlaw", 6)
				DebugPrint("[AutoOutlaw] Sweep queued, waiting for the floor")
				task.wait(2)
			elseif me.RunSweep() then
				me.pending = false
				print("[AutoOutlaw] Sweep done, handing Auto Farm back")
			else
				task.wait(2)
			end
		end
		GOLDPAN.WW.Outlaw.pending = false
		GOLDPAN.WW.ResumeFarm("Outlaw")
		GOLDPAN.WW.Release("Outlaw")
		LOOPGUARDS.autoOutlaw = false
	end)
end

