-- AUTO SELL (Pawn Shop)
-- Price identical to PawnShop.baseSellPriceForEntry (decompiled UI module):
-- BasePrice -> CalculatePriceForEntry -> * Grading.GradeCashMultForEntry.
-- Rate = Pawn.GetPawnState.rate (multiplicative: 0.85 = -15%).
-- Favorited items are NEVER sold.
local AUTOSELL = {
	GetSellableItems = Events:WaitForChild("Pawn"):WaitForChild("GetSellableItems"),
	GetPawnState = Events:WaitForChild("Pawn"):WaitForChild("GetPawnState"),
	SellItems = Events:WaitForChild("Pawn"):WaitForChild("SellItems"),
	enabled = false,
	-- GUIDs the server has refused, guid -> os.clock() when it said no.
	-- See the isolation pass in RunPass for why this has to be learned
	-- rather than predicted.
	refused = {},
	-- A refusal is not necessarily forever: finishing the quest that reserved
	-- an item makes it sellable again. So a refusal is forgotten after this
	-- long and the item gets one more chance, which costs one failed call an
	-- hour rather than an item that can never be sold again.
	REFUSAL_TTL = 1800,
	-- Ceiling on how many refusals one isolation pass will discover, so a
	-- server-side outage (every item refused) cannot turn into 100 remote
	-- calls every 10 seconds.
	ISOLATE_LIMIT = 5,
	-- Spacing between the isolation calls. The pawn shop rate-limits: at 0.1s
	-- every single call came back "Too fast" and three innocent items were
	-- blacklisted (measured 2026-09-10, first run of this code).
	ISOLATE_GAP = 0.6,
	maxValue = 100,
	-- Minimum rate (in-game display format: +15% / -20%) below which we
	-- sell nothing at all this cycle -- we wait for a better rate.
	-- -100 = no restriction, we sell whatever the rate.
	minRatePercent = -100,
	excludedCategories = {},
	excludedRarities = {},
	excludedItemNames = {},
	excludeVault = false,
	excludeEnergyDrinks = false,
	excludeExclusive = false,
	-- Items[id].Limited, a boolean of its own. NOT the same thing as
	-- EventExclusive above, and not a rarity: Limited marks the items of a
	-- timed event (Alien Invasion), which carry their own normal rarity on
	-- top (Alien Storage Box is Epic AND Limited). Confirmed in game
	-- 2026-09-06 by snippets/limited-rarity-probe.lua.
	excludeLimited = false,
	-- Set of mutation-name -> true, same pattern as FORCEBID.selected.
	-- Replaces the old "Exclude Mutated Items" toggle (all or nothing):
	-- here we choose precisely which mutations block the sale.
	excludedMutations = {},
}

-- "Too fast" is the pawn shop's rate limiter, not a verdict on the item, and
-- recording it as a refusal is how the first version of this code blacklisted
-- three Water Containers that were perfectly sellable. A transient reason is
-- never remembered -- the item simply gets picked up again next pass.
function AUTOSELL.IsTransient(reason)
	if type(reason) ~= "string" then
		return false
	end
	local lower = string.lower(reason)
	if string.find(lower, "too fast", 1, true) then
		return true
	end
	if string.find(lower, "rate limit", 1, true) then
		return true
	end
	if string.find(lower, "try again", 1, true) then
		return true
	end
	return false
end

-- True while the server is still refusing this item. Expiry is checked on
-- read, so nothing has to sweep the table.
function AUTOSELL.IsRefused(guid)
	local at = AUTOSELL.refused[guid]
	if not at then
		return false
	end
	if os.clock() - at > AUTOSELL.REFUSAL_TTL then
		AUTOSELL.refused[guid] = nil
		return false
	end
	return true
end

-- Remember a refusal and say so ONCE per item. This is a real failure -- the
-- item is not being sold -- so it warns rather than DebugPrints, but latched
-- per GUID so a 10s loop cannot bury the console the way it did before.
function AUTOSELL.Refuse(guid, name, reason)
	-- Belt and braces: a transient reason must never reach the table, whoever
	-- the caller is.
	if AUTOSELL.IsTransient(reason) then
		return
	end
	if AUTOSELL.refused[guid] then
		return
	end
	AUTOSELL.refused[guid] = os.clock()
	warn(string.format("[AutoSell] The server will not sell %s (%s) -- skipping it for %d minutes "
		.. "so it stops blocking everything else",
		tostring(name or "an item"), tostring(reason), math.floor(AUTOSELL.REFUSAL_TTL / 60)))
end

function AUTOSELL.ComputeSellPrice(entry, itemDef)
	local price = MutatorModule:CalculatePriceForEntry(itemDef.BasePrice or 0, entry)
	return price * Grading.GradeCashMultForEntry(entry)
end

function AUTOSELL.GetRate()
	local ok, state = pcall(function()
		return AUTOSELL.GetPawnState:InvokeServer()
	end)
	if ok and type(state) == "table" and type(state.rate) == "number" then
		return state.rate
	end
	warn("[AutoSell] GetPawnState failed: " .. tostring(state))
	return 1 -- neutral rate by default: does not skew the threshold comparison
end

-- Accepts "-10", "+15", "10%", "-20 %".
function AUTOSELL.ParseRatePercent(text)
	if type(text) ~= "string" then
		return nil
	end
	local cleaned = string.gsub(text, "[%s%%]", "")
	return tonumber(cleaned)
end

function AUTOSELL.RunPass()
	if not AUTOSELL.enabled then
		return
	end

	local rate = AUTOSELL.GetRate()
	local ratePercent = math.floor((rate - 1) * 100 + 0.5)

	if ratePercent < AUTOSELL.minRatePercent then
		DebugPrint(string.format("[AutoSell] Rate %d%% below minimum %d%%, skipping this pass", ratePercent, AUTOSELL.minRatePercent))
		return
	end

	local ok, items = pcall(function()
		return AUTOSELL.GetSellableItems:InvokeServer()
	end)
	if not ok or type(items) ~= "table" then
		warn("[AutoSell] GetSellableItems failed: " .. tostring(items))
		return
	end

	local guids = {}
	local sellNames = {}

	for guid, entry in pairs(items) do
		if entry.Favorited ~= true then
			local itemDef = Items[tostring(entry.ItemId)]
			if itemDef then
				local rarity = itemDef.Rarity or "Uncommon"
				-- EventExclusive: same criterion as the game's Collections
				-- module for putting an item in the "Exclusive" bucket (a
				-- static def field, not a mutation -- "Fishing Season" is
				-- separate, filed under "Fish" game-side, not "Exclusive").
				local isExclusive = itemDef.EventExclusive and itemDef.EventExclusive ~= "Fishing Season"

				-- True as soon as one of the item's mutations is in
				-- excludedMutations. Same read pattern as FORCEBID.Check:
				-- entry.Mutators is already a decoded table here (unlike
				-- item:GetAttribute on the ReadMutatorNames side), so we read
				-- .name directly.
				local hasExcludedMutation = false
				if type(entry.Mutators) == "table" then
					for _, mutation in ipairs(entry.Mutators) do
						if type(mutation) == "table" and AUTOSELL.excludedMutations[mutation.name] then
							hasExcludedMutation = true
							break
						end
					end
				end

				-- Mint is derived from Condition, not stored in Mutators, so
				-- the loop above cannot see it. See IsMintCondition.
				if AUTOSELL.excludedMutations["Mint"] and IsMintCondition(entry.Condition) then
					hasExcludedMutation = true
				end

				local ruleForcedSale = false
				local excluded = AUTOSELL.excludedRarities[rarity]
					or (type(itemDef.Category) == "string" and AUTOSELL.excludedCategories[itemDef.Category])
					or (AUTOSELL.excludeVault and itemDef.SafeId ~= nil)
					or (AUTOSELL.excludeEnergyDrinks and ENERGYDRINK.itemIdToDrinkId[tostring(entry.ItemId)] ~= nil)
					or (AUTOSELL.excludeExclusive and isExclusive)
					or (AUTOSELL.excludeLimited and itemDef.Limited == true)
					or hasExcludedMutation
					or (type(itemDef.Name) == "string" and AUTOSELL.excludedItemNames[itemDef.Name])
					-- Held back for the collector.
					or COLLECTORKEEP.Matches(entry.ItemId)

				-- Base value (before rate): the rate ONLY decides whether we
				-- sell this cycle (guard above), not which items count.
				local baseValue = AUTOSELL.ComputeSellPrice(entry, itemDef)

				-- Item Rules override this tab's own filters in both
				-- directions: "Never sell" holds an item back that the lists
				-- would have sold, "Allow selling" releases one they hold.
				--
				-- A forced sale ALSO clears the "Sell Below $" gate. It did not
				-- until 2026-09-12, which made this the odd lane out -- the
				-- place lane's force has always skipped its own min/max value
				-- -- and a rule saying "sell these" that silently did not was
				-- a control lying about itself. It is announced when it
				-- happens, because selling something expensive on purpose
				-- should never look like an accident.
				if RULES.LaneArmed("sell") then
					local verdict = RULES.Decide("sell", {
						name = itemDef.Name,
						category = itemDef.Category,
						rarity = rarity,
						mutations = entry.Mutators,
						traits = RULES.TraitsFor(itemDef, entry.ItemId),
						condition = entry.Condition,
						value = baseValue,
						-- The ROLLED weight when the item has one, otherwise the
						-- item's fixed weight from its definition.
						weight = entry.Weight or (type(itemDef) == "table" and itemDef.Weight) or nil,
					})
					if verdict == "block" then
						excluded = true
					elseif verdict == "force" then
						excluded = false
						ruleForcedSale = true
					end
				end

				if not excluded and not AUTOSELL.IsRefused(guid) then
					if baseValue < AUTOSELL.maxValue then
						table.insert(guids, guid)
						sellNames[guid] = itemDef.Name
					elseif ruleForcedSale then
						print(string.format(
							"[AutoSell] Rule %s says to sell %s, so it goes even though it is worth %s and Sell Below is %s",
							tostring(RULES.lastRule), tostring(itemDef.Name),
							tostring(math.floor(baseValue)), tostring(AUTOSELL.maxValue)))
						table.insert(guids, guid)
						sellNames[guid] = itemDef.Name
					end
				end
			end
		end
	end

	if #guids == 0 then
		DebugPrint("[AutoSell] Nothing under $" .. tostring(AUTOSELL.maxValue) .. " to sell this pass")
		return
	end

	local sellOk, result = pcall(function()
		return AUTOSELL.SellItems:InvokeServer(guids)
	end)

	if sellOk and type(result) == "table" and result.success then
		DebugPrint(string.format("[AutoSell] Sold %d item(s) for $%s (rate %d%%)", result.sold or #guids, tostring(result.totalEarned), ratePercent))
		return
	end

	local reason
	if sellOk and type(result) == "table" and result.error then
		reason = tostring(result.error)
	else
		reason = tostring(result)
	end

	-- The sell is ONE call for the whole batch, so a single item the server
	-- refuses ("You cannot sell this item [Quest]") takes every other item
	-- down with it -- nothing sold at all, every 10s, indefinitely. Seen live
	-- 2026-09-10: 30+ identical failures in a row against 13 sellable items.
	--
	-- Which item it is cannot be predicted: there is no quest flag on the
	-- inventory entry or on the item definition, so the refusal is the only
	-- evidence that exists. So isolate it -- sell one at a time, remember the
	-- ones the server refuses, and leave them out from then on.
	if #guids == 1 then
		AUTOSELL.Refuse(guids[1], sellNames[guids[1]], reason)
		return
	end

	warn("[AutoSell] The server refused the whole batch (" .. reason ..
		"), so it is being retried one item at a time to find which item it is")

	local sold = 0
	local refused = 0
	local deferred = 0

	-- The batch call has only just been made and the shop rate-limits, so
	-- wait before the first isolation call rather than spending it on a
	-- guaranteed "Too fast".
	task.wait(AUTOSELL.ISOLATE_GAP)

	for _, guid in ipairs(guids) do
		if refused >= AUTOSELL.ISOLATE_LIMIT then
			break
		end
		local oneOk, oneResult = pcall(function()
			return AUTOSELL.SellItems:InvokeServer({ guid })
		end)
		if oneOk and type(oneResult) == "table" and oneResult.success then
			sold = sold + 1
		else
			local why
			if oneOk and type(oneResult) == "table" and oneResult.error then
				why = tostring(oneResult.error)
			else
				why = tostring(oneResult)
			end
			if AUTOSELL.IsTransient(why) then
				-- Rate limited, which says nothing about the item. Leave it
				-- alone and let the next pass have it.
				deferred = deferred + 1
				DebugPrint("[AutoSell] Rate limited while isolating, will retry " ..
					tostring(sellNames[guid] or "the item") .. " next pass")
			else
				refused = refused + 1
				AUTOSELL.Refuse(guid, sellNames[guid], why)
			end
		end
		task.wait(AUTOSELL.ISOLATE_GAP)
	end

	DebugPrint(string.format("[AutoSell] Isolation pass: %d sold, %d refused and skipped, %d rate limited",
		sold, refused, deferred))
end

function AUTOSELL.Start()
	if LOOPGUARDS.autoSell then return end
	LOOPGUARDS.autoSell = true
	task.spawn(function()
		while AUTOSELL.enabled and LOOPGUARDS.autoSell do
			AUTOSELL.RunPass()
			task.wait(10) -- the rate does not move fast enough to justify shorter
		end
		LOOPGUARDS.autoSell = false
	end)
end

